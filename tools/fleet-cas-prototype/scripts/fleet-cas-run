#!/bin/bash
# launchd entry point for a fleet-cas service: exec fleet-cas with the role's
# arguments from $ROOT/run/ROLE.args (one per line, written by glaeda-fleet-cas),
# recording the PID so the installer can restart it without root.
set -u
role=${1:?usage: fleet-cas-run ROLE}
ROOT=${FLEET_CAS_ROOT:-/Users/Shared/cmux-build-fleet/xcode}

# Keep the run receipts truthful while this wrapper waits for a tailnet address. A previous
# process may have left a pid or binary hash behind; the wrapper is the only process that can
# replace those receipts before it execs the daemon.
pid_file="$ROOT/run/$role.pid"
bin_file="$ROOT/run/$role.bin"
clear_wait_receipts() {
  rm -f "$pid_file" "$bin_file"
}
record_wait_pid() {
  clear_wait_receipts
  printf '%s\n' "$$" >"$pid_file" || { clear_wait_receipts; exit 1; }
  rm -f "$bin_file"
}
record_wait_pid
trap 'clear_wait_receipts; exit 143' HUP INT TERM

args=()
args_file="$ROOT/run/$role.args"
if [ ! -r "$args_file" ]; then
  clear_wait_receipts
  exit 1
fi
if ! while IFS= read -r a; do args+=("$a"); done <"$args_file"; then
  clear_wait_receipts
  exit 1
fi

# A custom store root is supplied only for a separately mounted APFS volume. The installer
# records that volume's UUID in the LaunchDaemon environment. Re-check both the mount and UUID
# every time launchd starts the service so an unmounted sparsebundle, stale /Volumes directory,
# or replacement volume cannot make the CAS write onto the controller's boot disk.
validate_custom_store_volume() {
  local root=$1 fs_type=$2 mount_point=$3 volume_uuid=$4 expected_uuid=$5
  [ "$fs_type" = apfs ] || {
    echo "fleet-cas: custom store root must be APFS: $root" >&2
    return 1
  }
  case "$mount_point" in
    /Volumes/*) ;;
    *) echo "fleet-cas: custom store root must be a mounted /Volumes APFS volume: $root" >&2; return 1 ;;
  esac
  case "$root" in
    "$mount_point"|"$mount_point"/*) ;;
    *) echo "fleet-cas: custom store root is outside its mounted volume: $root" >&2; return 1 ;;
  esac
  [ -n "$expected_uuid" ] || {
    echo "fleet-cas: FLEET_CAS_VOLUME_UUID is missing for custom store root: $root" >&2
    return 1
  }
  [ "$volume_uuid" = "$expected_uuid" ] || {
    echo "fleet-cas: custom store volume UUID changed (expected $expected_uuid, found $volume_uuid)" >&2
    return 1
  }
}

check_custom_store_root() {
  [ "$role" = store ] || return 0
  [ -n "${FLEET_CAS_ROOT:-}" ] || return 0
  local volume_info fs_type mount_point volume_uuid expected_uuid
  [ -d "$ROOT" ] || { echo "fleet-cas: custom store root is not mounted: $ROOT" >&2; return 1; }
  command -v diskutil >/dev/null 2>&1 || {
    echo "fleet-cas: diskutil is required to validate custom store root: $ROOT" >&2
    return 1
  }
  volume_info=$(diskutil info "$ROOT" 2>/dev/null) || {
    echo "fleet-cas: unable to inspect custom store root: $ROOT" >&2
    return 1
  }
  fs_type=$(printf '%s\n' "$volume_info" | awk -F': *' '/Type \(Bundle\)/ {print tolower($2); exit}')
  mount_point=$(printf '%s\n' "$volume_info" | awk -F': *' '/Mount Point/ {print $2; exit}')
  volume_uuid=$(printf '%s\n' "$volume_info" | awk -F': *' '/Volume UUID/ {print $2; exit}')
  expected_uuid=${FLEET_CAS_VOLUME_UUID:-}
  validate_custom_store_volume "$ROOT" "$fs_type" "$mount_point" "$volume_uuid" "$expected_uuid"
}

if ! check_custom_store_root; then
  clear_wait_receipts
  exit 78
fi

is_ipv4() {
  local value=$1 octet
  [[ "$value" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || return 1
  local old_ifs=$IFS
  IFS=.
  read -r -a octets <<<"$value"
  IFS=$old_ifs
  for octet in "${octets[@]}"; do
    (( 10#$octet <= 255 )) || return 1
  done
}

# Return a host only for a valid, non-wildcard IPv4 endpoint. IPv6 and malformed endpoints are
# passed straight to fleet-cas, which owns their validation and error reporting.
store_ipv4_host() {
  local endpoint=${1#tcp:} host port
  [ "$endpoint" != "$1" ] || return 1
  case "$endpoint" in *:*) ;; *) return 1 ;; esac
  host=${endpoint%:*}
  port=${endpoint##*:}
  is_ipv4 "$host" || return 1
  case "$host" in 0.0.0.0|127.*) return 1 ;; esac
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 )) || return 1
  printf '%s\n' "$host"
}

# A store binds its explicit tailnet address. launchd can start it before Tailscale has
# installed that address, which makes tonic return EADDRNOTAVAIL and sends launchd into a
# restart loop. Keep the service alive and observable until the address exists; this preserves
# the explicit non-wildcard bind and lets launchd start the listener exactly once.
wait_for_store_address() {
  local host
  host=$(store_ipv4_host "$1") || return 0
  local waited=0
  local max_wait=60
  while ! ifconfig 2>/dev/null | awk '$1 == "inet" {print $2}' | grep -Fqx "$host"; do
    if [ "$waited" -eq 0 ]; then
      echo "fleet-cas: waiting for local bind address $host" >&2
    fi
    if [ "$waited" -ge "$max_wait" ]; then
      echo "fleet-cas: timed out after ${max_wait}s waiting for local bind address $host" >&2
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

if [ "$role" = store ] && [ "${args[0]:-}" != "" ] && ! wait_for_store_address "${args[0]}"; then
  clear_wait_receipts
  exit 78
fi

# Record the pid and the binary it runs, so the installer can restart a stale one.
trap - HUP INT TERM
shasum -a 256 "$ROOT/bin/fleet-cas" | cut -c1-64 >"$bin_file"
exec "$ROOT/bin/fleet-cas" "${args[@]}"
