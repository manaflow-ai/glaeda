#!/usr/bin/env python3
"""glaeda-mini-health: find what stops a cmux runner mini from running jobs, fix what this user can, report the rest.

    glaeda-mini-health            check only: print the report, change nothing
    glaeda-mini-health --apply    check, heal, write the report (the 2-minute LaunchAgent from glaeda-mini-setup)

Each run checks, as the runner user and without sudo:

  console_locked / console_no_user   the console session is screen-locked or nobody is logged in, so GUI jobs are
                                     refused here (glaeda#1286). Needs root and a reboot: reported only.
  autologin_locks                    /Library/Preferences/com.apple.loginwindow autoLoginUserScreenLocked is set, so
                                     every auto-login starts locked (cmuxterm-hq#757). Root: reported only.
  display_sleep                      pmset displaysleep is not 0; the screen lock follows the display sleep. Root.
  testmanagerd_wedged                this user's testmanagerd stopped half way through tearing down a session: its
                                     newest session line is "XCIDESession is responsible for cleaning up its socket"
                                     with no "Closing session", "Tearing down" or "Created session" after it, and
                                     every XCTest run here hangs. Healed while no test runs, with the runner hook's
                                     recycle_testmanagerd (glaeda#1281), the same stop a gui job does at its start.
  tailscale_down                     `tailscale status --json` answered with a BackendState that is not Running
                                     (Stopped, stuck Starting). Healed after two runs in a row: `tailscale up` when
                                     Stopped, else a stop and start of the Tailscale VPN service (scutil --nc), as
                                     mini-ops tailscale-unstick.sh does by hand. A standalone tailscaled (root daemon)
                                     or a logged-out node is reported only.
  tailscale_no_route                 BackendState is Running but the OS sends tailnet traffic elsewhere:
                                     `route -n get 100.100.100.100` (Tailscale's own address) leaves by a
                                     non-utun interface (en0 to the LAN gateway), so no tailnet host reaches
                                     ssh here while `tailscale ping --tsmp` still answers (cmuxs-mac-mini-5,
                                     2026-10-21: 100.64/10 gone from the routing table). Reported after two
                                     runs in a row (one when run by hand). Healed under --apply by a restart of
                                     Tailscale, never a config, auth or flag change, behind every one of these
                                     gates (heal_tailscale_route): a CI runner mini (registered glaeda runners,
                                     update.json setupArgs and mini-setup role fleet-mini, not --hygiene-only,
                                     --gh-only or --headless) that the fleet registry opted in:
                                     ~/.config/glaeda/tailscale-self-heal.json (schema glaeda-tailscale-self-heal/v1)
                                     names one of its names (hostname, LocalHostName, ComputerName, update.json host,
                                     tailnet name; an unreadable tailnet name refuses), and none of them holds
                                     "lawrence"; the two-runs rule met; glaeda-disk's host_busy idle, then the
                                     fleet host.lock held exclusively for the restart so no job is admitted, and
                                     no Runner.Worker or build under it (a mini never idle for TAILSCALE_DRAIN_AFTER_S,
                                     1 h, drains first: a glaeda-reservation/v1 marker owned by glaeda-mini-health in
                                     FLEET_DIR/reservation.json admits no new job while running ones finish; capped at
                                     TAILSCALE_DRAIN_MAX_S, 2 h, then it ends, alerts and does not drain again for 6 h;
                                     never on a host the fleet reservation list holds, glaeda-disk host_reservation,
                                     or that has anyone else's marker; the marker goes after the restart, when the route
                                     is back, or when a gate refuses); no attempt in the last 6 h (the attempt
                                     is written to tailscale-restart.json beside STATE before the restart runs;
                                     an unreadable file refuses). The app (App Store or System Extension) gets
                                     `scutil --nc stop/start` of its VPN service as this user; a standalone
                                     tailscaled gets `sudo -n launchctl kickstart -k system/com.tailscale.tailscaled`
                                     only where `sudo -n -l` lists an exact NOPASSWD rule for it (or NOPASSWD: ALL)
                                     as the last match (glaeda-mini-fleet sudo-plan --sudoers), else it is reported
                                     with that rule. One 30 s wait, one re-check of BackendState and the route.
                                     auto_fix is pending only for a short wait (busy or host lock held right now,
                                     the two-runs rule unmet); whenever no restart is coming it is impossible (an
                                     alert): a failed restart (until fixed; retried after 6 h, after 3 failed in a
                                     row not until the route is seen clear), the 6 h window, a kill switch, a gate
                                     that cannot answer, a restart state that cannot be read or written. Off with TAILSCALE_RESTART_OFF
                                     (~/.config/glaeda/tailscale-restart-off) or GLAEDA_TAILSCALE_RESTART=off.
  tailscale_cli_missing              a host with runner LaunchAgents has no Tailscale CLI at all (neither the
                                     standalone /usr/local/bin/tailscale nor the app bundle's): the tunnel is not
                                     checked, which is no answer, not a healthy tunnel. Reported only.
                                     A CLI that gave no BackendState while `route -n get` names a non-utun
                                     interface is tailscale_no_route too (the route is its own look).
  tailscale_probe_error              the Tailscale CLI gave no BackendState (it timed out, failed or printed no JSON;
                                     a loaded mini can time out with the tunnel up), or `route -n get` named no
                                     interface for the tailnet address. The check could not look, so the
                                     tunnel is not judged down: reported only, never healed. It keeps
                                     tailscale_no_route's count as it was (it did not look at the route).
  runner_stopped:<agent>             a runner LaunchAgent is loaded but not running (KeepAlive leaves it after a clean
                                     exit). Healed after two runs in a row with `launchctl kickstart`; nothing runs
                                     in it, so no job is disturbed. The listener gate's holds keep the agent running,
                                     and a runner cmux_mini_fix.sh runner_hold stopped (HELD) is no finding.
  runner_unloaded:<agent>            a runner LaunchAgent plist is not loaded: reported only (an operator may have
                                     unloaded it; glaeda-cmux-runner-fleet --apply loads it).
  node_toolchain_missing              the runner hook named one exact Rust toolchain that is absent. Healed as the
                                     runner user with `rustup toolchain install ... --profile minimal`, then the
                                     next health pass revalidates the hook. Only the exact version/triple from the
                                     refusal is accepted; receipt/enrollment failures remain operator-owned.
  node_ineligible                    the runner hook's node_refusal, for the fleet class its job-started hook requires
                                     (--require-eligible --fleet-class), names a reason, so job-started refuses every
                                     job here (a missing staged generation, a receipt that does not validate, a node
                                     that is not eligible). Restaging or re-enrolling is an operator's: reported only.
  toolchain_mismatch                 xcrun, in the env the runner gives its jobs (no SDKROOT or TOOLCHAINS,
                                     DEVELOPER_DIR on the job-started hook's --toolchain-xcode), resolves an SDK
                                     outside that Xcode, a swiftc of another Swift version than its toolchain's, an
                                     SDK of a newer major than its own, a cmux tool `xcrun --find` cannot find, or a
                                     python3 (PATH's, the /usr/bin/python3 shim) that does not start (the runner
                                     hook's xcode_refusal): cmux21,
                                     2026-10-21, Command Line Tools 27 on macOS 27 past Xcode_26.6. job-started refuses
                                     every job and the gate holds the listener off. Root's: reported only.
  ota_not_converging                 glaeda-update's converge.json (its step 8) says this host does not run the release
                                     its ring wants, by installed tool and runner hook digests, past the alertAfter
                                     time it wrote: "running X, wants Y, because Z". glaeda-update keeps retrying with
                                     backoff, so it is pending (warn), or an error when converge.json marks the reason
                                     blocking (a quarantined or refused release, a hook --refresh-hooks will not
                                     replace). The heal is glaeda-update's own; this only reports.
  ota_stale                          no glaeda-update run has finished since converge.json's staleAfter: its agent is
                                     not running, or every run dies. Reported only.

  daemon_heal_stale                  the root LaunchDaemon from scripts/glaeda-daemon-heal is missing, or its own
                                     report says it is not running its passes or has not kept itself on the stable
                                     release (glaeda-daemon-heal judge). Healed where `sudo -n` works (headless AWS
                                     hosts) by reinstalling it; elsewhere the root command is the note. Also run on a
                                     host without glaeda runners.
  daemon_hot:<name>                  a macOS daemon from config/macos-daemons.json has held hot_cores (fseventsd,
                                     audiomxd, WirelessRadioManagerd), from glaeda-daemon-heal's root report: that
                                     daemon restarts it at hot_hours (wait_idle daemons when the host is idle, or at
                                     busy_hot_hours). Reported here so ci-dash sees the wait; the heal is root's.
  claude_route                       Claude Code (~/.local/bin/claude, the capture jobs' agent) does not go through a
                                     fleet route from config/claude-routes.json that answers: ~/.claude/settings.json
                                     names no route (a personal login, which expires: cmux-mac-mini, 2026-10-21), a
                                     route outside the list, or a personal token; or a real `claude -p` through it
                                     failed (checked once per probe_every_s; a dead route hangs until killed).
                                     Healed at once by routing to the first listed route that answers (the failed
                                     one last), keeping a backup of settings.json. cmuxterm-hq build-fleet/capture-host
                                     admits no capture lease on a host whose report has it. Also run on a host
                                     without glaeda runners (a capture-only mini). While tailscale_down or
                                     tailscale_no_route is seen, it is not probed (without a fresh cached answer it
                                     reports "not probed: the Tailscale tunnel is down"), its probe is not kept and
                                     it is not rerouted (a broken tunnel, not the route, is why it does not answer),
                                     so it never acts in the same run as tailscale_no_route's restart.

A heal (other than tailscale_no_route's, above) is tried at most every HEAL_EVERY_S and HEAL_TRIES times a day per finding, counting heals that worked
but did not last (a runner that exits again), so nothing loops. Each finding reads
{id, code, severity, since, evidence, auto_fix, note}: auto_fix is "pending" while a heal will be tried,
"impossible" when this user cannot fix it or the tries ran out. A fixed finding leaves the report and its heal is
kept under "healed" for a day (auto_fix "done"). The report is REPORT (ci-dash's probe reads it; cmuxterm-hq
build-fleet/ci-dash turns each code into the operator command that fixes it); the state beside it keeps each
finding's first sighting and the heal tries. On a host with no glaeda runner it checks only claude_route (and the daemon healer). With KILL_SWITCH
present it still reports but never heals. Prints one JSON line when it healed something or the findings changed.
"""

from __future__ import annotations

import argparse
import contextlib
import datetime
import fcntl
import importlib.machinery
import importlib.util
import json
import math
import os
import plistlib
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any, Callable

HOME = Path.home()
STATE_DIR = HOME / ".local/state/glaeda/mini-health"
REPORT = STATE_DIR / "health.json"
STATE = STATE_DIR / "state.json"
NO_RUNNER_HEAL = STATE_DIR / "daemon-heal-attempt.json"  # the last daemon-heal reinstall on a host with no runner
KILL_SWITCH = HOME / ".config/glaeda/mini-health.disabled"
AGENTS = HOME / "Library/LaunchAgents"
HELD = HOME / ".local/state/glaeda/mini-fleet/runner-held"  # cmux_mini_fix.sh runner_hold's marks
RUNNER_AGENT = re.compile(r"com\.teamleaderleo\.glaeda\.cmux-runner(?:\.\d+)?")
LOGINWINDOW = Path("/Library/Preferences/com.apple.loginwindow.plist")
TAILSCALE_APP = "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
# Tailscale's own address: on a healthy node the OS sends it into the tunnel (a utun interface).
TAILNET_PROBE_IP = "100.100.100.100"
TAILSCALE_STANDALONE = "/usr/local/bin/tailscale"
# The app's binary is its CLI only when it sees a terminal or this; from a LaunchAgent it otherwise starts as the GUI
# and prints "The Tailscale GUI failed to start" instead of the status.
TAILSCALE_CLI_ENV = {"TAILSCALE_BE_CLI": "1"}
TESTMANAGERD = "/usr/libexec/testmanagerd"
SCHEMA = "glaeda-mini-health/v1"
SCRIPT_DIR = Path(__file__).resolve().parent
DAEMON_HEAL = SCRIPT_DIR / "glaeda-daemon-heal"  # beside this file in the repo, a release and ~/.local/bin
SYSTEM_PYTHON = "/usr/bin/python3"  # what the root LaunchDaemon runs; never a user-writable interpreter

HEAL_EVERY_S = 600
HEAL_TRIES = 3
HEALED_KEEP_S = 86400
HEALED_MAX = 20
WEDGE_AGE_S = 90  # a teardown finishes in the same millisecond; a signature this old with nothing after is a wedge
LOG_WINDOW_MIN = 720  # how far back the testmanagerd log is read (never before the daemon started)
TAILSCALE_WAIT_S = 60
RUST_TOOLCHAIN_RE = re.compile(r"rust toolchain ([0-9]+\.[0-9]+\.[0-9]+-[A-Za-z0-9][A-Za-z0-9.-]*) is not installed")
RUST_TOOLCHAIN_MAX_S = 900
# The newest of these lines decides: the signature alone means a session teardown that never finished.
WEDGE_SIGNATURE = "XCIDESession is responsible for cleaning up its socket"
SESSION_LINES = (WEDGE_SIGNATURE, "Closing session", "Tearing down", "Created session")
# A test that may be talking to testmanagerd (the hook's XCTEST_RUNNING, for hooks without it): the check waits.
XCTEST_RUNNING = re.compile(r"(?:^|/)xctest(?:\s|$)|(?:^|/)xcodebuild\s(?:.*\s)?(?:test|test-without-building)(?:\s|$)")
LEAKED_TEST_APP = re.compile(r"^\s*'?(.*/actions-runner[^/]+/_work/_temp/cmux-derived-data-tests-[^/]+/Build/Products/Debug/cmux DEV\.app)(?:/Contents/MacOS/[^ ]+)?'?(?:\s|$)")
LEAKED_APP_TERM_S = 1.0
OTA_CONVERGE = ".local/state/glaeda/update/converge.json"  # glaeda-update's CONVERGE, under this home
CLAUDE_ROUTES = "claude-routes.json"  # config/, beside this script or as mini-setup installs it
CLAUDE_PROBE_S = 60  # a route that does not answer hangs `claude -p` in its retries until it is killed
CLAUDE_PROMPT = "Reply with exactly PONG"
CLAUDE_PERSONAL = ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY")  # a person's login: it overrides the route

# tailscale_no_route's self-heal (Leo, 2026-10-21): a restart of Tailscale, only on an idle CI runner mini, at most
# once every TAILSCALE_RESTART_EVERY_S per mini, never on cmux-lawrence, the AWS Macs or a person's Mac.
TAILSCALE_RESTART_EVERY_S = 6 * 3600
TAILSCALE_RESTART_SETTLE_S = 30  # the one bounded wait between the restart and its re-check
TAILSCALE_RESTART_STATE = "tailscale-restart.json"  # beside STATE: the last attempt, written before it runs
TAILSCALE_RESTART_SCHEMA = "glaeda-mini-health-tailscale-restart/v1"
# Failed restarts in a row (tailscale-restart.json's failures) after which it stops restarting until the route is
# seen clear again: a restart that does not fix it is an operator's to look at, not a 6-hourly ritual.
TAILSCALE_RESTART_GIVE_UP = 3
# The kill switch, as glaeda-disk's disk-off: this file, or GLAEDA_TAILSCALE_RESTART=off|0|false|no in the agent's env.
TAILSCALE_RESTART_OFF = HOME / ".config/glaeda/tailscale-restart-off"
TAILSCALE_RESTART_ENV = "GLAEDA_TAILSCALE_RESTART"
TAILSCALED_LABEL = "com.tailscale.tailscaled"  # the standalone tailscaled's LaunchDaemon (tailscaled install-system-daemon)
# Which hosts may restart is declared in leo-workspace's machines/fleet-registry.json, not here: the registry side
# writes this opt-in on each host it allows ({"schema": TAILSCALE_OPT_IN_SCHEMA, "host": "<registry name>",
# "source": "fleet-registry.json"}), and a host whose opt-in is missing, unreadable or names another host refuses.
TAILSCALE_OPT_IN = ".config/glaeda/tailscale-self-heal.json"  # under the runner user's home
TAILSCALE_OPT_IN_SCHEMA = "glaeda-tailscale-self-heal/v1"
# Belt and braces under the opt-in: cmux-lawrence (Lawrence's controller, the subrouter every session streams
# through) is never restarted, whatever an opt-in says.
NEVER_RESTART_WORD = "lawrence"
# What the runner hook's FLEET_DIR is: its host.lock is the lock every job's admission takes (glaeda-cmux-runner-hook).
FLEET_DIR = Path(os.environ.get("GLAEDA_FLEET_DIR") or "/Users/Shared/cmux-build-fleet")
# The drain (cmuxs-mac-mini-5, 2026-10-26: 12 runners, never idle, so the idle-only restart never came and its
# controller worker sat out of placement from 05:40Z on). Once tailscale_no_route has waited TAILSCALE_DRAIN_AFTER_S
# for an idle mini, mini-health writes a glaeda-reservation/v1 marker (FLEET_DIR/reservation.json, the file the runner
# hook reads): job-started refuses new jobs fast and the listener gate stops idle listeners, so GitHub hands the work to
# other runners, as under any reservation. Running jobs finish; once none is left, the restart runs under the host lock
# as before, and the marker goes. 1 h: a mini with any gap between jobs restarts long before (most cmux jobs are
# minutes), so only a mini that is never idle drains, and an hour off the tailnet (no controller heartbeat, no ssh) is
# already more than draining costs (one mini's slots for one job's length).
TAILSCALE_DRAIN_AFTER_S = 3600
# The cap on the drain's wait for running jobs: 2 h covers 284 of the 303 timeout-minutes in cmux's workflows (the
# longer ones are Linux jobs and notarization polls). Past it the marker goes, the finding alerts (impossible) with
# the job still running, and no drain starts again for TAILSCALE_RESTART_EVERY_S.
TAILSCALE_DRAIN_MAX_S = 2 * 3600
TAILSCALE_DRAIN_LAPSE_S = 600  # the marker's own until is this past the cap: a mini-health that stops leaves no hold
TAILSCALE_DRAIN_OWNER = "glaeda-mini-health"
TAILSCALE_DRAIN_STATE = "tailscale-drain.json"  # beside STATE: the last drain that hit the cap
RESERVATION_SCHEMA = "glaeda-reservation/v1"
# glaeda-disk's host_reservation is asked with this as its host-local file, so it answers for the fleet's reservation
# list only (the host-local marker is read here, where our own drain marker is told from anyone else's).
NO_LOCAL_RESERVATION = Path("/nonexistent/glaeda-mini-health/reservation.json")


def sh(argv: list[str], timeout: float = 15, env: dict[str, str] | None = None,
       cwd: str | None = None) -> tuple[int, str]:
    """(exit code, stdout); 127 when it could not run or timed out."""
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                           timeout=timeout, check=False, env=env, cwd=cwd)
    except (OSError, subprocess.SubprocessError):
        return 127, ""
    return p.returncode, p.stdout


def leaked_test_app_pids(table: dict[int, tuple[int, int, str, str]]) -> list[tuple[int, str]]:
    result: list[tuple[int, str]] = []
    for pid, _uid, _state, command in table.values():
        match = LEAKED_TEST_APP.search(command)
        if not match:
            continue
        owner = pid
        owned = False
        for _ in range(256):
            row = table.get(owner)
            if owner <= 1 or row is None:
                break
            if re.search(r"(?:^|/)Runner\.Worker(?:\s|$)", row[3]):
                owned = True
                break
            owner = row[1]
        if not owned:
            result.append((pid, match.group(1)))
    return result


class NoAnswer(str):
    """A gate's reason that is no answer (it could not read or run something), not a short wait: no restart is
    coming until someone fixes it, so tailscale_no_route reports it impossible."""


def finding(fid: str, severity: str, evidence: str, auto_fix: str, note: str = "") -> dict[str, Any]:
    return {"id": fid, "code": fid.split(":")[0], "severity": severity, "evidence": evidence[:300],
            "auto_fix": auto_fix, "note": note[:300]}


class Mini:
    """What the checks read and do on this mini. Tests replace the methods that touch the system."""

    def __init__(self, home: Path = HOME) -> None:
        self.home = home
        self.uid = os.getuid()
        self._hook: Any = None
        self.tailnet_route_ok = False  # check_tailscale saw the tailnet route on the tunnel this run
        self.route_on_tunnel = False  # route -n get named a utun this run, whatever the CLI said (ends a drain)

    def runner_dirs(self) -> list[Path]:
        return sorted(p for p in self.home.glob("actions-runner-glaeda*") if (p / "glaeda-hooks").is_dir())

    def hook(self) -> Any:
        """The runner hook module the jobs run (console state, testmanagerd recycler), or None."""
        if self._hook is None:
            dirs = self.runner_dirs()
            path = dirs[0] / "glaeda-hooks" / "glaeda-cmux-runner-hook" if dirs else None
            sys.dont_write_bytecode = True  # never a __pycache__ in the runner's glaeda-hooks
            try:
                loader = importlib.machinery.SourceFileLoader("glaeda_cmux_runner_hook_for_health", os.fspath(path))
                module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
                loader.exec_module(module)
                self._hook = module
            except Exception:  # noqa: BLE001  (an unreadable hook skips the checks that need it)
                self._hook = False
        return self._hook or None

    # ---- reads

    def ota_converge(self) -> dict[str, Any]:
        """glaeda-update's converge.json, or {} before an updater that writes one."""
        doc = load_json(self.home / OTA_CONVERGE)
        return doc if doc.get("schema") == "glaeda-ota-converge/v1" else {}

    def console(self) -> tuple[str, str | None] | None:
        hook = self.hook()
        state = hook.console_state() if hook is not None and hasattr(hook, "console_state") else None
        return (state.state, state.user) if state is not None else None

    def loginwindow(self) -> dict[str, Any]:
        try:
            return plistlib.loads(LOGINWINDOW.read_bytes())
        except (OSError, plistlib.InvalidFileException, ValueError):
            return {}

    def pmset(self) -> str:
        return sh(["/usr/bin/pmset", "-g"])[1]

    def processes(self) -> list[tuple[int, int, str, str]]:
        """(pid, uid, stat, command) for every process."""
        rows = []
        for line in sh(["/bin/ps", "-Aww", "-o", "pid=,uid=,stat=,command="])[1].splitlines():
            parts = line.split(None, 3)
            if len(parts) == 4 and parts[0].isdigit() and parts[1].isdigit():
                rows.append((int(parts[0]), int(parts[1]), parts[2], parts[3].strip()))
        return rows

    def process_tree(self) -> list[tuple[int, int, str]]:
        """(pid, ppid, command) for ownership checks that need ancestry."""
        rows = []
        for line in sh(["/bin/ps", "-axo", "pid=,ppid=,command="])[1].splitlines():
            parts = line.split(None, 2)
            if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
                rows.append((int(parts[0]), int(parts[1]), parts[2].strip() if len(parts) > 2 else ""))
        return rows

    def elapsed_s(self, pid: int) -> int | None:
        text = sh(["/bin/ps", "-o", "etime=", "-p", str(pid)])[1].strip()  # [[dd-]hh:]mm:ss
        m = re.fullmatch(r"(?:(?:(\d+)-)?(\d+):)?(\d+):(\d+)", text)
        if not m:
            return None
        d, h, mi, s = (int(x or 0) for x in m.groups())
        return ((d * 24 + h) * 60 + mi) * 60 + s

    def session_lines(self, pid: int, minutes: int) -> list[tuple[float, str]] | None:
        """(time, message) of the daemon's session lines over the last `minutes`, oldest first; None when the
        log could not be read (a timeout on a loaded mini)."""
        wanted = " OR ".join(f'eventMessage BEGINSWITH "{s}"' for s in SESSION_LINES[1:])
        predicate = f'processID == {pid} AND (eventMessage CONTAINS "{WEDGE_SIGNATURE}" OR {wanted})'
        code, out = sh(["/usr/bin/log", "show", "--last", f"{max(1, minutes)}m", "--style", "ndjson",
                        "--predicate", predicate], timeout=60)
        if code != 0:
            return None
        rows = []
        for line in out.splitlines():
            try:
                row = json.loads(line)
                at = datetime.datetime.strptime(row["timestamp"], "%Y-%m-%d %H:%M:%S.%f%z").timestamp()
            except (ValueError, KeyError, TypeError):
                continue
            rows.append((at, str(row.get("eventMessage") or "")))
        return sorted(rows, key=lambda r: r[0])

    def tailscale(self) -> tuple[str, str | None, str] | None:
        """(flavor app|standalone, BackendState, what the CLI said), or None without Tailscale. BackendState is None
        when the CLI gave none (timed out, failed, no JSON): a probe error, not a verdict on the tunnel."""
        # the standalone CLI, not the app's "Install CLI" link into Tailscale.app; else the app's own binary
        standalone = os.path.exists(TAILSCALE_STANDALONE) and "Tailscale.app" not in os.path.realpath(TAILSCALE_STANDALONE)
        cli = TAILSCALE_STANDALONE if standalone else TAILSCALE_APP if os.path.exists(TAILSCALE_APP) else None
        if cli is None:
            return None
        flavor = "standalone" if standalone else "app"
        try:
            p = subprocess.run([cli, "status", "--json"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                               errors="replace", timeout=15, check=False, env={**os.environ, **TAILSCALE_CLI_ENV})
        except subprocess.TimeoutExpired:
            return flavor, None, f"{cli} status --json timed out after 15 s"
        except (OSError, subprocess.SubprocessError) as e:
            return flavor, None, f"{cli} status --json could not run: {e}"
        try:
            state = json.loads(p.stdout).get("BackendState")
        except (ValueError, AttributeError):
            state = None
        if isinstance(state, str) and state:
            return flavor, state, ""
        said = " ".join((p.stderr + " " + p.stdout).split())[:160] or "no output"
        return flavor, None, f"{cli} status --json exited {p.returncode} without a BackendState: {said}"

    def tailnet_route(self) -> str | None:
        """The interface the OS sends Tailscale's own address (100.100.100.100) out of, or None if it cannot tell."""
        code, out = sh(["/sbin/route", "-n", "get", TAILNET_PROBE_IP], timeout=10)
        m = re.search(r"^\s*interface:\s*(\S+)", out, re.M) if code == 0 else None
        return m.group(1) if m else None

    def vpn_service(self) -> str | None:
        m = re.search(r"([0-9A-F-]{36}).*io\.tailscale\.", sh(["/usr/sbin/scutil", "--nc", "list"])[1])
        return m.group(1) if m else None

    def runner_registrations(self) -> list[dict[str, Any]]:
        """The listener gate's registration_deleted records (glaeda-cmux-runner-hook registration_file), one per
        runner GitHub no longer knows, for the runners this tool watches (runner_dirs(), as runner_agents()). A
        record whose runner was uninstalled (its directory or .runner gone) is stale: nothing will clear it."""
        out = []
        dirs = {d.name: d for d in self.runner_dirs()}
        for path in sorted((self.home / ".local/state/glaeda/cmux-runner").glob("registration-*.json")):
            doc = load_json(path)
            name = path.name[len("registration-"):-len(".json")]
            if doc.get("cause") == "registration_deleted" and name in dirs and (dirs[name] / ".runner").is_file():
                out.append({**doc, "dir": name})
        return out

    def runner_agents(self) -> list[tuple[str, bool, bool, str]]:
        """(label, loaded, running, last exit) for each runner LaunchAgent plist."""
        out = []
        for plist in sorted(AGENTS.glob("com.teamleaderleo.glaeda.cmux-runner*.plist")):
            label = plist.name[:-len(".plist")]
            if not RUNNER_AGENT.fullmatch(label):
                continue
            code, text = sh(["/bin/launchctl", "print", f"gui/{self.uid}/{label}"])
            if code == 127:
                continue  # launchctl did not answer in time (a loaded mini) or could not run: unknown, not unloaded
            state = re.search(r"^\s*state = (\S+)", text, re.M)
            last = re.search(r"^\s*last exit code = (.+)$", text, re.M)
            out.append((label, code == 0, bool(state and state.group(1) == "running"),
                        last.group(1).strip() if last else "?"))
        return out

    # ---- heals

    def recycle_testmanagerd(self) -> str | None:
        hook = self.hook()
        recycle = getattr(hook, "recycle_testmanagerd", None) if hook is not None else None
        return recycle() if recycle else None

    def tailscale_up(self) -> None:
        sh([TAILSCALE_APP, "up"], timeout=30, env={**os.environ, **TAILSCALE_CLI_ENV})

    def restart_vpn(self, service: str) -> None:
        sh(["/usr/sbin/scutil", "--nc", "stop", service])
        time.sleep(3)
        sh(["/usr/sbin/scutil", "--nc", "start", service])

    def kickstart(self, label: str) -> None:
        sh(["/bin/launchctl", "kickstart", f"gui/{self.uid}/{label}"])

    def sleep(self, seconds: float) -> None:
        time.sleep(seconds)

    def clock(self) -> float:
        return time.monotonic()

    def leaked_test_apps(self) -> list[tuple[int, str]]:
        hook = self.hook()
        try:
            rows = self.process_tree()
            if hook is not None and hasattr(hook, "leaked_test_app_pids"):
                table = {pid: (ppid, command) for pid, ppid, command in rows}
                return hook.leaked_test_app_pids(table)
            return leaked_test_app_pids({pid: (pid, ppid, "", command) for pid, ppid, command in rows})
        except Exception:
            return []

    def kill_leaked_test_apps(self) -> list[str]:
        hook = self.hook()
        if hook is not None and hasattr(hook, "cleanup_leaked_test_apps"):
            return hook.cleanup_leaked_test_apps()
        killed = []
        for pid, path in self.leaked_test_apps():
            if (pid, path) not in self.leaked_test_apps():
                continue
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                continue
            deadline = time.monotonic() + LEAKED_APP_TERM_S
            while pid in {p for p, *_ in self.process_tree()} and time.monotonic() < deadline:
                time.sleep(0.05)
            if pid in {p for p, *_ in self.process_tree()} and (pid, path) in self.leaked_test_apps():
                with contextlib.suppress(OSError):
                    os.kill(pid, signal.SIGKILL)
            if pid not in {p for p, *_ in self.process_tree()}:
                killed.append(f"killed pid {pid} {path}")
        return killed

    def node_refusal(self) -> str | None:
        """The reason the runner hook refuses every job here as an ineligible node, or None when it is eligible,
        its job-started hook does not require eligibility, or the hook cannot be read."""
        dirs = self.runner_dirs()
        try:
            text = (dirs[0] / "glaeda-hooks" / "job-started.sh").read_text(encoding="utf-8")
            argv = shlex.split(next(line for line in text.splitlines() if line.startswith("exec ")))
        except (IndexError, StopIteration, OSError, ValueError):
            return None

        if "--require-eligible" not in argv or "--fleet-class" not in argv[:-1]:
            return None
        hook = self.hook()
        fleet_class = argv[argv.index("--fleet-class") + 1]
        answer = getattr(hook, "node_answer", None) if hook is not None else None
        refusal = getattr(hook, "node_refusal", None) if hook is not None else None
        try:
            if answer is not None:
                why, _want, timed_out = answer(fleet_class)
                # A probe that ran out of time on a loaded mini is no answer: never node_ineligible, whose remedy
                # restages the generation and re-adopts a receipt that is fine.
                return None if timed_out else why
            return refusal(fleet_class)[0] if refusal is not None else None
        except Exception:  # noqa: BLE001  (a hook that cannot answer is no finding)
            return None

    def toolchain_mismatch(self) -> str | None:
        """Why xcrun on this host, in the env the runner gives its jobs, does not build with the runner's pool Xcode
        (the runner hook's xcode_refusal for its job-started hook's --toolchain-xcode), or None when it does, the
        runner names no pool Xcode, or the hook cannot answer."""
        dirs = self.runner_dirs()
        try:
            text = (dirs[0] / "glaeda-hooks" / "job-started.sh").read_text(encoding="utf-8")
            argv = shlex.split(next(line for line in text.splitlines() if line.startswith("exec ")))
        except (IndexError, StopIteration, OSError, ValueError):
            return None
        if "--toolchain-xcode" not in argv[:-1]:
            return None
        xcode = argv[argv.index("--toolchain-xcode") + 1]
        hook = self.hook()
        refusal = getattr(hook, "xcode_refusal", None) if hook is not None else None
        clean = getattr(hook, "listener_env", None) if hook is not None else None
        if refusal is None or clean is None:
            return None
        try:
            return refusal(xcode, clean(os.environ, xcode))
        except Exception:  # noqa: BLE001  (a hook that cannot answer is no finding)
            return None

    def install_rust_toolchain(self, toolchain: str) -> tuple[bool, str]:
        """Install one exact rustup toolchain named by the runner hook refusal."""
        if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+-[A-Za-z0-9][A-Za-z0-9.-]*", toolchain):
            return False, "refused unsafe Rust toolchain name"
        code, _ = sh(["rustup", "toolchain", "install", toolchain, "--profile", "minimal"],
                     timeout=RUST_TOOLCHAIN_MAX_S)
        if code != 0:
            return False, f"rustup toolchain install {toolchain} failed (exit {code})"
        listed_code, listed = sh(["rustup", "toolchain", "list"], timeout=30)
        if listed_code != 0 or not any(line.split()[0] == toolchain for line in listed.splitlines() if line.split()):
            return False, f"rustup installed {toolchain} but it is not listed afterward"
        return True, f"installed Rust toolchain {toolchain}"

    def daemon_policy(self) -> Path | None:
        """config/macos-daemons.json: the repo's or release's beside this script, else the copy mini-setup installs."""
        env = os.environ.get("GLAEDA_DAEMON_POLICY")
        for path in ([Path(env)] if env else []) + [SCRIPT_DIR.parent / "config/macos-daemons.json",
                                                     self.home / ".local/share/glaeda/macos-daemons.json"]:
            if path.is_file():
                return path
        return None

    def fleet_host(self) -> bool:
        """A fleet mini, not a personal Mac (mini-setup --hygiene-only). glaeda-update's own default: no setupArgs
        (or no update.json) means --hygiene-only."""
        return "--hygiene-only" not in load_json(self.home / ".config/glaeda/update.json").get(
            "setupArgs", ["--hygiene-only"])

    def claude_bin(self) -> Path | None:
        """The runner user's Claude Code (the capture jobs' agent), or None where it is not installed."""
        path = self.home / ".local/bin/claude"
        return path if os.access(path, os.X_OK) else None

    def claude_routes(self) -> dict[str, Any]:
        """config/claude-routes.json: the repo's or release's beside this script, else the copy mini-setup installs."""
        for path in (SCRIPT_DIR.parent / "config" / CLAUDE_ROUTES, self.home / ".local/share/glaeda" / CLAUDE_ROUTES):
            if path.is_file():
                return load_json(path)
        return {}

    def claude_settings(self) -> dict[str, Any]:
        return load_json(self.home / ".claude/settings.json")

    def claude_probe(self, url: str, token: str) -> tuple[bool, str]:
        """One `claude -p` through URL (--settings outranks ~/.claude/settings.json), without a personal token."""
        claude = self.claude_bin()
        if claude is None:
            return False, "no ~/.local/bin/claude"
        settings = json.dumps({"env": {"ANTHROPIC_BASE_URL": url, "ANTHROPIC_AUTH_TOKEN": token}})
        env = {k: v for k, v in os.environ.items() if k not in CLAUDE_PERSONAL}
        code, out = sh([os.fspath(claude), "-p", "--settings", settings, CLAUDE_PROMPT],
                       timeout=CLAUDE_PROBE_S, env=env, cwd=tempfile.gettempdir())
        if code == 0 and "PONG" in out:
            return True, "PONG"
        if code == 127:
            return False, f"no answer in {CLAUDE_PROBE_S} s"
        return False, f"exit {code}: {' '.join(out.split())[-160:]}"

    def set_claude_route(self, url: str, token: str) -> str:
        """Point ~/.claude/settings.json at URL, keeping every other setting and a backup of the file."""
        path = self.home / ".claude/settings.json"
        doc = load_json(path)
        backup = None
        if path.exists():
            backup = path.with_name(f"settings.json.bak-mini-health-{int(time.time())}")
            shutil.copy2(path, backup)
            os.chmod(backup, 0o600)
        env = doc.get("env") if isinstance(doc.get("env"), dict) else {}
        env = {k: v for k, v in env.items() if k not in CLAUDE_PERSONAL}
        env.update(ANTHROPIC_BASE_URL=url, ANTHROPIC_AUTH_TOKEN=token)
        doc["env"] = env
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name(path.name + ".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(doc, indent=2) + "\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
        return f"~/.claude/settings.json routes Claude to {url}" + (f" (was kept in {backup.name})" if backup else "")

    def claude_probe_last(self) -> dict[str, Any]:
        return load_json(self.home / ".local/state/glaeda/mini-health/claude-probe.json")

    def save_claude_probe(self, doc: dict[str, Any]) -> None:
        write_json(self.home / ".local/state/glaeda/mini-health/claude-probe.json", doc)

    def daemon_heal_status(self) -> dict[str, Any] | None:
        """glaeda-daemon-heal --status: is the root LaunchDaemon this release's copy; None off macOS or without it."""
        policy = self.daemon_policy()
        if sys.platform != "darwin" or policy is None or not DAEMON_HEAL.is_file():
            return None
        if not self.fleet_host():  # a personal Mac's daemons are its owner's
            return None
        code, out = sh([sys.executable, "-I", os.fspath(DAEMON_HEAL), "--status", "--policy", os.fspath(policy)])
        try:
            doc = json.loads(out) if code == 0 else None
        except ValueError:
            doc = None
        return doc if isinstance(doc, dict) else None

    def sudo_ok(self) -> bool:
        return sh(["/usr/bin/sudo", "-n", "/usr/bin/true"])[0] == 0

    def install_daemon_heal(self) -> tuple[bool, str]:
        policy = self.daemon_policy()
        if policy is None:
            return False, "no config/macos-daemons.json"
        code, out = sh(["/usr/bin/sudo", "-n", SYSTEM_PYTHON, "-I", os.fspath(DAEMON_HEAL), "--install",
                        "--policy", os.fspath(policy), "--apply"], timeout=60)
        try:
            state = json.loads(out).get("state")
        except (ValueError, AttributeError):
            state = None
        ok = code == 0 and state in {"applied", "unchanged"}
        return ok, f"sudo -n glaeda-daemon-heal --install --apply: {state or f'exit {code}'}"

    def disk_summary(self) -> dict[str, Any]:
        path = self.home / ".local/state/glaeda/disk/summary.json"
        return load_json(path)

    # ---- tailscale_no_route's restart: its gates' reads and the restart itself

    def tailscale_restart_off(self) -> str:
        return restart_switch_off(os.environ, os.path.lexists(TAILSCALE_RESTART_OFF))

    def tailnet_names(self) -> list[str] | None:
        """This node's tailnet HostName and DNS name (tailscale status --json's Self), or None when the CLI cannot say:
        it failed, timed out, printed no JSON or no Self name."""
        standalone = os.path.exists(TAILSCALE_STANDALONE) and "Tailscale.app" not in os.path.realpath(TAILSCALE_STANDALONE)
        cli = TAILSCALE_STANDALONE if standalone else TAILSCALE_APP if os.path.exists(TAILSCALE_APP) else None
        if cli is None:
            return None
        code, out = sh([cli, "status", "--json"], env={**os.environ, **TAILSCALE_CLI_ENV})
        try:
            me = json.loads(out).get("Self") if code == 0 else None
        except (ValueError, AttributeError):
            me = None
        if not isinstance(me, dict):
            return None
        names = [me.get("HostName"), me.get("DNSName").split(".")[0] if isinstance(me.get("DNSName"), str) else None]
        names = [name for name in names if isinstance(name, str) and name.strip()]
        return names or None

    def host_names(self) -> list[str] | None:
        """Every name this host goes by: hostname, LocalHostName, ComputerName, update.json's host and its tailnet
        name; None when the tailnet name cannot be read (the restart refuses: fail closed)."""
        tailnet = self.tailnet_names()
        if tailnet is None:
            return None
        names = [socket.gethostname()]
        for key in ("LocalHostName", "ComputerName"):
            names.append(sh(["/usr/sbin/scutil", "--get", key], timeout=5)[1].strip())
        host = load_json(self.home / ".config/glaeda/update.json").get("host")
        names.append(host if isinstance(host, str) else "")
        return [name for name in names + tailnet if name]

    def tailscale_opt_in(self) -> tuple[dict[str, Any] | None, str]:
        """(the registry's opt-in for this host's Tailscale restart, "") or (None, why there is none)."""
        path = self.home / TAILSCALE_OPT_IN
        try:
            doc = json.loads(path.read_text())
        except FileNotFoundError:
            return None, f"no ~/{TAILSCALE_OPT_IN} (the fleet registry has not opted this host in)"
        except (OSError, ValueError) as error:
            return None, f"~/{TAILSCALE_OPT_IN} is unreadable ({type(error).__name__})"
        if not isinstance(doc, dict):
            return None, f"~/{TAILSCALE_OPT_IN} is unreadable (not a JSON object)"
        return doc, ""

    def ci_mini_facts(self) -> dict[str, Any]:
        """What makes this a CI runner mini, as glaeda set it up: registered glaeda runners (a .runner beside the
        hooks), update.json's setupArgs (None when missing or unreadable: no answer) and mini-setup's role."""
        try:
            runners: int | None = sum(1 for d in self.runner_dirs() if (d / ".runner").is_file())
        except OSError:
            runners = None
        setup_args: list[str] | None = None
        try:
            doc = json.loads((self.home / ".config/glaeda/update.json").read_text())
            args = doc.get("setupArgs", ["--hygiene-only"]) if isinstance(doc, dict) else None  # glaeda-update's default
            if isinstance(args, list) and all(isinstance(a, str) for a in args):
                setup_args = args
        except (OSError, ValueError):
            pass
        receipt = load_json(self.home / ".local/state/glaeda/mini-setup/receipt.json")
        role = receipt.get("role")
        if "role" in receipt and not isinstance(role, str):
            role = None  # a role that is no string is unreadable: no role, not a fallback
        elif role not in {"fleet-mini", "devbox"}:  # mini-setup's reading of old receipts
            role = "fleet-mini" if receipt.get("profile") == "build-host" else None
        return {"platform": sys.platform, "runners": runners, "setup_args": setup_args, "role": role}

    def disk_path(self) -> Path:
        return Path(os.environ.get("GLAEDA_DISK") or SCRIPT_DIR / "glaeda-disk")

    def disk_module(self) -> Any:
        """glaeda-disk, for its host gate (host_busy) and job patterns: the idle check glaeda-idle-repair uses."""
        if getattr(self, "_disk", None) is None:
            sys.dont_write_bytecode = True
            loader = importlib.machinery.SourceFileLoader("glaeda_disk_for_health", os.fspath(self.disk_path()))
            module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
            sys.modules[loader.name] = module  # its dataclasses look their module up there while it loads
            try:
                loader.exec_module(module)
            except BaseException:
                sys.modules.pop(loader.name, None)
                raise
            self._disk = module
        return self._disk

    def host_busy(self) -> str:
        """glaeda-disk's host_busy (a CI job or build, a dev-build worker job, a reservation, the host lock held), or
        why it could not answer: anything it cannot read is busy."""
        try:
            disk = self.disk_module()
            busy = disk.host_busy(FLEET_DIR)
            unreadable = disk.host_busy_unreadable(busy) if isinstance(busy, str) and busy else False
        except Exception as error:  # noqa: BLE001  (no answer is not idle)
            return NoAnswer(f"glaeda-disk's host gate could not answer ({type(error).__name__})")
        if not isinstance(busy, str):
            return NoAnswer("glaeda-disk's host gate gave no answer")
        return NoAnswer(busy) if unreadable else busy

    def jobs_running(self) -> str:
        """After the host lock is held: a CI job or build that started before it was, by glaeda-disk's patterns."""
        try:
            disk = self.disk_module()
            patterns = (disk.CI_WORKER, disk.BUILD_PROCESS)
        except Exception as error:  # noqa: BLE001
            return NoAnswer(f"glaeda-disk's job patterns could not be read ({type(error).__name__})")
        rows = self.processes()
        if not rows:
            return NoAnswer("cannot list processes")
        for _pid, _uid, _stat, command in rows:
            if any(p.search(command) for p in patterns):
                return f"a CI job or build is running ({command[:120]})"
        return self.listener_taking()

    def listener_taking(self) -> str:
        """A runner whose listener has acknowledged a job and not finished it (the runner hook's listener_request):
        between the acknowledge and its Runner.Worker the job is this runner's, and no Worker shows it yet. Read
        with the hook the runner runs; no hook, or a diag it cannot read, is no answer."""
        dirs = self.runner_dirs()
        if not dirs:
            return ""
        hook = self.hook()
        taking = getattr(hook, "listener_request", None) if hook is not None else None
        if taking is None:
            return NoAnswer("the runner hook's listener_request could not be loaded")
        for d in dirs:
            try:
                request = taking(d)
            except (OSError, ValueError) as error:
                return NoAnswer(f"cannot read {d.name}'s listener log ({type(error).__name__})")
            if request:
                return f"{d.name}'s listener took job {str(request)[:60]} and its Worker has not finished it"
        return ""

    @contextlib.contextmanager
    def hold_host_lock(self):
        """Hold the fleet host lock exclusively, as with-host-lock and a fleet build do, so no job is admitted (the
        runner hook refuses or waits, and idle listeners stop) while Tailscale restarts. Yields "" when held, else why
        not; never waits."""
        if not FLEET_DIR.is_dir() or FLEET_DIR.is_symlink():
            yield NoAnswer(f"no fleet dir {FLEET_DIR}: nothing would hold jobs off during the restart")
            return
        try:
            fd = os.open(FLEET_DIR / "host.lock", os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o660)
        except OSError as error:
            yield NoAnswer(f"cannot open the fleet host lock ({type(error).__name__})")
            return
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                yield "a job or a fleet build holds the fleet host lock"
                return
            yield ""
        finally:
            os.close(fd)  # closing the only fd drops the flock

    def sudo_allows(self, argv: list[str]) -> bool:
        """Whether sudoers lets this user run exactly argv (after `sudo -n`) as root without a password; runs nothing.
        `sudo -n -l <cmd>` exits 0 for a rule that still asks for a password, so the rules listing is read instead."""
        code, out = sh(["/usr/bin/sudo", "-n", "-l"], timeout=10)
        return code == 0 and sudo_nopasswd(out, " ".join(argv[2:]))

    def run_restart(self, commands: list[list[str]]) -> tuple[bool, str]:
        said = []
        for i, argv in enumerate(commands):
            if i:
                self.sleep(3)
            code = sh(argv, timeout=30)[0]
            said.append(f"{' '.join(argv)}: exit {code}")
        return all(s.endswith(": exit 0") for s in said), "; ".join(said)

    # ---- the drain before tailscale_no_route's restart

    def reservation_path(self) -> Path:
        return FLEET_DIR / "reservation.json"

    def host_reservation(self) -> tuple[str, dict[str, Any] | None]:
        """The host-local reservation marker: ("none", None), ("ours", marker) for a drain's, ("other", marker or
        None) for anyone else's or one that cannot be read (never ours to remove). An "ours" marker carries the
        exact bytes read under "raw", which end_drain compares before it removes anything."""
        try:
            raw = self.reservation_path().read_bytes()
            doc = json.loads(raw)
        except FileNotFoundError:
            return "none", None
        except (OSError, ValueError):
            return "other", None
        if not isinstance(doc, dict):
            return "other", None
        ours = (doc.get("schema") == RESERVATION_SCHEMA and doc.get("owner") == TAILSCALE_DRAIN_OWNER
                and isinstance(doc.get("since"), int) and not isinstance(doc.get("since"), bool)
                and isinstance(doc.get("until"), int) and not isinstance(doc.get("until"), bool))
        return ("ours", {**doc, "raw": raw}) if ours else ("other", doc)

    def fleet_reservation(self) -> str:
        """Why the fleet's reservation list holds this host (glaeda-disk's host_reservation, glaeda#1626: cmux16-24 are
        Lawrence's until 2026-10-28), "" when it does not. No answer is reserved: no drain on a guess."""
        try:
            why = self.disk_module().host_reservation(local=NO_LOCAL_RESERVATION)
        except Exception as error:  # noqa: BLE001
            return NoAnswer(f"glaeda-disk cannot say whether the fleet reserved this host ({type(error).__name__})")
        return why if isinstance(why, str) else NoAnswer("glaeda-disk's host_reservation gave no answer")

    @contextlib.contextmanager
    def reservation_lock(self):
        """glaeda-mini-fleet's writer lock, FLEET_DIR/.reservation.lock (flock, exclusive): a reserve or release
        there and a drain here never interleave their check and their write. Yields "" when held, else why not
        (it waits at most 20 s, as mini-fleet does)."""
        path = FLEET_DIR / ".reservation.lock"
        if not FLEET_DIR.is_dir() or FLEET_DIR.is_symlink() or path.is_symlink():
            yield f"no usable fleet dir or reservation lock at {FLEET_DIR}"
            return
        try:
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o664)
        except OSError as error:
            yield f"cannot open {path} ({type(error).__name__})"
            return
        try:
            deadline = time.monotonic() + 20
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except OSError:
                    if time.monotonic() >= deadline:
                        yield "another reserve or release is still running on this host"
                        return
                    time.sleep(0.2)
            yield ""
        finally:
            os.close(fd)

    def start_drain(self, now: float, purpose: str) -> str:
        """Write a drain's reservation marker, never over another one: "" when written, else why not."""
        marker = {"schema": RESERVATION_SCHEMA, "owner": TAILSCALE_DRAIN_OWNER, "purpose": purpose[:300],
                  "since": int(now), "until": int(now + TAILSCALE_DRAIN_MAX_S + TAILSCALE_DRAIN_LAPSE_S)}
        path = self.reservation_path()
        with self.reservation_lock() as locked:
            if locked:
                return locked
            tmp = path.with_name(f".reservation.json.health-{os.getpid()}")
            try:
                tmp.write_text(json.dumps(marker) + "\n")
                os.chmod(tmp, 0o664)
                os.link(tmp, path)  # fails if any marker is there: a reservation is never overwritten
            except FileExistsError:
                return "another reservation appeared"
            except OSError as error:
                return f"cannot write {path} ({type(error).__name__})"
            finally:
                with contextlib.suppress(OSError):
                    tmp.unlink()
        return ""

    def end_drain(self, seen: dict[str, Any] | None) -> bool:
        """Remove the drain marker seen (host_reservation's "ours" marker), under the writer lock and only while
        the file still holds exactly those bytes: a marker anyone wrote since is never removed. True when removed."""
        if not seen or "raw" not in seen:
            return False
        path = self.reservation_path()
        with self.reservation_lock() as locked:
            if locked:
                return False
            try:
                if path.is_symlink() or path.read_bytes() != seen["raw"]:
                    return False
                path.unlink()
                return True
            except OSError:
                return False

    def drain_busy(self) -> str:
        """While draining: what still runs (host_busy without the reservation, which is our own marker). The host
        lock is checked when the restart takes it."""
        busy = self.jobs_running()
        if busy:
            return busy
        jobs = FLEET_DIR / "jobs"
        try:
            with os.scandir(jobs) as it:
                if any(not e.name.startswith(".") for e in it):
                    return f"a dev-build worker job is in {jobs}"
        except FileNotFoundError:
            pass
        except OSError:
            return NoAnswer(f"cannot read {jobs}")
        return ""


# ---------------------------------------------------------------- checks


def check_console(mini: Mini) -> list[dict[str, Any]]:
    got = mini.console()
    if got is None or got[0] == "unlocked":
        return []
    state, user = got
    if state == "locked":
        return [finding("console_locked", "error", f"the console session ({user}) is screen-locked "
                        "(CGSSessionScreenIsLocked)", "impossible",
                        "GUI jobs are refused here until it is unlocked; needs root and a reboot")]
    return [finding("console_no_user", "error", "nobody is logged in at the console", "impossible",
                    "GUI jobs are refused here; the mini should auto-login its runner user")]


def check_power(mini: Mini) -> list[dict[str, Any]]:
    out = []
    if mini.loginwindow().get("autoLoginUserScreenLocked"):
        out.append(finding("autologin_locks", "warn", "loginwindow autoLoginUserScreenLocked is set: every "
                           "auto-login starts screen-locked", "impossible", "root: delete the key"))
    m = re.search(r"^\s*displaysleep\s+(\d+)", mini.pmset(), re.M)
    if m and m.group(1) != "0":
        out.append(finding("display_sleep", "warn", f"display sleep is {m.group(1)} min; the screen lock "
                           "follows it", "impossible", "root: pmset -a displaysleep 0"))
    return out


def check_leaked_test_apps(mini: Mini) -> list[dict[str, Any]]:
    apps = mini.leaked_test_apps()
    if not apps:
        return []
    return [finding("leaked_test_apps", "warn", f"{len(apps)} orphaned cmux DEV.app process(es) under runner _temp",
                    "pending", "killed by the runner post-job hook or mini-health backstop")]


def check_disk_accounting(mini: Mini) -> list[dict[str, Any]]:
    summary = mini.disk_summary()
    if summary.get("schema") != "glaeda-disk/v1":
        return []
    findings: list[dict[str, Any]] = []
    eviction_paths: list[str] = []
    eviction_path_seen: set[str] = set()
    eviction_path_count = 0
    eviction_count = 0
    eviction_severity = "warn"
    eviction_auto_fix = "pending"
    eviction_evidence = "du measurement timed out"
    for entry in summary.get("findings") or []:
        if not isinstance(entry, dict) or not entry.get("id"):
            continue
        if entry.get("id") == "eviction_stuck":
            if not eviction_evidence or eviction_evidence == "du measurement timed out":
                evidence = entry.get("evidence")
                if isinstance(evidence, str) and evidence:
                    eviction_evidence = evidence
            path = entry.get("path")
            if isinstance(path, str) and path and path not in eviction_path_seen:
                eviction_path_seen.add(path)
                eviction_path_count += 1
                if len(eviction_paths) < 32:
                    eviction_paths.append(path)
            count = entry.get("count", 1)
            try:
                count = max(1, int(count)) if not isinstance(count, bool) else 1
            except (TypeError, ValueError, OverflowError):
                count = 1
            eviction_count += count
            if entry.get("severity") == "error":
                eviction_severity = "error"
            if entry.get("auto_fix") == "impossible":
                eviction_auto_fix = "impossible"
            continue
        evidence = str(entry.get("evidence") or entry.get("path") or "disk eviction finding")
        findings.append(finding(str(entry["id"]), str(entry.get("severity") or "warn"), evidence,
                                str(entry.get("auto_fix") or "pending"), "glaeda-disk reported this finding"))
    if eviction_count:
        aggregate = finding("eviction_stuck", eviction_severity,
                            f"{eviction_evidence} on {eviction_count} path(s) "
                            f"({len(eviction_paths)} unique)", eviction_auto_fix,
                            "glaeda-disk reported repeated measurement timeouts")
        aggregate["timeout_count"] = eviction_count
        aggregate["path_count"] = eviction_path_count
        aggregate["paths"] = eviction_paths
        if eviction_path_count > len(aggregate["paths"]):
            aggregate["paths_truncated"] = eviction_path_count - len(aggregate["paths"])
        observed_at = summary.get("at")
        if isinstance(observed_at, (int, float)) and not isinstance(observed_at, bool):
            aggregate["observed_at"] = observed_at
        findings.append(aggregate)
    contention = summary.get("eviction_contention")
    if isinstance(contention, dict):
        owner = contention.get("owner")
        if not isinstance(owner, dict):
            owner = {}
        pid = owner.get("pid", "?")
        account = owner.get("owner", "unknown")
        state = owner.get("state", "unknown")
        findings.append(finding("eviction_contention", "warn",
                                f"eviction skipped while pid {pid} ({account}, {state}) held the lock",
                                "impossible", "the next scheduled pass retries; live scans are never killed"))
    accounting = summary.get("accounting") or []
    # The enrolled-runner profile deliberately measures only its rebuildable cache allowlist.
    # Its df-used remainder includes unrelated system and account data, so comparing it with the
    # whole APFS volume would produce a permanent false-positive warning. The profile still reports
    # its measured and reclaimable bytes in the disk summary; only the volume-gap warning is scoped out.
    if accounting and all(isinstance(x, dict) and x.get("scope") == "runner-cache-profile"
                          for x in accounting):
        return findings
    missing = sum(float(x.get("accounting_gap", x.get("unclassified", x.get("unmeasured")))) for x in accounting
                  if isinstance(x, dict) and isinstance(x.get("accounting_gap", x.get("unclassified", x.get("unmeasured"))), (int, float)))
    if missing < 1 * 1024**3:
        return findings
    top: list[str] = []
    for x in accounting:
        for entry in (x.get("top_level") or []) if isinstance(x, dict) else []:
            if isinstance(entry, dict) and entry.get("path") and isinstance(entry.get("bytes"), (int, float)):
                top.append(f"{entry['path']} {entry['bytes'] / 1024**3:.1f} GiB")
    where = "; top level: " + ", ".join(top[:5]) if top else ""
    findings.append(finding("disk_unmeasured", "warn", f"{missing / 1024**3:.1f} GiB used space remains outside measured items and complete shared-runner coverage{where}",
                            "pending", "glaeda-disk reports bounded known-heavy roots and refreshes their accounting"))
    return findings


def check_testmanagerd(mini: Mini, now: float) -> list[dict[str, Any]] | None:
    """None when it cannot judge (a test runs, or no hook): the last report's finding stands."""
    hook = mini.hook()
    busy = getattr(hook, "XCTEST_RUNNING", XCTEST_RUNNING) if hook is not None else XCTEST_RUNNING
    rows = [r for r in mini.processes() if not r[2].startswith("Z") and "E" not in r[2]]  # gone or exiting
    if any(busy.search(c) for _, _, _, c in rows):
        return None
    daemons = [pid for pid, uid, _, c in rows if uid == mini.uid and (c == TESTMANAGERD or c.startswith(TESTMANAGERD + " "))]
    if not daemons:
        return []
    pid = daemons[0]
    age = mini.elapsed_s(pid)
    lines = mini.session_lines(pid, min(LOG_WINDOW_MIN, age // 60 + 1) if age else LOG_WINDOW_MIN)
    if lines is None:
        return None
    if not lines or WEDGE_SIGNATURE not in lines[-1][1] or now - lines[-1][0] < WEDGE_AGE_S:
        return []
    at = datetime.datetime.fromtimestamp(lines[-1][0]).strftime("%H:%M:%S")
    return [finding("testmanagerd_wedged", "error", f"testmanagerd pid {pid} stopped mid-teardown at {at} "
                    f"(last line: {WEDGE_SIGNATURE}); every XCTest run here hangs", "pending",
                    "stopped while no test runs; launchd starts a fresh one at the next test")]


def check_tailscale(mini: Mini) -> list[dict[str, Any]]:
    mini.tailnet_route_ok = False  # seen clear this run: tailscale_no_route's failed restarts start again from 0
    mini.route_on_tunnel = False
    got = mini.tailscale()
    if got is None:  # a runner host is on the tailnet: no CLI to ask is no answer, not a healthy tunnel
        if not mini.runner_agents():
            return []
        return [finding("tailscale_cli_missing", "warn", f"no Tailscale CLI at {TAILSCALE_STANDALONE} (standalone) "
                        f"or {TAILSCALE_APP} (app) on a runner host: the tunnel is not checked", "impossible",
                        "install Tailscale (the standalone tailscaled or the app) as the mini's setup does")]
    if got[1] == "Running":
        via = mini.tailnet_route()
        if via is None:  # route -n get named no interface (a loaded mini): the check could not look, as above
            return [finding("tailscale_probe_error", "warn", f"/sbin/route -n get {TAILNET_PROBE_IP} named no "
                            "interface", "impossible", "the probe could not read the tailnet route; the tunnel "
                            "is not judged on it")]
        if via.startswith("utun"):
            mini.tailnet_route_ok = mini.route_on_tunnel = True
            return []
        f = finding("tailscale_no_route", "error", f"Tailscale ({got[0]}) BackendState Running, but the OS "
                    f"routes {TAILNET_PROBE_IP} out of {via}, not the tunnel: no tailnet host reaches ssh here",
                    "pending", restart_fix(got[0]))
        f["flavor"] = got[0]  # which restart heal_tailscale_route runs
        return [f]
    flavor, state, said = got
    if state is None:
        # The CLI times out on a loaded mini (cmuxs-mac-mini-5, 2026-10-26, every other run), but the route is
        # its own look: off the tunnel is tailscale_no_route whatever the CLI said, so the timeout cannot mask it.
        via = mini.tailnet_route()
        mini.route_on_tunnel = via is not None and via.startswith("utun")
        if via is not None and not via.startswith("utun"):
            f = finding("tailscale_no_route", "error", f"Tailscale ({flavor}) gave no BackendState ({said[:80]}), and "
                        f"the OS routes {TAILNET_PROBE_IP} out of {via}, not the tunnel: no tailnet host reaches ssh "
                        "here", "pending", restart_fix(flavor))
            f["flavor"] = flavor
            return [f]
        # otherwise the check could not look: never a tailscale_down, a heal or an unstick on a guess
        return [finding("tailscale_probe_error", "warn", said, "impossible",
                        "the probe got no BackendState from the Tailscale CLI; the tunnel is not judged down on it")]
    evidence = f"Tailscale BackendState {state}"
    if flavor == "standalone":
        return [finding("tailscale_down", "error", evidence + " (standalone tailscaled)", "impossible",
                        "root: sudo launchctl kickstart -k system/com.tailscale.tailscaled")]
    if state.startswith("Needs"):
        return [finding("tailscale_down", "error", evidence, "impossible", "a person logs the node in")]
    return [finding("tailscale_down", "error", evidence, "pending",
                    "tailscale up when Stopped, else a stop and start of the Tailscale VPN service")]


def check_runners(mini: Mini) -> list[dict[str, Any]]:
    out = []
    for doc in mini.runner_registrations():
        agent = re.fullmatch(r"actions-runner-glaeda(?:-(\d+))?", doc["dir"])
        agent = (agent.group(1) or "0") if agent else doc["dir"]
        out.append(finding(f"registration_deleted:{agent}", "error",
                           f"GitHub deleted runner {doc.get('runner') or doc['dir']}'s registration "
                           f"({doc.get('exits')} listener exit(s) since {doc.get('first_seen')})", "impossible",
                           "the mini holds no admin token: re-register it from an operator host "
                           "(glaeda-cmux-runner with a runner token); the gate retries every 10 minutes"))
    for label, loaded, running, last in mini.runner_agents():
        agent = label.rsplit(".", 1)[1] if label[-1].isdigit() else "0"
        if (HELD / ("actions-runner-glaeda" + ("" if agent == "0" else f"-{agent}"))).exists():
            continue  # cmux_mini_fix.sh runner_hold stopped it on purpose (an ineligible node)
        if not loaded:
            out.append(finding(f"runner_unloaded:{agent}", "error", f"{label} is not loaded", "impossible",
                               "glaeda-cmux-runner-fleet --apply loads it"))
        elif not running:
            out.append(finding(f"runner_stopped:{agent}", "error", f"{label} is loaded but not running "
                               f"(last exit code {last})", "pending", "launchctl kickstart"))
    return out


def check_node_eligibility(mini: Mini) -> list[dict[str, Any]]:
    why = mini.node_refusal()
    if not why:
        return []
    match = RUST_TOOLCHAIN_RE.search(why)
    if match:
        toolchain = match.group(1)
        return [finding(f"node_toolchain_missing:{toolchain}", "error", why, "pending",
                        f"rustup will install the exact missing toolchain {toolchain}; no receipt or enrollment state is changed")]
    return [finding("node_ineligible", "error", why, "impossible",
                    "job-started refuses every job here; restage the class receipt's generation or re-enroll "
                    "(docs/CMUX_FLEET_ENROLLMENT.md)")]


def check_toolchain(mini: Mini) -> list[dict[str, Any]]:
    why = mini.toolchain_mismatch()
    if not why:
        return []
    return [finding("toolchain_mismatch", "error", why, "impossible",
                    "job-started refuses every job and the gate holds the listener off; root: move "
                    "/Library/Developer/CommandLineTools aside (or xcode-select -s the pool Xcode), then the next "
                    "look admits the host")]


def utc(stamp: Any) -> float | None:
    try:
        return datetime.datetime.strptime(str(stamp), "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=datetime.timezone.utc).timestamp()
    except ValueError:
        return None


def ota_summary(doc: dict[str, Any]) -> dict[str, Any] | None:
    """The report's `ota`: what the host runs, what its ring wants, and why they differ (converge.json)."""
    if not doc:
        return None
    running = doc.get("running") or {}
    return {"at": doc.get("at"), "running": running.get("tag"), "wants": (doc.get("wants") or {}).get("tag"),
            "converged": doc.get("converged"), "why": (doc.get("why") or [])[:5], "since": doc.get("since"),
            "blocking": doc.get("blocking"), "toolDrift": (running.get("tools") or {}).get("drift") or [],
            "hooks": [{"runner": Path(str(h.get("runnerDir") or h.get("receipt") or "?")).name,
                       "sha256": h.get("glaeda-cmux-runner-hook"), "current": h.get("current")}
                      for h in running.get("hooks") or []]}


def check_ota(mini: Mini, now: float) -> list[dict[str, Any]]:
    doc = mini.ota_converge()
    if not doc:
        return []
    out = []
    stale = utc(doc.get("staleAfter"))
    if stale is None or now >= stale:
        out.append(finding("ota_stale", "warn", f"no glaeda-update run has finished since {doc.get('at') or '?'}",
                           "impossible", "glaeda-update --status says why; its agent should run every 10 min"))
    alert = utc(doc.get("alertAfter"))
    if doc.get("converged") is not False or alert is None or now < alert:
        return out
    running = (doc.get("running") or {}).get("tag") or "no release"
    wants = (doc.get("wants") or {}).get("tag") or "nothing"
    evidence = f"running {running}, wants {wants}, because " + "; ".join(str(w) for w in doc.get("why") or ["?"])
    if doc.get("blocking"):
        out.append(finding("ota_not_converging", "error", evidence, "impossible",
                           "retrying the same release cannot fix this: a newer release, or glaeda-cmux-runner "
                           "--apply for a hook it will not replace"))
    else:
        out.append(finding("ota_not_converging", "warn", evidence, "pending",
                           f"glaeda-update retries with backoff ({doc.get('attempts')} tries since "
                           f"{doc.get('since')}; next {doc.get('nextAttempt')})"))
    return out


def daemon_heal_command(mini: Mini) -> str:
    """The operator's root step. The hashes come from the release, not this host: the runner user can edit these files."""
    policy = mini.daemon_policy()
    return (f"sudo {SYSTEM_PYTHON} -I {DAEMON_HEAL} --install --policy {policy} --apply "
            "--expect-sha256 $(git show <release commit this host runs>:scripts/glaeda-daemon-heal | shasum -a 256) "
            "--expect-policy-sha256 $(git show <that commit>:config/macos-daemons.json | shasum -a 256)")


def check_daemon_heal(mini: Mini) -> list[dict[str, Any]]:
    status = mini.daemon_heal_status()
    if status is None:
        return []
    out = []
    why = None
    fixable = True
    verdict = status.get("verdict")
    if isinstance(verdict, dict) and verdict.get("state") in ("current", "stale", "missing"):
        # A copy that keeps itself on stable: its own report says whether it does, not this user's release bytes.
        if verdict["state"] != "current":
            why = str(verdict.get("why") or verdict["state"])[:300]
            fixable = verdict.get("reinstall") is not False
        elif status.get("loaded") is False:  # a report from before it was booted out reads current for a while
            why = "the root daemon-heal LaunchDaemon is installed but not loaded"
    elif not status.get("installed"):
        why = "the root daemon-heal LaunchDaemon is not installed"
    elif not status.get("current"):
        why = "the root daemon-heal LaunchDaemon is not this release's copy: " + ", ".join(status.get("stale") or [])
    elif status.get("loaded") is False:
        why = "the root daemon-heal LaunchDaemon is installed but not loaded"
    elif not status.get("reportFresh"):  # loaded, or launchctl could not say: an old report alone means no passes
        age = status.get("reportAgeS")
        why = ("the root daemon-heal LaunchDaemon is loaded but its report is "
               + ("missing" if age is None else f"{age} s old") + ": its passes are not running")
    if why and not fixable:  # a reinstall cannot make it read its channel or take a release it refused
        out.append(finding("daemon_heal_stale", "warn", why, "impossible",
                           "its report's release.error says why; it retries every release.every_s"))
    elif why:
        out.append(finding("daemon_heal_stale", "warn", why,
                           "pending" if mini.sudo_ok() else "impossible",
                           "reinstalled with sudo -n" if mini.sudo_ok() else
                           "no passwordless sudo here; root: " + daemon_heal_command(mini)))
    if status.get("installed"):
        report = load_json(Path(str(status.get("report") or "")))
        mini.daemon_healed = [  # the root daemon's restarts, in this report's healed list for ci-dash
            {"id": f"daemon_hot:{h['name']}", "code": "daemon_hot", "t": h.get("t") or 0, "at": h.get("at"),
             "since": h.get("since"), "evidence": f"{h['name']} at {h.get('cores')} cores",
             "action": str(h.get("action") or "")[:200], "auto_fix": "done"}
            for h in report.get("healed") or [] if isinstance(h, dict) and h.get("name")]
        for h in report.get("hot") or []:
            if not isinstance(h, dict) or not h.get("name"):
                continue
            hours = (h.get("hot_for_s") or 0) / 3600
            out.append(finding(f"daemon_hot:{h['name']}", "warn",
                               f"{h['name']} (macOS, pid {h.get('pid')}) has used {h.get('cores')} cores for "
                               f"{hours:.1f} h, since {h.get('since')}", "pending",
                               f"the root glaeda-daemon-heal restarts it: {h.get('waiting') or 'next pass'}"))
    return out


def claude_route_settings(mini: Mini) -> tuple[list[str], dict[str, Any]]:
    """(the fleet routes, the env of ~/.claude/settings.json)."""
    routes = [r for r in mini.claude_routes().get("routes") or [] if isinstance(r, str) and r]
    env = mini.claude_settings().get("env")
    return routes, env if isinstance(env, dict) else {}


def check_claude_route(mini: Mini, now: float, remember: bool = True,
                       tunnel_down: bool = False) -> list[dict[str, Any]]:
    """Claude Code goes through a fleet route that answers a real `claude -p`, checked once per probe_every_s
    (remember=False, a check-only run: the probe's answer is not kept). tunnel_down (TUNNEL_DOWN seen this run):
    without a fresh cached answer it is not probed (a probe through a broken tunnel hangs up to 60 s every run)."""
    if mini.claude_bin() is None or not mini.fleet_host():  # a personal Mac's Claude login is its owner's
        return []
    routes, env = claude_route_settings(mini)
    if not routes:
        return []
    url, token = env.get("ANTHROPIC_BASE_URL"), env.get("ANTHROPIC_AUTH_TOKEN")
    note = "rerouted to the first fleet route in config/claude-routes.json that answers; until then capture-host " \
           "admits no capture lease here"
    personal = [k for k in CLAUDE_PERSONAL if env.get(k)]
    if personal:
        why = f"~/.claude/settings.json sets {', '.join(personal)}, a personal login that overrides the fleet route"
    elif not url:
        why = "~/.claude/settings.json sets no ANTHROPIC_BASE_URL, so Claude uses a personal login, which expires"
    elif url not in routes:
        why = f"~/.claude/settings.json routes Claude to {url}, not a fleet route ({', '.join(routes)})"
    elif not token:
        why = f"~/.claude/settings.json routes Claude to {url} with no ANTHROPIC_AUTH_TOKEN placeholder"
    else:
        why = None
    if why:
        return [finding("claude_route", "error", why, "pending", note)]
    last = mini.claude_probe_last()
    every = mini.claude_routes().get("probe_every_s") or 1800
    if last.get("route") == url and 0 <= now - (last.get("at") or 0) < every:
        ok, detail = bool(last.get("ok")), str(last.get("detail") or "")
    elif tunnel_down:  # the finding stays (capture-host stays closed); the first run after recovery probes
        return [finding("claude_route", "error", "not probed: the Tailscale tunnel is down", "pending", note)]
    else:
        ok, detail = mini.claude_probe(url, token)
        if remember:
            mini.save_claude_probe({"at": now, "at_iso": iso(now), "route": url, "ok": ok, "detail": detail})
    if ok:
        return []
    return [finding("claude_route", "error", f"`claude -p` through {url}: {detail}", "pending", note)]


# ---------------------------------------------------------------- heals


def heal_claude_route(mini: Mini, f: dict[str, Any]) -> tuple[bool, str]:
    """Route Claude to the first fleet route that answers, in the config's order; a route whose probe just failed
    is tried last. The token is the config's placeholder unless Claude already went to a fleet route with one (a
    token meant for another URL never goes to a gateway)."""
    routes, env = claude_route_settings(mini)
    current = env.get("ANTHROPIC_BASE_URL")
    token = (env.get("ANTHROPIC_AUTH_TOKEN") if current in routes else None) or mini.claude_routes().get("placeholder")
    if not token:
        return False, "config/claude-routes.json has no placeholder token"
    failed_route = current if f.get("evidence", "").startswith("`claude -p` through ") else None
    order = [r for r in routes if r != failed_route] + [r for r in routes if r == failed_route]
    failed = []
    for url in order:
        ok, detail = mini.claude_probe(url, token)
        if ok:
            what = mini.set_claude_route(url, token)
            at = time.time()
            mini.save_claude_probe({"at": at, "at_iso": iso(at), "route": url, "ok": True, "detail": detail})
            return True, what
        failed.append(f"{url}: {detail}")
    return False, "no fleet route answered: " + "; ".join(failed)



def heal_testmanagerd(mini: Mini, f: dict[str, Any]) -> tuple[bool, str]:
    note = mini.recycle_testmanagerd()
    if note is None:
        return False, "this runner hook has no testmanagerd recycler yet (glaeda#1281)"
    return ("stopped pid" in note or "killed pid" in note or "not running" in note), note


def heal_tailscale(mini: Mini, f: dict[str, Any]) -> tuple[bool, str]:
    before = f["evidence"]
    if "Stopped" in before:
        mini.tailscale_up()
        what = "tailscale up"
    else:
        service = mini.vpn_service()
        if service is None:
            return False, "no Tailscale VPN service to restart"
        mini.restart_vpn(service)
        what = f"scutil --nc stop/start {service}"
    state = None
    for _ in range(TAILSCALE_WAIT_S // 5):
        got = mini.tailscale()
        state = got[1] if got else None
        if state == "Running":
            return True, f"{what}: Running"
        mini.sleep(5)
    return False, f"{what}: still {state or 'no BackendState'}"


def restart_fix(flavor: str) -> str:
    """What restarts this flavor of Tailscale (the finding's note before any gate speaks)."""
    if flavor == "standalone":
        return f"root: sudo launchctl kickstart -k system/{TAILSCALED_LABEL}"
    return "stop and start the Tailscale VPN service (scutil --nc)"


def restart_switch_off(env: Any, switch_exists: bool) -> str:
    """Why the Tailscale restart's kill switch is on, or "": TAILSCALE_RESTART_OFF exists, or the env says off."""
    if switch_exists:
        return f"{TAILSCALE_RESTART_OFF} exists"
    value = str(env.get(TAILSCALE_RESTART_ENV, "")).strip().lower()
    if value in {"0", "off", "false", "no"}:
        return f"{TAILSCALE_RESTART_ENV}={value}"
    return ""


def host_key(name: str) -> str:
    return (name.strip().lower().split(".")[0].replace(" ", "-")
            .replace("’", "").replace("'", ""))


def ci_mini_refusal(names: list[str] | None, facts: dict[str, Any]) -> str:
    """Why this host is not a CI runner mini whose Tailscale may be restarted, or "" when it is. Fails closed: no
    tailnet name (names None), no name, an unreadable fact or an unknown role refuses. Which minis may restart at
    all is the registry's opt-in (opt_in_refusal); this is what glaeda itself knows."""
    if names is None:
        return "this host's tailnet name cannot be read (tailscale status --json has no Self name)"
    if not names:
        return "this host's name cannot be read"
    for name in names:
        if NEVER_RESTART_WORD in host_key(name):
            return f"{host_key(name)} never has its Tailscale restarted by mini-health"
    if facts.get("platform") != "darwin":
        return "not a macOS mini"
    runners = facts.get("runners")
    if runners is None:
        return "its glaeda runners cannot be read"
    if not runners:
        return "no registered glaeda runner here"
    args = facts.get("setup_args")
    if args is None:
        return "~/.config/glaeda/update.json's setupArgs cannot be read"
    for flag in ("--hygiene-only", "--gh-only", "--headless"):
        if flag in args:
            return f"set up {flag} (not a CI runner mini)"
    for i, arg in enumerate(args):
        role = arg.split("=", 1)[1] if arg.startswith("--role=") else (
            args[i + 1] if arg == "--role" and i + 1 < len(args) else None)
        if role is not None and role != "fleet-mini":
            return f"set up --role={role}, not fleet-mini"
    if facts.get("role") != "fleet-mini":
        return f"mini-setup's role is {facts.get('role') or 'unknown'}, not fleet-mini"
    return ""


def opt_in_refusal(opt_in: tuple[dict[str, Any] | None, str], names: list[str]) -> str:
    """Why the fleet registry's opt-in (Mini.tailscale_opt_in) does not allow this host's restart, or "" when it
    names one of the names this host goes by. Missing, unreadable, another schema or another host refuses."""
    doc, why = opt_in
    if doc is None:
        return why or f"no ~/{TAILSCALE_OPT_IN}"
    if doc.get("schema") != TAILSCALE_OPT_IN_SCHEMA:
        return f"~/{TAILSCALE_OPT_IN}'s schema is {doc.get('schema')!r}, not {TAILSCALE_OPT_IN_SCHEMA}"
    host = doc.get("host")
    if not isinstance(host, str) or not host.strip():
        return f"~/{TAILSCALE_OPT_IN} names no host"
    if host_key(host) not in {host_key(name) for name in names}:
        return f"~/{TAILSCALE_OPT_IN} names {host}, not this host ({', '.join(sorted(set(names)))})"[:200]
    return ""


SUDO_TAG = re.compile(r"([A-Z_]+):\s*")  # NOPASSWD:, SETENV:, ... before a command


def sudo_nopasswd(listing: str, command: str) -> bool:
    # Conservative by intent only (wildcard negation and runas !root are not modeled); `sudo -n` still enforces.
    """Whether `sudo -n -l`'s listing lets this user run command as root without a password: the last rule that
    matches it (exactly, or ALL) wins, as in sudoers, and must carry NOPASSWD; a negated match refuses. Anything
    it cannot read is no."""
    lines = listing.splitlines()
    start = next((i + 1 for i, line in enumerate(lines) if "may run the following commands" in line), None)
    if start is None:
        return False
    allowed = False
    root = nopasswd = False
    for line in lines[start:]:
        if not line.strip():
            continue
        m = re.match(r"\s*\(([^)]*)\)\s*(.*)$", line)
        if m:  # a new entry: its runas users, and tags that start from the defaults
            users = {u.strip() for u in m.group(1).split(":")[0].split(",")}
            root, nopasswd, rest = bool(users & {"root", "ALL"}), False, m.group(2)
        elif line[:1].isspace():
            rest = line  # a continuation of the entry above
        else:
            break  # another section
        for item in (part.strip() for part in rest.split(",")):
            while True:  # tags carry to the rest of the entry until another sets them
                tag = SUDO_TAG.match(item)
                if not tag:
                    break
                if tag.group(1) in {"NOPASSWD", "PASSWD"}:
                    nopasswd = tag.group(1) == "NOPASSWD"
                item = item[tag.end():]
            negated = item.startswith("!")
            if root and item.lstrip("!") in {command, "ALL"}:
                allowed = nopasswd and not negated
    return allowed


def restart_state_path(state_path: Path) -> Path:
    return state_path.with_name(TAILSCALE_RESTART_STATE)


def load_restart_state(path: Path) -> dict[str, Any] | None:
    """The restart state: {} when there was never an attempt, None when it cannot be read (fail closed)."""
    try:
        doc = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) else None


def attempt_time_ok(at: Any, now: float) -> bool:
    """A last_attempt_at that can be a real attempt: a finite number from 0 to one window past now (a clock step
    back is allowed, NaN, Infinity, 1e300 or a negative stamp is not)."""
    return (isinstance(at, (int, float)) and not isinstance(at, bool) and math.isfinite(at)
            and 0 <= at <= now + TAILSCALE_RESTART_EVERY_S)


def restart_window_refusal(doc: dict[str, Any] | None, now: float) -> str:
    """Why the once-per-TAILSCALE_RESTART_EVERY_S window forbids a restart now, or "" when it allows one."""
    if doc is None:
        return f"the restart state ({TAILSCALE_RESTART_STATE}) is unreadable, so the 6 h window cannot be checked"
    if "last_attempt_at" not in doc:
        return ""
    at = doc.get("last_attempt_at")
    if not attempt_time_ok(at, now):
        return f"the restart state's last attempt is unreadable ({at!r}), so the 6 h window cannot be checked"
    if at > now:  # a clock step back: the attempt still happened, so the window starts from now
        return f"the last restart is stamped in the future ({iso(at)}); none before {iso(now + TAILSCALE_RESTART_EVERY_S)}"
    if now - at < TAILSCALE_RESTART_EVERY_S:
        result = f" ({doc['result']})" if isinstance(doc.get("result"), str) else ""
        return (f"restarted at {iso(at)}{result}; at most once per 6 h, next after "
                f"{iso(at + TAILSCALE_RESTART_EVERY_S)}")
    return ""


def restart_failures(doc: dict[str, Any] | None, now: float) -> int | None:
    """Failed restarts in a row the restart state records (an attempt that crashed mid-restart counts: its failure is
    written before it runs), 0 when none; None when the state, its last attempt's time or its count is unreadable."""
    if doc is None or ("last_attempt_at" in doc and not attempt_time_ok(doc.get("last_attempt_at"), now)):
        return None
    if "failures" not in doc:
        return 0 if doc.get("ok") or "last_attempt_at" not in doc else 1
    n = doc.get("failures")
    return n if isinstance(n, int) and not isinstance(n, bool) and n >= 0 else None


def restart_failed_note(doc: dict[str, Any], failures: int, now: float) -> str:
    """What the last failed restart left: when it ran, what the re-check saw, and when the next try is allowed."""
    at = doc.get("last_attempt_at")
    result = doc.get("result") if isinstance(doc.get("result"), str) and doc.get("result") != "started" else (
        "it never finished")
    if not attempt_time_ok(at, now):
        return f"the last Tailscale restart did not restore the route ({result})"
    if failures >= TAILSCALE_RESTART_GIVE_UP:
        return (f"{failures} Tailscale restarts in a row did not restore the route (last at {iso(at)}: {result}); "
                "no more until the route is seen clear")
    return (f"Tailscale restart at {iso(at)} did not restore the route ({result}); next try after "
            f"{iso(at + TAILSCALE_RESTART_EVERY_S)}")


def clear_restart_failures(path: Path, now: float) -> None:
    """The route is seen clear: failed restarts in a row start again from 0 (the give-up ends)."""
    doc = load_restart_state(path)
    if doc is None or restart_failures(doc, now) == 0:
        return
    with contextlib.suppress(OSError):
        write_json(path, {**doc, "failures": 0, "cleared_at": iso(now)})


def restart_commands(flavor: str, service: str | None) -> list[list[str]]:
    """The restart for this flavor, and nothing else: no config, auth or flag changes. A standalone tailscaled is
    its LaunchDaemon's kickstart -k (root, through one exact NOPASSWD sudoers rule); the app (the App Store app or
    the standalone System Extension app) is a stop and start of its VPN service, as tailscale_down's heal does."""
    if flavor == "standalone":
        return [["/usr/bin/sudo", "-n", "/bin/launchctl", "kickstart", "-k", f"system/{TAILSCALED_LABEL}"]]
    if service is None:
        return []
    return [["/usr/sbin/scutil", "--nc", "stop", service], ["/usr/sbin/scutil", "--nc", "start", service]]


def route_ok(state: str | None, via: str | None) -> bool:
    """Running with the route on the tunnel; a CLI that gave no BackendState (a loaded mini) is judged on the route."""
    return state in ("Running", None) and via is not None and via.startswith("utun")


def drain_state_path(state_path: Path) -> Path:
    return state_path.with_name(TAILSCALE_DRAIN_STATE)


def drain_gave_up(path: Path, now: float) -> str:
    """Why a drain may not start again yet (one hit its cap less than TAILSCALE_RESTART_EVERY_S ago), or ""; an
    unreadable record refuses."""
    try:
        doc = json.loads(path.read_text())
    except FileNotFoundError:
        return ""
    except (OSError, ValueError):
        return f"the drain record ({TAILSCALE_DRAIN_STATE}) is unreadable"
    if isinstance(doc, dict) and "gave_up_at" not in doc:
        # A drain was started and never recorded a cap. One that ended early (restart, route back) leaves it; one
        # whose cap record could not be written leaves it too, so a start older than the cap counts as a cap
        # from the cap's time: no new drain until 6 h after it.
        started = doc.get("drain_started_at")
        if not attempt_time_ok(started, now):
            return f"the drain record ({TAILSCALE_DRAIN_STATE}) is unreadable"
        if doc.get("ended") or now - started < TAILSCALE_DRAIN_MAX_S:
            return ""
        at = started + TAILSCALE_DRAIN_MAX_S
        if now - at < TAILSCALE_RESTART_EVERY_S:
            return (f"a drain started at {iso(started)} did not record its end; no drain before "
                    f"{iso(at + TAILSCALE_RESTART_EVERY_S)}")
        return ""
    at = doc.get("gave_up_at") if isinstance(doc, dict) else None
    if not attempt_time_ok(at, now):
        return f"the drain record ({TAILSCALE_DRAIN_STATE}) is unreadable"
    if now - at < TAILSCALE_RESTART_EVERY_S:
        return (f"a drain hit its {TAILSCALE_DRAIN_MAX_S // 3600} h cap at {iso(at)} ({doc.get('busy', '?')}); "
                f"no drain before {iso(at + TAILSCALE_RESTART_EVERY_S)}")
    return ""


def finish_drain(mini: Mini, marker: dict[str, Any], now: float, drain_path: Path) -> None:
    """End a drain before its cap (restart done, route back, a gate refused) and record that it ended, so
    drain_gave_up does not read it as a cap. A record that cannot be written reads as a cap: fail closed."""
    if mini.end_drain(marker):
        with contextlib.suppress(OSError):
            write_json(drain_path, {"drain_started_at": marker["since"], "ended": iso(now)})


def drain_capped(mini: Mini, marker: dict[str, Any], now: float, drain_path: Path, busy: str) -> str:
    """End a drain at its cap: the cooldown record first (so no new drain starts for TAILSCALE_RESTART_EVERY_S),
    then the marker, which goes even when the record cannot be written (no host stays closed to jobs; a drain
    whose record cannot be written never starts again, start_drain's precondition). The note to report."""
    start = marker["since"]
    try:
        write_json(drain_path, {"gave_up_at": now, "at": iso(now), "drain_since": iso(start), "busy": str(busy)[:200]})
        kept = ""
    except OSError as error:
        kept = f"the drain record could not be written ({type(error).__name__}); "
    mini.end_drain(marker)
    return (f"{kept}{busy}: still there after the {TAILSCALE_DRAIN_MAX_S // 3600} h drain cap (draining since "
            f"{iso(start)}); the drain ended and jobs are admitted again; look at it")


def drain_housekeeping(mini: Mini, now: float, heal_ok: bool, drain_path: Path, route_clear: bool) -> str:
    """A pass that did not run tailscale_no_route's heal (the route is clear, the CLI and route gave no answer, or
    the finding is not reported yet) still ends a drain of ours that has no reason to stay: the route is clear, a
    kill switch is on, or the cap is past. The note for the report ("" when nothing ended at the cap)."""
    kind, marker = mini.host_reservation()
    if kind != "ours":
        return ""
    if route_clear or not heal_ok or mini.tailscale_restart_off():
        finish_drain(mini, marker, now, drain_path)
        return ""
    if now - marker["since"] >= TAILSCALE_DRAIN_MAX_S:
        return drain_capped(mini, marker, now, drain_path, "the route could not be judged this run")
    return ""


def heal_tailscale_route(mini: Mini, f: dict[str, Any], now: float, runs: int, apply: bool, heal_ok: bool,
                         path: Path, since: float | None = None) -> tuple[dict[str, Any], dict[str, Any] | None, bool]:
    """tailscale_no_route's restart behind every gate: (the finding as reported, the heal it ran or None, fixed).
    auto_fix stays pending only while a restart is still possible and none has failed: a restart that did not fix it
    (or an unreadable restart state) is impossible, the state ci-dash's health_alerts raises to an operator.
    Under --apply, the drain this pass owns (one it found, or one it started) ends here unless the pass keeps it
    (still waiting on jobs or the host lock): a gate that now refuses or a restart that ran ends it. A pass that
    found no drain and lost the race to start one owns none, so it never removes another pass's marker."""
    kind, marker = mini.host_reservation() if apply else ("none", None)
    owned: list[dict[str, Any] | None] = [marker if kind == "ours" else None]
    keep = [False]
    try:
        return _heal_tailscale_route(mini, f, now, runs, apply, heal_ok, path, since, kind, marker, owned, keep)
    finally:
        if apply and owned[0] is not None and not keep[0]:
            finish_drain(mini, owned[0], now, drain_state_path(path))


def _heal_tailscale_route(mini: Mini, f: dict[str, Any], now: float, runs: int, apply: bool, heal_ok: bool,
                          path: Path, since: float | None, kind: str, marker: dict[str, Any] | None,
                          owned: list[dict[str, Any] | None], keep: list[bool]
                          ) -> tuple[dict[str, Any], dict[str, Any] | None, bool]:
    drain_path = drain_state_path(path)
    f = dict(f)
    flavor = f.pop("flavor", None) or ("standalone" if "(standalone)" in f["evidence"] else "app")
    fix = restart_fix(flavor)
    record = load_restart_state(path)
    failures = restart_failures(record, now)
    if failures is None:  # the state, its last attempt's time or its count: unreadable, so no restart is coming
        failed = (restart_window_refusal(record, now) if record is None or "last_attempt_at" in record
                  and not attempt_time_ok(record.get("last_attempt_at"), now) else
                  f"the restart state's failure count is unreadable ({record.get('failures')!r})"[:120])
    else:
        failed = restart_failed_note(record, failures, now) if failures else ""

    def stop(auto_fix: str, why: str) -> tuple[dict[str, Any], None, bool]:
        # pending only for a short wait (busy right now, the two-runs rule); once a restart failed, always impossible
        if failed:
            auto_fix, why = "impossible", f"{failed}; {why}" if why else failed
        f["auto_fix"], f["note"] = auto_fix, f"{fix}; {why}"[:300]
        return f, None, False

    def wait(why: str) -> tuple[dict[str, Any], None, bool]:
        # busy for 6 h is no short wait (a stranded host lock, a stuck jobs/ entry): it alerts
        stuck = (isinstance(since, (int, float)) and not isinstance(since, bool) and math.isfinite(since)
                 and 0 <= since and now - since >= TAILSCALE_RESTART_EVERY_S)
        if not isinstance(why, NoAnswer) and stuck and not failed:  # a failed restart's note already alerts
            return stop("impossible", f"waiting for an idle mini since {iso(since)} (6 h or more): {why}")
        return stop("impossible" if isinstance(why, NoAnswer) else "pending", f"waiting for an idle mini: {why}")

    if not heal_ok:
        return stop("impossible", f"healing is off ({KILL_SWITCH})")
    off = mini.tailscale_restart_off()
    if off:
        return stop("impossible", f"the Tailscale restart is off ({off})")
    names = mini.host_names()
    refused = ci_mini_refusal(names, mini.ci_mini_facts()) or opt_in_refusal(mini.tailscale_opt_in(), names or [])
    if refused:
        return stop("impossible", f"not restarted here: {refused}; its owner does that")
    commands = restart_commands(flavor, mini.vpn_service() if flavor == "app" else None)
    if not commands:
        return stop("impossible", "no Tailscale VPN service (scutil --nc list) to restart")
    if flavor == "standalone" and not mini.sudo_allows(commands[0]):
        user = os.environ.get("USER") or "the runner user"
        return stop("impossible", f"needs the sudoers rule `{user} ALL=(root) NOPASSWD: /bin/launchctl kickstart -k "
                    f"system/{TAILSCALED_LABEL}` (glaeda-mini-fleet sudo-plan --sudoers)")
    if not apply or runs < REPORT_AFTER.get("tailscale_no_route", 1):
        return stop("pending", "mini-health --apply restarts it when the mini is idle, at most once per 6 h")
    if failures is None or failures >= TAILSCALE_RESTART_GIVE_UP:
        return stop("impossible", "")
    window = restart_window_refusal(record, now)
    if window:  # hours, not a short wait; a failed restart's note already names the next try
        return stop("impossible", "" if failed else window)
    def drain_over(busy: str) -> tuple[dict[str, Any], None, bool]:
        note = drain_capped(mini, owned[0], now, drain_path, busy)
        owned[0] = None
        return stop("impossible", note)

    start = marker["since"] if kind == "ours" else None
    if kind == "ours":  # draining: what still runs, not our own marker
        busy = mini.drain_busy()
        if busy and not isinstance(busy, NoAnswer):
            if now - start >= TAILSCALE_DRAIN_MAX_S:
                return drain_over(busy)
            keep[0] = True
            return stop("pending", f"{busy}: draining since {iso(start)}, no new job is admitted "
                        f"({mini.reservation_path()}); the cap is {iso(start + TAILSCALE_DRAIN_MAX_S)}")
        if busy:
            return wait(busy)  # no answer: the drain ends (a pass that cannot look does not hold jobs off)
    else:
        busy = mini.host_busy()
        if busy:
            waited = (isinstance(since, (int, float)) and not isinstance(since, bool) and math.isfinite(since)
                      and now - since >= TAILSCALE_DRAIN_AFTER_S)
            if isinstance(busy, NoAnswer) or not waited:
                return wait(busy)
            gave_up = drain_gave_up(drain_path, now)
            if gave_up:
                return stop("impossible", f"{gave_up}; waiting for an idle mini: {busy}")
            refused = ("someone else's reservation holds the host" if kind == "other" else mini.fleet_reservation())
            if refused:
                return wait(type(refused)(f"{busy}; no drain: {refused}"))  # a NoAnswer stays one: it alerts
            try:  # the record first: a drain whose cap could not be recorded must not be able to start
                write_json(drain_path, {"drain_started_at": int(now), "at": iso(now)})
            except OSError as error:
                return wait(NoAnswer(f"{busy}; no drain: cannot write {drain_path.name} ({type(error).__name__})"))
            why = mini.start_drain(now, f"drain for a Tailscale restart: tailscale_no_route since {iso(since)} "
                                   "(glaeda-mini-health)")
            if why:
                return wait(f"{busy}; no drain: {why}")
            kind, marker = mini.host_reservation()
            if kind != "ours":
                return wait(f"{busy}; no drain: the marker could not be read back")
            owned[0], keep[0] = marker, True
            return stop("pending", f"{busy}: draining from now, no new job is admitted ({mini.reservation_path()}); "
                        f"no idle moment since {iso(since)}; the cap is {iso(now + TAILSCALE_DRAIN_MAX_S)}")
    with mini.hold_host_lock() as held:
        if held and start is not None and not isinstance(held, NoAnswer):
            if now - start >= TAILSCALE_DRAIN_MAX_S:
                return drain_over(held)  # a lock nobody lets go of is capped as a job is
            keep[0] = True  # a short wait: the drain holds
        if held:
            return wait(held)
        busy = mini.jobs_running()
        if busy and start is not None and not isinstance(busy, NoAnswer):
            keep[0] = True
        if busy:
            return wait(busy)
        record = load_restart_state(path)  # another pass may have gone first
        window = restart_window_refusal(record, now)
        if window:
            return stop("impossible", window)
        failures = restart_failures(record, now)
        if failures is None or failures >= TAILSCALE_RESTART_GIVE_UP:
            return stop("impossible", "the restart state changed under the host lock")
        # counted as failed before it runs, so a crash mid-restart is a failed restart; a fixed route rewrites 0
        attempt = {"schema": TAILSCALE_RESTART_SCHEMA, "last_attempt_at": now, "at": iso(now), "flavor": flavor,
                   "commands": commands, "evidence": f["evidence"], "result": "started", "ok": False,
                   "failures": failures + 1}
        try:
            write_json(path, attempt)  # written before the restart runs: a crash mid-restart still counts
        except OSError as error:
            return stop("impossible", f"cannot write the restart state ({type(error).__name__}): not restarted")
        started = mini.clock()
        ran, what = mini.run_restart(commands)
        mini.sleep(TAILSCALE_RESTART_SETTLE_S)  # one bounded wait, then one re-check
        checked = now + max(0.0, mini.clock() - started)
        got = mini.tailscale()
        state = got[1] if got else None
        via = mini.tailnet_route() if state in ("Running", None) else None
        fixed = route_ok(state, via)
        result = (f"Running, {TAILNET_PROBE_IP} via {via}" if fixed else
                  f"still {state or 'no BackendState'}, {TAILNET_PROBE_IP} via {via or 'unknown'}")
        with contextlib.suppress(OSError):
            write_json(path, {**attempt, "result": result, "ok": fixed, "ran": what[:300], "checked_at": iso(checked),
                              "failures": 0 if fixed else failures + 1})
    action = f"restarted Tailscale ({flavor}{'' if ran else ', a command failed'}): {result}; {what}"
    heal = {"id": f["id"], "ok": fixed, "action": action[:200]}
    if fixed:
        return f, heal, True
    nxt = ("no more until the route is seen clear" if failures + 1 >= TAILSCALE_RESTART_GIVE_UP else
           f"next try after {iso(now + TAILSCALE_RESTART_EVERY_S)}")
    f["auto_fix"] = "impossible"
    f["note"] = (f"Tailscale restart ({flavor}{'' if ran else ', a command failed'}) at {iso(now)} did not restore "
                 f"the route: {result}; {nxt}; {what}")[:300]
    return f, heal, False


def agent_label(agent: str) -> str:
    return "com.teamleaderleo.glaeda.cmux-runner" + ("" if agent == "0" else f".{agent}")


def heal_runner(mini: Mini, f: dict[str, Any]) -> tuple[bool, str]:
    label = agent_label(f["id"].split(":", 1)[1])
    mini.kickstart(label)
    mini.sleep(5)
    running = any(l == label and r for l, _, r, _ in mini.runner_agents())
    return running, f"launchctl kickstart {label}: {'running' if running else 'still not running'}"


def heal_leaked_test_apps(mini: Mini) -> tuple[bool, str]:
    notes = mini.kill_leaked_test_apps()
    return bool(notes), "; ".join(notes) if notes else "no orphaned cmux DEV.app remained after recheck"


def heal_node_toolchain(mini: Mini, f: dict[str, Any]) -> tuple[bool, str]:
    toolchain = f["id"].split(":", 1)[1]
    return mini.install_rust_toolchain(toolchain)


def heal_daemon_heal(mini: Mini, f: dict[str, Any]) -> tuple[bool, str]:
    ok, what = mini.install_daemon_heal()
    status = mini.daemon_heal_status() if ok else None
    verdict = (status or {}).get("verdict")
    if isinstance(verdict, dict):  # healed only once its own report says so, not when the bytes are in place
        return bool(verdict.get("state") == "current" and status.get("loaded") is not False), what
    return bool(status and status.get("current") and status.get("loaded") is not False), what


# Tailscale findings under which a fleet route over the tailnet cannot answer: claude_route waits for them.
TUNNEL_DOWN = frozenset({"tailscale_down", "tailscale_no_route"})

# code -> runs in a row seen before --apply reports it (default 1): a route gap during a Tailscale reconnect
# lasts seconds, so one sighting is no finding.
REPORT_AFTER = {"tailscale_no_route": 2}

# code -> (heal, runs in a row seen before healing)
HEALS: dict[str, tuple[Callable[[Mini, dict[str, Any]], tuple[bool, str]], int]] = {
    "daemon_heal_stale": (heal_daemon_heal, 1),
    "testmanagerd_wedged": (heal_testmanagerd, 1),
    "tailscale_down": (heal_tailscale, 2),
    "runner_stopped": (heal_runner, 2),
    "leaked_test_apps": (lambda mini, _f: heal_leaked_test_apps(mini), 1),
    "node_toolchain_missing": (heal_node_toolchain, 1),
    "claude_route": (heal_claude_route, 1),
}


# ---------------------------------------------------------------- run


def load_json(path: Path) -> dict[str, Any]:
    try:
        doc = json.loads(path.read_text())
        return doc if isinstance(doc, dict) else {}
    except (OSError, ValueError):
        return {}


def write_json(path: Path, doc: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(doc, separators=(",", ":"), sort_keys=True) + "\n")
    os.replace(tmp, path)


def iso(t: float) -> str:
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run(mini: Mini, apply: bool, now: float | None = None, state_path: Path = STATE,
        report_path: Path = REPORT, heal_ok: bool = True, runner: bool = True) -> dict[str, Any]:
    """One pass. runner=False is a host with no glaeda runner (a capture-only mini): only its Claude route."""
    now = time.time() if now is None else now
    state = load_json(state_path) if apply else {}
    seen: dict[str, Any] = state.get("seen") or {}
    tries: dict[str, Any] = state.get("tries") or {}
    healed = [h for h in state.get("healed") or [] if isinstance(h, dict) and now - (h.get("t") or 0) < HEALED_KEEP_S]
    previous = {f["id"]: f for f in (load_json(report_path).get("findings") or []) if isinstance(f, dict)}

    carried = tunnel_down = False
    if runner:
        tailnet = check_tailscale(mini)
        # a tunnel that is down or off its route explains a `claude -p` that does not answer: claude_route neither
        # keeps that probe nor reroutes on it until the tunnel is back (tailscale_no_route's restart may fix it)
        tunnel_down = any(f["code"] in TUNNEL_DOWN for f in tailnet)
        found = (check_console(mini) + check_power(mini) + tailnet + check_runners(mini)
                 + check_node_eligibility(mini) + check_toolchain(mini) + check_leaked_test_apps(mini)
                 + check_disk_accounting(mini)
                 + check_daemon_heal(mini) + check_ota(mini, now)
                 + check_claude_route(mini, now, apply and not tunnel_down, tunnel_down))
        if apply and mini.tailnet_route_ok:
            clear_restart_failures(restart_state_path(state_path), now)
        tm = check_testmanagerd(mini, now)
        carried = tm is None and "testmanagerd_wedged" in previous  # a test runs, or the log was unreadable: no heal
        found += [previous["testmanagerd_wedged"]] if carried else tm or []
    else:
        found = check_claude_route(mini, now, apply)

    findings, heals = [], []
    route_healed = False  # heal_tailscale_route ran this pass (it looks after the drain itself)
    for f in found:
        f = dict(f)
        s = seen.get(f["id"]) or {"since": now, "runs": 0}
        s["runs"] = s.get("runs", 0) + 1
        seen[f["id"]] = s
        if apply and s["runs"] < REPORT_AFTER.get(f["code"], 1):
            continue  # seen, not yet reported
        f["since"] = iso(s["since"])
        if f["code"] == "tailscale_no_route":  # its own gates and 6 h window, not HEALS' tries
            route_healed = True
            f, done_heal, fixed = heal_tailscale_route(mini, f, now, s["runs"], apply, heal_ok,
                                                       restart_state_path(state_path), s["since"])
            if done_heal:
                heals.append(done_heal)
            if fixed:
                healed.append({"id": f["id"], "code": f["code"], "t": now, "at": iso(now), "since": f["since"],
                               "evidence": f["evidence"], "action": done_heal["action"], "auto_fix": "done"})
                seen.pop(f["id"], None)
                continue
            findings.append(f)
            continue
        if f["code"] == "claude_route" and tunnel_down:
            f["note"] = (f"not rerouted while the tunnel is down ({', '.join(sorted(TUNNEL_DOWN))}): the route may "
                         "answer once Tailscale is back")[:300]
            findings.append(f)
            continue
        heal = HEALS.get(f["code"])
        t = tries.get(f["id"]) or {"n": 0, "at": 0}
        # a heal that worked and did not last (a runner that exits again) counts too, so nothing loops for a day
        done = [h for h in healed if h.get("id") == f["id"]]
        if done:
            t = {**t, "at": max(t["at"], max(h["t"] for h in done))}
        if heal and f["auto_fix"] == "pending" and not (carried and f["code"] == "testmanagerd_wedged"):
            if t["n"] + len(done) >= HEAL_TRIES:
                f["auto_fix"] = "impossible"
                f["note"] = f"{HEAL_TRIES} heals did not fix it; last: {t.get('last', '?')}"[:300]
            elif apply and heal_ok and s["runs"] >= heal[1] and now - t["at"] >= HEAL_EVERY_S:
                ok, what = heal[0](mini, f)
                t = {"n": t["n"] + 1, "at": now, "last": what[:200]}
                tries[f["id"]] = t
                heals.append({"id": f["id"], "ok": ok, "action": what[:200]})
                if ok:
                    healed.append({"id": f["id"], "code": f["code"], "t": now, "at": iso(now), "since": f["since"],
                                   "evidence": f["evidence"], "action": what[:200], "auto_fix": "done"})
                    seen.pop(f["id"], None)
                    tries.pop(f["id"], None)
                    continue
                f["note"] = f"heal {t['n'] + len(done)} of {HEAL_TRIES} did not fix it: {what}"[:300]
            elif not heal_ok:
                f["note"] = f"healing is off ({KILL_SWITCH})"
        findings.append(f)
    ids = {f["id"] for f in findings}
    if apply and runner and not route_healed:
        # clear: no finding about the tunnel, or a CLI that timed out while the route itself was on a utun
        codes = {f["code"] for f in found}
        route_clear = "tailscale_no_route" not in codes and (mini.route_on_tunnel or "tailscale_probe_error" not in codes)
        capped = drain_housekeeping(mini, now, heal_ok, drain_state_path(state_path), route_clear)
        for f in findings:
            if capped and f["code"] == "tailscale_probe_error":
                f["auto_fix"], f["note"] = "impossible", f"{f.get('note', '')}; {capped}"[:300]
    # a CLI that gave no BackendState never looked at the route: tailscale_no_route's count neither grows nor
    # starts again (cmuxs-mac-mini-5, 2026-10-26: a 15 s status timeout every other run kept it at 1 for hours)
    # (a probe error whose route lookup named a utun did look: the route is clear, so the count starts again)
    unlooked = ({"tailscale_no_route"} if any(f["code"] == "tailscale_probe_error" for f in found)
                and not (runner and mini.route_on_tunnel) else set())
    seen = {k: v for k, v in seen.items() if k in ids | {f["id"] for f in found} | unlooked}
    tries = {k: v for k, v in tries.items() if k in ids}
    report = {"schema": SCHEMA, "at": iso(now), "findings": findings,
              "healed": sorted(healed + getattr(mini, "daemon_healed", []), key=lambda h: h.get("t") or 0)[-HEALED_MAX:],
              "ota": ota_summary(mini.ota_converge())}
    if apply:
        write_json(state_path, {"seen": seen, "tries": tries, "healed": healed[-HEALED_MAX:]})
        write_json(report_path, report)
    report["heals"] = heals
    report["changed"] = sorted(ids) != sorted(previous)
    return report


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--apply", action="store_true", help="heal and write the report (the LaunchAgent)")
    args = p.parse_args(argv)
    mini = Mini()
    if not mini.runner_dirs():
        # No runner report here, but the daemon healer serves every macOS host (the AWS dev-build hosts too).
        stale = [f for f in check_daemon_heal(mini) if f["code"] == "daemon_heal_stale"]
        last = load_json(NO_RUNNER_HEAL).get("at") or 0
        due = time.time() - last >= HEAL_EVERY_S  # the same pace as a runner host's heals
        healed = None
        if args.apply and stale and stale[0]["auto_fix"] == "pending" and due and not KILL_SWITCH.exists():
            healed = heal_daemon_heal(mini, stale[0])
            write_json(NO_RUNNER_HEAL, {"at": time.time(), "ok": healed[0], "action": healed[1]})
        # A capture-only mini still runs Claude for its captures: its route is checked and healed, and the
        # report is written where capture-host reads it.
        claude = (run(mini, args.apply, state_path=STATE, report_path=REPORT, heal_ok=not KILL_SWITCH.exists(),
                      runner=False) if mini.claude_bin() else None)
        heals = ([{"id": "daemon_heal_stale", "ok": healed[0], "action": healed[1]}] if healed else []) \
            + (claude["heals"] if claude else [])
        if not args.apply:
            print(json.dumps({"schema": SCHEMA, "skipped": "no glaeda runner on this host",
                              "findings": [f["id"] for f in stale] + [f["id"] for f in (claude or {}).get("findings", [])]}))
        elif heals or (claude and claude["changed"]):
            print(json.dumps({"findings": [f["id"] for f in (claude or {}).get("findings", [])], "heals": heals},
                             separators=(",", ":")), flush=True)
        return 0
    report = run(mini, args.apply, heal_ok=not KILL_SWITCH.exists())
    if not args.apply:
        print(json.dumps(report, indent=2))
    elif report["heals"] or report["changed"]:
        print(json.dumps({"at": report["at"], "findings": [f["id"] for f in report["findings"]],
                          "heals": report["heals"]}, separators=(",", ":")), flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
