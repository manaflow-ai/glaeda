HOME = Path.home()
SNAPSHOT = HOME / ".cache/glaeda-disk/sizes.json"
DEDUPE_STATE = HOME / ".cache/glaeda-disk/dedupe.json"
# The last pressure run's du of ~/Library/Caches/cmux-next-ci (cmux_next_ci_cap_state): reports read it beside
# the size snapshot and never walk the cache themselves.
CMUX_NEXT_CAP_RECORD = HOME / ".cache/glaeda-disk/cmux-next-cap.json"
MEASURE_LOCK = HOME / ".cache/glaeda-disk/measure.lock"
ACCOUNTING = HOME / ".cache/glaeda-disk/accounting.json"
HEALTH_SUMMARY = HOME / ".local/state/glaeda/disk/summary.json"
EVICT_LOCK = HOME / ".cache/glaeda-disk/evict.lock"  # one --apply at a time (the runner hooks and the LaunchAgent)
# The runner hook's one-pass-at-a-time queue (glaeda-cmux-runner-hook DISK_PASS_LOCK/PENDING): a pressure run that is
# not the hook's own pass (HOOK_PASS_ENV) and finds a pass under way leaves its trigger there instead of racing it.
HOOK_PASS_LOCK = HOME / ".cache/glaeda-disk/hook-pass.lock"
HOOK_PASS_PENDING = HOME / ".cache/glaeda-disk/hook-pass.pending"
HOOK_PASS_ENV = "GLAEDA_DISK_HOOK_PASS"  # "1" in the hook's own pass and its floor evictions: never queued
# Any other --pressure --apply run (the LaunchAgent's, idle-repair's) takes HOOK_PASS_LOCK itself (take_hook_pass), so
# it and the hook's pass never overlap, or leaves its trigger to the pass that holds it.
CALLER_ENV = "GLAEDA_DISK_CALLER"  # who started this run, for its run line; else the parent's command
COALESCED_INTO_HOOK = "coalesced into the running pass (glaeda-disk)"
UNSERVED = ("eviction_busy", "measurement_busy", "defer_during_ci")  # a run that skipped these did no pass
EVICT_OWNER = HOME / ".cache/glaeda-disk/evict.owner.json"
EVICT_OWNER_STALE_S = 30 * 60
RUNNER_HELD_DIR = ".local/state/glaeda/mini-fleet/runner-held"
# The marker is also a kernel lock.  Its name is useful in operator reports, while
# flock keeps a long refresh from being mistaken for a stale one.
_REFRESH_HANDLE = None
# Items a nested_git family kept for a git loss, so a dead session with unpushed work is not
# re-walked every run. Only keep verdicts are cached: a stale entry can delay a deletion, never cause one.
NESTED_KEEP = HOME / ".cache/glaeda-disk/nested-keep.json"
NESTED_KEEP_S = 24 * 3600
# Session scratch holds whole source copies nested deeper than git_state's search; finding every
# checkout in one took ~48 s on a loaded Air Blue (glaeda#1293). Paid only by idle items.
NESTED_DEPTH, NESTED_BUDGET = 40, 5_000_000
DEDUPE_SUBDIRS = ("SourcePackages", "ModuleCache.noindex", "SDKExplicitPrecompiledModules")
DEDUPE_MIN_BYTES = 1024 * 1024
GIB = 1024**3
DARWIN = platform.system() == "Darwin"
# A blocked filesystem walk must not hold evict.lock or pause a runner indefinitely.  A walk that
# cannot finish in this window is left unsized and retried on a later report; it never becomes a
# zero-byte reclaim candidate.
DU_TIMEOUT_S = 30
DU_KILL_GRACE_S = 1
# A refresh is a background convenience, not a reason to keep a runner CPU-bound for hours.  The
# snapshot keeps completed measurements, so a later refresh can finish the remaining candidates.
REFRESH_BUDGET_S = 10 * 60
# A pressure --apply re-measures every candidate of every reclaimable family (fresh_for_apply). With no bound, a
# per-user $TMPDIR of ~55,000 test scratch dirs kept every pass in that walk until the runner hook's 15 min bound
# killed it, before it deleted anything; the hook's floor eviction then skipped as eviction_busy behind it. A CI mini
# sat under its 30 GiB floor for five hours with 32.8 GiB of idle SwiftPM scratch reclaimable (2026-10-26). So a
# pressure apply stops starting walks after PRESSURE_MEASURE_BUDGET_S and stops judging after twice that, then
# deletes from what it judged: an unmeasured candidate is never deleted (it stays unsized), and the families are
# walked round-robin, so a family of a few large caches is measured before a family of many small entries.
PRESSURE_MEASURE_BUDGET_S = 4 * 60
EVICTION_STUCK: list[dict[str, Any]] = []
_EVICT_HANDLE = None
_MEASURE_BUDGET_REACHED = False
_REFRESH_PROGRESS_KNOWN: dict[str, int] | None = None
# A timed-out walk is left unsized and protected.  Do not relaunch the same
# pathological walk on every scheduled pass; the next pass after the cooldown
# retries it with fresh evidence.
TIMEOUT_COOLDOWN_S = 30 * 60
TIMEOUT_STATE = HOME / ".cache/glaeda-disk/timeout-paths.json"
_TIMED_OUT_PATHS: dict[str, float] = {}
_REFRESH_DEADLINE_ACTIVE = False
_ACTIVE_MEASURE_HANDLE = None
_ACTIVE_DU_PROCS: dict[int, subprocess.Popen] = {}
_ACTIVE_QUERY_PROCS: dict[int, subprocess.Popen] = {}


class RefreshDeadlineExceeded(Exception):
    """The owned background refresh exceeded its wall-clock budget."""


def _refresh_alarm(_signum, _frame):
    raise RefreshDeadlineExceeded()

# Never ask du to enumerate the data volume. These are the bounded roots that account for
# runner work and rebuildable state on a mini. Cloud/FileProvider placeholders can block in
# the kernel while opening a directory, so they are excluded before a walk starts.
MEASURE_SKIP_COMPONENTS = frozenset({
    "FileProvider", "CloudStorage", "Mobile Documents", ".DocumentRevisions-V100",
    "com.apple.FileProvider", "com.apple.CloudDocs",
})

# These roots are for accounting only. They are deliberately separate from the eviction
# catalogue: their sizes may overlap, and an incomplete walk is a lower bound rather than
# permission to delete anything. Keeping the Data volume at one bounded level makes the
# dashboard's "other" bucket explainable without walking `/` or entering FileProvider trees.
DARWIN_ACCOUNTING_ROOTS = (
    ("data-volume", Path("/System/Volumes/Data")),
    ("data-users", Path("/System/Volumes/Data/Users")),
    ("data-users-shared", Path("/System/Volumes/Data/Users/Shared")),
)
PLATFORM_VALUES = frozenset({"macos", "linux", "shared", "unknown"})

# A secondary account left behind by a runner install gets its own narrow profile.
# Keep this separate from default_families(): that catalogue intentionally includes
# developer caches and report-only home scopes which must never be traversed by the
# account hygiene LaunchDaemon.
RUNNER_CACHE_PROFILE = False


def host_cache_platform() -> str:
    """An execution-host fact for generic caches, used only to label routing evidence."""
    return "macos" if DARWIN else "linux"


def runner_home_roots() -> list[tuple[str, Path]]:
    """Return extra accounting scopes only when the home proves it is a CI runner account."""
    if not DARWIN:
        return []
    try:
        runners = [p for p in HOME.glob("actions-runner*")
                   if (p / ".runner").is_file() and (p / "glaeda-hooks").is_dir()]
    except OSError:
        return []
    if not runners:
        return []
    return [("runner-home", HOME),
            ("runner-library-caches", HOME / "Library/Caches"),
            ("runner-browser-build", HOME / "cmux-browser-fleet/build")]


def shared_fleet_roots() -> list[tuple[str, Path]]:
    """Return bounded scopes for the local shared fleet tier.

    The shared tree is a local hot tier, not the controller's external SSD. Keep its
    direct children visible so the dashboard can distinguish CI state from caches and
    node products without exposing job names or user paths. The controller's external
    cache is observed by its own host and is deliberately not counted on a mini.
    """
    if not DARWIN:
        return []
    root = Path("/Users/Shared/cmux-build-fleet")
    try:
        if not root.is_dir() or not _measurement_path_allowed(root):
            return []
    except OSError:
        return []
    scopes = [("shared-fleet", root)]
    for name in ("cache", "xcode", "ci", "ci-ios", "node-products", "git", "logs", "tools",
                 "job-volumes", "bin"):
        child = root / name
        try:
            if child.is_dir() and _measurement_path_allowed(child):
                scopes.append((f"shared-fleet/{name}", child))
        except OSError:
            continue
    return scopes


@dataclass(frozen=True)
class Family:
    id: str
    root: Path
    reclaimable: bool
    rebuild: str
    depth: int = 1  # candidates are directories this many levels below root
    skip: tuple[str, ...] = ()
    # when set, candidates are directories with this name found up to `depth` levels below
    # root (the first match on a path wins), instead of every directory exactly `depth` down
    match: str = ""
    marker: str = ""  # with match: the candidate must also contain this file
    files: bool = False  # top-level regular files are candidates too
    min_bytes: int | None = None  # size floor for this family instead of --min-mib
    git_disposable: bool = False  # a checkout that loses nothing when deleted is reclaimable
    nested_git: bool = False  # judge every checkout inside an item, not only one rooted at it
    owner: str = ""  # who writes it, so a cache nobody owns any more is visible
    # launchd services of that owner (e.g. system/ai.x.worker), one or several; retired = none of them loaded
    owner_job: str | tuple[str, ...] = ""
    rebuild_minutes: float = 10.0  # rough cost of losing it; cheaper items go first under pressure
    skip_prefixes: tuple[str, ...] = ()  # candidates whose name starts with one of these are skipped
    # size every missing candidate with one `du -d1` walk of root instead of one du per candidate:
    # a macOS $TMPDIR holds tens of thousands of small leaked directories (25,730 on Air Blue)
    bulk_sizes: bool = False
    build_output: bool = False  # DerivedData-like: SwiftPM clones inside do not make it a checkout
    # candidates are per-launch app bundle copies (code_sign_clone.*): keep_live_app_clones keeps the live ones
    app_clones: bool = False
    include: tuple[str, ...] = ()  # when set, only candidates whose name starts with one of these
    min_idle_hours: float = 0.0  # an item must also be idle this long, whatever the idle window
    max_idle_hours: float | None = None  # a hot-tier item goes once idle this long, whatever the idle window
    # candidates are the sealed caches discover_caches finds below root, not root's children
    discover: bool = False
    # candidates are the build outputs inside the checkouts under root (checkout_builds), not root's children
    checkout_builds: bool = False
    retired_only: bool = False  # reclaim only with fresh evidence the declared service is unloaded
    pressure_only: bool = False  # dev-box package caches are reclaimed only during pressure runs
    transcripts: bool = False  # discover individual agent transcript files below root
    transcript_archives: bool = False  # discover archived transcript files below root
    # Fleet artifacts use a fixed migration cutoff. Older cruft is eligible immediately; newer
    # entries follow the normal idle window and are protected when a live lease names them.
    stale_before: float | None = None
    allow_stale_protected: bool = False  # permit an explicit family below NEVER_DELETE roots
    reference_root: Path | None = None  # root containing lease/job markers for this family
    # Past this idle age the checkouts inside an item are mirrors (a GitHub clone, a laptop's synced tree)
    # and no git check keeps it; process, socket and job-marker checks still do.
    mirror_idle_hours: float | None = None
    platform: str = "unknown"  # macos | linux | shared | unknown; reporting only, never deletion authority


def idle_window(fam: Family, idle_hours: float) -> float:
    window = max(idle_hours, fam.min_idle_hours)
    return window if fam.max_idle_hours is None else min(window, fam.max_idle_hours)


# Never deleted by any family, at any pressure (Leo, 2026-09-27): the Chromium / cmux-browser dev trees
# and their caches. A lost tree is a ~17 min LAN re-seed at best and a multi-hour Chromium build at worst,
# and a campaign may hold work nowhere else. A candidate at, inside or above one of these paths, or whose
# name matches NEVER_DELETE_NAMES, is dropped before it is judged.
NEVER_DELETE = ("cmux-browser-fleet", "Library/Caches/cmux-release-support", "Library/Caches/siso")  # under HOME
NEVER_DELETE_NAMES = re.compile(r"chromium|cmux-browser|siso|depot_tools|cmux-release-support|vpython|cipd", re.I)
# Leo's fleet cleanup cutoff: artifacts predating this migration are known cruft. Keep this as
# an epoch so the comparison is deterministic on hosts in any local timezone.
ARTIFACT_CUTOFF = calendar.timegm((2026, 9, 17, 0, 0, 0))
FLEET_ROOT = Path("/Users/Shared/cmux-build-fleet")


def _reference_spellings(path: Path) -> tuple[str, ...]:
    """Absolute and user-facing spellings that a configuration may use for a checkout."""
    absolute = os.path.abspath(os.fspath(path))
    real = os.path.realpath(absolute)
    values = {absolute, real}
    home = os.path.abspath(os.fspath(HOME))
    for value in tuple(values):
        if value == home or value.startswith(home + "/"):
            values.add("~" + value[len(home):])
        if value == "/private" or value.startswith("/private/"):
            values.add(value.removeprefix("/private"))
    return tuple(sorted(values, key=len, reverse=True))


def _reference_mentions(text: str, path: Path) -> bool:
    for spelling in _reference_spellings(path):
        start = 0
        while (index := text.find(spelling, start)) >= 0:
            before = text[index - 1] if index else ""
            after_at = index + len(spelling)
            after = text[after_at] if after_at < len(text) else ""
            if (not before or before in " \t\r\n'\"=:/,;([{<") and \
                    (not after or after in " \t\r\n'\"=:/,;)]}>"):
                return True
            start = index + 1
    return False


def _reference_files() -> list[Path]:
    """User-owned launch, shell, and agent configuration that can name a checkout."""
    files = [HOME / ".codex/hooks.json", HOME / ".codex/config.toml",
             HOME / ".claude/settings.json", HOME / ".profile",
             HOME / ".bashrc", HOME / ".bash_profile", HOME / ".bash_login",
             HOME / ".zshrc", HOME / ".zprofile", HOME / ".zlogin", HOME / ".zshenv",
             HOME / ".kshrc", HOME / ".config/fish/config.fish",
             *sorted((HOME / "Library/LaunchAgents").glob("*.plist")),
             *sorted((HOME / ".config/systemd/user").glob("**/*"))]
    return [path for path in dict.fromkeys(files) if path.is_file()]


def referenced_main_checkout(path: Path, *, nested: bool = False) -> str:
    """Return a guard reason when user configuration or a tool symlink names this main checkout."""
    if path.is_symlink():
        return ""
    if (path / ".git").is_dir():
        roots = [path]
    elif nested:
        roots = nested_checkouts(path)
        if roots is None:
            return "main checkout references unreadable"
    else:
        return ""
    local_bin = HOME / ".local/bin"
    for root in roots:
        if not (root / ".git").is_dir():
            continue
        try:
            for entry in local_bin.iterdir():
                if entry.is_symlink() and Path(os.path.realpath(entry)).is_relative_to(root.resolve()):
                    return "main checkout referenced by ~/.local/bin symlink"
        except FileNotFoundError:
            pass
        except OSError:
            return "main checkout references unreadable"
        for config in _reference_files():
            try:
                if _reference_mentions(config.read_text(errors="ignore"), root):
                    return "main checkout referenced by user configuration"
            except OSError:
                return "main checkout references unreadable"
    return ""


# The toolchain a job runs, never deleted by any family at any pressure: rustup's binary and the cargo/rustc links
# to it, rustup's home with every installed toolchain, and the tools glaeda-cmux-runner-hook's job-started probes
# on the job PATH (rustup, rustc, cargo, python3, gh, git, xcodebuild) plus the Xcode apps. All 14 runner minis lost
# ~/.cargo/bin/rustup on 2026-10-26 (21:26-00:48Z); job-started then refused every job ("cannot name a toolchain
# for 'rustc 1.98.1'"). Whatever removed it, glaeda-disk must never be able to.
TOOLCHAIN_HOME_PATHS = (".cargo/bin", ".rustup")  # under HOME; CARGO_HOME/bin and RUSTUP_HOME too
# Every tool job-started probes (glaeda-cmux-runner-hook TOOLCHAIN_PROBES, toolchain_refusal, xcode_refusal).
TOOLCHAIN_TOOLS = ("rustup", "rustc", "cargo", "zig", "python3", "gh", "git", "xcodebuild", "xcrun", "swift", "swiftc",
                   "clang", "make", "ld")
TOOLCHAIN_ROOTS = ("/Applications",)  # the pool Xcode (--toolchain-xcode) and every other Xcode_*.app
# Where TOOLCHAIN_TOOLS are looked up: every one of the fleet's fixed tool directories, each match kept (not only the
# first, so the order a job's PATH puts them in does not matter), never the caller's PATH, which inside a job can
# name a checkout's own bin directory and would then keep that checkout.
TOOLCHAIN_BIN_DIRS = (".cargo/bin", ".local/bin")  # under HOME
TOOLCHAIN_SYSTEM_BIN_DIRS = ("/opt/homebrew/bin", "/usr/local/bin", "/usr/bin")
_TOOLCHAIN_KEEP: dict[tuple[str, str, str], tuple[str, ...]] = {}


def toolchain_keep(fresh: bool = False) -> tuple[str, ...]:
    """The job toolchain: TOOLCHAIN_HOME_PATHS, CARGO_HOME/bin, RUSTUP_HOME, TOOLCHAIN_ROOTS, and each TOOLCHAIN_TOOLS
    binary in any of the fixed tool dirs with that dir. Each both as spelled (absolute, symlinks kept) and resolved,
    with every symlink on the way, so neither a symlinked ancestor nor the link's target can go. Cached per HOME,
    CARGO_HOME and RUSTUP_HOME for never_delete, which runs for every directory a discovery walk visits; fresh
    (remove() and finish_deletion(), just before a delete) looks again, so a tool switched mid-run is kept too."""
    env = os.environ
    key = (os.fspath(HOME), env.get("CARGO_HOME", ""), env.get("RUSTUP_HOME", ""))
    if fresh or key not in _TOOLCHAIN_KEEP:
        paths = [HOME / rel for rel in TOOLCHAIN_HOME_PATHS] + [Path(r) for r in TOOLCHAIN_ROOTS]
        if env.get("CARGO_HOME"):
            paths.append(Path(env["CARGO_HOME"]) / "bin")
        if env.get("RUSTUP_HOME"):
            paths.append(Path(env["RUSTUP_HOME"]))
        for d in [HOME / d for d in TOOLCHAIN_BIN_DIRS] + [Path(d) for d in TOOLCHAIN_SYSTEM_BIN_DIRS]:
            for tool in TOOLCHAIN_TOOLS:
                if os.path.lexists(d / tool):
                    paths += [d, d / tool]
        out: list[str] = []
        for path in paths:
            out += _link_spellings(os.path.abspath(path))
            out.append(os.path.realpath(path))
        _TOOLCHAIN_KEEP[key] = tuple(dict.fromkeys(out))
    return _TOOLCHAIN_KEEP[key]


def _link_spellings(path: str, hops: int = 40) -> list[str]:
    """PATH and every spelling it passes through on the way to its target, resolved one component at a time: a symlink
    in any component (~/.cargo -> ~/.cache/cargo-switch/current -> /opt/job-cargo) adds each target with the rest of
    PATH appended (~/.cache/cargo-switch/current/bin, /opt/job-cargo/bin). The link itself is never added as a path of
    its own: it is above the spelling that runs through it, so it is kept that way, while a system link such as /tmp
    keeps only what PATH runs through, not everything below it."""
    out = [path]
    todo = [path]
    while todo and hops > 0:
        cur = todo.pop()
        parts = cur.split(os.sep)
        for i in range(2, len(parts) + 1):
            head = os.sep.join(parts[:i]) or os.sep
            if os.path.islink(head):
                hops -= 1
                try:
                    target = os.path.normpath(os.path.join(os.path.dirname(head), os.readlink(head)))
                except OSError:
                    break
                nxt = os.path.join(target, *parts[i:]) if parts[i:] else target
                out.append(nxt)
                todo.append(nxt)
                break
    return out


def _at_inside_or_above(path: Path, keep: list[str] | tuple[str, ...]) -> bool:
    """PATH, as spelled or resolved, is at, inside or above any KEEP path."""
    return any(p == k or p.startswith(k + "/") or k.startswith(p + "/")
               for p in {os.path.abspath(path), os.path.realpath(path)} for k in keep)


def toolchain_held(path: Path, fresh: bool = False) -> bool:
    """PATH is at, inside or above a toolchain_keep() path or a role_keep() path. No family flag lifts it (not
    allow_stale_protected). A root above a role keep is held whole, so a family that would take that root as one
    item splits it first (nightly_next_split: the cmux-nightly-next root's other runners' trees still go by age)."""
    return _at_inside_or_above(path, toolchain_keep(fresh)) or _at_inside_or_above(path, role_keep())


# A dedicated runner's warm state, kept by role and not by age (Leo, 2026-10-26: warm compile caches an incremental
# build keeps fresh stay by role). glaeda-cmux-runner --dedicated writes the entry's `keep` paths, expanded, to
# <runner>/ROLE_KEEP_MARKER: the nightly-next builder's own checkout (_work/cmux/cmux, its .git and cargo targets)
# and its ~/Library/Caches/cmux-nightly-next/<runner> DerivedData. Only a glaeda-enrolled runner's marker counts,
# and only paths under the home that are not the home, the runner directory or its _work themselves; everything
# else in that runner (PR leftovers, _work/_temp, test TMPDIRs, other DerivedData) still goes by age.
ROLE_KEEP_MARKER = ".glaeda-keep.json"
# What a dedicated runner's jobs leave in its _work/_temp: goes once idle DEFAULT_AGE_HOURS (default_families)
DEDICATED_RUNNER_TEMP = "dedicated-runner-temp"


def real_runner_dir(runner: Path) -> bool:
    """RUNNER is a real directory directly in the home, not a symlink to a tree elsewhere."""
    try:
        return (not runner.is_symlink() and runner.is_dir()
                and os.path.realpath(runner) == os.path.join(os.path.realpath(HOME), runner.name))
    except OSError:
        return False


def role_keep() -> tuple[str, ...]:
    """Every enrolled dedicated runner's kept paths (ROLE_KEEP_MARKER), as spelled and resolved. Read fresh each
    call: a marker is small, and a keep the installer just added must hold for the very next delete."""
    out: list[str] = []
    home = os.path.realpath(HOME)
    for runner in HOME.glob("actions-runner-glaeda-*"):
        if not (real_runner_dir(runner) and (runner / ".runner").is_file() and (runner / "glaeda-hooks").is_dir()):
            continue
        try:
            paths = json.loads((runner / ROLE_KEEP_MARKER).read_text())
        except (OSError, ValueError):
            continue
        for raw in paths if isinstance(paths, list) else []:
            if not isinstance(raw, str) or not os.path.isabs(raw):
                continue
            for spelled in {os.path.abspath(raw), os.path.realpath(raw)}:
                if (spelled.startswith(home + "/") and spelled not in
                        {os.path.realpath(runner), os.path.realpath(runner / "_work"), os.path.abspath(runner),
                         os.path.abspath(runner / "_work")}):
                    out.append(spelled)
    return tuple(dict.fromkeys(out))


def toolchain_within(path: Path) -> bool:
    """PATH is at or inside a toolchain_keep() path: a discovery walk stops there, but walks on through one only
    above it (~/.cargo, to reach the registry beside ~/.cargo/bin), which toolchain_held still keeps whole."""
    return any(p == k or p.startswith(k + "/")
               for p in {os.path.abspath(path), os.path.realpath(path)} for k in toolchain_keep())


def never_delete(path: Path, walk: bool = False) -> bool:
    """With walk (a discovery walk asking whether to descend), a directory only above the job toolchain is not
    kept from the walk, only from being taken itself."""
    if NEVER_DELETE_NAMES.search(path.name):
        return True
    return (_at_inside_or_above(path, [os.path.realpath(HOME / keep) for keep in NEVER_DELETE])
            or (toolchain_within(path) if walk else toolchain_held(path)))


_LIVE_REFERENCES: dict[str, frozenset[str]] = {}


def live_artifact_references(root: Path = FLEET_ROOT) -> frozenset[str]:
    """Return paths named by active fleet reservations or leases, using read-only evidence."""
    key = os.fspath(root)
    if key in _LIVE_REFERENCES:
        return _LIVE_REFERENCES[key]
    refs: set[str] = set()
    now = time.time()
    reservation = root / "reservation.json"
    try:
        doc = json.loads(reservation.read_text())
        if doc.get("schema") == "glaeda-reservation/v1" and float(doc["until"]) > now:
            refs.add(os.path.realpath(root))
    except (OSError, ValueError, TypeError, KeyError):
        pass
    # Jobs and product leases are small JSON markers. Old history and empty lock files must not
    # pin the whole cache forever.
    for base in (root / "node-products/leases", root / "jobs", root / "job-volumes"):
        if not base.is_dir():
            continue
        try:
            paths = [p for p in base.rglob("*") if p.is_file() and p.stat().st_size <= 1 << 20]
        except OSError:
            continue
        for marker in paths:
            try:
                text = marker.read_text(errors="replace")
                doc = json.loads(text)
                state = str(doc.get("state", "")).lower()
                until = float(doc.get("until", 0) or 0)
                active = until > now or state in {"active", "running", "leased", "reserved", "started"}
            except (OSError, ValueError, TypeError, AttributeError):
                continue
            if not active:
                continue
            for match in re.findall(r"/(?:Users|private|tmp|var)/[^\s\"']+", text):
                refs.add(os.path.realpath(match.rstrip(",]}")))
    result = frozenset(refs)
    _LIVE_REFERENCES[key] = result
    return result


def fresh_artifact_references(root: Path) -> frozenset[str]:
    """live_artifact_references read again now: apply's re-check before a delete, never the survey's cached set."""
    _LIVE_REFERENCES.pop(os.fspath(root), None)
    return live_artifact_references(root)


def artifact_referenced(path: Path, references: frozenset[str]) -> bool:
    p = os.path.realpath(path)
    return any(p == ref or p.startswith(ref + os.sep) or ref.startswith(p + os.sep) for ref in references)


# cmux CI's warm state on an owned mini (cmux scripts/ci/owned_build_state.py, seed_derived_data.py).
# Root 1 keeps it in FLEET_CI, root k in FLEET_CI/cmux-ci-<k>. This is the local hot tier: every item is
# a copy of something a job can fetch or rebuild (seed bucket, the PR's next compile), so it is evicted
# LRU under pressure, keeping what the next job most likely starts from.
FLEET_CI = Path("/Users/Shared/cmux-build-fleet/ci")
SEED_SOURCE = "seed-source.json"
SEED_KEEP = 2  # seed_derived_data.LOCAL_KEEP_LOW_DISK: newest seeds of the current prefix each root keeps
# One age for everything disposable (Leo, 2026-10-26): "When have we ever had something useful greater than 12 hours?
# I mean, if something stalls, like sure, but why would it stall? If it stalls, it's gonna have to get a rebase
# anyway." DerivedData, CoreSimulator, package caches, runner work dirs and build dirs go once idle this long. Only
# the newest warm compile cache per builder is exempt, by role and not by age (the per-host cmux-next build root,
# cmux_next_ci_host_idle_hours; each root's newest SEED_KEEP seeds); older warm caches go at this age too.
DEFAULT_AGE_HOURS = 12.0
KEPT_BUILD_IDLE_HOURS = DEFAULT_AGE_HOURS
PARKED_IDLE_HOURS = float("inf")  # parked builds age by host-job reuse distance, not wall clock
# A missing job log cannot establish a reuse distance.  An idle sweep can still make
# bounded progress after DEFAULT_AGE_HOURS, the window used for mirror checkouts; the
# sweep's host-busy gate plus the normal process, socket, lease and recheck guards
# remain in force before any deletion.
PARKED_NO_LOG_IDLE_HOURS = DEFAULT_AGE_HOURS


def fleet_stores(ci: Path | None = None) -> list[Path]:
    ci = FLEET_CI if ci is None else ci
    if not ci.is_dir():
        return []
    return [ci, *sorted(p for p in ci.glob("cmux-ci-*")
                        if p.name[len("cmux-ci-"):].isdigit() and p.is_dir() and not p.is_symlink())]


