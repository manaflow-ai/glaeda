# Build output is write-heavy while a job is running.  It is therefore never part of
# the ordinary cache dedupe pass (which runs from a WatchPaths LaunchAgent).  The
# explicit --dedupe-builds pass below can include sealed Products directories after a state-root
# idle/ownership check.  Keep a floor even when the caller asks for no settle delay: a
# completed Xcode command can update a file just after its last write, and this pass is
# deliberately best-effort rather than a build synchronisation primitive.
CMUX_NEXT_CI_DEDUPE_SETTLE_MINUTES = 15.0
CMUX_NEXT_CI_DEDUPE_DIR_NAMES = frozenset({"Products"})
# ~/Library/Caches/cmux-nightly-next/<runner>: cmux's scripts/ci/nightly_build_state.py keeps NEXT's package
# checkouts, compilation cache and notices crates there, one tree per runner that built nightly-next (7-9 GiB
# each). Every pool runner of every mini could be that builder, so it held 0-35 GiB per mini (Leo, 2026-10-27:
# "and how can <100gb be free on >256gb minis all the time"). Once the build routes to one dedicated builder
# (cmux vars.CI_NIGHTLY_NEXT_DEDICATED_LABEL, cmux#26048; Leo: "what if we just dedicatd one, only, always, and
# it just incrementally... did the thing? clear its stuff, etc"), that builder's tree is kept by role and every
# pool runner's tree is its own fallback item that goes once idle DEFAULT_AGE_HOURS (read when the family is built,
# so a reserved host's keep_legacy_ages applies). The build still
# falls back to an idle pool mini when the builder is busy (cmux scripts/ci/nightly_build_runner.py: dedicated,
# then owned, then Blacksmith), so a recently used fallback stays warm under the normal age; one no overflow used
# for that long is not worth the disk (a cold Blacksmith Release build took a median 620 s against 830 s on a warm
# pool mini, 22 builds on 2026-10-26/27). Before, the whole root was one library-caches item that any pool runner's
# build kept fresh, so every tree on a mini stayed. Inert until disk-policy's
# nightly_next_dedicated_label names the label cmux routes by: before that the whole root stays the
# library-caches item it always was.
NIGHTLY_NEXT_ROOT = "cmux-nightly-next"
NIGHTLY_NEXT_FAMILY = "cmux-nightly-next-fallback"
NIGHTLY_NEXT_DEDICATED_LABEL = "glaeda-trusted-next-nightly"  # cmux pr_runner_pool.NIGHTLY_DEDICATED_LABEL
# the dedicated builder's runner: <member>-nightly-next (hand-made) or <member>-glaeda-nightly-next (glaeda#1648)
NIGHTLY_NEXT_DEDICATED_RUNNER = re.compile(r"[A-Za-z0-9._-]+-nightly-next")
# a pool runner's tree (cmux nightly_build_state.owned: <member>-glaeda[-K]); anything else in the root stays
NIGHTLY_NEXT_POOL_RUNNER = re.compile(r"[A-Za-z0-9._-]+-glaeda(?:-[0-9]+)?")


def fleet_families(ci: Path | None = None) -> list[Family]:
    fams = []
    for store in fleet_stores(ci):
        # A parked pull request build (owned_build_state.py, usable by reuse distance) has no disk floor of
        # its own: two per root grew a mini's use by ~38 GiB within hours of landing (cmux14, 2026-09-27).
        # Job activity, not wall-clock age, decides when a parked build is stale.
        fams.append(Family("cmux-pr-builds", store / "pr-builds", True,
                           "the pull request's next push compiles from main's kept build",
                           include=("pr-",), build_output=True, max_idle_hours=PARKED_IDLE_HOURS,
                           owner="cmux owned_build_state.py (park)", rebuild_minutes=6,
                           platform="macos"))
        # Seeds: the root's newest SEED_KEEP of its current prefix stay (seed_verdict); older and other
        # fingerprints' seeds go LRU. A seed comes back from the LAN seeder or the bucket in 25 to 280 s.
        # On the trusted seeder, one the seed archive already holds goes without waiting (archived_seeds).
        fams.append(Family("cmux-seeds", store / "seeds", True,
                           "glaeda-seed-prefetch or the next job fetches it again", build_output=True,
                           owner="cmux seed_derived_data.py (CMUX_SEED_LOCAL_CACHE)", rebuild_minutes=4,
                           platform="macos"))
        # A root's kept build (and a discard a killed job left) goes only when the root is dead.
        fams.append(Family("cmux-kept-build", store, True, "the next job on this root starts from a seed",
                           include=("derived-data", ".derived-data.discard-"), build_output=True,
                           min_idle_hours=KEPT_BUILD_IDLE_HOURS,
                           owner="cmux owned_build_state.py (keep)", rebuild_minutes=10,
                           platform="macos"))
    if fams:  # root 1's store is the mini's, and the only one that holds SwiftPM scratch (cmux mini_store)
        fams.append(spm_scratch_family(fleet_stores(ci)[0]))
    return fams


def ci_ios_family(root: Path | None = None) -> Family:
    """DerivedData left by the iOS runner pool, one generation per runner."""
    root = FLEET_ROOT / "ci-ios" if root is None else root
    return Family("ci-ios-derived-data", root, True,
                  "the next iOS job rebuilds its DerivedData", depth=2,
                  match="derived-data", build_output=True,
                  reference_root=FLEET_ROOT, owner="cmux iOS CI jobs", rebuild_minutes=8,
                  platform="macos")


# cmux CI's canonical build roots (cmux scripts/ci/canonical-build-root.sh): /private/tmp/cmux-ci is root 1,
# /private/tmp/cmux-ci-<k> root k. A compile job holds root k's capacity token for the whole job
# (glaeda-cmux-runner-hook take-root: an exclusive flock on capacity/root-<k>.token) and clears the root's
# admission DerivedData and compilation CAS before it builds; a rerun replaces them from the artifact. What a
# finished job leaves there only its own run's consumers read, so a day later it is dead weight. The tmp family
# judges the whole root as one item, and src/ (the root's checkout, with untracked build inputs) kept all of
# it: 8-9 GiB per idle root on cmux7s, cmux12s and cmux13s while the controller paused their claims for disk
# (2026-10-21). Only these names one level below the root, so src/ stays the tmp family's and git's to judge.
CANONICAL_ADMISSION = "cmux-ci-admission"
CANONICAL_ADMISSION_NAMES = ("derived-data-", "compile-admission-cas")
CANONICAL_ADMISSION_IDLE_HOURS = DEFAULT_AGE_HOURS
CANONICAL_CAPACITY = FLEET_ROOT / "capacity"


def canonical_root_number(root: Path) -> int | None:
    if root.name == "cmux-ci":
        return 1
    # the runner hook's own root spec: roots 2-99, ASCII digits only (/private/tmp is world-writable)
    m = re.fullmatch(r"cmux-ci-([2-9]|[1-9][0-9])", root.name)
    return int(m.group(1)) if m else None


def canonical_admission_families(tmp: Path | None = None) -> list[Family]:
    tmp = (Path("/private/tmp") if DARWIN else Path("/tmp")) if tmp is None else tmp
    roots = [tmp / "cmux-ci", *sorted(tmp.glob("cmux-ci-*"))]
    return [Family(CANONICAL_ADMISSION, root, True, "the next compile on this root clears and re-seeds it",
                   include=CANONICAL_ADMISSION_NAMES, build_output=True,
                   min_idle_hours=CANONICAL_ADMISSION_IDLE_HOURS,
                   owner="cmux ci-macos.yml compile admission (canonical build root)", rebuild_minutes=10,
                   platform="macos")
            for root in roots
            if canonical_root_number(root) is not None and root.is_dir() and not root.is_symlink()]


def canonical_root_token(path: Path, whole_root: bool = False) -> Path | None:
    """The token of the canonical root path sits in (an admission item), or with whole_root of path itself."""
    k = canonical_root_number(path if whole_root else path.parent)
    return None if k is None else CANONICAL_CAPACITY / f"root-{k}.token"


# The tmp family judges each canonical root as one item and may delete a whole one after an hour idle. A job's
# tree can sit an hour unwritten (a long test phase) while the job still holds the root, so the root's token
# decides there too: in use while held, and the delete takes it exclusive (remove_canonical_root).
def tmp_canonical_root(fam: "Family", path: Path) -> bool:
    return fam.id == "tmp" and path.parent == fam.root and canonical_root_number(path) is not None


def canonical_root_held(path: Path, whole_root: bool = False) -> bool:
    """Whether a job holds the canonical root an admission item sits in (with whole_root: the root path). Probed
    shared and released at once, as the runner hook's own probes do: a job's take retries past it. No token
    means no job ever took the root; an unreadable one, or a path outside a canonical root, counts as held."""
    token = canonical_root_token(path, whole_root)
    if token is None:
        return True
    try:
        fd = os.open(token, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return False
    except OSError:
        return True
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        os.close(fd)
    return False


def remove_canonical_root(root: Path) -> bool:
    """remove_canonical_admission for a whole canonical root (the tmp family's item)."""
    return remove_canonical_admission(root, whole_root=True)


def remove_canonical_admission(path: Path, whole_root: bool = False) -> bool:
    """Rename an admission item (with whole_root: the root itself) aside under its root's token, held exclusive
    as a job holds it, and delete it outside the lock. False, touching nothing, while a job holds the root."""
    token = canonical_root_token(path, whole_root)
    if token is None:
        return False
    if not token.parent.is_dir():  # no capacity dir: not a fleet mini, so no job can take the root
        remove(path)
        return True
    # created if missing, as the runner hook's lock_file creates it, so a job arriving now waits on this lock
    fd = os.open(token, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return False
    held = [fd]

    def release() -> None:
        if held:
            os.close(held.pop())

    try:
        remove(path, after_rename=release)
    finally:
        release()
    return True


# cmux CI's SwiftPM scratch (cmux scripts/ci/owned_spm_scratch.py): swift-package-tests links each package's .build
# to STORE/spm-scratch/<fingerprint>/<package> so a job rebuilds only what its change touched. A job holds
# <fingerprint>.lock shared (a holder process) until the runner ends it; `link` touches the lock, so its time is the
# directory's last use. Its owner bounds it only at a link (24 GiB LRU), so nothing evicted it under pressure:
# cmux9s held 31 GiB of it, none held by a job, while glaeda-disk --pressure found 0.0 GiB reclaimable and every
# runner's job-started hook refused at 21.9 GiB free under its 30 GiB floor (2026-09-30). A directory goes only
# under owned_spm_scratch's own protocol (remove_spm_scratch); its .trash-* leftovers always go.
SPM_SCRATCH = "cmux-spm-scratch"
SPM_TRASH = ".trash-"  # owned_spm_scratch.TRASH: a directory renamed aside for deletion, never reused
SPM_REBUILD_MINUTES = 3.0  # one swift-package-tests job rebuilds the packages its change selects


def spm_scratch_family(store: Path) -> Family:
    return Family(SPM_SCRATCH, store / "spm-scratch", True,
                  "the next swift-package-tests job rebuilds the packages it selects", build_output=True,
                  owner="cmux owned_spm_scratch.py", rebuild_minutes=SPM_REBUILD_MINUTES,
                  platform="macos")


def spm_lock(path: Path) -> Path:
    return path.with_name(path.name + ".lock")


def spm_scratch_held(path: Path) -> bool:
    """Whether a job holds this scratch directory: owned_spm_scratch's holder keeps a shared flock on
    <fingerprint>.lock for the whole job. Probed exclusive and released at once, as owned_spm_scratch's own drop()
    does: its link takes the lock blocking, so it waits out the probe; its prune skips the directory for that moment.
    No lock file means no job ever linked it. An unreadable lock counts as held."""
    if path.name.startswith(SPM_TRASH):
        return False
    try:
        fd = os.open(spm_lock(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return False
    except OSError:
        return True
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        os.close(fd)  # closing drops the probe's lock
    return False


def remove_spm_scratch(path: Path) -> bool:
    """owned_spm_scratch.drop(): under an exclusive lock on <fingerprint>.lock, rename the directory aside to
    .trash-<name>-<pid> (which owned_spm_scratch also sweeps, should this delete be killed) and drop its .size, then
    delete it outside the lock. False, touching nothing, while a job holds it."""
    if toolchain_held(path, fresh=True):
        raise OSError("refusing the job toolchain (toolchain_keep)")
    if path.is_symlink():
        raise OSError("refusing symlink")
    if os.path.ismount(path) or path.lstat().st_dev != path.parent.stat().st_dev:
        raise OSError("refusing a mount point")
    if path.name.startswith(SPM_TRASH):
        shutil.rmtree(path, onerror=_chmod_retry)
        return True
    with open(spm_lock(path), "a") as handle:  # created as owned_spm_scratch creates it
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        aside = path.with_name(f"{SPM_TRASH}{path.name}-{os.getpid()}")
        os.rename(path, aside)
        path.with_name(path.name + ".size").unlink(missing_ok=True)
    shutil.rmtree(aside, onerror=_chmod_retry)
    return True


# Filesystems whose free space is below the emergency floor (emergency_bytes) in this pressure run or report. There
# the SwiftPM scratch no job holds goes whatever its age: it rebuilds in minutes, and the runner floor is near.
EMERGENCY_DEVS: frozenset[int] = frozenset()

# Filesystems (device -> free bytes to stop at) where the runner gate holds runners for disk in this pressure
# run: free is under the hooks' --min-free-gib plus GATE_DISK_RESUME_GIB (a held runner resumes only above that).
# Idle runners' build output need not wait out RUNNER_BUILD_IDLE_HOURS there: it goes at once, after everything
# else apply would take, and only up to the floor plus target_margin_gib, so the rest keep warm builds. What
# keeps a job's output is the fresh ps before each delete (a Runner.Worker exists before the job's checkout),
# not the gate: a runner that was never held can still take a job between the floor and the resume mark. cmux11s and cmux9s sat at 8-25 GiB under a 30 GiB floor with 25-40 GiB of it
# "recent" while the gate held every runner idle (2026-10-21).
FLOOR_HOLD: dict[int, int] = {}
# Filesystems under FLOOR_HOLD -> the runner floor itself (floor_gib), in bytes: a per-host cmux-next build root
# younger than its idle window goes only while free is still below it, after everything else (cmux_next_ci_host_roots).
CMUX_NEXT_HOST_FLOOR: dict[int, int] = {}
GATE_DISK_RESUME_GIB = 2.0  # glaeda-cmux-runner-hook's: a disk hold ends only this far above the floor


def floor_hold(fss: "dict[int, Fs]", floor_gib: float, home: Path | None = None) -> dict[int, int]:
    if floor_gib <= 0:
        return {}
    try:
        dev = (HOME if home is None else home).stat().st_dev
    except OSError:
        return {}
    fs = fss.get(dev)
    if fs is None or fs.tmpfs or fs.free >= (floor_gib + GATE_DISK_RESUME_GIB) * GIB:
        return {}
    return {dev: min(int((floor_gib + POLICY["target_margin_gib"]) * GIB), fs.total // 2)}


def emergency_devs(fss: "dict[int, Fs]", emergency: str, floor_gib: float = 0.0) -> frozenset[int]:
    return frozenset(fs.dev for fs in fss.values() if fs.free < emergency_bytes(fs, emergency, floor_gib))


# The trusted seeder's serve log (glaeda-seed-serve): the seed archive on cmux-lawrence's SSD fills itself from
# it every 5 minutes (glaeda-seed-archive), asking seed-list-v1 and then one seed-v1 per seed it lacks.
SEED_SERVE_LOG = HOME / ".local/state/glaeda/seed-serve/serve.jsonl"


def archived_seeds(log: Path | None = None) -> frozenset[str]:
    """Seed keys the seed archive holds, as far as this seeder's serve log (and the rotated one) can show.

    Only the archive's filler asks seed-list-v1, so a client address that lists is the archive. A clean
    `served` alone is not enough: the filler still checks and renames the file afterwards and drops it on
    failure. Each run lists first, then asks for every seed it lacks, so two later lists from that client
    with no new request for the key mean the archive saw the seed as present. The PR minis restore it from
    there over the LAN (63 to 184 s against about 15 minutes cold), so it need not wait out the idle window.
    A client that lied about being the archive can only make a seed go early, and the next job refetches it.
    An unreadable or rotated-away log proves nothing, so the seed keeps its usual window.
    """
    log = SEED_SERVE_LOG if log is None else log
    records: list[dict] = []
    for path in (log.with_name(log.name + ".1"), log):
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            with contextlib.suppress(ValueError, RecursionError):
                record = json.loads(line)
                if isinstance(record, dict) and isinstance(record.get("client"), str) \
                        and record.get("role") == "seed":
                    records.append(record)
    lists: dict[str, int] = {}  # client -> lists seen after the record being read (walking backwards)
    decided: set[str] = set()
    held: set[str] = set()
    for r in reversed(records):
        client, outcome, key = r["client"], r.get("outcome"), r.get("key")
        if outcome == "list":
            lists[client] = lists.get(client, 0) + 1
        elif isinstance(key, str) and key not in decided and outcome in ("served", "failed"):
            decided.add(key)  # only a key's newest request counts
            if outcome == "served" and r.get("status") == 0 and lists.get(client, 0) >= 2:
                held.add(key)
    return frozenset(held)


# cmux's media tour (cmux-next-media.yml) builds two apps per tour slot into
# ~/Library/Developer/Xcode/DerivedData/cmux-ci-media-slot<N>-{base,head}, about 12 GiB each side.
# cmux_next_media_runner.py routes tours only to the glaeda-gui-<class>-* and glaeda-session-<class>-* labels,
# so the media hosts are the minis where an enrolled runner carries one of them: derived from the runners'
# own registration receipts, never a host list. Elsewhere these dirs go at once (a mini that lost its gui
# runner, or one that never had one). On a media host, the warm slots (index below media_tour_warm_slots,
# the workflow's CMUX_MEDIA_TOUR_SLOTS) are kept by role, not by age: they go only under the runner floor,
# after everything else. Overflow slots and old per-PR dirs keep the family's 12 h window. The usual
# in-use vetoes (open files, cwd, command lines) still hold for every one of them.
MEDIA_TOUR_DD = re.compile(r"^cmux-ci-media-[A-Za-z0-9._-]+$")
MEDIA_TOUR_WARM_SLOT = re.compile(r"^cmux-ci-media-slot(0|[1-9][0-9]*)-(?:base|head)$")
# pr_runner_pool.gui_label()/session_label(): glaeda-gui-<class>-xcode-<version>, glaeda-session-<class>-xcode-<version>
MEDIA_TOUR_LABEL = re.compile(r"^glaeda-(?:gui|session)-[a-z0-9]+-xcode-[0-9][0-9.]*$")
CMUX_RUNNER_STATE = HOME / ".local/state/glaeda/cmux-runner"
# media_tag_lock.py's lock dir: one flock per tag (ci-media-slot0 for cmux-ci-media-slot0-{base,head}), held by a
# tour from its claim until its Runner.Worker exits, before it has opened anything in the DerivedData.
MEDIA_TOUR_LOCKS = HOME / "Library/Caches/cmux-ci-media/locks"
_MEDIA_TOUR_HOST: bool | None = None
_MEDIA_TOUR_HOST_SET = False


def media_tour_host(state: Path | None = None) -> bool | None:
    """Whether a media tour can be routed to this host: True when an enrolled runner's registration carries a gui
    or session pool label, False when every enrolled runner was read and none does, None when no runner is
    enrolled here or a receipt cannot be read (not a CI mini, or unknown: nothing changes)."""
    global _MEDIA_TOUR_HOST, _MEDIA_TOUR_HOST_SET
    if state is None and _MEDIA_TOUR_HOST_SET:
        return _MEDIA_TOUR_HOST
    base = CMUX_RUNNER_STATE if state is None else state
    enrolled, answer = 0, False
    for path in [base / "receipt.json", *sorted(base.glob("instance-*/receipt.json"))]:
        try:
            doc = json.loads(path.read_text())
        except FileNotFoundError:
            continue
        except (OSError, ValueError):
            answer = None
            break
        if not isinstance(doc, dict) or doc.get("mode") == "uninstall":
            continue
        runner_dir = doc.get("runnerDir")
        if not runner_dir or not (Path(str(runner_dir)) / ".runner").is_file():
            continue  # not installed (any more): its labels route nothing here
        enrolled += 1
        labels = (doc.get("registration") or {}).get("labels") if isinstance(doc.get("registration"), dict) else None
        if not isinstance(labels, list):
            answer = None
            break
        if any(isinstance(x, str) and MEDIA_TOUR_LABEL.match(x) for x in labels):
            answer = True
            break
    result = answer if enrolled or answer is None else None
    if state is None:
        _MEDIA_TOUR_HOST, _MEDIA_TOUR_HOST_SET = result, True
    return result


def media_tour_dd(fam: Family, path: Path) -> bool:
    """Whether PATH is a cmux media tour's DerivedData (cmux-ci-media-<tag>) directly in Xcode's DerivedData."""
    return (fam.id == "xcode-derived-data" and path.parent == fam.root and bool(MEDIA_TOUR_DD.match(path.name))
            and not path.is_symlink())


def media_tour_warm_slot(fam: Family, path: Path) -> bool:
    """Whether PATH is one of a media host's warm tour slots, kept by role (see MEDIA_TOUR_DD)."""
    if not media_tour_dd(fam, path) or media_tour_host() is not True:
        return False
    m = MEDIA_TOUR_WARM_SLOT.match(path.name)
    return m is not None and int(m.group(1)) < int(POLICY["media_tour_warm_slots"])


def media_tour_tag_lock(path: Path) -> int | None:
    """An fd holding the tour tag lock of media DerivedData PATH (media_tag_lock.py), taken without waiting, or None
    while a tour holds it or the lock cannot be opened or taken (fail closed). Keep it until PATH is gone: a tour
    claiming the tag meanwhile takes the next slot or waits, so it never builds into a dir being removed."""
    tag = path.name[len("cmux-"):]
    for side in ("-base", "-head"):
        if tag.endswith(side):
            tag = tag[: -len(side)]
            break
    try:
        MEDIA_TOUR_LOCKS.mkdir(parents=True, exist_ok=True)
        fd = os.open(MEDIA_TOUR_LOCKS / f"{tag}.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def media_tour_tag_held(path: Path) -> bool:
    """Whether a tour holds (or may hold: the lock cannot be taken) the tag of media DerivedData PATH."""
    fd = media_tour_tag_lock(path)
    if fd is None:
        return True
    os.close(fd)
    return False


def remove_media_tour_dd(path: Path) -> bool:
    """Delete media DerivedData PATH only under its tour tag lock; False (nothing done) while a tour holds it."""
    fd = media_tour_tag_lock(path)
    if fd is None:
        return False
    try:
        remove(path)
    finally:
        os.close(fd)
    return True


def media_tour_stray(fam: Family, path: Path) -> bool:
    """Whether PATH is media tour DerivedData on an enrolled CI host that no tour can be routed to."""
    return media_tour_dd(fam, path) and media_tour_host() is False


def item_window(fam: Family, path: Path, idle_hours: float, archived: frozenset[str] = frozenset()) -> float:
    """The idle window for one candidate: a seed the archive already holds may go at once (the newest of each
    root still stay, by keep_verdict), and SwiftPM scratch left in the trash or under the emergency floor
    (EMERGENCY_DEVS) may go at once (its lock keeps what a job holds), and so may an idle runner's build output
    while the runner gate holds for disk (FLOOR_HOLD), and cmux-next output while that cache is over its cap
    (cmux_next_ci_over). Everything else waits out its family's window."""
    if fam.id == "cmux-seeds" and path.name in archived:
        return 0.0
    if media_tour_stray(fam, path):  # no tour can reach this host: nothing will reuse it
        return 0.0
    if media_tour_warm_slot(fam, path):  # warm by role: only under the runner floor (floor_hold_only)
        with contextlib.suppress(OSError):
            if fam.root.stat().st_dev in FLOOR_HOLD:
                return 0.0
        return math.inf
    if cmux_next_ci_host_root(fam, path):  # never the cap's: its own idle window, or at once under the floor hold
        with contextlib.suppress(OSError):
            if fam.root.stat().st_dev in FLOOR_HOLD:
                return 0.0
        window = float(POLICY["cmux_next_ci_host_idle_hours"])
        return max(window, fam.min_idle_hours) if RUNNER_CACHE_PROFILE else window  # that profile's minimum age
    if fam.id == CMUX_NEXT_CI_FAMILY and (CMUX_NEXT_CI_DRAIN or cmux_next_ci_over()):
        return 0.0
    if fam.id == SPM_SCRATCH:
        if path.name.startswith(SPM_TRASH):
            return 0.0
        with contextlib.suppress(OSError):
            if fam.root.stat().st_dev in EMERGENCY_DEVS:
                return 0.0
    if floor_hold_family(fam, path):
        with contextlib.suppress(OSError):
            if fam.root.stat().st_dev in FLOOR_HOLD:
                return 0.0
    return idle_window(fam, idle_hours)


def floor_hold_family(fam: Family, path: Path) -> bool:
    """Whether the runner gate's floor hold lets PATH go before its family's window: an idle runner's checkout
    build output, an enrolled runner's cmux-next scheme output (its Runner.Worker vetoes it in
    cmux_next_ci_busy), a canonical root's admission DerivedData once the root has a token file (the token keeps
    it while a compile or a product consumer holds the root: canonical_root_held, re-checked at apply with fresh
    process evidence and taken exclusive to delete; the next compile on the root clears it anyway, and a rerun
    restores it from the artifact; a root without a token file keeps its 12 h window), and code-sign clones
    (keep_live_app_clones and app_clone_running keep the live ones)."""
    if fam.id == RUNNER_BUILD_FAMILY or fam.app_clones or media_tour_warm_slot(fam, path):
        return True
    if fam.id == CANONICAL_ADMISSION:  # only where the runner hook's token protocol is in force on this root
        token = canonical_root_token(path)
        return token is not None and token.is_file() and not token.is_symlink()
    return fam.id == CMUX_NEXT_CI_FAMILY and not CMUX_NEXT_CI_DRAIN and (
        cmux_next_ci_runner(path, fam.root) is not None or cmux_next_ci_floor_slot(fam, path))


def floor_hold_only(fam: Family, item: "Item", idle_hours: float) -> bool:
    """Reclaimable only because of the floor hold: younger than its family's own window. A media host's warm tour
    slot has no age window, so the floor hold is the only thing that lets it go."""
    if media_tour_warm_slot(fam, Path(item.path)):
        return True
    return floor_hold_family(fam, Path(item.path)) and item.idle_hours < idle_window(fam, idle_hours)


def cmux_next_ci_over() -> int:
    """Bytes the cmux-next-ci cache is over its cap, counted only in a pressure run (never a drain)."""
    return CMUX_NEXT_CI_OVER if ACTIVITY_MODE == "pressure" and not CMUX_NEXT_CI_DRAIN else 0


def cmux_next_cap_only(fam: Family, path: Path, idle: float, idle_hours: float) -> bool:
    """Reclaimable only because the cmux-next-ci cache is over its cap: an unowned state root listed whole, or
    generated output younger than the family's own window. apply stops these once the cache is under the cap."""
    return (fam.id == CMUX_NEXT_CI_FAMILY and cmux_next_ci_over() > 0 and not cmux_next_ci_floor_slot(fam, path)
            and not cmux_next_ci_host_root(fam, path)
            and (cmux_next_ci_state_for(path, fam.root) is None or idle < idle_window(fam, idle_hours)))


# The idle sweep (--idle): windows from how often each family is read again, not from free space.
# cmux restores parked PR builds by host-job reuse distance, so a quiet fleet does not age them out. A job
# touches the seed it starts from, so a seed's mtime is its last use.
# A busy root lands about four new ~9 GiB seeds an hour; one no job picked for a day (beyond the root's
# newest SEED_KEEP, which stay) sits far behind every new base, and a fetch brings it back in 25 to 280 s.
# Twelve hours, not less: cmux keeps the newest seeds per root while older generations can be
# fetched again from the LAN archive. DerivedData, caches and scratch get KEPT_BUILD_IDLE_HOURS,
# which bounds stale disposable output without touching a live job's state.
IDLE_SWEEP_HOURS = KEPT_BUILD_IDLE_HOURS
IDLE_PR_BUILD_HOURS = float("inf")
IDLE_SEED_HOURS = DEFAULT_AGE_HOURS
IDLE_SWEEP_EVERY_S = 3600  # the 15-minute agent sweeps at most hourly: an apply re-measures every candidate
IDLE_STAMP = HOME / ".cache/glaeda-disk/idle-sweep.last"
FLEET_DIR = FLEET_CI.parent
BUILD_PROCESS = re.compile(r"(^|/)(xcodebuild|SWBBuildService|XCBBuildService)(\s|$)")


def idle_families(fams: list[Family]) -> list[Family]:
    """The families as the idle sweep judges them: the hot tier gets its reuse windows."""
    windows = {"cmux-pr-builds": IDLE_PR_BUILD_HOURS, "cmux-seeds": IDLE_SEED_HOURS}
    return [replace(f, max_idle_hours=windows[f.id]) if f.id in windows else f for f in fams]


# Activity, not wall clock (Leo, 2026-09-29): a cache idle for 5 h because the whole fleet was idle is not
# stale, nothing had a chance to use it. So the hot tier (FLEET_FAMILY_IDS) ages in host CI jobs: how many
# jobs started on this host (the runner hook's job log) since the item was last used. Measured on 13 minis,
# 2026-09-26..29, 11,393 job starts: a job of the same PR (or push ref) came back to the same host after
# p50 6, p75 23, p90 76, p95 189, p99 431 other jobs (0.4 / 1.4 / 5.2 / 15.5 / 46 h), so wall clock says
# little (p90 5 h, p99 46 h) while the job count separates reuse from cruft. Under pressure an item goes
# once pressure_jobs (~p90) jobs passed it, or once it is past its family's window with at least min_jobs
# (~p50) jobs since. The idle sweep (no pressure) takes one past sweep_jobs (~p95), or one idle
# soft_idle_hours with pressure_jobs since: the soft 12 h rule, never an age cap on a quiet fleet. A host
# without a job log keeps the wall-clock windows. Every threshold is a key of DISK_POLICY.
DISK_POLICY = HOME / ".config/glaeda/disk-policy.json"
# The kill switch (or "enabled": false in DISK_POLICY): an --apply run deletes nothing.
DISK_OFF = HOME / ".config/glaeda/disk-off"
# One JSON line per --apply run (write_run_line), next to the verbose log the agents keep.
RUN_LOG = HOME / ("Library/Logs/glaeda-disk-runs.jsonl" if sys.platform == "darwin"
                  else ".local/state/glaeda/disk-runs.jsonl")
RUN: dict[str, Any] = {}  # what this run did, for its run line; _main_impl fills it


def run_caller() -> str:
    """Who started this run: CALLER_ENV, else the parent process's command (bounded), else its pid."""
    named = os.environ.get(CALLER_ENV, "").strip()
    if named:
        return named[:120]
    try:
        out = subprocess.run(["ps", "-o", "command=", "-p", str(os.getppid())], capture_output=True, text=True,
                             timeout=5, check=False).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        out = ""
    return (out or f"pid {os.getppid()}")[:120]


HOOK_PASS_CLAIMED = Path(f"{HOOK_PASS_PENDING}.claimed")
_HOOK_PASS_FD: int | None = None  # HOOK_PASS_LOCK, held for the rest of this run once taken (take_hook_pass)


def take_hook_pass() -> bool | None:
    """Take the runner hook's one-pass-at-a-time lock for this run, as the hook's pass process does: True when taken
    (held until this process exits, so no hook pass overlaps it; the triggers waiting are claimed for it), False when
    a pass holds it (this run's trigger is then left for that pass, which serves it with its follow-up), None when
    the lock cannot be used (the run goes on as before). The trigger is written before the second try, so a pass that
    lets go in between either sees it or leaves the lock to this run."""
    global _HOOK_PASS_FD
    try:
        HOOK_PASS_LOCK.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(HOOK_PASS_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    except OSError:
        return None
    for attempt in range(2):
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if attempt:
                os.close(fd)
                return False
            try:
                os.close(os.open(HOOK_PASS_PENDING, os.O_WRONLY | os.O_CREAT, 0o600))
            except OSError:
                os.close(fd)
                return False  # never overlap the running pass, which is freeing space now; the next run comes back
            continue
        except OSError:
            os.close(fd)
            return None
        _HOOK_PASS_FD = fd
        with contextlib.suppress(OSError):
            os.replace(HOOK_PASS_PENDING, HOOK_PASS_CLAIMED)  # served by this run, which starts after them
        return True
    return False


def release_hook_pass(served: bool) -> None:
    """Let go of the hook's lock; the claimed triggers are cleared only when this run did its pass, and a run that did
    none leaves its own trigger claimed too, for the next pass."""
    global _HOOK_PASS_FD
    if _HOOK_PASS_FD is None:
        return
    with contextlib.suppress(OSError):
        if served:
            HOOK_PASS_CLAIMED.unlink()
        else:
            os.close(os.open(HOOK_PASS_CLAIMED, os.O_WRONLY | os.O_CREAT, 0o600))
    with contextlib.suppress(OSError):
        os.close(_HOOK_PASS_FD)
    _HOOK_PASS_FD = None


def config_sha256(disk: Path | None = None, policy: Path | None = None) -> str:
    """What decides a default run's targets: this script's bytes (POLICY_DEFAULTS) and DISK_POLICY's ("" when absent).
    The runner hook computes the same and trusts a run line's targets only when they match."""
    h = hashlib.sha256()
    for path in (disk or Path(os.path.abspath(__file__)), policy or DISK_POLICY):
        try:
            h.update(path.read_bytes())
        except OSError:
            pass
        h.update(b"\0")
    return h.hexdigest()
POLICY_DEFAULTS: dict[str, Any] = {
    "enabled": True,
    "low": "25%:60-200",
    "target": "35%:100-350",
    "emergency": "10%:30-60",
    "low_margin_gib": 4.0,
    "target_margin_gib": 20.0,
    "pressure_idle_hours": 0.5,
    # PRESSURE_MEASURE_BUDGET_S: seconds a pressure --apply spends starting size walks (0: no bound)
    "pressure_measure_budget_s": float(PRESSURE_MEASURE_BUDGET_S),
    "pressure_jobs": 80,
    "min_jobs": 6,
    "sweep_jobs": 190,
    "soft_idle_hours": DEFAULT_AGE_HOURS,
    # Build markers are aged by observed host activity, not a fixed wall-clock
    # guess.  The cap is only a recovery bound when the job log is unavailable.
    "stale_marker_min_age_hours": 0.5,
    "stale_marker_jobs": 3,
    "stale_marker_max_hours": DEFAULT_AGE_HOURS,
    # A busy host cleans too: deletes skip only what a job uses (open, named by a command, its root's
    # current seed or checkout), never the whole pass. true restores the old defer-while-CI-runs rule.
    "defer_during_ci": False,
    # LRU size cap on ~/Library/Caches/cmux-next-ci (CMUX_NEXT_CI_OVER); 0 turns it off. --cmux-next-cap-gib.
    "cmux_next_ci_cap_gib": 40.0,
    # Over the cap, a cmux-next state no enrolled runner owns goes whole (inputs too) only once idle this long:
    # GitHub's default job timeout (timeout-minutes 360), so no job can still be using it.
    "cmux_next_ci_unowned_idle_hours": 6.0,
    # Warm media tour slots a media host keeps by role (cmux-ci-media-slot<N>-{base,head}, N below this): cmux's
    # CMUX_MEDIA_TOUR_SLOTS, default 2. They go only under the runner floor; on a host no tour can reach, none stay.
    "media_tour_warm_slots": 2,
    # Per-host cmux-next build roots, relative to the cmux-next-ci cache (cmux#25147: the DEV Release compile builds
    # from one tree per mini, so the compilation cache's path-bearing keys match whichever runner instance builds).
    # Builds hold flock(2) on <root>/lock; <root>/src and <root>/Release/xcode-<toolchain> are one warm state, and the
    # per-instance states beside it (<kind>/<key>) are only its busy-lock fallback. A host root goes whole and last
    # (cmux_next_ci_host_roots): never for the size cap, only once idle cmux_next_ci_host_idle_hours, or while free is
    # still under the runner floor after everything else, and never while its lock is held. [] turns this off.
    "cmux_next_ci_host_roots": ["dev-daily-release/host"],
    # The newest warm compile cache per builder is exempt by role, not by age (DEFAULT_AGE_HOURS): the host root goes
    # only under the runner floor. A finite number here ages it again.
    "cmux_next_ci_host_idle_hours": float("inf"),
    # The label cmux's nightly-next build routes to its one dedicated builder by (vars.CI_NIGHTLY_NEXT_DEDICATED_LABEL).
    # Only NIGHTLY_NEXT_DEDICATED_LABEL turns the cmux-nightly-next fallback eviction on; "" (or any other value)
    # leaves that cache as it was. Set it only once that variable is set, so no fallback goes before the routing.
    "nightly_next_dedicated_label": "",
    # --dedupe also clones identical files in capture and evidence trees (screen-capture frames, UI evidence),
    # with its own floor: one PNG frame is 16-200 KiB, so Xcode's 1 MiB floor saw 2.7 of the 11.2 GiB of
    # identical frames in cmux-mac-mini's ~/messageslab-26. "~" is the account's home; globs are allowed; a
    # missing root is skipped; [] turns the capture pass off.
    "dedupe_capture_roots": [
        "~/messageslab-*", "~/Projects/captures", "~/Projects/*-evidence", "~/Projects/*-validation",
        "~/Applications/cx-ui-captures", "~/cmux-showcase-runs",
        "/Users/Shared/cmux-capture", "/Users/Shared/cmux-captures", "/Users/Shared/cmux-cua-artifacts",
    ],
    "dedupe_capture_min_kib": 16,
    # a file written this recently may still be recording; it waits for a later pass
    "dedupe_capture_settle_minutes": 30.0,
    # one pass stops here (walking, hashing and cloning); its hashes are kept, and the next pass resumes
    "dedupe_capture_budget_minutes": 20.0,
}
ACTIVITY_MODE: str | None = None  # "pressure" or "sweep" while main acts; None keeps the wall-clock rule
ROLE = "fleet-mini"
DEVBOX_TRANSCRIPT_DAYS = 30
DEVBOX_TRANSCRIPT_DELETE_DAYS = 180


def policy_overrides(path: Path | None = None) -> dict[str, Any]:
    """The keys DISK_POLICY sets, each with a value of its default's type; an unreadable file sets none."""
    out: dict[str, Any] = {}
    try:
        doc = json.loads((DISK_POLICY if path is None else path).read_text())
    except (OSError, ValueError):
        return out
    if isinstance(doc, dict):
        for key, default in POLICY_DEFAULTS.items():
            value = doc.get(key)
            if isinstance(default, bool):
                if isinstance(value, bool):
                    out[key] = value
            elif isinstance(default, list):
                if isinstance(value, list) and all(isinstance(v, str) and v for v in value):
                    out[key] = list(value)
            elif isinstance(default, str):
                if isinstance(value, str) and value:
                    out[key] = value
            elif isinstance(value, (int, float)) and not isinstance(value, bool) and value >= 0:
                if math.isfinite(value):
                    out[key] = type(default)(value)
    return out


def disk_policy(path: Path | None = None) -> dict[str, Any]:
    """POLICY_DEFAULTS overlaid with DISK_POLICY; an unreadable file or a wrongly typed key keeps the default."""
    return {**POLICY_DEFAULTS, **policy_overrides(path)}


POLICY = disk_policy()
_JOB_STARTS: list[float] | None = None
_JOB_STARTS_READ = False


def job_starts(log: Path | None = None) -> list[float] | None:
    """Sorted start times of this host's CI jobs (glaeda-cmux-jobs.jsonl "started" lines), or None without a log."""
    global _JOB_STARTS, _JOB_STARTS_READ
    if log is None and _JOB_STARTS_READ:
        return _JOB_STARTS
    path = log or HOME / "Library/Logs/glaeda-cmux-jobs.jsonl"
    starts: list[float] | None
    try:
        with path.open(encoding="utf-8", errors="replace") as f:
            starts = []
            for line in f:
                if '"started"' not in line:
                    continue
                try:
                    doc = json.loads(line)
                except ValueError:
                    continue
                at = doc.get("at") if isinstance(doc, dict) else None
                if doc.get("event") == "started" and isinstance(at, (int, float)) and not isinstance(at, bool):
                    starts.append(float(at))
            starts.sort()
    except OSError:
        starts = None
    if log is None:
        _JOB_STARTS, _JOB_STARTS_READ = starts, True
    return starts


def jobs_since_use(fam: "Family", idle_hours: float, now: float | None = None) -> int | None:
    """Host CI jobs started since a hot-tier item's last use, or None (not hot tier, or no job log)."""
    if fam.id not in FLEET_FAMILY_IDS:
        return None
    starts = job_starts()
    if starts is None:
        return None
    last_use = (time.time() if now is None else now) - idle_hours * 3600
    return len(starts) - bisect.bisect_right(starts, last_use)


_RUNNING_JOB_HOURS: float | None = None


def running_job_hours() -> float:
    """Age in hours of the oldest running CI job (Runner.Worker), 0 when none; ps failing counts as a day."""
    global _RUNNING_JOB_HOURS
    if _RUNNING_JOB_HOURS is None:
        try:
            out = subprocess.run(["ps", "-axww", "-o", "etime=,command="], capture_output=True, text=True,
                                 timeout=60).stdout
        except (OSError, subprocess.SubprocessError):
            out = None
        oldest = 0.0 if out is not None else 24.0
        for line in (out or "").splitlines():
            etime, _, cmd = line.strip().partition(" ")
            if CI_WORKER.search(cmd):
                days, _, clock = etime.rpartition("-")
                parts = [int(x) for x in clock.split(":") if x.isdigit()]
                secs = sum(v * 60 ** i for i, v in enumerate(reversed(parts))) + int(days or 0) * 86400
                oldest = max(oldest, secs / 3600)
        _RUNNING_JOB_HOURS = oldest
    return _RUNNING_JOB_HOURS


def item_due(fam: "Family", idle_hours: float, window: float) -> tuple[bool, int | None]:
    """Whether an item is old enough to delete, and the job count that decided it (None: wall clock).

    A hot-tier item used since the oldest running CI job started is never due: that job may hold it
    (a `cp -cR` clone leaves the source's times alone, and a step between commands names no path),
    which the old defer-while-CI-runs rule covered. Its own run counts toward jobs_since, so without
    this a job could age the seed it started from past pressure_jobs."""
    jobs = jobs_since_use(fam, idle_hours)
    if ACTIVITY_MODE == "pressure" and fam.id in FLEET_FAMILY_IDS:
        # Pressure spends disposable hot state until the free target, even on a quiet host.
        # A running job may touch a source between commands; cwd, command-line, socket and job-unit
        # checks preserve that veto. Do not use the job's age as a blanket six-hour retention window.
        return idle_hours >= POLICY["pressure_idle_hours"], jobs
    if jobs is None and fam.id == "cmux-pr-builds":
        # A quiet fleet with no job log must not age parked builds merely because
        # wall-clock time passed.  Once an idle sweep has observed a full mirror
        # window, however, retaining them forever leaves the hot tier unbounded.
        # `apply` still rechecks process/open-file evidence, and the idle sweep
        # stops on a busy host before it mutates anything.
        return (ACTIVITY_MODE == "sweep"
                and idle_hours >= PARKED_NO_LOG_IDLE_HOURS), None
    if jobs is None or ACTIVITY_MODE is None:
        return idle_hours >= window, jobs
    if idle_hours <= running_job_hours():
        return False, jobs
    return (jobs >= POLICY["sweep_jobs"]
            or (idle_hours >= POLICY["soft_idle_hours"] and jobs >= POLICY["pressure_jobs"])), jobs


# host_busy's reasons that are no answer (it could not read), not a busy host: a caller that waits for idle (the
# Tailscale restart in glaeda-mini-health) tells them apart with host_busy_unreadable instead of matching text.
HOST_PS_UNREADABLE = "cannot list processes"
HOST_JOBS_UNREADABLE = "cannot read {jobs}"
HOST_RESERVATION_UNREADABLE = "the host reservation is unreadable"
HOST_LOCK_UNREADABLE = "the host lock is unreadable"


def host_busy_unreadable(reason: str) -> bool:
    """Whether a host_busy reason is one it gives when it could not read the host, not one for a busy host."""
    prefix, suffix = HOST_JOBS_UNREADABLE.split("{jobs}")
    return reason in {HOST_PS_UNREADABLE, HOST_RESERVATION_UNREADABLE, HOST_LOCK_UNREADABLE} or (
        reason.startswith(prefix) and reason.endswith("/jobs") and len(reason) > len(prefix) + len(suffix))


def host_busy(fleet: Path | None = None, now: float | None = None) -> str:
    """Why this host is not idle, or "": a CI job or build process, a dev-build worker job, an active or
    unreadable reservation, or the fleet host lock held (PR jobs hold it shared, fleet builds exclusive).
    Anything unreadable counts as busy."""
    fleet = FLEET_DIR if fleet is None else fleet
    now = time.time() if now is None else now
    try:
        ps = subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return HOST_PS_UNREADABLE
    if ps.returncode != 0 or not ps.stdout.strip():
        return HOST_PS_UNREADABLE
    for line in ps.stdout.splitlines():
        if CI_WORKER.search(line):
            return f"a CI job is running ({line.strip()[:120]})"
        if BUILD_PROCESS.search(line):  # the whole line: an Xcode path may hold a space
            return f"a build is running ({line.strip()[:120]})"
    try:
        with os.scandir(fleet / "jobs") as it:
            if any(not e.name.startswith(".") for e in it):
                return f"a dev-build worker job is in {fleet / 'jobs'}"
    except FileNotFoundError:
        pass
    except OSError:
        return HOST_JOBS_UNREADABLE.format(jobs=fleet / "jobs")
    try:
        doc = json.loads((fleet / "reservation.json").read_text())
    except FileNotFoundError:
        pass
    except (OSError, ValueError):
        return HOST_RESERVATION_UNREADABLE
    else:
        # glaeda_reservation's rule: another schema or a non-integer time is invalid, and invalid is active
        until = doc.get("until") if isinstance(doc, dict) else None
        if (not isinstance(doc, dict) or doc.get("schema") != "glaeda-reservation/v1"
                or not isinstance(until, int) or isinstance(until, bool) or now < until):
            return "the host is reserved"
    try:
        fd = os.open(fleet / "host.lock", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return ""
    except OSError:
        return HOST_LOCK_UNREADABLE
    try:
        # shared, as the runner hook's host_held probes: an exclusive probe could make a PR job's own
        # one-shot exclusive take fail. PR jobs (shared holders) are caught by Runner.Worker above.
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        return "a fleet build holds the host lock"
    finally:
        os.close(fd)
    return ""


def _valid_cmux_next_drain_reservation(marker: object, now: float | None = None) -> bool:
    now = time.time() if now is None else now
    return (isinstance(marker, dict) and marker.get("schema") == "glaeda-reservation/v1"
            and isinstance(marker.get("owner"), str) and isinstance(marker.get("purpose"), str)
            and isinstance(marker.get("since"), int) and not isinstance(marker.get("since"), bool)
            and isinstance(marker.get("until"), int) and not isinstance(marker.get("until"), bool)
            and 0 <= marker["since"] <= now and now < marker["until"] <= now + 24 * 3600
            and marker["until"] - marker["since"] <= 24 * 3600)


def _hook_proves_whole_job_host_lock(source: str) -> bool:
    """Recognize the installed hook's call graph, ignoring comments/strings."""
    try:
        tree = ast.parse(source)
    except SyntaxError:
        return False
    definitions = {node.name for node in ast.walk(tree) if isinstance(node, ast.FunctionDef)}
    calls = {node.func.id for node in ast.walk(tree)
             if isinstance(node, ast.Call) and isinstance(node.func, ast.Name)}
    return {"take_host_lock", "release_host_lock"} <= definitions and {"take_host_lock", "release_host_lock"} <= calls


def cmux_next_drain_preflight(fleet: Path | None = None, expected_owner: str | None = None) -> tuple[object | None, str]:
    """Acquire the enrolled runner's exclusive host lock for explicit drain mode.

    This is intentionally stricter than ``host_busy``: a bounded active
    reservation and installed job-started wrappers prove that new Glaeda jobs
    are being admitted through the whole-job host lock.  The returned file
    handle remains open until the caller has completed its fresh checks and
    renames.
    """
    fleet = FLEET_DIR if fleet is None else fleet
    if fleet.is_symlink() or not fleet.is_dir():
        return None, "cmux-next drain requires a non-symlink fleet directory"
    cursor = fleet
    while cursor.parent != cursor:
        if cursor.is_symlink():
            return None, "cmux-next drain refuses symlinked fleet ancestors"
        cursor = cursor.parent
    reservation = fleet / "reservation.json"
    try:
        if reservation.is_symlink() or not reservation.is_file():
            return None, "cmux-next drain requires a regular reservation file"
        raw = reservation.read_text()
        marker = json.loads(raw)
        if not _valid_cmux_next_drain_reservation(marker):
            return None, "cmux-next drain requires a fresh active Glaeda reservation"
        if not expected_owner or marker.get("owner") != expected_owner:
            return None, "cmux-next drain reservation owner does not match the requested owner"
        global CMUX_NEXT_CI_DRAIN_RESERVATION
        CMUX_NEXT_CI_DRAIN_RESERVATION = dict(marker)
    except (OSError, ValueError, TypeError):
        return None, "cmux-next drain requires a readable active Glaeda reservation"
    runners = []
    try:
        for runner in HOME.glob("actions-runner*"):
            hook_dir = runner / "glaeda-hooks"
            registration = runner / ".runner"
            started = hook_dir / "job-started.sh"
            registered = registration.exists() or registration.is_symlink()
            if not registered:
                continue
            if (runner.is_symlink() or registration.is_symlink() or not registration.is_file()
                    or hook_dir.is_symlink() or not hook_dir.is_dir()
                    or started.is_symlink() or not started.is_file()):
                return None, f"runner enrollment state is unsafe for {runner.name}"
            if runner.is_dir():
                text = started.read_text()
                implementation = (hook_dir / "glaeda-cmux-runner-hook")
                if implementation.is_symlink() or not implementation.is_file():
                    return None, f"runner hook implementation is unsafe for {runner.name}"
                implementation_bytes = implementation.read_bytes()
                implementation_text = implementation_bytes.decode()
                implementation_sha = hashlib.sha256(implementation_bytes).hexdigest()
                if ("glaeda-cmux-runner-hook" not in text or " job-started" not in text
                        or implementation_sha not in CMUX_NEXT_DRAIN_HOOK_SHA256
                        or not _hook_proves_whole_job_host_lock(implementation_text)):
                    return None, f"runner hook enrollment is not proven for {runner.name}"
                plist_paths = [*HOME.glob("Library/LaunchAgents/*.plist"),
                               *Path("/Library/LaunchDaemons").glob("*.plist")]
                enrolled = False
                for plist in plist_paths:
                    try:
                        if plist.is_symlink() or not plist.is_file():
                            continue
                        doc = plistlib.loads(plist.read_bytes())
                        env = doc.get("EnvironmentVariables", {}) if isinstance(doc, dict) else {}
                        if env.get("ACTIONS_RUNNER_HOOK_JOB_STARTED") == os.fspath(started):
                            enrolled = True
                            break
                    except (OSError, ValueError, plistlib.InvalidFileException):
                        continue
                if not enrolled:
                    return None, f"launchd does not prove job-started enrollment for {runner.name}"
                runners.append(runner)
    except (OSError, UnicodeDecodeError):
        return None, "runner hook enrollment could not be inspected"
    if not runners:
        return None, "cmux-next drain requires an enrolled Glaeda runner"
    busy = cmux_next_drain_halt(fleet)
    if busy:
        return None, busy
    lock = fleet / "host.lock"
    try:
        if lock.is_symlink() or not lock.exists() or not lock.is_file():
            return None, "cmux-next drain requires the enrolled runner host.lock"
        handle = lock.open("a+")
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, BlockingIOError):
        with contextlib.suppress(UnboundLocalError, OSError):
            handle.close()
        return None, "cmux-next drain deferred: host.lock is held"
    busy = cmux_next_drain_halt(fleet)
    if busy:
        fcntl.flock(handle, fcntl.LOCK_UN)
        handle.close()
        return None, f"cmux-next drain deferred after lock: {busy}"
    return handle, ""


def cmux_next_drain_halt(fleet: Path | None = None) -> str:
    """Fresh per-candidate reservation/process gate while drain mode holds host.lock."""
    fleet = FLEET_DIR if fleet is None else fleet
    try:
        marker = json.loads((fleet / "reservation.json").read_text())
        if not _valid_cmux_next_drain_reservation(marker):
            return "cmux-next drain reservation expired or changed"
        if CMUX_NEXT_CI_DRAIN_RESERVATION is None or marker != CMUX_NEXT_CI_DRAIN_RESERVATION:
            return "cmux-next drain reservation changed"
        ps = subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True, timeout=60)
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        return "cmux-next drain cannot recheck reservation/process state"
    if ps.returncode != 0 or not ps.stdout.strip():
        return "cmux-next drain cannot recheck process state"
    for line in ps.stdout.splitlines():
        if CI_WORKER.search(line) or BUILD_PROCESS.search(line):
            return f"cmux-next drain deferred: live job/build ({line.strip()[:120]})"
    return ""


def _fresh(path: Path, seconds: float) -> bool:
    try:
        return time.time() - path.stat().st_mtime < seconds
    except OSError:
        return False


def idle_due(stamp: Path | None = None, every_s: float = IDLE_SWEEP_EVERY_S) -> bool:
    return not _fresh(IDLE_STAMP if stamp is None else stamp, every_s)


# Xcode copies and simulator runtimes (idle sweep, macOS). An Xcode is an install, not a rebuild: it is only
# reported, with the pins that name it. A runtime is a multi-GiB download; one goes only when nothing uses it.
RUNTIME_IDLE_DAYS = DEFAULT_AGE_HOURS / 24  # simctl's lastUsedAt: an iOS lane touches its runtime on every run


def _version_key(v: str) -> tuple[int, ...]:
    return tuple(int(x) for x in re.findall(r"[0-9]+", v))


def _iso_age_hours(text: object, now: float) -> float | None:
    if not isinstance(text, str):
        return None
    try:
        import datetime
        at = datetime.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None
    return (now - at) / 3600


def runtime_items(runtimes: dict, devices: dict, now: float | None = None) -> list[Item]:
    """Judge simulator runtimes (`simctl runtime list -j`) against devices (`simctl list devices -j`).
    Reclaimable only when deletable, used by no device, not its platform's newest, unused for
    RUNTIME_IDLE_DAYS, and no simulator is booted. Unknown fields keep it."""
    now = time.time() if now is None else now
    by_runtime = devices.get("devices") if isinstance(devices, dict) else None
    if not isinstance(runtimes, dict) or not isinstance(by_runtime, dict):
        return []
    booted = any(isinstance(d, dict) and d.get("state") == "Booted"
                 for devs in by_runtime.values() if isinstance(devs, list) for d in devs)
    newest: dict[str, str] = {}
    for r in runtimes.values():
        if isinstance(r, dict):
            plat, v = str(r.get("platformIdentifier", "")), str(r.get("version", ""))
            if plat not in newest or _version_key(v) > _version_key(newest[plat]):
                newest[plat] = v
    items = []
    for rid, r in sorted(runtimes.items()):
        if not isinstance(r, dict):
            continue
        reasons = [f"{r.get('version', '?')} ({r.get('build', '?')}) {r.get('state', '?')}"]
        keep = []
        devs = by_runtime.get(r.get("runtimeIdentifier"), [])
        if not r.get("runtimeIdentifier") or devs:
            keep.append(f"{len(devs) if isinstance(devs, list) else '?'} simulator devices use it")
        if newest.get(str(r.get("platformIdentifier", ""))) == str(r.get("version", "")):
            keep.append("its platform's newest")
        if r.get("deletable") is not True:
            keep.append("simctl cannot delete it")
        idle = _iso_age_hours(r.get("lastUsedAt"), now)
        if idle is None:
            keep.append("no last-use time")
        if booted:
            keep.append("a simulator is booted (deleting restarts CoreSimulatorService)")
        size = r.get("sizeBytes")
        verdict = ("kept" if keep else "recent" if idle is not None and idle < RUNTIME_IDLE_DAYS * 24
                   else "reclaimable")
        items.append(Item("simulator-runtimes", str(rid), size if isinstance(size, int) else 0,
                          round(idle or 0.0, 1), verdict, reasons + keep, platform="macos"))
    return items


def simctl_json(*args: str) -> dict | None:
    try:
        r = subprocess.run(["xcrun", "simctl", *args, "-j"], capture_output=True, text=True, timeout=120)
        return json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def simulator_runtimes() -> list[Item]:
    if not DARWIN or not shutil.which("xcrun"):
        return []
    runtimes, devices = simctl_json("runtime", "list"), simctl_json("list", "devices")
    return runtime_items(runtimes, devices) if runtimes is not None and devices is not None else []


# Simulator devices (macOS, pressure passes and idle sweeps). CI jobs create a device per run and delete it in a
# cleanup step, so a cancelled job leaves it; lanes keep named ones (kit-*). On cmux11s-mac-mini on 2026-10-27, 30
# of 32 devices had not booted in over 80 h and held 35 GB: nothing reclaimed them, because the runtime rule only
# deletes runtimes no device uses and the idle sweep had not run since 10-19 (the mini is never idle). A device is
# judged on its own: erasing a shutdown device does not restart CoreSimulatorService (deleting a runtime does), and
# simctl refuses to erase a booted one. Erase, not delete, so a job or lane that boots a device by name or UDID
# still finds it.
SIM_DEVICE_FAMILY = "simulator-device-data"
SIM_DEVICE_IDLE_HOURS = DEFAULT_AGE_HOURS  # since simctl's lastBootedAt
SIM_DEVICE_MIN_BYTES = 512 * 1024 ** 2  # dataPathSize under this: a fresh or erased device, nothing to gain
SIM_DEVICE_BUDGET_S = 300.0  # one pass erases for at most this long; the next pass continues


def sim_device_items(devices: object, cmds: str, opened: frozenset[str], now: float | None = None,
                     leases: str | None = None) -> list[Item]:
    """Judge simulator devices (`simctl list devices -j`) for erasing. Reclaimable only when shutdown, available,
    holding at least SIM_DEVICE_MIN_BYTES of data, last booted SIM_DEVICE_IDLE_HOURS ago, no running command names
    its UDID or its name, no capture lease names its UDID, and no process has a file or its cwd in its directory.
    An unknown field keeps it."""
    now = time.time() if now is None else now
    leases = capture_lease_text() if leases is None else leases
    by_runtime = devices.get("devices") if isinstance(devices, dict) else None
    if not isinstance(by_runtime, dict):
        return []
    items = []
    for runtime, devs in sorted(by_runtime.items()):
        for d in devs if isinstance(devs, list) else []:
            if not isinstance(d, dict) or not isinstance(d.get("udid"), str):
                continue
            udid, size = d["udid"], d.get("dataPathSize")
            sized = isinstance(size, int) and not isinstance(size, bool)
            size = size if sized else 0
            idle = _iso_age_hours(d.get("lastBootedAt"), now)
            reasons = [f"{d.get('name', '?')} ({str(runtime).rsplit('.', 1)[-1]}) {d.get('state', '?')}"]
            keep = []
            if d.get("state") != "Shutdown":
                keep.append(f"it is {d.get('state', 'in an unknown state')}")
            if d.get("isAvailable") is not True:
                keep.append("simctl lists it unavailable")
            if not sized:
                keep.append("its size cannot be read")
            elif size < SIM_DEVICE_MIN_BYTES:
                keep.append("its data is already small")
            if idle is None:
                keep.append("no last-boot time")
            data = d.get("dataPath")
            home = os.path.dirname(data) if isinstance(data, str) and data.endswith("/data") else None
            if home is None:
                keep.append("no data path")
            elif in_cwd(home, opened):
                keep.append("a process has a file open in it")
            name = d.get("name")
            if not isinstance(name, str) or not name:
                keep.append("its name cannot be read")
            if re.search(re.escape(udid), cmds, re.I) or (
                    isinstance(name, str) and name and re.search(
                        r"(?:^|[\s'\"=,])" + re.escape(name) + r"(?=$|[\s'\",])", cmds, re.M)):
                keep.append("a running command names it")  # by UDID, or by name (-destination name=...)
            if leases is None:
                keep.append("the capture leases cannot be read")
            elif udid.lower() in leases.lower():
                keep.append("a capture lease names it")
            verdict = ("kept" if keep else "recent" if idle < SIM_DEVICE_IDLE_HOURS else "reclaimable")
            items.append(Item(SIM_DEVICE_FAMILY, udid, size, round(idle or 0.0, 1), verdict, reasons + keep,
                              platform="macos"))
    return items


def erase_idle_sim_devices(receipt: Path, halt=None, budget_s: float = SIM_DEVICE_BUDGET_S, simctl=None,
                           below_target=None) -> int:
    """Erase each reclaimable device, largest first, while budget_s lasts (no new erase starts after it; one erase
    may then run up to its own 300 s limit), and, when below_target is given, only while it says free space is still
    short. Before each erase the device is judged again: process evidence first (lsof, the slow part), then the
    reservation, a fresh `ps`, then, holding the simulator token (sim_token) so no simulator-class job is admitted,
    the capture leases, a fresh simctl reading and the budget, halt and target once more. What can still slip
    between them and the erase is a job outside the simulator class that picks this device and has not yet named,
    opened or booted it: simctl refuses to erase a Booted or Booting device, and an unbooted device holds only state
    that went untouched for SIM_DEVICE_IDLE_HOURS, which this policy gives up. Returns the bytes simctl reports
    released (0 for a device it cannot read back)."""
    if not DARWIN or not shutil.which("xcrun") or SIM_DEVICE_IDLE_HOURS == float("inf"):
        return 0
    simctl = (lambda: simctl_json("list", "devices")) if simctl is None else simctl
    started = time.monotonic()
    try:
        cmds, opened = _sim_evidence()
    except NoEvidence as e:
        print(f"refusing to erase simulator devices: {e}", file=sys.stderr)
        return 0
    first = sim_device_items(simctl(), cmds, opened)
    released = 0
    for i in sorted((x for x in first if x.verdict == "reclaimable"), key=lambda x: -x.bytes):
        if time.monotonic() - started > budget_s or (halt is not None and halt()):
            break  # a halt is a busy host (a CI job): the next idle sweep or pressure pass goes on
        if below_target is not None and not below_target():
            break
        try:
            cmds, opened = _sim_evidence()
        except NoEvidence as e:
            print(f"refusing to erase simulator devices: {e}", file=sys.stderr)
            break
        if (why := host_reservation()):
            print(f"refusing to erase simulator devices: {why}", file=sys.stderr)
            break
        try:
            cmds += "\n" + subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True,
                                          timeout=30, check=True).stdout
        except (OSError, subprocess.SubprocessError):
            print("refusing to erase simulator devices: ps failed", file=sys.stderr)
            break
        token = sim_token()
        if token is None:
            print("not erasing simulator devices: a simulator job holds the simulator token", file=sys.stderr)
            break
        try:  # held through the last reading and the erase, so no simulator job is admitted in between
            now = {x.path: x for x in sim_device_items(simctl(), cmds, opened)}.get(i.path)
            if time.monotonic() - started > budget_s or (halt is not None and halt()) or (
                    below_target is not None and not below_target()):
                break  # the readings took the rest of the budget, a job started, or the target was reached
            if (why := host_reservation()):
                print(f"refusing to erase simulator devices: {why}", file=sys.stderr)
                break
            size = 0
            if now is None or now.verdict != "reclaimable":
                outcome, reasons = "changed:in-use", (now.reasons if now else ["no longer listed"])
            else:
                reasons = now.reasons
                try:
                    r = subprocess.run(["xcrun", "simctl", "erase", i.path], capture_output=True, text=True,
                                       timeout=300)
                    outcome = "reclaimed" if r.returncode == 0 else f"incomplete:exit {r.returncode}"
                except (OSError, subprocess.SubprocessError) as e:
                    outcome = f"incomplete:{e.__class__.__name__}"
        finally:
            os.close(token)
        if outcome == "reclaimed":
            after = sim_device_size(simctl(), i.path)
            if after is None:
                reasons = reasons + ["its size after the erase could not be read; counted 0"]
            else:
                size = max(0, now.bytes - after)
            released += size
        rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(), "family": SIM_DEVICE_FAMILY,
               "path": i.path, "outcome": outcome, "bytes": size, "idle_hours": i.idle_hours,
               "verdict": "reclaimable" if outcome == "reclaimed" else "blocked", "reasons": reasons,
               "rebuild": "the next boot recreates its data"}
        with contextlib.suppress(OSError):
            receipt.parent.mkdir(parents=True, exist_ok=True)
            with receipt.open("a") as f:
                f.write(json.dumps(rec) + "\n")
        print(f"  {outcome:16s} {gib(size)}  simulator device {i.path} ({reasons[0]})")
    return released


# The runner hook admits a simulator-class job (ios-simulator, screenshots, a guest's *-sim) only while it holds
# capacity/simulator.token exclusive, for the whole job. The eraser takes it the same way (created if missing, as
# the hook's lock_file does) around its last reading and the erase, so no such job starts in between.
SIM_TOKEN = CANONICAL_CAPACITY / "simulator.token"


def sim_token(path: Path | None = None) -> int | None:
    """An fd holding the simulator token exclusive, or None while a job holds it or it cannot be opened."""
    path = SIM_TOKEN if path is None else path
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def sim_device_size(devices: object, udid: str) -> int | None:
    """The dataPathSize simctl lists for a device, or None when it is not listed or the size is not a number."""
    by_runtime = devices.get("devices") if isinstance(devices, dict) else None
    for devs in by_runtime.values() if isinstance(by_runtime, dict) else ():
        for d in devs if isinstance(devs, list) else ():
            if isinstance(d, dict) and d.get("udid") == udid:
                size = d.get("dataPathSize")
                return size if isinstance(size, int) and not isinstance(size, bool) else None
    return None


CAPTURE_LEASE_ROOT = HOME / ".cache/cmux-capture-host"  # cmuxterm-hq build-fleet/capture-host's LEASE_ROOT


def capture_lease_text(root: Path | None = None) -> str | None:
    """The text of every file in each capture lease directory, where a lease records what it holds; "" when there
    is no lease root. None when the root, a lease or any file in one cannot be read, or a file is too big to be a
    lease record: then nothing is erased."""
    root = CAPTURE_LEASE_ROOT if root is None else root
    out = []
    try:
        with os.scandir(root) as it:
            leases = [Path(e.path) for e in it if e.is_dir(follow_symlinks=False)]
        for lease in leases:
            with os.scandir(lease) as it:
                files = [Path(e.path) for e in it if e.is_file(follow_symlinks=False)]
            for f in files:
                if f.stat().st_size > 65536:
                    return None
                out.append(f.read_text())
    except FileNotFoundError:
        if not root.exists():
            return ""
        return None  # a lease or file went away while it was read: read again next pass
    except (OSError, UnicodeDecodeError):
        return None
    return "\n".join(out)


def _sim_evidence() -> tuple[str, frozenset[str]]:
    opened, cmds = process_evidence()
    return cmds, open_index(opened)


XCODE_PIN_RE = r"\s--toolchain-xcode[\s=]+(\S+)"


def xcode_pins(home: Path = HOME) -> dict[str, str]:
    """Xcode app paths something names -> what: xcode-select, and a runner hook's --toolchain-xcode."""
    pins: dict[str, str] = {}
    for hook in home.glob(RUNNER_HOOKS):
        try:
            for app in re.findall(XCODE_PIN_RE, hook.read_text()):
                pins[os.path.realpath(app.strip("'\""))] = "a runner hook's --toolchain-xcode"
        except (OSError, UnicodeDecodeError):
            continue
    try:
        sel = subprocess.run(["xcode-select", "-p"], capture_output=True, text=True, timeout=10).stdout.strip()
        if ".app/" in sel:
            pins.setdefault(os.path.realpath(sel.split(".app/")[0] + ".app"), "xcode-select")
    except (OSError, subprocess.SubprocessError):
        pass
    return pins


def xcode_items(apps: Path = Path("/Applications"), pins: dict[str, str] | None = None) -> list[Item]:
    """Every Xcode*.app, report-only, with the pin that names it or why nothing here removes it."""
    pins = xcode_pins() if pins is None else pins
    items = []
    for app in sorted(apps.glob("Xcode*.app")):
        if app.is_symlink():
            continue
        try:
            import plistlib
            version = plistlib.loads((app / "Contents/Info.plist").read_bytes()).get("CFBundleShortVersionString", "?")
            owner = pwd.getpwuid(app.stat().st_uid).pw_name
        except Exception:  # noqa: BLE001  (a report line, never a decision)
            version, owner = "?", "?"
        pin = pins.get(os.path.realpath(app))
        why = [f"Xcode {version}, owned by {owner}",
               f"pinned by {pin}" if pin else "no pin names it: remove it by hand if no workflow uses it"]
        # Xcode app sizing is tooling/accounting only; a slow walk must not be reported as an
        # eviction failure because this path can never be deleted by glaeda-disk.
        size = du_bytes(app, record_timeout=False)
        if size is None:
            size = 0
            why.append("size walk timed out; size is unsized")
        items.append(Item("xcode-apps", str(app), size, 0.0, "report-only", why, platform="macos"))
    return items


def apply_runtimes(items: list[Item], receipt: Path, halt=None) -> int:
    """Delete reclaimable runtimes after judging them again from a fresh simctl reading."""
    released = 0
    for i in items:
        if i.verdict != "reclaimable":
            continue
        why = halt() if halt is not None else ""
        fresh = {x.path: x for x in simulator_runtimes()}.get(i.path)
        if why:
            outcome = f"stopped:{why[:60]}"
        elif fresh is None or fresh.verdict != "reclaimable":
            outcome = "changed:in-use"
        else:
            try:
                r = subprocess.run(["xcrun", "simctl", "runtime", "delete", i.path], capture_output=True,
                                   text=True, timeout=900)
                outcome = "reclaimed" if r.returncode == 0 else f"incomplete:exit {r.returncode}"
            except (OSError, subprocess.SubprocessError) as e:
                outcome = f"incomplete:{e.__class__.__name__}"
            if outcome == "reclaimed":
                released += i.bytes
        rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(), "outcome": outcome,
               "rebuild": "xcodebuild -downloadPlatform or Xcode's Components settings", **asdict(i),
               "sweep": "idle"}
        receipt.parent.mkdir(parents=True, exist_ok=True)
        with receipt.open("a") as f:
            f.write(json.dumps(rec) + "\n")
        print(f"  {outcome:16s} {gib(i.bytes)}  simulator runtime {i.path}")
        if why:
            break
    return released


def seed_verdict(path: Path) -> str:
    """Why a seed stays whatever its age, or "": one of its root's newest SEED_KEEP seeds of the prefix the
    root's last job recorded (seed-source.json), or of any prefix when it recorded none. Dot entries are a
    download or delete in progress, never a seed."""
    try:
        prefix = json.loads((path.parent.parent / SEED_SOURCE).read_text()).get("prefix") or ""
    except (OSError, ValueError, AttributeError):
        prefix = ""
    if not isinstance(prefix, str):
        prefix = ""
    if path.name.startswith(".") or not path.name.startswith(prefix):
        return ""
    current = []
    for c in _entries(path.parent):
        if c.name.startswith(prefix) and not c.name.startswith(".") and c.is_dir(follow_symlinks=False):
            try:
                current.append((c.stat(follow_symlinks=False).st_mtime, c.name))
            except OSError:
                continue
    keep = 1 if ACTIVITY_MODE == "pressure" else SEED_KEEP
    newest = {name for _, name in sorted(current, reverse=True)[:keep]}
    return f"one of its root's newest {keep} current seeds" if path.name in newest else ""


WORKTREE_DIRS = ("worktrees", "cmux-worktrees", "glaeda-worktrees")
CHECKOUT_BUILD_IDLE_HOURS = DEFAULT_AGE_HOURS
# The runner-account cache profile (runner_cache_families): 168 h before the 12 h default, and 168 h again on a
# reserved host, where keep_legacy_ages puts it back.
RUNNER_CACHE_IDLE_HOURS = DEFAULT_AGE_HOURS


def _checkout_git(checkout: Path, *args: str) -> list[str]:
    """NUL-separated output of a read-only git command in checkout, or [] on any failure. The caller's
    GIT_* variables would override -C (a hook's GIT_DIR names one repository for every checkout)."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0")
    try:
        r = subprocess.run(["git", "-C", os.fspath(checkout), *args], capture_output=True, timeout=60, env=env)
    except (OSError, subprocess.SubprocessError):
        return []
    return [os.fsdecode(f) for f in r.stdout.split(b"\0") if f] if r.returncode == 0 else []


def project_checkouts(projects: Path) -> list[Path]:
    """Every checkout under projects, by real path: each repository directly below it and its linked
    worktrees there. Worktrees outside projects (a Claude session's scratchpad) belong to their own family."""
    real = os.path.realpath(projects)
    repos = [c for c in _children(projects) if (c / ".git").exists() and not c.is_symlink()]
    found = {os.path.realpath(c) for c in repos}
    with ThreadPoolExecutor(max_workers=8) as pool:
        for fields in pool.map(lambda c: _checkout_git(c, "worktree", "list", "--porcelain", "-z"), repos):
            for f in fields:
                if f.startswith("worktree "):
                    w = os.path.realpath(f[len("worktree "):])
                    if w.startswith(real + "/") and os.path.isdir(w):
                        found.add(w)
    return [Path(w) for w in sorted(found)]


def contained_directory(path: Path, root: Path) -> bool:
    """A directory reached without symlinks and wholly inside its declared root."""
    try:
        if root.is_symlink() or not path.is_relative_to(root):
            return False
        for ancestor in (path, *path.parents):
            if ancestor.is_symlink():
                return False
            if ancestor == root:
                break
        return path.is_dir() and path.resolve().is_relative_to(root.resolve())
    except OSError:
        return False


def _checkout_build_dirs(checkout: Path) -> list[Path]:
    found = []
    tracked = _checkout_git(checkout, "ls-files", "-z", "--", "Package.swift", ":(glob)**/Package.swift")
    for rel in sorted({os.path.dirname(r) for r in tracked}):
        build = checkout / rel / ".build"
        if not build.is_symlink() and _head(os.fspath(build / "CACHEDIR.TAG"), 64).startswith(CACHEDIR_TAG):
            found.append(build)
    found += [g for g in _children(checkout / ".glaeda/apple-build/cache") if g.is_dir() and not g.is_symlink()]
    # Zig and SwiftPM outputs are per-checkout working state. Ghostty's Zig cache is
    # intentionally found by its stable location so a source tree is never walked blindly.
    for candidate in (checkout / ".zig-cache", checkout / "ghostty/.zig-cache"):
        if candidate.is_dir() and not candidate.is_symlink():
            found.append(candidate)
    for package_root in (checkout / "Packages", checkout / "vendor"):
        if package_root.is_dir() and not package_root.is_symlink():
            for pattern in ("*/.build", "*/*/.build"):
                for candidate in package_root.glob(pattern):
                    if candidate.is_dir() and not candidate.is_symlink():
                        found.append(candidate)
    return sorted({p.resolve() for p in found if contained_directory(p, checkout)})


def checkout_builds(projects: Path) -> list[Path]:
    """The build output inside the checkouts under projects that its tool recreates: SwiftPM's .build
    (tagged with a CACHEDIR.TAG) beside each tracked Package.swift, and each glaeda-apple cache generation
    (.glaeda/apple-build/cache/<key>; the receipts beside it stay). The index names the packages, so
    nothing walks the checkouts; the git calls run in parallel (hundreds of checkouts on a laptop)."""
    with ThreadPoolExecutor(max_workers=8) as pool:
        return [b for bs in pool.map(_checkout_build_dirs, project_checkouts(projects)) for b in bs]


def checkout_build_family(projects: Path, role: str = "fleet-mini") -> Family:
    return Family("checkout-build", projects, True,
                  "swift build or glaeda-apple warm rebuilds it; also counted in its checkout",
                  checkout_builds=True, build_output=True,
                  min_idle_hours=CHECKOUT_BUILD_IDLE_HOURS,
                  owner="SwiftPM and glaeda-apple, per checkout", rebuild_minutes=15,
                  platform="shared")


# A GitHub runner's checkout (~/actions-runner*/_work/<repo>/<repo>) keeps build output between jobs: SwiftPM's
# Packages/<platform>/<package>/.build (~9 GiB per runner) and cmux-tui's cargo target (~20 GiB), plus git's temp
# packs from fetches a cancelled job interrupted (up to 5 GiB). With 10-12 runners per mini that was 134-338 GiB
# no family counted ("accounting gap") while glaeda-disk found 0.0G reclaimable under the 30 GiB runner floor
# (cmux CI minis, 2026-10-20). Build output goes only under pressure and only while that runner has no
# Runner.Worker (no job), least recently modified first; the next job on that runner rebuilds it. A temp pack an
# hour old is garbage whatever the runner does: git writes it continuously and renames it when the fetch ends,
# and a fetch still holding one open keeps it (open by a process).
RUNNER_BUILD_FAMILY = "runner-checkout-build"
RUNNER_GIT_GARBAGE_FAMILY = "runner-git-garbage"
RUNNER_CHECKOUT_FAMILIES = frozenset({RUNNER_BUILD_FAMILY, RUNNER_GIT_GARBAGE_FAMILY})
RUNNER_BUILD_IDLE_HOURS = 1.0
GIT_GARBAGE_IDLE_HOURS = 1.0
# odb_mkstemp's names (tmp_pack_, tmp_idx_, tmp_rev_, tmp_obj_, tmp_bitmap_, tmp_mtimes_) and repack's .tmp-<pid>-pack-*
GIT_GARBAGE_NAME = re.compile(r"tmp_[a-z]+_[A-Za-z0-9]{6,}|\.tmp-[0-9]+-pack-.+")
CARGO_TAG = re.compile(rb"^# This file is a cache directory tag created by cargo\.?\s*$", re.M)
# Workflows keep DerivedData, SourcePackages and compilation caches in $RUNNER_WORKSPACE/.glaeda-state
# (hq NEW-REPO-CI.md); only the DerivedData is build output (ios-e2e-mac-derived-data: 9.5 GiB on one runner).
RUNNER_STATE_DERIVED_DATA = re.compile(r"(?i)derived-?data")


def enrolled_runners(home: Path | None = None) -> list[Path]:
    """The runner directories glaeda-cmux-runner installed: a .runner config and the glaeda hooks beside it."""
    home = HOME if home is None else home
    try:
        found = sorted(home.glob("actions-runner*"))
    except OSError:
        return []
    return [r for r in found if not r.is_symlink() and (r / ".runner").is_file() and (r / "glaeda-hooks").is_dir()]


def runner_checkouts(work: Path) -> list[Path]:
    """Each repository checkout in a runner's _work (_work/<repo>/<repo>); the runner's own _temp, _actions,
    _tool and friends start with an underscore and are never checkouts."""
    out = []
    for repo in _children(work):
        if repo.name.startswith("_") or repo.is_symlink() or not repo.is_dir():
            continue
        for checkout in _children(repo):
            git = checkout / ".git"
            if (not checkout.name.startswith("_") and not checkout.is_symlink() and not git.is_symlink()
                    and git.is_dir() and contained_directory(checkout, work)):
                out.append(checkout)
    return sorted(out)


def runner_checkout_builds(work: Path) -> list[Path]:
    """SwiftPM .build directories below Packages/ and cargo target directories (tagged by cargo) at the top
    of each checkout or one level down (cmux-tui/target), and DerivedData directories in each runner
    workspace's .glaeda-state (never its SourcePackages or compilation cache). Fixed places, so no source
    tree is walked."""
    found: list[Path] = []
    for workspace in _children(work):
        state = workspace / ".glaeda-state"
        if (workspace.name.startswith("_") or workspace.is_symlink() or not workspace.is_dir()
                or state.is_symlink() or not state.is_dir()):
            continue
        found += [d for d in _children(state)
                  if RUNNER_STATE_DERIVED_DATA.search(d.name) and d.is_dir() and not d.is_symlink()]
    for checkout in runner_checkouts(work):
        packages = checkout / "Packages"
        if packages.is_dir() and not packages.is_symlink():
            for pattern in ("*/.build", "*/*/.build"):
                found += [b for b in packages.glob(pattern) if b.is_dir() and not b.is_symlink()]
        for parent in [checkout, *(c for c in _children(checkout) if not c.name.startswith(".") and c.is_dir())]:
            target = parent / "target"
            if target.is_dir() and not target.is_symlink() and CARGO_TAG.search(_head(os.fspath(target / "CACHEDIR.TAG"), 256)):
                found.append(target)
    return sorted({p for p in found if contained_directory(p, work)})


def runner_git_garbage(work: Path) -> list[Path]:
    """Temp files git leaves in a checkout's object store when a fetch or repack dies: objects/pack/tmp_pack_*
    and friends, and tmp_obj_* loose-object temp files in objects/ or one fan-out directory down."""
    found: list[Path] = []
    for checkout in runner_checkouts(work):
        objects = checkout / ".git/objects"
        if objects.is_symlink() or not objects.is_dir():
            continue
        dirs = [objects, objects / "pack", *(d for d in _children(objects) if len(d.name) == 2)]
        for d in dirs:
            if d.is_symlink() or not contained_directory(d, work):  # a git object store outside this runner's _work
                continue
            for e in _entries(d):
                if GIT_GARBAGE_NAME.fullmatch(e.name) and e.is_file(follow_symlinks=False):
                    found.append(Path(e.path))
    return sorted(found)


def runner_job_live(runner: Path, cmds: str) -> str:
    """Why a runner's checkout is in use, or "": its Runner.Worker runs only while it has a job."""
    # either spelling of the runner's path (a symlinked home, /private) counts, so a mismatch never reads as idle
    names = {os.fspath(runner), os.fspath(runner.resolve())}
    pattern = "(?:" + "|".join(map(re.escape, sorted(names))) + r")/bin(?:\.[0-9.]+)?/Runner\.Worker(?:\s|$)"
    return f"{runner.name} is running a job (Runner.Worker)" if re.search(pattern, cmds, re.M) else ""


# One `ps -o lstart=,command=` line: the process's start ("Tue Oct 27 03:10:26 2026", LC_ALL=C), then its command.
PS_LSTART_RE = re.compile(r"\s*([A-Z][a-z]{2} [A-Z][a-z]{2} +\d{1,2} \d{2}:\d{2}:\d{2} \d{4})\s+(.*)$")


def runner_job_started(runner: Path) -> float | None:
    """When the runner's running job began: its Runner.Worker's start (ps lstart), the earliest when ps shows more
    than one. None when ps fails, shows none, or a start cannot be read: callers then hold the job to be using
    everything the runner owns."""
    try:
        ps = subprocess.run(["ps", "-axww", "-o", "lstart=,command="], capture_output=True, text=True, timeout=60,
                            env={**os.environ, "LC_ALL": "C"})
    except (OSError, subprocess.TimeoutExpired):
        return None
    if ps.returncode != 0:
        return None
    starts = []
    for line in ps.stdout.splitlines():
        m = PS_LSTART_RE.match(line)
        if m is None or not runner_job_live(runner, m.group(2)):
            continue
        try:
            starts.append(time.mktime(time.strptime(m.group(1), "%a %b %d %H:%M:%S %Y")))
        except ValueError:
            return None
    return min(starts) if starts else None


def runner_checkout_families(home: Path | None = None) -> list[Family]:
    fams = []
    for runner in enrolled_runners(home):
        work = runner / "_work"
        if not work.is_dir() or work.is_symlink():
            continue
        fams.append(Family(RUNNER_BUILD_FAMILY, work, True,
                           "the runner's next job rebuilds it (SwiftPM .build, cargo target)",
                           checkout_builds=True, build_output=True, pressure_only=True,
                           max_idle_hours=RUNNER_BUILD_IDLE_HOURS,
                           owner="GitHub Actions jobs in this runner's checkout", rebuild_minutes=10,
                           platform="macos"))
        fams.append(Family(RUNNER_GIT_GARBAGE_FAMILY, work, True,
                           "garbage: an interrupted fetch's temp pack, never read again",
                           checkout_builds=True, build_output=True, min_bytes=1024**2,
                           min_idle_hours=GIT_GARBAGE_IDLE_HOURS, max_idle_hours=GIT_GARBAGE_IDLE_HOURS,
                           owner="git fetch in this runner's checkout", rebuild_minutes=0.1,
                           platform="macos"))
    return fams


# The last resort for the runner gate's disk hold. With 10-12 runners on a mini, each runner's own checkout
# (_work/<repo>/<repo>: a 7.5 GiB .git plus sources and what build output survives) adds up to 70-170 GiB,
# and build-output eviction alone left cmuxs-mac-mini-3, -6 and cmux11s under the 32 GiB floor with every
# listener held (2026-10-21; removing idle runners' checkouts by hand freed 116 GiB on three minis and the
# gate reopened). So a pressure run that is still under the gate's floor after every other family removes
# whole checkouts of runners with no job, least recently used first, until free space reaches the floor
# plus target_margin_gib. The next job on that runner clones again (actions/checkout). Never _work/_tool,
# _actions, _temp or the workspace's .glaeda-state.
# The quiet window is runner-checkout-repack's 10 minutes, not an hour: the gate holds only the jobs that need
# the floor, so light jobs keep every runner busy at least hourly and an hour-quiet checkout never appears
# (cmuxs-mac-mini-6, 2026-10-21: 0.3 GiB free, three runners with no job holding 6.5 GiB .git each, last
# used 23-32 minutes before, and the pass freed nothing). No Runner.Worker is what keeps a job's checkout.
RUNNER_IDLE_CHECKOUT_FAMILY = "runner-idle-checkout"
RUNNER_IDLE_CHECKOUT_HOURS = 10 / 60
# Old runner work dirs go by age too, above the floor and in the idle sweep: a checkout no job used for
# DEFAULT_AGE_HOURS is cloned again by its runner's next job, like one the floor took.
RUNNER_STALE_CHECKOUT_HOURS = DEFAULT_AGE_HOURS
# A runner checkout that one full-history job fetched into stays full-history: every later job only adds to it, and
# runner-checkout-repack's `repack -k` keeps what no ref names. On 2026-10-27 one runner per mini (12 of 109
# checkouts) held 6.7-7.1 GiB of packs and 22k refs/remotes/origin/* while its siblings held about 0.55 GiB: 118.5 of
# the fleet's 198 GB of runner .git. Such a checkout goes once its runner is quiet, at any free space, and the next
# job starts from a shallow clone or git seed again. Bloated is relative to the same repository's other checkouts on
# this mini, so a repository that is big everywhere never counts.
RUNNER_CHECKOUT_BLOAT_RATIO = 4.0  # times the median pack bytes of the same repository's other checkouts here
RUNNER_CHECKOUT_BLOAT_MIN_GIB = 2.0


def runner_checkout_last_use(runner: Path, checkout: Path) -> float:
    """When the runner last used a checkout: its git bookkeeping (a job's checkout step rewrites the index,
    HEAD and FETCH_HEAD) or the runner's Worker logs, which a job writes from start to end."""
    times = [0.0]
    for p in (checkout, checkout / ".git", *(checkout / ".git" / n for n in ("index", "HEAD", "FETCH_HEAD", "logs/HEAD"))):
        with contextlib.suppress(OSError):
            times.append(p.lstat().st_mtime)
    with contextlib.suppress(OSError), os.scandir(runner / "_diag") as logs:
        for e in logs:
            if e.name.startswith("Worker_"):
                with contextlib.suppress(OSError):  # a log rotated away mid-scan drops only itself
                    times.append(e.stat(follow_symlinks=False).st_mtime)
    return max(times)


GIT_LOCK_NAMES = ("index.lock", "HEAD.lock", "shallow.lock", "packed-refs.lock", "config.lock", "ORIG_HEAD.lock",
                  "FETCH_HEAD.lock", "MERGE_HEAD", "REBASE_HEAD", "rebase-merge", "rebase-apply", "CHERRY_PICK_HEAD",
                  "REVERT_HEAD", "BISECT_LOG", "sequencer")  # the home-clone set (HOME_CLONE_GIT_LOCKS) and more


def runner_checkout_git_veto(checkout: Path) -> str:
    """Why a stale runner checkout must stay for git's sake, or "": git holds a lock or has an operation under way in
    it or any of its worktrees (a lock file, MERGE_HEAD, a rebase or sequencer dir), or a commit there (HEAD, every
    worktree's HEAD, a local branch or tag, the stash) is on no remote-tracking ref. Any doubt (git fails or times
    out) keeps it.

    What goes with it: untracked and ignored files (a job's build output), tracked edits and commits only a reflog
    names. This is actions/checkout's own directory: the next job there runs `git clean -ffdx` and `git reset --hard`
    and moves HEAD, so a runner checkout never carries those from one job to the next; deleting it loses only what
    the runner would throw away itself."""
    dotgit = checkout / ".git"
    if dotgit.is_symlink() or not dotgit.is_dir():
        return "not a plain checkout (.git is not a directory)"
    def unreadable(error: OSError) -> None:
        raise error  # a directory git keeps state in that cannot be read is doubt, and doubt keeps it

    try:
        for root, dirs, files in os.walk(dotgit, onerror=unreadable):
            rel = Path(root).relative_to(dotgit).parts
            # only a git dir's own object store, LFS store and reflogs are skipped: a submodule store with one of
            # those names is still walked for its locks
            if not rel or ("HEAD" in files and "objects" in dirs):
                dirs[:] = [d for d in dirs if d not in ("objects", "lfs", "logs")]
            if any(n in GIT_LOCK_NAMES for n in (*files, *dirs)) or any(
                    f.endswith(".lock") and "refs" in rel for f in files):
                return "git holds a lock in it"
            if len(rel) >= 2 and rel[-2] == "worktrees" and "locked" in files:
                return "a linked worktree of it is locked"
            # a linked worktree's private refs (refs/worktree, refs/bisect) live in its own git dir, where
            # for-each-ref in the main one never lists them
            if len(rel) >= 3 and rel[-3] == "worktrees" and rel[-1] == "refs" and (files or dirs):
                return "a linked worktree of it has refs of its own"
    except OSError:
        return "git could not say whether it holds a lock"
    # the caller's GIT_* would override -C (a hook's GIT_DIR names one repository for every checkout)
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0")

    def git(*args: str, timeout: int = 60) -> str:
        return subprocess.run(["git", "-C", os.fspath(checkout), *args], capture_output=True, text=True,
                              timeout=timeout, env=env, check=True).stdout
    try:
        heads = [ln.split(" ", 1)[1] for ln in git("worktree", "list", "--porcelain").splitlines()
                 if ln.startswith("HEAD ")]
        local = unpushed_commit(git, heads)
    except (OSError, subprocess.SubprocessError, IndexError, ValueError):  # ValueError: a ref name not UTF-8
        return "git could not say whether a commit is only here"
    if local:
        return "a commit here is on no remote-tracking ref"
    return submodule_git_veto(dotgit, env)


def unpushed_commit(git, heads: list[str]) -> bool:
    """Whether HEAD, `heads`, or any ref but a remote-tracking one (a branch, the stash, bisect, notes, refs/worktree,
    a tag) names a commit on no remote-tracking ref. A tag
    counts only when origin does not have it at the same object: a full-history fetch brings every tag of origin,
    including tags of commits on no branch (cmux's cmux-rbh-src-*, 270 of them on 2026-10-27), and those are not
    only here. Asking origin is one `git ls-remote --tags` (0.3 s), made only when a tag names such a commit; with
    the checkout's expired job token header cleared. Raises when git cannot say, which keeps the checkout."""
    refs = [ln.split(" ", 1) for ln in git("for-each-ref", "--format=%(objectname) %(refname)").splitlines()
            if " " in ln]
    # every ref but remote-tracking ones and tags: branches, the stash, bisect, notes, refs/worktree, anything
    tips = [sha for sha, ref in refs if not ref.startswith(("refs/remotes/", "refs/tags/"))]
    if git("rev-list", "--max-count=1", "HEAD", *heads, *tips, "--not", "--remotes", timeout=120).strip():
        return True
    tags = {ref: sha for sha, ref in refs if ref.startswith("refs/tags/")}
    if not tags or not git("rev-list", "--max-count=1", *tags.values(), "--not", "--remotes", timeout=120).strip():
        return False
    origin = {}
    for ln in git("-c", "http.https://github.com/.extraheader=", "-c", "credential.helper=", "ls-remote",
                  "--tags", "origin", timeout=60).splitlines():
        sha, _, ref = ln.partition("\t")
        if ref and not ref.endswith("^{}"):
            origin[ref] = sha
    only_here = [sha for ref, sha in tags.items() if origin.get(ref) != sha]
    return bool(only_here) and bool(git("rev-list", "--max-count=1", *only_here, "--not", "--remotes",
                                        timeout=120).strip())


SUBMODULE_DEPTH = 4  # submodules of submodules this deep are followed; deeper is doubt


def submodule_git_veto(dotgit: Path, env: dict[str, str]) -> str:
    """runner_checkout_git_veto's commit rule for every other git dir inside .git (submodule stores under modules/,
    nested ones, those under a linked worktree's worktrees/<name>/modules): a HEAD, a linked worktree's HEAD or any
    ref but a remote-tracking one on none of its remote-tracking refs keeps the checkout. Their locks and operations
    are in runner_checkout_git_veto's walk of .git. A submodule (a gitlink in the index, followed through absorbed
    submodules) whose repository sits in the work tree as its own .git directory keeps the checkout outright, and so
    does doubt: a symlink inside .git, a git dir that cannot be read, or an index git cannot list."""
    def unreadable(error: OSError) -> None:
        raise error

    gitdirs: list[Path] = []
    try:
        for root, dirs, files in os.walk(dotgit, onerror=unreadable):
            here = Path(root)
            is_gitdir = "HEAD" in files and "objects" in dirs
            if here != dotgit and is_gitdir:
                gitdirs.append(here)
            if any((here / d).is_symlink() for d in dirs) or (here != dotgit and any(
                    (here / f).is_symlink() for f in files if not is_gitdir)):
                return "a symlink inside .git: git could not say what it holds"
            # a git dir's own object store, reflogs and LFS store hold no git dirs; a directory with those names
            # anywhere else (a submodule named refs) is walked
            dirs[:] = [d for d in dirs if not (is_gitdir and d in ("objects", "lfs", "logs", "refs"))]
    except OSError:
        return "git could not say whether a submodule commit is only here"
    try:
        surveyed = frozenset(g.resolve() for g in gitdirs)
    except (OSError, RuntimeError):
        return "git could not say whether a submodule commit is only here"
    why = embedded_submodule_veto(dotgit.parent, env, SUBMODULE_DEPTH, surveyed)
    if why:
        return why
    for gitdir in gitdirs:
        name = os.fspath(gitdir.relative_to(dotgit))

        def git(*args: str, timeout: int = 120, gitdir: Path = gitdir) -> str:
            return subprocess.run(["git", "--git-dir", os.fspath(gitdir), *args], capture_output=True, text=True,
                                  timeout=timeout, env=env, check=True).stdout
        try:
            heads = [ln.split(" ", 1)[1] for ln in git("worktree", "list", "--porcelain").splitlines()
                     if ln.startswith("HEAD ")]
            local = unpushed_commit(git, heads)
        except (OSError, subprocess.SubprocessError, ValueError, IndexError):
            return f"git could not say whether a commit in {name} is only here"
        if local:
            return f"a commit in {name} is on no remote-tracking ref"
    return ""


def embedded_submodule_veto(tree: Path, env: dict[str, str], depth: int, surveyed: frozenset[Path]) -> str:
    """Why a work tree's submodules keep the checkout, or "": a gitlink (mode 160000 in the index) whose .git is a
    directory or a symlink, not a gitfile into the superproject's .git/modules, or such a one in an absorbed
    submodule's own work tree, or one whose gitfile names a repository other than the git dirs submodule_git_veto
    surveyed (resolved). Any doubt (git cannot list an index, read a gitfile, the nesting is deeper than depth)
    keeps it."""
    try:
        listed = subprocess.run(["git", "-C", os.fspath(tree), "ls-files", "--stage", "-z"], capture_output=True,
                                timeout=120, env=env, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return f"git could not list the index of {tree.name}"
    for entry in listed.split(b"\0"):
        if not entry.startswith(b"160000 "):
            continue
        path = os.fsdecode(entry.split(b"\t", 1)[-1])
        sub = tree / path
        dotgit = sub / ".git"
        if dotgit.is_symlink() or dotgit.is_dir():
            return f"submodule {path} keeps its own repository in the work tree"
        if not dotgit.exists():
            continue  # not initialized: no repository of its own here
        try:
            target = dotgit.read_text().strip()
            store = (sub / target.removeprefix("gitdir:").strip()).resolve()
        except (OSError, ValueError, RuntimeError):
            return f"git could not say where submodule {path} keeps its repository"
        if not target.startswith("gitdir:") or store not in surveyed:
            # submodule_git_veto checks only the git dirs its walk of .git found; any other store is not checked
            return f"submodule {path} keeps its repository outside .git"
        if depth <= 0:
            return f"submodule {path} is nested deeper than {SUBMODULE_DEPTH}"
        if why := embedded_submodule_veto(sub, env, depth - 1, surveyed):
            return why
    return ""


def idle_runner_checkout_veto(runner: Path, checkout: Path, opened: frozenset[str], cmds: str) -> str:
    """Why an idle runner's checkout must stay, or "" when it may go."""
    path = os.fspath(checkout)
    if (checkout.is_symlink() or checkout.name != checkout.parent.name
            or not contained_directory(checkout, runner / "_work")):
        return "not actions/checkout's _work/<repo>/<repo> inside the runner's _work"
    if why := runner_job_live(runner, cmds):
        return why
    resolved = os.fspath(checkout.resolve())
    if in_cwd(path, opened) or in_cwd(resolved, opened):
        return "open or a working directory of a process"
    if named_by(path, cmds) or named_by(resolved, cmds):
        return "named by a running command"
    if (time.time() - runner_checkout_last_use(runner, checkout)) / 3600 < RUNNER_IDLE_CHECKOUT_HOURS:
        return f"used within {RUNNER_IDLE_CHECKOUT_HOURS * 60:g} minutes"
    return ""


def git_pack_bytes(gitdir: Path) -> int | None:
    """Bytes of the .pack files in a git dir's objects/pack, from one directory listing (no git, no walk); None
    when the directory or a pack in it cannot be read."""
    total = 0
    try:
        with os.scandir(gitdir / "objects/pack") as it:
            for e in it:
                if e.name.endswith(".pack") and e.is_file(follow_symlinks=False):
                    total += e.stat(follow_symlinks=False).st_size
    except OSError:
        return None
    return total


def checkout_origin(checkout: Path) -> str | None:
    """The repository a checkout is of: its remote.origin.url as git reads it (includes too), normalized so https
    and ssh spellings match (the host lowercased, the path as is). None when git cannot say; such a checkout is
    never anyone's sibling."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env.update(GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL="/dev/null")
    try:
        out = subprocess.run(["git", "config", "--file", os.fspath(checkout / ".git/config"), "--includes", "--get",
                              "remote.origin.url"], capture_output=True, timeout=30, check=True, env=env).stdout
        url = os.fsdecode(out).strip()
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    url = re.sub(r"^(?:https?://|ssh://|git://)?(?:[^@/]+@)?", "", url.removesuffix("/").removesuffix(".git"))
    host, sep, path = url.replace(":", "/", 1).partition("/")
    return f"{host.lower()}/{path}" if host and sep and path else None


def bloated_runner_checkouts(checkouts: list[Path]) -> dict[str, int]:
    """The checkouts whose packs are over RUNNER_CHECKOUT_BLOAT_RATIO times the median of the same repository's
    other checkouts (by origin URL) and over RUNNER_CHECKOUT_BLOAT_MIN_GIB: path -> pack bytes. A checkout with no
    sibling of its repository has nothing to compare with and never counts, and no checkout of a repository counts
    when any of its checkouts' packs cannot be read."""
    if RUNNER_CHECKOUT_BLOAT_RATIO == float("inf"):
        return {}
    sizes = {os.fspath(c): (checkout_origin(c), git_pack_bytes(c / ".git")) for c in checkouts}
    unknown = {r for r, b in sizes.values() if b is None}  # a size that cannot be read could skew the median
    out = {}
    for path, (repo, size) in sizes.items():
        if repo is None or repo in unknown:
            continue
        others = sorted(b for p, (r, b) in sizes.items() if r == repo and p != path)
        if not others or size <= RUNNER_CHECKOUT_BLOAT_MIN_GIB * GIB:
            continue
        median = (others[(len(others) - 1) // 2] + others[len(others) // 2]) / 2
        if size > RUNNER_CHECKOUT_BLOAT_RATIO * median:
            out[path] = size
    return out


def evict_idle_runner_checkouts(receipt: Path, floor_gib: float, home: Path | None = None) -> int:
    """Remove idle runners' whole checkouts, least recently used first, each after fresh process evidence: every
    one unused for RUNNER_STALE_CHECKOUT_HOURS or bloated (bloated_runner_checkouts) and quiet for
    RUNNER_IDLE_CHECKOUT_HOURS, and under the runner gate's disk floor also other quiet ones until free space is
    back at the floor plus target_margin_gib."""
    home = HOME if home is None else home
    try:
        free, total = free_bytes(home)
    except OSError:
        return 0
    # above the gate's resume mark (or with no floor) only stale checkouts go
    under = floor_gib > 0 and free < (floor_gib + GATE_DISK_RESUME_GIB) * GIB
    target = min(int((floor_gib + POLICY["target_margin_gib"]) * GIB), total // 2)  # as filesystems() sets it
    now = time.time()
    every = []
    for runner in enrolled_runners(home):
        work = runner / "_work"
        if work.is_symlink() or not work.is_dir():
            continue
        # only actions/checkout's default _work/<repo>/<repo>; a dedicated runner's checkout kept by role (role_keep)
        every += [(runner, c) for c in runner_checkouts(work) if c.name == c.parent.name and not toolchain_held(c)]
    bloated = bloated_runner_checkouts([c for _, c in every])
    found = []
    for runner, checkout in every:
        used = runner_checkout_last_use(runner, checkout)
        idle = (now - used) / 3600
        if idle >= RUNNER_IDLE_CHECKOUT_HOURS and (under or idle >= RUNNER_STALE_CHECKOUT_HOURS
                                                   or os.fspath(checkout) in bloated):
            found.append((used, runner, checkout))
    released = 0
    for used, runner, checkout in sorted(found, key=lambda t: t[0]):
        stale = (now - used) / 3600 >= RUNNER_STALE_CHECKOUT_HOURS
        bloat = bloated.get(os.fspath(checkout), 0)
        try:
            free_now = free_bytes(home)[0]
            if not stale and not bloat and free_now >= target:
                continue  # under the floor's last resort only until the target; stale and bloated ones still go
            opened, cmds = process_evidence()  # a job may have started since the last deletion
        except OSError:
            break
        except NoEvidence as e:
            print(f"refusing to delete idle runner checkouts: {e}", file=sys.stderr)
            break
        why = idle_runner_checkout_veto(runner, checkout, open_index(opened), cmds)
        # Only the floor's last resort (under the floor, short of the target) takes a checkout git could lose
        # something of; a stale or bloated one anywhere else goes only when git loses nothing.
        if not why and not (under and free_now < target):
            why = runner_checkout_git_veto(checkout)
        if not why:  # the git veto can take a minute (it may ask origin for its tags): judge the runner again now
            try:
                opened, cmds = process_evidence()
            except NoEvidence as e:
                print(f"refusing to delete idle runner checkouts: {e}", file=sys.stderr)
                break
            why = idle_runner_checkout_veto(runner, checkout, open_index(opened), cmds)
        size = 0
        if why:
            outcome = ("changed:modified" if why.startswith("used within")
                       else "blocked:git" if why.startswith(("git", "a commit", "not a plain")) else "changed:in-use")
        else:
            try:
                before = free_bytes(home)[0]
                remove(checkout)
                outcome = "reclaimed"
                size = max(0, free_bytes(home)[0] - before)  # what the free space shows, without a du walk
                released += size
            except OSError as e:
                outcome = f"incomplete:{e.__class__.__name__}"
        rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(), "outcome": outcome,
               "family": RUNNER_IDLE_CHECKOUT_FAMILY, "path": os.fspath(checkout), "bytes": size,
               "verdict": "reclaimable" if not why else "blocked",
               "reasons": [why] if why else [f"unused for {RUNNER_STALE_CHECKOUT_HOURS:g} h" if stale
                                             else f"bloated: {gib(bloat).strip()} of packs" if bloat
                                             else "under the runner disk floor", "runner has no job"],
               "idle_hours": round((now - used) / 3600, 2)}
        with contextlib.suppress(OSError), receipt.open("a") as f:  # a lost receipt line must not stop the pass
            f.write(json.dumps(rec) + "\n")
        if outcome == "reclaimed":
            why_now = (f"unused for {RUNNER_STALE_CHECKOUT_HOURS:g} h" if stale
                       else f"bloated: {gib(bloat).strip()} of packs" if bloat else "under the disk floor")
            print(f"  reclaimed {gib(size).strip():>8s}  {checkout} (idle runner checkout, {why_now})")
    return released


# A bloated checkout (bloated_runner_checkouts) whose runner takes job after job is never quiet for
# RUNNER_IDLE_CHECKOUT_HOURS, so evict_idle_runner_checkouts never takes it: an hour after it reached stable
# (2026-10-27), the tour runner's 7-8 GiB checkout (glaeda-11) was still on all 11 minis. The runner hook takes it at
# job-started instead (--own-runner-checkout): the job's own workspace, before any step of the job runs, so no job of
# this runner is using it and no other runner ever does. Only its .git goes; the workspace directory stays for the
# steps that run before checkout, and actions/checkout, finding no repository there, clones at the job's depth.
RUNNER_CHECKOUT_AT_START_FAMILY = "runner-bloated-checkout-at-start"
# The job must be starting: its Runner.Worker began at most this long ago, and nothing in the checkout's git
# bookkeeping is newer than that start (a checkout step rewrites the index, HEAD and FETCH_HEAD). A later step of
# the job, or any other caller, finds the checkout already in use and is refused.
RUNNER_JOB_START_WINDOW_S = 600.0


def runner_agent_name(runner: Path) -> str | None:
    """The runner's name from its .runner config (agentName), or None when it cannot be read."""
    try:
        doc = json.loads((runner / ".runner").read_text(encoding="utf-8-sig"))
    except (OSError, ValueError):
        return None
    name = doc.get("agentName") if isinstance(doc, dict) else None
    return name if isinstance(name, str) and name else None


def checkout_git_touched(checkout: Path) -> float:
    """The newest mtime of the checkout's git bookkeeping, which any git command that moves it rewrites."""
    times = [0.0]
    for n in ("index", "HEAD", "FETCH_HEAD", "logs/HEAD", "packed-refs", "shallow", "config"):
        with contextlib.suppress(OSError):
            times.append((checkout / ".git" / n).lstat().st_mtime)
    return max(times)


def checkout_users(checkout: Path) -> tuple[str, str]:
    """The processes other than this one and its ancestors (the job-started hook, whose working directory is the
    workspace) that have a file open or their working directory anywhere in the checkout ("pid N (command)", or ""),
    and every command line. ps and lsof run in this process's own group, so the hook's timeout kill takes them too.
    Raises NoEvidence when lsof or ps cannot say."""
    def query(argv: list[str], timeout: float) -> tuple[int, str]:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                           timeout=timeout, check=False)
        return r.returncode, r.stdout
    try:
        code, out = query(["ps", "-axww", "-o", "pid=,ppid=,command="], 30)
        lcode, listing = query([shutil.which("lsof") or "/usr/sbin/lsof", "-n", "-P", "-Fpn"], 60)
    except (OSError, subprocess.SubprocessError) as e:
        raise NoEvidence(f"lsof or ps: {e}") from e
    if code != 0 or not out.strip() or lcode != 0 or not listing.strip():
        raise NoEvidence(f"lsof or ps failed (exit {lcode}, {code})")
    parents, commands = {}, {}
    for line in out.splitlines():
        fields = line.split(None, 2)
        if len(fields) >= 2 and fields[0].isdigit() and fields[1].isdigit():
            parents[int(fields[0])], commands[int(fields[0])] = int(fields[1]), (fields[2] if len(fields) > 2 else "")
    mine, pid = set(), os.getpid()
    while pid > 1 and pid not in mine:
        mine.add(pid)
        pid = parents.get(pid, 0)
    names = {*spellings(os.fspath(checkout)), *spellings(os.fspath(checkout.resolve()))}
    pid = 0
    for line in listing.splitlines():
        if line.startswith("p") and line[1:].isdigit():
            pid = int(line[1:])
        elif line.startswith("n/") and pid not in mine:
            path = line[1:]
            if any(path == n or path.startswith(n + "/") for n in names):
                return f"pid {pid} ({commands.get(pid, '?')[:80]})", command_text("\n".join(commands.values()))
    return "", command_text("\n".join(commands.values()))


def live_linked_worktrees(checkout: Path) -> list[str] | None:
    """The linked worktrees of the checkout's repository and of every repository stored inside its .git (absorbed
    submodules under modules/, nested ones) whose directories still exist (each <gitdir>/worktrees/<name>/gitdir
    names its <worktree>/.git; a --relative-paths one from worktrees/<name>), or None when any of it cannot be read.
    A worktree whose directory is gone (a job's RUNNER_TEMP, wiped between jobs) is only a stale entry."""
    dotgit = checkout / ".git"
    roots = []
    try:
        for root, dirs, files in os.walk(dotgit, onerror=lambda e: (_ for _ in ()).throw(e)):
            if "worktrees" in dirs and ("HEAD" in files or Path(root) == dotgit):
                roots.append(Path(root) / "worktrees")
            if "HEAD" in files and "objects" in dirs:  # a git dir: its stores hold no git dirs
                dirs[:] = [d for d in dirs if d not in ("objects", "lfs", "logs", "refs", "worktrees")]
    except OSError:
        return None
    live = []
    for root in roots:
        try:
            entries = list(os.scandir(root))
        except OSError:
            return None
        for e in entries:
            try:
                target = (Path(e.path) / "gitdir").read_text().strip()
            except OSError:
                return None
            if not target:
                return None
            target = os.path.normpath(os.path.join(e.path, target))  # a relative backlink is from worktrees/<name>
            if os.path.lexists(os.path.dirname(target)):
                live.append(os.path.dirname(target))
    return live


def evict_own_runner_checkout(workspace: Path, receipt: Path, home: Path | None = None) -> str:
    """Remove the .git of the starting job's own workspace when it is a bloated runner checkout and git loses nothing:
    a one-line note, or "" when the workspace is not an enrolled runner's _work/<repo>/<repo>, is not bloated, or the
    host is reserved. Any veto (git, an open file in its .git, a command naming the checkout, no process evidence)
    keeps it and writes a blocked receipt. Never raises OSError."""
    home = HOME if home is None else home
    checkout = Path(os.path.abspath(workspace))
    runner = checkout.parent.parent.parent
    runners = enrolled_runners(home)
    if checkout.parent.parent.name != "_work" or checkout.name != checkout.parent.name or runner not in runners:
        return ""
    if checkout not in runner_checkouts(runner / "_work") or host_reservation() or disk_off():
        return ""
    name = os.environ.get("RUNNER_NAME")
    if not name or runner_agent_name(runner) != name:
        return ""  # only the runner whose job is starting, about its own workspace
    started = runner_job_started(runner)
    if started is None or time.time() - started > RUNNER_JOB_START_WINDOW_S \
            or checkout_git_touched(checkout) >= started:
        return ""  # no job starting here, or this job already used the checkout
    every = [c for r in runners if not (r / "_work").is_symlink() and (r / "_work").is_dir()
             for c in runner_checkouts(r / "_work") if c.name == c.parent.name]
    bloat = bloated_runner_checkouts(every).get(os.fspath(checkout), 0)
    if not bloat:
        return ""
    git_dir = checkout / ".git"
    linked = live_linked_worktrees(checkout)
    why = ("its linked worktrees cannot be read" if linked is None
           else f"a linked worktree uses it ({linked[0]})" if linked else runner_checkout_git_veto(checkout))
    if not why:  # the git veto can take a minute: the evidence is read after it
        try:
            users, cmds = checkout_users(checkout)
        except NoEvidence as e:
            why = f"no process evidence: {e}"
        else:
            resolved = os.fspath(checkout.resolve())
            if users:
                why = f"open or a working directory of {users}"
            elif named_by(os.fspath(checkout), cmds) or named_by(resolved, cmds):
                why = "named by a running command"
    size = 0
    if why:
        outcome = "blocked:git" if why.startswith(("git", "a commit", "not a plain")) else "changed:in-use"
    else:
        try:
            before = free_bytes(home)[0]
            remove(git_dir)
            outcome = "reclaimed"
            size = max(0, free_bytes(home)[0] - before)
        except OSError as e:
            outcome = f"incomplete:{e.__class__.__name__}"
    rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(), "outcome": outcome,
           "family": RUNNER_CHECKOUT_AT_START_FAMILY, "path": os.fspath(git_dir), "bytes": size,
           "verdict": "blocked" if why else "reclaimable",
           "reasons": [why] if why else [f"bloated: {gib(bloat).strip()} of packs", "its runner's job is starting"]}
    with contextlib.suppress(OSError):
        receipt.parent.mkdir(parents=True, exist_ok=True)
        with receipt.open("a") as f:
            f.write(json.dumps(rec) + "\n")
    RUN["released"] = RUN.get("released", 0) + size
    if why:
        return f"kept the bloated checkout {checkout} ({gib(bloat).strip()} of packs): {why}"
    if outcome != "reclaimed":
        return f"could not remove {git_dir}: {outcome}"
    return f"removed {git_dir} ({gib(bloat).strip()} of packs, bloated; freed {gib(size).strip()}); checkout clones it again"


def own_runner_checkout_main(args: list[str]) -> int:
    """glaeda-disk --own-runner-checkout [--receipt PATH]: evict_own_runner_checkout on $GITHUB_WORKSPACE, from the
    runner hook at job-started. The workspace comes from the environment, so no command line names it. Exits 0."""
    ap = argparse.ArgumentParser(prog="glaeda-disk --own-runner-checkout")
    ap.add_argument("--own-runner-checkout", action="store_true")
    ap.add_argument("--receipt", type=Path, default=HOME / "Projects/recovery/disk-reclaim/receipts.jsonl")
    a = ap.parse_args(args)
    workspace = os.environ.get("GITHUB_WORKSPACE")
    if not workspace or not os.environ.get("RUNNER_NAME"):
        return 0
    RUN.clear()
    RUN.update(caller=run_caller(), mode="own-runner-checkout", apply=True)
    started, before = time.time(), _home_free()
    try:
        if (off := disk_off()):
            RUN.update(off=True, skipped=f"kill switch: {off}")
            return 0
        note = evict_own_runner_checkout(Path(workspace), a.receipt)
        if note:
            print(note)
        else:
            RUN["skipped"] = "not a bloated checkout of a starting job"
        return 0
    finally:
        write_run_line(started, before)



# Test runs leave one small scratch entry per test case in the runner user's $TMPDIR and never remove it:
# 88k entries and 22.6 GiB on cmux14, 36k and 11.9 GiB on cmuxs-mac-mini-6 (2026-10-21), almost all of
# them under the 50 MiB item floor, so the user-tmp family never sized or reclaimed one. Named here by the
# prefixes those tests use, each followed by its random suffix; anything else in $TMPDIR stays with
# user-tmp. Measured on the minis: cmux-cli-socket-<uuid> (a ~48 MiB copy of the DEV app per CLI socket
# test), cnd-bin-<n>, git-{pr,pr-merge,stage,hunk}-<uuid>, Foundation's TemporaryDirectory.<rand>.
TMP_TEST_RESIDUE_FAMILY = "user-tmp-test-residue"
TMP_TEST_RESIDUE = re.compile(
    r"(?:cmux-cli-socket|cnd-bin|git-pr-merge|git-pr|git-stage|git-hunk|cmux-home-attach-tests|cmux-file-pages"
    r"|floating-chat|header-pr|picker-listing|swift-package-test\.XXXXXX|TemporaryDirectory|cmux-claude-hooks"
    r"|swift-crash-reproducer|cmux-shortcut-routing|cmux-agent-journal-test|cmux-git-active-pwd"
    r"|cmux-ssh-pty-replay|cmux-screenshots-tests|glaeda-tmp-hold)[-.][0-9A-Za-z]")
# On a fleet mini with enrolled runners, also a name that is dash-separated words (no dots), a full UUID and at
# most a short extension (phone-tests-<uuid>.sqlite): test fixtures name their scratch this way, ~60 prefixes on
# one CI mini (2026-10-26), more than a list keeps up with. A dotted name (com.apple.CoreSimulator.SimDevice.<uuid>),
# a bare UUID, a TMP_TEST_RESIDUE_KEEP name or a credential extension never matches; by_prefix counts by the words.
# Only there: elsewhere $TMPDIR also holds a person's and their tools' own files.
_UUID = r"[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}"
TMP_TEST_UUID_NAME = re.compile(
    r"(?P<prefix>[A-Za-z][A-Za-z0-9_]*(?:-[A-Za-z0-9_]+)*)-" + _UUID + r"(?:\.(?P<ext>[A-Za-z0-9]{1,8}))?")
TMP_TEST_RESIDUE_KEEP = re.compile(r"(?:\.|com\.apple\.|tmux-|ssh-|launchd|xcrun_db|[A-Za-z0-9_-]*(?:sign|keychain|"
                                   r"cert|credential|secret|token|provision|notar|export|release))", re.I)
TMP_CREDENTIAL_EXT = frozenset(("keychain", "keychaindb", "p12", "pfx", "pem", "key", "cer", "crt", "der",
                                "mobileprovision", "provisionprofile", "p8", "jks", "keystore"))
# macOS guards $TMPDIR/<entry>/TemporaryItems (a sandboxed app's temporary-items folder): listing, renaming or
# removing it fails, and on macOS 27 the call blocks first. A test fixture that made one in its scratch dir left
# that dir behind on every run (cmux-screenshots-tests-*). One level deeper the name is not guarded, so the reaper
# moves such an entry into a holding dir, walks and judges it there like any other, and moves it back if it stays.
TMP_GUARDED_CHILD = "TemporaryItems"
TMP_HOLD_PREFIX = "glaeda-tmp-hold-"
TMP_TEST_RESIDUE_WARN = 10_000  # glaeda-fleet-status warns when this many test scratch entries are past 12 h
TMP_TEST_RESIDUE_IDLE_HOURS = DEFAULT_AGE_HOURS  # nothing in the entry changed for this long: no test run uses it
TMP_TEST_RESIDUE_WALK_BUDGET = 20_000  # entries walked per candidate; a bigger tree is not proven idle
TMP_TEST_RESIDUE_EVIDENCE_S = 60.0  # process evidence is re-read at least this often during a pass
TMP_TEST_RESIDUE_BUDGET_S = 600.0  # one pass stops here and holds the eviction lock no longer; the next continues


def tree_newest(path: Path, budget: int | None = None, deadline: float | None = None,
                no_sockets: bool = False) -> tuple[float, int] | None:
    """Newest mtime of path and of everything below it, and the bytes allocated to it, without following
    symlinks. None when the walk would visit more than budget entries, passes deadline (time.time()), meets
    a directory it cannot read, another filesystem mounted below path or (no_sockets) a socket, path itself
    included: such a tree is not proven idle."""
    budget = TMP_TEST_RESIDUE_WALK_BUDGET if budget is None else budget
    try:
        st = path.lstat()
    except OSError:
        return None
    if no_sockets and stat.S_ISSOCK(st.st_mode):
        return None
    newest, used, dev = st.st_mtime, st.st_blocks * 512, st.st_dev
    stack = [os.fspath(path)] if stat.S_ISDIR(st.st_mode) else []
    while stack:
        try:
            with os.scandir(stack.pop()) as it:
                for e in it:
                    budget -= 1
                    if budget < 0 or (deadline is not None and time.time() > deadline):
                        return None
                    try:
                        est = e.stat(follow_symlinks=False)
                    except OSError:
                        return None
                    if est.st_dev != dev:  # rmtree would descend into a mount below the entry
                        return None
                    if no_sockets and stat.S_ISSOCK(est.st_mode):  # a live daemon's socket shows no open file
                        return None
                    newest = max(newest, est.st_mtime)
                    used += est.st_blocks * 512
                    if stat.S_ISDIR(est.st_mode):
                        stack.append(e.path)
        except OSError:
            return None
    return newest, used


def tmp_test_residue_veto(entry: Path, opened: frozenset[str], cmds: str, now: float,
                          deadline: float | None = None, unnamed: bool = False) -> tuple[str, int]:
    """Why a test-scratch entry in $TMPDIR must stay ("" when it may go), and its allocated bytes. An entry
    no prefix names (unnamed) also stays while any socket sits in it."""
    if entry.is_symlink():
        return "a symlink", 0
    seen = tree_newest(entry, deadline=deadline, no_sockets=unnamed)
    if seen is None:
        return (f"not proven idle (unreadable, a mount or socket below it, over {TMP_TEST_RESIDUE_WALK_BUDGET}"
                " entries or past the pass budget)"), 0
    newest, used = seen
    if (now - newest) / 3600 < TMP_TEST_RESIDUE_IDLE_HOURS:
        return f"changed within {TMP_TEST_RESIDUE_IDLE_HOURS:g}h", used
    path, resolved = os.fspath(entry), os.fspath(entry.resolve())
    if in_cwd(path, opened) or in_cwd(resolved, opened):
        return "open or a working directory of a process", used
    if named_by(path, cmds) or named_by(resolved, cmds):
        return "named by a running command", used
    return "", used


def tmp_test_residue_prefix(name: str, runner_host: bool) -> str | None:
    """The receipt prefix of a $TMPDIR entry the reaper may take, or None: a TMP_TEST_RESIDUE name, or on a runner
    host (runner_host) a TMP_TEST_UUID_NAME that no KEEP name or credential extension rules out. Anything else
    stays: an idle, unopened entry is not proven disposable by its age alone."""
    if m := TMP_TEST_RESIDUE.match(name):
        return m.group(0)[:-2]
    if not runner_host or TMP_TEST_RESIDUE_KEEP.match(name):
        return None
    m = TMP_TEST_UUID_NAME.fullmatch(name)
    if m is None or (m.group("ext") or "").lower() in TMP_CREDENTIAL_EXT:
        return None
    return m.group("prefix")


def tmp_socket_veto(name: str) -> bool:
    """A socket in or at this entry keeps it: every candidate except the measured TMP_TEST_RESIDUE prefixes (whose
    tests leave socket files of their own, cmux-cli-socket-*), and always a hold a killed pass left."""
    return TMP_TEST_RESIDUE.match(name) is None or name.startswith(TMP_HOLD_PREFIX)


def tmp_hold_movable(name: str) -> bool:
    """Only a measured test prefix's entry is moved into the hold to be judged (its tests own it, and it has no
    socket veto to lose on the way): an entry the UUID rule names is judged in place, so a guarded one stays."""
    return TMP_TEST_RESIDUE.match(name) is not None and not name.startswith(TMP_HOLD_PREFIX)


def tmp_test_residue_runner_host() -> bool:
    """The UUID-named test fixture rule applies: a fleet mini whose user runs enrolled CI runners."""
    return ROLE == "fleet-mini" and bool(enrolled_runners())


def tmp_test_residue_census(tmp: Path | None = None, runner_host: bool | None = None) -> dict[str, Any] | None:
    """How much test scratch sits in $TMPDIR, for status: one listing and one lstat per candidate, no walk and
    no du. entries is every name; test_residue the reaper's candidates; idle those whose own mtime is past
    TMP_TEST_RESIDUE_IDLE_HOURS (an entry that changed deeper down still counts here). None off macOS."""
    if runner_host is None:  # the host's own $TMPDIR follows the host; a given directory only its named prefixes
        runner_host = tmp is None and tmp_test_residue_runner_host()
    tmp = (darwin_user_tmp() if DARWIN else None) if tmp is None else tmp
    if tmp is None or tmp.is_symlink() or not tmp.is_dir():
        return None
    now, entries, residue, idle = time.time(), 0, 0, 0
    try:
        with os.scandir(tmp) as it:
            for e in it:
                entries += 1
                if tmp_test_residue_prefix(e.name, runner_host) is None:
                    continue
                residue += 1
                with contextlib.suppress(OSError):
                    if (now - e.stat(follow_symlinks=False).st_mtime) / 3600 >= TMP_TEST_RESIDUE_IDLE_HOURS:
                        idle += 1
    except OSError:
        return None
    return {"entries": entries, "test_residue": residue, "idle": idle, "idle_hours": TMP_TEST_RESIDUE_IDLE_HOURS,
            "runner_host": runner_host}


def guarded_tmp_entry(entry: Path) -> bool:
    """A $TMPDIR entry with a TemporaryItems child, which macOS will not let anyone list or remove in place."""
    try:
        return stat.S_ISDIR(entry.lstat().st_mode) and os.path.lexists(entry / TMP_GUARDED_CHILD)
    except OSError:
        return False


def judge_tmp_entry(entry: Path, hold: Path, opened: frozenset[str], cmds: str, now: float,
                    deadline: float | None, unnamed: bool, movable: bool = True) -> tuple[str, int, Path]:
    """tmp_test_residue_veto for one $TMPDIR entry, and the path it now sits at; unnamed is tmp_socket_veto. A
    guarded entry stays unless movable (tmp_hold_movable); a movable one is first vetoed by its own name (open
    files, cwds, commands), then moved into hold, where it can be walked; one that must stay moves back."""
    if not guarded_tmp_entry(entry):
        return (*tmp_test_residue_veto(entry, opened, cmds, now, deadline=deadline, unnamed=unnamed), entry)
    if not movable:
        return "a guarded TemporaryItems in a name no measured test prefix lists", 0, entry
    path = os.fspath(entry)
    if in_cwd(path, opened):
        return "open or a working directory of a process", 0, entry
    if named_by(path, cmds):
        return "named by a running command", 0, entry
    hold.mkdir(exist_ok=True)
    moved = hold / entry.name
    os.rename(entry, moved)
    why, used = tmp_test_residue_veto(moved, opened, cmds, now, deadline=deadline, unnamed=unnamed)
    if why:
        if os.path.lexists(entry):  # a test made a new one meanwhile: the old one waits in hold for the next pass
            return why, used, moved
        os.rename(moved, entry)
        return why, used, entry
    return "", used, moved


def reap_tmpdir_test_residue(receipt: Path, tmp: Path | None = None, halt=None,
                             runner_host: bool | None = None) -> int:
    """Remove test scratch the runner user's tests left in $TMPDIR: entries named by TMP_TEST_RESIDUE (on a
    runner host also a TMP_TEST_UUID_NAME, see tmp_test_residue_prefix), whole trees unchanged for
    TMP_TEST_RESIDUE_IDLE_HOURS, held open and named by no process. Every candidate is walked and judged right
    before its own deletion; process evidence is never older than TMP_TEST_RESIDUE_EVIDENCE_S, and missing
    evidence stops the pass. One summary receipt line per pass."""
    if runner_host is None:  # the host's own $TMPDIR follows the host; a given directory only its named prefixes
        runner_host = tmp is None and tmp_test_residue_runner_host()
    tmp = (darwin_user_tmp() if DARWIN else None) if tmp is None else tmp
    if tmp is None or tmp.is_symlink() or not tmp.is_dir():
        return 0
    # Not a DELETING_PREFIX name: interrupted-deletions would finish a leftover without judging it. A hold a killed
    # pass left is named test scratch itself, walked and judged like any other entry.
    hold = tmp / f"{TMP_HOLD_PREFIX}{os.getpid()}"
    start = now = time.time()
    names = []
    try:
        with os.scandir(tmp) as it:
            for e in it:
                if tmp_test_residue_prefix(e.name, runner_host) is None:
                    continue
                with contextlib.suppress(OSError):  # an entry a test removed mid-scan drops only itself
                    # an entry whose own mtime is recent cannot be idle; skip it without walking it
                    if (now - e.stat(follow_symlinks=False).st_mtime) / 3600 >= TMP_TEST_RESIDUE_IDLE_HOURS:
                        names.append(e.name)
    except OSError:
        return 0
    names.sort()
    released, removed, kept, stopped = 0, collections.Counter(), collections.Counter(), ""
    evidence: tuple[frozenset[str], str] | None = None
    read_at = 0.0
    for name in names:
        now = time.time()
        if now - start > TMP_TEST_RESIDUE_BUDGET_S:
            stopped = f"pass budget {TMP_TEST_RESIDUE_BUDGET_S:g}s reached"
            break
        if evidence is None or now - read_at > TMP_TEST_RESIDUE_EVIDENCE_S:
            if halt is not None and (why := halt()):
                stopped = f"halted: {why}"
                break
            try:
                opened, cmds = process_evidence()
            except NoEvidence as e:
                stopped = f"no process evidence: {e}"
                print(f"refusing to reap $TMPDIR test scratch: {e}", file=sys.stderr)
                break
            evidence, read_at = (open_index(opened), cmds), time.time()
        entry = tmp / name
        prefix = tmp_test_residue_prefix(name, runner_host)
        try:
            why, used, entry = judge_tmp_entry(entry, hold, evidence[0], evidence[1], time.time(),
                                               start + TMP_TEST_RESIDUE_BUDGET_S, tmp_socket_veto(name),
                                               tmp_hold_movable(name))
        except OSError as e:
            kept[f"incomplete:{e.__class__.__name__}"] += 1
            continue
        if why:
            kept[why.split(" (")[0]] += 1
            continue
        try:
            remove(entry)
        except OSError as e:
            kept[f"incomplete:{e.__class__.__name__}"] += 1
            continue
        removed[prefix] += 1
        released += used
    with contextlib.suppress(OSError):  # empty once every move was deleted or moved back
        hold.rmdir()
    rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(),
           "outcome": "reclaimed" if removed else "none", "family": TMP_TEST_RESIDUE_FAMILY,
           "path": os.fspath(tmp), "bytes": released, "items": sum(removed.values()),
           "by_prefix": dict(removed), "kept": dict(kept), "candidates": len(names),
           **({"stopped": stopped} if stopped else {})}
    if names:
        with contextlib.suppress(OSError), receipt.open("a") as f:  # a lost receipt line must not stop the pass
            f.write(json.dumps(rec) + "\n")
    if removed:
        print(f"  reclaimed {gib(released).strip():>8s}  {sum(removed.values())} test scratch entries in {tmp}")
    return released


def apple_build_verdict(path: Path) -> str:
    """Why a glaeda-apple cache generation stays whatever its age, or "": a run is in flight or holds the
    build lock. Xcode writes deeper than the idle check looks, so the lock is what shows a build."""
    state = path.parent.parent
    if (state / "inflight.json").exists():
        return "a glaeda-apple run is in flight"
    try:
        fd = os.open(state / "build.lock", os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return ""
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return ""
    except OSError:
        return "a glaeda-apple run holds its build lock"
    finally:
        os.close(fd)


def worktree_roots(projects: Path) -> list[Path]:
    """Worktree parents under ~/Projects: the fixed names plus any `<name>-worktrees`."""
    names = set(WORKTREE_DIRS)
    for c in _children(projects):
        if c.name.endswith("-worktrees") and c.is_dir() and not c.is_symlink():
            names.add(c.name)
    return [projects / n for n in sorted(names)]


def fs_type(path: Path, mounts: Path = Path("/proc/mounts")) -> str:
    """Filesystem type of the mount holding path ("" when unknown, e.g. on macOS)."""
    try:
        target = str(mount_point(path))
        best = ""
        for line in mounts.read_text().splitlines():
            f = line.split()
            if len(f) >= 3 and f[1].replace("\\040", " ") == target:
                best = f[2]  # a later mount on the same point shadows earlier ones
        return best
    except OSError:
        return ""


def darwin_user_tmp() -> Path | None:
    """The per-user temp dir macOS gives every process as $TMPDIR (/var/folders/../T), resolved.

    It is not /private/tmp, so scratch that tools create with mktemp or tempfile lands here
    unseen: 14.5 GiB of throwaway cmux copies and build traces sat in it on Air Blue (2026-09-25).
    """
    try:
        out = subprocess.run(["getconf", "DARWIN_USER_TEMP_DIR"], capture_output=True, text=True,
                             timeout=10, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    value = out.stdout.strip() if out.returncode == 0 else ""
    if not value:
        return None
    path = Path(os.path.realpath(value))
    return path if path.is_dir() and path != Path("/private/tmp") else None


def darwin_code_sign_clones() -> Path | None:
    """The per-user code-signing clone dir beside $TMPDIR (/var/folders/../X), resolved.

    Chromium-based apps (Chrome, Edge, cmux with CEF) copy their bundle into
    X/<bundle id>.code_sign_clone/code_sign_clone.<random> at launch, so the running app's signature
    stays valid if the bundle is replaced, and remove it on a clean exit. A killed or crashed launch
    leaks the copy. Every media or perf launch of a fresh cmux DEV build leaked one of ~1 GiB that no
    family measured: 90 GiB (du) of them filled cmux14 to 0 GiB free, and 25 to 60 GiB sat on most GUI
    minis (2026-10-20). Most copies share blocks with the installed app, so du overstates what goes.
    """
    user_tmp = darwin_user_tmp()
    if user_tmp is None:
        return None
    path = user_tmp.parent / "X"
    return path if path.is_dir() and not path.is_symlink() else None


def keep_live_app_clones(level: list[Path], commands: str | None = None) -> list[Path]:
    """Drop the copies a running app may use from code_sign_clone candidates.

    A running app neither holds its copy open (its executable there is a hard link, so lsof names the
    installed path) nor names it on a command line, and the copy's mtime is its launch time, so neither
    the open-file nor the idle check protects it. Kept instead: the newest copy of every bundle id, and
    every copy of an app whose `<Name>.app/Contents/MacOS/` appears in a running command line. Without
    a process list nothing is a candidate.
    """
    if commands is None:
        try:
            ps = subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            return []
        if ps.returncode != 0 or not ps.stdout.strip():
            return []
        commands = ps.stdout
    newest: dict[Path, tuple[float, Path]] = {}
    for p in level:
        with contextlib.suppress(OSError):
            m = p.lstat().st_mtime
            if p.parent not in newest or m > newest[p.parent][0]:
                newest[p.parent] = (m, p)
    keep = {p for _, p in newest.values()}
    out = []
    for p in level:
        if p in keep:
            continue
        try:
            apps = [e.name[:-len(".bundle")] for e in os.scandir(p) if e.name.endswith(".app.bundle")]
        except OSError:
            continue  # unreadable: keep
        if any(f"{app}/Contents/MacOS/" in commands for app in apps):
            continue
        out.append(p)
    return out


def app_clone_running(clone: Path, commands: str) -> bool:
    """Whether an app in this code_sign_clone copy runs (keep_live_app_clones' test, for one copy right before
    its delete); unreadable counts as running."""
    try:
        apps = [e.name[:-len(".bundle")] for e in os.scandir(clone) if e.name.endswith(".app.bundle")]
    except OSError:
        return True
    return any(f"{app}/Contents/MacOS/" in commands for app in apps)


def bazel_family(root: Path) -> Family:
    # Bazel's output root on macOS (Linux keeps it under ~/.cache/bazel, a bazel-output-root layout). One output
    # base per workspace (an md5 name) and the unpacked install/: all rebuilt by bazel, and external/
    # holds its repository fetches, so git inside is fetched, not work (as in DerivedData). A running
    # bazel server holds its output base open and names it on its command line, so the in-use checks
    # keep it; a `bazel run` binary writing into its runfiles is kept by its cwd while it runs.
    # cache/ is the repository cache, not a rebuild: its downloads sit too deep for the idle check,
    # no process names it, newer Bazel links output bases' external/ into it, and it is what an
    # offline build or a vanished URL needs. install/ bases carry future mtimes, so they read recent.
    return Family("bazel-output", root, True, "bazel rebuilds it", skip=("cache",), owner="bazel",
                  rebuild_minutes=30, build_output=True, platform=host_cache_platform())


# launchd services of the hq build workers that read and write /Users/Shared/cmux-build-fleet/cache
HQ_BUILD_WORKERS = ("system/ai.manaflow.cmux-build-worker", "system/ai.manaflow.cmux-lent-worker")
HQ_CACHE_FAMILY = "hq-build-fleet-cache"

# A reload-cloud unit's checkouts are mirrors: cmux-base is a clone of GitHub (sync-repo.sh checks out
# origin/<branch> into it) and work/<slot> is that clone with the developer's tree rsynced over it from their
# laptop, which keeps the edits. So once a unit sat idle a week, no git check keeps it. Before that, a clone
# still has to lose nothing. Every git check kept them: 107 GiB idle since Sep 28-Oct 2 on eight minis read
# "git-checkout (checkout below the top level)" while glaeda-disk reported 0.0 G reclaimable (2026-10-11).
# A week of whole checkouts filled the minis; what is worth keeping is a commit or ref no remote has, so past this
# window archive_mirror bundles those into ~/archive and the tree goes (Leo, 2026-10-26: "When have we ever had
# something useful greater than 12 hours?").
CMUX_JOB_MIRROR_HOURS = DEFAULT_AGE_HOURS


def transcript_candidates(root: Path, archives: bool = False) -> list[Path]:
    """Return regular transcript files without treating the Codex tree as a cache."""
    roots = [root / "archive"] if archives else [root / "sessions", root / "thread_history"]
    found: list[Path] = []
    for base in roots:
        if not base.is_dir() or base.is_symlink():
            continue
        for dirpath, dirnames, filenames in os.walk(base, followlinks=False):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for name in filenames:
                path = Path(dirpath) / name
                try:
                    if path.is_file() and not path.is_symlink():
                        found.append(path)
                except OSError:
                    continue
    return found


# The hq build workers' shared cache: the dedicated dev-build worker (cmuxterm-hq#661) and the lent worker
# on borrowed minis (ai.manaflow.cmux-lent-worker, CMUX_CI_SHARED_CACHE_DIR) both build in it. It is
# retired, and reclaimable, only while neither service is loaded. Naming only the dev-build worker
# labelled the lent minis' live cmux-workspaces "RETIRED" (cmux12s, 2026-10-11).
# A retired worker's checkouts are mirrors as a reload unit's are: cmux-workspaces/<key>/src is a clone the
# worker synced from GitHub, swiftpm holds SwiftPM's own clones, and no person edits either. So once an entry
# sat idle past CMUX_JOB_MIRROR_HOURS, no git check keeps it (archive_mirror bundles what is unpushed), and a tree too deep to search (cmux-tui-target, a cargo target dir)
# is not kept as "unchecked" either. A fleet lease or running job that names an entry still keeps it, as in
# fleet-artifacts over the same directory. cmux14 sat at the 30 GiB floor with 0.0G reclaimable while
# cmux-workspaces (11.6 GiB, idle 190 h), cmux-tui-target (4.2 GiB, 289 h) and swiftpm (3.9 GiB, 310 h) of
# its unloaded workers read "git-checkout" and "unchecked" (2026-10-25).
def hq_cache_family(root: Path | None = None) -> Family:
    return Family(HQ_CACHE_FAMILY, FLEET_ROOT / "cache" if root is None else root, True,
                  "the hq build worker rebuilds its cache", retired_only=True,
                  owner="cmux dev-build and lent build workers (hq controller)",
                  owner_job=HQ_BUILD_WORKERS, mirror_idle_hours=CMUX_JOB_MIRROR_HOURS,
                  reference_root=FLEET_ROOT if root is None else root.parent, platform="macos")


def default_families(role: str = "fleet-mini") -> list[Family]:
    tmp = Path("/private/tmp") if DARWIN else Path("/tmp")
    tmpfs = tmp.is_dir() and fs_type(tmp) == "tmpfs"
    uid = os.getuid()
    projects = HOME / "Projects"
    wt_roots = worktree_roots(projects)
    fams = [
        Family("xcode-derived-data", HOME / "Library/Developer/Xcode/DerivedData", True,
               "next xcodebuild rebuilds it", owner="Xcode, per checkout", rebuild_minutes=15,
               build_output=True, platform="macos"),
        Family("claude-scratchpad", tmp / f"claude-{uid}", True,
               "session scratch space; the session is idle", depth=2,
               skip=("bundled-skills", "bash-edit-diff"), owner="Claude sessions", rebuild_minutes=0.5,
               # sessions clone into <session>/scratchpad/<name>; each clone must lose nothing
               git_disposable=True, nested_git=True, platform="shared"),
        # Scratch and disposable CI checkouts are cold after an hour under either pressure or an
        # idle sweep. Process, socket, root-token and git-loss checks still veto live or valuable work.
        Family("tmp", tmp, True, "agent scratch under the temp dir",
               skip=(f"claude-{uid}",), files=True, max_idle_hours=1.0,
               min_bytes=1024**2 if tmpfs or role == "devbox" else None, git_disposable=True, owner="agents and tools",
               rebuild_minutes=0.5, platform=host_cache_platform()),
        # cmux's cloud reload and CI jobs keep warm trees per unit (reload-cloud/{cmux-base,work},
        # reload-cloud-ios/{DerivedData,work}); a build mini grew 36 GiB here within hours. Depth 2
        # so a unit's DerivedData can go while the clones below cmux-base and work stay protected.
        # Reload-cloud state must be at least half a day old before this pass considers it; pressure
        # runs therefore cannot erase a slot used recently in the same work period.
        Family("cmux-job-cache", HOME / ".cache/cmux-job", True,
               "next cmux reload or CI job rebuilds it (cold)", depth=2, git_disposable=True,
               owner="cmuxterm-hq reload-cloud scripts", rebuild_minutes=30, min_idle_hours=DEFAULT_AGE_HOURS,
               mirror_idle_hours=CMUX_JOB_MIRROR_HOURS, platform=host_cache_platform()),
        # Caches are disposable by definition; an idle one goes under pressure, a live one (go-build
        # while a Go build runs) stays recent. Any git data inside keeps it, as everywhere else.
        Family("user-cache", HOME / ".cache", True, "the tool re-downloads or rebuilds it",
               # glaeda* holds glaeda-gh daemon state, the minis' native cache root, fleet-cas deployments
               # and benchmark receipts; huggingface keeps its token; codex-runtimes is an install
               skip=("cmux-job", "huggingface", "codex-runtimes"), skip_prefixes=("glaeda",),
               owner="tools (XDG cache)", rebuild_minutes=5, pressure_only=role == "devbox", platform=host_cache_platform()),
        Family("library-caches", HOME / "Library/Caches", True, "the app re-downloads or rebuilds it",
               # glaeda: OTA candidates and LAN seed stages; PassKit: web service cookies; tidy-branches:
               # a deletion receipt; the rest are Apple daemons without the com.apple. prefix
               skip=("glaeda", "cmux-next-ci", "PassKit", "tidy-branches", "CloudKit", "GeoServices", "FamilyCircle",
                     "familycircled", "GameKit", "askpermissiond", "mbuseragent", "AMSDataMigratorTool",
                     "PHTPhenotype", "SharedImageCache", "Animoji", "SiriTTS", "GIPPseudonymousID"),
               skip_prefixes=("com.apple.",), owner="apps", rebuild_minutes=5,
               stale_before=ARTIFACT_CUTOFF, reference_root=FLEET_ROOT, pressure_only=role == "devbox", platform="macos"),
        # CUA recordings and frame caches are runner tooling residue, not private user data needed
        # by CI. Keep them separate from the generic Application Support/Cache totals so operators
        # can see their age and reclaim them after the normal process/open-file gate passes.
        Family("cua-recordings", HOME / "Library/Application Support/cua-ssh/recordings", True,
               "the CUA recorder can capture it again", depth=1, files=True,
               min_idle_hours=DEFAULT_AGE_HOURS, owner="CUA recorder", rebuild_minutes=2, platform="macos"),
        Family("cua-cache", HOME / "Library/Caches/cmux/cmux-cua", True,
               "the CUA client rebuilds its frame cache", depth=1, files=True,
               min_idle_hours=DEFAULT_AGE_HOURS, owner="cmux CUA", rebuild_minutes=1, platform="macos"),
        # Sealed caches (cache_layout) anywhere else in the home directory: ~/.npm/_cacache,
        # ~/.bun/install/cache, ~/.cargo/registry, ~/go/pkg/mod, rustup toolchains. Found by content,
        # so a tool this list never heard of is covered once its cache has a recognized layout.
        # DEFAULT_AGE_HOURS: Linux's relatime moves a file's access time once a day, so a cache read every hour can
        # show a day-old atime; the live process and command checks protect a cache in use, and one that goes is
        # downloaded again.
        Family("home-caches", HOME, True, "the tool re-downloads or rebuilds it", discover=True,
               owner="tools (found by cache layout)", rebuild_minutes=5, min_idle_hours=DEFAULT_AGE_HOURS, pressure_only=role == "devbox", platform=host_cache_platform()),
        Family("simulators", HOME / "Library/Developer/CoreSimulator", False,
               "use `xcrun simctl delete unavailable` (report only)", platform="macos"),
        Family("projects", projects, False, "checkouts (report only)",
               skip=tuple(r.name for r in wt_roots), platform="shared"),
    ]
    cmux_next_ci = HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT
    if DARWIN and cmux_next_ci.is_dir():
        fams.append(cmux_next_ci_family(cmux_next_ci))
    if DARWIN and nightly_next_split():
        lib = next(i for i, f in enumerate(fams) if f.id == "library-caches")
        fams[lib] = replace(fams[lib], skip=(*fams[lib].skip, NIGHTLY_NEXT_ROOT))
        fams.append(nightly_next_family())
    user_tmp = darwin_user_tmp() if DARWIN else None
    if user_tmp is not None:
        # Apple daemons keep live state in com.apple.* entries without holding them open.
        # Do not use the bulk root walk here. A user's temp directory can contain hundreds of
        # independent scratch trees; ``du -d1`` still recursively walks all of them and can spend
        # the full timeout in one kernel filesystem call. The per-child walks remain killable and
        # fail closed, so one wedged tree cannot make the whole temp root look like one stuck item.
        fams.append(Family("user-tmp", user_tmp, True, "agent scratch under the per-user $TMPDIR",
                           skip_prefixes=("com.apple.",), git_disposable=True,
                           owner="agents and tools", rebuild_minutes=0.5, platform="shared"))
    clones = darwin_code_sign_clones() if DARWIN else None
    if clones is not None:
        # One copy per launch, below a directory per bundle id. keep_live_app_clones keeps each bundle's
        # newest copy and any copy of a running app; two idle hours cover a launch in progress. An app
        # bundle is too deep for the git search to finish and holds no checkout, so it is build output.
        fams.append(Family("code-sign-clones", clones, True, "the app copies its bundle again at its next launch",
                           depth=2, include=("code_sign_clone.",), skip_prefixes=("com.apple.",),
                           app_clones=True, build_output=True, min_idle_hours=2.0,
                           owner="Chromium-based apps, one bundle copy per launch",
                           rebuild_minutes=0.5, platform="macos"))
    fams.append(hq_cache_family())
    bazel_user = ""
    with contextlib.suppress(KeyError):
        bazel_user = pwd.getpwuid(uid).pw_name
    if DARWIN and bazel_user:
        fams.append(bazel_family(Path(f"/private/var/tmp/_bazel_{bazel_user}")))
    if DARWIN:  # the owned cmux minis
        # These roots contain disposable build products outside the CI hot tier. Keep Chromium's
        # source tree under cmux-browser-fleet/build, but allow old top-level tour artifacts and
        # fleet cache entries to age out. A live reservation/lease still protects referenced paths.
        fleet_cache = FLEET_ROOT / "cache"
        if fleet_cache.is_dir():
            fams.append(Family("fleet-artifacts", fleet_cache, True,
                               "the fleet worker rebuilds or fetches the artifact", depth=1,
                               files=True, allow_stale_protected=True, stale_before=ARTIFACT_CUTOFF,
                               reference_root=FLEET_ROOT, owner="cmux fleet worker", rebuild_minutes=8,
                               platform="macos"))
        ci_ios = FLEET_ROOT / "ci-ios"
        if ci_ios.is_dir():
            fams.append(ci_ios_family(ci_ios))
        browser = HOME / "cmux-browser-fleet"
        if browser.is_dir():
            fams.append(Family("browser-artifacts", browser, True,
                               "the browser tour rebuilds the artifact", depth=1, files=True,
                               skip=("build",), allow_stale_protected=True, stale_before=ARTIFACT_CUTOFF,
                               reference_root=FLEET_ROOT, owner="cmux browser fleet", rebuild_minutes=20,
                               platform="macos"))
        fams += fleet_families()
        fams += canonical_admission_families()
        fams += runner_checkout_families()
        for runner in HOME.glob("actions-runner*"):
            temp = runner / "_work/_temp"
            if (runner / ".runner").is_file() and (runner / "glaeda-hooks").is_dir() and temp.is_dir():
                fams.append(Family("ci-derived-data", temp, True, "the CI test job rebuilds it",
                                   include=("cmux-derived-data-tests-",), build_output=True,
                                   owner="cmux CI test jobs", rebuild_minutes=6, platform="macos"))
                if (runner.name.startswith("actions-runner-glaeda-") and real_runner_dir(runner)
                        and not (runner / "_work").is_symlink() and not temp.is_symlink()
                        and (runner / "glaeda-hooks/dedicated-admit.sh").is_file()):
                    # a dedicated runner (its admission wrapper): what its jobs leave in _temp goes by age
                    fams.append(Family(DEDICATED_RUNNER_TEMP, temp, True, "the next job writes its own _temp",
                                       files=True, skip=("_github_home", "_github_workflow", "_runner_file_commands"),
                                       skip_prefixes=("cmux-derived-data-tests-",),  # ci-derived-data's
                                       min_idle_hours=DEFAULT_AGE_HOURS, owner="the dedicated runner's jobs",
                                       rebuild_minutes=0.1, platform="macos"))
        # The runner mini's full cmux git mirror (glaeda-git-mirror), kept by role: jobs fetch their commit from it
        # instead of GitHub, and a reseed is a 2.4 GB bundle download. About 2.2 GiB, grown only by new commits.
        fams.append(Family("cmux-git-mirror", Path("/Users/Shared/cmux-build-fleet/git"), False,
                           "report only: kept by role, the fleet git mirror jobs fetch from",
                           owner="glaeda-git-mirror", platform="macos"))
        # Bounded by its owner: node_product_cache.py evicts LRU to CMUX_NODE_PRODUCT_CACHE_MAX_BYTES (24 GiB).
        fams.append(Family("cmux-node-products", Path("/Users/Shared/cmux-build-fleet/node-products"), False,
                           "report only: its owner evicts LRU to a 24 GiB budget",
                           owner="cmux node_product_cache.py", platform="macos"))
    for root in wt_roots:
        fams.append(Family("worktrees", root, False,
                           "run glaeda-worktree-reclaim-all (report only)", platform="shared"))
    # SwiftPM and glaeda-apple build output inside the checkouts: every other family here keeps a checkout
    # whole, so under pressure nothing was left to evict while agent sessions compiled packages in hundreds
    # of worktrees (Air Blue fell to 134 MiB free, 2026-09-28). A day idle, since the session may come back.
    fams.append(checkout_build_family(projects, role))
    # Cargo owns target validity and RFC #1137 owns Cargo reclaim, so this is visibility only.
    # Sizes here are also counted inside their checkout under projects or worktrees.
    fams.append(Family("cargo-target", projects, False,
                       "report only: cargo clean; also counted in its checkout",
                       depth=4, match="target", marker="CACHEDIR.TAG", platform="shared"))
    if role == "devbox":
        # Apply the same clean, pushed, live-process and age guards used for disposable
        # scratch checkouts to developer workspaces. Fleet minis keep their owned hot tier.
        if contained_directory(projects / "worktrees", projects):
            fams.append(Family("devbox-checkouts", projects / "worktrees", False,
                               "report only: preserve developer source and Git state", depth=2, git_disposable=True,
                               nested_git=True, owner="developer workspaces", rebuild_minutes=8,
                               platform="shared"))
        codex = HOME / ".codex"
        fams.append(Family("agent-transcripts", codex, False,
                           "report only: preserve Codex task history",
                           min_idle_hours=DEVBOX_TRANSCRIPT_DAYS * 24, transcripts=True,
                           owner="Codex sessions", rebuild_minutes=0.1, platform="shared"))
        fams.append(Family("agent-transcript-archives", codex, False,
                           "report only: preserve Codex transcript history", min_idle_hours=DEVBOX_TRANSCRIPT_DELETE_DAYS * 24,
                           transcript_archives=True, owner="Codex transcript archive", rebuild_minutes=0.1,
                           platform="shared"))
    return [f for f in fams if f.root.is_dir()]


def runner_cache_families() -> list[Family]:
    """Return only rebuildable CI residue for an enrolled runner account.

    This is deliberately an allowlist.  The account may have belonged to a person
    before it became a runner, so generic XDG caches, Application Support, keys,
    browser state, toolchains, and wallpapers are outside this profile.  Process,
    open-file, command-line, socket, git and age gates are still applied by
    ``survey`` and ``apply``.
    """
    if not DARWIN:
        return []
    roots = [
        Family("xcode-derived-data", HOME / "Library/Developer/Xcode/DerivedData", True,
               "next xcodebuild rebuilds it", owner="Xcode, per checkout", rebuild_minutes=15,
               build_output=True, min_idle_hours=RUNNER_CACHE_IDLE_HOURS, platform="macos"),
        Family("cmux-job-cache", HOME / ".cache/cmux-job", True,
               "next cmux reload or CI job rebuilds it", depth=2, git_disposable=True,
               owner="cmux reload-cloud", rebuild_minutes=30, min_idle_hours=RUNNER_CACHE_IDLE_HOURS,
               mirror_idle_hours=CMUX_JOB_MIRROR_HOURS, platform="macos"),
        Family("cmux-ghosttykit-cache", HOME / ".cache/cmux/ghosttykit", True,
               "cmux rebuilds GhosttyKit", depth=1, files=True,
               owner="cmux build tooling", rebuild_minutes=5, min_idle_hours=RUNNER_CACHE_IDLE_HOURS,
               platform="macos"),
        Family("cua-recordings", HOME / "Library/Application Support/cua-ssh/recordings", True,
               "the CUA recorder can capture it again", depth=1, files=True,
               skip=("index.json", "manifest.json", "state.json", ".metadata_never_index", ".lock"),
               owner="CUA recorder", rebuild_minutes=2, min_idle_hours=RUNNER_CACHE_IDLE_HOURS, platform="macos"),
        Family("cua-cache", HOME / "Library/Caches/cmux/cmux-cua", True,
               "the CUA client rebuilds its frame cache", depth=1, files=True,
               skip=("index.json", "manifest.json", "state.json", ".metadata_never_index", ".lock"),
               owner="cmux CUA", rebuild_minutes=1, min_idle_hours=RUNNER_CACHE_IDLE_HOURS, platform="macos"),
    ]
    if (HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT).is_dir():
        roots.append(replace(cmux_next_ci_family(), min_idle_hours=RUNNER_CACHE_IDLE_HOURS))
    if nightly_next_split():
        roots.append(replace(nightly_next_family(), min_idle_hours=RUNNER_CACHE_IDLE_HOURS,
                             max_idle_hours=RUNNER_CACHE_IDLE_HOURS))
    return [f for f in roots if f.root.is_dir()]


def runner_profile_roots_safe(fams: list[Family]) -> bool:
    """Require profile roots to remain real directories on the account's home volume."""
    try:
        home = HOME.resolve(strict=True)
        home_stat = home.stat()
    except OSError:
        return False
    for fam in fams:
        try:
            root = fam.root
            if not root.is_absolute() or root.is_symlink() or not root.is_dir():
                return False
            resolved = root.resolve(strict=True)
            if resolved != root or not resolved.is_relative_to(home):
                return False
            if root.stat().st_dev != home_stat.st_dev:
                return False
            current = root
            while current != home:
                st = current.lstat()
                if stat.S_ISLNK(st.st_mode) or st.st_dev != home_stat.st_dev:
                    return False
                current = current.parent
            if current != home:
                return False
        except (OSError, ValueError):
            return False
    return True


def runner_profile_path_safe(fam: Family, path: Path) -> bool:
    """Reject a candidate whose parent chain escaped its profile root."""
    try:
        root = fam.root.resolve(strict=True)
        observed = path.resolve(strict=True)
        if not observed.is_relative_to(root):
            return False
        current = path
        while current != fam.root:
            st = current.lstat()
            if stat.S_ISLNK(st.st_mode):
                return False
            current = current.parent
        return current == fam.root
    except (OSError, ValueError):
        return False


@dataclass
class Item:
    family: str
    path: str
    bytes: int
    idle_hours: float
    verdict: str  # reclaimable | recent | in-use | git-checkout | unchecked | report-only | kept
    reasons: list[str] = field(default_factory=list)
    jobs_since: int | None = None  # host CI jobs started since its last use (activity_due), when counted
    platform: str = "unknown"


def platform_label(fam: Family) -> str:
    """Return a bounded reporting label; platform is evidence for display, never deletion authority."""
    return fam.platform if fam.platform in PLATFORM_VALUES else "unknown"


def eviction_activity() -> dict[str, str] | None:
    """Return bounded live activity evidence for a measurement timeout.

    A timeout while a build owns the fleet host lock (or while a Runner.Worker/build
    process is live) is expected contention, not a wedged eviction.  Keep the probe
    read-only and short: stale marker files are accepted only when their PID is still
    alive, and the lock/process probes have a five-second bound.
    """
    for marker in (FLEET_DIR / "evict-lock-v1", FLEET_DIR / "host-lock-holder",
                   FLEET_DIR / "host.lock.yield"):
        try:
            text = marker.read_text(encoding="utf-8", errors="replace")[:256]
            match = re.search(r"\b([1-9][0-9]{0,8})\b", text)
            if match:
                pid = int(match.group(1))
                if _pid_alive(pid):
                    command = _owner_command(pid)
                    detail = f"{marker.name} pid {pid}"
                    if command:
                        detail += f" ({command[:160]})"
                    return {"state": "active", "evidence": detail}
        except (OSError, ValueError):
            continue
    lock = FLEET_DIR / "host.lock"
    try:
        fd = os.open(lock, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        fd = None
    except OSError:
        fd = None
    if fd is not None:
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                return {"state": "active", "evidence": "fleet host.lock is held"}
        finally:
            os.close(fd)
    try:
        result = subprocess.run(["ps", "-axww", "-o", "command="],
                                capture_output=True, text=True, timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode == 0:
        for line in result.stdout.splitlines():
            if CI_WORKER.search(line) or BUILD_PROCESS.search(line):
                return {"state": "active", "evidence": f"active build process: {line.strip()[:220]}"}
    return None


def _record_eviction_stuck(argv: list[str]) -> None:
    """Record a timeout and distinguish active host contention from stale work."""
    raw_path = str(argv[-1]) if argv else "unknown"
    try:
        path = os.path.realpath(raw_path)
    except OSError:
        path = raw_path
    observed_at = time.time()
    _TIMED_OUT_PATHS[path] = observed_at
    with contextlib.suppress(OSError, TypeError, ValueError):
        TIMEOUT_STATE.parent.mkdir(parents=True, exist_ok=True)
        state = json.loads(TIMEOUT_STATE.read_text()) if TIMEOUT_STATE.exists() else {}
        if not isinstance(state, dict):
            state = {}
        old = state.get(path) if isinstance(state.get(path), dict) else {}
        state[path] = {"at": observed_at, "count": int(old.get("count", 0)) + 1}
        tmp = TIMEOUT_STATE.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(state, separators=(",", ":")))
        os.replace(tmp, TIMEOUT_STATE)
    activity = eviction_activity()
    state = "active" if activity is not None else "stale"
    severity = "warn" if activity is not None else "error"
    auto_fix = "deferred" if activity is not None else "pending"
    evidence = f"du timed out after {DU_TIMEOUT_S}s"
    if activity is not None:
        evidence += f"; {activity['evidence']}"
    for finding in EVICTION_STUCK:
        if finding.get("id") == "eviction_stuck" and finding.get("path") == path:
            finding["count"] = int(finding.get("count", 1)) + 1
            finding["state"] = state
            finding["severity"] = severity
            finding["auto_fix"] = auto_fix
            finding["evidence"] = evidence
            finding["observed_at"] = int(observed_at)
            if activity is None:
                finding.pop("activity", None)
            else:
                finding["activity"] = activity
            return
    record = {"id": "eviction_stuck", "severity": severity, "path": path,
              "evidence": evidence, "auto_fix": auto_fix, "state": state,
              "observed_at": int(observed_at), "count": 1}
    if activity is not None:
        record["activity"] = activity
    EVICTION_STUCK.append(record)


def _measurement_path_allowed(path: Path) -> bool:
    """Reject the volume root and known privacy/FileProvider trees before invoking du."""
    try:
        absolute = Path(os.path.abspath(path))
    except (OSError, ValueError):
        return False
    if absolute == Path("/") or any(part in MEASURE_SKIP_COMPONENTS for part in absolute.parts):
        return False
    try:
        st = absolute.stat()
    except OSError:
        return False
    # Newer macOS exposes a dataless flag on some FileProvider placeholders.  Python's
    # stat module does not define it on every SDK, so probe the platform value when present.
    dataless = getattr(stat, "UF_DATALESS", 0)
    return not bool(getattr(st, "st_flags", 0) & dataless)


def _measurement_on_timeout_cooldown(path: Path) -> bool:
    """Return true when a prior timeout says to leave this path unsized for now."""
    try:
        key = os.path.realpath(os.fspath(path))
    except OSError:
        return False
    at = _TIMED_OUT_PATHS.get(key)
    if at is None:
        try:
            state = json.loads(TIMEOUT_STATE.read_text())
            entry = state.get(key) if isinstance(state, dict) else None
            at = float(entry.get("at")) if isinstance(entry, dict) else None
        except (OSError, TypeError, ValueError):
            at = None
        if at is not None:
            _TIMED_OUT_PATHS[key] = at
    return at is not None and time.time() - at < TIMEOUT_COOLDOWN_S


def fixed_measurement_roots() -> list[Path]:
    """Return only bounded, rebuildable roots used for volume accounting.

    This deliberately does not include ``/``: FileProvider and other privacy-protected
    directories can block a recursive fts walk in the kernel for hours.
    """
    if RUNNER_CACHE_PROFILE:
        # The per-account profile must not recursively inspect generic home caches
        # merely to explain an accounting gap. Its selected family roots are already
        # measured by survey().
        return [f.root for f in runner_cache_families()]
    candidates: list[Path] = [
        # Keep known-heavy fleet roots separate. A single du of the shared
        # fleet tree can hold evict.lock long enough to starve admission.
        FLEET_ROOT / "cache",
        FLEET_ROOT / "ci",
        FLEET_ROOT / "ci-ios",
        FLEET_ROOT / "ci-ios-packages",
        FLEET_ROOT / "job-volumes",
        FLEET_ROOT / "logs",
        HOME / "cmux-browser-fleet",
        HOME / "Library/Caches",
        HOME / "Library/Developer/Xcode/DerivedData",
        HOME / "Library/Developer/CoreSimulator",
        HOME / ".cache",
    ]
    candidates.extend(sorted(HOME.glob("actions-runner*/_work")))
    roots: list[Path] = []
    seen: set[str] = set()
    for path in candidates:
        resolved = Path(os.path.abspath(path))
        key = os.fspath(resolved)
        if key in seen or resolved == Path("/") or any(part in MEASURE_SKIP_COMPONENTS for part in resolved.parts):
            continue
        seen.add(key)
        # Keep configured roots in the list even before the directory is created; accounting
        # will simply skip a missing root, and tests can substitute a bounded fake root.
        roots.append(resolved)
    return roots


def _du_output(argv: list[str], allow_nonzero: bool = False,
               record_timeout: bool = True, timeout: float | None = None) -> str | None:
    """Run one du walk with a killable process group; None means the tree is unsized.

    Report-only accounting and tooling probes use the same bounded walker, but a timeout there
    is an accounting gap rather than an eviction failure.  Keep the distinction at this boundary
    so only measurements that can participate in an eviction decision publish ``eviction_stuck``.
    """
    try:
        proc = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            start_new_session=True,
        )
        _ACTIVE_DU_PROCS[proc.pid] = proc
        try:
            out, _ = proc.communicate(timeout=DU_TIMEOUT_S if timeout is None else timeout)
        except subprocess.TimeoutExpired:
            # du can be stuck in a kernel open() on a dead or remote filesystem.  Kill the group
            # and do not wait indefinitely for a post-kill read: callers must remain fail-closed.
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, signal.SIGKILL)
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.communicate(timeout=DU_KILL_GRACE_S)
            if record_timeout:
                _record_eviction_stuck(argv)
            return None
        except BaseException:
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, signal.SIGKILL)
            with contextlib.suppress(subprocess.TimeoutExpired, OSError):
                proc.communicate(timeout=DU_KILL_GRACE_S)
            raise
        finally:
            _ACTIVE_DU_PROCS.pop(proc.pid, None)
    except OSError:
        return None
    if proc.returncode != 0 and not allow_nonzero:
        return None
    return out


def _terminate_active_children() -> None:
    """Kill owned measurement/evidence children; each owner reaps its own Popen."""
    for registry in (_ACTIVE_DU_PROCS, _ACTIVE_QUERY_PROCS):
        for pid, proc in list(registry.items()):
            with contextlib.suppress(OSError):
                os.killpg(pid, signal.SIGKILL)
            # The owning worker/main path performs communicate and removes the entry.


def du_bytes(path: Path, *, record_timeout: bool = True) -> int | None:
    if not _measurement_path_allowed(path):
        return None
    if _measurement_on_timeout_cooldown(path):
        return None
    out = _du_output(["du", "-xsk", str(path)], record_timeout=record_timeout)
    if out is None:
        return None
    try:
        return int(out.split()[0]) * 1024
    except (IndexError, ValueError):
        return None


BULK_SIZE_MIN = 64  # unsized candidates in a bulk_sizes family before one walk beats per-item du


def du_children(root: Path, *, record_timeout: bool = True) -> dict[str, int] | None:
    """Sizes of every directory directly below root from a single walk, keyed like candidates."""
    if not _measurement_path_allowed(root):
        return None
    out = _du_output(["du", "-xk", "-d", "1", str(root)], record_timeout=record_timeout)
    if out is None:
        return None
    sizes: dict[str, int] = {}
    for line in out.splitlines():
        fields = line.split(None, 1)
        if len(fields) == 2 and fields[1] != str(root) and fields[0].isdigit():
            sizes[str(root / Path(fields[1]).name)] = int(fields[0]) * 1024
    return sizes


def du_children_with_status(root: Path, *, record_timeout: bool = True) -> tuple[dict[str, int], bool] | None:
    """Return a bounded one-level walk plus whether every entry was readable.

    macOS `du` exits nonzero when an unprivileged health agent meets a protected
    directory, but it still prints useful lower-bound rows. This function preserves
    those rows and marks the result incomplete; callers must keep it report-only.
    """
    if not _measurement_path_allowed(root):
        return None
    out = _du_output(["du", "-xk", "-d", "1", str(root)], allow_nonzero=True,
                     record_timeout=record_timeout)
    if out is None:
        return None
    sizes: dict[str, int] = {}
    for line in out.splitlines():
        fields = line.split(None, 1)
        if len(fields) == 2 and fields[1] != str(root) and fields[0].isdigit():
            sizes[str(root / Path(fields[1]).name)] = int(fields[0]) * 1024
    complete = not any(line.startswith("du:") for line in out.splitlines())
    return sizes, complete


def newest_mtime(path: Path, levels: int = 2, budget: int = 3000, access: bool = False,
                 skip_names: frozenset[str] = frozenset()) -> float:
    """Newest mtime of path and entries up to `levels` below it, visiting at most `budget` entries.

    Build tools touch top-level files (DerivedData info.plist, logs) on every run, so a shallow,
    bounded look is enough to see activity without walking the whole tree. With `access`, a file's
    access time counts too, where the filesystem keeps it: a cache is read far more often than written.
    It is a hint for LRU order, not protection: APFS moves atime lazily and Linux relatime at most daily,
    and only the top `levels` are seen (npm's cacache and Go's module cache keep their blobs deeper).
    A cache in use is kept by the process evidence (open files, cwd, command lines), not by atime.
    Only files count, and never the ones a layout test reads (LAYOUT_PROBES): listing a directory or
    reading a probe would move the very times being judged.
    """
    try:
        newest = path.lstat().st_mtime
    except OSError:
        return 0.0
    frontier = [str(path)]
    for _ in range(levels):
        nxt: list[str] = []
        for d in frontier:
            try:
                with os.scandir(d) as it:
                    for e in it:
                        if budget <= 0:
                            return newest
                        budget -= 1
                        # Read-only git checks can still update metadata directories (for example
                        # a submodule index). Those writes are tool bookkeeping, not user activity;
                        # counting them would keep a clean disposable checkout "recent" forever
                        # because every disk survey refreshes its own evidence.
                        if e.name in skip_names:
                            continue
                        try:
                            st = e.stat(follow_symlinks=False)
                        except OSError:
                            continue
                        newest = max(newest, st.st_mtime)
                        if access and stat.S_ISREG(st.st_mode) and e.name not in LAYOUT_PROBES:
                            newest = max(newest, st.st_atime)
                        if stat.S_ISDIR(st.st_mode):
                            nxt.append(e.path)
            except OSError:
                pass
        frontier = nxt
    return newest


def item_mtime(fam: Family, path: Path) -> float:
    """An item's last use as survey and apply judge it: its newest mtime near the top, and for SwiftPM scratch
    also its lock, which owned_spm_scratch touches whenever a job links the directory."""
    # Git's index refresh rewrites metadata without using the build output. In
    # the enrolled-account profile that bookkeeping must not extend the cache's
    # reuse window. Active jobs are still protected by process evidence and the
    # git-loss check before deletion.
    skip_names = frozenset(VCS_MARKERS) if (fam.id == "tmp" or RUNNER_CACHE_PROFILE) else frozenset()
    newest = newest_mtime(path, 2 if fam.reclaimable else 1, 3000 if fam.reclaimable else 300,
                          access=fam.discover, skip_names=skip_names)
    if fam.id == SPM_SCRATCH:
        with contextlib.suppress(OSError):
            newest = max(newest, spm_lock(path).stat().st_mtime)
    if fam.id == NIGHTLY_NEXT_FAMILY:
        newest = max(newest, nightly_next_last_use(path))
    return newest


# Files every nightly-next build on a runner rewrites, below its tree (cmux nightly_build_state.py's layout), each
# glob a handful of entries. A build that reuses an identity touches neither the runner nor the identity directory:
# SwiftPM rewrites workspace-state.json when it resolves, and the compilation cache rewrites its action cache and
# index on every lookup (cmux14, 2026-10-27: generic/v1.1/v3.actions and v8.index at the build's end, 5 levels
# down, under directories dated two days earlier).
NIGHTLY_NEXT_USE_GLOBS = ("*/SourcePackages/workspace-state.json", "*/CompilationCache/*/lock",
                          "*/CompilationCache/generic/*/*", "notices-crates", "notices-crates/*")


def nightly_next_last_use(path: Path) -> float:
    """The newest mtime of the files a nightly-next build on this runner writes, however deep."""
    newest = 0.0
    for pattern in NIGHTLY_NEXT_USE_GLOBS:
        with contextlib.suppress(OSError):
            for entry in path.glob(pattern):
                with contextlib.suppress(OSError):
                    newest = max(newest, entry.lstat().st_mtime)
    return newest


class NoEvidence(Exception):
    """Process evidence could not be collected; nothing may be deleted."""


def _owned_query(argv: list[str], timeout: float) -> tuple[int, str]:
    """Run a bounded evidence query whose child can be killed by refresh expiry."""
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, text=True, start_new_session=True)
    _ACTIVE_QUERY_PROCS[proc.pid] = proc
    try:
        output, _ = proc.communicate(timeout=timeout)
        return proc.returncode, output
    except BaseException:
        with contextlib.suppress(OSError):
            os.killpg(proc.pid, signal.SIGKILL)
        with contextlib.suppress(subprocess.TimeoutExpired, OSError):
            proc.communicate(timeout=DU_KILL_GRACE_S)
        raise
    finally:
        _ACTIVE_QUERY_PROCS.pop(proc.pid, None)


def process_evidence() -> tuple[list[str], str]:
    """Every path a process has open (cwd and files) plus all command lines.

    Raises NoEvidence when either source is unavailable, so callers fail closed.
    """
    opened: list[str] = []
    proc = Path("/proc")
    if not DARWIN and proc.is_dir():
        for pid in proc.iterdir():
            if not pid.name.isdigit():
                continue
            try:  # other users' processes are unreadable; that is expected, not a finding
                fds = [pid / "fd" / fd for fd in os.listdir(pid / "fd")]
            except OSError:
                fds = []
            for link in [pid / "cwd", pid / "exe", *fds]:  # exe: a running rustc from a toolchain
                try:
                    opened.append(os.readlink(link))
                except OSError:
                    pass
        if not opened:  # at least this process has a cwd, so empty means /proc is unusable
            raise NoEvidence("/proc showed no open paths")
    else:
        lsof = shutil.which("lsof") or "/usr/sbin/lsof"
        try:
            code, out = _owned_query([lsof, "-n", "-P", "-Fn"], 120)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise NoEvidence(f"lsof: {e}") from e
        if code != 0:
            raise NoEvidence(f"lsof failed (exit {code})")
        opened = [line[1:] for line in out.splitlines() if line.startswith("n/")]
        if not opened:
            raise NoEvidence(f"lsof returned nothing (exit {code})")
    try:
        ps_code, ps_out = _owned_query(["ps", "-axww", "-o", "command="], 60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise NoEvidence(f"ps: {e}") from e
    if ps_code != 0 or not ps_out.strip():
        raise NoEvidence(f"ps failed (exit {ps_code})")
    return opened, command_text(ps_out)


def command_lines() -> str:
    """Current command lines (command_text), or "" when ps fails."""
    try:
        ps = subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return command_text(ps.stdout) if ps.returncode == 0 else ""


# A clone in the runner user's home that a person or agent fetches branch after branch: each shallow fetch
# writes a pack of its own, and git consolidates only at gc.autoPackLimit (50) packs. ~/cmux on
# cmuxs-mac-mini-3 held 23 packs, 35 GiB, that one `git gc` turned into 1.7 GiB (2026-10-21).
HOME_CLONE_GC_FAMILY = "home-clone-gc"
HOME_CLONE_GC_PACKS = 10  # a home clone with this many packs is repacked
HOME_CLONE_GC_IDLE_HOURS = 1.0  # no fetch, checkout, commit or ref update in it or its work trees for this long
HOME_CLONE_GC_WAIT_S = 900.0  # a pass waits this long for its gc; a slower gc runs on and is never killed
# Unreachable objects (no ref, reflog, index or work tree HEAD names them) older than this go: a fetch
# of a branch that only FETCH_HEAD named. Git's own default keeps them two weeks, which would not have
# freed mini-3's 23 packs; "now" would race a writer. A day is far beyond the hour-idle veto.
HOME_CLONE_GC_PRUNE = "1.day.ago"
HOME_CLONE_GC_PID_STALE_S = 12 * 3600  # git itself ignores a gc.pid this old
HOME_CLONE_GC_LOG = HOME / ".cache/glaeda-disk/home-clone-gc.log"
HOME_CLONE_GC_FAILED = HOME / ".cache/glaeda-disk/home-clone-gc-failed.json"  # git dir -> time of its last failed gc
HOME_CLONE_GC_RETRY_S = 24 * 3600
HOME_CLONE_GIT_LOCKS = ("index.lock", "HEAD.lock", "packed-refs.lock", "shallow.lock", "config.lock",
                        "FETCH_HEAD.lock", "ORIG_HEAD.lock", "MERGE_HEAD", "REBASE_HEAD", "rebase-merge",
                        "rebase-apply", "CHERRY_PICK_HEAD", "BISECT_LOG")
HOME_CLONE_ACTIVITY = ("FETCH_HEAD", "index", "HEAD", "ORIG_HEAD", "logs/HEAD", "packed-refs", "shallow",
                       "objects/pack")
HOME_CLONE_REF_BUDGET = 20_000  # entries read below refs/ and logs/refs/ for locks and activity
# A runner's own checkout (_work/<repo>/<repo>) that every job fetches into. cmux's nightly-next step writes
# gc.auto=0 into it and folds packs only on its own runs, so the other jobs' fetches pile up packs that git
# never consolidates: on 2026-10-21 cmux13s-mac-mini's glaeda-2 checkout held 3935 packs, cmux9s 2970, and
# minis sat under the runner gate's 30 GiB floor with ~10 GiB of .git per runner. `git repack -a -d -k -l`
# folds them and keeps unreachable objects (-k): a job can start after the veto, and its fetch's objects are
# unreachable until it moves its refs, so plain -a -d could delete them with the old packs.
RUNNER_CHECKOUT_REPACK_FAMILY = "runner-checkout-repack"
RUNNER_CHECKOUT_REPACK_PACKS = 40  # nightly.yml's own threshold
RUNNER_CHECKOUT_REPACK_IDLE_HOURS = 10 / 60  # busy runners are rarely idle an hour; its job is checked directly


def _git_common_dir(gitdir: Path) -> Path | None:
    """The main clone's git dir of a linked work tree's git dir (<clone>/.git/worktrees/<name>)."""
    with contextlib.suppress(OSError, ValueError):
        common = (gitdir / "commondir").read_text().strip()
        return Path(os.path.normpath(gitdir / common)) if common else None
    return None


def linked_work_trees(gitdir: Path) -> list[Path]:
    """The work trees linked to a clone, from <gitdir>/worktrees/<name>/gitdir (each names <tree>/.git)."""
    trees = []
    with contextlib.suppress(OSError), os.scandir(gitdir / "worktrees") as it:
        for e in it:
            with contextlib.suppress(OSError, ValueError):
                dotgit = Path((Path(e.path) / "gitdir").read_text().strip())
                if dotgit.name == ".git":
                    trees.append(dotgit.parent)
    return trees


def home_clones(home: Path) -> list[tuple[Path, Path]]:
    """(work tree, git dir) of each clone whose work tree sits directly under home: a directory with a
    .git directory, or the main clone of a linked work tree there when that clone is under home too.
    Runner checkouts (~/actions-runner*/_work/...) are never directly under home."""
    try:
        with os.scandir(home) as it:
            dirs = sorted(Path(e.path) for e in it if e.is_dir(follow_symlinks=False))
    except OSError:
        return []
    found: dict[str, tuple[Path, Path]] = {}
    for d in dirs:
        dotgit = d / ".git"
        if dotgit.is_symlink():
            continue
        if dotgit.is_dir():
            gitdir = dotgit
        elif dotgit.is_file():  # a linked work tree: "gitdir: <clone>/.git/worktrees/<name>"
            try:
                text = dotgit.read_text().strip()
            except (OSError, ValueError):
                continue
            if not text.startswith("gitdir:"):
                continue
            common = _git_common_dir(Path(os.path.normpath(d / text.split(":", 1)[1].strip())))
            if common is None:
                continue
            gitdir = common
        else:
            continue
        tree = gitdir.parent
        if (gitdir.name != ".git" or tree.parent != home or tree.is_symlink() or gitdir.is_symlink()
                or not gitdir.is_dir()):
            continue
        found[os.fspath(gitdir)] = (tree, gitdir)
    return list(found.values())


def git_pack_count(gitdir: Path) -> int:
    with contextlib.suppress(OSError):
        return sum(1 for p in (gitdir / "objects/pack").iterdir() if p.suffix == ".pack")
    return 0


def git_object_bytes(gitdir: Path) -> int:
    """Bytes of the clone's object store: packs, loose objects and garbage, as `git count-objects -v` says."""
    git = shutil.which("git") or "git"
    try:
        out = subprocess.run([git, "--git-dir", os.fspath(gitdir), "count-objects", "-v"], capture_output=True,
                             text=True, timeout=120, check=False)
    except (OSError, subprocess.SubprocessError):
        return 0
    kib = 0
    for line in out.stdout.splitlines():
        key, _, value = line.partition(":")
        if key.strip() in ("size", "size-pack", "size-garbage"):
            with contextlib.suppress(ValueError):
                kib += int(value.strip())
    return kib * 1024


def _ref_tree_state(root: Path) -> tuple[float, str] | None:
    """Newest mtime below a refs/ or logs/refs/ tree and the first *.lock in it; None past the budget."""
    newest, budget, stack = 0.0, HOME_CLONE_REF_BUDGET, [os.fspath(root)]
    while stack:
        try:
            with os.scandir(stack.pop()) as it:
                for e in it:
                    budget -= 1
                    if budget < 0:
                        return None
                    if e.name.endswith(".lock"):
                        return newest, e.path
                    with contextlib.suppress(OSError):
                        st = e.stat(follow_symlinks=False)
                        newest = max(newest, st.st_mtime)
                        if stat.S_ISDIR(st.st_mode):
                            stack.append(e.path)
        except FileNotFoundError:
            continue
        except OSError:
            return None
    return newest, ""


def home_clone_gc_veto(tree: Path, gitdir: Path, opened: frozenset[str], cmds: str, now: float,
                       idle_hours: float = HOME_CLONE_GC_IDLE_HOURS) -> str:
    """Why a home clone must not be repacked now, or "" when `git gc` may run on it."""
    trees = [tree, *linked_work_trees(gitdir)]
    gitdirs = [gitdir, *(p for p in (gitdir / "worktrees").glob("*") if p.is_dir() and not p.is_symlink())]
    for t in trees[1:]:  # gc would prune a missing work tree's metadata once old enough; never risk it
        if not (t / ".git").is_file():
            return f"a linked work tree is missing or unreadable: {t}"
    with contextlib.suppress(OSError):
        if now - (gitdir / "gc.pid").lstat().st_mtime < HOME_CLONE_GC_PID_STALE_S:
            return "a git operation holds gc.pid"
    for g in gitdirs:
        for lock in HOME_CLONE_GIT_LOCKS:
            if os.path.lexists(g / lock):
                return f"a git operation holds {lock}"
    with contextlib.suppress(OSError), os.scandir(gitdir / "objects/pack") as it:
        for e in it:
            if e.name.startswith(("tmp_", ".tmp-")):
                return "a git operation is writing a pack"
    newest = 0.0
    for g in gitdirs:
        for name in HOME_CLONE_ACTIVITY:
            with contextlib.suppress(OSError):
                newest = max(newest, (g / name).lstat().st_mtime)
    for root in (gitdir / "refs", gitdir / "logs/refs"):
        state = _ref_tree_state(root)
        if state is None:
            return f"not proven idle ({root.name}/ unreadable or over {HOME_CLONE_REF_BUDGET} entries)"
        newest = max(newest, state[0])
        if state[1]:
            return f"a git operation holds {os.path.relpath(state[1], gitdir)}"
    if (now - newest) / 3600 < idle_hours:
        return f"git activity within {idle_hours:g}h"
    for path in (*trees, gitdir):
        p, resolved = os.fspath(path), os.fspath(path.resolve())
        if in_cwd(p, opened) or in_cwd(resolved, opened):
            return f"open or a working directory of a process: {p}"
        if named_by(p, cmds) or named_by(resolved, cmds):
            return f"named by a running command: {p}"
    return ""


def gc_home_clones(receipt: Path, home: Path | None = None, halt=None) -> int:
    """Repack the home clone with the most packs once it has HOME_CLONE_GC_PACKS of them, when no git
    operation, process or command uses it or its work trees and it saw no git activity for an hour.
    Unreachable objects older than HOME_CLONE_GC_PRUNE go; nothing is deleted by hand. One clone per pass;
    a gc that outlasts HOME_CLONE_GC_WAIT_S keeps running in its own session and is never killed; a gc that
    failed is not retried for HOME_CLONE_GC_RETRY_S."""
    home = HOME if home is None else home
    if not enrolled_runners(home):  # only a CI runner account's home: never a person's or a dev box's clones
        return 0
    clones = [(git_pack_count(g), t, g) for t, g in home_clones(home)]
    clones = sorted((c for c in clones if c[0] >= HOME_CLONE_GC_PACKS), key=lambda c: -c[0])
    return _gc_clones(receipt, clones, HOME_CLONE_GC_FAMILY,
                      lambda tree: ["gc", "--quiet", f"--prune={HOME_CLONE_GC_PRUNE}"],
                      lambda tree, gitdir, index, cmds, now: home_clone_gc_veto(tree, gitdir, index, cmds, now),
                      halt)


def runner_checkout_repack_veto(runner: Path, tree: Path, gitdir: Path, opened: frozenset[str], cmds: str,
                                now: float) -> str:
    """Why a runner's checkout must not be repacked now: its runner runs a job, or home_clone_gc_veto's
    reasons with RUNNER_CHECKOUT_REPACK_IDLE_HOURS of git quiet."""
    if why := runner_job_live(runner, cmds):
        return why
    return home_clone_gc_veto(tree, gitdir, opened, cmds, now, idle_hours=RUNNER_CHECKOUT_REPACK_IDLE_HOURS)


def repack_runner_checkouts(receipt: Path, home: Path | None = None, halt=None) -> int:
    """Fold the packs of the runner checkout with the most of them once it has RUNNER_CHECKOUT_REPACK_PACKS,
    when its runner runs no job and nothing uses it: `git repack -a -d -k -l`, which keeps every object. One
    per pass, with gc_home_clones' slow-run and failure rules; with a home clone gc in the same pass, the pass
    can wait up to twice HOME_CLONE_GC_WAIT_S."""
    home = HOME if home is None else home
    runner_of: dict[str, Path] = {}
    clones = []
    for runner in enrolled_runners(home):
        work = runner / "_work"
        if work.is_symlink() or not work.is_dir():
            continue
        for tree in runner_checkouts(work):
            packs = git_pack_count(tree / ".git")
            if packs >= RUNNER_CHECKOUT_REPACK_PACKS:
                runner_of[os.fspath(tree)] = runner
                clones.append((packs, tree, tree / ".git"))
    clones.sort(key=lambda c: -c[0])
    return _gc_clones(receipt, clones, RUNNER_CHECKOUT_REPACK_FAMILY,
                      lambda tree: ["repack", "-a", "-d", "-k", "-l", "-q"],
                      lambda tree, gitdir, index, cmds, now: runner_checkout_repack_veto(
                          runner_of[os.fspath(tree)], tree, gitdir, index, cmds, now),
                      halt)


def _gc_clones(receipt: Path, clones: list[tuple[int, Path, Path]], family: str, git_args, veto, halt) -> int:
    """Run `git <git_args(tree)>` on the first of clones (packs, tree, git dir) that veto clears."""
    if not clones:
        return 0
    if halt is not None and (why := halt()):
        return 0
    try:
        opened, cmds = process_evidence()
    except NoEvidence as e:
        print(f"refusing to {family}: {e}", file=sys.stderr)
        return 0
    index = open_index(opened)
    failed: dict[str, float] = {}
    with contextlib.suppress(OSError, ValueError, AttributeError):
        failed = {k: float(v) for k, v in json.loads(HOME_CLONE_GC_FAILED.read_text()).items()}
    released = 0
    for packs, tree, gitdir in clones:
        why = veto(tree, gitdir, index, cmds, time.time())
        if not why and time.time() - failed.get(os.fspath(gitdir), 0.0) < HOME_CLONE_GC_RETRY_S:
            why = f"its last gc failed within {HOME_CLONE_GC_RETRY_S // 3600}h"
        rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(), "family": family,
               "path": os.fspath(tree), "packs": packs}
        if not why:  # lsof can take minutes: judge again on fresh evidence right before git starts
            try:
                opened, cmds = process_evidence()
            except NoEvidence as e:
                print(f"refusing to {family}: {e}", file=sys.stderr)
                break
            index = open_index(opened)
            why = veto(tree, gitdir, index, cmds, time.time())
        if why:
            rec.update(outcome="changed:in-use", verdict="blocked", reasons=[why], bytes=0)
        else:
            before = git_object_bytes(gitdir)
            git = shutil.which("git") or "git"
            nice = shutil.which("nice")
            argv = [*([nice, "-n", "15"] if nice else []), git, "-c", "gc.worktreePruneExpire=never",
                    "-C", os.fspath(tree), *git_args(tree)]
            proc = None
            try:
                HOME_CLONE_GC_LOG.parent.mkdir(parents=True, exist_ok=True)
                with HOME_CLONE_GC_LOG.open("a") as log:
                    log.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {' '.join(argv)}\n")
                    log.flush()
                    # its own session: the pass's timers and group kills never reach a running gc
                    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                            start_new_session=True)
            except OSError as e:
                rec.update(outcome=f"incomplete:{e.__class__.__name__}", bytes=0)
            if proc is not None:
                try:
                    code = proc.wait(timeout=HOME_CLONE_GC_WAIT_S)
                except subprocess.TimeoutExpired:
                    rec.update(outcome="running", pid=proc.pid, bytes=0)
                else:
                    size = max(0, before - git_object_bytes(gitdir)) if code == 0 else 0
                    released += size
                    rec.update(outcome="reclaimed" if code == 0 else f"failed:exit-{code}", bytes=size,
                               packs_after=git_pack_count(gitdir))
                    if code == 0:
                        print(f"  reclaimed {gib(size).strip():>8s}  {tree} (git {git_args(tree)[0]} of {packs} packs)")
            rec.update(verdict={"reclaimed": "reclaimable", "running": "running"}.get(rec["outcome"], "failed"),
                       reasons=[f"{packs} packs"] + (["no git activity or process"] if rec["outcome"] == "reclaimed"
                                                     else [f"gc {rec['outcome']}"]))
            if rec["verdict"] == "failed":  # an unchanged clone would otherwise be retried every pass
                failed[os.fspath(gitdir)] = time.time()
                with contextlib.suppress(OSError):
                    HOME_CLONE_GC_FAILED.parent.mkdir(parents=True, exist_ok=True)
                    HOME_CLONE_GC_FAILED.write_text(json.dumps(failed))
        with contextlib.suppress(OSError), receipt.open("a") as f:  # a lost receipt line must not stop the pass
            f.write(json.dumps(rec) + "\n")
        if not why:
            break  # one gc per pass
    return released


def cleanup_paused_runner_work(receipt: Path) -> int:
    """Clear only disposable ``_work/cmux`` trees for explicitly held, idle runners.

    A runner-held marker is the drain path's ownership signal.  We additionally require that
    neither its Listener nor Worker is present and that process evidence cannot name the tree.
    This keeps a service outage or an active job from turning a routine pressure pass into a
    destructive cleanup.
    """
    held_root = HOME / RUNNER_HELD_DIR
    if not held_root.is_dir():
        return 0
    try:
        opened, commands = process_evidence()
    except NoEvidence:
        return 0
    opened = open_index(opened)
    released = 0
    for runner in sorted(HOME.glob("actions-runner*")):
        if not (runner / ".runner").is_file() or not (runner / "glaeda-hooks").is_dir():
            continue
        if not (held_root / runner.name).is_file():
            continue
        root = runner / "_work/cmux"
        if not root.is_dir() or in_cwd(os.fspath(root), opened) or named_by(os.fspath(root), commands):
            continue
        if cmux_active(root):
            continue
        prefix = re.escape(os.fspath(runner))
        if re.search(prefix + r"/bin/Runner\.(?:Listener|Worker)(?:\s|$)", commands):
            continue
        size = du_bytes(root)
        if size is None:
            continue
        try:
            remove(root)
        except OSError:
            continue
        rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(),
               "outcome": "reclaimed", "family": "paused-runner-work", "path": os.fspath(root),
               "bytes": size, "verdict": "reclaimable", "reasons": ["runner-held", "listener-idle"]}
        with receipt.open("a") as f:
            f.write(json.dumps(rec) + "\n")
        print(f"  reclaimed {gib(size).strip():>8s}  {root}")
        released += size
    return released


def command_text(ps_output: str) -> str:
    """Command lines with repeated slashes collapsed: $TMPDIR ends in a slash, so a script's
    "$TMPDIR/x" reads .../T//x, which would not match the path it names."""
    return re.sub(r"/{2,}", "/", ps_output)


def spellings(path: str) -> list[str]:
    """The same location as processes may name it (macOS /tmp and /var are symlinks into /private)."""
    out = [path]
    for real, alias in (("/private/tmp", "/tmp"), ("/private/var", "/var"), ("/private/etc", "/etc")):
        if path == real or path.startswith(real + "/"):
            out.append(alias + path[len(real):])
    return out


def named_by(path: str, cmds: str) -> bool:
    for spelling in spellings(path):
        if spelling in cmds and re.search(
                re.escape(spelling) + r"(?=$|[/\s'\"=:,;)\]])", cmds, re.M):
            return True
    return False


def open_index(opened: list[str]) -> frozenset[str]:
    """Every opened path and all its ancestors, so in_cwd is one lookup per spelling instead of a
    scan of every open file (lsof lists tens of thousands; the scan cost ~1 min per survey)."""
    out: set[str] = set()
    for o in opened:
        while o and o not in out:  # an ancestor already present has all of its own ancestors too
            out.add(o)
            o = o.rpartition("/")[0]
    return frozenset(out)


def in_cwd(path: str, opened: list[str] | frozenset[str]) -> bool:
    """True when any process has its cwd or an open file inside path."""
    index = opened if isinstance(opened, frozenset) else open_index(opened)
    return any(sp in index for sp in spellings(path))


def claude_config_dirs() -> list[Path]:
    """~/.claude plus alternate config dirs (~/.claude-<account>, $CLAUDE_CONFIG_DIR)."""
    dirs = [HOME / ".claude", *sorted(HOME.glob(".claude-*"))]
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        dirs.append(Path(os.environ["CLAUDE_CONFIG_DIR"]))
    return [d for d in dirs if d.is_dir()]


def claude_session_active(session_id: str, idle_s: float) -> bool:
    for config in claude_config_dirs():
        for transcript in (config / "projects").glob(f"*/{session_id}.jsonl"):
            try:
                if time.time() - transcript.stat().st_mtime < idle_s:
                    return True
            except OSError:
                continue
    return False


DELETING_PREFIX = ".glaeda-disk-deleting-"  # remove() renames a tree to this before deleting it
DELETING_RE = re.compile(re.escape(DELETING_PREFIX) + r".+-([0-9]+)")  # ...<name>-<pid of the deleter>


def derived_data(fam: Family, path: Path) -> bool:
    """Build output despite git inside: Xcode DerivedData (SourcePackages holds clones), and a tree
    remove() had already renamed aside when it was interrupted, which is only ever reclaimed. Neither
    is searched for git. A tool's own cache is searched, but git_state does not enter its sealed parts."""
    return bool(fam.build_output
            or DELETING_RE.fullmatch(path.name)
            or (fam.id == "cmux-job-cache" and (path.name == "DerivedData" or path.parent.name == "SourcePackages")))


def mirror_due(fam: Family, path: Path, idle_hours: float) -> bool:
    """A mirror family's item idle past its mirror age: it goes once archive_mirror has bundled what is unpushed."""
    return (fam.mirror_idle_hours is not None and idle_hours >= fam.mirror_idle_hours
            and not derived_data(fam, path))


def git_exempt(fam: Family, path: Path, idle_hours: float) -> bool:
    """No git check applies: build output (derived_data), or a mirror (mirror_due), whose apply bundles first."""
    return derived_data(fam, path) or mirror_due(fam, path, idle_hours)


# A deletion interrupted after remove()'s rename (the process killed, the host rebooted) leaves the tree under
# DELETING_PREFIX<name>-<pid>. No family lists it (cmux-kept-build includes only its own names), so 9.3 GiB
# on cmux8s and 7.8 GiB on cmuxs-mac-mini-3 sat there for days (2026-10-11). Once its pid is gone, the
# interrupted-deletions family finishes it in place.
INTERRUPTED = "interrupted-deletions"


def deleting_pid(name: str) -> int | None:
    m = DELETING_RE.fullmatch(name)
    return int(m.group(1)) if m else None


def deletion_owner_live(path: Path) -> str:
    """Why an aside tree is still being deleted, or "": its pid runs glaeda-disk (or cannot be read).
    A reused pid running anything else does not hold it."""
    pid = deleting_pid(path.name)
    if pid is None or pid <= 0:
        return ""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return ""
    except OSError:
        pass  # another user's live process
    command = _owner_command(pid)
    if not command or "glaeda-disk" in command:
        return f"glaeda-disk (pid {pid}) is still deleting it"
    return ""


def interrupted_families(fams: list[Family]) -> list[Family]:
    """One family per directory that holds an aside tree a family's remove() left: the directories its
    candidates sit in. Built only where such a tree exists, so the usual pass reads nothing more than one
    listing per directory."""
    parents: dict[str, Family] = {}
    for fam in fams:
        if not fam.reclaimable or fam.id == INTERRUPTED:
            continue
        dirs = {fam.root}
        if fam.id == CMUX_NEXT_CI_FAMILY:  # a whole state set aside leaves no candidate where it sat
            dirs.update(cmux_next_ci_state_parents(fam.root))
            dirs.update(cmux_next_ci_host_parents(fam.root))
        if fam.discover or fam.checkout_builds:
            dirs.update(p.parent for p in candidates(fam))
        else:  # a match family's candidates sit within depth levels too: an aside one left no candidate behind
            level = [fam.root]
            for _ in range(fam.depth - 1):
                level = [Path(e.path) for p in level for e in _entries(p)
                         if e.name not in fam.skip and not DELETING_RE.fullmatch(e.name)
                         and e.is_dir(follow_symlinks=False)]
                dirs.update(level)
        for d in dirs:
            if os.fspath(d) in parents:
                continue
            if any(DELETING_RE.fullmatch(e.name) for e in _entries(d)):
                parents[os.fspath(d)] = Family(
                    INTERRUPTED, d, True, "nothing: a deletion glaeda-disk started and did not finish",
                    files=True, include=(DELETING_PREFIX,), build_output=True, min_bytes=0,
                    max_idle_hours=0.0, owner="glaeda-disk remove()", rebuild_minutes=0.1,
                    allow_stale_protected=fam.allow_stale_protected, platform=fam.platform)
    return [parents[k] for k in sorted(parents)]


def finish_deletion(path: Path) -> None:
    """Delete an aside tree in place: it already has its deleting name, so a second rename adds nothing."""
    if toolchain_held(path, fresh=True):
        raise OSError("refusing the job toolchain (toolchain_keep)")
    if path.is_symlink():
        raise OSError("refusing symlink")
    if os.path.ismount(path) or path.lstat().st_dev != path.parent.stat().st_dev:
        raise OSError("refusing a mount point")
    if not DELETING_RE.fullmatch(path.name):
        raise OSError("refusing a tree without the deleting name")
    if os.path.lexists(mirror_keep_marker(path)):
        raise OSError("refusing a tree glaeda-disk kept: its git work changed after bundling")
    if path.is_dir():
        shutil.rmtree(path, onerror=_chmod_retry)
    else:
        path.unlink()


# Cache layouts, recognized by what a tool writes rather than by a directory's name. A tree that
# matches one is "sealed": the tool alone writes below its top level (content-addressed blobs,
# unpacked downloads, fetched clones), so git_state checks only that top level and the one below it,
# where a person's clone would sit, instead of walking millions of files it cannot finish (the Go build
# cache held 18 GiB and far more than the 20000-entry budget on Air Blue, 2026-09-27). Anything else is
# searched in full and stays "unchecked" when the search cannot finish. Sealing only shortens the git
# search in families whose items are caches by where they sit; a layout is never enough to delete
# something on its own except in discovery, and only for DISCOVERABLE layouts.
CACHEDIR_TAG = b"Signature: 8a477f597d28d172789f06886806bc55"  # https://bford.info/cachedir/
# Chromium's blockfile cache index starts with kIndexMagic 0xC103CAC3, little endian.
CHROMIUM_INDEX_MAGIC = b"\xc3\xca\x03\xc1"
CHROMIUM_SIMPLE_ENTRY = re.compile(r"[0-9a-f]{16}_[0-9s]")
HEX_SHARD = re.compile(r"[0-9a-f]{1,2}")
BUN_ENTRY = re.compile(r".+@[^@/]*@@@[0-9]+")  # bun's install cache: <name>@<version>@@@<n>
MD5_NAME = re.compile(r"[0-9a-f]{32}")
# Version-control state: a directory holding one is a checkout, never a cache and never searched past.
VCS_MARKERS = (".git", ".jj", ".hg", ".sl", ".svn")
SEALED_BUDGET = 500_000  # entries git_state reads at the tops of sealed caches, per call
LAYOUT_LISTING = 4096  # entries a layout test reads from one directory
SHARD_SAMPLE = 16  # entries sampled from each of the first four shards; all must be blobs or shards
# Files a layout test reads. Reading moves their access time (Linux relatime), so the LRU scan
# (newest_mtime with access) ignores their atime or every recognized cache would look just used.
LAYOUT_PROBES = frozenset({"CACHEDIR.TAG", "index"})


def _is_file(p: str) -> bool:
    return os.path.isfile(p) and not os.path.islink(p)


def _is_dir(p: str) -> bool:
    return os.path.isdir(p) and not os.path.islink(p)


def _head(p: str, n: int) -> bytes:
    """The first n bytes of a regular file, or b"". Never opens a FIFO or device, which could block."""
    try:
        st = os.lstat(p)
        if not stat.S_ISREG(st.st_mode):
            return b""
        fd = os.open(p, os.O_RDONLY | getattr(os, "O_NOATIME", 0) | getattr(os, "O_NONBLOCK", 0))
    except OSError:
        return b""
    try:
        return os.read(fd, n)
    except OSError:
        return b""
    finally:
        os.close(fd)


def _listing(d: str, limit: int = LAYOUT_LISTING, partial: bool = False) -> list[os.DirEntry] | None:
    """Up to `limit` entries of d, or None when d is unreadable or, unless `partial`, holds more."""
    out: list[os.DirEntry] = []
    try:
        with os.scandir(d) as it:
            for e in it:
                if len(out) >= limit:
                    return out if partial else None
                out.append(e)
    except OSError:
        return None
    return out


def vcs_at(d: str) -> bool:
    return any(os.path.lexists(os.path.join(d, m)) for m in VCS_MARKERS) or looks_like_repository(d)


def _hash_sharded(d: str, entries: list[os.DirEntry]) -> bool:
    """A content-addressed store: at least 16 entries, nine in ten of them 1-2 hex digit shard
    directories of one width with some a-f (Go's build cache, pip's http cache, ccache), and the sampled
    contents of the first shards all blobs or deeper shards. A git objects directory looks the same; it
    is never judged here, since git_state and discovery stop at the repository around it."""
    if len(entries) < 16 or os.path.basename(d) == "objects" or looks_like_repository(os.path.dirname(d)):
        return False
    shards = [e for e in entries if HEX_SHARD.fullmatch(e.name) and e.is_dir(follow_symlinks=False)]
    # one width, and some a-f: numbered directories (Maven's 10..35 versions) are not hex shards
    if (len(shards) * 10 < len(entries) * 9 or len({len(e.name) for e in shards}) != 1
            or not any(re.search("[a-f]", e.name) for e in shards)):
        return False
    for shard in sorted(shards, key=lambda e: e.name)[:4]:
        inner = _listing(shard.path, SHARD_SAMPLE, partial=True)
        if inner is None:
            return False
        for e in inner:
            # blobs, or deeper shards (pip's http cache nests a/b/c/d/e/<hash>)
            if not (e.is_file(follow_symlinks=False)
                    or (e.is_dir(follow_symlinks=False) and HEX_SHARD.fullmatch(e.name))):
                return False
    return True


def _chromium_cache(d: str) -> bool:
    """A Chromium disk cache: the simple cache (index-dir/the-real-index beside <16 hex>_0 entries) or
    the blockfile cache (an index carrying Chromium's magic, and data_0 to data_3). An index and a data_0
    alone are any dataset's names."""
    if _is_file(os.path.join(d, "index-dir", "the-real-index")):
        return any(CHROMIUM_SIMPLE_ENTRY.fullmatch(e.name) for e in _listing(d, 64, partial=True) or [])
    return (_head(os.path.join(d, "index"), 4) == CHROMIUM_INDEX_MAGIC
            and all(_is_file(os.path.join(d, f"data_{i}")) for i in range(4)))


def stat_layout(d: str) -> str:
    """The layout d matches by a few files a tool writes at its top, or "" (see listing_layout)."""
    if _head(os.path.join(d, "CACHEDIR.TAG"), len(CACHEDIR_TAG)) == CACHEDIR_TAG:
        return "cachedir-tag"  # cargo's registry, uv, Gradle and others declare their caches so
    j = lambda *parts: os.path.join(d, *parts)  # noqa: E731
    if _is_dir(j("index-v5")) and _is_dir(j("content-v2")):
        return "npm-cacache"
    if _is_file(j("lib", "rustlib", "multirust-channel-manifest.toml")) and _is_file(j("lib", "rustlib", "components")):
        return "rustup-toolchain"
    if _is_dir(j("cache", "download")) and _is_file(j("cache", "lock")):
        return "go-module-cache"
    if _chromium_cache(d):
        return "chromium-disk-cache"
    return ""


def listing_layout(d: str, entries: list[os.DirEntry]) -> str:
    """The layout d matches by the names of its entries, or ""."""
    if _hash_sharded(d, entries):
        return "hash-sharded-store"
    names = [e.name for e in entries]
    bun = sum(1 for n in names if BUN_ENTRY.fullmatch(n))
    if bun >= 8 and bun * 2 >= sum(1 for n in names if not n.startswith((".", "@"))):
        return "bun-install-cache"
    # Bazel's output user root: install/ plus md5-named output bases (~/.cache/bazel/_bazel_$USER),
    # each holding bazel's own server/, execroot/ or external/
    if "install" in names and any(
            MD5_NAME.fullmatch(e.name) and e.is_dir(follow_symlinks=False)
            and any(_is_dir(os.path.join(e.path, n)) for n in ("server", "execroot", "external"))
            for e in entries):
        return "bazel-output-root"
    return ""


def cache_layout(path: Path | str) -> str:
    """The cache layout a directory matches, or "": never a checkout or repository itself."""
    d = os.fspath(path)
    if not _is_dir(d) or vcs_at(d):
        return ""
    if (found := stat_layout(d)):
        return found
    entries = _listing(d)
    return listing_layout(d, entries) if entries is not None else ""


REPRODUCIBLE_DIRS = frozenset({"node_modules", ".build", "DerivedData", "target", ".venv",
                               "__pycache__", ".gradle", "Pods"})


# Never searched by discover_caches, relative to the home directory: secrets and credentials,
# keychains (under Library), the roots other families own (~/.cache, ~/Library/Caches, ~/Projects), the
# folders macOS guards with a privacy prompt, which a LaunchAgent must not trip and which hold no tool's
# cache, and installed environments that carry a CACHEDIR.TAG without being recreatable (uv tags every
# venv and tool environment it makes; pipx and virtualenvwrapper keep installs). SECRET_NAME drops any
# directory named like a credential store at any depth.
HOME_NEVER = (".ssh", ".gnupg", ".secrets", ".aws", ".azure", ".kube", ".docker", ".password-store",
              ".config/gh", ".local/share/keyrings", ".local/share/uv", ".local/share/pipx",
              ".local/pipx", ".virtualenvs", ".pyenv", ".conda", "miniconda3", "anaconda3",
              ".cache", ".Trash", "Library", "Projects",
              "Desktop", "Documents", "Downloads", "Movies", "Music", "Pictures", "Public", "Applications")
SECRET_NAME = re.compile(r"secret|credential|token|keychain|keyring|password", re.I)
# a project's package and build directories belong to it, not to a tool; ~/.gradle is Gradle's own home
DISCOVER_SKIP = (REPRODUCIBLE_DIRS - {".gradle"}) | {".direnv", "venv", "env"} | set(VCS_MARKERS)
# What discovery may delete. A CACHEDIR.TAG only says "do not back this up": uv writes one into every
# venv, direnv into .direnv. So a tagged directory counts only when its tag names a tool that refetches
# it (TAG_CREATORS) and it holds no Python environment. A hex-sharded store never counts on its own: a
# backup repository (restic's data/) or an app's only copy of its blobs looks the same. A Chromium disk
# cache sits inside a browser profile, which the browser owns.
DISCOVERABLE = ("cachedir-tag", "npm-cacache", "rustup-toolchain", "go-module-cache", "bun-install-cache",
                "bazel-output-root")
TAG_CREATORS = re.compile(rb"^# This file is a cache directory tag created by (cargo|Gradle)\.?\s*$", re.M)
DISCOVER_DEPTH = 5  # deep enough for ~/.rustup/toolchains/<tc>, ~/go/pkg/mod, ~/.bun/install/cache
DISCOVER_BUDGET = 8000  # entries read below each top-level home directory
DISCOVER_SECONDS = 30.0  # and the whole discovery stops after this long; it only ever misses caches


def discoverable(d: str) -> str:
    """The layout that lets discovery delete d, or ""."""
    layout = cache_layout(d)
    if layout not in DISCOVERABLE:
        return ""
    if os.path.lexists(os.path.join(d, "pyvenv.cfg")) or os.path.lexists(os.path.join(d, "conda-meta")):
        return ""
    if layout == "cachedir-tag" and not TAG_CREATORS.search(_head(os.path.join(d, "CACHEDIR.TAG"), 512)):
        return ""
    # cargo tags its target directory too; one outside a project (CARGO_TARGET_DIR) is a build, not the
    # registry or git cache cargo refetches
    if layout == "cachedir-tag" and any(os.path.lexists(os.path.join(d, n))
                                        for n in ("release", "debug", ".rustc_info.json")):
        return ""
    return layout


def discover_caches(root: Path, depth: int = DISCOVER_DEPTH, budget: int = DISCOVER_BUDGET,
                    seconds: float = DISCOVER_SECONDS) -> list[Path]:
    """Every discoverable cache (discoverable) up to `depth` levels below root, outermost only.

    Never entered: symlinks, other filesystems, HOME_NEVER, credential-named directories, the Chromium
    trees (never_delete), a checkout or repository of any VCS, Python environments, and package or
    build-output directories (they belong to the project around them). Each top-level directory gets its
    own `budget` of entries and the whole walk stops after `seconds`, so one huge tree can hide caches,
    never delete anything. The deadline is checked between directories: it cannot interrupt one syscall
    hung on a dead network mount (st_dev keeps discovery off other filesystems, but the first lstat of
    the mount point itself can still block).
    """
    never = {os.path.realpath(root / n) for n in HOME_NEVER}
    deadline = time.monotonic() + seconds
    try:
        dev = root.stat().st_dev
    except OSError:
        return []
    found: list[Path] = []
    for top in _entries(root):
        if not top.is_dir(follow_symlinks=False):
            continue
        left = budget
        level = [top.path]
        for _ in range(depth):
            nxt: list[str] = []
            for d in level:
                if time.monotonic() > deadline:
                    return found
                name = os.path.basename(d)
                try:
                    other_fs = os.lstat(d).st_dev != dev
                except OSError:
                    continue
                if (other_fs or os.path.realpath(d) in never or SECRET_NAME.search(name)
                        or name in DISCOVER_SKIP or never_delete(Path(d), walk=True) or vcs_at(d)
                        or os.path.lexists(os.path.join(d, "pyvenv.cfg"))):
                    continue
                if stat_layout(d):
                    if discoverable(d) and not toolchain_held(Path(d)):
                        found.append(Path(d))
                    continue  # a sealed cache discovery may not take is not searched either
                entries: list[os.DirEntry] = []
                try:
                    with os.scandir(d) as it:
                        for e in it:
                            left -= 1
                            if left < 0:
                                break
                            entries.append(e)
                except OSError:
                    continue
                if left < 0:
                    break  # a partial listing can hide a layout, never invent one: stop here
                if listing_layout(d, entries):
                    if discoverable(d) and not toolchain_held(Path(d)):
                        found.append(Path(d))
                    continue
                nxt += [e.path for e in entries if e.is_dir(follow_symlinks=False)]
            if left < 0:
                break
            level = nxt
    return found


def _toolchain_pins(projects: Path, budget: int = 2000) -> set[str]:
    """Toolchains a checkout pins (rust-toolchain.toml `channel`, or a legacy rust-toolchain file), in
    ~/Projects/* and one level into its worktree directories, reading at most `budget` entries."""
    pins: set[str] = set()
    dirs: list[Path] = []
    for c in _children(projects)[:budget]:
        if c.is_dir() and not c.is_symlink():
            dirs.append(c)
            if c.name in WORKTREE_DIRS or c.name.endswith("-worktrees"):
                dirs += [w for w in _children(c)[:budget] if w.is_dir() and not w.is_symlink()]
    for d in dirs[:budget]:
        for f in ("rust-toolchain.toml", "rust-toolchain"):
            text = _head(os.fspath(d / f), 4096).decode(errors="replace")
            if not text:
                continue
            m = re.search(r'^\s*channel\s*=\s*"([^"]+)"', text, re.M)
            if m:
                pins.add(m.group(1))
            elif f == "rust-toolchain" and text.strip() and "\n" not in text.strip() and "[" not in text:
                pins.add(text.strip())
            break
    return pins


def rustup_verdict(path: Path) -> str:
    """Why a rustup toolchain stays whatever its age, or "". Only rustup puts one back, so a toolchain
    goes only from a rustup home (settings.toml beside toolchains/) whose rustup binary exists, and
    never one that something names: the default, a directory override, $RUSTUP_TOOLCHAIN, or a
    rust-toolchain file of a checkout under ~/Projects."""
    home = path.parent.parent
    settings = home / "settings.toml"
    if path.parent.name != "toolchains" or not settings.is_file():
        return "a toolchain outside a rustup home"
    cargo_home = Path(os.environ.get("CARGO_HOME") or HOME / ".cargo")
    if not (shutil.which("rustup") or (cargo_home / "bin/rustup").is_file() or (home.parent / ".cargo/bin/rustup").is_file()):
        return "rustup is not installed to reinstall it"
    try:
        text = settings.read_text()
    except OSError:
        return "unreadable rustup settings"
    pinned = set()
    for m in re.finditer(r'^\s*default_toolchain\s*=\s*"([^"]+)"', text, re.M):
        pinned.add(m.group(1))
    overrides = text.partition("[overrides]")[2]
    for m in re.finditer(r'=\s*"([^"]+)"', overrides):
        pinned.add(m.group(1))
    if os.environ.get("RUSTUP_TOOLCHAIN"):
        pinned.add(os.environ["RUSTUP_TOOLCHAIN"])
    pinned |= _toolchain_pins(HOME / "Projects")
    for tc in pinned:
        if path.name == tc or path.name.startswith(tc + "-"):
            return "a pinned toolchain (default, override, RUSTUP_TOOLCHAIN or rust-toolchain file)"
    return ""


def keep_verdict(fam: "Family", path: Path) -> str:
    """Why a candidate stays whatever its age, or ""."""
    if fam.id == "cmux-seeds":
        return seed_verdict(path)
    if fam.id == INTERRUPTED:
        if os.path.lexists(mirror_keep_marker(path)):
            return "glaeda-disk kept it: its git work changed after bundling"
        return deletion_owner_live(path)
    if fam.discover and stat_layout(os.fspath(path)) == "rustup-toolchain":
        return rustup_verdict(path)
    if fam.checkout_builds and path.parent.name == "cache" and path.parent.parent.name == "apple-build":
        return apple_build_verdict(path)
    return ""


def git_state(path: Path, depth: int = 5, budget: int = 20000, sealed: bool = False) -> str:
    """"git" when version-control state (VCS_MARKERS) exists up to `depth` levels down, "none" when the
    whole tree was searched without finding one, "unchecked" when the search could not finish.

    A clone inside a scratch directory can hold unpushed commits, so callers treat "unchecked"
    like "git" (fail closed); so is any read error other than an entry vanishing, and another
    filesystem mounted inside (a deletion would descend into it). Package and build-output directories
    are only checked for version control of their own, not searched. With `sealed` (families whose items
    are caches by where they sit), a sealed cache (stat_layout, listing_layout), at path or anywhere in
    the walk, is checked at its top level and the one below, where a person's clone would sit, and not
    entered further; a hex-sharded store is read in full, but only as blobs, and a directory in a shard
    is walked as usual. Every entry read counts against `budget`, or for sealed caches SEALED_BUDGET.
    """
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return "none"
    except OSError:
        return "unchecked"
    if not stat.S_ISDIR(st.st_mode):
        return "none"  # a file (a leaked library in the temp dir) holds no checkout
    dev = st.st_dev
    sealed_left = SEALED_BUDGET

    def mounted(e: os.DirEntry) -> bool:
        try:
            return e.stat(follow_symlinks=False).st_dev != dev
        except FileNotFoundError:
            return False
        except OSError:
            return True

    def listing(d: str, sealed_budget: bool) -> list[os.DirEntry] | str:
        """d's entries, or "git" / "unchecked" / "gone"."""
        nonlocal budget, sealed_left
        out: list[os.DirEntry] = []
        try:
            with os.scandir(d) as it:
                for e in it:
                    if sealed_budget:
                        sealed_left -= 1
                        if sealed_left < 0:
                            return "unchecked"
                    else:
                        budget -= 1
                        if budget < 0:
                            return "unchecked"
                    if e.name in VCS_MARKERS or (e.name == "HEAD" and looks_like_repository(d)):
                        return "git"  # a bare repository holds commits just like a checkout
                    out.append(e)
        except (FileNotFoundError, NotADirectoryError):
            return "gone"  # vanished, or replaced by a file, since it was listed
        except OSError:
            return "unchecked"  # EIO, ESTALE, EACCES: not evidence that nothing is there
        return out

    frontier = [str(path)]
    for _ in range(depth + 1):
        nxt: list[str] = []
        for d in frontier:
            if sealed and stat_layout(d) and not vcs_at(d):
                entries = listing(d, True)
                if isinstance(entries, str):
                    if entries == "gone":
                        continue
                    return entries
                for e in entries:
                    if e.is_dir(follow_symlinks=False) and (mounted(e) or vcs_at(e.path)):
                        return "unchecked" if mounted(e) else "git"
                continue
            entries = listing(d, False)
            if isinstance(entries, str):
                if entries == "gone":
                    continue
                return entries
            dirs = [e for e in entries if e.is_dir(follow_symlinks=False)]
            if any(mounted(e) for e in dirs):
                return "unchecked"
            layout = listing_layout(d, entries) if sealed else ""
            if layout == "hash-sharded-store":
                # blobs are cheap to list and the shards were only sampled: read every shard (on the
                # sealed budget) and walk anything in one that is neither a blob nor a deeper shard
                stack = [e.path for e in dirs if HEX_SHARD.fullmatch(e.name)]
                dirs = [e for e in dirs if not HEX_SHARD.fullmatch(e.name)]
                while stack:
                    inner = listing(stack.pop(), True)
                    if isinstance(inner, str):
                        if inner == "gone":
                            continue
                        return inner
                    for e in inner:
                        if e.is_dir(follow_symlinks=False):
                            if mounted(e):
                                return "unchecked"
                            if HEX_SHARD.fullmatch(e.name):
                                stack.append(e.path)
                            else:
                                dirs.append(e)
            elif layout:
                # sealed: its entries were just read; a clone one level below its top is the last look
                if any(vcs_at(e.path) for e in dirs):
                    return "git"
                continue
            for e in dirs:
                if e.name in REPRODUCIBLE_DIRS:
                    if vcs_at(e.path):
                        return "git"  # e.g. `git clone x target`; not searched deeper
                else:
                    nxt.append(e.path)
        frontier = nxt
    return "unchecked" if frontier else "none"


def looks_like_repository(d: str) -> bool:
    """A bare repository or a copied git dir: no .git entry of its own, but HEAD, objects and refs."""
    return (os.path.isfile(os.path.join(d, "HEAD")) and os.path.isdir(os.path.join(d, "objects"))
            and os.path.isdir(os.path.join(d, "refs")))


def checkouts(path: Path, depth: int = 5, budget: int = 20000, strict: bool = False) -> list[Path] | None:
    """Every checkout (a directory holding .git) or bare repository up to `depth` levels below
    path, not searching inside one; None when the search could not finish (with strict, also when any
    directory could not be read)."""
    found: list[Path] = []
    frontier = [str(path)]
    for _ in range(depth + 1):
        nxt: list[str] = []
        for d in frontier:
            if os.path.lexists(os.path.join(d, ".git")) or looks_like_repository(d):
                found.append(Path(d))
                continue
            try:
                with os.scandir(d) as it:
                    for e in it:
                        budget -= 1
                        if budget < 0:
                            return None
                        if e.is_dir(follow_symlinks=False):
                            if e.name not in REPRODUCIBLE_DIRS:
                                nxt.append(e.path)
                            elif os.path.lexists(os.path.join(e.path, ".git")) or looks_like_repository(e.path):
                                found.append(Path(e.path))  # as git_state: not searched deeper
            except PermissionError:
                return None
            except OSError:
                if strict:
                    return None
        frontier = nxt
    return None if frontier else found


_NESTED_WALKS: dict[str, list[Path] | None] = {}  # one walk per item per survey or apply pass


def nested_checkouts(path: Path) -> list[Path] | None:
    key = str(path)
    if key not in _NESTED_WALKS:
        _NESTED_WALKS[key] = checkouts(path, NESTED_DEPTH, NESTED_BUDGET)
    return _NESTED_WALKS[key]


def family_git_state(fam: "Family", path: Path) -> str:
    """git_state, or for a nested_git family the full-depth checkout search."""
    if not fam.nested_git:
        # a family whose items are caches by where they sit may skip their sealed parts; one that deletes
        # disposable checkouts (tmp, scratch) searches everything
        return git_state(path, sealed=not fam.git_disposable)
    roots = nested_checkouts(path)
    return "unchecked" if roots is None else "git" if roots else "none"


def bare_loss(gitdir: Path) -> str:
    """repo_loss for a bare repository or copied git dir, and for every submodule repository
    kept under its modules/ (they are deleted with it)."""
    if (loss := repo_loss(gitdir)):
        return loss
    modules = gitdir / "modules"
    if not modules.is_dir() or modules.is_symlink():
        return ""
    unreadable: list[str] = []
    for dirpath, dirnames, _ in os.walk(modules, onerror=lambda e: unreadable.append(str(e.filename))):
        if unreadable:
            return "unreadable submodule store"
        if looks_like_repository(dirpath):
            if (loss := repo_loss(Path(dirpath))):
                return f"{os.path.relpath(dirpath, gitdir)}: {loss}"
            dirnames[:] = ["modules"] if "modules" in dirnames else []  # nested submodules only
    return "unreadable submodule store" if unreadable else ""


def _load_keep() -> dict:
    try:
        keep = json.loads(NESTED_KEEP.read_text())
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in keep.items() if isinstance(v, dict) and isinstance(v.get("at"), (int, float))} \
        if isinstance(keep, dict) else {}


def family_git_loss(fam: "Family", path: Path) -> str:
    """git_loss for the checkout at path, or with fam.nested_git for every checkout inside it."""
    if not fam.nested_git:
        return git_loss(path)
    keep = _load_keep()
    hit = keep.get(str(path))
    if isinstance(hit, dict) and time.time() - hit.get("at", 0) < NESTED_KEEP_S and hit.get("loss"):
        return str(hit["loss"])
    loss = _nested_loss(path)
    if loss:
        keep = {k: v for k, v in keep.items()
                if isinstance(v, dict) and time.time() - v.get("at", 0) < NESTED_KEEP_S}
        keep[str(path)] = {"at": time.time(), "loss": loss}
        try:
            NESTED_KEEP.parent.mkdir(parents=True, exist_ok=True)
            tmp = NESTED_KEEP.with_suffix(f".{os.getpid()}.tmp")
            tmp.write_text(json.dumps(keep))
            os.replace(tmp, NESTED_KEEP)
        except OSError:
            pass
    return loss


def ignored_checkout_loss(root: Path) -> str:
    """checkouts() stops at a checkout, and its status hides ignored directories, so a clone kept
    in one (vendor/ in .gitignore) would go unjudged. Build-output directories are skipped as
    everywhere else: SwiftPM and friends keep reproducible dependency clones there."""
    try:
        r = subprocess.run(["git", "-C", str(root), "status", "--porcelain", "-z", "--ignored=matching",
                            "--untracked-files=normal"], capture_output=True, text=True, timeout=60,
                           env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    except (OSError, subprocess.TimeoutExpired):
        return "unreadable ignored files"
    if r.returncode != 0:
        return "unreadable ignored files"
    for entry in r.stdout.split("\0"):  # -z: paths unquoted, so none is misread and skipped
        if not entry.startswith("!! ") or not entry.endswith("/"):
            continue
        rel = entry[3:].rstrip("/")
        if Path(rel).name in REPRODUCIBLE_DIRS:
            continue
        inner = checkouts(root / rel, NESTED_DEPTH, NESTED_BUDGET)
        if inner is None:
            return f"{rel}: too deep or large to find every checkout"
        for sub in inner:
            if not os.path.lexists(sub / ".git"):
                if (loss := bare_loss(sub)):
                    return f"{sub.relative_to(root)}: {loss}"
            elif (loss := git_loss(sub)) or (loss := ignored_checkout_loss(sub)):
                return f"{sub.relative_to(root)}: {loss}"
    return ""


def _nested_loss(path: Path) -> str:
    roots = nested_checkouts(path)
    if roots is None:
        return "too deep or large to find every checkout"
    inside = os.path.realpath(path) + "/"
    for root in roots:
        where = root.relative_to(path)
        if not os.path.lexists(root / ".git"):
            if (loss := bare_loss(root)):
                return f"{where}: {loss}"
            continue
        if (loss := git_loss(root)):
            return f"{where}: {loss}"
        if (loss := ignored_checkout_loss(root)):
            return f"{where}: {loss}"
        # git_loss keeps a linked worktree because its repository stays; here the repository
        # may be inside the item being deleted
        if (root / ".git").is_file():
            common = git_common_dir(root)
            if not common or (os.path.realpath(common) + "/").startswith(inside):
                return f"{where}: worktree of a repository inside this item"
    return ""


def has_git(path: Path) -> bool:
    return git_state(path) != "none"


def git_loss(path: Path) -> str:
    """"" when deleting this checkout loses nothing git holds, else what it would lose.

    Only a checkout rooted at path is judged; any failure or doubt counts as a loss.
    """
    dotgit = path / ".git"
    if not os.path.lexists(dotgit) or dotgit.is_symlink():
        return "checkout below the top level"

    def git(*args: str) -> str | None:
        try:
            r = subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True,
                               timeout=60, env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
        except (OSError, subprocess.TimeoutExpired):
            return None
        return r.stdout if r.returncode == 0 else None

    top = git("rev-parse", "--show-toplevel")
    if top is None or os.path.realpath(top.strip()) != os.path.realpath(path):
        return "not a readable checkout"
    # --ignore-submodules=none overrides submodule.*.ignore, so dirty submodules count
    status = git("status", "--porcelain", "--untracked-files=all", "--ignore-submodules=none")
    if status is None or status.strip():
        return "uncommitted or untracked changes"
    # status hides edits to files flagged assume-unchanged (lowercase tag) or skip-worktree (S)
    flags = git("ls-files", "-v")
    if flags is None or any(ln[:1].islower() or ln[:1] == "S" for ln in flags.splitlines()):
        return "files hidden from status"
    own = git("rev-parse", "--path-format=absolute", "--git-dir")
    if own is None:
        return "not a readable checkout"
    # submodule repositories live in this checkout's git dir (a linked worktree's own one),
    # so they are deleted with it
    if (loss := submodule_loss(path, Path(own.strip()))):
        return loss
    if dotgit.is_dir():
        wts = git("worktree", "list", "--porcelain")
        if wts is None or sum(ln.startswith("worktree ") for ln in wts.splitlines()) != 1:
            return "other worktrees use this repository"
        if (loss := repo_loss(dotgit)):
            return loss
    else:  # linked worktree: branches and stash live in the repository, which stays
        common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
        if common is None or os.path.realpath(common.strip()).startswith(os.path.realpath(path) + "/"):
            return "repository inside the worktree"
        if os.path.lexists(os.path.join(own.strip(), "locked")):
            return "locked worktree"
        # refs/bisect and refs/worktree belong to the worktree and go with it
        refs = git("for-each-ref", "--count=1", "--contains", "HEAD", "--format=%(refname)",
                   "refs/heads", "refs/tags", "refs/remotes")
        if refs is None or not refs.strip():
            return "HEAD on no ref"
        # so does its HEAD reflog: a commit made here and then checked away from lives only there
        tips = local_tips(Path(own.strip()), worktree_only=True)
        if tips is None:
            return "unreadable worktree reflog"
        left = git("rev-list", "-n1", *tips, "--not", "--branches", "--tags", "--remotes") \
            if tips else ""
        if left is None or left.strip():
            return "commits only this worktree's reflog holds"
    return ""


def _git_dir_run(gitdir: Path, *args: str, timeout: int = 60,
                 network: bool = False, stdin: str | None = None) -> str | None:
    env = {**os.environ, "GIT_OPTIONAL_LOCKS": "0", "GIT_TERMINAL_PROMPT": "0"}
    if network and "GIT_SSH_COMMAND" not in env:
        env["GIT_SSH_COMMAND"] = "ssh -o BatchMode=yes -o ConnectTimeout=10"
    try:
        r = subprocess.run(["git", "--git-dir", str(gitdir), *args], capture_output=True,
                           text=True, timeout=timeout, env=env, input=stdin)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


ZERO = re.compile(r"0{40}(0{24})?$")


def files_strict(d: Path) -> list[Path] | None:
    """Every file below d (none when it is absent); None when any directory below it cannot be read, which
    Path.rglob would skip without a word."""
    if not os.path.lexists(d):
        return []
    errors: list[OSError] = []
    found: list[Path] = []
    for dp, dirs, fs in os.walk(d, onerror=errors.append):
        if any(os.path.islink(os.path.join(dp, x)) for x in dirs):  # os.walk would not enter it: unread
            return None
        for f in fs:  # a symlink or special file is skipped by is_file() readers: unread too
            try:
                if not stat.S_ISREG(os.lstat(os.path.join(dp, f)).st_mode):
                    return None
            except OSError:
                return None
        found += [Path(dp) / f for f in fs]
    return None if errors or d.is_symlink() else found


# refs a linked worktree keeps for itself; they are deleted with it
WORKTREE_REFS = ("refs/bisect", "refs/worktree", "refs/rewritten")


def local_tips(gitdir: Path, worktree_only: bool = False) -> list[str] | None:
    """Every commit this repository points at on its own: HEAD, all refs but remote-tracking
    ones, and every reflog entry (a commit left behind by `submodule update` lives only there).
    With worktree_only, only what a linked worktree's git dir holds for itself: HEAD, its
    per-worktree refs and its reflogs. None when they cannot all be read."""
    for name in ("HEAD", "packed-refs"):  # git reads these through a symlink; a hidden one is unreadable
        try:
            if not stat.S_ISREG(os.lstat(gitdir / name).st_mode):
                return None
        except FileNotFoundError:
            if name == "HEAD":
                return None
        except OSError:
            return None
    refs = _git_dir_run(gitdir, "for-each-ref",
                        "--format=%(refname)%09%(objectname)%09%(*objectname)",
                        *(WORKTREE_REFS if worktree_only else ()))
    head = _git_dir_run(gitdir, "rev-parse", "--verify", "-q", "HEAD")
    if refs is None or head is None:
        return None
    tips = {head.strip()}
    for line in refs.splitlines():
        name, obj, peeled = (line.split("\t") + ["", ""])[:3]
        if not name.startswith("refs/remotes/"):
            tips.add(peeled or obj)
    logs = gitdir / "logs"
    if (files := files_strict(logs)) is None:
        return None
    if files:
        for f in files:
            if f.is_file() and not f.relative_to(logs).parts[:2] == ("refs", "remotes"):
                try:
                    lines = f.read_text(errors="replace").splitlines()
                except OSError:
                    return None
                tips.update(ln.split(" ", 2)[1] for ln in lines if ln.count(" ") >= 2)
    return sorted(t for t in tips if t and not ZERO.match(t))


NETWORK_URL = re.compile(r"(https?|ssh|git|git\+ssh|ssh\+git)://|[^/.][^/:]*:(?!//)")


TRUSTED_LOCAL_REMOTES: tuple[str, ...] = ()  # tests: local repos standing in for a server


def network_remotes(gitdir: Path) -> list[str] | None:
    """Remotes on another machine. A local path or file:// remote can be one more scratch repo
    about to be deleted too (two clones fetching from each other vouch for commits that exist
    nowhere else), so it never counts as a copy. None when the config cannot be read."""
    out = _git_dir_run(gitdir, "config", "--get-regexp", r"^remote\..*\.url$")
    if out is None:
        return [] if _git_dir_run(gitdir, "rev-parse", "--git-dir") is not None else None
    names = set()
    for line in out.splitlines():
        key, _, url = line.partition(" ")
        name = key[len("remote."):-len(".url")]
        trusted = any(url == t or url.startswith(t + "/") for t in TRUSTED_LOCAL_REMOTES)
        if trusted or (NETWORK_URL.match(url) and not url.startswith("file:")):
            names.add(name)
        else:
            names.discard(name)  # a remote with any local URL is not trusted
            names.add(f"\0{name}")
    return sorted(n for n in names if not n.startswith("\0") and f"\0{n}" not in names)


def remote_has(gitdir: Path, commits: list[str]) -> bool:
    """True when some remote of this repository confirms it holds every one of `commits`.

    `fetch --negotiate-only` asks the server which of these it has in common and transfers no
    objects and writes no refs. An unreachable server, a refusal or a partial answer is False.
    """
    remotes = network_remotes(gitdir)
    if not remotes:
        return False
    missing = set(commits)
    for remote in remotes:
        acked = _git_dir_run(gitdir, "-c", "protocol.version=2", "fetch", "--negotiate-only",
                             *[f"--negotiation-tip={c}" for c in sorted(missing)], remote,
                             network=True)
        if acked is not None:
            missing -= set(acked.split())
        if not missing:
            return True
    return False


def repo_loss(gitdir: Path) -> str:
    """"" when deleting this (submodule) repository loses nothing: no stash, no worktrees of
    its own, and every local commit on a remote-tracking ref or confirmed by a remote."""
    if (gitdir / "worktrees").is_dir() and any((gitdir / "worktrees").iterdir()):
        return "has worktrees of its own"
    stash = _git_dir_run(gitdir, "for-each-ref", "--count=1", "refs/stash")
    if stash is None or stash.strip():
        return "stash entries"
    tips = local_tips(gitdir)
    if tips is None:
        return "unreadable refs"
    if not tips:
        return ""
    remotes = network_remotes(gitdir)
    if remotes is None:
        return "unreadable remotes"
    try:
        r = subprocess.run(["git", "--git-dir", str(gitdir), "rev-list", "--max-count=5001",
                            "--stdin", "--not", *[f"--remotes={n}/*" for n in remotes]],
                           input="\n".join(tips) + "\n",
                           capture_output=True, text=True, timeout=60,
                           env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    except (OSError, subprocess.TimeoutExpired):
        return "unreadable history"
    if r.returncode != 0 or len(r.stdout.split()) > 5000:
        return "unreadable history"
    outside = set(r.stdout.split())
    unconfirmed = [t for t in tips if t in outside]  # every outside commit is below one of these
    if not unconfirmed:
        return ""
    if len(unconfirmed) > 64 or not remote_has(gitdir, unconfirmed):
        return "commits no remote confirms"
    return ""


# archive_mirror's bundles: only files its manifest lists, at the sha256 recorded there, are ever pruned
MIRROR_ARCHIVE_DAYS = 30
MIRROR_BUNDLE_RE = re.compile(r"\d{8}T\d{6}-\d+-[0-9a-f]{16}-[A-Za-z0-9._-]*\.expires-(\d{4}-\d{2}-\d{2})\.bundle")
ARCHIVE_REF = "refs/glaeda-archive/"  # a commit only a reflog or HEAD holds is named for the bundle meanwhile
NEGOTIATE_MAX = 1024  # more candidate commits than this are not asked about: their history is bundled instead


def mirror_archive() -> Path:
    return HOME / "archive" / "glaeda-disk"


def _sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def prune_mirror_archive(today: str | None = None) -> int:
    """Delete the bundles manifest.jsonl lists whose expiry has passed, each only while it is a regular file
    with the sha256 the manifest recorded for it; nothing the manifest does not list, nothing else in ~/archive."""
    today = today or time.strftime("%Y-%m-%d")
    root, gone, kept = mirror_archive(), 0, []
    manifest = root / "manifest.jsonl"
    if root.is_symlink() or not root.is_dir() or manifest.is_symlink() or not manifest.is_file():
        return 0
    try:
        lines = manifest.read_text().splitlines()
    except OSError:
        return 0
    for line in lines:
        try:
            e = json.loads(line)
            name, sha, expires = str(e["name"]), str(e["sha256"]), str(e["expires"])
        except (ValueError, KeyError, TypeError):
            kept.append(line)
            continue
        f = root / name
        if not MIRROR_BUNDLE_RE.fullmatch(name) or expires >= today:
            kept.append(line)
        elif f.is_file() and not f.is_symlink():
            try:
                if _sha256(f) == sha:
                    f.unlink()
                    gone += 1
                    continue
            except OSError:
                pass
            kept.append(line)  # changed or unreadable: never deleted, still listed
    with contextlib.suppress(OSError):
        tmp = manifest.with_name(f".manifest.{os.getpid()}.tmp")
        tmp.write_text("".join(ln + "\n" for ln in kept))
        os.replace(tmp, manifest)
    return gone


def _bundle_name(key: str, ref: str = "") -> str:
    """Unique per repository (a hash of its real path), per ref, per pass and per process; readable tail."""
    digest = hashlib.sha256(f"{key}\0{ref}".encode()).hexdigest()[:16]
    tail = re.sub(r"[^A-Za-z0-9._-]+", "_", f"{key}{'-' + ref if ref else ''}").strip("_")[-80:]
    return f"{time.strftime('%Y%m%dT%H%M%S')}-{os.getpid()}-{digest}-{tail}"


def _write_bundle(gitdir: Path, name: str, revs: list[str], heads: set[str], written: list[Path]) -> str:
    """`git bundle create` from rev-list arguments, checked by `git bundle verify` and its heads, then linked
    to its archive name (never over an existing file) and recorded in the manifest. "" or why it failed."""
    expires = time.strftime("%Y-%m-%d", time.localtime(time.time() + MIRROR_ARCHIVE_DAYS * 86400))
    dest = mirror_archive() / f"{name}.expires-{expires}.bundle"
    tmp = dest.with_name(f".{dest.name}.{os.getpid()}.tmp")
    try:
        dest.parent.mkdir(parents=True, exist_ok=True)
        if _git_dir_run(gitdir, "bundle", "create", str(tmp), "--stdin", stdin="\n".join(revs) + "\n",
                        timeout=600) is None or _git_dir_run(gitdir, "bundle", "verify", str(tmp), timeout=600) is None:
            return f"git bundle create or verify failed for {gitdir}"
        listed = _git_dir_run(gitdir, "bundle", "list-heads", str(tmp))
        if listed is None or not heads <= {ln.split(" ", 1)[-1] for ln in listed.splitlines()}:
            return f"bundle of {gitdir} lacks a ref"
        os.link(tmp, dest)  # FileExistsError rather than replacing another bundle
        written.append(dest)
        with (dest.parent / "manifest.jsonl").open("a") as m:
            m.write(json.dumps({"name": dest.name, "sha256": _sha256(dest), "expires": expires}) + "\n")
        return ""
    except OSError as e:
        return f"bundle of {gitdir}: {e.__class__.__name__}"
    finally:
        with contextlib.suppress(OSError):
            tmp.unlink(missing_ok=True)


def _server_acks(gitdir: Path, remotes: list[str], commits: list[str]) -> set[str]:
    """The commits among `commits` some remote confirms it holds (`fetch --negotiate-only`, as remote_has).
    A server that decides it is ready answers with a packfile and git gives up on the batch, so a failed batch
    is asked one commit at a time; a commit no answer confirms is not held (its history is bundled)."""
    def ask(remote: str, batch: list[str]) -> set[str] | None:
        out = _git_dir_run(gitdir, "-c", "protocol.version=2", "fetch", "--negotiate-only",
                           *[f"--negotiation-tip={c}" for c in batch], remote, network=True)
        return None if out is None else set(out.split()) & set(batch)
    acked: set[str] = set()
    for r in remotes:
        for k in range(0, len(commits), 64):
            batch = [c for c in commits[k:k + 64] if c not in acked]
            got = ask(r, batch) if batch else set()
            acked |= got if got is not None else {c for c in batch if ask(r, [c])}
    return acked


def _server_known(gitdir: Path, remotes: list[str], asked: set[str]) -> tuple[str, dict[str, set[str]], list[str]]:
    """What the servers hold right now: ("" or why not, refname -> objects they advertise there, the local
    commits and tags among those and `asked` they advertise or acknowledge)."""
    held: dict[str, set[str]] = {}
    for r in remotes:
        if (out := _git_dir_run(gitdir, "ls-remote", "--heads", "--tags", r, network=True, timeout=120)) is None:
            return f"remote {r} of {gitdir} did not answer", {}, []
        for ln in out.splitlines():
            obj, _, name = ln.partition("\t")
            held.setdefault(name.removesuffix("^{}"), set()).add(obj)
    candidates = sorted({*asked, *(o for s in held.values() for o in s)})
    have = _git_dir_run(gitdir, "cat-file", "--batch-check=%(objectname) %(objecttype)",
                        stdin="\n".join(candidates) + "\n") if candidates else ""
    if have is None:
        return f"unreadable objects in {gitdir}", {}, []
    present = {ln.split()[0] for ln in have.splitlines() if ln.endswith(" commit") or ln.endswith(" tag")}
    advertised = {o for s in held.values() for o in s} & present
    ask = sorted((present & asked) - advertised)
    acked = _server_acks(gitdir, remotes, ask) if len(ask) <= NEGOTIATE_MAX else set()
    return "", held, sorted(advertised | (acked & present))


def server_still_holds(gitdir: Path, relied: list[str]) -> str:
    """Right before the delete: every commit the bundles left to the servers (their prerequisites and the
    tips no bundle holds) is still on a server, asked again."""
    remotes = network_remotes(gitdir)
    if remotes is None:
        return f"unreadable remotes in {gitdir}"
    why, _, known = _server_known(gitdir, remotes, set(relied))
    if why:
        return why
    out = _git_dir_run(gitdir, "rev-list", "--stdin", stdin="\n".join([*relied, "--not", *known]) + "\n",
                       timeout=600) if relied else ""
    return "" if out == "" else f"a commit left to the servers is no longer on one ({gitdir})"


def bundle_unpushed(gitdir: Path, key: str, written: list[Path], relied: list[str] | None = None) -> str:
    """Bundle what deleting this repository loses: commits no remote server confirms (what ls-remote advertises
    and what `fetch --negotiate-only` acknowledges; local remote-tracking refs are only candidates to ask
    about), and every branch or tag the servers do not have at that commit. The commits left to the servers
    go to relied, for server_still_holds. "" or why it failed."""
    if repo_unborn(gitdir):
        return ""  # nothing to keep
    tips = local_tips(gitdir)
    for wt in [p for p in (gitdir / "worktrees").glob("*") if p.is_dir()] if tips is not None else []:
        own = local_tips(wt, worktree_only=True)
        tips = None if own is None else sorted({*tips, *own})
    remotes = network_remotes(gitdir)
    refs = _git_dir_run(gitdir, "for-each-ref", "--format=%(refname)%09%(objectname)%09%(*objectname)")
    if tips is None or remotes is None or refs is None:
        return f"unreadable refs or remotes in {gitdir}"
    local: dict[str, tuple[str, str]] = {}  # refname -> (object, commit)
    tracking: set[str] = set()
    for line in refs.splitlines():
        name, obj, peeled = (line.split("\t") + ["", ""])[:3]
        if name.startswith("refs/remotes/"):
            tracking.add(peeled or obj)
        else:
            local[name] = (obj, peeled or obj)
    why, held, known = _server_known(gitdir, remotes, {*tips, *tracking})
    if why:
        return why
    # --boundary: the server-held commits the unpushed history stops at, which its bundle requires
    out = _git_dir_run(gitdir, "rev-list", "--boundary", "--stdin",
                       stdin="\n".join([*tips, "--not", *known]) + "\n", timeout=600)
    if out is None:
        return f"unreadable history in {gitdir}"
    unpushed = {c for c in out.split() if not c.startswith("-")}
    if relied is not None:
        relied += sorted({c[1:] for c in out.split() if c.startswith("-")} | ({*tips} - unpushed))
    # the refs to keep: every local one on an unpushed commit, and every branch or tag the servers lack there
    keep = {n for n, (_, c) in local.items() if c in unpushed}
    only_here = sorted(n for n, (o, _) in local.items() if n.startswith(("refs/heads/", "refs/tags/"))
                       and n not in keep and o not in held.get(n, ()))
    loose = sorted({t for t in tips if t in unpushed} - {local[n][1] for n in keep})
    if loose and _git_dir_run(gitdir, "update-ref", "--stdin", stdin="".join(
            f"create {ARCHIVE_REF}{t} {t}\n" for t in loose)) is None:
        return f"cannot name the loose commits in {gitdir}"
    try:
        heads = keep | {ARCHIVE_REF + t for t in loose}
        if heads and (why := _write_bundle(gitdir, _bundle_name(key), [*sorted(heads), "--not", *known],
                                           heads, written)):
            return why
        for n in only_here:  # its commit is on a server: the bundle holds that commit and the name
            parents = _git_dir_run(gitdir, "rev-parse", f"{local[n][1]}^@")
            if parents is None or (why := _write_bundle(
                    gitdir, _bundle_name(key, n), [n, "--not", *parents.split()], {n}, written)):
                return why or f"unreadable {n} in {gitdir}"
        return ""
    finally:
        if loose:
            _git_dir_run(gitdir, "update-ref", "--stdin", stdin="".join(
                f"delete {ARCHIVE_REF}{t}\n" for t in loose))


def _ignored_checkouts(root: Path) -> list[Path] | None:
    """Checkouts inside a checkout's ignored directories (vendor/ in .gitignore), as ignored_checkout_loss
    finds them; build-output directories are skipped as there. None when they cannot all be found."""
    try:
        r = subprocess.run(["git", "-C", str(root), "status", "--porcelain", "-z", "--ignored=matching",
                            "--untracked-files=normal"], capture_output=True, text=True, timeout=60,
                           env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    found: list[Path] = []
    for entry in r.stdout.split("\0"):
        if entry.startswith("!! ") and entry.endswith("/") and Path(entry[3:-1]).name not in REPRODUCIBLE_DIRS:
            if (inner := checkouts(root / entry[3:-1], NESTED_DEPTH, NESTED_BUDGET, strict=True)) is None:
                return None
            found += inner
    return found


def _work_tree_dirty(root: Path) -> str:
    """Tracked edits, untracked files that are not ignored, or files hidden from status: a bundle holds none."""
    status = _git_dir_run(root / ".git", "--work-tree", str(root), "status", "--porcelain",
                          "--untracked-files=all", "--ignore-submodules=none")
    flags = _git_dir_run(root / ".git", "--work-tree", str(root), "ls-files", "-v")
    if status is None or flags is None:
        return "unreadable work tree"
    if status.strip() or any(ln[:1].islower() or ln[:1] == "S" for ln in flags.splitlines()):
        return "uncommitted or untracked changes"
    return ""


MIRROR_KEEP = ".glaeda-disk-keep-"  # next to an aside tree: finish_deletion and interrupted-deletions never delete it


def mirror_keep_marker(aside: Path) -> Path:
    return aside.with_name(MIRROR_KEEP + aside.name)


def repo_unborn(gitdir: Path) -> bool:
    """No ref, reflog or linked worktree, and HEAD a branch with no commit yet: a repository with nothing in it."""
    try:
        if not stat.S_ISREG(os.lstat(gitdir / "HEAD").st_mode) or os.path.lexists(gitdir / "packed-refs"):
            return False  # a symlinked HEAD or any packed-refs at all: not judged empty
    except OSError:
        return False
    return (files_strict(gitdir / "refs") == [] and _git_dir_run(gitdir, "for-each-ref", "--count=1") == ""
            and _git_dir_run(gitdir, "rev-parse", "-q", "--verify", "HEAD") is None
            and _git_dir_run(gitdir, "symbolic-ref", "-q", "HEAD") is not None
            and files_strict(gitdir / "logs") == [] and not os.path.lexists(gitdir / "worktrees"))


def mirror_tips(root: Path, gitdirs: dict[str, Path]) -> dict[str, tuple[list[str], str]] | None:
    """Every commit each repository points at on its own (local_tips: refs, HEAD, reflogs, its worktrees'), and
    its local refs by name, keyed by the git dir's path relative to root, so the same item can be read again
    after a rename."""
    tips: dict[str, tuple[list[str], str]] = {}
    for g in gitdirs.values():
        t = [] if repo_unborn(g) else local_tips(g)
        for wt in [p for p in (g / "worktrees").glob("*") if p.is_dir()] if t is not None else []:
            own = local_tips(wt, worktree_only=True)
            t = None if own is None else sorted({*t, *own})
        refs = _git_dir_run(g, "for-each-ref", "--format=%(refname) %(objectname)")
        if t is None or refs is None:
            return None
        tips[os.path.relpath(g, root)] = (t, "\n".join(
            ln for ln in refs.splitlines() if not ln.startswith(("refs/remotes/", ARCHIVE_REF))))
    return tips


def mirror_rename_recheck(path: Path, recheck: tuple):
    """after_rename for a bundled mirror: the renamed tree gets the whole check archive_mirror made before its
    bundles again (a fresh strict scan of repositories and work trees, each clean and unlocked), and must hold
    the same repositories with no commit beyond what was bundled or left to the servers. Otherwise it goes back
    to its path, or, when that fails, stays aside: its keep marker is written before the rename (if that write
    fails, nothing is renamed or deleted) and removed only once the check passes."""
    doomed = path.with_name(f"{DELETING_PREFIX}{path.name}-{os.getpid()}")
    before = recheck[4]
    marker = mirror_keep_marker(doomed)
    marker.write_text(f"kept by glaeda-disk {os.getpid()} until its git work is checked again\n")  # raises: kept

    def check() -> None:
        why, gitdirs, _ = mirror_repos(doomed)
        now = None if why else mirror_tips(doomed, gitdirs)
        if now is not None and before is not None and set(now) == set(before) \
                and all(set(t) <= set(before[k][0]) and refs == before[k][1] for k, (t, refs) in now.items()):
            try:
                marker.unlink()
                return
            except OSError as e:
                why = f"its keep marker could not be removed ({e.strerror})"
        try:
            rename_noreplace(doomed, path)
        except OSError as e:
            raise SlotTaken(f"{path.name}: changed after bundling; kept aside as {doomed.name} ({e.strerror})")
        with contextlib.suppress(OSError):
            marker.unlink()
        raise SlotTaken(f"{path.name}: changed after bundling ({why or 'git changed'}); put back")
    return check


def mirror_git_snapshot(gitdirs: list[Path], trees: list[Path]) -> list[str | None]:
    """Every ref, HEAD and reflog size of the item's repositories and the status of its work trees: compared
    before and after archive_mirror's bundles, so a commit made meanwhile keeps the tree."""
    snap: list[str | None] = []
    for g in gitdirs:
        snap.append(_git_dir_run(g, "for-each-ref", "--format=%(refname) %(objectname)"))
        for d in [g, *(p for p in (g / "worktrees").glob("*") if p.is_dir())]:
            try:
                snap.append((d / "HEAD").read_text())  # a symbolic ref or a commit; an unborn HEAD reads too
            except OSError:
                snap.append(None)
            try:
                files = files_strict(d / "logs")
                snap.append(None if files is None else " ".join(f"{f}:{f.stat().st_size}" for f in sorted(files)))
            except OSError:
                snap.append(None)  # unreadable: never matches, so the tree stays
    snap += [_git_dir_run(t / ".git", "--work-tree", str(t), "status", "--porcelain", "--untracked-files=all")
             for t in trees]
    return snap


def _linked_trees_strict(gitdir: Path) -> list[Path] | None:
    """linked_work_trees, but None when <gitdir>/worktrees or any record in it cannot be read."""
    wts = gitdir / "worktrees"
    if not os.path.lexists(wts):
        return []
    try:
        if wts.is_symlink() or not wts.is_dir():
            return None
        with os.scandir(wts) as it:
            return [Path((Path(e.path) / "gitdir").read_text().strip()).parent for e in it]
    except (OSError, ValueError):
        return None


def mirror_repos(path: Path) -> tuple[str, dict[str, Path], list[Path]]:
    """Every repository a mirror item takes along, found as _nested_loss finds them (checkouts, bare
    repositories, a linked worktree's repository inside it, checkouts in ignored directories, submodule stores
    and initialized submodules, recursively), and its work trees, each checked clean right now.
    ("" or why it must stay, real git dir -> git dir, work trees)."""
    queue = checkouts(path, NESTED_DEPTH, NESTED_BUDGET, strict=True)  # an unreadable directory may hide one
    if queue is None:
        return "too deep, large or unreadable to find every checkout", {}, []
    queue, inside = list(queue), os.path.realpath(path) + "/"
    gitdirs: dict[str, Path] = {}
    trees: list[Path] = []
    seen: set[str] = set()
    while queue:
        root = queue.pop()
        if (real := os.path.realpath(root)) in seen:
            continue
        seen.add(real)
        where, dotgit = root.relative_to(path), root / ".git"
        if not os.path.lexists(dotgit):
            gitdirs[real] = root
            continue
        if dotgit.is_symlink():
            return f"{where}: .git is a symlink", {}, []
        if (dirty := _work_tree_dirty(root)):
            return f"uncommitted: {where}: {dirty}", {}, []
        trees.append(root)
        if (inner := _ignored_checkouts(root)) is None:
            return f"{where}: too deep or large to find every checkout in its ignored files", {}, []
        queue += inner
        own = _git_dir_run(dotgit, "rev-parse", "--absolute-git-dir")
        links = _git_dir_run(dotgit, "--work-tree", str(root), "ls-files", "-s")
        if own is None or links is None:
            return f"{where}: unreadable git dir or index", {}, []
        # initialized submodules, embedded (.git a directory) or stored in modules/ (.git a file), and theirs
        queue += [root / ln.split("\t", 1)[1] for ln in links.splitlines()
                  if ln.startswith("160000 ") and os.path.lexists(root / ln.split("\t", 1)[1] / ".git")]
        if dotgit.is_dir():
            gitdirs[os.path.realpath(dotgit)] = dotgit
            continue
        # a .git file: a linked worktree, or a submodule whose repository is in its superproject's modules/
        common = git_common_dir(root)
        if not common:
            return f"{where}: unreadable worktree", {}, []
        if os.path.lexists(os.path.join(own.strip(), "locked")):  # as git_loss: wherever its repository is
            return f"{where}: locked worktree", {}, []
        if (os.path.realpath(common) + "/").startswith(inside):
            gitdirs[os.path.realpath(common)] = Path(common)
            continue
        tips = local_tips(Path(own.strip()), worktree_only=True)
        left = None if tips is None else _git_dir_run(
            Path(common), "rev-list", "-n1", *tips, "--not", "--branches", "--tags", "--remotes") if tips else ""
        if left is None or left.strip():
            return f"{where}: commits only this worktree's reflog holds", {}, []
    unreadable: list[str] = []
    for g in list(gitdirs.values()):  # submodule stores: modules/<name>, nested ones too
        if (g / "modules").is_symlink():
            unreadable.append(os.fspath(g / "modules"))
        for dirpath, dirnames, _ in os.walk(g / "modules", onerror=lambda e: unreadable.append(str(e.filename))):
            # os.walk neither enters nor reports a symlinked directory: as submodule_loss, it is unreadable
            unreadable += [os.path.join(dirpath, d) for d in dirnames if os.path.islink(os.path.join(dirpath, d))]
            if looks_like_repository(dirpath):
                gitdirs[os.path.realpath(dirpath)] = Path(dirpath)
                dirnames[:] = ["modules"] if "modules" in dirnames else []
    if [u for u in unreadable if os.path.lexists(u)]:  # a missing modules/ is no submodule store
        return f"unreadable submodule store {unreadable[0]}", {}, []
    for key, g in gitdirs.items():
        if (linked := _linked_trees_strict(g)) is None:
            return f"{key}: unreadable linked worktree records", {}, []
        if linked:  # the records name absolute paths, so after the rename its worktrees can't be checked again
            return f"{key}: has linked worktrees ({', '.join(map(os.fspath, linked[:3]))}); kept", {}, []
    return "", gitdirs, sorted(trees)


def archive_mirror(path: Path) -> tuple[str, list[Path], tuple]:
    """Before a mirror item goes: bundle_unpushed for every repository mirror_repos finds. A tree with
    uncommitted work, or whose repositories cannot all be found or bundled, is kept.
    ("" or why it must stay, the bundles written, what mirror_moved rechecks)."""
    none: tuple = ([], [], [], {}, None)
    why, gitdirs, trees = mirror_repos(path)
    if why:
        return why, [], none
    snap = mirror_git_snapshot(list(gitdirs.values()), trees)
    tips = mirror_tips(path, gitdirs)  # what the bundles and the servers cover, for mirror_rename_recheck
    if tips is None:
        return "unreadable refs", [], none
    bundles: list[Path] = []
    relied: dict[Path, list[str]] = {}
    for key, g in sorted(gitdirs.items()):
        if (why := bundle_unpushed(g, key, bundles, relied.setdefault(g, []))):
            return why, bundles, none
    return "", bundles, (list(gitdirs.values()), trees, snap, relied, tips)


def mirror_moved(fam: Family, path: Path, recheck: tuple) -> str:
    """Right before a bundled mirror goes, everything the bundling took time over is read again: process
    evidence, the family's owner and artifact references, and its repositories, found afresh (the same set,
    every work tree clean) and as at bundle time, and the servers, asked again for what the bundles left to them."""
    gitdirs, trees, snap, relied, _ = recheck
    for g, commits in relied.items():  # the slow network first, then git, then the quick process checks last
        if (why := server_still_holds(g, commits)):
            return why
    why, now, now_trees = mirror_repos(path)
    if why or {os.path.realpath(g) for g in now.values()} != {os.path.realpath(g) for g in gitdirs} \
            or now_trees != trees:
        return f"its repositories changed while they were bundled{': ' + why if why else ''}"
    if None in snap or mirror_git_snapshot(gitdirs, trees) != snap:
        return "its git refs or work trees changed while they were bundled"
    if fam.git_disposable and (ref := referenced_main_checkout(path, nested=fam.nested_git)):
        return f"referenced while its git work was bundled: {ref}"
    if fam.retired_only and not owner_retired(fam):
        return "its owner loaded while its git work was bundled"
    if fam.reference_root is not None and artifact_referenced(path, fresh_artifact_references(fam.reference_root)):
        return "referenced while its git work was bundled"
    try:
        opened, cmds = process_evidence()
    except NoEvidence as e:
        return f"no process evidence: {e}"
    if in_cwd(os.fspath(path), open_index(opened)) or named_by(os.fspath(path), cmds) or holds_socket(path) \
            or job_busy(fam, path):
        return "in use while its git work was bundled"
    return ""


def submodule_loss(worktree: Path, gitdir: Path, seen: set[str] | None = None,
                   depth: int = 0) -> str:
    """"" when every submodule repository this checkout would take with it loses nothing.

    Those are the repositories stored under its git dir (`modules/`, nested ones included) and
    any embedded in its tree (a submodule whose `.git` is a directory), recursively.
    """
    seen = set() if seen is None else seen
    if depth > 8 or len(seen) > 200:
        return "submodules nested too deep to check"
    repos: list[tuple[str, Path]] = []
    frontier = [gitdir / "modules"] if (gitdir / "modules").exists() else []
    while frontier:
        d = frontier.pop()
        if d.is_symlink() or not d.is_dir():
            return "unreadable submodule store"
        for c in _children(d):
            if c.is_symlink() or not c.is_dir():
                continue
            if (c / "HEAD").is_file() and (c / "objects").is_dir():
                repos.append((os.path.relpath(c, gitdir / "modules"), c))
                if (c / "modules").exists():
                    frontier.append(c / "modules")
            else:
                frontier.append(c)  # a path component of a nested submodule name
    links = subprocess.run(["git", "-C", str(worktree), "ls-files", "-s"], capture_output=True,
                           text=True, timeout=60, env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    if links.returncode != 0:
        return "unreadable index"
    subs = [worktree / ln.split("\t", 1)[1] for ln in links.stdout.splitlines()
            if ln.startswith("160000 ")]
    for sub in subs:
        dotgit = sub / ".git"
        if dotgit.is_dir() and not dotgit.is_symlink():
            repos.append((os.path.relpath(sub, worktree), dotgit))
    for name, repo in repos:
        key = os.path.realpath(repo)
        if key in seen:
            continue
        seen.add(key)
        if (loss := repo_loss(repo)):
            return f"submodule {name}: {loss}"
    for sub in subs:  # submodules of submodules, wherever their repositories live
        if not os.path.lexists(sub / ".git"):
            continue  # not initialized: nothing of it is here
        own = subprocess.run(["git", "-C", str(sub), "rev-parse", "--path-format=absolute",
                              "--git-dir"], capture_output=True, text=True, timeout=60)
        if own.returncode != 0:
            return f"submodule {os.path.relpath(sub, worktree)}: not readable"
        if (loss := submodule_loss(sub, Path(own.stdout.strip()), seen, depth + 1)):
            return loss
    return ""


def git_common_dir(path: Path) -> str:
    """The repository of a linked worktree, so its record can be pruned after deletion."""
    if not (path / ".git").is_file():
        return ""
    try:
        r = subprocess.run(["git", "-C", str(path), "rev-parse", "--path-format=absolute",
                            "--git-common-dir"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return ""  # callers treat an unknown repository as one to keep
    return r.stdout.strip() if r.returncode == 0 else ""


UNREADABLE: set[str] = set()


def _entries(path: Path) -> list[os.DirEntry]:
    """Like _children, but entries carry their type, so filtering tens of thousands (a macOS
    $TMPDIR) costs no stat per entry."""
    try:
        with os.scandir(path) as it:
            return list(it)
    except PermissionError:
        UNREADABLE.add(str(path))
        return []
    except OSError:
        return []


def _children(path: Path) -> list[Path]:
    try:
        return list(path.iterdir())
    except PermissionError:
        UNREADABLE.add(str(path))
        return []
    except OSError:
        return []


def owner_jobs(fam: Family) -> tuple[str, ...]:
    return (fam.owner_job,) if isinstance(fam.owner_job, str) else tuple(fam.owner_job)


def owner_retired(fam: Family) -> bool:
    """True when the family names its owner's launchd services and none of them is loaded."""
    jobs = [j for j in owner_jobs(fam) if j]
    if not jobs or not DARWIN:
        return False
    for job in jobs:
        try:
            # 113 is launchctl's "could not find service"; any other failure is not evidence of retirement
            if subprocess.run(["launchctl", "print", job], capture_output=True, timeout=10).returncode != 113:
                return False
        except (OSError, subprocess.SubprocessError):
            return False  # unknown: say nothing rather than call a live owner retired
    return True


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # someone else's live process
    return True


def eviction_owner_status() -> dict[str, Any]:
    """Read the current eviction owner for bounded status and receipts."""
    try:
        owner = json.loads(EVICT_OWNER.read_text())
        if not isinstance(owner, dict):
            raise ValueError("owner is not an object")
        pid = int(owner.get("pid", 0))
        started = float(owner.get("started_at", 0))
    except (OSError, ValueError, TypeError):
        return {"state": "unavailable", "owner": "unknown"}
    name = owner.get("owner")
    if not isinstance(name, str) or not name:
        name = "unknown"
    command = owner.get("command")
    if not isinstance(command, str) or not command:
        command = _owner_command(pid)
    return {"state": "live" if _pid_alive(pid) else "dead", "pid": pid, "owner": name,
            "started_at": started, "age_s": max(0.0, time.time() - started) if started else None,
            "command": command[:300]}


def eviction_owner_text(status: dict[str, Any]) -> str:
    """Render owner evidence without exposing an unbounded command line."""
    if status.get("state") == "unavailable":
        return "owner=unknown"
    started = status.get("started_at")
    when = time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(started)) if isinstance(started, (int, float)) else "?"
    age = status.get("age_s")
    age_text = f"{age:.0f}s" if isinstance(age, (int, float)) else "?"
    return (f"pid={status.get('pid', '?')} owner={status.get('owner', 'unknown')} "
            f"started={when} age={age_text} state={status.get('state', 'unknown')}")


def write_eviction_status(receipt: Path, status: dict[str, Any]) -> None:
    """Record a skipped eviction so ci-dash can distinguish contention from a quiet run."""
    record = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "at_epoch": time.time(), "host": platform.node(),
              "outcome": "skipped", "family": "eviction", "reason": "another eviction running",
              "owner": status}
    try:
        receipt.parent.mkdir(parents=True, exist_ok=True)
        with receipt.open("a") as handle:
            handle.write(json.dumps(record) + "\n")
    except OSError:
        pass


def cmux_active(path: Path, levels: int = 3, budget: int = 5000) -> bool:
    """cmuxterm-hq's reload-cloud marks a slot busy while a job runs: <slot>/.cmux-active/pid with a
    live pid, or work/<slot>/.lock (lib/cloud-slot-runtime.sh). Either, at or up to `levels` below path,
    means in use. An unreadable pid, or a tree too big to search within `budget`, counts as busy."""
    level = [path]
    for depth in range(levels + 1):
        nxt: list[Path] = []
        for d in level:
            if d.parent.name == "work" and (d / ".lock").exists():  # hq's slot lock, not any tool's .lock
                return True
            marker = d / ".cmux-active" / "pid"
            if marker.exists():
                try:
                    if _pid_alive(int(marker.read_text().split()[0])):
                        return True
                except (OSError, ValueError, IndexError):
                    return True
            if depth == levels:
                continue
            for c in _children(d):
                budget -= 1
                if budget < 0:
                    return True
                if c.name != ".cmux-active" and not c.is_symlink() and c.is_dir():
                    nxt.append(c)
        level = nxt
    return False


def job_busy(fam: Family, path: Path) -> bool:
    """A cmux job unit's slots are marked in work/<slot>, not beside DerivedData/<slot>, so a
    candidate in the job cache is busy when any slot of its whole unit (path.parent) is."""
    if fam.id == "cmux-job-cache":
        return cmux_active(path.parent)
    # a sealed cache (home-caches) is never a job unit, and cmux_active calls a tree larger than its
    # budget busy, which would keep bun's install cache forever. Nor is cmux CI's warm state: a DerivedData
    # there holds thousands of module cache directories within three levels, so every seed read as busy and
    # none was ever evicted (cmux15, 2026-09-28). A job using one is seen by its command line and cwd.
    # The generic tmp family also contains the canonical CI checkout. Its source tree is wider than
    # cmux_active's bounded marker search, so treating budget exhaustion as busy would pin it forever;
    # the runner's root token (tmp_canonical_root) and process/socket evidence are the live-use checks there.
    if fam.id in FLEET_FAMILY_IDS or fam.id == "tmp":
        return False
    if fam.id in RUNNER_CHECKOUT_FAMILIES:  # a cargo target is wider than the budget; Runner.Worker is its signal
        return False
    if fam.id == SPM_SCRATCH:  # dozens of package builds within three levels; its lock is its in-use signal
        return False
    if fam.id == CANONICAL_ADMISSION:  # a DerivedData; the root's token is its in-use signal
        return False
    if fam.id == INTERRUPTED:  # renamed away from every job's path; its deleter's pid is its in-use signal
        return False
    if fam.id == DEDICATED_RUNNER_TEMP:  # a job's scratch can be wider than the budget; a running job is seen by
        return False                     # its processes and open files, and nothing here is younger than 12 h
    if fam.id == CMUX_NEXT_CI_FAMILY and (path in cmux_next_ci_state_roots(fam.root)
                                         or cmux_next_ci_host_root(fam, path)):
        return False  # a whole state's inputs are wider than the budget; cmux_next_ci_busy is its signal
    return fam.reclaimable and not fam.discover and cmux_active(path)


def value(item: "Item", fam: Family) -> float:
    """Deletion order under pressure: space freed per minute of rebuild, favouring what has sat idle
    longest (a tree untouched for days is less likely to be read again)."""
    jobs = 0 if item.jobs_since is None else item.jobs_since / max(POLICY["pressure_jobs"], 1)
    return item.bytes * (1 + item.idle_hours / 24 + jobs) / max(fam.rebuild_minutes, 0.1)


def holds_socket(path: Path, levels: int = 2, budget: int = 3000) -> bool:
    """True when a Unix socket sits up to `levels` below path (tmux, ssh-agent, X11, IDE servers).

    /proc shows a socket a process holds as socket:[inode], not as a path, so neither the open
    file nor the command line check sees it. A directory holding one is treated as in use.
    """
    frontier = [str(path)]
    for _ in range(levels):
        nxt: list[str] = []
        for d in frontier:
            try:
                with os.scandir(d) as it:
                    for e in it:
                        budget -= 1
                        if budget < 0:
                            return False
                        try:
                            st = e.stat(follow_symlinks=False)
                        except OSError:
                            continue
                        if stat.S_ISSOCK(st.st_mode):
                            return True
                        if stat.S_ISDIR(st.st_mode):
                            nxt.append(e.path)
            except OSError:
                pass
        frontier = nxt
    return False


SEARCH_SKIP = REPRODUCIBLE_DIRS | {".git"}


def _search(fam: Family, budget: int = 20000) -> list[Path]:
    found: list[Path] = []
    level = [fam.root]
    for _ in range(fam.depth):
        nxt: list[Path] = []
        for p in level:
            for c in _children(p):
                budget -= 1
                if budget < 0:
                    return found
                if c.name in fam.skip or c.is_symlink() or not c.is_dir() or DELETING_RE.fullmatch(c.name):
                    continue
                if c.name == fam.match and (not fam.marker or (c / fam.marker).exists()):
                    found.append(c)
                elif c.name not in SEARCH_SKIP:
                    nxt.append(c)
        level = nxt
    return found


_DISCOVERED: dict[str, list[Path]] = {}


def candidates(fam: Family) -> list[Path]:
    if fam.transcripts or fam.transcript_archives:
        level = transcript_candidates(fam.root, fam.transcript_archives)
    elif fam.discover:
        key = os.fspath(fam.root)
        if key not in _DISCOVERED:  # one walk per run: main() and survey both ask
            _DISCOVERED[key] = discover_caches(fam.root)
        level = list(_DISCOVERED[key])
    elif fam.checkout_builds:
        key = (f"checkout-builds:{fam.id}:" + os.fspath(fam.root) + (":over-cap" if cmux_next_ci_over() else "")
               + (":floor" if FLOOR_HOLD else "") + (":drain" if CMUX_NEXT_CI_DRAIN else ""))
        if key not in _DISCOVERED:
            _DISCOVERED[key] = (cmux_next_ci_generated_paths(fam.root, whole_stale=True)
                                if fam.id == CMUX_NEXT_CI_FAMILY and cmux_next_ci_over()
                                else cmux_next_ci_generated_paths(fam.root) if fam.id == CMUX_NEXT_CI_FAMILY
                                else runner_checkout_builds(fam.root) if fam.id == RUNNER_BUILD_FAMILY
                                else runner_git_garbage(fam.root) if fam.id == RUNNER_GIT_GARBAGE_FAMILY
                                else checkout_builds(fam.root))
        level = list(_DISCOVERED[key])
    elif fam.match:
        level = _search(fam)
    else:
        level = [fam.root]
        for _ in range(fam.depth):
            level = [Path(e.path) for p in level for e in _entries(p)
                     if e.name not in fam.skip
                     and not (fam.skip_prefixes and e.name.startswith(fam.skip_prefixes))
                     and not (p != fam.root and DELETING_RE.fullmatch(p.name))  # never list inside an aside tree
                     and (e.is_dir(follow_symlinks=False)
                          or (fam.files and e.is_file(follow_symlinks=False)))]
        if fam.include:
            level = [p for p in level if p.name.startswith(fam.include)]
        if fam.id == NIGHTLY_NEXT_FAMILY:  # kept by role: the dedicated builder's tree and anything unrecognized
            level = [p for p in level if nightly_next_fallback(p)]
        if fam.app_clones:
            level = keep_live_app_clones(level)
    # an aside tree (remove()'s rename) is the interrupted-deletions family's alone, whatever family's root holds it
    if fam.id == INTERRUPTED:
        level = [p for p in level if DELETING_RE.fullmatch(p.name)]
    else:
        level = [p for p in level if not DELETING_RE.fullmatch(p.name)]
    uid = os.getuid()
    owned = []
    for p in level:
        if (never_delete(p) and not fam.allow_stale_protected) or toolchain_held(p):
            continue
        try:
            if p.lstat().st_uid == uid:
                owned.append(p)
        except OSError:
            pass  # vanished mid-scan
    return owned


def pressure_measure_budget_s() -> float:
    """disk-policy.json's pressure_measure_budget_s, PRESSURE_MEASURE_BUDGET_S by default (0: no bound)."""
    return float(POLICY.get("pressure_measure_budget_s", PRESSURE_MEASURE_BUDGET_S))


def pressure_survey_deadlines(now: float | None = None) -> tuple[float | None, float | None]:
    """A pressure apply's (measure, judge) deadlines: walks stop starting at the budget, verdicts at twice it."""
    budget = pressure_measure_budget_s()
    if budget <= 0:
        return None, None
    now = time.monotonic() if now is None else now
    return now + budget, now + 2 * budget


def fresh_for_apply(known: dict[str, int], fams: list[Family]) -> dict[str, int]:
    """The snapshot sizes an --apply may reuse: sizes decide what gets deleted under pressure, so every
    reclaimable candidate is re-measured. A discovering family's root is the whole home directory, so
    only its current candidates are dropped, not every size below it (that re-measured the report-only
    checkouts too and ran past the hooks' timeout on the minis)."""
    drop = {os.fspath(p) for f in fams if f.reclaimable and (f.discover or f.checkout_builds or f.transcripts or f.transcript_archives)
            for p in candidates(f)}

    def candidate_of_selected(k: str) -> bool:
        if k in drop:
            return True
        for f in fams:
            if not f.reclaimable or f.discover or f.checkout_builds or f.transcripts or f.transcript_archives:
                continue
            root = str(f.root) + "/"
            if k.startswith(root) and k[len(root):].split("/")[0] not in f.skip:
                return True
        return False
    return {k: v for k, v in known.items() if not candidate_of_selected(k)}


def load_snapshot_meta(path: Path = SNAPSHOT) -> tuple[float, dict[str, int], dict[str, float]]:
    try:
        doc = json.loads(path.read_text())
        sizes = {k: int(v) for k, v in doc["sizes"].items()}
        at = float(doc["at"])
        measured = doc.get("measured_at") if isinstance(doc.get("measured_at"), dict) else {}
        times = {k: float(v) for k, v in measured.items() if k in sizes and isinstance(v, (int, float))}
        return at, sizes, times
    except (OSError, ValueError, KeyError, TypeError):
        return 0.0, {}, {}


def load_snapshot(path: Path = SNAPSHOT) -> tuple[float, dict[str, int]]:
    at, sizes, _ = load_snapshot_meta(path)
    return at, sizes


def snapshot_stamp(at: float, sizes: dict[str, int], measured_at: dict[str, float]) -> float | None:
    """The snapshot's global `at`: when its oldest size was measured. It stays at the old stamp while any item
    has no time of its own, and moves to the oldest item time once every item has one. Without that, a snapshot
    that only --apply passes re-measure (a fleet mini never runs a report, so never a background --refresh) kept
    its first stamp for days although every size in it was minutes old. None (no sizes, or no snapshot yet)
    means now."""
    if not sizes:
        return None  # nothing to be stale: a pass that found no candidates is a full measurement now
    if all(k in measured_at for k in sizes):
        return max(at, min(measured_at[k] for k in sizes)) if at else min(measured_at[k] for k in sizes)
    return at or None


def save_snapshot(sizes: dict[str, int], path: Path = SNAPSHOT, at: float | None = None,
                  measured_at: dict[str, float] | None = None) -> None:
    """`at` is when the oldest size was measured; per-item times prevent stale reports starving refresh."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f".{os.getpid()}.tmp")
    payload = {"at": time.time() if at is None else at, "sizes": sizes}
    if measured_at is not None:
        payload["measured_at"] = {k: v for k, v in measured_at.items() if k in sizes}
    tmp.write_text(json.dumps(payload))
    os.replace(tmp, path)


def refresh_lock_path() -> Path:
    return SNAPSHOT.with_suffix(".refreshing")


def acquire_refresh_lock():
    """Take the background-refresh lock, recovering an unlocked stale marker."""
    path = refresh_lock_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = path.open("a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return None
    return handle


def _unlink_refresh_marker(handle) -> None:
    """Remove only the marker inode held by handle, never a successor refresh marker."""
    path = refresh_lock_path()
    try:
        marker, held = path.stat(), os.fstat(handle.fileno())
        if (marker.st_dev, marker.st_ino) == (held.st_dev, held.st_ino):
            path.unlink()
    except OSError:
        pass


def release_refresh_lock(handle) -> None:
    global _REFRESH_HANDLE
    if handle is None:
        return
    try:
        # Unlink while the inode is still locked.  A later reporter can then
        # create and lock a successor marker without this cleanup removing it.
        _unlink_refresh_marker(handle)
        with contextlib.suppress(OSError):
            fcntl.flock(handle, fcntl.LOCK_UN)
    finally:
        handle.close()
        if _REFRESH_HANDLE is handle:
            _REFRESH_HANDLE = None


def _release_refresh_lock_at_exit() -> None:
    if _REFRESH_HANDLE is not None:
        release_refresh_lock(_REFRESH_HANDLE)


atexit.register(_release_refresh_lock_at_exit)


def launch_background_refresh() -> bool:
    """Launch one refresh while passing the lock ownership to the child."""
    handle = acquire_refresh_lock()
    if handle is None:
        return False
    fd = handle.fileno()
    try:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--refresh", "--top", "0",
                          "--min-mib", "0", "--refresh-budget-s", str(REFRESH_BUDGET_S),
                          "--refresh-lock-fd", str(fd)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, start_new_session=True, pass_fds=(fd,))
    except (OSError, subprocess.SubprocessError):
        release_refresh_lock(handle)
        return False
    # The child has the same open file description and therefore keeps the
    # flock after the parent closes its descriptor.
    handle.close()
    return True


def _measure_missing(paths: list[Path], deadline: float | None = None) -> dict[str, int]:
    """Measure paths with a bounded number of workers, stopping new walks at ``deadline``.

    ``du`` has its own timeout, but an unbounded list of candidates could still keep a refresh alive
    indefinitely.  Keep only a small in-flight batch so a refresh can stop without first queuing tens
    of thousands of subprocesses.  Running walks are already killable by ``_du_output`` and are
    allowed to finish their bounded cleanup after the deadline.
    """
    if not paths:
        return {}
    measured: dict[str, int] = {}
    pool = ThreadPoolExecutor(max_workers=8)
    pending: dict[object, Path] = {}
    next_path = 0

    def fill() -> None:
        nonlocal next_path
        while next_path < len(paths) and len(pending) < 8:
            if deadline is not None and time.monotonic() >= deadline:
                return
            path = paths[next_path]
            next_path += 1
            pending[pool.submit(du_bytes, path)] = path

    try:
        fill()
        while pending:
            timeout = None if deadline is None else max(0.0, deadline - time.monotonic())
            if timeout == 0:
                break
            done, _ = wait(tuple(pending), timeout=timeout)
            if not done:
                break
            for future in done:
                path = pending.pop(future)
                try:
                    size = future.result()
                except (OSError, subprocess.SubprocessError):
                    size = None
                if size is not None:
                    measured[str(path)] = size
            fill()
    finally:
        for future in pending:
            future.cancel()
        # Do not wait for a walk that is already in _du_output: its subprocess has the 30s bound,
        # and waiting here would make the refresh budget meaningless.
        pool.shutdown(wait=False, cancel_futures=True)
    return measured


def survey(families: list[Family], idle_hours: float, min_bytes: int,
           known: dict[str, int] | None = None, defer_bulk: bool = False,
           deadline: float | None = None, judge_deadline: float | None = None) -> list[Item]:
    """Judge every candidate live. Sizes come from `known` when present; the rest are measured.

    With defer_bulk, unsized candidates of bulk_sizes families are left out instead of measured,
    so a report stays fast; the background refresh sizes them for the next one.
    """
    # Capture process evidence before any measurement helpers start. Otherwise a
    # concurrent `du` command appears in ps/lsof and every generated tree is
    # incorrectly classified as in-use.
    try:
        evidence = process_evidence()
    except NoEvidence as error:
        evidence = error
    return _survey(families, idle_hours, min_bytes, known, evidence, defer_bulk, deadline, judge_deadline)


def round_robin_work(families: list[Family]) -> list[tuple[Family, Path]]:
    """Every family's candidates, one family's next candidate after another's: a deadline that stops the walks
    leaves a few of each family unmeasured, not every family after one with tens of thousands of entries."""
    queues = [[(fam, path) for path in candidates(fam)] for fam in families]
    return [pair for row in itertools.zip_longest(*queues) for pair in row if pair is not None]


def bounded_refresh_survey(families: list[Family], idle_hours: float, min_bytes: int,
                           known: dict[str, int], defer_bulk: bool,
                           budget_s: float) -> list[Item]:
    """Run only the owned background refresh under a process-wide wall-clock guard."""
    global _REFRESH_PROGRESS_KNOWN
    _REFRESH_PROGRESS_KNOWN = dict(known)
    if budget_s <= 0:
        return survey(families, idle_hours, min_bytes, known, defer_bulk=defer_bulk)
    own_timer = not _REFRESH_DEADLINE_ACTIVE
    previous_handler = signal.getsignal(signal.SIGALRM) if own_timer else None
    previous_timer = signal.getitimer(signal.ITIMER_REAL) if own_timer else (0.0, 0.0)
    if own_timer:
        signal.signal(signal.SIGALRM, _refresh_alarm)
        signal.setitimer(signal.ITIMER_REAL, budget_s)
    try:
        return survey(families, idle_hours, min_bytes, known, defer_bulk=defer_bulk,
                      deadline=time.monotonic() + budget_s)
    except RefreshDeadlineExceeded:
        global _MEASURE_BUDGET_REACHED
        _MEASURE_BUDGET_REACHED = True
        return []
    finally:
        if own_timer:
            signal.setitimer(signal.ITIMER_REAL, 0)
            signal.signal(signal.SIGALRM, previous_handler)
            if previous_timer != (0.0, 0.0):
                signal.setitimer(signal.ITIMER_REAL, *previous_timer)


def _survey(families, idle_hours, min_bytes, known, evidence, defer_bulk=False,
            deadline: float | None = None, judge_deadline: float | None = None) -> list[Item]:
    global _MEASURE_BUDGET_REACHED
    _MEASURE_BUDGET_REACHED = False
    _NESTED_WALKS.clear()
    now = time.time()
    items: list[Item] = []
    known = known if known is not None else {}
    work = round_robin_work(families)
    if defer_bulk:
        work = [(fam, path) for fam, path in work if not fam.bulk_sizes or str(path) in known]
    for fam in families:
        # a few new entries are cheaper to size one by one than by re-walking the whole root
        if fam.bulk_sizes and sum(str(p) not in known for f, p in work if f is fam) >= BULK_SIZE_MIN:
            if deadline is not None and time.monotonic() >= deadline:
                _MEASURE_BUDGET_REACHED = True
                break
            walked = du_children(fam.root)
            if walked is not None:
                known.update({k: v for k, v in walked.items() if k not in known})
    missing = [path for _, path in work if str(path) not in known]
    if deadline is not None and time.monotonic() >= deadline:
        _MEASURE_BUDGET_REACHED = True
        measured = {}
    else:
        measured = _measure_missing(missing, deadline)
        if deadline is not None and time.monotonic() >= deadline:
            _MEASURE_BUDGET_REACHED = True
    # A failed walk is unsized, never zero bytes.  Do not put it in the snapshot or judge it for
    # reclaim; the next report will retry it without allowing a stale zero to hide the tree.
    known.update({path: size for path, size in measured.items() if size is not None})
    global _REFRESH_PROGRESS_KNOWN
    if _REFRESH_PROGRESS_KNOWN is not None:
        _REFRESH_PROGRESS_KNOWN = dict(known)
    work = [(fam, path) for fam, path in work if str(path) in known]
    sizes = [known[str(path)] for _, path in work]
    floors = [min_bytes if fam.min_bytes is None else fam.min_bytes for fam, _ in work]
    judge_deadline = deadline if judge_deadline is None else judge_deadline
    if judge_deadline is None:
        idles: list[float | None] = [(now - item_mtime(fam, path)) / 3600
                                     if size >= floor else 0.0 for (fam, path), size, floor in zip(work, sizes, floors)]
    else:
        # A deadline also covers the live verdict pass, ages included: each candidate's age is read in the verdict
        # loop below, so a pass that runs out of time keeps every candidate it fully judged, not none.
        idles = [None] * len(work)
    if isinstance(evidence, NoEvidence):
        cwds, cmds, blind = [], "", f"no process evidence ({evidence})"
    else:
        try:
            cwds, cmds = evidence if isinstance(evidence, tuple) else evidence.result()
            blind = ""
        except NoEvidence as e:
            cwds, cmds, blind = [], "", f"no process evidence ({e})"
    opened = open_index(cwds)
    references_by_root: dict[str, frozenset[str]] = {}
    archived = archived_seeds() if any(fam.id == "cmux-seeds" for fam, _ in work) else frozenset()
    for (fam, path), size, idle, floor in zip(work, sizes, idles, floors):
        # the verdicts' socket, lock and git checks count against the judge deadline too: what is judged by then
        # is kept (and may be deleted), the rest is left out
        if judge_deadline is not None and time.monotonic() >= judge_deadline:
            _MEASURE_BUDGET_REACHED = True
            break
        if size < floor:
            continue
        if idle is None:
            idle = (now - item_mtime(fam, path)) / 3600
        sp = str(path)
        reasons = []
        if blind:
            reasons.append(blind)
        if fam.id == CMUX_NEXT_CI_FAMILY and not blind:
            if busy_reason := cmux_next_ci_busy(fam, path, opened, cmds):
                reasons.append(busy_reason)
        if fam.id == RUNNER_BUILD_FAMILY and not blind and (why := runner_job_live(fam.root.parent, cmds)):
            reasons.append(why)
        if in_cwd(sp, opened):
            reasons.append("open by a process")
        if named_by(sp, cmds):
            reasons.append("named by a running command")
        if fam.id == "claude-scratchpad" and claude_session_active(path.name, idle_hours * 3600):
            reasons.append("claude session active")
        references = frozenset()
        if fam.reference_root is not None:
            key = os.fspath(fam.reference_root)
            references = references_by_root.setdefault(key, live_artifact_references(fam.reference_root))
            if artifact_referenced(path, references):
                reasons.append("live lease or running job")
        if fam.id == SPM_SCRATCH and spm_scratch_held(path):
            reasons.append("a job holds its lock (owned_spm_scratch.py)")
        if media_tour_dd(fam, path) and media_tour_tag_held(path):
            reasons.append("a media tour holds its slot's tag lock (media_tag_lock.py)")
        if fam.id == CANONICAL_ADMISSION and canonical_root_held(path):
            reasons.append("a job holds its canonical root (root token)")
        if tmp_canonical_root(fam, path) and canonical_root_held(path, whole_root=True):
            reasons.append("a job holds this canonical root (root token)")
        if fam.pressure_only and ACTIVITY_MODE != "pressure":
            reasons.append(("runner build output" if fam.id == RUNNER_BUILD_FAMILY else "package cache")
                           + ": pressure-only policy")
        if fam.git_disposable and (reference := referenced_main_checkout(path, nested=fam.nested_git)):
            reasons.append(reference)
        policy_note = ""
        if ROLE == "devbox" and (fam.id == "xcode-derived-data" or
                (fam.id in ("tmp", "user-tmp") and re.search(r"cmux|terminal-image|derived-data", path.name, re.I))):
            # This is informational; stale build output remains reclaimable on a dev box.
            policy_note = "policy violation: build output on a no-build dev box"
        # The tree walks below cost seconds each on a loaded host, and a recent item is kept anyway,
        # so only an item old enough to delete pays for them (apply re-checks before deleting).
        window = item_window(fam, path, idle_hours, archived)
        keep = keep_verdict(fam, path)
        due, jobs = item_due(fam, idle, window)
        if fam.stale_before is not None and item_mtime(fam, path) <= fam.stale_before:
            due = True
        if jobs is not None:
            reasons_jobs = f"{jobs} host jobs since its last use"
        deletable_age = fam.reclaimable and due
        if deletable_age and holds_socket(path):
            reasons.append("holds a socket")
        if deletable_age and job_busy(fam, path):
            reasons.append("a cmux reload job holds its unit (.cmux-active or .lock)")
        if fam.pressure_only and ACTIVITY_MODE != "pressure":
            verdict = "kept"
        elif not fam.reclaimable:
            verdict = "report-only"
        elif reasons:
            verdict = "in-use"
        elif fam.retired_only and not owner_retired(fam):
            verdict = "report-only"
        elif keep:
            verdict = "kept"
            reasons.append(keep)
        elif reasons:
            verdict = "in-use"
        elif (not git_exempt(fam, path, idle) and (g := family_git_state(fam, path)) != "none"
              and not (g == "git" and fam.git_disposable and due
                       and not (loss := family_git_loss(fam, path)))):
            verdict = "git-checkout" if g == "git" else "unchecked"
            if g == "unchecked":
                reasons.append("too deep or large to rule out a git checkout")
            elif fam.git_disposable and due:
                reasons.append(loss)
        elif not due:
            verdict = "recent"
            if media_tour_warm_slot(fam, path):
                reasons.append("a warm media tour slot on a media host: kept by role, only under the runner floor")
        else:
            verdict = "reclaimable"
            if media_tour_stray(fam, path):
                reasons.append("media tour DerivedData on a host no tour is routed to (no gui or session runner)")
            elif media_tour_warm_slot(fam, path):
                reasons.append("a warm media tour slot, under the runner floor: last, least recently used first")
            if path.name in archived and fam.id == "cmux-seeds":
                reasons.append("the seed archive holds it")
            if cmux_next_ci_host_root(fam, path):
                reasons.append("the per-host cmux-next build root, last of everything: "
                               + (f"idle {float(POLICY['cmux_next_ci_host_idle_hours']):g}h+"
                                  if idle >= float(POLICY["cmux_next_ci_host_idle_hours"])
                                  else "only while free stays under the runner floor"))
            elif cmux_next_ci_floor_slot(fam, path):
                reasons.append("an idle runner's whole cmux-next slot, under the runner floor (its next job builds "
                               "cold; least recently used first, after every generated child)")
            elif cmux_next_cap_only(fam, path, idle, idle_hours):
                reasons.append(f"cmux-next-ci is {gib(cmux_next_ci_over()).strip()} over its size cap "
                               "(least recently used first)")
            if mirror_due(fam, path, idle):
                reasons.append(f"idle {fam.mirror_idle_hours:g}h+: its checkouts are mirrors "
                               "(unpushed commits go to a verified bundle in ~/archive first)")
        if jobs is not None and verdict in ("recent", "reclaimable"):
            reasons.append(reasons_jobs)
        if policy_note:
            reasons.append(policy_note)
        items.append(Item(fam.id, sp, size, round(idle, 1), verdict, reasons, jobs,
                          platform_label(fam)))
    items.sort(key=lambda i: i.bytes, reverse=True)
    return items


def free_bytes(path: Path) -> tuple[int, int]:
    u = shutil.disk_usage(path)
    return u.free, u.total


def filesystem_receipt_state(fss: list[Fs] | dict[int, Fs]) -> list[dict[str, Any]]:
    """Capture the bounded filesystem state used by an eviction receipt.

    The ``Fs`` values collected before a sweep are the authoritative starting
    observation. A post-sweep observation is taken separately; callers must not
    infer physical reclamation from the logical sizes of deleted catalogue items.
    """
    values = list(fss.values()) if isinstance(fss, dict) else list(fss)
    return [{"dev": fs.dev, "mount": fs.mount, "free": fs.free, "total": fs.total,
             "low": fs.low, "target": fs.target, "under": fs.under, "observed": True}
            for fs in values]


def reobserve_filesystems(fss: list[Fs] | dict[int, Fs]) -> tuple[list[Fs], list[dict[str, Any]]]:
    """Re-read free space after an apply and retain an explicit failure marker."""
    values = list(fss.values()) if isinstance(fss, dict) else list(fss)
    updated: list[Fs] = []
    state: list[dict[str, Any]] = []
    for fs in values:
        try:
            free, total = free_bytes(Path(fs.mount))
        except (OSError, ValueError) as exc:
            updated.append(fs)
            state.append({"dev": fs.dev, "mount": fs.mount, "free": None, "total": None,
                          "low": fs.low, "target": fs.target, "under": None,
                          "observed": False, "error": exc.__class__.__name__})
            continue
        current = replace(fs, free=free, total=total)
        updated.append(current)
        state.append({"dev": current.dev, "mount": current.mount, "free": current.free,
                      "total": current.total, "low": current.low, "target": current.target,
                      "under": current.under, "observed": True})
    return updated, state


def physical_df_delta(before: list[dict[str, Any]], after: list[dict[str, Any]]) -> dict[str, Any]:
    """Compare before/after free blocks without guessing when either side is missing."""
    old = {str(row.get("dev")): row for row in before if isinstance(row, dict)}
    new = {str(row.get("dev")): row for row in after if isinstance(row, dict)}
    by_dev: dict[str, int | None] = {}
    for dev in sorted(set(old) | set(new)):
        a, b = old.get(dev, {}), new.get(dev, {})
        afree, bfree = a.get("free"), b.get("free")
        by_dev[dev] = bfree - afree if isinstance(afree, int) and isinstance(bfree, int) else None
    known = [delta for delta in by_dev.values() if isinstance(delta, int)]
    complete = len(known) == len(by_dev)
    total = sum(known) if complete else None
    return {"by_dev": by_dev, "bytes": total, "complete": complete,
            "reclaimed_bytes": max(0, total) if isinstance(total, int) else None}


def space(spec: str, total: int) -> int:
    """A threshold as bytes: "60" is 60 GiB, "15%" is 15% of this filesystem's size, and
    "15%:40-150" is that share held between 40 and 150 GiB. LO never lifts it past twice the
    share, so a small disk (a 30 GiB VM) is not left permanently under pressure."""
    spec = str(spec).strip()
    share, _, bounds = spec.partition(":")
    if not share.endswith("%"):
        if bounds:
            raise ValueError(f"bounds need a percentage: {spec!r}")
        return int(float(share) * GIB)
    n = int(total * float(share[:-1]) / 100)
    if bounds:
        lo, sep, hi = bounds.partition("-")
        if not sep:
            raise ValueError(f"bounds are LOW-HIGH GiB: {spec!r}")
        lo_b, hi_b = int(float(lo) * GIB), int(float(hi) * GIB)
        if lo_b > hi_b:
            raise ValueError(f"bounds are LOW-HIGH GiB: {spec!r}")
        n = min(max(n, min(lo_b, 2 * n)), hi_b)
    return n


# A GitHub Actions job in progress (any runner dir: actions-runner, actions-runner-glaeda-2, ...). An
# auto-updated runner's bin is a symlink to bin.<version>, which ps shows resolved.
CI_WORKER = re.compile(r"/actions-runner[^/\s]*/bin(?:\.[0-9.]+)?/Runner\.Worker(?:\s|$)")


def ci_jobs() -> list[str]:
    """Command lines of running CI jobs; empty when ps fails (apply's own evidence then fails closed)."""
    try:
        out = subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [line.strip()[:160] for line in out.splitlines() if CI_WORKER.search(line)]


def emergency_bytes(fs: "Fs", emergency: str, floor_gib: float = 0.0) -> int:
    """The emergency floor on fs: --emergency, lifted on HOME's volume to target_margin_gib above a
    runner's disk floor. A busy mini always has a job running, so below this is the only place pressure
    deletes happen; under the gate's floor they would wait until the runners stopped taking jobs
    (cmux9s, 2026-09-27: every run deferred at 71 GiB free, emergency 46 GiB, floor 50 GiB)."""
    n = space(emergency, fs.total)
    if floor_gib > 0 and not fs.tmpfs and fs.dev == HOME.stat().st_dev:
        n = max(n, min(int((floor_gib + POLICY["target_margin_gib"]) * GIB), fs.total // 2))
    return n


def ci_defer(fss: dict[int, Fs], jobs: list[str], emergency: str, floor_gib: float = 0.0) -> str:
    """Why a pressure run should wait for a running CI job, or "" to go ahead. A bulk delete competes
    with the job's compile for disk and CPU (a 30 GiB delete starved one on a build mini), so it waits
    unless some filesystem under pressure is below the emergency floor (emergency_bytes)."""
    if not jobs:
        return ""
    if any(fs.under and fs.free < emergency_bytes(fs, emergency, floor_gib) for fs in fss.values()):
        return ""
    return f"deferred: a CI job is running ({jobs[0]}); pressure deletes wait unless free drops below {emergency} or {POLICY['target_margin_gib']:g} GiB above a runner floor"


def mount_point(path: Path) -> Path:
    path = Path(os.path.realpath(path))
    dev = path.stat().st_dev
    while path.parent != path and path.parent.stat().st_dev == dev:
        path = path.parent
    return path


@dataclass
class Fs:
    dev: int
    mount: str
    free: int
    total: int
    low: int
    target: int
    tmpfs: bool = False

    @property
    def under(self) -> bool:
        return self.free < self.low


# A glaeda runner's listener gate holds the runner while free disk is under its job-started hook's --min-free-gib,
# and resumes only GATE_DISK_RESUME_GIB (2 GiB) above it. Pressure on a disk must start by then, or a 460 GiB mini
# between the default low (25%:60-200, about 115 GiB) and a 150 GiB floor stays held with nothing freed. The
# target sits target_margin_gib higher, so one run lifts the mini well clear of the floor.
RUNNER_HOOKS = "actions-runner*/glaeda-hooks/job-started.sh"  # glaeda-cmux-runner's default --runner-dir
MIN_FREE_GIB_RE = r"\s--min-free-gib[\s=]+([0-9.eE+-]+)(?=\s|$)"  # the hook's min_free_gib reads the same


def runner_floor_gib(home: Path = HOME) -> float:
    """The highest --min-free-gib among this user's glaeda runner hooks (the last one in each), or 0."""
    floor = 0.0
    for hook in home.glob(RUNNER_HOOKS):
        try:
            values = re.findall(MIN_FREE_GIB_RE, hook.read_text())
            value = float(values[-1]) if values else 0.0
            if math.isfinite(value):
                floor = max(floor, value)
        except (OSError, UnicodeDecodeError, ValueError):
            continue
    return floor


# A fleet reservation hands a host to one person for a while. On a reserved fleet mini only floor-pressure eviction
# runs: no idle sweep, and a pressure run acts only below the runner floor and works only back to the floor plus
# target_margin_gib, so state its holder keeps idle is not aged out. The list is never part of this repository: the
# fleet's own writer puts it on each host, in the home of the user that owns FLEET_ROOT
# (~/.local/share/glaeda/fleet-reservations.json, schema glaeda-fleet-reservations/v1:
# {"expires", "reservations": [{"id", "owner", "hosts": [...], "from", "until"}], "aliases": {host: [...]}}; the
# writer stamps expires 13 h after each write and refreshes it every 6 h). The host-local reservation
# (FLEET_ROOT/reservation.json, glaeda-reservation/v1, the one the runner hook reads) counts too. Fails closed: a
# missing, unreadable, malformed or expired list, or one with no expires, reads as reserved, whatever the
# host-local file says.
FLEET_RESERVATIONS: Path | None = None  # None: fleet_reservations_path(); tests point it at a fixture
FLEET_RESERVATIONS_NAME = ".local/share/glaeda/fleet-reservations.json"
UPDATE_CONFIG = HOME / ".config/glaeda/update.json"
HOST_RESERVATION_LOCAL = FLEET_ROOT / "reservation.json"


def fleet_reservations_path() -> Path:
    """The list in the home of the user that owns FLEET_ROOT (the fleet account, also when this runs as root);
    this user's home when FLEET_ROOT or its owner cannot be read."""
    if FLEET_RESERVATIONS is not None:
        return FLEET_RESERVATIONS
    with contextlib.suppress(OSError, KeyError):
        return Path(pwd.getpwuid(FLEET_ROOT.stat().st_uid).pw_dir) / FLEET_RESERVATIONS_NAME
    return HOME / FLEET_RESERVATIONS_NAME


def reservation_time(value: Any) -> float:
    """An ISO 8601 time (Z or an offset; a naive one is UTC) as Unix seconds; ValueError otherwise."""
    if not isinstance(value, str) or not value:
        raise ValueError(f"not an ISO 8601 time: {value!r}")
    text = value.strip()
    text = text[:-1] + "+00:00" if text[-1:] in "Zz" else text
    import datetime as _dt
    when = _dt.datetime.fromisoformat(text)
    return (when if when.tzinfo else when.replace(tzinfo=_dt.timezone.utc)).timestamp()


def host_names() -> set[str]:
    """This host's names as the registry spells them: glaeda-update's configured host, and the machine name without
    .local, lowercased."""
    names = {platform.node().split(".")[0].lower()}
    with contextlib.suppress(OSError, ValueError, AttributeError):
        host = json.loads(UPDATE_CONFIG.read_text()).get("host")
        if isinstance(host, str) and host:
            names.add(host.lower())
    return {n for n in names if n}


def _str_list(value: Any, what: str) -> list[str]:
    if not isinstance(value, list) or not all(isinstance(v, str) and v for v in value):
        raise ValueError(f"{what} must be a list of names")
    return value


def host_reservation(now: float | None = None, path: Path | None = None, names: set[str] | None = None,
                     local: Path | None = None) -> str:
    """Why this host is reserved now ("" when it is not): an active fleet reservation naming it (or an alias), an
    active host-local reservation, or a reservation list that is missing, unreadable or malformed anywhere."""
    now = time.time() if now is None else now
    names = host_names() if names is None else {n.lower() for n in names}
    try:
        doc = json.loads((fleet_reservations_path() if path is None else path).read_text())
        if not isinstance(doc, dict):
            raise ValueError("malformed")
        entries, aliases = doc["reservations"], doc.get("aliases", {})
        if not isinstance(entries, list) or not isinstance(aliases, dict):
            raise ValueError("malformed")
        if reservation_time(doc["expires"]) <= now:  # KeyError without one: the writer stopped refreshing it
            return f"fleet reservations expired at {doc['expires']}; kept as reserved"
        alias = {str(h).lower(): {a.lower() for a in _str_list(v, "aliases")} for h, v in aliases.items()}
        hit = ""
        for e in entries:  # every entry is checked, so one malformed entry anywhere fails closed
            if not isinstance(e, dict):
                raise ValueError("malformed entry")
            hosts = {h.lower() for h in _str_list(e["hosts"], "hosts")}
            hosts |= {a for h in list(hosts) for a in alias.get(h, ())}
            start, end = reservation_time(e["from"]), reservation_time(e["until"])
            if start >= end:
                raise ValueError("from must be before until")
            if not hit and names & hosts and start <= now <= end:
                hit = f"reserved for {e.get('owner', '?')} until {e['until']} ({e.get('id', '?')})"
        if hit:
            return hit
    except (OSError, ValueError, KeyError, TypeError) as error:
        return f"fleet reservations unreadable ({type(error).__name__}); kept as reserved"
    marker = HOST_RESERVATION_LOCAL if local is None else local
    try:  # a marker that is there but cannot be read or understood holds the host, as host_busy reads it
        try:
            text = marker.read_text()
        except FileNotFoundError:
            return ""  # only a marker that is certainly absent holds nothing
        held = json.loads(text)
        since, until = held["since"], held["until"]
        if (held.get("schema") != "glaeda-reservation/v1" or not all(
                isinstance(v, int) and not isinstance(v, bool) for v in (since, until))):
            raise ValueError("not a glaeda-reservation/v1 marker")
    except (OSError, ValueError, TypeError, AttributeError, KeyError) as error:
        return f"host reservation marker unreadable ({type(error).__name__}); kept as reserved"
    if now < until:  # the runner hook's rule: a marker holds from when it is written until until, since or not
        return f"host reservation by {held.get('owner', '?')} until {until}"
    return ""


# The ages before DEFAULT_AGE_HOURS (2026-10-26). A host a fleet reservation holds keeps them (and gets only
# floor-pressure eviction, _main_impl): its holder's idle state is theirs until the reservation lapses, when the 12 h
# ages apply by themselves. Family minimums that read DEFAULT_AGE_HOURS take its legacy value, 24 h.
LEGACY_AGES = {"DEFAULT_AGE_HOURS": 24.0, "KEPT_BUILD_IDLE_HOURS": 24.0, "IDLE_SWEEP_HOURS": 24.0,
               "PARKED_NO_LOG_IDLE_HOURS": 168.0, "CMUX_NEXT_CI_MIN_IDLE_HOURS": 72.0,
               "CANONICAL_ADMISSION_IDLE_HOURS": 24.0, "IDLE_SEED_HOURS": 12.0, "RUNTIME_IDLE_DAYS": 14.0,
               "CHECKOUT_BUILD_IDLE_HOURS": 24.0, "TMP_TEST_RESIDUE_IDLE_HOURS": 48.0,
               "RUNNER_STALE_CHECKOUT_HOURS": float("inf"), "RUNNER_CACHE_IDLE_HOURS": 168.0,
               "CMUX_JOB_MIRROR_HOURS": 168.0, "SIM_DEVICE_IDLE_HOURS": float("inf"), "RUNNER_CHECKOUT_BLOAT_RATIO": float("inf")}
LEGACY_POLICY = {"soft_idle_hours": 24.0, "stale_marker_max_hours": 48.0, "cmux_next_ci_host_idle_hours": 48.0}


def keep_legacy_ages() -> None:
    """Put back the pre-12 h ages for this run (a reserved host). A POLICY key disk-policy.json sets stays its own,
    even one set to the new default; so does one already changed in this run."""
    globals().update(LEGACY_AGES)
    explicit = policy_overrides()
    for key, value in LEGACY_POLICY.items():
        if key not in explicit and POLICY.get(key) == POLICY_DEFAULTS.get(key):
            POLICY[key] = value


def filesystems(fams: list[Family], low: str, target: str,
                tmpfs_low: str = "75%", tmpfs_target: str = "90%", floor_gib: float = 0.0,
                reserved: bool = False) -> dict[int, Fs]:
    out: dict[int, Fs] = {}
    for f in fams:
        dev = f.root.stat().st_dev
        if dev not in out:
            free, total = free_bytes(f.root)
            tmpfs = not DARWIN and fs_type(f.root) == "tmpfs"
            lo, tg = (tmpfs_low, tmpfs_target) if tmpfs else (low, target)
            lo_b, tg_b = space(lo, total), space(tg, total)
            # a runner's disk floor (runner_floor_gib) lifts both on HOME's volume, where the gate measures it,
            # never past half the disk, as space() keeps a small disk from permanent pressure; a reserved host's
            # pressure starts at the floor itself, not the floor plus low_margin_gib
            if floor_gib > 0 and not tmpfs and dev == HOME.stat().st_dev:
                lo_margin = 0.0 if reserved else POLICY["low_margin_gib"]
                lo_b = max(lo_b, min(int((floor_gib + lo_margin) * GIB), total // 2))
                tg_b = max(tg_b, min(int((floor_gib + POLICY["target_margin_gib"]) * GIB), total // 2))
            out[dev] = Fs(dev, str(mount_point(f.root)), free, total, lo_b, tg_b, tmpfs)
    return out


def gib(n: int) -> str:
    return f"{n / GIB:6.1f}G"


ACCOUNTING_MAX_AGE_S = 6 * 3600
_ACCOUNTING_MEM: dict[tuple[int, str], list[dict[str, Any]]] = {}
_ACCOUNTING_COVERAGE_MEM: dict[tuple[int, str], tuple[float, list[dict[str, Any]]]] = {}
_APFS_CONTAINER_MEM: dict[str, dict[str, Any]] = {}


def _accounting_cache() -> dict[str, Any]:
    try:
        doc = json.loads(ACCOUNTING.read_text())
        return doc if isinstance(doc, dict) else {}
    except (OSError, ValueError):
        return {}


def _safe_cached_coverage(value: Any) -> list[dict[str, Any]] | None:
    """Accept only the redacted coverage shape; old/path-bearing rows are rescanned."""
    if not isinstance(value, list):
        return None
    for row in value:
        if not isinstance(row, dict) or not isinstance(row.get("scope"), str):
            return None
        for child in row.get("children", []):
            if (not isinstance(child, dict) or not isinstance(child.get("category"), str)
                    or "path" in child):
                return None
    return value


def apfs_container_capacity(mount: str, now: float | None = None) -> dict[str, Any] | None:
    """Read APFS container capacity without treating it as volume or reclaimable space.

    `df` reports the Data volume's free blocks. `diskutil info -plist` also reports free
    capacity in the enclosing APFS container, which can differ because the container holds
    sibling volumes and snapshots. This is observation only and is cached for the same six
    hour window as the bounded accounting walk.
    """
    if not DARWIN:
        return None
    now = time.time() if now is None else now
    cached = _APFS_CONTAINER_MEM.get(mount)
    if cached is not None and now - float(cached.get("at", 0)) < ACCOUNTING_MAX_AGE_S:
        return dict(cached)
    def unavailable() -> dict[str, Any]:
        entry = {"status": "unavailable", "at": now}
        _APFS_CONTAINER_MEM[mount] = entry
        return dict(entry)
    try:
        result = subprocess.run(["/usr/sbin/diskutil", "info", "-plist", mount],
                                capture_output=True, timeout=15, check=False)
        if result.returncode != 0:
            return unavailable()
        info = plistlib.loads(result.stdout)
        total = int(info["APFSContainerSize"])
        free = int(info["APFSContainerFree"])
        if total < 0 or free < 0 or free > total:
            return unavailable()
    except (OSError, ValueError, TypeError, KeyError, plistlib.InvalidFileException,
            subprocess.SubprocessError):
        return unavailable()
    entry = {"status": "observed", "total": total, "free": free,
             "used": total - free, "at": now}
    _APFS_CONTAINER_MEM[mount] = entry
    return dict(entry)


def accounting_coverage(dev: int, now: float) -> list[dict[str, Any]]:
    """Collect bounded, report-only Data-volume categories for the operator view.

    The rows intentionally overlap (Data -> Users -> Users/Shared). Each row names its
    scope and completeness so the UI can show where the bytes live without pretending
    that their sum is a physical total.
    """
    if not DARWIN or RUNNER_CACHE_PROFILE:
        return []
    rows: list[dict[str, Any]] = []
    shared_children: dict[str, int] | None = None
    shared_complete = False
    for scope, root in (*DARWIN_ACCOUNTING_ROOTS, *shared_fleet_roots(), *runner_home_roots()):
        try:
            if root.stat().st_dev != dev or not _measurement_path_allowed(root):
                continue
        except OSError:
            continue
        if scope.startswith("shared-fleet/") and shared_children is not None:
            # The parent walk already measured each direct child. Reuse those bytes instead of
            # walking the same cache or build tree again for every explanatory nested row.
            name = scope.split("/", 1)[1]
            size = sum(value for path, value in shared_children.items()
                       if Path(path).name == name)
            children, complete = ({str(root): size}, shared_complete) if size else ({}, shared_complete)
        else:
            # This is a report-only lower-bound walk.  An unreadable or slow accounting root is
            # already surfaced through the coverage gap; it cannot block or veto an eviction.
            result = du_children_with_status(root, record_timeout=False)
            if result is None:
                continue
            children, complete = result
            if scope == "shared-fleet":
                shared_children, shared_complete = children, complete
        # Never emit user-home names or paths. The Users walk is for accounting only and is
        # deliberately reduced to an aggregate private bucket plus the explicitly shared tree.
        if scope == "data-users":
            private_bytes = sum(size for path, size in children.items()
                                if Path(path).name != "Shared")
            shared_bytes = sum(size for path, size in children.items()
                               if Path(path).name == "Shared")
            children_out = []
            if private_bytes:
                children_out.append({"category": "private-user-data", "bytes": private_bytes,
                                     "private": True, "classification": "private"})
            if shared_bytes:
                children_out.append({"category": "shared-users-data", "bytes": shared_bytes,
                                     "private": False, "classification": "shared-runner"})
        elif scope == "runner-home":
            children_out = []
            for path, size in sorted(children.items(), key=lambda kv: -kv[1])[:32]:
                name = Path(path).name
                if name == "cmux-browser-fleet":
                    classification = "build"
                elif name.startswith("actions-runner"):
                    classification = "runner-work"
                elif name in {".cache", ".bun", ".cargo", ".rustup", "go"}:
                    classification = "tool-cache"
                elif name in {"cmux", "nx-jobs", "fun", "cmux-browser-client-kits", "codex-cli"}:
                    classification = "workspace"
                elif name in {"Desktop", "Documents", "Downloads", "Movies", "Music", "Pictures", "Public"}:
                    classification = "user-owned"
                else:
                    classification = "unclassified"
                children_out.append({"category": name, "bytes": size,
                                     "private": classification == "user-owned",
                                     "classification": classification})
        elif scope == "runner-library-caches":
            children_out = [{"category": f"cache/{Path(path).name}", "bytes": size,
                             "private": False, "classification": "cache"}
                            for path, size in sorted(children.items(), key=lambda kv: -kv[1])[:32]]
        elif scope == "runner-browser-build":
            children_out = [{"category": "browser-build", "bytes": sum(children.values()),
                             "private": False, "classification": "build"}] if children else []
        elif scope == "shared-fleet":
            children_out = []
            for path, size in sorted(children.items(), key=lambda kv: -kv[1])[:32]:
                name = Path(path).name
                if name in {"cache", "xcode"}:
                    classification = "shared-cache" if name == "cache" else "macos-build"
                elif name in {"ci", "ci-ios"}:
                    classification = "macos-ci"
                elif name == "node-products":
                    classification = "shared-node-products"
                else:
                    classification = "shared-fleet"
                children_out.append({"category": name, "bytes": size,
                                     "private": False, "classification": classification})
        elif scope.startswith("shared-fleet/"):
            name = scope.split("/", 1)[1]
            classification = ("shared-cache" if name == "cache" else
                              "macos-build" if name == "xcode" else
                              "macos-ci" if name in {"ci", "ci-ios"} else
                              "shared-node-products" if name == "node-products" else
                              "shared-fleet")
            children_out = [{"category": name, "bytes": sum(children.values()),
                             "private": False, "classification": classification}] if children else []
        else:
            children_out = []
            for path, size in sorted(children.items(), key=lambda kv: -kv[1])[:32]:
                private = scope == "data-volume" and Path(path).name == "Users"
                children_out.append({"category": "private-user-data" if private else Path(path).name,
                                     "bytes": size, "private": private,
                                     "classification": "private" if private else "unclassified"})
        rows.append({"scope": scope, "complete": complete,
                     "at": now, "platform": "macos", "children": children_out})
    return rows


def reconciled_known_coverage(coverage: list[dict[str, Any]]) -> int:
    """Return complete shared-runner bytes without summing overlapping coverage rows.

    ``data-users-shared`` and ``shared-fleet`` describe the same tree at different
    levels.  The child scopes below ``shared-fleet`` are useful for labels, but adding
    them to either parent would inflate the physical total.  Keep the largest complete
    shared-runner view and leave private or incomplete user-home rows outside this
    reconciliation.  This is accounting only; it never changes an eviction verdict.
    """
    totals: list[int] = []
    for row in coverage:
        if not isinstance(row, dict) or not row.get("complete"):
            continue
        if row.get("scope") not in {"data-users-shared", "shared-fleet"}:
            continue
        total = sum(int(child.get("bytes", 0)) for child in row.get("children", [])
                    if isinstance(child, dict) and isinstance(child.get("bytes"), (int, float))
                    and child.get("bytes", 0) >= 0)
        if total:
            totals.append(total)
    return max(totals, default=0)


# Whole-volume census: a report-only, once-a-day pass that sizes every directory of the Data volume no
# family or fixed accounting root already sizes, so `accounting_gap` names its bytes instead of leaving
# half the volume unexplained (Leo, 2026-10-27: "and how can <100gb be free on >256gb minis all the time").
# It walks top-down: a directory that is sized is skipped, a directory that holds sized paths is opened and
# its loose files counted, and any other directory gets one throttled `du` as "unclassified:<path>". A walk
# that times out is opened one level instead, so the next slice resumes at a finer grain. It never deletes,
# never uses sudo, and a root-only directory is reported as "unreadable:<path>" with du's lower bound.
CENSUS_STATE = HOME / ".cache/glaeda-disk/census.json"
CENSUS_LOCK = HOME / ".cache/glaeda-disk/census.lock"
CENSUS_EVERY_S = 24 * 3600  # a new census starts at most once a day
CENSUS_RESUME_S = 3600  # an unfinished census continues at most hourly, one bounded slice at a time
CENSUS_BUDGET_S = 5 * 60  # wall clock per slice; no new walk starts after it
CENSUS_DU_TIMEOUT_S = 120  # one walk; past it the directory is opened one level instead
CENSUS_SAVE_EVERY_S = 10.0
CENSUS_ROWS_SHOWN = 48
CENSUS_SCOPE = "volume-census"
CENSUS_FILES = ".glaeda-census-files"  # pseudo child naming the loose files of an opened directory
CENSUS_AUTOLAUNCH = True
DATA_VOLUME = Path("/System/Volumes/Data")
APFS_INVISIBLE = "apfs-invisible (open-deleted/purgeable)"


_CENSUS_FIRMLINK_MEM: dict[str, bool] = {}
_PRIVATE_LINKS = ("var", "tmp", "etc")


def _firmlinked(name: str) -> bool:
    """Whether /NAME and the Data volume's NAME are one directory (a firmlink such as /Users or /private)."""
    hit = _CENSUS_FIRMLINK_MEM.get(name)
    if hit is None:
        try:
            a, b = os.stat(Path("/") / name), os.stat(DATA_VOLUME / name)
            hit = (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)
        except OSError:
            hit = False
        _CENSUS_FIRMLINK_MEM[name] = hit
    return hit


def census_canon(path: str) -> str:
    """One name per directory for coverage checks and overlap: /Users/... not /System/Volumes/Data/Users/...,
    /private/var/... not /var/..., so a snapshot size and a census row of the same tree always overlap."""
    path = os.path.abspath(path)
    data = str(DATA_VOLUME)
    if path.startswith(data + "/"):
        rest = path[len(data):]
        if _firmlinked(rest.split("/", 2)[1]):
            path = rest
    parts = path.split("/", 2)
    if len(parts) > 1 and parts[1] in _PRIVATE_LINKS and _private_link(parts[1]):
        path = "/private" + path
    return path


def _private_link(name: str) -> bool:
    """macOS: /var, /tmp and /etc are symlinks into /private; elsewhere they are real directories."""
    key = "private:" + name
    hit = _CENSUS_FIRMLINK_MEM.get(key)
    if hit is None:
        hit = _CENSUS_FIRMLINK_MEM[key] = os.path.realpath("/" + name) == "/private/" + name
    return hit


def census_roots() -> list[Path]:
    if not DARWIN or RUNNER_CACHE_PROFILE:
        return []
    return [DATA_VOLUME] if DATA_VOLUME.is_dir() else []


def load_census(path: Path | None = None) -> dict[str, Any]:
    try:
        doc = json.loads((path or CENSUS_STATE).read_text())
        return doc if isinstance(doc, dict) else {}
    except (OSError, ValueError):
        return {}


def save_census(state: dict[str, Any], path: Path | None = None) -> None:
    path = path or CENSUS_STATE
    with contextlib.suppress(OSError):
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(state, separators=(",", ":")))
        os.replace(tmp, path)


def census_due(state: dict[str, Any], now: float) -> bool:
    if state.get("complete"):
        return now - float(state.get("started_at", 0)) >= CENSUS_EVERY_S
    return now - float(state.get("slice_at", 0)) >= CENSUS_RESUME_S


def census_covered() -> set[str]:
    """Paths glaeda already sizes: every snapshot size and every fixed accounting root that was walked."""
    _, sizes = load_snapshot()
    paths = set(sizes)
    for record in _accounting_cache().values():
        for row in (record.get("top_level") or []) if isinstance(record, dict) else []:
            if isinstance(row, dict) and isinstance(row.get("path"), str):
                paths.add(row["path"])
    return {census_canon(p) for p in paths}


def _census_du_argv(path: Path) -> list[str]:
    # never enter a FileProvider/cloud tree below an unowned directory: du can block in the kernel there
    skips = [arg for name in sorted(MEASURE_SKIP_COMPONENTS)
             for arg in (("-I", name) if DARWIN else (f"--exclude={name}",))]
    argv = ["du", "-xsk", *skips, str(path)]
    if os.path.exists("/usr/sbin/taskpolicy"):
        return ["/usr/sbin/taskpolicy", "-b", *argv]  # background QoS: CPU and I/O throttled
    if ionice := shutil.which("ionice"):
        return [ionice, "-c", "3", *argv]
    return argv


def _census_du(path: Path, timeout: float) -> tuple[int, bool] | None:
    out = _du_output(_census_du_argv(path), allow_nonzero=True, record_timeout=False, timeout=timeout)
    if out is None:
        return None
    lines = out.splitlines()
    sized = [line.split(None, 1) for line in lines if not line.startswith("du:")]
    sized = [fields for fields in sized if len(fields) == 2 and fields[0].isdigit()]
    if not sized:
        return None
    return int(sized[-1][0]) * 1024, not any(line.startswith("du:") for line in lines)


def census_pass(roots: list[Path], covered: set[str], state: dict[str, Any] | None = None, *,
                budget_s: float = CENSUS_BUDGET_S, now: float | None = None, clock=time.monotonic,
                path: Path | None = None) -> dict[str, Any]:
    """Run one bounded slice of the census, resuming ``state`` and saving progress to ``path``."""
    now = time.time() if now is None else now
    state = dict(state or {})
    try:
        root_dev = roots[0].stat().st_dev if roots else None
    except OSError:
        root_dev = None
    if state.get("pending") and not state.get("complete") and state.get("dev") != root_dev:
        state = {"last": state.get("last")}  # the volume changed under an unfinished census: start over
    if not state.get("pending") or state.get("complete"):
        last = ({"rows": state.get("rows", {}), "completed_at": state.get("completed_at"),
                 "dev": state.get("dev")} if state.get("complete") else state.get("last"))
        try:
            dev = roots[0].stat().st_dev if roots else None
        except OSError:
            dev = None
        state = {"schema": "glaeda-disk-census/v1", "started_at": now, "dev": dev, "complete": False,
                 "pending": [str(r) for r in reversed(roots)], "rows": {}, "last": last}
    state["slice_at"] = now
    save_census(state, path)  # a launcher reading the state now sees this slice and does not start another
    skipped_covered: list[str] = state.setdefault("covered_skips", [])
    skipped_files: list[str] = state.setdefault("covered_files", [])
    ancestors = {str(parent) for p in covered for parent in Path(p).parents}
    pending: list[str] = state["pending"]  # a stack: the next directory is the last entry
    rows: dict[str, list[Any]] = state["rows"]
    dev = state.get("dev")
    deadline = clock() + budget_s
    saved = clock()

    # directories opened part way, each with where to go on: a child opened meanwhile has its own entry
    cursor: dict[str, Any] = state.setdefault("cursors", {})

    def expand(current: Path) -> bool:
        """Open one directory, reading its entries one at a time; False means the slice ended inside it and
        ``cursor`` holds how far it got, so the next slice goes on from there instead of starting it over."""
        key = str(current)
        part = cursor.get(key)
        after, files = (str(part["after"]), int(part["files"])) if part else ("", 0)
        try:
            if not part:
                files = os.lstat(current).st_blocks * 512
            # names in sorted order, so a resumed slice goes on after the last name it read: an entry added
            # or removed meanwhile can be missed by this census, never counted twice
            names = sorted(name for name in os.listdir(current) if name > after)
        except OSError:
            probe = _census_du(current, max(1.0, min(CENSUS_DU_TIMEOUT_S, deadline - clock())))
            rows[key] = [probe[0] if probe else 0, "unreadable", False]
            return True
        children: list[str] = []
        for name in names:
            if clock() >= deadline:
                cursor[key] = {"after": after, "files": files}
                pending.append(key)
                pending.extend(sorted(children, reverse=True))
                return False
            after = name
            entry_path = os.path.join(current, name)
            child = census_canon(entry_path)
            try:
                est = os.lstat(entry_path)
            except OSError:
                rows[child] = [0, "unreadable", False]  # vanished or not ours to stat: named, never dropped
                continue
            if stat.S_ISDIR(est.st_mode):
                if dev is not None and est.st_dev != dev:
                    continue  # another volume mounted here
                if name in MEASURE_SKIP_COMPONENTS:
                    rows[child] = [0, "skipped", False]  # FileProvider: du can block in the kernel there
                else:
                    children.append(child)
            elif child not in covered:  # a sized file is counted by its own size, not again here
                files += est.st_blocks * 512
            else:
                skipped_files.append(child)
        cursor.pop(key, None)
        rows[str(current / CENSUS_FILES)] = [files, "unclassified", True]
        pending.extend(sorted(children, reverse=True))
        return True

    try:
        while clock() < deadline:
            if not pending:
                # a directory skipped because it was sized is walked after all if that size has since gone
                back = [p for p in skipped_covered if p not in covered]
                if not back:
                    break
                pending.extend(back)
                skipped_covered[:] = [p for p in skipped_covered if p in covered]
            current = Path(pending.pop())
            key = str(current)
            if key in covered:
                skipped_covered.append(key)
                continue
            if key in ancestors or key in [str(r) for r in roots] or key in cursor:
                if not expand(current):
                    break
            else:
                # One row per directory nothing sizes (its subtree is that row): the census names where the
                # unexplained bytes are at the first level glaeda does not already own, not every leaf.
                result = _census_du(current, max(1.0, min(CENSUS_DU_TIMEOUT_S, deadline - clock())))
                if result is None:
                    if clock() >= deadline:
                        pending.append(key)  # the slice ran out during the walk: the next one retries it
                        break
                    if not expand(current):  # timed out: opened one level instead, so each piece is smaller
                        break
                else:
                    size, complete = result
                    rows[key] = [size, "unclassified" if complete else "unreadable", complete]
            if clock() - saved >= CENSUS_SAVE_EVERY_S:
                save_census(state, path)
                saved = clock()
    finally:
        state["complete"] = not pending and not any(p not in covered for p in skipped_covered)
        if state["complete"]:
            # a sized file whose size has since gone from the snapshot goes back into its directory's files row
            for gone in [f for f in skipped_files if f not in covered]:
                with contextlib.suppress(OSError):
                    row = rows.setdefault(str(Path(gone).parent / CENSUS_FILES), [0, "unclassified", True])
                    row[0] += os.lstat(gone).st_blocks * 512
            skipped_files[:] = [f for f in skipped_files if f in covered]
        if state["complete"]:
            state["completed_at"] = now
            state["last"] = None
        save_census(state, path)
    return state


def census_for(dev: int, state: dict[str, Any] | None = None) -> dict[str, Any] | None:
    """The newest complete census of this volume (or the one in progress before any completed)."""
    state = load_census() if state is None else state
    if state.get("complete") and state.get("dev") == dev:
        return {"rows": state.get("rows", {}), "complete": True, "at": state.get("completed_at")}
    last = state.get("last")
    if isinstance(last, dict) and last.get("dev") == dev and last.get("rows"):
        return {"rows": last["rows"], "complete": True, "at": last.get("completed_at")}
    if state.get("dev") == dev and state.get("rows"):
        return {"rows": state["rows"], "complete": False, "at": state.get("slice_at")}
    return None


def _census_label(key: str, kind: str) -> str:
    path = Path(census_canon(key))
    shown = f"{path.parent} (files)" if path.name == CENSUS_FILES else str(path)
    parts = Path(shown).parts
    if parts[:4] == ("/", "System", "Volumes", "Data"):
        parts = ("/", *parts[4:])  # an unfirmlinked physical path is redacted the same way
    if len(parts) >= 3 and parts[1] == "Users" and parts[2] not in {HOME.name, "Shared"}:
        return f"{kind}:private-user-data"  # never name another account's home
    return f"{kind}:{shown}"


def census_catalogue(census: dict[str, Any] | None) -> list[tuple[Path, int, str]]:
    if not census:
        return []
    out = []
    for key, row in census["rows"].items():
        if not (isinstance(row, list) and row and isinstance(row[0], int) and row[0] > 0):
            continue
        # a tree deleted since the census (an apply, a finished job) no longer holds its bytes
        if not os.path.lexists(os.path.dirname(key) if key.endswith("/" + CENSUS_FILES) else key):
            continue
        out.append((Path(census_canon(key)), int(row[0]), "census"))
    return out


def census_coverage_row(census: dict[str, Any]) -> dict[str, Any]:
    merged: dict[str, list[Any]] = {}
    for key, row in census["rows"].items():
        label = _census_label(key, str(row[1]))
        hit = merged.setdefault(label, [0, row[1]])
        hit[0] += int(row[0])
    ranked = sorted(merged.items(), key=lambda kv: -kv[1][0])
    children = [{"category": label, "bytes": size, "private": label.endswith(":private-user-data"),
                 "classification": kind} for label, (size, kind) in ranked[:CENSUS_ROWS_SHOWN]
                if size or kind != "unclassified"]  # an unreadable or skipped tree stays named at 0 bytes
    rest = sum(size for _, (size, _) in ranked[CENSUS_ROWS_SHOWN:])
    if rest:
        children.append({"category": "unclassified:other", "bytes": rest, "private": False,
                         "classification": "unclassified"})
    return {"scope": CENSUS_SCOPE, "complete": census["complete"], "at": census["at"],
            "platform": "macos", "children": children}


def _census_lock():
    try:
        CENSUS_LOCK.parent.mkdir(parents=True, exist_ok=True)
        handle = CENSUS_LOCK.open("a+")
    except OSError:
        return None
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def _background_argv(argv: list[str]) -> list[str]:
    """Run the whole census process at background QoS (macOS) or idle I/O class (Linux), not only its du."""
    if os.path.exists("/usr/sbin/taskpolicy"):
        return ["/usr/sbin/taskpolicy", "-b", *argv]
    if ionice := shutil.which("ionice"):
        return [ionice, "-c", "3", *argv]
    return argv


def launch_background_census() -> bool:
    """Start one detached, throttled census slice when one is due, handing it the lock this process took."""
    if not CENSUS_AUTOLAUNCH or not census_roots() or not census_due(load_census(), time.time()):
        return False
    handle = _census_lock()
    if handle is None:
        return False  # a slice is running
    fd = handle.fileno()
    try:
        subprocess.Popen(_background_argv([sys.executable, os.path.abspath(__file__), "--census",
                                           "--census-lock-fd", str(fd)]),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, start_new_session=True, pass_fds=(fd,))
    except (OSError, subprocess.SubprocessError):
        handle.close()
        return False
    handle.close()  # the child holds the same open file description, and with it the lock
    return True


def census_main(args: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="glaeda-disk --census")
    ap.add_argument("--census", action="store_true")
    ap.add_argument("--census-budget-s", type=float, default=CENSUS_BUDGET_S)
    ap.add_argument("--census-lock-fd", type=int, default=None, help=argparse.SUPPRESS)
    a = ap.parse_args(args)
    with contextlib.suppress(OSError):
        os.nice(19)
    if a.census_lock_fd is not None:
        try:
            handle = os.fdopen(a.census_lock_fd, "a+")
        except (OSError, ValueError):
            handle = None
    else:
        handle = _census_lock()
    if handle is None:
        print("census already running; skipped")
        return 0
    budget = max(1.0, a.census_budget_s)
    # a filesystem call that blocks in the kernel must not keep the lock forever: progress is saved every
    # CENSUS_SAVE_EVERY_S, and the default SIGALRM action ends the process well past the slice budget
    signal.alarm(int(budget + 3 * CENSUS_DU_TIMEOUT_S))
    with handle:
        roots, state = census_roots(), load_census()
        if not roots or not census_due(state, time.time()):
            print("census not due; skipped")
            return 0
        state = census_pass(roots, census_covered(), state, budget_s=max(1.0, a.census_budget_s))
    print(f"census {'complete' if state['complete'] else 'paused'}: {len(state['rows'])} rows, "
          f"{len(state['pending'])} directories left")
    return 0


def top_level_catalogued(catalogued: list[tuple[Path, int, str]]) -> list[tuple[Path, int, str]]:
    """Keep the highest-level item from each overlapping path set.

    ``filesystem_accounting`` receives a flat catalogue that can contain a
    report-only checkout and a reclaimable build below it.  The old scan asked
    every candidate whether it was below every selected path, which made a
    large refresh quadratic in the number of catalogue items.  The path depth
    is bounded, so checking the candidate's own ancestors against a set keeps
    the same lexical overlap semantics in O(items * path depth).
    """
    selected: list[tuple[Path, int, str]] = []
    selected_paths: set[Path] = set()
    selected_parts: set[tuple[str, ...]] = set()
    for row in catalogued:
        path = row[0]
        parts = path.parts
        if path in selected_paths or any(parts[:depth] in selected_parts for depth in range(1, len(parts))):
            continue
        selected.append(row)
        selected_paths.add(path)
        selected_parts.add(parts)
    return selected


def filesystem_accounting(fss: list[Fs], items: list[Item],
                          sizes: dict[str, int] | None = None) -> list[dict[str, Any]]:
    """Show df-used minus catalogued bytes and bounded top-level volume usage.

    ``measured`` is every sized byte on the volume, counting the outermost path of each overlapping set
    once: catalogue items, every other snapshot size (``sizes``, including candidates below the report
    floor), the fixed accounting roots and the whole-volume census rows.

    The top-level walk is cached for six hours. Item sizes stay the authoritative measured catalog;
    this report deliberately calls out anything the catalog does not own so a zero reclaimable result
    cannot hide a full volume.
    """
    # The runner-account profile has a deliberately different catalogue. Do not
    # reuse the normal user's broad accounting snapshot or overwrite it with a
    # profile-only lower bound.
    cached = {} if RUNNER_CACHE_PROFILE else _accounting_cache()
    now = time.time()
    out: list[dict[str, Any]] = []
    cache_records: dict[str, dict[str, Any]] = {}
    for fs in fss:
        key = str(fs.dev)
        hit = cached.get(key) if isinstance(cached.get(key), dict) else None
        mem = None if RUNNER_CACHE_PROFILE else _ACCOUNTING_MEM.get((fs.dev, fs.mount))
        if mem is not None:
            top = mem
            top_at = float(hit.get("at", 0)) if hit else 0.0
        elif RUNNER_CACHE_PROFILE:
            # The enrolled-runner profile is intentionally an allowlist. Its roots are already
            # represented by surveyed items; walking each root again for a volume-level top list
            # defeats the profile's bounded contract and can re-trigger a recursive du timeout.
            top = [{"path": i.path, "bytes": i.bytes} for i in items if i.bytes > 0][:32]
            top_at = now
        elif not DARWIN:
            # Linux test and development hosts do not need a / walk for the macOS mini report.
            top = []
            top_at = now
        elif hit and now - float(hit.get("at", 0)) < ACCOUNTING_MAX_AGE_S and hit.get("mount") == fs.mount:
            top = hit.get("top_level") if isinstance(hit.get("top_level"), list) else []
            top_at = float(hit.get("at", 0))
        else:
            # Account only bounded, known-heavy roots.  In particular, never call du on the
            # filesystem mount itself: ``du -d1 /`` can enter a FileProvider/TCC directory and
            # block in the kernel while holding the eviction lock.
            top_map: dict[str, int] = {}
            for root in fixed_measurement_roots():
                try:
                    if root.stat().st_dev != fs.dev or not _measurement_path_allowed(root):
                        continue
                except OSError:
                    continue
                # Top-level accounting is explanatory only.  Keep an incomplete root out of the
                # eviction-timeout finding; the accounting gap remains visible in the summary.
                size = du_bytes(root, record_timeout=False)
                if size is not None:
                    top_map[str(root)] = size
            if not top_map:
                # Keep a prior complete reading, if any, but leave its timestamp old so a later
                # report retries.  An unsized root must not erase accounting or look fresh.
                top = hit.get("top_level") if hit and isinstance(hit.get("top_level"), list) else []
                top_at = float(hit.get("at", 0)) if hit else 0.0
            else:
                top = [{"path": p, "bytes": n} for p, n in sorted(top_map.items(), key=lambda kv: -kv[1])[:32]]
                top_at = now
        _ACCOUNTING_MEM[(fs.dev, fs.mount)] = top
        measured = 0
        catalogued: list[tuple[Path, int, str]] = []
        for i in items:
            try:
                if Path(i.path).stat().st_dev == fs.dev:
                    catalogued.append((Path(i.path), i.bytes, i.verdict))
            except OSError:
                continue
        # A parent catalog item already includes every nested item. Count only the highest-level path
        # in each overlapping set so the unmeasured figure remains an accounting gap, not an overlap artifact.
        ordered = sorted(catalogued, key=lambda pair: (len(pair[0].parts), str(pair[0])))
        selected: list[Path] = []
        blocked_by_verdict: dict[str, int] = {}
        for path, size, verdict in sorted(catalogued, key=lambda pair: (len(pair[0].parts), str(pair[0]))):
            if any(path == parent or parent in path.parents for parent in selected):
                continue
            selected.append(path)
            measured += size
            if verdict != "reclaimable":
                blocked_by_verdict[verdict] = blocked_by_verdict.get(verdict, 0) + size
        blocked = sum(blocked_by_verdict.values())
        unchecked = blocked_by_verdict.get("unchecked", 0)
        census = None if RUNNER_CACHE_PROFILE else census_for(fs.dev)
        sized_rows = [(Path(census_canon(str(path))), size, verdict) for path, size, verdict in catalogued]
        listed = {str(path) for path, _, _ in catalogued}
        for path, size in (sizes or {}).items():
            if path in listed or size <= 0:
                continue
            try:
                if Path(path).stat().st_dev == fs.dev:
                    sized_rows.append((Path(census_canon(path)), size, "sized"))
            except OSError:
                continue
        for row in top:
            if isinstance(row, dict) and isinstance(row.get("path"), str) and isinstance(row.get("bytes"), int):
                sized_rows.append((Path(census_canon(row["path"])), row["bytes"], "sized"))
        sized_rows.extend(census_catalogue(census))
        outermost = top_level_catalogued(sorted(sized_rows, key=lambda row: (len(row[0].parts), str(row[0]))))
        measured = sum(size for _, size, _ in outermost)
        shared = Path("/Users/Shared")
        measured_shared = (math.inf if any(path in shared.parents for path, _, _ in outermost) else
                           sum(size for path, size, _ in outermost if path == shared or shared in path.parents))
        # A report-only checkout must not mask a reclaimable build directory nested inside it.
        # Deduplicate reclaimable candidates independently so this number is the bytes the next
        # apply can actually target, rather than every item carrying a reclaimable verdict.
        reclaimable = sum(size for _, size, _ in top_level_catalogued(
            [row for row in ordered if row[2] == "reclaimable"]))
        used = max(0, fs.total - fs.free)
        coverage_mem = None if RUNNER_CACHE_PROFILE else _ACCOUNTING_COVERAGE_MEM.get((fs.dev, fs.mount))
        cached_coverage = _safe_cached_coverage(hit.get("coverage")) if hit else None
        cached_coverage_at = float(hit.get("coverage_at", 0)) if hit else 0.0
        if RUNNER_CACHE_PROFILE:
            # The profile intentionally has no broad Data-volume coverage scopes.
            coverage, coverage_at = [], 0.0
        elif coverage_mem is not None and now - coverage_mem[0] < ACCOUNTING_MAX_AGE_S:
            coverage = coverage_mem[1]
            coverage_at = coverage_mem[0]
        elif cached_coverage is not None and now - cached_coverage_at < ACCOUNTING_MAX_AGE_S:
            coverage = cached_coverage
            coverage_at = cached_coverage_at
        else:
            coverage = accounting_coverage(fs.dev, now)
            coverage_at = now if coverage else 0.0
        _ACCOUNTING_COVERAGE_MEM[(fs.dev, fs.mount)] = (coverage_at, coverage)
        coverage = [row for row in coverage if row.get("scope") != CENSUS_SCOPE]
        unclassified = max(0, used - measured)
        # The shared-runner coverage rows have no paths: subtract only what they hold beyond the sized
        # paths already measured inside /Users/Shared, or the same bytes would leave the gap twice.
        known_coverage = min(unclassified, int(max(0, reconciled_known_coverage(coverage) - measured_shared)))
        if census is not None:
            coverage = [*coverage, census_coverage_row(census)]
        if census is not None and census["complete"]:
            # The census already sized the shared tree by path, so the path-less coverage rows add nothing.
            gap = unclassified
            unreadable = sum(1 for row in census["rows"].values() if row[1] in ("unreadable", "skipped"))
            residual = APFS_INVISIBLE + (f" and {unreadable} unreadable or skipped dirs (lower bounds)"
                                         if unreadable else "")
        else:
            gap = max(0, unclassified - known_coverage)
            residual = "unwalked (volume census in progress)" if census else "unwalked (no volume census yet)"
        entry = {"dev": fs.dev, "mount": fs.mount, "used": used, "measured": measured,
                 "unmeasured": unclassified, "unclassified": unclassified,
                 "known_coverage": known_coverage,
                 "accounting_gap": gap,
                 "residual": {"category": residual, "bytes": gap},
                 "reclaimable": reclaimable, "blocked": blocked, "unchecked": unchecked,
                 "blocked_by_verdict": blocked_by_verdict, "top_level": top,
                 "scope": "runner-cache-profile" if RUNNER_CACHE_PROFILE else "volume",
                 "container": apfs_container_capacity(fs.mount, now),
                 "coverage": coverage, "coverage_at": coverage_at,
                 "coverage_note": "coverage rows overlap and incomplete rows are lower bounds"}
        out.append(entry)
        cache_records[str(fs.dev)] = {**entry, "at": top_at}
    if not RUNNER_CACHE_PROFILE:
        try:
            ACCOUNTING.parent.mkdir(parents=True, exist_ok=True)
            ACCOUNTING.write_text(json.dumps(cache_records))
        except OSError:
            pass
    return out


EVICTION_CONTENTION_MAX_AGE_S = 60 * 60


def eviction_lock_is_held() -> bool | None:
    """Probe the eviction lock without waiting or changing its ownership.

    ``eviction_contention`` is a receipt from an earlier skipped run, so the
    receipt's PID alone is insufficient evidence: the PID can be reused after
    the owner released the lock.  Return ``None`` when the lock cannot be
    inspected so callers can retain the warning conservatively.
    """
    try:
        fd = os.open(EVICT_LOCK, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return False
    except OSError:
        return None
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        except OSError:
            return None
        return False
    finally:
        os.close(fd)


def read_eviction_contention(receipt: Path) -> dict[str, Any] | None:
    """Read the latest bounded contention receipt while it is still actionable."""
    try:
        with receipt.open("rb") as handle:
            handle.seek(max(0, handle.seek(0, os.SEEK_END) - 128 * 1024))
            lines = handle.read().splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            record = json.loads(line)
        except (TypeError, ValueError):
            continue
        if not isinstance(record, dict) or record.get("family") != "eviction" or record.get("outcome") != "skipped":
            continue
        at_epoch = record.get("at_epoch")
        if not isinstance(at_epoch, (int, float)) or isinstance(at_epoch, bool):
            return None
        if time.time() - at_epoch > EVICTION_CONTENTION_MAX_AGE_S:
            return None
        owner = record.get("owner")
        if not isinstance(owner, dict):
            owner = {}
        owner_pid = owner.get("pid")
        if isinstance(owner_pid, int) and not isinstance(owner_pid, bool) and owner_pid > 0:
            # A completed or crashed sweep can leave its last skip receipt behind.  The PID
            # may also have been reused by an unrelated process, so a live PID is not enough:
            # the owner must still have the eviction lock.  If this process acquired the lock
            # after the skipped run, the old contention is likewise no longer actionable.
            if not _pid_alive(owner_pid):
                return None
            if _EVICT_HANDLE is not None or eviction_lock_is_held() is False:
                return None
        bounded_owner = {key: owner[key] for key in ("state", "pid", "owner", "started_at", "age_s")
                         if key in owner}
        return {"at": record.get("at"), "at_epoch": at_epoch, "owner": bounded_owner}
    return None


def write_eviction_contention_health(receipt: Path) -> None:
    """Refresh only the contention field when a run cannot acquire the eviction lock."""
    contention = read_eviction_contention(receipt)
    try:
        try:
            payload = json.loads(HEALTH_SUMMARY.read_text())
            if not isinstance(payload, dict):
                payload = {}
        except (OSError, ValueError):
            payload = {}
        payload.setdefault("schema", "glaeda-disk/v1")
        if contention is None:
            payload.pop("eviction_contention", None)
        else:
            payload["eviction_contention"] = contention
        HEALTH_SUMMARY.parent.mkdir(parents=True, exist_ok=True)
        tmp = HEALTH_SUMMARY.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(payload, separators=(",", ":")))
        os.replace(tmp, HEALTH_SUMMARY)
    except OSError:
        pass


def write_health_summary(fss: list[Fs], items: list[Item], accounting: list[dict[str, Any]],
                         receipt: Path | None = None) -> None:
    """Write the bounded local summary consumed by mini-health and ci-dash's Health row."""
    try:
        HEALTH_SUMMARY.parent.mkdir(parents=True, exist_ok=True)
        if accounting:
            reclaimable = sum(int(row.get("reclaimable", 0)) for row in accounting)
            blocked = sum(int(row.get("blocked", 0)) for row in accounting)
            unchecked = sum(int(row.get("unchecked", 0)) for row in accounting)
            accounting_gap = sum(int(row.get("accounting_gap", 0)) for row in accounting)
        else:
            # A vanished item must not keep the health row stale after apply. This fallback is
            # mainly for profile-less test hosts where no filesystem accounting row exists.
            live = [i for i in items if os.path.lexists(i.path)]
            reclaimable = sum(i.bytes for i in live if i.verdict == "reclaimable")
            blocked = sum(i.bytes for i in live if i.verdict != "reclaimable")
            unchecked = sum(i.bytes for i in live if i.verdict == "unchecked")
            accounting_gap = 0
        payload = {"schema": "glaeda-disk/v1", "at": int(time.time()),
                   "reclaimable": reclaimable, "blocked": blocked, "unchecked": unchecked,
                   "accounting_gap": accounting_gap,
                   "findings": list(EVICTION_STUCK),
                   "accounting": [dict(x) for x in accounting],
                   "filesystems": [{"mount": x.mount, "free": x.free, "total": x.total,
                                    "under": x.under} for x in fss]}
        if receipt is not None:
            contention = read_eviction_contention(receipt)
            if contention is not None:
                payload["eviction_contention"] = contention
        tmp = HEALTH_SUMMARY.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(payload, separators=(",", ":")))
        os.replace(tmp, HEALTH_SUMMARY)
    except OSError:
        pass


def _owner_command(pid: int) -> str:
    try:
        result = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True,
                                text=True, timeout=10, check=False)
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip()


def _pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def _take_over_stale_evict_owner() -> bool:
    """Stop only an identified, stale glaeda-disk owner so a lost lock cannot wedge evictions."""
    try:
        owner = json.loads(EVICT_OWNER.read_text())
        pid = int(owner.get("pid", 0))
        started = float(owner.get("started_at", 0))
    except (OSError, ValueError, TypeError):
        return False
    if pid == os.getpid() or not started or time.time() - started < EVICT_OWNER_STALE_S:
        return False
    if not _pid_alive(pid):
        # A dead owner has already released flock; retrying the acquisition is sufficient.
        return True
    command = _owner_command(pid)
    if "glaeda-disk" not in command:
        return False
    with contextlib.suppress(OSError):
        os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline and _pid_alive(pid):
        time.sleep(0.05)
    if _pid_alive(pid):
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGKILL)
    return True


def _write_evict_owner() -> None:
    EVICT_OWNER.parent.mkdir(parents=True, exist_ok=True)
    try:
        owner = pwd.getpwuid(os.getuid()).pw_name
    except (KeyError, OSError):
        owner = str(os.getuid())
    payload = {"schema": "glaeda-disk/evict-owner/v1", "pid": os.getpid(),
               "started_at": time.time(), "owner": owner, "command": " ".join(sys.argv)}
    tmp = EVICT_OWNER.with_suffix(f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(payload, separators=(",", ":")))
    os.replace(tmp, EVICT_OWNER)


def acquire_evict_lock():
    """Acquire the eviction lock and publish an owner record for stale-lock recovery."""
    global _EVICT_HANDLE
    EVICT_LOCK.parent.mkdir(parents=True, exist_ok=True)
    handle = EVICT_LOCK.open("a")
    with contextlib.suppress(OSError):
        fcntl.fcntl(handle.fileno(), fcntl.F_SETFD,
                    fcntl.fcntl(handle.fileno(), fcntl.F_GETFD) | fcntl.FD_CLOEXEC)
    for attempt in range(2):
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            _write_evict_owner()
            _EVICT_HANDLE = handle
            return handle
        except BlockingIOError:
            if attempt == 0 and _take_over_stale_evict_owner():
                time.sleep(0.05)
                continue
            handle.close()
            return None
    handle.close()
    return None


def release_evict_lock(handle) -> None:
    global _EVICT_HANDLE
    if handle is None:
        return
    try:
        try:
            owner = json.loads(EVICT_OWNER.read_text())
        except (OSError, ValueError, TypeError):
            owner = {}
        if int(owner.get("pid", -1)) == os.getpid():
            EVICT_OWNER.unlink(missing_ok=True)
        fcntl.flock(handle, fcntl.LOCK_UN)
    finally:
        handle.close()
        if _EVICT_HANDLE is handle:
            _EVICT_HANDLE = None


def _release_evict_lock_at_exit() -> None:
    if _EVICT_HANDLE is not None:
        release_evict_lock(_EVICT_HANDLE)


atexit.register(_release_evict_lock_at_exit)


def report(items: list[Item], fss: list[Fs], limit: int, idle_hours: float,
           notes: dict[str, str] | None = None, fams: dict[str, Family] | None = None,
           accounting: list[dict[str, Any]] | None = None) -> None:
    print(f"role {ROLE}")
    for fs in fss:
        print(f"free {gib(fs.free).strip()} of {gib(fs.total).strip()} "
              f"({100 * fs.free / max(fs.total, 1):.0f}%) on {fs.mount}, pressure below "
              f"{gib(fs.low).strip()}{' (tmpfs: RAM and swap)' if fs.tmpfs else ''}"
              f"{' (under pressure)' if fs.under else ''}")
    print(f"idle window {idle_hours:g}h\n")
    for a in accounting or []:
        print(f"accounting on {a['mount']}: reclaimable {gib(a.get('reclaimable', 0)).strip()}, "
              f"blocked {gib(a.get('blocked', 0)).strip()} "
              f"(unchecked {gib(a.get('unchecked', 0)).strip()}), "
              f"unclassified {gib(a.get('unclassified', a.get('unmeasured', 0))).strip()} "
              f"(df used {gib(a['used']).strip()}, measured {gib(a['measured']).strip()})")
        if isinstance(a.get("residual"), dict):
            print(f"  accounting gap {gib(a['residual'].get('bytes', 0)).strip()}: {a['residual'].get('category')}")
        container = a.get("container") or {}
        if container.get("free") is not None:
            print(f"  APFS container free {gib(container['free']).strip()} of "
                  f"{gib(container.get('total', 0)).strip()} (not volume free or reclaimable)")
        for coverage in a.get("coverage", []):
            scope = coverage.get("scope", "unknown")
            state = "complete" if coverage.get("complete") else "lower bound"
            print(f"  coverage {scope} ({state}, report-only, overlapping categories)")
            for child in coverage.get("children", []):
                category = child.get("category", "unknown")
                private = " private" if child.get("private") else ""
                print(f"    {gib(int(child.get('bytes', 0))).strip()}  {category}{private}")
    by_fam: dict[str, int] = {}
    for i in items:
        by_fam[i.family] = by_fam.get(i.family, 0) + i.bytes
    print("by family")
    for fam, n in sorted(by_fam.items(), key=lambda kv: -kv[1]):
        r = sum(i.bytes for i in items if i.family == fam and i.verdict == "reclaimable")
        note = f"  ({notes[fam]})" if notes and fam in notes else ""
        f = (fams or {}).get(fam)
        if f and f.owner:
            note += f"  owner: {f.owner}" + (" (RETIRED: its service is not loaded)" if owner_retired(f) else "")
        label = f.platform if f and f.platform in PLATFORM_VALUES else "unknown"
        print(f"  {gib(n)}  {fam:20s}  {label:7s} reclaimable {gib(r).strip()}{note}")
    print(f"\ntop {limit}")
    for i in items[:limit]:
        why = f" ({', '.join(i.reasons)})" if i.reasons else ""
        path = i.path.replace(str(HOME), "~")
        print(f"  {gib(i.bytes)}  {i.verdict:12s} {i.idle_hours:6.1f}h  "
              f"{i.platform:7s} {path}{why}")
    for u in sorted(UNREADABLE):
        hint = (f"background jobs need Full Disk Access for {os.path.realpath(sys.executable)}"
                if DARWIN else f"not readable by uid {os.getuid()}; its items are skipped")
        print(f"\ncannot read {u}: permission denied ({hint})", file=sys.stderr)
    total_r = sum(i.bytes for i in items if i.verdict == "reclaimable")
    print(f"\nreclaimable now: {gib(total_r).strip()}  ->  glaeda-disk --apply")


def notify_disk(title: str, body: str) -> None:
    """Best-effort cmux notification; a missing GUI must never change cleanup decisions."""
    binary = next((path for path in ("/usr/local/bin/cmux", "/opt/homebrew/bin/cmux", "/usr/bin/cmux")
                   if os.access(path, os.X_OK)), None)
    if not binary:
        return
    try:
        subprocess.run([binary, "notify", "--title", title[:128], "--body", body[:1024]],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=5, check=False,
                       env={"PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin", "LC_ALL": "C"})
    except (OSError, subprocess.SubprocessError):
        pass

def write_eviction_summary(receipt: Path, operation: str, logical_released: int,
                            before_fs: list[dict[str, Any]], after_fs: list[dict[str, Any]],
                            before_accounting: list[dict[str, Any]],
                            after_accounting: list[dict[str, Any]]) -> dict[str, Any]:
    """Append a before/after receipt for an apply, with physical and logical bytes separate."""
    physical = physical_df_delta(before_fs, after_fs)
    blocked = sum(int(row.get("blocked", 0)) for row in after_accounting)
    unchecked = sum(int(row.get("unchecked", 0)) for row in after_accounting)
    gap = sum(int(row.get("accounting_gap", 0)) for row in after_accounting)
    record = {
        "schema": "glaeda-disk/eviction-summary/v1",
        "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "at_epoch": time.time(),
        "host": platform.node(),
        "family": "eviction",
        "outcome": "completed",
        "operation": operation,
        "logical_released_bytes": logical_released,
        "physical_df_delta_bytes": physical["bytes"],
        "physical_df_reclaimed_bytes": physical["reclaimed_bytes"],
        "physical_observation": physical,
        "blocked_bytes": blocked,
        "unchecked_bytes": unchecked,
        "accounting_gap_bytes": gap,
        "before": {"filesystems": before_fs, "accounting": before_accounting},
        "after": {"filesystems": after_fs, "accounting": after_accounting},
        "findings": list(EVICTION_STUCK),
    }
    try:
        receipt.parent.mkdir(parents=True, exist_ok=True)
        with receipt.open("a") as handle:
            handle.write(json.dumps(record) + "\n")
    except OSError:
        # The stdout receipt remains useful even when its requested path is unavailable.
        pass
    return record


def remove(path: Path, after_rename=None) -> None:
    """Delete path. `after_rename` runs once the tree is out of the way, before the long delete."""
    if toolchain_held(path, fresh=True):
        raise OSError("refusing the job toolchain (toolchain_keep)")
    if path.is_symlink():
        raise OSError("refusing symlink")
    if os.path.ismount(path) or path.lstat().st_dev != path.parent.stat().st_dev:
        raise OSError("refusing a mount point")
    if not path.is_dir():
        path.unlink()
        return
    # Move it out of the way first (same directory, so one atomic rename): a job that starts during a
    # minutes-long delete then finds nothing at the path instead of a half-deleted tree it might reuse.
    # A read-only parent makes the rename fail and apply records the item incomplete: nothing is lost.
    doomed = path.with_name(f"{DELETING_PREFIX}{path.name}-{os.getpid()}")
    os.rename(path, doomed)
    if after_rename is not None:
        after_rename()
    shutil.rmtree(doomed, ignore_errors=False, onerror=_chmod_retry)


def _chmod_retry(func, p, _exc):  # read-only files in SwiftPM/Xcode checkouts
    rwx = stat.S_IWUSR | stat.S_IRUSR | stat.S_IXUSR
    parent = os.path.dirname(p)
    if not os.path.islink(parent):
        os.chmod(parent, rwx)
    if not os.path.islink(p):  # never chmod through a symlink to something outside the tree
        os.chmod(p, rwx)
    func(p)


def archive_transcript(path: Path) -> Path:
    """Atomically detach and compress one old transcript into the Codex archive."""
    relative = path.relative_to(HOME / ".codex")
    destination = HOME / ".codex" / "archive" / relative
    destination = destination.with_name(destination.name + ".gz")
    destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(destination.parent, 0o700)
    holding = path.with_name(f".{path.name}.glaeda-archive-{os.getpid()}")
    temporary = destination.with_name(f".{destination.name}.glaeda-{os.getpid()}.tmp")
    os.rename(path, holding)
    try:
        with holding.open("rb") as source, gzip.open(temporary, "wb", compresslevel=6) as target:
            shutil.copyfileobj(source, target)
        os.chmod(temporary, 0o600)
        os.replace(temporary, destination)
        os.chmod(destination, 0o600)
        holding.unlink()
    except BaseException:
        # A session may recreate the live pathname after the handoff. Never replace that new file;
        # leave the detached copy for a later retry if restoration is no longer safe.
        if not path.exists() and holding.exists():
            os.rename(holding, path)
        raise
    finally:
        temporary.unlink(missing_ok=True)
    return destination


APPLY_LSOF_ITEMS, APPLY_LSOF_S = 8, 20.0  # apply re-takes lsof for discovered items this often


def apply(items: list[Item], families: dict[str, Family], receipt: Path,
          targets: dict[int, int] | None, idle_hours: float, halt=None,
          all_families: list[Family] | None = None, receipt_sweep: bool | None = None,
          taken: dict[Path, int] | None = None) -> int:
    """Delete reclaimable items, largest first. With `targets` (filesystem device -> free bytes
    to stop at), only items on those filesystems are touched, each until its own target. With `halt`
    (the idle sweep's host_busy), each deletion first asks it and the run stops once it names a reason."""
    receipt.parent.mkdir(parents=True, exist_ok=True)
    released = 0
    _NESTED_WALKS.clear()  # re-observe every checkout right before deleting
    every = list(families.values()) if all_families is None else all_families

    def family_of(item: Item) -> Family:
        """The family that listed the item: ids repeat across roots (one interrupted-deletions family per
        directory), so the deepest root holding the item wins."""
        p = Path(item.path)
        own = [f for f in every if f.id == item.family and p.parent.is_relative_to(f.root)]
        return max(own, key=lambda f: len(f.root.parts)) if own else families[item.family]
    try:
        cwds, cmds = process_evidence()
    except NoEvidence as e:
        print(f"refusing to delete anything: {e}", file=sys.stderr)
        return 0
    cwds = open_index(cwds)
    if any(f.mirror_idle_hours is not None for f in every):
        prune_mirror_archive()
    lsof_at, lsof_items = time.monotonic(), 0
    archived = archived_seeds() if any(i.family == "cmux-seeds" for i in items) else frozenset()
    # Among pressure hot-tier items, evict greatest reuse distance, then oldest use.
    cap_left = cmux_next_ci_over()  # what the cmux-next-ci cache is still over its cap
    # bytes this pass took from inside each cmux-next state root and host root; TAKEN shares it across main's passes
    taken_in: dict[Path, int] = {} if taken is None else taken

    def order(i):
        if cmux_next_ci_host_root(family_of(i), Path(i.path)):
            # the per-host build root is every DEV compile's warm state: after everything else, slots included
            return (-3, 0, i.idle_hours, i.bytes)
        slot = cmux_next_ci_floor_slot(family_of(i), Path(i.path))
        warm = slot or floor_hold_only(family_of(i), i, idle_hours) \
            or cmux_next_cap_only(family_of(i), Path(i.path), i.idle_hours, idle_hours)
        if warm and cmux_next_ci_fallback_item(family_of(i), Path(i.path)):
            # a per-instance state of a kind with a host root is only that root's busy-lock fallback: before every
            # other warm cmux-next item, its generated children first, then the state whole
            whole = slot or Path(i.path) in cmux_next_ci_state_roots(family_of(i).root)
            return (-1, 1 if whole else 2, i.idle_hours, i.bytes)
        if slot:
            # a whole slot costs its runner a cold build: after every generated child, least recently used first
            return (-2, 0, i.idle_hours, i.bytes)
        if warm:
            # reclaimable only by FLOOR_HOLD or the cmux-next cap: warm builds go last, least recently used first
            return (-1, 0, i.idle_hours, i.bytes)
        if i.family == RUNNER_GIT_GARBAGE_FAMILY:  # garbage nothing reads goes before anything that costs a rebuild
            return (2, 0, i.idle_hours, i.bytes)
        if cmux_next_ci_fallback_item(family_of(i), Path(i.path)):  # due by its own window: first of its band
            return (0, math.inf, i.idle_hours, i.bytes)
        if ACTIVITY_MODE == "pressure" and (i.family in FLEET_FAMILY_IDS or i.family == RUNNER_BUILD_FAMILY):
            return (1, i.jobs_since if i.jobs_since is not None else -1, i.idle_hours, i.bytes)
        return (0, value(i, families[i.family]), 0, 0)
    for i in sorted(items, key=order, reverse=True):
        if i.verdict != "reclaimable":
            continue
        p = Path(i.path)
        fam = family_of(i)
        if RUNNER_CACHE_PROFILE and (not runner_profile_roots_safe(every)
                                     or not runner_profile_path_safe(fam, p)):
            outcome = "changed:profile-boundary"
            i.verdict = "blocked"
            i.reasons.append(outcome)
            rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(),
                   "outcome": outcome, "rebuild": fam.rebuild, **asdict(i)}
            with receipt.open("a") as f:
                f.write(json.dumps(rec) + "\n")
            continue
        if targets is not None:
            try:
                dev = p.parent.stat().st_dev
            except OSError:
                continue
            if dev not in targets or free_bytes(p.parent)[0] >= targets[dev]:
                continue
        # an item younger than its family's window goes only while a budget that let it go still allows:
        # the floor hold stops at the floor plus target_margin_gib, the cmux-next cap once the cache is under it
        warm: list[bool] = []
        if cmux_next_ci_floor_slot(fam, p):
            if not floor_stop_unmet(p):
                continue
        elif floor_hold_only(fam, i, idle_hours):
            try:
                stop = FLOOR_HOLD.get(p.parent.stat().st_dev)
                warm.append(stop is not None and free_bytes(p.parent)[0] < stop)
            except OSError:
                warm.append(False)
        if cmux_next_cap_only(fam, p, i.idle_hours, idle_hours):
            warm.append(cap_left > 0)
        if warm and not any(warm):
            continue
        if cmux_next_ci_host_floor_only(fam, p, i.idle_hours) and not cmux_next_ci_host_floor_unmet(p):
            continue  # the host root goes for the floor only while free is still under the floor itself
        # fresh re-observation right before the destructive step. cmux jobs clone their warm state with
        # `cp -cR SOURCE ...` at any moment and a clone leaves the source's times alone, so those families
        # re-read the command lines per item rather than trusting the ones from the start of a long run.
        if halt is not None and (why := halt()):
            print(f"stopped: {why}")
            break
        if fam.id in FLEET_FAMILY_IDS or fam.id in (CMUX_NEXT_CI_FAMILY, HQ_CACHE_FAMILY, CANONICAL_ADMISSION) \
                or media_tour_dd(fam, p) or (
                fam.id == INTERRUPTED and fam.root in (cmux_next_ci_state_parents(HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT)
                                                       + cmux_next_ci_host_parents(HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT))):
            # Pressure eligibility is intentionally broad, so take fresh cwd/open-file evidence immediately
            # before each rename. A job may start using a candidate after the survey or during a long pass.
            try:
                opened, cmds = process_evidence()
            except NoEvidence as e:
                print(f"refusing to delete the rest: {e}", file=sys.stderr)
                break
            cwds = open_index(opened)
        if fam.build_output and fam.root.is_relative_to(FLEET_CI):
            cmds = command_lines() or cmds
        if fam.id == RUNNER_BUILD_FAMILY or fam.app_clones:
            # the runner may have taken a job since the survey (its Runner.Worker shows in a fresh ps), or an
            # app may have started from a clone: a running app names only its installed path, so ps it is
            cmds = command_lines()
            if not cmds:
                print("refusing to delete the rest: ps failed", file=sys.stderr)
                break
        fresh_layout = ""
        if fam.discover:
            # a discovered cache is deleted only on its own layout, so both are re-read now: the layout,
            # and the open files (a build may have started using it since the survey's lsof)
            # (lsof costs seconds on a loaded mini, so it is re-taken every APPLY_LSOF_ITEMS items or
            # APPLY_LSOF_S seconds, keeping --pressure --apply inside the hooks' timeout; ps is per item)
            fresh_layout = discoverable(i.path)
            lsof_items += 1
            if lsof_items >= APPLY_LSOF_ITEMS or time.monotonic() - lsof_at >= APPLY_LSOF_S:
                try:
                    opened, cmds = process_evidence()
                except NoEvidence as e:
                    print(f"refusing to delete the rest: {e}", file=sys.stderr)
                    break
                cwds = open_index(opened)
                lsof_at, lsof_items = time.monotonic(), 0
            else:
                cmds = command_lines()
                if not cmds:
                    print("refusing to delete the rest: ps failed", file=sys.stderr)
                    break
        if fam.retired_only and not owner_retired(fam):
            outcome = "changed:owner-loaded"
        elif fam.discover and not fresh_layout:
            outcome = "changed:layout"
        elif (cmux_next_ci_busy(fam, p, cwds, cmds)
                or (fam.id == INTERRUPTED and cmux_next_ci_aside_busy(p, cwds, cmds))
                or (fam.id == RUNNER_BUILD_FAMILY and runner_job_live(fam.root.parent, cmds))
                or (fam.app_clones and app_clone_running(p, cmds))
                or in_cwd(i.path, cwds) or named_by(i.path, cmds) or holds_socket(p) or job_busy(fam, p)
                or (fam.reference_root is not None
                    and artifact_referenced(p, fresh_artifact_references(fam.reference_root)))
                or (i.family == "claude-scratchpad" and claude_session_active(p.name, idle_hours * 3600))
                or (i.family == SPM_SCRATCH and spm_scratch_held(p))
                or (i.family == CANONICAL_ADMISSION and canonical_root_held(p))
                or (tmp_canonical_root(fam, p) and canonical_root_held(p, whole_root=True))):
            outcome = "changed:in-use"
        elif (families[i.family].git_disposable
              and referenced_main_checkout(p, nested=families[i.family].nested_git)):
            outcome = "changed:referenced"
        elif not item_due(fam, (idle_now := (time.time() - item_mtime(fam, p)) / 3600),
                          item_window(fam, p, idle_hours, archived))[0]:
            outcome = "changed:modified"
        elif keep_verdict(fam, p):
            outcome = "changed:kept"
        elif cmux_next_ci_floor_slot(fam, p) and not floor_stop_unmet(p):
            continue  # free reached the floor hold's stop while the evidence was re-taken
        elif cmux_next_ci_host_floor_only(fam, p, idle_now) and not cmux_next_ci_host_floor_unmet(p):
            continue  # likewise free reached the floor
        elif not git_exempt(fam, p, idle_now) and not fam.git_disposable and family_git_state(fam, p) != "none":
            outcome = "changed:git"  # a clone appeared at the top of the cache since the survey
        elif (fam.git_disposable and p.is_dir() and not git_exempt(fam, p, idle_now)
              and (g := family_git_state(fam, p)) != "none"
              and (g != "git" or family_git_loss(fam, p))):
            outcome = "changed:git"  # the checkout gained something to lose since the survey
        elif mirror_due(fam, p, idle_now) and (bundled := archive_mirror(p))[0]:
            # never deleted without a verified bundle of what is unpushed; uncommitted work no bundle holds
            dirty = bundled[0].startswith("uncommitted: ")
            outcome = "blocked:uncommitted" if dirty else "blocked:bundle-failed"
            i.reasons.append(bundled[0])
            if not dirty:
                RUN.setdefault("bundle_failed", []).append(i.path)
                print(f"glaeda-disk: ALERT: kept {i.path}: bundling its unpushed git work failed: {bundled[0]}",
                      file=sys.stderr)
        elif mirror_due(fam, p, idle_now) and (moved := mirror_moved(fam, p, bundled[2])):
            outcome = "changed:in-use"  # its bundles stay in the archive; the tree stays too
            i.reasons.append(moved)
        else:
            if mirror_due(fam, p, idle_now) and bundled[1]:
                i.reasons.append("unpushed git work bundled to " + ", ".join(map(os.fspath, bundled[1])))
            whole_state = fam.id == CMUX_NEXT_CI_FAMILY and p in cmux_next_ci_state_roots(fam.root)
            try:
                common = git_common_dir(p) if fam.git_disposable else ""
                if fam.transcripts:
                    original_bytes = p.stat().st_size
                    destination = archive_transcript(p)
                    outcome = "archived"
                    released += max(0, original_bytes - destination.stat().st_size)
                elif i.family == SPM_SCRATCH:
                    gone = remove_spm_scratch(p)  # only under its lock: a job may link it right now
                elif i.family == CANONICAL_ADMISSION:
                    gone = remove_canonical_admission(p)  # only under its root's token: a job may take it now
                elif tmp_canonical_root(fam, p):
                    gone = remove_canonical_root(p)  # the whole root, likewise only under its token
                elif i.family == INTERRUPTED:
                    finish_deletion(p)
                    gone = True
                elif media_tour_dd(fam, p):
                    gone = remove_media_tour_dd(p)  # only under the tour's tag lock: a tour may claim the slot now
                elif cmux_next_ci_host_root(fam, p):
                    # only under its own lock (a build may take it now); for the floor alone, only while still under it
                    gone = remove_cmux_next_host(p, needed=(lambda q=p: cmux_next_ci_host_floor_unmet(q))
                                                 if cmux_next_ci_host_floor_only(fam, p, idle_now) else None)
                else:
                    # rustup skips reinstalling a toolchain whose update hash still matches the channel
                    # the moment the toolchain is renamed away, so an interrupted delete cannot leave it behind
                    stale_hash = (p.parent.parent / "update-hashes" / p.name
                                  if fresh_layout == "rustup-toolchain" else None)
                    remove(p, after_rename=cmux_next_ci_slot_recheck(fam, p, floor=cmux_next_ci_floor_slot(fam, p))
                           if whole_state
                           else cmux_next_ci_child_recheck(fam, p) if fam.id == CMUX_NEXT_CI_FAMILY
                           else mirror_rename_recheck(p, bundled[2]) if mirror_due(fam, p, idle_now)
                           else None if stale_hash is None else lambda h=stale_hash: h.unlink(missing_ok=True))
                    gone = True
                    if fam.id == CMUX_NEXT_CI_FAMILY and p.parent.parent.parent in tuple(
                            fam.root / kind for kind in CMUX_NEXT_RELEASE_KINDS):
                        # a whole unowned release state: no empty <key>/Release left behind (no runner uses the key)
                        for empty in (p.parent, p.parent.parent):
                            with contextlib.suppress(OSError):
                                empty.rmdir()
                if not fam.transcripts:
                    outcome = "reclaimed" if gone else "changed:in-use"
                    took = i.bytes
                    if gone and fam.id == CMUX_NEXT_CI_FAMILY:
                        if whole_state or cmux_next_ci_host_root(fam, p):
                            took = max(0, took - taken_in.get(p, 0))  # its children's bytes were counted already
                        else:
                            taken_in[p.parent] = taken_in.get(p.parent, 0) + took
                        cap_left -= took
                    elif gone and fam.id == INTERRUPTED and p.parent in (
                            cmux_next_ci_state_parents(HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT)
                            + cmux_next_ci_host_parents(HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT)):
                        cap_left -= took  # an aside slot was part of the cache the cap measured
                        taken_in[p.parent] = taken_in.get(p.parent, 0) + took  # a host root's measure held it too
                    released += took if gone else 0
                if common:  # drop the deleted worktree's record from its repository
                    subprocess.run(["git", "--git-dir", common, "worktree", "prune"],
                                   capture_output=True, timeout=60)
            except SlotTaken:
                outcome = "changed:in-use"
            except SlotNotNeeded:
                continue  # as the stop check before the rename
            except (OSError, subprocess.SubprocessError) as e:
                outcome = f"incomplete:{e.__class__.__name__}"
        is_sweep = halt is not None if receipt_sweep is None else receipt_sweep
        if outcome != "reclaimed" and outcome.startswith(("changed:", "incomplete:", "blocked:")):
            # Keep the post-apply health/accounting view honest when a candidate became
            # busy or otherwise failed the final recheck after the survey.
            i.verdict = "blocked"
            i.reasons.append(outcome)
        rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(),
               "outcome": outcome, "rebuild": fam.rebuild, **asdict(i),
               **({"sweep": "idle"} if is_sweep else {})}
        with receipt.open("a") as f:
            f.write(json.dumps(rec) + "\n")
        print(f"  {outcome:16s} {gib(i.bytes)}  {i.path.replace(str(HOME), '~')}")
    print(f"logical released {released} bytes ({gib(released).strip()}); physical df delta is measured in the run summary; "
          f"receipt {receipt}")
    return released


def cmux_next_ci_dirs(home: Path | None = None) -> list[Path]:
    """The cmux-next workflow's DerivedData, one per runner: ~/Library/Caches/cmux-next-ci/<scheme>/<runner>.
    Each runner keeps its own copy of the same SourcePackages and module caches (3.9 GiB, three times on
    every mini, 2026-10-11), so each <scheme> directory is a dedupe base like Xcode's DerivedData."""
    root = (HOME if home is None else home) / "Library/Caches" / CMUX_NEXT_CI_ROOT
    if not root.is_dir() or root.is_symlink():
        return []
    return [d for d in _children(root) if d.is_dir() and not d.is_symlink()]


def cmux_next_ci_aside_busy(path: Path, opened: list[str] | frozenset[str], commands: str) -> str:
    """For an aside tree (DELETING_PREFIX<name>-<pid>) where cmux-next state roots sit, the state's own vetoes,
    as if it were still at <name>: its runner's job (unknown ownership refuses), a process naming it, the
    fail-closed socket search, markers, unknown children. "" for any other aside tree."""
    root = HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT
    m = DELETING_RE.fullmatch(path.name)
    if m is None:
        return ""
    original = path.with_name(path.name[len(DELETING_PREFIX):m.start(1) - 1])
    if path.parent in cmux_next_ci_host_roots(root):  # a host root's child set aside: its builds' lock, on the root
        return cmux_next_ci_host_lock_held(path.parent)
    if path.parent not in cmux_next_ci_state_parents(root):
        return ""
    runner = cmux_next_ci_owner(original, root)
    if runner == OWNER_UNKNOWN:
        return "an enrolled runner's .runner names no agent: whose cmux-next state this is is unknown"
    if runner is not None and (why := runner_job_live(runner, commands)):
        return why
    if named_by(os.fspath(original), commands) or named_by(os.fspath(path), commands):
        return "cmux-next state is referenced by a process"
    return cmux_next_ci_tree_busy(path)


def cmux_next_ci_state_parents(root: Path) -> list[Path]:
    """The directories cmux_next_ci_state_roots' roots sit in (cmux-scheme, each <kind>/<key>/Release), whether
    or not a state is left in them."""
    if root.is_symlink() or not root.is_dir():
        return []
    found = [root / "cmux-scheme"]
    for kind in CMUX_NEXT_RELEASE_KINDS:
        if (root / kind).is_symlink():
            continue
        for key in _children(root / kind):
            if not key.is_symlink() and re.fullmatch(r"[0-9a-fA-F]{8,64}", key.name):
                found.append(key / "Release")
    real = root.resolve()
    return [d for d in found if d.is_dir() and not d.is_symlink() and d.resolve().is_relative_to(real)]


def cmux_next_ci_state_roots(root: Path) -> list[Path]:
    """Validated per-runner DerivedData roots owned by cmux-next CI.

    The workflow's reusable scheme roots are ``cmux-scheme/<runner>``.  Older
    dev-daily runs use ``dev-daily-release/<key>/Release/<xcode-hash>``.
    Names outside these shapes are intentionally ignored so a generic cache
    directory can never become a deletion candidate by accident.
    """
    if not root.is_dir() or root.is_symlink():
        return []
    roots: list[Path] = []
    scheme = root / "cmux-scheme"
    for runner in _children(scheme) if scheme.is_dir() and not scheme.is_symlink() else []:
        # an aside tree remove() left (a deletion in progress or interrupted) is never a state root
        if runner.is_dir() and not runner.is_symlink() and not DELETING_RE.fullmatch(runner.name):
            roots.append(runner)
    # Both dev-daily and release-compile use a <key>/Release/xcode state root, the
    # key one per runner and workspace (cmux_next_ci_release_key), not a source
    # fingerprint.  Real Xcode output names the final component ``xcode-<hash>``;
    # older fixtures used the bare hash.  Keep the shape strict so arbitrary
    # cache directories never become deletion candidates.
    for daily_name in ("dev-daily-release", "release-compile"):
        daily = root / daily_name
        if daily.is_symlink() or not daily.is_dir():
            continue
        for key in _children(daily):
            if key.is_symlink() or not key.is_dir() \
                    or re.fullmatch(r"[0-9a-fA-F]{8,64}", key.name) is None:
                continue
            release = key / "Release"
            if release.is_symlink() or not release.is_dir():
                continue
            for xcode_hash in _children(release):
                if not xcode_hash.is_dir() or xcode_hash.is_symlink():
                    continue
                if re.fullmatch(r"(?:xcode-)?[0-9a-fA-F]{8,64}", xcode_hash.name):
                    roots.append(xcode_hash)
    return roots


def runner_config(runner: Path) -> dict:
    """A runner's .runner (UTF-8 with a byte order mark), or {} when unreadable."""
    try:
        doc = json.loads((runner / ".runner").read_text(encoding="utf-8-sig"))
    except (OSError, ValueError):
        return {}
    return doc if isinstance(doc, dict) else {}


def runner_work_folder(runner: Path) -> Path:
    """The runner's work folder: .runner's workFolder, relative to the runner directory or absolute; _work."""
    work = runner_config(runner).get("workFolder")
    return runner / (work if isinstance(work, str) and work else "_work")


def enrolled_runner_roster() -> tuple[dict[str, Path], bool, dict[Path, Path]]:
    """From one read of each enrolled runner's .runner: agentName -> runner directory, whether every one named its
    agent (while one cannot be read, mid-write, malformed or with a blank name, a state no name matches may be its),
    and each named runner's work folder (runner_work_folder) from that same read. A .runner rewritten within a
    job's timeout (cmux_next_ci_unowned_idle_hours) leaves the roster incomplete too, as does one removed
    within it: a Runner.Worker started under the old name may still be on its way to the old name's state."""
    names: dict[str, Path] = {}
    work: dict[Path, Path] = {}
    complete = True
    recent = time.time() - float(POLICY["cmux_next_ci_unowned_idle_hours"]) * 3600
    try:  # a runner whose .runner went missing just now (mid re-registration) is not known gone either
        for runner in HOME.glob("actions-runner*"):
            if (not runner.is_symlink() and (runner / "glaeda-hooks").is_dir()
                    and not (runner / ".runner").is_file() and runner.stat().st_mtime > recent):
                complete = False
    except OSError:
        complete = False
    for runner in enrolled_runners():
        try:
            if (runner / ".runner").stat().st_mtime > recent:
                complete = False
        except OSError:
            complete = False
        config = runner_config(runner)
        name = config.get("agentName")
        if isinstance(name, str) and name.strip():
            names.setdefault(name, runner)
            folder = config.get("workFolder")
            work[runner] = runner / (folder if isinstance(folder, str) and folder else "_work")
        else:
            complete = False
    return names, complete, work


def enrolled_runner_names() -> dict[str, Path]:
    """agentName -> runner directory for every enrolled runner."""
    return enrolled_runner_roster()[0]


CMUX_NEXT_RELEASE_KINDS = ("dev-daily-release", "release-compile")


def cmux_next_ci_release_key(runner_name: str, workspace: str) -> str:
    """The <key> of a dev-daily-release/release-compile state: cmux's scripts/cmux-next/release-derived-data-path.sh
    names it sha256("$RUNNER_NAME\n$GITHUB_WORKSPACE\n")[:16], one per runner and workspace (cmux11s,
    2026-10-21: release-compile/3c965dbc3ce04dc2 is cmux11s-mac-mini-glaeda-1 in its _work/cmux/cmux)."""
    return hashlib.sha256(f"{runner_name}\n{workspace}\n".encode()).hexdigest()[:16]


def cmux_next_ci_release_keys(roster: tuple[dict[str, Path], bool, dict[Path, Path]] | None = None) -> dict[str, Path]:
    """Release state key -> enrolled runner, for its cmux checkout ($GITHUB_WORKSPACE: <workFolder>/cmux/cmux)
    as given and as resolved, from one roster read (enrolled_runner_roster)."""
    names, _, work = enrolled_runner_roster() if roster is None else roster
    keys: dict[str, Path] = {}
    for name, runner in names.items():
        workspace = os.fspath(work[runner] / "cmux/cmux")
        for ws in {workspace, os.path.realpath(workspace)}:
            keys.setdefault(cmux_next_ci_release_key(name, ws), runner)
    return keys


# cmux_next_ci_owner's answer while an enrolled runner's .runner cannot be read: the state may be that runner's.
# Not None, so nothing takes the state as unowned, and every in-use veto refuses it (cmux_next_ci_busy).
OWNER_UNKNOWN = Path("/nonexistent/glaeda-disk-owner-unknown")

# state root -> the owner cmux_next_ci_busy last vetted it under. A slot's post-rename recheck holds its runner to
# that one: a .runner rewritten in between (re-registered, renamed) would otherwise drop the old Runner.Worker.
CMUX_NEXT_CI_VETTED_OWNER: dict[Path, Path | None] = {}


def cmux_next_ci_owner(state: Path, root: Path) -> Path | None:
    """The enrolled runner a validated state root belongs to: cmux-scheme/<agentName>, or <kind>/<key>/Release/...
    by its release key. None for a runner no longer enrolled here, or a shape neither names; OWNER_UNKNOWN when
    no runner matched but one's .runner could not be read in the same read."""
    roster = enrolled_runner_roster()
    names, complete, _ = roster
    if state.parent == root / "cmux-scheme":
        owner = names.get(state.name)
    elif state.parent.parent.parent in tuple(root / kind for kind in CMUX_NEXT_RELEASE_KINDS):
        owner = cmux_next_ci_release_keys(roster).get(state.parent.parent.name)
    else:
        return None
    return owner if owner is not None or complete else OWNER_UNKNOWN


def cmux_next_ci_runner(path: Path, root: Path) -> Path | None:
    """The enrolled runner whose state (cmux-scheme/<agentName>, or a release state by its key) holds generated
    child PATH, or None (a runner no longer enrolled here)."""
    state = cmux_next_ci_state_for(path, root)
    return None if state is None else cmux_next_ci_owner(state, root)


def cmux_next_ci_stale_roots(root: Path) -> list[Path]:
    """Validated state roots the size cap may take whole, inputs included: every state idle at least a job's
    timeout (cmux_next_ci_unowned_idle_hours), whoever owns it, least recently used first like the rest of the
    cap. An enrolled runner keeps a state per runner and kind (cmux-scheme/<runner>, <kind>/<runner key>), so with
    only their generated output the cap's to take, the inputs of states no job had built in for hours held the
    cache over its cap for good (cmux14, 2026-10-27: 79 GiB against 40, eight states of five runners, 4-5 GiB of
    SourcePackages and module cache each). A younger state keeps its inputs. Only a host with enrolled runners
    applies the cap, so elsewhere there are none, and while an enrolled runner's .runner cannot be read none is
    (the state may be that runner's, mid-registration). Every in-use veto, its runner's running job included,
    still holds (cmux_next_ci_busy)."""
    if not enrolled_runner_names():
        return []
    idle_s = float(POLICY["cmux_next_ci_unowned_idle_hours"]) * 3600
    now = time.time()
    return [s for s in cmux_next_ci_state_roots(root)
            if cmux_next_ci_owner(s, root) != OWNER_UNKNOWN and now - newest_mtime(s, 2, 3000) >= idle_s]


def cmux_next_ci_stale_roots_cached(root: Path) -> frozenset[Path]:
    """cmux_next_ci_stale_roots once per run (one newest_mtime walk per state, not one per question), kept with the
    run's candidate lists (_DISCOVERED)."""
    key = "cmux-next-stale:" + os.fspath(root)
    if key not in _DISCOVERED:
        _DISCOVERED[key] = frozenset(cmux_next_ci_stale_roots(root))
    return _DISCOVERED[key]


def cmux_next_ci_host_paths(root: Path) -> list[Path]:
    """Where disk-policy.json's cmux_next_ci_host_roots put the per-host build roots under ROOT, whether or not one
    is there: relative paths only, no . or .. segment, never ROOT itself."""
    found: list[Path] = []
    for rel in POLICY["cmux_next_ci_host_roots"]:
        rel_path = Path(rel)
        if rel_path.is_absolute() or not rel_path.parts or any(p in (".", "..") for p in rel.split("/")):
            continue
        if (root / rel_path) not in found:
            found.append(root / rel_path)
    return found


def cmux_next_ci_host_roots(root: Path) -> list[Path]:
    """The per-host build roots (cmux_next_ci_host_paths) present under ROOT: real directories with no symlink from
    ROOT down. Each is one item of the cmux-next family, whole, and never a state root (its key is no hex key), so
    the size cap never takes it: it goes once idle cmux_next_ci_host_idle_hours (item_window), or under the floor
    hold while free is still below the floor itself, after everything else (apply's order), and only under its own
    lock (remove_cmux_next_host). cmux13s/cmux14, 2026-10-26: 14-16 GiB, 424 of 502 compile jobs cache hits warm."""
    if root.is_symlink() or not root.is_dir():
        return []
    found = []
    for host in cmux_next_ci_host_paths(root):
        step, ok = root, True
        for part in host.relative_to(root).parts:
            step = step / part
            if step.is_symlink() or not step.is_dir():
                ok = False
                break
        if ok:
            found.append(host)
    return found


def cmux_next_ci_host_parents(root: Path) -> list[Path]:
    """The host roots themselves: remove_cmux_next_host renames each child aside inside its root (the root and its
    lock stay), so an interrupted removal leaves the aside there (interrupted_families)."""
    return cmux_next_ci_host_roots(root)


def cmux_next_ci_host_root(fam: Family, path: Path) -> bool:
    """Whether PATH is a per-host cmux-next build root listed whole (cmux_next_ci_host_roots)."""
    return fam.id == CMUX_NEXT_CI_FAMILY and path in cmux_next_ci_host_roots(fam.root)


def cmux_next_ci_host_floor_only(fam: Family, path: Path, idle: float) -> bool:
    """Whether a host root is due only for the floor hold: younger than cmux_next_ci_host_idle_hours."""
    return cmux_next_ci_host_root(fam, path) and idle < float(POLICY["cmux_next_ci_host_idle_hours"])


def cmux_next_ci_host_floor_unmet(path: Path) -> bool | None:
    """Whether free space on PATH's filesystem is still below the runner floor itself (CMUX_NEXT_HOST_FLOOR); None
    when it cannot be read (falsy: the host root stays)."""
    try:
        floor = CMUX_NEXT_HOST_FLOOR.get(path.parent.stat().st_dev)
        return floor is not None and free_bytes(path.parent)[0] < floor
    except OSError:
        return None


def cmux_next_ci_fallback_item(fam: Family, path: Path) -> bool:
    """Whether PATH is inside a per-instance state (<kind>/<hex key>/...) of a kind that has a host root here: the
    host lock's fallback only (cmux compile-dev-release.sh), so it goes before every other cmux-next item."""
    if fam.id != CMUX_NEXT_CI_FAMILY:
        return False
    try:
        rel = path.relative_to(fam.root).parts
    except ValueError:
        return False
    return (len(rel) >= 2 and re.fullmatch(r"[0-9a-fA-F]{8,64}", rel[1]) is not None
            and any(h.parent == fam.root / rel[0] for h in cmux_next_ci_host_roots(fam.root)))


def cmux_next_ci_host_lock_held(host: Path) -> str:
    """Why a host root's builds hold it, from flock(2) on <root>/lock, or "". cmux's host_build_lock.py takes it
    exclusive without waiting, and the clone, xcodebuild and ditto inherit it, so the kernel holds it until the last
    of them exits. Probed shared and released at once; a lock that cannot be read or is a symlink counts as held."""
    try:
        fd = os.open(host / "lock", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return ""
    except OSError as e:
        return f"cmux-next host lock unreadable ({e.strerror})"
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except BlockingIOError:
        return "a cmux-next build holds the host root (flock on its lock)"
    except OSError as e:
        return f"cmux-next host lock unreadable ({e.strerror})"
    finally:
        os.close(fd)
    return ""


def remove_cmux_next_host(host: Path, needed=None) -> bool:
    """Empty a host root only under its own lock: flock(2) exclusive on <root>/lock, without waiting, held while
    every child but the lock is removed (each renamed aside first, as remove() does). The lock file itself stays, the
    same inode, so a build that opened it before this and flocks it now or later still excludes every other build
    (a lock file replaced under it would let two builds hold two inodes at once). A build that starts meanwhile finds
    the lock taken and builds per instance (cmux's fallback); one after sets up a fresh tree. False when a build holds
    the lock. A child that cannot be removed raises, as remove() does. NEEDED (the floor hold's case) is asked again
    once the lock is held, before anything goes: falsy raises SlotNotNeeded and nothing is touched."""
    if host.is_symlink() or os.path.ismount(host) or host.lstat().st_dev != host.parent.stat().st_dev:
        raise OSError("refusing a host root that is a link or a mount point")
    try:  # created when missing, as the build's `exec 9>>lock` does, so both meet the same inode
        fd = os.open(host / "lock", os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    except OSError:
        return False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return False
        if needed is not None and not needed():
            raise SlotNotNeeded(f"{host.name}: free reached the runner floor; kept")
        for child in _children(host):
            if child.name != "lock":
                remove(child)
    finally:
        os.close(fd)
    return True


def cmux_next_ci_floor_slots(root: Path) -> list[Path]:
    """Validated state roots of runners enrolled here, listed whole while the runner gate holds for disk on their
    filesystem (FLOOR_HOLD): a slot's inputs (SourcePackages, module and compilation caches) are what a cold build
    of that runner fetches again, and with 14 slots at 4-11 GiB each they are most of the cache. They go last, least
    recently used first, only up to the floor hold's stop, and under every in-use veto (cmux_next_ci_busy: the
    runner's Runner.Worker, a process naming or open in it, a marker, an unknown child). cmux14, 2026-10-25: 115
    GiB of cmux-next-ci, 10.8 GiB free under a 30 GiB floor, Swift compiles refused."""
    if CMUX_NEXT_CI_DRAIN:
        return []  # a drain takes generated output only (cmux_next_ci_floor_slot): never a slot's inputs
    try:
        if root.stat().st_dev not in FLOOR_HOLD:
            return []
    except OSError:
        return []
    return [s for s in cmux_next_ci_state_roots(root) if cmux_next_ci_owner(s, root) is not None]


def floor_stop_unmet(path: Path) -> bool | None:
    """Whether free space on PATH's filesystem is still under the floor hold's stop; None when it cannot be read
    (falsy, so nothing more is taken for the floor, and never proof the stop was met)."""
    try:
        stop = FLOOR_HOLD.get(path.parent.stat().st_dev)
        return stop is not None and free_bytes(path.parent)[0] < stop
    except OSError:
        return None


RENAME_EXCL = 0x4  # macOS renamex_np: fail with EEXIST if the destination exists
RENAME_NOREPLACE = 0x1  # Linux renameat2


def rename_noreplace(src: Path, dst: Path) -> None:
    """Rename SRC to DST atomically, failing with EEXIST when anything is at DST, even an empty directory (which
    os.rename would replace). Raises OSError(ENOTSUP) where the platform has no such rename."""
    import ctypes
    import ctypes.util
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    a, b = os.fsencode(src), os.fsencode(dst)
    if hasattr(libc, "renamex_np"):
        rc = libc.renamex_np(a, b, ctypes.c_uint(RENAME_EXCL))
    elif hasattr(libc, "renameat2"):
        rc = libc.renameat2(-100, a, -100, b, ctypes.c_uint(RENAME_NOREPLACE))  # AT_FDCWD
    else:
        raise OSError(errno.ENOTSUP, "no atomic no-replace rename here")
    if rc != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err), os.fspath(dst))


class SlotTaken(OSError):
    """A runner's job took its slot between the last check and the rename: the slot was put back, or, when a new
    slot already stands at its path, left aside under its deleting name. remove() deletes neither; the
    interrupted-deletions family finishes an aside tree only once this pid is gone and nothing has it open."""


class SlotNotNeeded(OSError):
    """Free reached the floor hold's stop while the post-rename evidence was taken: the slot was put back."""


def cmux_next_ci_slot_recheck(fam: Family, path: Path, floor: bool = True):
    """after_rename for a whole slot. A slot is only its own runner's, and that runner's Runner.Worker shows in ps
    long before its build reaches the slot, so the fresh ps right before the rename already keeps a job's slot;
    this closes the rest: if the runner took a job, or anything is open in the detached tree, put it back. Free
    space is read again after that evidence too: a slot no longer needed for the floor hold goes back as well
    (FLOOR: the floor hold took it; a stale root the cap takes whole has no stop)."""
    doomed = path.with_name(f"{DELETING_PREFIX}{path.name}-{os.getpid()}")
    vetted = CMUX_NEXT_CI_VETTED_OWNER.get(path, OWNER_UNKNOWN)  # never vetted: whose it is is unknown

    def recheck() -> None:
        runner = cmux_next_ci_owner(path, fam.root)
        try:
            opened, cmds = process_evidence()
        except NoEvidence:
            opened, cmds = None, ""
        taken = (opened is None or OWNER_UNKNOWN in (runner, vetted) or runner != vetted
                 or (runner is not None and runner_job_live(runner, cmds)
                     and not cmux_next_ci_job_predates(doomed, runner))
                 or in_cwd(os.fspath(doomed), open_index(opened)) or named_by(os.fspath(path), cmds)
                 or named_by(os.fspath(doomed), cmds) or bool(cmux_next_ci_tree_busy(doomed)))
        unmet = floor_stop_unmet(path) if floor else True
        if not taken and unmet:
            return  # nobody's, and still needed: remove() deletes it
        try:
            rename_noreplace(doomed, path)
        except OSError as e:
            if not taken and unmet is False and e.errno in (errno.EEXIST, errno.ENOTEMPTY) and os.path.lexists(path):
                return  # the floor was met, but a new slot stands at the path: the detached one is nobody's
            # in use, or the rename back failed for another reason: the detached tree stays aside, never deleted
            # from here (interrupted-deletions finishes it once this pid is gone and its own vetoes pass)
            raise (SlotTaken if taken else SlotNotNeeded)(
                f"{path.name}: could not be put back ({e.strerror}); left aside as {doomed.name}")
        if taken:
            raise SlotTaken(f"{path.name}: its runner took a job; put back")
        raise SlotNotNeeded(f"{path.name}: free reached the floor hold's stop; put back")
    return recheck


def cmux_next_ci_state_written(state: Path, skip: frozenset[str] = frozenset()) -> float:
    """When STATE was last written: the newest mtime of the state root and its direct children (newest_mtime one
    level down), leaving out the children named in SKIP. 0 when it cannot be read."""
    return newest_mtime(state, 1, 3000, skip_names=skip)


def cmux_next_ci_job_predates(state: Path, runner: Path, written: float | None = None) -> bool:
    """Whether RUNNER's running job began after STATE was last written (WRITTEN, else read now), so it has not built
    there: a build into a state rewrites its top level (xcodebuild's info.plist as it starts, cmux's
    cmux-next-build.log as it ends), and the steps that read a state's products follow the build into it in the same
    job (cmux-next.yml). Such a state is the runner's last job's, as an idle runner's is (cmux14, 2026-10-27: ten
    runners busy around the clock, each job minutes to two hours old, every state last built in before its runner's
    job began, so nothing was ever reclaimable). False when the job's start or the state's times cannot be read."""
    started = runner_job_started(runner)
    if started is None:
        return False
    last = cmux_next_ci_state_written(state) if written is None else written
    return 0 < last < started


def cmux_next_ci_child_recheck(fam: Family, path: Path):
    """after_rename for a state's generated child: once the child is renamed aside, fresh evidence, and the child
    goes back when anything has started on its state since the last check before the rename. That is a process
    naming the state or open in it; its owner changed from the one cmux_next_ci_busy vetted (a re-registration); its
    runner running a job that the state's times (taken before the rename, so the rename's own change to the state
    directory is not mistaken for a build) do not predate, or any running job in a drain; a write to any other
    top-level entry of the state since then (a build that began: xcodebuild rewrites its info.plist first); or a
    marker, socket or unknown child (cmux_next_ci_tree_busy). Evidence that cannot be taken or read puts the child
    back too."""
    state = cmux_next_ci_state_for(path, fam.root)
    if state is None:
        return None
    vetted = CMUX_NEXT_CI_VETTED_OWNER.get(state, OWNER_UNKNOWN)  # never vetted: whose it is is unknown
    written = cmux_next_ci_state_written(state)
    doomed = path.with_name(f"{DELETING_PREFIX}{path.name}-{os.getpid()}")

    def recheck() -> None:
        try:
            opened, cmds = process_evidence()
        except NoEvidence:
            opened, cmds = None, ""
        runner = cmux_next_ci_owner(state, fam.root)
        since = cmux_next_ci_children_written(state, doomed.name)
        taken = (opened is None or written <= 0 or since is None or since > written
                 or OWNER_UNKNOWN in (runner, vetted) or runner != vetted
                 or (runner is not None and runner_job_live(runner, cmds)
                     and (CMUX_NEXT_CI_DRAIN or not cmux_next_ci_job_predates(state, runner, written)))
                 or in_cwd(os.fspath(state), open_index(opened)) or named_by(os.fspath(state), cmds)
                 or bool(cmux_next_ci_tree_busy(state, aside=doomed.name)))
        if not taken:
            return
        try:
            rename_noreplace(doomed, path)
        except OSError as e:
            raise SlotTaken(f"{path.name}: could not be put back ({e.strerror}); left aside as {doomed.name}")
        raise SlotTaken(f"{path.name}: something started on {state}; put back")
    return recheck


def cmux_next_ci_children_written(state: Path, skip: str) -> float | None:
    """The newest mtime among STATE's direct children other than SKIP (not the state directory itself, whose mtime the
    rename aside just moved): 0 when there are none, None when the state or a child cannot be read."""
    newest = 0.0
    try:
        with os.scandir(state) as it:
            for entry in it:
                if entry.name != skip:
                    newest = max(newest, entry.stat(follow_symlinks=False).st_mtime)
    except OSError:
        return None
    return newest


def cmux_next_ci_floor_slot(fam: Family, path: Path) -> bool:
    """Whether PATH is an enrolled runner's whole cmux-next state root, listed only under the floor hold. Outside
    it, an owned fallback state the size cap lists whole (cmux_next_ci_stale_roots) is the cap's, as an unowned one."""
    if not (fam.id == CMUX_NEXT_CI_FAMILY and not CMUX_NEXT_CI_DRAIN and path in cmux_next_ci_state_roots(fam.root)
            and cmux_next_ci_owner(path, fam.root) is not None):
        return False
    try:
        held = fam.root.stat().st_dev in FLOOR_HOLD
    except OSError:
        held = False
    return held or not (cmux_next_ci_over() and path in cmux_next_ci_stale_roots_cached(fam.root))


def cmux_next_ci_generated_paths(root: Path, whole_stale: bool = False) -> list[Path]:
    """Generated children eligible for the cmux-next retention family.

    Inputs and unknown state are deliberately absent from this list. In
    particular, SourcePackages, ModuleCache.noindex and SDK caches remain
    available for future runs and are never treated as disposable output.
    With ``whole_stale`` (the cache is over its cap), an unowned state root
    (cmux_next_ci_stale_roots) is listed whole instead of its children.
    """
    found: list[Path] = []
    stale = set(cmux_next_ci_stale_roots(root)) if whole_stale else set()
    for state in cmux_next_ci_state_roots(root):
        if state in stale:
            found.append(state)
            continue
        for child in _children(state):
            if child.name in CMUX_NEXT_CI_PRESERVED_NAMES or child.is_symlink():
                continue
            if child.name in CMUX_NEXT_CI_GENERATED_NAMES and (child.is_dir() or child.is_file()):
                found.append(child)
    # its generated children are listed as well and go first (apply's order); the slot itself goes after them
    found.extend(slot for slot in cmux_next_ci_floor_slots(root) if slot not in stale)
    if not CMUX_NEXT_CI_DRAIN:  # listed whole and always, so a report shows it; its window decides (item_window)
        found.extend(cmux_next_ci_host_roots(root))
    return found


def cmux_next_ci_cap_state(fams: list[Family], cap_gib: float, measure: bool = False) -> dict[str, float] | None:
    """The cmux-next-ci cache's size against CAP_GIB: used, cap and over bytes, and when it was measured (at).

    With ``measure`` (a pressure run) one du of its whole root, inputs included, which CMUX_NEXT_CAP_RECORD keeps;
    without, that record alone, so a report never walks the cache (7-10 s on a mini). None when the cap does not
    apply: off (0), the family not in this run, no enrolled glaeda runner (not a CI host), or the size unknown
    (the 12 h window then stands). The du is a probe, not an eviction measurement, so its timeout records no
    eviction_stuck and no cooldown."""
    fam = next((f for f in fams if f.id == CMUX_NEXT_CI_FAMILY), None)
    if fam is None or cap_gib <= 0 or not enrolled_runners():
        return None
    if measure:
        used, at = du_bytes(fam.root, record_timeout=False), time.time()
        if used is not None:
            with contextlib.suppress(OSError):
                CMUX_NEXT_CAP_RECORD.parent.mkdir(parents=True, exist_ok=True)
                tmp = CMUX_NEXT_CAP_RECORD.with_suffix(f".{os.getpid()}.tmp")
                tmp.write_text(json.dumps({"root": os.fspath(fam.root), "used": used, "at": at}))
                os.replace(tmp, CMUX_NEXT_CAP_RECORD)
    else:
        try:
            doc = json.loads(CMUX_NEXT_CAP_RECORD.read_text())
            used, at = int(doc["used"]), float(doc["at"])
            if doc.get("root") != os.fspath(fam.root):
                return None
        except (OSError, ValueError, KeyError, TypeError):
            return None
    if used is None:
        return None
    cap = int(cap_gib * GIB)
    return {"used": used, "cap": cap, "over": max(0, used - cap), "at": at}


def nightly_next_dedicated() -> bool:
    """The nightly-next build routes to its dedicated builder: disk-policy names the label cmux routes by."""
    return POLICY.get("nightly_next_dedicated_label") == NIGHTLY_NEXT_DEDICATED_LABEL


def nightly_next_split() -> bool:
    """cmux-nightly-next is split into per-runner items: the build routes to its dedicated builder, or a dedicated
    runner keeps a tree in it by role (role_keep). Whole, a root above a role keep would be held forever, and with
    it every pool runner's stale tree."""
    if nightly_next_dedicated():
        return True
    root = os.path.realpath(HOME / "Library/Caches" / NIGHTLY_NEXT_ROOT)
    return any(k.startswith(root + "/") for k in role_keep())


def nightly_next_family(root: Path | None = None) -> Family:
    """Pool runners' cmux-nightly-next trees, each its own item; the dedicated builder's tree is never one."""
    root = (HOME / "Library/Caches" / NIGHTLY_NEXT_ROOT) if root is None else root
    window = DEFAULT_AGE_HOURS  # a module global keep_legacy_ages may have raised for this run
    return Family(NIGHTLY_NEXT_FAMILY, root, True,
                  "a fallback nightly-next build on this runner starts cold (the dedicated builder keeps its own)",
                  # SourcePackages/checkouts and notices-crates/git hold SwiftPM and cargo clones, which the next
                  # build fetches again: build output, not a checkout anyone works in
                  build_output=True, min_idle_hours=window, max_idle_hours=window,
                  owner="cmux nightly_build_state.py, per runner", rebuild_minutes=4, platform="macos")


def nightly_next_fallback(path: Path) -> bool:
    """A pool runner's tree under cmux-nightly-next: never the dedicated builder's, never an unknown name."""
    name = path.name
    return (NIGHTLY_NEXT_POOL_RUNNER.fullmatch(name) is not None
            and NIGHTLY_NEXT_DEDICATED_RUNNER.fullmatch(name) is None)


def cmux_next_ci_family(root: Path | None = None) -> Family:
    """Reclaim old generated cmux-next CI output while preserving reusable inputs."""
    root = (HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT) if root is None else root
    return Family(CMUX_NEXT_CI_FAMILY, root, True,
                  "the cmux-next workflow rebuilds generated DerivedData output",
                  checkout_builds=True, build_output=True,
                  min_idle_hours=CMUX_NEXT_CI_MIN_IDLE_HOURS,
                  owner="cmux-next.yml per-runner DerivedData", rebuild_minutes=15,
                  platform="macos")


def cmux_next_ci_state_for(path: Path, root: Path) -> Path | None:
    """Return the validated state root containing a generated child, if any."""
    for state in cmux_next_ci_state_roots(root):
        try:
            if path.parent == state and path.name in CMUX_NEXT_CI_GENERATED_NAMES:
                return state
        except OSError:
            continue
    return None


def cmux_next_ci_state_for_path(path: Path, root: Path) -> Path | None:
    """Return the validated state root containing any descendant of ``path``.

    ``cmux_next_ci_state_for`` intentionally accepts only a generated child (the
    retention family calls it immediately before deleting that child).  Dedupe walks
    files below ``Products`` and needs the corresponding state root for each file, so it
    uses this descendant form.  The same validated layout and symlink exclusions are
    retained; an arbitrary path under the cache never becomes eligible.
    """
    path = Path(path)
    for state in cmux_next_ci_state_roots(root):
        try:
            path.relative_to(state)
        except ValueError:
            continue
        return state
    return None


def cmux_next_ci_busy(fam: Family, path: Path, opened: list[str] | frozenset[str],
                      commands: str) -> str:
    """Fresh process/lease/lock veto for one cmux-next generated child, or an unowned state root the cap takes whole.

    Marker presence is treated as active or ambiguous state. A stale marker is
    therefore a safe keep until the owner repairs it; this family never guesses
    that a lease or lock has expired.
    """
    if fam.id != CMUX_NEXT_CI_FAMILY:
        return ""
    if cmux_next_ci_host_root(fam, path):  # no runner's state: its builds' flock is its in-use signal
        return cmux_next_ci_host_lock_held(path)
    state = cmux_next_ci_state_for(path, fam.root)
    if state is None and cmux_next_ci_over() and path in cmux_next_ci_stale_roots(fam.root):
        state = path  # an unowned state root the cap takes whole: the same vetoes, on the root itself
    if state is None and FLOOR_HOLD and cmux_next_ci_floor_slot(fam, path):
        state = path  # an enrolled runner's slot the floor hold takes whole: the same vetoes, its runner's job first
    if state is None:
        return "cmux-next state root is no longer validated"
    runner = cmux_next_ci_owner(state, fam.root)
    CMUX_NEXT_CI_VETTED_OWNER[state] = runner
    if runner == OWNER_UNKNOWN:
        return "an enrolled runner's .runner names no agent: whose cmux-next state this is is unknown"
    if runner is not None and (why := runner_job_live(runner, commands)) \
            and (CMUX_NEXT_CI_DRAIN or not cmux_next_ci_job_predates(state, runner)):
        return why
    state_text = os.fspath(state)
    if in_cwd(state_text, opened) or named_by(state_text, commands):
        return "cmux-next state is referenced by a process"
    return cmux_next_ci_tree_busy(state)


# The tools' own caches inside a state (Xcode's module, compilation and SDK stat caches, SwiftPM's packages): wide
# (thousands of entries in one directory) and written only by the compiler and SwiftPM, never a socket's home.
CMUX_NEXT_CI_TOOL_CACHES = frozenset({"ModuleCache.noindex", "SDKStatCaches.noindex", "SDKExplicitPrecompiledModules",
                                      "CompilationCache.noindex", "SourcePackages"})


def cmux_next_ci_holds_socket(state: Path, budget: int = 3000) -> bool:
    """holds_socket for a cmux-next state, two levels down as holds_socket, failing closed: a tree it cannot
    finish within `budget` entries, or a directory it cannot read, counts as holding one. The tools' caches (CMUX_NEXT_CI_TOOL_CACHES) are not
    listed, so a real slot's width alone never makes it busy."""
    frontier = [state]
    for depth in range(2):
        nxt: list[Path] = []
        for d in frontier:
            try:
                with os.scandir(d) as it:
                    for e in it:
                        budget -= 1
                        if budget < 0:
                            return True
                        try:
                            st = e.stat(follow_symlinks=False)
                        except FileNotFoundError:
                            continue
                        if stat.S_ISSOCK(st.st_mode):
                            return True
                        if stat.S_ISDIR(st.st_mode) and not (depth == 0 and e.name in CMUX_NEXT_CI_TOOL_CACHES):
                            nxt.append(Path(e.path))
            except FileNotFoundError:
                continue  # gone since it was listed
            except OSError:
                return True  # unreadable: a socket in it cannot be ruled out
        frontier = nxt
    return False


def cmux_next_ci_tree_busy(state: Path, aside: str = "") -> str:
    """cmux_next_ci_busy's vetoes read from the tree itself: a socket, an activity marker in it or beside it,
    a child the family does not know. Also read on a slot's detached tree (cmux_next_ci_slot_recheck), and on a
    state one of whose generated children is renamed aside as ASIDE (cmux_next_ci_child_recheck), which is not
    an unknown child."""
    if cmux_next_ci_holds_socket(state):
        return "cmux-next state holds a socket"
    for ancestor in (state, state.parent):
        for entry in _children(ancestor):
            if entry.name in CMUX_NEXT_CI_ACTIVITY_MARKERS:
                return f"cmux-next active or ambiguous marker: {entry.name}"
    unknown = [entry.name for entry in _children(state)
               if entry.name not in CMUX_NEXT_CI_PRESERVED_NAMES
               and entry.name not in CMUX_NEXT_CI_GENERATED_NAMES and entry.name != aside]
    if unknown:
        return "cmux-next state has unknown children: " + ", ".join(sorted(unknown)[:4])
    return ""


STALE_BUILD_MARKER_NAMES = frozenset({".build.active"})


def _stale_marker_candidates(root: Path) -> list[tuple[Path, Path]]:
    """Return build markers only from validated fleet/cmux-next state layouts."""
    if root.is_symlink() or not root.is_dir():
        return []
    found: list[tuple[Path, Path]] = []
    workspaces = root / "cmux-workspaces"
    if not workspaces.is_symlink() and workspaces.is_dir():
        for state in _children(workspaces):
            if state.is_symlink() or not state.is_dir():
                continue
            marker = state / ".build.active"
            if marker.is_file() and not marker.is_symlink():
                found.append((marker, state))
    if root.name == CMUX_NEXT_CI_ROOT:
        for state in cmux_next_ci_state_roots(root):
            marker = state / ".build.active"
            if marker.is_file() and not marker.is_symlink():
                found.append((marker, state))
    return found


def _marker_activity(marker: Path, now: float) -> tuple[float, int | None]:
    """Return marker age and host jobs started after it, when the log is readable."""
    age_hours = max(0.0, (now - marker.stat().st_mtime) / 3600)
    starts = job_starts()
    jobs = None if starts is None else max(0, len(starts) - bisect.bisect_right(starts, marker.stat().st_mtime))
    return age_hours, jobs


def _marker_due(marker: Path, now: float) -> tuple[bool, float, int | None, str]:
    age_hours, jobs = _marker_activity(marker, now)
    min_age = float(POLICY["stale_marker_min_age_hours"])
    required_jobs = int(POLICY["stale_marker_jobs"])
    max_age = float(POLICY["stale_marker_max_hours"])
    if age_hours < min_age:
        return False, age_hours, jobs, "marker-too-new"
    if jobs is not None and jobs >= required_jobs:
        return True, age_hours, jobs, "host-activity"
    if age_hours >= max_age:
        return True, age_hours, jobs, "safety-cap"
    return False, age_hours, jobs, "waiting-for-activity"


def clear_stale_build_markers(receipt: Path, roots: list[Path] | None = None,
                              now: float | None = None) -> int:
    """Clear dead build markers after activity evidence or a bounded safety cap."""
    roots = ([FLEET_ROOT / "cache", HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT]
             if roots is None else roots)
    now = time.time() if now is None else now
    try:
        opened, commands = process_evidence()
    except NoEvidence:
        return 0
    opened_indexed = open_index(opened)
    if any(Path(r).resolve() == (FLEET_ROOT / "cache").resolve() for r in roots) and host_busy():
        return 0
    released = 0
    seen: set[str] = set()
    for root in roots:
        for marker, state in _stale_marker_candidates(Path(root)):
            key = os.fspath(marker)
            if key in seen:
                continue
            seen.add(key)
            try:
                due, age_hours, jobs, reason = _marker_due(marker, now)
            except OSError:
                continue
            if not due:
                continue
            state_text = os.fspath(state)
            if in_cwd(state_text, opened_indexed) or named_by(state_text, commands) or holds_socket(state):
                continue
            siblings = {entry.name for entry in _children(state)}
            if siblings & (CMUX_NEXT_CI_ACTIVITY_MARKERS - STALE_BUILD_MARKER_NAMES):
                continue
            try:
                if artifact_referenced(state, live_artifact_references(FLEET_ROOT)):
                    continue
                before = marker.lstat()
                marker.unlink()
            except OSError:
                continue
            released += before.st_size
            record = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "at_epoch": now,
                      "host": platform.node(), "outcome": "stale-marker-cleared",
                      "family": "build-marker", "path": key, "bytes": before.st_size,
                      "verdict": "reclaimable", "reasons": [reason, {"age_hours": round(age_hours, 1),
                      "jobs_since_marker": jobs, "required_jobs": int(POLICY["stale_marker_jobs"]),
                      "max_age_hours": float(POLICY["stale_marker_max_hours"])}]}
            try:
                receipt.parent.mkdir(parents=True, exist_ok=True)
                with receipt.open("a") as handle:
                    handle.write(json.dumps(record) + "\n")
            except OSError:
                pass
            print(f"  stale-marker-cleared {key} ({reason}, {age_hours:.1f}h, jobs={jobs})")
    return released


def cmux_next_ci_dedupe_roots(root: Path) -> list[Path]:
    """Return generated cmux-next trees eligible for the opt-in clone pass.

    This is deliberately separate from :func:`dedupe_roots`: the normal pass is
    allowed to run while Xcode is active and only visits reusable input caches.  Build
    output is write-heavy and remains excluded; only sealed top-level ``Products``
    output is included by ``--dedupe-builds`` after the guard below proves the
    containing state root is idle and fully understood.
    """
    found: list[Path] = []
    for state in cmux_next_ci_state_roots(root):
        for child in _children(state):
            if child.is_symlink():
                continue
            if child.name in CMUX_NEXT_CI_DEDUPE_DIR_NAMES and child.is_dir():
                found.append(child)
                continue
            # Current Xcode state roots nest the sealed products under the
            # write-heavy Build tree. Admit only that Products leaf.
            if child.name == "Build":
                products = child / "Products"
                if products.is_dir() and not products.is_symlink():
                    found.append(products)
    return sorted(found)


def cmux_next_ci_dedupe_guard(root: Path):
    """Return a fresh, fail-closed guard for one cmux-next clone operation.

    APFS clones are copy-on-write, so a later compiler write cannot corrupt another
    path's bytes.  The unsafe part is replacing a path while a job is using its state
    root, has a lock/socket there, or has introduced an unknown child.  Recollect
    process evidence for each canonical/target pair instead of trusting the initial
    walk.  If lsof/ps cannot provide evidence, the guard refuses the clone.
    """
    fam = cmux_next_ci_family(root)
    # A duplicate pair gets one lsof/ps snapshot for both paths.  dedupe() calls
    # the guard for canonical then target in that order; consuming the snapshot on
    # the second call avoids paying for two full lsof walks per clone while still
    # taking fresh evidence for every atomic swap.
    pending_evidence = None
    pending_path = None

    def allowed(path: str | Path) -> bool:
        nonlocal pending_evidence, pending_path
        path = Path(path)
        state = cmux_next_ci_state_for_path(path, root)
        if state is None:
            return False
        # Products may be a direct state child or the sealed Products leaf below Build.
        try:
            relative = path.relative_to(state).parts
        except (ValueError, IndexError):
            return False
        if not relative:
            return False
        if relative[0] in CMUX_NEXT_CI_DEDUPE_DIR_NAMES:
            child = state / relative[0]
        elif relative[:2] == ("Build", "Products"):
            child = state / "Build"
        else:
            return False
        if not child.is_dir():
            return False
        if pending_evidence is None or pending_path is None:
            try:
                opened, commands = process_evidence()
            except NoEvidence:
                return False
            pending_evidence = (open_index(opened), commands)
            pending_path = path
        else:
            opened, commands = pending_evidence
            pending_evidence = None
            pending_path = None
        # Lease/reservation paths are decision evidence, not a long-lived cache:
        # invalidate the bounded read-only snapshot before this pair's check.
        _LIVE_REFERENCES.pop(os.fspath(FLEET_ROOT), None)
        if artifact_referenced(state, live_artifact_references(FLEET_ROOT)):
            return False
        return not cmux_next_ci_busy(fam, child, opened, commands)

    return allowed


# -- capture and evidence trees (dedupe_capture_roots in disk-policy.json) ------------------------------
# Screen-capture rigs write the same PNG frame over and over across takes. Those trees are nobody's cache, so
# nothing may be deleted there: the capture pass only clones byte-identical files onto one copy, and holds
# every swap to stricter rules than the Xcode pass (clone_over strict=True): bytes compared, not just hashed;
# same volume; never a file a process has open for writing or that changed within the settle window; owner,
# group, mode, times, birth time, flags, xattrs and ACL all kept or the swap is refused; a bounded pass.
DEDUPE_META = ""  # the state file's key for the pass's own bookkeeping (no real path is "")
DEDUPE_SKIP_DIRS = frozenset({".git"})  # a checkout's object store inside a capture tree is never walked
CAPTURE_WRITERS_REFRESH_S = 60.0


def capture_dedupe_roots(patterns: list[str], home: Path | None = None) -> list[Path]:
    """The capture roots disk-policy names, "~" as this account's home and globs expanded, in order: real
    directories only (no symlink, no file, nothing missing), each once."""
    home = HOME if home is None else home
    out: list[Path] = []
    for pattern in patterns:
        if pattern == "~" or pattern.startswith("~/"):
            pattern = os.fspath(home) + pattern[1:]
        for match in sorted(glob.glob(pattern)) if glob.has_magic(pattern) else [pattern]:
            p = Path(match)
            if p.is_dir() and not p.is_symlink() and p not in out:
                out.append(p)
    return out


def lsof_writers(text: str) -> frozenset[str]:
    """Paths `lsof -F an` lists as open for writing (access w or u)."""
    out: set[str] = set()
    access = ""
    for line in text.splitlines():
        tag, value = line[:1], line[1:]
        if tag in ("p", "f"):
            access = ""
        elif tag == "a":
            access = value
        elif tag == "n" and access in ("w", "u") and value.startswith("/"):
            out.add(value)
    return frozenset(out)


def open_for_writing() -> frozenset[str]:
    """Every path some process has open for writing now. Raises NoEvidence when lsof cannot tell."""
    lsof = shutil.which("lsof") or "/usr/sbin/lsof"
    try:
        code, out = _owned_query([lsof, "-n", "-P", "-w", "-F", "an"], 120)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise NoEvidence(f"lsof: {e}") from e
    # lsof exits 1 when some processes could not be read (other users'); no output at all is no evidence
    if code not in (0, 1) or "\nn/" not in out:
        raise NoEvidence(f"lsof gave no open files (exit {code})")
    return lsof_writers(out)


def capture_dedupe_guard(refresh_s: float = CAPTURE_WRITERS_REFRESH_S, clock=time.monotonic):
    """A dedupe guard that refuses any path a process has open for writing. The writer list is read when the
    guard is made (NoEvidence propagates, so the caller skips the pass) and again once it is refresh_s old;
    a refresh that fails refuses every swap until one succeeds."""
    seen = {"writers": open_for_writing(), "at": clock()}

    def allowed(path: str | Path) -> bool:
        if clock() - seen["at"] >= refresh_s:
            try:
                seen["writers"] = open_for_writing()
            except NoEvidence:
                seen["writers"] = None
            seen["at"] = clock()
        writers = seen["writers"]
        if writers is None:
            return False
        path = os.fspath(path)
        return path not in writers and os.path.realpath(path) not in writers

    return allowed


class _AttrList(ctypes.Structure):
    _fields_ = [("bitmapcount", ctypes.c_ushort), ("reserved", ctypes.c_uint16),
                ("commonattr", ctypes.c_uint32), ("volattr", ctypes.c_uint32), ("dirattr", ctypes.c_uint32),
                ("fileattr", ctypes.c_uint32), ("forkattr", ctypes.c_uint32)]


class _Timespec(ctypes.Structure):
    _fields_ = [("tv_sec", ctypes.c_long), ("tv_nsec", ctypes.c_long)]


_LIBC = None
_XATTR_NOFOLLOW = 0x0001
_FSOPT_NOFOLLOW = 0x0001
_FSOPT_ATTR_CMN_EXTENDED = 0x0020
_ATTR_CMN_CRTIME = 0x00000200
_ATTR_CMNEXT_CLONEID = 0x00000100
_ACL_TYPE_EXTENDED = 0x00000100


def _libc():
    """libc with the macOS metadata calls typed, or None off macOS."""
    global _LIBC
    if _LIBC is None and DARWIN:
        lib = ctypes.CDLL(None, use_errno=True)
        lib.listxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_int]
        lib.listxattr.restype = ctypes.c_ssize_t
        lib.getxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_size_t,
                                 ctypes.c_uint32, ctypes.c_int]
        lib.getxattr.restype = ctypes.c_ssize_t
        lib.getattrlist.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t,
                                    ctypes.c_uint]
        lib.setattrlist.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t,
                                    ctypes.c_uint]
        lib.acl_get_link_np.argtypes = [ctypes.c_char_p, ctypes.c_int]
        lib.acl_get_link_np.restype = ctypes.c_void_p
        lib.acl_to_text.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        lib.acl_to_text.restype = ctypes.c_void_p
        lib.acl_free.argtypes = [ctypes.c_void_p]
        _LIBC = lib
    return _LIBC


def file_xattrs(path: str) -> dict[str, bytes] | None:
    """A file's extended attributes (not following a symlink), or None when they cannot be read."""
    lib, raw = _libc(), os.fsencode(path)
    if lib is None:
        return None
    size = lib.listxattr(raw, None, 0, _XATTR_NOFOLLOW)
    if size < 0:
        return None
    names = ctypes.create_string_buffer(size or 1)
    size = lib.listxattr(raw, names, size, _XATTR_NOFOLLOW)
    if size < 0:
        return None
    out: dict[str, bytes] = {}
    for name in names.raw[:size].split(b"\0"):
        if not name:
            continue
        n = lib.getxattr(raw, name, None, 0, 0, _XATTR_NOFOLLOW)
        if n < 0:
            return None
        value = ctypes.create_string_buffer(n or 1)
        if lib.getxattr(raw, name, value, n, 0, _XATTR_NOFOLLOW) != n:
            return None
        out[name.decode("utf-8", "surrogateescape")] = value.raw[:n]
    return out


def file_acl(path: str) -> str | None:
    """A file's extended ACL as text, "" when it has none, or None when it cannot be read."""
    lib = _libc()
    if lib is None:
        return None
    acl = lib.acl_get_link_np(os.fsencode(path), _ACL_TYPE_EXTENDED)
    if not acl:
        return "" if ctypes.get_errno() == 2 else None  # ENOENT: no ACL
    try:
        text = lib.acl_to_text(acl, None)
        if not text:
            return None
        try:
            return ctypes.string_at(text).decode("utf-8", "replace")
        finally:
            lib.acl_free(text)
    finally:
        lib.acl_free(acl)


def _attr_list(common: int = 0, fork: int = 0) -> _AttrList:
    return _AttrList(5, 0, common, 0, 0, 0, fork)


def file_birthtime(path: str) -> tuple[int, int] | None:
    """A file's birth (creation) time as (seconds, nanoseconds), or None."""
    lib = _libc()
    if lib is None:
        return None
    al, buf = _attr_list(common=_ATTR_CMN_CRTIME), ctypes.create_string_buffer(64)
    if lib.getattrlist(os.fsencode(path), ctypes.byref(al), buf, 64, _FSOPT_NOFOLLOW) != 0:
        return None
    _, sec, nsec = struct.unpack_from("<Iqq", buf.raw)
    return sec, nsec


def set_file_birthtime(path: str, when: tuple[int, int]) -> bool:
    lib = _libc()
    if lib is None:
        return False
    al, ts = _attr_list(common=_ATTR_CMN_CRTIME), _Timespec(*when)
    return lib.setattrlist(os.fsencode(path), ctypes.byref(al), ctypes.byref(ts), ctypes.sizeof(ts),
                           _FSOPT_NOFOLLOW) == 0


def file_clone_id(path: str) -> int | None:
    """APFS's id for a file's data stream: two files that share it are already clones of each other."""
    lib = _libc()
    if lib is None:
        return None
    al, buf = _attr_list(fork=_ATTR_CMNEXT_CLONEID), ctypes.create_string_buffer(64)
    if lib.getattrlist(os.fsencode(path), ctypes.byref(al), buf, 64,
                       _FSOPT_NOFOLLOW | _FSOPT_ATTR_CMN_EXTENDED) != 0:
        return None
    clone_id = struct.unpack_from("<IQ", buf.raw)[1]
    return clone_id or None


def same_bytes(a: str, b: str) -> bool:
    """Whether two files hold the same bytes, read in full (a hash match alone never clones a capture file)."""
    with open(a, "rb") as fa, open(b, "rb") as fb:
        while True:
            ca, cb = fa.read(1 << 20), fb.read(1 << 20)
            if ca != cb:
                return False
            if not ca:
                return True


def _metadata(path: str) -> tuple | None:
    """What a strict swap must keep that the clone might not: xattrs and ACL (None when unreadable)."""
    xattrs, acl = file_xattrs(path), file_acl(path)
    return None if xattrs is None or acl is None else (xattrs, acl)


def dedupe_roots(derived_data: Path) -> list[Path]:
    roots = [derived_data / sub for sub in DEDUPE_SUBDIRS]
    for d in _children(derived_data):
        if not d.is_symlink():
            roots += [d / sub for sub in DEDUPE_SUBDIRS]
    return [r for r in roots if r.is_dir() and not r.is_symlink()]


def _file_key(st: os.stat_result) -> list[int]:
    return [st.st_size, st.st_mtime_ns, st.st_ino]


def _sha256(path: str) -> str:
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(1 << 20):
            h.update(chunk)
    return h.hexdigest()


def clone_over(canonical: str, target: str, expect: list[int],
               canonical_expect: list[int] | None = None, strict: bool = False) -> bool:
    """Replace target with an APFS clone of canonical, keeping target's mode and times.

    Refuses when target or canonical changed since they were hashed, checked before and
    after the copy, so a file rewritten mid-run can never be cloned over a verified one. A process that has target open keeps
    reading the old inode; the rename only swaps the directory entry. Refuses two files on different
    volumes (a copy there saves nothing). strict (capture trees) also refuses when the bytes differ, when
    this account does not own target, when either file carries flags (other than APFS compression), or
    when their xattrs or ACLs differ; it keeps target's group and birth time and checks the clone's
    metadata matches target's before the swap.
    """
    st = os.lstat(target)
    if _file_key(st) != expect or not stat.S_ISREG(st.st_mode):
        return False
    cst = os.lstat(canonical)
    if cst.st_dev != st.st_dev or not stat.S_ISREG(cst.st_mode):
        return False
    if canonical_expect is not None and _file_key(cst) != canonical_expect:
        return False
    if strict:
        compressed = getattr(stat, "UF_COMPRESSED", 0x20)
        if st.st_uid != os.geteuid() or (st.st_flags | cst.st_flags) & ~compressed:
            return False
        meta = _metadata(target)
        if meta is None or meta != _metadata(canonical):
            return False
        born = file_birthtime(target)
        if born is None or not same_bytes(canonical, target):
            return False
    tmp = os.path.join(os.path.dirname(target), f".{os.path.basename(target)}.glaeda-clone-{os.getpid()}")
    try:
        subprocess.run(["/bin/cp", "-c", canonical, tmp], check=True, capture_output=True, timeout=60)
        os.chmod(tmp, stat.S_IMODE(st.st_mode))
        if strict:
            tst = os.lstat(tmp)
            if tst.st_gid != st.st_gid:
                os.chown(tmp, -1, st.st_gid)
            os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
            if not set_file_birthtime(tmp, born):
                return False
            tst = os.lstat(tmp)
            kept = (tst.st_uid, tst.st_gid, tst.st_mode, tst.st_mtime_ns, tst.st_dev)
            if (kept != (st.st_uid, st.st_gid, st.st_mode, st.st_mtime_ns, st.st_dev)
                    or file_birthtime(tmp) != born or _metadata(tmp) != meta):
                return False
        else:
            os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
        if _file_key(os.lstat(target)) != expect:
            return False
        if canonical_expect is not None and _file_key(os.lstat(canonical)) != canonical_expect:
            return False
        os.rename(tmp, target)
        return True
    finally:
        if os.path.lexists(tmp):
            os.unlink(tmp)


def dedupe(roots: list[Path], state_path: Path = DEDUPE_STATE,
           min_bytes: int = DEDUPE_MIN_BYTES, settle_s: float = 0,
           guard=None, strict: bool = False, budget_s: float | None = None,
           clock=time.monotonic) -> dict[str, Any]:
    """Clone-dedupe identical files.

    ``guard`` is an optional fresh safety check used for write-heavy trees.  It is
    called immediately before hashing a target/canonical pair is replaced and must
    return true for both paths.  A guard failure is a refusal, not a reason to fall
    back to a weaker cache policy.  Files modified within ``settle_s`` are left for a
    later run. Only files on the same volume are paired. ``strict`` is clone_over's (capture trees), and also
    leaves files that already share an APFS clone as they are ("shared").

    ``budget_s`` bounds the pass: the walk stops at half of it, hashing and cloning at all of it, and the
    result says "complete": False. The hashes made so far are kept in the state, and the next pass starts its
    walk at the root this one stopped in (or the one after, when that root already went first and still did
    not fit), so a tree bigger than one pass cannot keep the others from ever being walked.
    """
    try:
        state: dict[str, dict] = json.loads(state_path.read_text())
        if not isinstance(state, dict):
            state = {}
    except (OSError, ValueError):
        state = {}
    meta = state.pop(DEDUPE_META, None)
    meta = meta if isinstance(meta, dict) else {}
    started = clock()
    deadline = None if budget_s is None else started + budget_s
    walk_deadline = None if budget_s is None else started + budget_s / 2

    def over(limit: float | None) -> bool:
        return limit is not None and clock() >= limit

    complete = True
    files: dict[str, list[int]] = {}
    devs: dict[str, int] = {}
    walked: set[str] = set()
    young = 0
    cutoff = time.time() - settle_s
    first = int(meta.get("next_root", 0)) % len(roots) if roots else 0
    order = list(range(first, len(roots))) + list(range(first))
    next_root = first
    for n, i in enumerate(order):
        stopped = False
        for dirpath, dirnames, filenames in os.walk(roots[i]):
            dirnames[:] = sorted(d for d in dirnames if d not in DEDUPE_SKIP_DIRS
                                 and not os.path.islink(os.path.join(dirpath, d)))
            for name in sorted(filenames):
                if over(walk_deadline):
                    stopped = True
                    break
                if ".glaeda-clone-" in name:
                    continue
                path = os.path.join(dirpath, name)
                walked.add(path)
                try:
                    st = os.lstat(path)
                except OSError:
                    continue
                if stat.S_ISREG(st.st_mode) and st.st_size >= min_bytes and st.st_nlink == 1:
                    if st.st_mtime > cutoff:
                        young += 1  # still being downloaded or written
                        continue
                    files[path] = _file_key(st)
                    devs[path] = st.st_dev
            if stopped:
                break
        if stopped:
            complete = False
            # the root it stopped in goes first next time, unless it already went first and did not fit
            next_root = (i + 1) % len(roots) if n == 0 else i
            break
    by_size: dict[tuple[int, int], list[str]] = {}
    for path, key in files.items():
        by_size.setdefault((devs[path], key[0]), []).append(path)
    # an incomplete pass keeps what it knew about the files it did not reach this time
    new_state: dict[str, dict] = ({} if complete else
                                  {p: v for p, v in state.items() if p not in walked and isinstance(v, dict)})
    groups: dict[tuple[int, str], list[str]] = {}
    hashed = 0
    for (dev, _), paths in sorted(by_size.items()):
        if len(paths) < 2:
            continue
        for path in paths:
            old = state.get(path)
            if old and old.get("key") == files[path]:
                sha, cloned = old["sha"], old.get("cloned", False)
            else:
                if over(deadline):
                    complete = False
                    continue
                try:
                    sha = _sha256(path)
                except OSError:
                    continue
                cloned, hashed = False, hashed + files[path][0]
            new_state[path] = {"key": files[path], "sha": sha, "cloned": cloned}
            groups.setdefault((dev, sha), []).append(path)
    cloned_bytes = refused = shared = 0
    for (_, sha), paths in groups.items():
        if len(paths) < 2:
            continue
        paths.sort(key=lambda p: (not new_state[p]["cloned"], p))
        canonical = paths[0]
        canonical_id = file_clone_id(canonical) if strict else None
        for target in paths[1:]:
            if new_state[target]["cloned"]:
                continue
            if canonical_id is not None and file_clone_id(target) == canonical_id:
                new_state[target]["cloned"] = True  # already one copy on disk (an earlier clone, by hand or not)
                shared += 1
                continue
            if over(deadline):
                complete = False
                break
            # Recheck both sides immediately before the atomic swap.  The canonical
            # file may itself have become busy since the hash walk, and a target may
            # have been adopted by a newly-started job.  clone_over's inode/mtime
            # checks remain the final content race protection.
            if guard is not None:
                try:
                    # Evaluate both calls even when canonical is refused so a guard
                    # that batches one process-evidence snapshot per pair can clear
                    # its pending snapshot before the next pair.
                    canonical_ok = guard(canonical)
                    target_ok = guard(target)
                    if not canonical_ok or not target_ok:
                        refused += 1
                        continue
                except (OSError, ValueError):
                    refused += 1
                    continue
            try:
                ok = clone_over(canonical, target, files[target], files[canonical], strict=strict)
                if ok:
                    new_state[target] = {"key": _file_key(os.lstat(target)), "sha": sha,
                                         "cloned": True}
            except (OSError, subprocess.SubprocessError):
                ok = False
                new_state.pop(target, None)  # vanished or unreadable; rehash next run
            if ok:
                cloned_bytes += files[target][0]
            else:
                refused += 1
        new_state[canonical]["cloned"] = True
    if budget_s is not None:
        new_state[DEDUPE_META] = {"next_root": next_root}
    state_path.parent.mkdir(parents=True, exist_ok=True)
    tmp = state_path.with_suffix(f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(new_state))
    os.replace(tmp, state_path)
    return {"files": len(files), "hashed_bytes": hashed, "cloned_bytes": cloned_bytes,
            "refused": refused, "young": young, "shared": shared, "complete": complete}


def dedupe_xcode(a: argparse.Namespace, bases: list[Path], ci_root: Path) -> None:
    """The Xcode pass: DerivedData's and cmux-next's package and module caches (and, with --dedupe-builds,
    sealed cmux-next Products), files of 1 MiB and up, retried while files are still settling."""
    input_roots = [r for b in bases for r in dedupe_roots(b)]
    passes = [(input_roots, DEDUPE_STATE, a.settle_minutes * 60, None)]
    if a.dedupe_builds:
        # Sealed Products output is opt-in because the normal LaunchAgent can run
        # while a job is compiling.  Top-level Build remains excluded.  Only
        # validated Products trees are admitted, and the per-clone guard rechecks
        # process/lease/lock/socket/unknown-child state.
        build_roots = cmux_next_ci_dedupe_roots(ci_root)
        if build_roots:
            build_state = DEDUPE_STATE.with_name("dedupe-builds.json")
            passes.append((build_roots, build_state,
                           max(a.settle_minutes * 60,
                               CMUX_NEXT_CI_DEDUPE_SETTLE_MINUTES * 60),
                           cmux_next_ci_dedupe_guard(ci_root)))
    before, _ = free_bytes(bases[0])
    started = time.time()
    for attempt in range(3):
        totals = {"files": 0, "hashed_bytes": 0, "cloned_bytes": 0,
                  "refused": 0, "young": 0}
        for roots, state_path, settle_s, guard in passes:
            r = dedupe(roots, state_path, settle_s=settle_s, guard=guard)
            for key in totals:
                totals[key] += r[key]
        after, _ = free_bytes(bases[0])
        print(f"dedupe: {totals['files']} files >= 1 MiB, hashed {gib(totals['hashed_bytes']).strip()}, "
              f"cloned {gib(totals['cloned_bytes']).strip()}, refused {totals['refused']}, "
              f"still settling {totals['young']}, free {gib(before).strip()} -> {gib(after).strip()} "
              f"in {time.time() - started:.0f}s", flush=True)
        if not totals["young"] or attempt == 2:
            break
        time.sleep(a.settle_minutes * 60)


def dedupe_captures(roots: list[Path]) -> None:
    """The capture pass: dedupe_capture_roots at their own floor, strict swaps, no file open for writing,
    one bounded pass (dedupe_capture_budget_minutes) that the next one resumes."""
    floor_kib = POLICY["dedupe_capture_min_kib"]
    try:
        guard = capture_dedupe_guard()
    except NoEvidence as e:
        print(f"dedupe captures: skipped ({e})", flush=True)
        return
    before, _ = free_bytes(roots[0])
    started = time.time()
    r = dedupe(roots, DEDUPE_STATE.with_name("dedupe-captures.json"), min_bytes=int(floor_kib * 1024),
               settle_s=POLICY["dedupe_capture_settle_minutes"] * 60, guard=guard, strict=True,
               budget_s=POLICY["dedupe_capture_budget_minutes"] * 60)
    after, _ = free_bytes(roots[0])
    print(f"dedupe captures: {r['files']} files >= {floor_kib:g} KiB in {len(roots)} roots, "
          f"hashed {gib(r['hashed_bytes']).strip()}, cloned {gib(r['cloned_bytes']).strip()}, "
          f"already shared {r['shared']}, refused {r['refused']}, still settling {r['young']}, "
          f"{'complete' if r['complete'] else 'stopped at its budget (the next pass resumes)'}, "
          f"free {gib(before).strip()} -> {gib(after).strip()} in {time.time() - started:.0f}s", flush=True)


def _main_impl(argv: list[str] | None = None) -> int:
    global _ACTIVE_MEASURE_HANDLE, _REFRESH_PROGRESS_KNOWN
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("command", nargs="?", choices=("report", "keepup"),
                    help="report is read-only; keepup enables the same policy surface explicitly")
    ap.add_argument("--apply", action="store_true", help="delete reclaimable items")
    ap.add_argument("--role", choices=("fleet-mini", "devbox"), default=None,
                    help="policy role (default: fleet-mini; hygiene installs default to devbox)")
    ap.add_argument("--devbox", dest="role_devbox", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--pressure", action="store_true",
                    help="only act when free space is below --low; stop at --target")
    ap.add_argument("--idle", action="store_true",
                    help="idle sweep: only while no job runs, delete what sat idle past its family's reuse "
                         "window whatever the free space; with --pressure, only when there is no pressure, "
                         "at most hourly")
    # Air Blue sat at 3-7% free for a day with the old 15%/25%: act earlier and free more per run
    ap.add_argument("--low", default=POLICY["low"],
                    help="pressure threshold per filesystem: GiB free, N%% of its size, or "
                         "N%%:LO-HI to hold that share between LO and HI GiB (default %(default)s)")
    ap.add_argument("--target", default=POLICY["target"],
                    help="stop freeing at this much free, same forms (default %(default)s)")
    ap.add_argument("--tmpfs-low", default="75%",
                    help="pressure threshold for a tmpfs, whose files live in RAM and swap "
                         "(default %(default)s free)")
    ap.add_argument("--tmpfs-target", default="90%",
                    help="stop freeing a tmpfs at this much free (default %(default)s)")
    # One cold cmux job can write 10-36 GiB between two 15-minute runs, so the floor sits well above empty.
    ap.add_argument("--emergency", default=POLICY["emergency"],
                    help="with --pressure --apply: delete even while a CI job runs once free space is "
                         "below this, same forms as --low (default %(default)s)")
    ap.add_argument("--floor-gib", type=float, default=0.0,
                    help="a runner disk floor to honour besides the ones read from runner hooks (runner_floor_gib): "
                         "the runner hook passes its own --min-free-gib when it evicts before refusing a job")
    ap.add_argument("--need", type=float, default=None,
                    help="make room for this many GiB before a job; derives thresholds from the policy margins")
    ap.add_argument("--cmux-next-cap-gib", type=float, default=POLICY["cmux_next_ci_cap_gib"],
                    help="under pressure, while ~/Library/Caches/cmux-next-ci is over this many GiB, its least "
                         "recently used generated output (and states no enrolled runner owns) go whatever their age; "
                         "0 turns the cap off (default %(default)g, disk-policy.json cmux_next_ci_cap_gib)")
    ap.add_argument("--cmux-next-drain", action="store_true",
                    help="explicit enrolled-runner maintenance: drain cmux-next generated output under host.lock")
    ap.add_argument("--cmux-next-reservation-owner",
                    help="cmux-next drain: exact owner string in the active Glaeda reservation")
    ap.add_argument("--idle-hours", type=float, default=None,
                    help="idle window (default 12h, or 6h under pressure)")
    ap.add_argument("--family", action="append", help="limit to these family ids")
    ap.add_argument("--runner-caches", action="store_true",
                    help="use the narrow enrolled-runner account profile (macOS only)")
    ap.add_argument("--top", type=int, default=25)
    ap.add_argument("--min-mib", type=int, default=50)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--dedupe", action="store_true",
                    help="clone-dedupe identical Xcode package and module-cache files, and files of "
                         "dedupe_capture_min_kib and up in disk-policy's dedupe_capture_roots, then exit")
    ap.add_argument("--dedupe-builds", action="store_true",
                    help="also clone-dedupe inactive cmux-next Products trees (APFS/macOS only)")
    ap.add_argument("--settle-minutes", type=float, default=0,
                    help="with --dedupe: skip files changed this recently, wait and retry (up to 3 passes)")
    ap.add_argument("--refresh", action="store_true", help="re-measure all sizes now")
    ap.add_argument("--refresh-lock-fd", type=int, default=None, help=argparse.SUPPRESS)
    ap.add_argument("--refresh-budget-s", type=float, default=0, help=argparse.SUPPRESS)
    ap.add_argument("--max-age", type=float, default=15,
                    help="minutes before the size snapshot is refreshed in the background (default 15)")
    ap.add_argument("--no-snapshot", action="store_true", help=argparse.SUPPRESS)  # tests
    ap.add_argument("--receipt", type=Path,
                    default=HOME / "Projects/recovery/disk-reclaim/receipts.jsonl")
    ap.add_argument("--root-override", action="append", default=[], metavar="ID=PATH",
                    help=argparse.SUPPRESS)  # tests
    a = ap.parse_args(argv)

    def deferred(reason: str, message: str, **details) -> int:
        RUN["skipped"] = reason
        if a.json:
            print(json.dumps({"status": "deferred", "complete": False,
                              "reason": reason, "message": message, **details}))
            return 3
        print(message)
        return 0

    if a.command == "report":
        a.apply = False
        a.pressure = False
        a.idle = False
    elif a.command == "keepup":
        # Keepup is intentionally report-first; callers must opt into mutation with --apply.
        a.pressure = bool(a.apply)
        a.idle = bool(a.apply)
    RUN.update(apply=a.apply, mode="keepup" if a.command == "keepup" else "pressure" if a.pressure
               else "idle" if a.idle else "apply")
    if (a.apply or a.dedupe or a.dedupe_builds) and (why := disk_off()):
        print(f"glaeda-disk is off ({why}): nothing deleted")
        RUN.update(off=True, skipped="off")
        return 0
    role = "devbox" if a.role_devbox else (a.role or "fleet-mini")
    global ROLE
    ROLE = role

    if a.cmux_next_drain:
        if (not a.apply or not a.pressure or a.need is None or a.family != [CMUX_NEXT_CI_FAMILY]
                or not a.cmux_next_reservation_owner
                or not a.runner_caches or a.idle or a.dedupe or a.dedupe_builds):
            print("cmux-next drain requires --runner-caches --pressure --need --family cmux-next-ci-generated "
                  "--cmux-next-reservation-owner OWNER --apply")
            return 3
        global CMUX_NEXT_CI_DRAIN
        CMUX_NEXT_CI_DRAIN = True

    global _REFRESH_HANDLE
    if a.refresh_lock_fd is not None:
        try:
            _REFRESH_HANDLE = os.fdopen(a.refresh_lock_fd, "a+")
        except (OSError, ValueError):
            print("refresh lock unavailable; skipped")
            return 0

    if not math.isfinite(a.cmux_next_cap_gib) or a.cmux_next_cap_gib < 0:
        ap.error("--cmux-next-cap-gib must be a non-negative GiB value")
    if a.need is not None:
        if not math.isfinite(a.need) or a.need <= 0:
            ap.error("--need must be a positive GiB value")
        a.floor_gib = max(a.floor_gib, a.need)
        a.low = f"{a.need + POLICY['low_margin_gib']:g}"
        a.target = f"{a.need + POLICY['target_margin_gib']:g}"

    # before any family is built: a reserved host's families keep its holder's ages (keep_legacy_ages, once 12 h lands)
    reserved = (host_reservation() if role == "fleet-mini" and DARWIN and (a.apply or a.dedupe or a.dedupe_builds)
                else "")
    if reserved:
        keep_legacy_ages()
    global RUNNER_CACHE_PROFILE
    RUNNER_CACHE_PROFILE = bool(a.runner_caches)
    fams = runner_cache_families() if RUNNER_CACHE_PROFILE else default_families(role)
    if RUNNER_CACHE_PROFILE and not DARWIN:
        print("runner cache profile is macOS-only; skipped")
        return 0
    if RUNNER_CACHE_PROFILE and not runner_profile_roots_safe(fams):
        print("runner cache profile roots are not safe; skipped")
        return 0
    for ov in a.root_override:
        fid, _, p = ov.partition("=")
        fams = [replace(f, root=Path(p), files=False, min_bytes=None, git_disposable=False)
                if f.id == fid else f for f in fams]
    every = fams
    if a.family:
        fams = [f for f in fams if f.id in a.family]
    if RUNNER_CACHE_PROFILE and not runner_profile_roots_safe(fams):
        print("runner cache profile roots are not safe; skipped")
        return 0
    if (a.dedupe or a.dedupe_builds) and reserved:
        print(f"{reserved}: only floor-pressure eviction runs here; no dedupe")
        return 0
    if a.dedupe or a.dedupe_builds:
        dd = next((f.root for f in fams if f.id == "xcode-derived-data"), None)
        ci_root = HOME / "Library/Caches" / CMUX_NEXT_CI_ROOT
        ci_dirs = cmux_next_ci_dirs() if not RUNNER_CACHE_PROFILE else []
        bases = ([dd] if dd is not None else []) + ci_dirs
        # the narrow runner-account profile never walks beyond its cache allowlist
        captures = ([] if RUNNER_CACHE_PROFILE or not DARWIN
                    else capture_dedupe_roots(POLICY["dedupe_capture_roots"]))
        if not (bases or captures) or not DARWIN:
            print("nothing to dedupe (APFS clones of Xcode DerivedData are macOS only)")
            return 0
        if bases:
            dedupe_xcode(a, bases, ci_root)
        if captures:
            dedupe_captures(captures)
        return 0
    if RUNNER_CACHE_PROFILE and not fams:
        # An account with no known CI roots has nothing to sweep. Do not fall back
        # to a synthetic HOME family, which would turn this allowlist into a broad
        # home traversal.
        print("runner cache profile: no configured cache roots")
        return 0
    try:
        floor_gib = max(runner_floor_gib(), a.floor_gib if math.isfinite(a.floor_gib) else 0.0)
        if reserved:
            RUN["reserved"] = reserved
            a.idle = False  # no idle sweep on a reserved host
            if not a.pressure or floor_gib <= 0:
                print(f"{reserved}: only floor-pressure eviction runs here"
                      f"{'' if a.pressure else ' (--pressure)'}{'' if floor_gib > 0 else ', and it has no runner floor'}; "
                      "nothing deleted")
                RUN["skipped"] = "reserved host: floor-pressure eviction only"
                return 0
            # pressure below the floor only, and only back to the floor plus the margin
            a.low, a.target = f"{floor_gib:g}", f"{floor_gib + POLICY['target_margin_gib']:g}"
            print(f"{reserved}: only floor-pressure eviction runs here")
        fss = filesystems(fams or [Family("home", HOME, False, "")], a.low, a.target,
                          a.tmpfs_low, a.tmpfs_target, floor_gib, **({"reserved": True} if reserved else {}))
        space(a.emergency, GIB)
    except ValueError:
        ap.error(f"--low/--target/--tmpfs-*/--emergency take GiB or N%: {a.low!r}, {a.target!r}, "
                 f"{a.tmpfs_low!r}, {a.tmpfs_target!r}, {a.emergency!r}")
    # a tmpfs is under pressure at a quarter full, so it shortens the idle window only for
    # pressure runs, which then touch nothing but that filesystem's families
    under = any(fs.under for fs in fss.values() if a.pressure or not fs.tmpfs)
    sweep = a.idle and not (a.pressure and under)
    RUN["floor_gib"] = round(floor_gib, 1)
    # every filesystem's exact target, and whether they are the ones a plain `--pressure --apply` works to: the runner
    # hook skips its pass while every one is met (disk_targets there)
    RUN["targets"] = {fs.mount: fs.target for fs in fss.values()}
    RUN["config_sha256"] = config_sha256()
    RUN["default_targets"] = (a.low == POLICY["low"] and a.target == POLICY["target"] and a.need is None
                              and a.tmpfs_low == "75%" and a.tmpfs_target == "90%" and not a.family
                              and not a.root_override and not a.runner_caches)
    with contextlib.suppress(OSError):
        if (home_fs := fss.get(HOME.stat().st_dev)) is not None:
            RUN.update(target_gib=round(home_fs.target / GIB, 1), target_bytes=home_fs.target)
    if a.pressure and not under:
        for fs in fss.values():
            print(f"no pressure: {gib(fs.free).strip()} free >= {gib(fs.low).strip()} on {fs.mount}")
        if not a.idle:
            RUN["skipped"] = "no pressure"
            return 0
        if not idle_due():
            print(f"idle sweep: the last one ran within {IDLE_SWEEP_EVERY_S // 60} min")
            RUN["skipped"] = "no pressure; idle sweep ran within the hour"
            return 0
    global ACTIVITY_MODE, EMERGENCY_DEVS, FLOOR_HOLD, CMUX_NEXT_HOST_FLOOR
    ACTIVITY_MODE = "sweep" if sweep else "pressure" if a.pressure else None
    # the idle sweep judges by reuse windows alone; a pressure run or a report sees the emergency floor
    EMERGENCY_DEVS = frozenset() if sweep else emergency_devs(fss, a.emergency, floor_gib)
    FLOOR_HOLD = floor_hold(fss, floor_gib) if ACTIVITY_MODE == "pressure" else {}
    CMUX_NEXT_HOST_FLOOR = {dev: int(floor_gib * GIB) for dev in FLOOR_HOLD}
    busy = host_busy() if sweep else ""
    if sweep:
        print(f"idle sweep: {'host busy, ' + busy if busy else 'host idle'}")
        # a busy host sweeps too (POLICY defer_during_ci false): only items a job uses are held
        if busy and a.apply and POLICY["defer_during_ci"]:
            return 0
        a.pressure = False  # the sweep reports and acts on every filesystem, without targets
        fams = idle_families(fams)
    if a.pressure:
        # only families on a filesystem under pressure are surveyed or touched
        fams = [f for f in fams if fss[f.root.stat().st_dev].under]
        # Before the cap's du (10-20 s on a mini): a run that would only find evict.lock taken stops here. Another
        # caller's pressure run (the LaunchAgent's, idle-repair's) joins the runner hook's queue while a hook pass is
        # under way, so that pass serves it with its one follow-up rather than this run skipping as busy. It does so
        # before any deferral, so a deferred run's trigger is still left (or kept claimed) for a later pass.
        if a.apply and not a.cmux_next_drain and not RUNNER_CACHE_PROFILE \
                and os.environ.get(HOOK_PASS_ENV) != "1" and take_hook_pass() is False:
            return deferred(COALESCED_INTO_HOOK, "a runner hook pass is under way; this run joins its queue")
        if a.apply and POLICY["defer_during_ci"] and (why := ci_defer(fss, ci_jobs(), a.emergency, floor_gib)):
            print(why)
            RUN["skipped"] = "defer_during_ci"
            return 0
        if a.apply and not a.cmux_next_drain and not RUNNER_CACHE_PROFILE:
            if eviction_lock_is_held():
                owner = eviction_owner_status()
                RUN["evict_owner"] = owner
                write_eviction_status(a.receipt, owner)
                write_eviction_contention_health(a.receipt)
                return deferred("eviction_busy", f"another eviction running; skipped before measuring "
                                                 f"({eviction_owner_text(owner)})", owner=owner)
    # only a pressure run measures the cap (one du) and acts on it (cmux_next_ci_over); a text report shows the last
    # measurement, and --json (glaeda-fleet-status asks every mini on every call) neither measures nor shows it
    global CMUX_NEXT_CI_OVER
    pressure = ACTIVITY_MODE == "pressure" and not a.cmux_next_drain
    cap = (cmux_next_ci_cap_state(fams, a.cmux_next_cap_gib, measure=True) if pressure
           else cmux_next_ci_cap_state(fams, a.cmux_next_cap_gib, measure=False)
           if not sweep and not a.cmux_next_drain and not a.refresh and not a.json else None)
    CMUX_NEXT_CI_OVER = cap["over"] if cap and pressure else 0
    RUN["cmux_next_ci_over_gib"] = round(cap["over"] / GIB, 1) if cap and pressure else None
    if cap and not a.json:
        measured = "" if pressure else f", measured {max(0.0, time.time() - cap['at']) / 60:.0f} min ago"
        print(f"cmux-next-ci: {gib(cap['used']).strip()} of its {cap['cap'] / GIB:g} GiB cap "
              f"({gib(cap['over']).strip()} over){measured}"
              + ("; a pressure run takes its least recently used output first, whatever its age"
                 if cap["over"] and pressure else
                 "; a pressure run would take its least recently used output first" if cap["over"] else ""))
    # Aside trees a killed deletion left, in the directories of the families this run judges (so a pressure
    # run looks only on the filesystems under pressure); `--family interrupted-deletions` alone looks in all.
    if not a.family or INTERRUPTED in a.family:
        fams = fams + interrupted_families(every if a.family and set(a.family) == {INTERRUPTED} else fams)
    maintenance_handle = None
    stale_marker_released = 0
    if a.apply:
        if a.cmux_next_drain:
            maintenance_handle, why = cmux_next_drain_preflight(expected_owner=a.cmux_next_reservation_owner)
            if maintenance_handle is None:
                print(why)
                return 3
        if RUNNER_CACHE_PROFILE and not runner_profile_roots_safe(fams):
            print("runner cache profile roots changed during observation; skipped")
            release_evict_lock(_EVICT_HANDLE)
            if maintenance_handle is not None:
                fcntl.flock(maintenance_handle, fcntl.LOCK_UN)
                maintenance_handle.close()
            return 0
        # A second eviction would only race the first for the same items; its caller re-reads free
        # space instead.  The owner record lets a later run recover from a daemon that died while
        # its lock descriptor remained open.
        if acquire_evict_lock() is None:
            owner = eviction_owner_status()
            RUN["evict_owner"] = owner
            write_eviction_status(a.receipt, owner)
            write_eviction_contention_health(a.receipt)
            result = deferred("eviction_busy", f"another eviction running; skipped ({eviction_owner_text(owner)})",
                              owner=owner)
            if maintenance_handle is not None:
                fcntl.flock(maintenance_handle, fcntl.LOCK_UN)
                maintenance_handle.close()
            return result
        if not reserved:  # a reserved host gets the floor-pressure pass and nothing else
            stale_marker_released = clear_stale_build_markers(a.receipt)
    idle = a.idle_hours if a.idle_hours is not None else IDLE_SWEEP_HOURS if sweep else (6 if under else DEFAULT_AGE_HOURS)
    at, known, measured_at = (0.0, {}, {}) if a.refresh or a.no_snapshot else load_snapshot_meta()
    original_known = set(known)
    _REFRESH_PROGRESS_KNOWN = dict(known)
    if a.apply:
        # sizes decide what gets deleted under pressure, so never trust stale candidate sizes
        known = fresh_for_apply(known, fams)
    now = time.time()
    stale_s = a.max_age * 60
    if a.pressure:
        # A pressure decision must not be based on a report-only item measured hours ago.
        known = {k: v for k, v in known.items() if now - measured_at.get(k, at) <= stale_s}
    known = {k: v for k, v in known.items() if os.path.lexists(k)}
    dropped_for_measurement = original_known - set(known)
    known_before = set(known)
    before = len(known)
    measure_lock = None
    try:
        MEASURE_LOCK.parent.mkdir(parents=True, exist_ok=True)
        measure_lock = MEASURE_LOCK.open("a")
        _ACTIVE_MEASURE_HANDLE = measure_lock
        fcntl.flock(measure_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        measure_lock.close()
        measure_lock = None
        _ACTIVE_MEASURE_HANDLE = None
        # Below the emergency floor a pressure apply goes on without the lock, as a report does: it
        # re-measures its candidates itself (fresh_for_apply), and a background refresh can take up to
        # its 600 s budget (cmux9s, 2026-10-21: every pressure run skipped at 0.9 GiB free while a
        # refresh held the lock, with 32 GiB of finished steps' spm-scratch reclaimable).
        if (a.pressure and not (a.apply and EMERGENCY_DEVS)) or a.refresh:
            if measure_lock is not None:
                measure_lock.close()
                measure_lock = None
            result = deferred("measurement_busy", "another measurement running; skipped")
            release_evict_lock(_EVICT_HANDLE)
            if maintenance_handle is not None:
                fcntl.flock(maintenance_handle, fcntl.LOCK_UN)
                maintenance_handle.close()
            return result
        measure_lock = None
    refresh_deadline = judge_deadline = None
    if a.refresh and a.refresh_budget_s > 0:
        refresh_deadline = time.monotonic() + a.refresh_budget_s
    elif a.pressure and a.apply:
        refresh_deadline, judge_deadline = pressure_survey_deadlines()
    background_refresh = a.refresh and not a.apply and a.refresh_lock_fd is not None
    if background_refresh:
        items = bounded_refresh_survey(
            fams, idle, a.min_mib * 1024**2, known, defer_bulk=bool(at) and not a.apply,
            budget_s=a.refresh_budget_s,
        )
        if _REFRESH_PROGRESS_KNOWN is not None:
            known.update(_REFRESH_PROGRESS_KNOWN)
    else:
        items = survey(fams, idle, a.min_mib * 1024**2, known,
                       defer_bulk=bool(at) and not a.apply, deadline=refresh_deadline,
                       judge_deadline=judge_deadline)
        if judge_deadline is not None and _MEASURE_BUDGET_REACHED:
            RUN["measure_budget_reached"] = True
            if not a.json:
                print(f"pressure measure budget ({pressure_measure_budget_s():g} s) reached: deleting from the "
                      "candidates measured so far; the rest stay unsized and are never deleted this pass\n")
    # Release the measurement lock before starting a background refresh. The child must be able to
    # acquire it, otherwise every stale report spawns a refresh that immediately skips.
    if measure_lock is not None:
        measure_lock.close()
        measure_lock = None
        _ACTIVE_MEASURE_HANDLE = None
    fresh_paths = dropped_for_measurement | (set(known) - known_before)
    age_min = (time.time() - at) / 60 if at else 0.0
    if not a.no_snapshot:
        if a.refresh:
            old_at, old_sizes, old_times = load_snapshot_meta()
            merged = {**old_sizes, **known}
            save_snapshot(merged, measured_at={**old_times, **{k: time.time() for k in known}})
        elif not at or len(known) != before or a.apply or fresh_paths or not known:
            # Keep the global stamp old until every item has been refreshed, while recording exact item times.
            updated_times = {k: v for k, v in measured_at.items() if k in known}
            updated_times.update({k: time.time() for k in fresh_paths})
            stamp = snapshot_stamp(at, known, updated_times)
            save_snapshot(known, at=stamp, measured_at=updated_times)
            if at:  # the age this run reports and refreshes on is the snapshot it just wrote (None: now)
                at = stamp or time.time()
                age_min = (time.time() - at) / 60
        if at and age_min > a.max_age and not a.apply:
            launch_background_refresh()
    if at and not a.json:
        print(f"sizes from {age_min:.0f} min ago"
              f"{' (refreshing in background)' if age_min > a.max_age and not a.apply else ''};"
              " verdicts are live\n")
    if a.refresh and _MEASURE_BUDGET_REACHED and not a.json:
        print(f"refresh budget reached after {a.refresh_budget_s:g}s; completed measurements were saved; "
              "the next refresh will continue\n")
    shown = [fs for fs in fss.values() if not a.pressure or fs.under]
    accounting = filesystem_accounting(shown, items, known)
    # A before/after receipt must compare the same filesystem set even when a pressure
    # report only displays volumes currently below the threshold.
    receipt_accounting_before = (accounting if len(shown) == len(fss)
                                 else filesystem_accounting(list(fss.values()), items, known))
    before_fs_receipt = filesystem_receipt_state(fss)
    operation = "idle" if sweep else "pressure" if a.pressure else "apply"
    RUN["mode"] = operation
    write_health_summary(shown, items, accounting, a.receipt)
    # After accounting.json holds this run's fixed-root walk, so the census skips those roots; never from an
    # apply, whose deletions it would race (another process's apply only leaves rows the next census drops).
    if not a.no_snapshot and not a.refresh and not a.pressure and not a.apply:
        launch_background_census()
    # Xcode copies are sized by a walk, so only a report shows them (the agent runs with --top 0)
    tooling = (simulator_runtimes() + (xcode_items() if a.top or a.json else [])) \
        if sweep and DARWIN and not RUNNER_CACHE_PROFILE else []
    tmp_residue = tmp_test_residue_census() if not RUNNER_CACHE_PROFILE else None
    if a.json:
        print(json.dumps({"schema": "glaeda-disk/v2", "role": ROLE, "free": shown[0].free,
                          "total": shown[0].total, "idle_hours": idle, "tmp_test_residue": tmp_residue,
                          "tooling": [asdict(i) for i in tooling],
                          "filesystems": [asdict(fs) for fs in shown],
                          "accounting": accounting,
                          "owners": {f.id: {"owner": f.owner, "retired": owner_retired(f)}
                                     for f in fams if f.owner},
                          "items": [asdict(i) for i in items]}, indent=2))
    else:
        report(items, shown, a.top, idle,
               {f.id: f.rebuild for f in fams if f.id == "cargo-target"}, {f.id: f for f in fams}, accounting)
        if tmp_residue is not None:
            print(f"\n$TMPDIR: {tmp_residue['entries']} entries, {tmp_residue['test_residue']} test scratch"
                  f" ({tmp_residue['idle']} untouched {TMP_TEST_RESIDUE_IDLE_HOURS:g}h+ at the top)"
                  f"{'; words-UUID test names count on this runner host' if tmp_residue['runner_host'] else ''}")
        if tooling:
            print("\nXcode copies and simulator runtimes")
        for t in tooling:
            print(f"  {gib(t.bytes)}  {t.verdict:12s} {t.idle_hours:6.1f}h  {t.family} {t.path} ({', '.join(t.reasons)})")
    if a.apply:
        print()
        halt = (cmux_next_drain_halt if a.cmux_next_drain
                else host_busy if sweep and POLICY["defer_during_ci"] else None)
        by_id = {f.id: f for f in fams}
        # the per-host cmux-next build root goes after everything else, idle runners' whole checkouts included
        last = {id(i) for i in items if i.family in by_id and cmux_next_ci_host_root(by_id[i.family], Path(i.path))}

        taken: dict[Path, int] = {}  # one tally across both passes: an aside finished first is in the host's size

        def apply_pass(chosen: list[Item]) -> int:
            return apply(chosen, by_id, a.receipt, {fs.dev: fs.target for fs in shown} if a.pressure else None,
                         idle, halt, all_families=fams, receipt_sweep=sweep, taken=taken)
        logical_released = stale_marker_released + apply_pass([i for i in items if id(i) not in last])
        # A drained runner is explicitly held by cmux_mini_fix; once its listener and worker
        # are absent, its disposable checkout can be cleared under this same eviction lock.
        if not RUNNER_CACHE_PROFILE and not reserved:
            logical_released += cleanup_paused_runner_work(a.receipt)
        # test scratch left in $TMPDIR, two days untouched: too small per entry for any family's size floor
        if not RUNNER_CACHE_PROFILE and not a.cmux_next_drain and not reserved \
                and (not a.family or TMP_TEST_RESIDUE_FAMILY in a.family):
            logical_released += reap_tmpdir_test_residue(a.receipt, halt=halt)
        # idle runners' whole checkouts, last: stale ones on every pressure or sweep pass, younger ones only while
        # still under the runner gate's floor after every family
        if (a.pressure or sweep) and not RUNNER_CACHE_PROFILE and not a.cmux_next_drain \
                and (not a.family or RUNNER_IDLE_CHECKOUT_FAMILY in a.family):
            logical_released += evict_idle_runner_checkouts(a.receipt, floor_gib)
        if last:
            logical_released += apply_pass([i for i in items if id(i) in last])
        # a home clone that fetch after fetch left in many packs: repacked at most hourly or under pressure,
        # after the eviction lock is released, so a gc of many minutes never holds back another eviction
        home_clone_gc_due = ((sweep or a.pressure) and ROLE == "fleet-mini" and not RUNNER_CACHE_PROFILE
                             and not a.cmux_next_drain and not reserved and (not a.family or HOME_CLONE_GC_FAMILY in a.family))
        runner_repack_due = ((sweep or a.pressure) and ROLE == "fleet-mini" and not RUNNER_CACHE_PROFILE
                             and not a.cmux_next_drain and not reserved
                             and (not a.family or RUNNER_CHECKOUT_REPACK_FAMILY in a.family))
        # the fleet compilation-cache node store's hard cap, on every pressure pass: the runner hook's pass before each
        # job and its floor eviction run this one (glaeda-fleet-cas-prune keeps its own working-set rule)
        if a.pressure and ROLE == "fleet-mini" and not RUNNER_CACHE_PROFILE and not a.cmux_next_drain and not a.family:
            logical_released += fleet_cas_node_cap()
        # idle simulator devices, on every idle sweep and on a pressure pass while free space is still short of the
        # target: each device is judged on its own, so a busy mini (never idle) still gets them back
        if ((sweep or a.pressure) and DARWIN and ROLE == "fleet-mini" and not RUNNER_CACHE_PROFILE
                and not a.cmux_next_drain and not reserved and (not a.family or SIM_DEVICE_FAMILY in a.family)):
            def short_of_target() -> bool:
                for fs in shown:
                    with contextlib.suppress(OSError):
                        if free_bytes(Path(fs.mount))[0] < fs.target:
                            return True
                return False
            logical_released += erase_idle_sim_devices(a.receipt, halt,
                                                       below_target=None if sweep else short_of_target)
        remaining = []
        for fs in shown:
            try:
                free, _ = free_bytes(Path(fs.mount))
            except OSError:
                free = fs.free
            if free < fs.low:
                remaining.append(f"{gib(free).strip()} free on {fs.mount}")
        RUN["released"] = logical_released
        blocked: dict[str, int] = {}
        for i in items:
            if i.verdict != "reclaimable":
                blocked[i.family] = blocked.get(i.family, 0) + i.bytes
        RUN["blocked"] = {f: round(b / GIB, 1) for f, b in sorted(blocked.items(), key=lambda x: -x[1])[:3]}
        if logical_released:
            notify_disk("glaeda disk keepup", f"{gib(logical_released).strip()} reclaimed on {platform.node()}")
        if remaining:
            kept = [i for i in items if i.verdict != "reclaimable"][:3]
            blocked = ", ".join(f"{gib(i.bytes).strip()} {Path(i.path).name} ({i.verdict})" for i in kept)
            notify_disk("glaeda disk pressure", "still below floor: " + "; ".join(remaining)
                        + (f"; biggest guarded items: {blocked}" if blocked else ""))
        if sweep:
            if not RUNNER_CACHE_PROFILE:
                # deleting a runtime restarts CoreSimulatorService: never while a job may be using simulators
                logical_released += apply_runtimes(tooling, a.receipt, host_busy)
            IDLE_STAMP.parent.mkdir(parents=True, exist_ok=True)
            IDLE_STAMP.touch()
        # Re-observe after every destructive operation. The accounting and df delta are
        # deliberately separate: logical catalogue bytes can differ from physical free
        # blocks because of APFS clones, snapshots, concurrent jobs, or failed measurements.
        after_fss, after_fs_receipt = reobserve_filesystems(fss)
        after_accounting = filesystem_accounting(after_fss, items, known)
        write_health_summary(after_fss, items, after_accounting, a.receipt)
        summary = write_eviction_summary(a.receipt, operation, logical_released,
                                         before_fs_receipt, after_fs_receipt,
                                         receipt_accounting_before, after_accounting)
        physical = summary["physical_df_delta_bytes"]
        physical_text = (f"{physical} bytes ({physical / GIB:+.1f}G)" if isinstance(physical, int)
                         else "unknown (post-sweep observation incomplete)")
        print(f"eviction summary: logical released {logical_released} bytes ({gib(logical_released).strip()}); "
              f"physical df delta {physical_text}; blocked {gib(summary['blocked_bytes']).strip()} "
              f"(unchecked {gib(summary['unchecked_bytes']).strip()}); "
              f"accounting gap {gib(summary['accounting_gap_bytes']).strip()}; receipt {a.receipt}")
        release_evict_lock(_EVICT_HANDLE)
        if maintenance_handle is not None:
            fcntl.flock(maintenance_handle, fcntl.LOCK_UN)
            maintenance_handle.close()
        if home_clone_gc_due:
            gc_home_clones(a.receipt, halt=halt)
        if runner_repack_due:
            repack_runner_checkouts(a.receipt, halt=halt)
    return 0


def disk_off() -> str:
    """Why the kill switch is on, or "": DISK_OFF exists, or the policy says "enabled": false."""
    if os.path.lexists(DISK_OFF):
        return f"{DISK_OFF} exists"
    if not POLICY["enabled"]:
        return f'{DISK_POLICY} has "enabled": false'
    return ""


def _home_free() -> int | None:
    try:
        return free_bytes(HOME)[0]
    except OSError:
        return None


def _owner_line(owner: Any) -> dict[str, Any] | None:
    """The busy skip's evict.lock holder for the run line: its pid, command and when it took the lock."""
    if not isinstance(owner, dict):
        return None
    started = owner.get("started_at")
    return {"pid": owner.get("pid"), "command": str(owner.get("command") or "")[:120] or None,
            "since": time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(started))
            if isinstance(started, (int, float)) else None}


FLEET_CAS_ROOT = FLEET_ROOT / "xcode"
FLEET_CAS_PRUNE_TIMEOUT_S = 300.0


def fleet_cas_node_cap(root: Path | None = None, prune: Path | None = None) -> int:
    """Run `glaeda-fleet-cas-prune --apply --node-only` (installed beside this script) on a host with fleet-cas, bounded
    by FLEET_CAS_PRUNE_TIMEOUT_S; the bytes it reports freed, 0 when it is absent, fails or freed nothing. Never raises."""
    root = FLEET_CAS_ROOT if root is None else root
    prune = Path(os.path.abspath(__file__)).with_name("glaeda-fleet-cas-prune") if prune is None else prune
    if not (root / "fleet-cas.env").is_file() or not prune.is_file():
        return 0
    try:
        out = subprocess.run([sys.executable, os.fspath(prune), "--apply", "--node-only"], capture_output=True,
                             text=True, timeout=FLEET_CAS_PRUNE_TIMEOUT_S, check=False,
                             env={**os.environ, "GLAEDA_FLEET_CAS_ROOT": os.fspath(root)})
        rec = json.loads(out.stdout.strip().splitlines()[-1]) if out.stdout.strip() else {}
    except (OSError, subprocess.SubprocessError, ValueError):
        return 0
    m = re.match(r"removed (\d+) oldest files, ([0-9.]+) GiB", str(rec.get("node_store") or ""))
    if not m:
        return 0
    print(f"  fleet-cas node store: {rec['node_store']}")
    return int(float(m.group(2)) * GIB)


def write_run_line(started: float, free_before: int | None) -> None:
    """The run's one line in RUN_LOG; a log that cannot be written never fails the run."""
    after = _home_free()
    target = RUN.get("target_bytes")

    def g(b):
        return None if b is None else round(b / GIB, 1)
    row = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(), "mode": RUN.get("mode"),
           "off": bool(RUN.get("off")), "free_gib_before": g(free_before), "free_gib_after": g(after),
           "target_gib": RUN.get("target_gib"), "target_bytes": target, "targets": RUN.get("targets"),
           "default_targets": bool(RUN.get("default_targets")), "config_sha256": RUN.get("config_sha256"),
           "floor_gib": RUN.get("floor_gib"),
           "reclaimed_gib": round(RUN.get("released", 0) / GIB, 1),
           "reached": None if target is None or after is None else after >= target,
           "blocked": RUN.get("blocked", {}), "duration_s": round(time.time() - started, 1),
           "skipped": RUN.get("skipped"), "cmux_next_ci_over_gib": RUN.get("cmux_next_ci_over_gib"),
           "caller": RUN.get("caller"), "evict_owner": _owner_line(RUN.get("evict_owner")),
           "bundle_failed": RUN.get("bundle_failed", []),
           "measure_budget_reached": bool(RUN.get("measure_budget_reached"))}
    with contextlib.suppress(OSError):
        RUN_LOG.parent.mkdir(parents=True, exist_ok=True)
        with RUN_LOG.open("a") as f:
            f.write(json.dumps(row) + "\n")


def _logged_main(args: list[str]) -> int:
    """_main_impl, then one run line when it was an --apply run (whatever it did, or why it skipped)."""
    RUN.clear()
    RUN["caller"] = run_caller()
    started, before = time.time(), _home_free()
    try:
        status = _main_impl(args)
        release_hook_pass(served=status == 0 and RUN.get("skipped") not in UNSERVED)
        return status
    except BaseException as e:
        RUN.setdefault("skipped", f"error: {type(e).__name__}")
        release_hook_pass(served=False)
        raise
    finally:
        if RUN.get("apply"):
            write_run_line(started, before)


def main(argv: list[str] | None = None) -> int:
    """Run the disk command, bounding only the owned background refresh process."""
    args = list(sys.argv[1:] if argv is None else argv)
    if "--census" in args:
        return census_main(args)
    if "--own-runner-checkout" in args:
        return own_runner_checkout_main(args)
    background = "--refresh" in args and "--refresh-lock-fd" in args and "--apply" not in args
    if not background:
        return _logged_main(args)
    budget_s = REFRESH_BUDGET_S
    with contextlib.suppress(ValueError, IndexError):
        budget_s = max(1.0, float(args[args.index("--refresh-budget-s") + 1]))
    global _REFRESH_DEADLINE_ACTIVE, _ACTIVE_MEASURE_HANDLE, _REFRESH_HANDLE, _MEASURE_BUDGET_REACHED
    previous_handler = signal.getsignal(signal.SIGALRM)
    previous_timer = signal.getitimer(signal.ITIMER_REAL)
    _REFRESH_DEADLINE_ACTIVE = True
    signal.signal(signal.SIGALRM, _refresh_alarm)
    signal.setitimer(signal.ITIMER_REAL, budget_s)
    try:
        return _main_impl(args)
    except RefreshDeadlineExceeded:
        _MEASURE_BUDGET_REACHED = True
        if _REFRESH_PROGRESS_KNOWN is not None:
            with contextlib.suppress(OSError):
                save_snapshot(_REFRESH_PROGRESS_KNOWN)
        return 0
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        if previous_timer != (0.0, 0.0):
            signal.setitimer(signal.ITIMER_REAL, *previous_timer)
        _REFRESH_DEADLINE_ACTIVE = False
        _terminate_active_children()
        if _ACTIVE_MEASURE_HANDLE is not None:
            with contextlib.suppress(OSError):
                _ACTIVE_MEASURE_HANDLE.close()
            _ACTIVE_MEASURE_HANDLE = None
        if _REFRESH_HANDLE is not None:
            release_refresh_lock(_REFRESH_HANDLE)


if __name__ == "__main__":
    sys.exit(main())
