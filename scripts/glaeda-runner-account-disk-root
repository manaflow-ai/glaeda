#!/bin/bash
# glaeda-runner-account-disk-root OWNER: the one root step that lets glaeda-disk's runner-account pass reach the
# runner accounts' homes on a fleet mini, as root.
#
# glaeda-disk (as OWNER, the fleet user) runs one pass in each other runner account (RUNNER_ACCOUNTS in glaeda-disk) as
# that account, through `sudo -n -u ACCOUNT`. A fleet mini's sudo asks for a password, so every pass read "runner
# account cmuxci-gui-01: not reached (sudo: a password is required)" and the gui pool accounts' homes, 30-55 GiB per
# mini that no family counted, were never cleaned while the runner gate held their gui-light listeners off for disk
# (2026-11-27). Run it from a glaeda checkout on main:
#
#   { echo 'set -- cmux'; cat scripts/glaeda-runner-account-disk-root; } | fleet-sudo HOST -f -
#
# It
#   - copies OWNER's installed glaeda-disk (~OWNER/.local/bin/glaeda-disk: a regular file OWNER owns, no symlink, at
#     most 8 MiB, that python3 compiles) to /usr/local/libexec/glaeda/glaeda-disk, root:wheel 755, so no account but
#     root can change what the rule runs;
#   - finds the runner accounts glaeda-disk would delegate to: a non-admin login account (uid >= 500, home directly in
#     /Users, not OWNER) whose home holds an actions-runner*/.runner;
#   - writes /etc/sudoers.d/glaeda-runner-account-disk (checked with visudo -c first) letting OWNER run, as exactly
#     those accounts and with no password, only
#       /usr/bin/python3 -I /usr/local/libexec/glaeda/glaeda-disk --runner-account *
#     No shell, no env, no other program: OWNER can make that pass run with other glaeda-disk flags, and the pass in
#     that account only removes the account's own rebuildable files by glaeda-disk's vetoes. No rule runs as root;
#   - prints the accounts, the copy's sha256 and visudo's verdict as the readback.
# The copy is as new as the last run of this step; run it again after a glaeda-disk change the pass depends on (the
# deploy that updates ~OWNER/.local/bin cannot write a root-owned file). With no runner account it removes the rule.
set -euo pipefail
if [ "$(/usr/bin/id -u)" != 0 ]; then
    echo "glaeda-runner-account-disk-root: run as root: { echo 'set -- OWNER'; cat scripts/glaeda-runner-account-disk-root; } | fleet-sudo HOST -f -" >&2
    exit 2
fi
if [ "$#" -ne 1 ]; then
    echo "usage: glaeda-runner-account-disk-root OWNER (as root; OWNER is the fleet user that runs glaeda-disk)" >&2
    exit 2
fi
exec </dev/null 3<<'PY' /usr/bin/python3 -I /dev/fd/3 "$@"
import glob
import grp
import hashlib
import os
import pwd
import re
import stat
import subprocess
import sys
import tempfile

COPY = "/usr/local/libexec/glaeda/glaeda-disk"
SUDOERS = "/etc/sudoers.d/glaeda-runner-account-disk"
PYTHON = "/usr/bin/python3"
SOURCE_MAX = 8 * 1024 * 1024
USER_RE = re.compile(r"[a-z_][a-z0-9_-]{0,31}")
ADMIN_GROUPS = ("admin", "wheel", "sudo")


def say(text):
    print(f"glaeda-runner-account-disk-root: {text}", flush=True)


def read_source(path, uid):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > SOURCE_MAX:
            raise ValueError("not a regular file of that user's, or larger than 8 MiB")
        data = os.read(fd, SOURCE_MAX + 1)
    finally:
        os.close(fd)
    if len(data) > SOURCE_MAX:
        raise ValueError("larger than 8 MiB")
    compile(data, path, "exec")  # SyntaxError: a torn or foreign file is never installed
    return data


def install(path, data, mode):
    """Write DATA to PATH root:wheel MODE atomically (a stage beside it, renamed over it)."""
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    for d in (directory, os.path.dirname(directory)):
        st = os.lstat(d)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise OSError(f"{d} is not a root-owned directory only root may write")
    fd, stage = tempfile.mkstemp(prefix=".glaeda-", dir=directory)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            os.fchown(f.fileno(), 0, 0)
            os.fchmod(f.fileno(), mode)
            f.flush()
            os.fsync(f.fileno())
        return stage
    except BaseException:
        if os.path.lexists(stage):
            os.unlink(stage)
        raise


def is_admin(entry):
    for name in ADMIN_GROUPS:
        try:
            g = grp.getgrnam(name)
        except KeyError:
            continue
        if entry.pw_name in g.gr_mem or entry.pw_gid == g.gr_gid:
            return True
    return False


def runner_accounts(owner):
    out = []
    for entry in pwd.getpwall():
        home = entry.pw_dir.rstrip("/")
        if (entry.pw_uid < 500 or entry.pw_name == owner or os.path.dirname(home) != "/Users"
                or not USER_RE.fullmatch(entry.pw_name) or is_admin(entry)):
            continue
        if any(os.path.isfile(p) for p in glob.glob(os.path.join(glob.escape(home), "actions-runner*", ".runner"))):
            out.append(entry.pw_name)
    return sorted(set(out))


def rules(owner, accounts):
    return ("# glaeda-runner-account-disk: written by glaeda-runner-account-disk-root. glaeda-disk's runner-account\n"
            "# pass, run as each runner account with no password: that one root-owned script, no shell, no env.\n"
            f"{owner} ALL=({', '.join(accounts)}) NOPASSWD: {PYTHON} -I {COPY} --runner-account *\n").encode()


def write_sudoers(data):
    try:
        with open(SUDOERS, "rb") as f:
            if f.read() == data:
                return "unchanged"
    except OSError:
        pass
    fd, stage = tempfile.mkstemp(prefix=".glaeda-", dir=os.path.dirname(SUDOERS))
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            os.fchown(f.fileno(), 0, 0)
            os.fchmod(f.fileno(), 0o440)
        done = subprocess.run(["/usr/sbin/visudo", "-c", "-f", stage], capture_output=True, text=True, check=False)
        if done.returncode != 0:
            raise OSError(f"visudo -c refused it: {(done.stdout + done.stderr)[-300:]}")
        os.rename(stage, SUDOERS)
    except BaseException:
        if os.path.exists(stage):
            os.unlink(stage)
        raise
    return "written"


def main(argv):
    owner = argv[0]
    if not USER_RE.fullmatch(owner):
        say(f"refusing owner {owner!r}")
        return 2
    try:
        pw = pwd.getpwnam(owner)
    except KeyError:
        say(f"no user {owner}")
        return 2
    accounts = runner_accounts(owner)
    if not accounts:
        if os.path.lexists(SUDOERS):
            os.unlink(SUDOERS)
            say("no runner account on this host: removed the rule")
        else:
            say("no runner account on this host: nothing to do")
        return 0
    source = os.path.join(pw.pw_dir, ".local/bin/glaeda-disk")
    try:
        data = read_source(os.path.realpath(source) if os.path.islink(source) else source, pw.pw_uid)
    except (OSError, ValueError, SyntaxError) as error:
        say(f"refusing {source}: {error}")
        return 1
    stage = install(COPY, data, 0o755)
    os.rename(stage, COPY)
    verdict = write_sudoers(rules(owner, accounts))
    say(f"accounts={','.join(accounts)} copy={COPY} sha256={hashlib.sha256(data).hexdigest()[:12]} sudoers={verdict}")
    return 0


sys.exit(main(sys.argv[1:]))
PY
