# A "fetch" step fills this host's mirror of the PR's repository. huge-blue, 2026-11-17 ~14:01Z: land_judge could not
# read its mirror (ls-remote failed) and refused leo-workspace#5653 and #5614 "unreadable", naming a fetch of that
# mirror as a "command" step; the queue stops on a command, no lane can run one on huge-blue, and a coordinator ran
# the fetch by hand. land_judge (mirror_fetch_argv) now names it {"kind": "fetch", "argv": [...]}, one of two shapes,
# which this queue checks again on its own (land_fetch_shape, then the mirror itself) before it runs it, bounded:
# - git --git-dir MIRROR.git fetch [LAND_FETCH_OPTIONS] origin REFSPEC..., MIRROR's origin being the PR's repository
#   on github.com (LAND_FETCH_ORIGIN), run with the bare env (this host's own git login);
# - lane-gh fetch OWNER/REPO --dir MIRROR.git [--branch B]..., OWNER/REPO the PR's (a broker read: land_lane).
# Any other argv stops the entry as policy and runs nothing. A fetch that fails is a refused step (step_refused): it
# backs off, and the LAND_STEP_STOP-th identical failure stops the entry and tells the requester.
LAND_FETCH_DEADLINE = 300.0
LAND_FETCH_CONFIG_DEADLINE = 10.0  # git config --get remote.origin.url
LAND_FETCH_OPTIONS = frozenset({"--quiet", "--no-tags", "--no-write-fetch-head"})
LAND_FETCH_REFSPEC = re.compile(r"\+?refs/(?:heads|pull)/[\w./-]+:refs/remotes/origin/[\w./-]+|[0-9a-f]{40}|\w[\w./-]*")
LAND_FETCH_BRANCH = re.compile(r"\w[\w./-]*")
LAND_FETCH_REPO = re.compile(r"[\w.-]+/[\w.-]+")
LAND_FETCH_ORIGIN = re.compile(
    r"(?:https://github\.com/|ssh://git@github\.com/|git@github\.com:)([\w.-]+/[\w.-]+?)(?:\.git)?/?")
LAND_FETCH_UNSAFE = frozenset("\0\n\r\t ;|&$`<>\\'\"*?")


# The lane a land step writes as. lane-gh (a lane VM's broker client) fences every write (land, update_branch, rerun)
# with a lease taken in the calling lane's name, from LANE_GH_LANE or the acpmux session, and refuses with no lane:
# "land: lease acquisition requires a lane session", exit 1, before the broker. This queue strips the session keys
# (LAND_ENV), so on gcp-agent-lane-3 on 2026-11-17 every merge and update-branch it sent failed that way: none
# reached the broker (`lane-gh calls --tool land` holds no land of cmux#45102 or #45090 after 27 and 30 merges).
# The step is the queuing session's: its lane names the step's; the calls stay charged to glaeda-land
# (gh_quota reads CMUX_AGENT_SESSION, never LANE_GH_LANE).
# Every step that writes passes E (self.env(e)): merge, update_branch, rerun_failed and review (router-review
# --post writes its comment through the same client). Reads (land_judge explain, the post-merge `pr view`) and
# acpmux notices need no lane and run with the bare env.
# The lane is the queuing process's own (land_queue_lane), recorded in the entry with the host it names a lane on
# ("lane", "laneHost"): --notify only says who is told. gcp-agent-lane-1, 2026-11-18: the lane was read from the
# requester, so a sub-session (acpmux names it PARENT/CHILD, which was read as HOST/SESSION), a --notify on another
# host and a queue with no session all named none, and every merge failed that way six times in a row.
LAND_LANE_ENV = "LANE_GH_LANE"
LAND_LANE_NAME = re.compile(r"[A-Za-z0-9._-]{1,100}")
LAND_LANE_KEYS = (LAND_LANE_ENV, "ACPMUX_SESSION_NAME", "ACPMUX_SESSION")  # lane-gh's lane(), in its order
# Where no lane is named here (a requester on another host, none, a queue with no session), a step on a broker host
# writes as the queue's own lane. The broker takes it: it checks a PR is this VM's by the VM, and fences a lane only by
# its lease (cmuxterm-hq tools/lane-gh-broker parts/30-calls-core.py own_pr; parts/27-leases.py lease_resource_for):
# update_branch, rerun and a review's comment take the lane's own actor lease, and land the PR's branch lease, refused
# while another lane holds it ("held by ... wait for expiry", a broker refusal step_refused backs off). `reach` from a
# lane VM reaches only the VM itself; a step the broker refuses for ownership goes to its host's queue (LAND_NOT_OWNER).
LAND_QUEUE_LANE = "glaeda-land"
# lane-gh's refusal of a write with no lane, raised before the broker: no retry changes it, so the first one stops the
# entry (step_refused).
LAND_NO_LANE = re.compile(r"lease acquisition requires a lane session")
# The broker's owner check refused a write step for this VM: the PR's branch is another lane's (cmuxterm-hq
# tools/lane-gh-broker parts/30-calls-core.py own_pr: "PR N's branch 'B' was not pushed by VM (lane-gh-broker own)").
# 2026-11-18, cmux#45756 ("branch lane/drag-like-paste was not pushed by gcp-agent-lane-6"): a lander lane only judged.
# interim-coord: "have the refusal hand the merge to huge-blue automatically". The check stands and nothing here goes
# around it: the entry is handed, once per PR head, to the broker host's own land queue (the broker's land_handoff:
# `glaeda-gh land serve` there), which judges the PR itself (land_judge: CI, the pinned head, a BLOCK, holds, a
# teammate's PR only on their opt-in) and merges with its own credential, or stops and tells the requester why. This
# entry then reads "forwarded" and does nothing more. Only this refusal hands off: a CI, hold or review refusal is
# land_judge's answer here and stays this queue's to wait on or stop at.
LAND_NOT_OWNER = re.compile(r"branch \S+ was not pushed by \S+")
LAND_HANDOFF_KINDS = frozenset({"merge", "update_branch", "retarget"})  # the write steps own_pr refuses
LAND_HANDOFF_TOOL = "land_handoff"
LAND_BROKER_MERGE_TOOL = "land"  # a lane VM's pinned merge: the broker judges and merges it (broker_land)
LAND_HANDOFF_DEADLINE = 60.0


def land_session_lane(name: str) -> str:
    """The lane lane-gh names for session NAME (its last path component), or "" when that is no lane name."""
    lane = str(name or "").strip().rstrip("/").split("/")[-1]
    return lane if LAND_LANE_NAME.fullmatch(lane) and lane != LAND_TAG else ""


def land_queue_lane() -> str:
    """The lane of the process queuing a land, as lane-gh would name it for its own write: LANE_GH_LANE, else the acpmux
    session's name; "" when it has none."""
    return land_session_lane(next((os.environ[k] for k in LAND_LANE_KEYS if os.environ.get(k, "").strip()), ""))


def land_session_host(name: str) -> tuple[str, str]:
    """(HOST, the session's name on HOST) for a session NAME as a requester holds it. HOST/REST when its first part is
    this host or a fleet machine (fleet_machines); a bare name, or PARENT/CHILD whose PARENT is no machine (an acpmux
    sub-session), is a session on this host. ("", NAME) when no registry can tell which a slash is."""
    first, sep, rest = name.partition("/")
    me = policy_host()
    if not sep:
        return me, name
    if first == me:
        return me, rest
    machines = fleet_machines()
    if first in machines:
        return first, rest
    return ("", name) if not machines else (me, name)


def land_lane(e: dict) -> str:
    """The lane E's steps write as on this host, or "": the lane recorded when it was queued, on this host; an entry
    queued before that was recorded reads its requester (land_session_host), a session on this host naming its
    lane."""
    if "lane" in e:
        lane = str(e.get("lane") or "")
        return lane if e.get("laneHost") == policy_host() and land_session_lane(lane) == lane else ""
    requester = str(e.get("requester") or "")
    host, name = land_session_host(requester)
    if host == policy_host() and name == requester and "/" in name and e.get("requesterFrom") == "--notify":
        # Only this host's own environment wrote a hostless PARENT/CHILD; a --notify one names a host the registry
        # does not know (a VM newer than its copy), never a session here.
        return ""
    return land_session_lane(name) if host == policy_host() and name else ""


def land_dir() -> Path:
    return BASE / "land"


def land_config() -> dict:
    doc = read_json(LAND_CONFIG)
    return doc if isinstance(doc, dict) else {}


def land_key(target: str) -> tuple[str, str, int]:
    """(key, OWNER/REPO as typed, N) for OWNER/REPO#N, OWNER/REPO/N, a PR URL, or a bare N in the repository
    the caller stands in (parse_key reads both of the loose forms), or `pr:OWNER/REPO#N` as this tool prints it."""
    text = drop_kind_prefix(target, "pr")
    m = PR_KEY_RE.fullmatch(text)
    if not m and not BARE_NUMBER.fullmatch(text):
        raise WatchError(f"land takes {KIND_FORMS['pr']}, not {target!r}")
    key = parse_key("pr", text)  # a bare number names the repository the caller stands in, or raises
    _, owner, repo, number = split_key(key)
    return key, f"{m.group(1)}/{m.group(2)}" if m else f"{owner}/{repo}", int(number)


def land_after_in(repo: str, after: list[str]) -> list[str]:
    """--after targets with a bare N or #N made OWNER/REPO#N in the land target's own repository, ahead of
    parse_key's fallback to the caller's cwd origin (a land names its repository, so a bare --after number is
    that one, from a directory with no origin too). A full target stays as given. Said on stderr."""
    out = []
    for a in after:
        bare = BARE_NUMBER.fullmatch(drop_kind_prefix(a, "pr"))
        if bare:
            full = f"{repo}#{int(bare.group(1))}"
            say_waiting(f"glaeda-gh: {bare.group(1)} is {full} (the land target's repository)")
            a = full
        out.append(a)
    return out


# Where the session that queues a land is named, in order (acpmux send takes a session's name or id). Read at queue
# time, so the session that asked is the one told, whatever --notify it forgot.
LAND_REQUESTER_KEYS = ("ACPMUX_SESSION_NAME", "ACPMUX_SESSION", "LANE_GH_LANE", "ACPMUX_FROM", "ACPMUX_SESSION_ID",
                       "CMUX_AGENT_SESSION", "CMUX_AGENT_SESSION_ID")


def land_requester_from(given: str | None) -> tuple[str, str]:
    """(HOST/SESSION, where it came from): --notify (a bare name gets this host), else the first of
    LAND_REQUESTER_KEYS set in the queuing process (never glaeda-land itself); ("", "") when none is. A name from
    the environment is a session here: a sub-session's PARENT/CHILD gets this host too (acpmux send takes
    HOST/PARENT/CHILD), unless its first part is a fleet machine (a peer's session name, HOST/NAME)."""
    name, source = (given.strip(), "--notify") if given and given.strip() else ("", "")
    if not name:
        name, source = next(((os.environ[k].strip(), "$" + k) for k in LAND_REQUESTER_KEYS
                             if os.environ.get(k, "").strip() and os.environ[k].strip() != LAND_TAG), ("", ""))
    if not name:
        return "", ""
    if source != "--notify":
        host, local = land_session_host(name)
        if host:
            return f"{host}/{local}", source
        # no registry to tell a peer's HOST/NAME from PARENT/CHILD: kept as it is (acpmux send resolves both)
    return (name if "/" in name else f"{policy_host()}/{name}"), source


def land_requester(given: str | None) -> str:
    return land_requester_from(given)[0]


def land_notify_target(e: dict, requester: str) -> str:
    """Use the queued session's parent when the caller did not record a requester.

    Reader identity adds ``:agent:<name>`` for helper processes, while acpmux
    resolves the parent session id.  A target that cannot be derived is left
    empty so notify logs one land-unnotified event instead of retrying a bad
    destination.
    """
    if requester:
        return requester
    queued_by = str(e.get("queuedBy") or "")
    parent = queued_by.split(":agent:", 1)[0]
    return parent if READER_SAFE.fullmatch(parent) and "/session:" in parent else ""


def land_day(at: float) -> str:
    return dt.datetime.fromtimestamp(at, dt.timezone.utc).strftime("%Y-%m-%d")


# GitHub's numeric account id, which gh quotes in its own rate-limit error ("API rate limit already exceeded for user
# ID NNNN"). It is personal data, and the queue's text is pasted into PR and issue bodies by every agent that reads
# `land status` (leo-workspace tools/public_body_guard.py refuses it there), so the daemon drops the id where it
# captures the error (LandQueue.call) and where it reads a park an older daemon stored (land_queue_parked). The
# actionable words -- which limit, and the reset -- are kept.
LAND_USER_ID = re.compile(r"\b(user(?:\s+id)?)\s+\d{3,}\b", re.I)


# A word every shell hands on as typed: shlex's own safe set, plus `#` anywhere but the first character.
TYPED_WORD_PLAIN = re.compile(r"[\w@%+=:,./-][\w@%+=:,./#-]*")


def typed_line(words: Any) -> str:
    """WORDS as a command line that can be typed or pasted back, each word quoted only where it has to be.

    Every `read as`, `ran as` and `next:` line this tool prints is an argv rendered back as text, and a reader
    (a person or an agent) runs what it says. A plain `" ".join` loses the word boundaries: `--body "two words"`
    comes back as `--body two words`, which the shell splits into two arguments and argparse then refuses as an
    unrecognized one, so the printed repair does not run while the call it was read from would have. shlex.quote
    An ordinary word is left untouched, so this changes only the lines that carried a value needing quotes.
    shlex.quote alone would also quote `o/r#1`, this tool's own target form and the one every printed line and
    its tests already carry: a `#` is a comment only at the start of a word, so it stays bare past the first
    character and TYPED_WORD_PLAIN says so."""
    return " ".join(w if TYPED_WORD_PLAIN.fullmatch(w) else shlex.quote(w) for w in (str(x) for x in words))


def land_redact(text: Any) -> str:
    """TEXT with GitHub's numeric user id dropped (LAND_USER_ID)."""
    return LAND_USER_ID.sub(r"\1 <redacted>", str(text or ""))


def land_trim(text: Any, limit: int = LAND_TEXT) -> str:
    text = " ".join(str(text or "").split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def land_tail(text: Any, limit: int = LAND_TEXT) -> str:
    """TEXT on one line, its end kept when it is longer than LIMIT (where a refusal's reason and next step are)."""
    text = " ".join(str(text or "").split())
    return text if len(text) <= limit else "…" + text[-(limit - 1):]


# Every read on the land path has more than one route (docs/handbook/read-with-one-quota-route.md), and a refusal
# reports each route's outcome as its own labelled clause: head_reds tries the store, GraphQL, then REST, and raises
# "GraphQL: <160 chars>; REST: <160 chars>; the store: <160 chars>" when the live reads both failed (leo-workspace
# tools/land_judge/engine.py). Which route failed, and whether another could still answer, is the whole difference
# between a GraphQL-only outage this host can read around and a GitHub-wide one it cannot -- and that verdict sits in
# the clauses a head-cut drops first. One lane host, 2026-11-21 12:08Z: a queue park's stored reason ended "... GraphQL: gh
# api graphql failed: ...; REST:" and stopped there, because land_trim(text, 300) landed exactly at the start of the
# REST clause; /rate_limit read 3873 REST left for the same login at 12:07:37Z, so the park that held 26 of 27 rows
# (4 repos, 3 lanes) for 49 min may have been a GraphQL-only failure, and no log on the host kept what REST said
# (50,508 lines of glaeda-gh.jsonl searched, no match). So a trimmed reason spends its budget *within* the clauses:
# every route's verdict survives, the first route's verbose stack trace is what goes.
LAND_ROUTE_CLAUSE = re.compile(r"(?:^|(?<=; )|(?<=: )|(?<=, ))((?:the )?"
                               r"(?:graphql|rest|store|cache|direct|upstream|broker)\s*:\s)", re.I)
LAND_CLAUSE_MIN = 24  # a clause keeps its label and the first words of its verdict, or the budget is spent flat


def land_route_clauses(text: str) -> list[str]:
    """TEXT as the clauses it reports: what precedes the first route label, then one piece per route label
    (LAND_ROUTE_CLAUSE), each without the boundary punctuation it ended on (land_reason joins them back with "; ",
    the separator this same split reads, so trimming an already-trimmed reason keeps finding the clauses). One route
    named, or none: [TEXT], so land_reason trims exactly as land_trim does."""
    starts = [m.start(1) for m in LAND_ROUTE_CLAUSE.finditer(text)]
    if len(starts) < 2:
        return [text]
    cuts = ([0] if starts[0] else []) + starts + [len(text)]
    pieces = [text[a:b].rstrip(" ;,:") for a, b in zip(cuts, cuts[1:])]
    return [p for p in pieces if p]


def land_shares(lengths: list[int], budget: int) -> list[int]:
    """BUDGET split over LENGTHS so that no piece is dropped whole while another keeps detail: an equal share each,
    and a piece shorter than its share gives what it does not need back to the longer ones (one word of a route's
    answer is worth more than another 100 characters of the first route's stack trace)."""
    shares = [0] * len(lengths)
    left, pending = budget, list(range(len(lengths)))
    while pending:
        share = left // len(pending)
        fits = [i for i in pending if lengths[i] <= share]
        if not fits:  # every piece still wants more than its share: split what is left, the remainder to the first
            for n, i in enumerate(pending):
                shares[i] = share + (1 if n < left - share * len(pending) else 0)
            break
        for i in fits:
            shares[i], left = lengths[i], left - lengths[i]
            pending.remove(i)
    return shares


def land_reason(text: Any, limit: int = LAND_TEXT) -> str:
    """TEXT on one line within LIMIT characters, every route's verdict kept (LAND_ROUTE_CLAUSE's comment).

    A refusal naming two or more routes is trimmed clause by clause, each with its share of the budget
    (land_shares), so "GraphQL: ...; REST: ...; the store: ..." always shows what all three answered and detail goes
    before a verdict does. Anything else -- one route, no route, a budget too small for every clause to keep its
    label -- is land_trim, unchanged."""
    one = " ".join(str(text or "").split())
    if len(one) <= limit:
        return one
    pieces = land_route_clauses(one)
    joiners = 2 * (len(pieces) - 1)  # the "; " each clause after the first is joined back on
    if len(pieces) < 2 or limit - joiners < len(pieces) * LAND_CLAUSE_MIN:
        return land_trim(one, limit)
    shares = land_shares([len(p) for p in pieces], limit - joiners)
    return "; ".join(land_trim(p, s) for p, s in zip(pieces, shares))


def land_checks_running(data: dict, head: str) -> bool:
    """Whether the cache shows checks still running at HEAD (a pending status counts, and so does an unfinished context
    a truncated rollup counts past its first page: the wait's own answer, pending_on_every_page)."""
    if not data or data.get("state") != "OPEN" or not head or data.get("headRefOid") != head:
        return False
    return (any(str(c.get("status") or "").upper() not in ("COMPLETED", "") for c in data.get("checks") or [])
            or pending_on_every_page(data) > 0)


def land_unfinished(data: dict, now: float, limit: int = 6) -> str:
    """The checks DATA shows unfinished, as said in a checks_stuck stop: "NAME (STATUS N min), ..." or ""."""
    out = []
    for c in data.get("checks") or []:
        status = str(c.get("status") or "").upper()
        if status in ("COMPLETED", ""):
            continue
        name = "/".join(str(x) for x in (c.get("workflow"), c.get("name")) if x) or "?"
        started = iso_epoch(c.get("startedAt")) if c.get("startedAt") else None
        out.append(f"{name} ({status.lower()}" + (f" {int((now - started) // 60)} min)" if started else ")"))
    more = f", +{len(out) - limit} more" if len(out) > limit else ""
    return ", ".join(out[:limit]) + more


def land_step_class(out: str) -> str:
    """What a refused step's output says, as one identity: land_judge's refusal code (`refused [code`) when it names
    one, else the output's last line with numbers and shas folded (a count of commits behind moves with the base)."""
    found = LAND_STEP_CODE.findall(out or "")
    if found:
        return found[-1]
    lines = [ln.strip() for ln in str(out or "").splitlines() if ln.strip()]
    return re.sub(r"[0-9a-f]{7,40}|\d+", "#", lines[-1] if lines else "no output")[:120]


def land_step_named(out: str) -> dict | None:
    """The step a refusal's own `next:` names, when it is one the queue runs (update_branch, wait_pr), else None."""
    text = str(out or "")
    if LAND_STEP_NEXT_UPDATE.search(text):
        return {"kind": "update_branch"}
    wait = LAND_STEP_NEXT_WAIT.search(text)
    if wait:
        return {"kind": "wait_pr", "timeout_s": float(wait.group(1)) if wait.group(1) else LAND_WAIT_DEFAULT}
    return None


def land_fingerprint(cache: dict | None, conflict_only: bool = False) -> str:
    """What could change land_judge's answer, as the cache shows it: head, state, mergeability, each check. (Not
    mergeStateStatus: it flips with every push to the base, and each flip would be a judgment.) CONFLICT_ONLY:
    mergeability only as CONFLICTING or not (land_check_fingerprint)."""
    data = (cache or {}).get("data") or {}
    if not data:
        return ""
    checks = sorted((str(c.get("workflow") or ""), str(c.get("name") or ""), str(c.get("status") or ""),
                     str(c.get("conclusion") or "")) for c in data.get("checks") or [])
    mergeable = data.get("mergeable") == "CONFLICTING" if conflict_only else data.get("mergeable")
    doc = [data.get("headRefOid"), data.get("state"), mergeable, checks]
    return hashlib.sha256(json.dumps(doc, sort_keys=True).encode()).hexdigest()[:16]


def land_check_fingerprint(cache: dict | None) -> str:
    """What a kept verdict was judged on (LAND_VERDICT_KEEP): the head, its state, each check run and status, and
    mergeability only as CONFLICTING or not: UNKNOWN <-> MERGEABLE turns on every push to the base."""
    return land_fingerprint(cache, conflict_only=True)


def land_fetch_mirror_ok(mirror: str) -> bool:
    return os.path.isabs(mirror) and mirror.endswith(".git") and ".." not in mirror.split("/")


def land_fetch_shape(argv: Any, repo: str) -> tuple[str, str, str]:
    """(form "git" or "lane-gh", the mirror, "") when ARGV is one of a fetch step's two shapes (LAND_FETCH_DEADLINE's
    comment) for REPO, else ("", "", why not). Reads nothing: the mirror itself is do_fetch's to check."""
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        return "", "", "the fetch step's argv is not a list of strings"
    if any(not a or LAND_FETCH_UNSAFE.intersection(a) for a in argv):
        return "", "", f"the fetch step's argv holds an empty word or a shell character: {land_trim(argv, 160)}"
    if argv[:2] == ["git", "--git-dir"] and len(argv) >= 6 and argv[3] == "fetch":
        if not land_fetch_mirror_ok(argv[2]):
            return "", "", f"git fetch's --git-dir {argv[2]!r} is not an absolute path ending .git"
        rest = argv[4:]
        while rest and rest[0] in LAND_FETCH_OPTIONS:
            rest = rest[1:]
        if len(rest) < 2 or rest[0] != "origin":
            return "", "", f"git fetch names {rest[0] if rest else 'nothing'!r} where origin and a refspec go"
        bad = [r for r in rest[1:] if not LAND_FETCH_REFSPEC.fullmatch(r) or ".." in r]
        if bad:
            return "", "", f"git fetch with a refspec or option this queue does not run: {bad[0]!r}"
        return "git", argv[2], ""
    if argv[:2] == ["lane-gh", "fetch"] and len(argv) >= 5 and argv[3] == "--dir":
        if not land_fetch_mirror_ok(argv[4]):
            return "", "", f"lane-gh fetch's --dir {argv[4]!r} is not an absolute path ending .git"
        if not LAND_FETCH_REPO.fullmatch(argv[2]) or argv[2].lower() != repo.lower():
            return "", "", f"lane-gh fetch names {argv[2]!r}, not this PR's {repo}"
        pairs = argv[5:]
        if len(pairs) % 2 or not all(pairs[i] == "--branch" and LAND_FETCH_BRANCH.fullmatch(pairs[i + 1])
                                     and ".." not in pairs[i + 1] for i in range(0, len(pairs), 2)):
            return "", "", f"lane-gh fetch with an option this queue does not run: {land_trim(pairs, 160)}"
        return "lane-gh", argv[4], ""
    return "", "", f"the fetch step is neither git --git-dir M fetch nor lane-gh fetch: {land_trim(argv[:5], 160)}"


# A chat or iOS hold the PR body can claim a release from (leo-workspace hold_fences CHAT_CLAIM and IOS_CLAIM: a line
# of its own, "Chat-hold: ..." or "iOS-hold: ..."); a review SHIP at the head must confirm the claim it makes.
LAND_HOLD_CLAIM_STOPS = frozenset({"chat_hold", "ios_hold"})
LAND_HOLD_CLAIM = re.compile(r"^[ \t>*_-]*(?:Chat|iOS)-hold:[^\n]*$", re.M | re.I)
LAND_HOLD_BODY_DEADLINE = 30.0


def land_hold_claims(body: str) -> str:
    """BODY's hold claim lines, normalized and in order, joined by newlines: "" when it has none."""
    found = LAND_HOLD_CLAIM.findall(str(body or "").replace("\r\n", "\n"))
    return "\n".join(" ".join(re.sub(r"[*_]", "", line).strip(" \t>-").split()).lower() for line in found)


def land_fetch_origin(url: str) -> str:
    """OWNER/REPO a github.com remote URL names (https, ssh:// or scp form), else ""."""
    m = LAND_FETCH_ORIGIN.fullmatch(url.strip())
    return m.group(1) if m else ""


def land_fallback(answer: dict, head: str) -> dict:
    """The step an older land_judge's answer (no "action") names, from its code alone (LAND_FALLBACK)."""
    if answer.get("ok"):
        return {"v": 1, "kind": "merge", "sha": head}
    code = str(answer.get("code") or "other")
    kind = LAND_FALLBACK.get(code)
    if code in LAND_STOP_CLASSES:
        return {"v": 1, "kind": "stop", "stop": LAND_STOP_CLASSES[code], "why": land_reason(answer.get("reason"))}
    if kind == "update_branch":
        return {"v": 1, "kind": kind, "expected_head_sha": head}
    if kind == "wait_pr":
        return {"v": 1, "kind": kind, "sha": head, "until": "done", "timeout_s": LAND_WAIT_DEFAULT}
    if kind == "repin":
        return {"v": 1, "kind": kind, "sha": ""}
    if kind == "retry":
        return {"v": 1, "kind": kind, "after_s": LAND_RETRY_DEFAULT}
    if kind == "wait_comment":
        return {"v": 1, "kind": kind, "match": "SHIP|BLOCK", "timeout_s": LAND_REVIEW_WAIT}
    if kind == "review":
        return {"v": 1, "kind": kind}
    return {"v": 1, "kind": "command", "text": land_trim(answer.get("next"))}


def land_merge_argv(answer: dict, repo: str, number: str, sha: str) -> list[str]:
    """The gh arguments of the merge land_judge's ANSWER passed at SHA. A merge action `via: "rest"` is a teammate's PR
    that a coordinator's deliberate fix merge record covers at exactly SHA (leo-workspace machines/deliberate-fix-merges.json,
    read by teammate_optin.deliberate_fix_record in `land-judge explain`): the record covers only REST's PUT
    pulls/N/merge pinned to SHA (land_judge.rest_fix_merge), never a `gh pr merge`, which can enqueue or auto-merge.
    Either goes through the gh-quota shim, so land_judge judges it again (teammate_optin.fix_merge, holds, BLOCKs).
    Before, the queue sent only `gh pr merge` and stopped every such PR on teammate (cmux#47721, 2026-11-21)."""
    act = answer.get("action")
    if isinstance(act, dict) and act.get("via") == "rest":
        return ["api", "-X", "PUT", f"repos/{repo}/pulls/{number}/merge", "-f", f"sha={sha}", "-f",
                "merge_method=squash"]
    return ["pr", "merge", number, "-R", repo, "--squash", "--match-head-commit", sha]


def land_action(answer: dict, head: str) -> dict:
    """The answer's "action" when it is one this queue knows, else the fallback table's."""
    act = answer.get("action")
    if not (isinstance(act, dict) and act.get("kind") in LAND_KINDS):
        act = land_fallback(answer, head)
    return land_command_wait(act, answer, head) if act.get("kind") == "command" else act


def land_command_wait(act: dict, answer: dict, head: str) -> dict:
    """A "command" step that is a glaeda-gh wait (LAND_COMMAND_WAIT_RUN, _PR) as that wait step, else ACT. The run or
    PR's repository is the step's, so take() stops one on another repository; a PR wait on another PR number is left
    a command (take() would stop it anyway)."""
    text = " ".join(map(str, act["argv"])) if isinstance(act.get("argv"), list) else str(act.get("text") or "")
    if not text.strip():
        text = str(answer.get("next") or "")
    timeout = LAND_COMMAND_TIMEOUT.search(text)
    timeout_s = float(timeout.group(1)) if timeout else LAND_WAIT_DEFAULT
    base = {"v": 1, **{k: act[k] for k in ("number", "head") if k in act}}
    run = LAND_COMMAND_WAIT_RUN.fullmatch(text)
    if run:
        return {**base, "kind": "wait_run", "repo": run.group(1), "run": run.group(2), "timeout_s": timeout_s,
                "from": "command"}
    pr = LAND_COMMAND_WAIT_PR.fullmatch(text)
    if pr and (act.get("number") in (None, "") or str(act.get("number")) == pr.group(2)):
        until = LAND_COMMAND_UNTIL.search(text)
        return {**base, "kind": "wait_pr", "repo": pr.group(1), "number": pr.group(2), "sha": head,
                "until": until.group(1) if until else "done", "timeout_s": timeout_s, "from": "command"}
    return act


def land_read_quota(error: str) -> bool:
    """Whether a direct read's ERROR is a refusal for the login's spent quota (direct_read's DIRECT_QUOTA, or the
    gh-quota shim's, the broker's or a step's words for it: LAND_UNREAD_QUOTA, LAND_STEP_QUOTA), not a failed read.
    cmuxterm-hq#16608, 2026-11-21 23:05Z and 23:15Z: a pinned land stopped pin_unread on three such refusals while
    GraphQL read 0/5000 until 23:38Z."""
    text = str(error or "")
    return DIRECT_QUOTA in text or bool(LAND_UNREAD_QUOTA.search(text) or LAND_STEP_QUOTA.search(text))


def land_quota_said(text: str, now: float) -> float | None:
    """The reset a quota refusal's TEXT names (HH:MM[:SS]Z, see LAND_QUOTA_SAID), as the next such time at or after
    NOW (a time up to 120 s past is this window's, just gone, as gh_latch._next_at reads it), or None: no time, or one
    more than LAND_QUOTA_MAX_S ahead."""
    for pattern in LAND_QUOTA_SAID:
        m = pattern.search(text or "")
        if not m:
            continue
        hh, mm, ss = int(m.group(1)), int(m.group(2)), int(m.group(3)) if m.group(3) else 59
        if hh > 23 or mm > 59 or ss > 59:
            return None
        day = time.gmtime(now)
        at = float(dt.datetime(day.tm_year, day.tm_mon, day.tm_mday, hh, mm, ss,
                               tzinfo=dt.timezone.utc).timestamp())
        if at < now - 120:
            at += 86400
        return at if at <= now + LAND_QUOTA_MAX_S else None
    return None


def latch_free_reason(got: subprocess.CompletedProcess) -> str:
    """The latch-free check's own reason for "no" (gh_app_token.py ready prints "gh-app-token: not ready for OWNER:
    WHY" on stderr): WHY, else its last line, else its exit. huge-blue, 2026-11-19: every starved-latch notice named
    leo-workspace#5944 (merged) whatever kept the owner on the login; teamleaderleo's real reason was that no App pool
    serves it."""
    text = "\n".join(t for t in (got.stderr, got.stdout) if isinstance(t, str) and t.strip())
    line = next((ln.strip() for ln in reversed(text.splitlines()) if ln.strip()), "")
    m = re.search(r"not ready for \S+: (.+)", line)
    return (m.group(1) if m else line)[:300] or f"the latch-free check exited {got.returncode}"


def land_jitter(key: str, reset: float = 0.0) -> float:
    """This caller's offset past the reset RESET for KEY, 0..reset_spread_s (gh-quota.json; LAND_QUOTA_JITTER its
    default): fixed per host, PR and reset, so a re-park lands on the same second and the queues of every host spread
    over the window (pace_spread, the shim's own hash)."""
    return pace_spread(f"{policy_host()}|{LAND_TAG}|{key}", reset)


def land_latch_spread(now: float) -> float | None:
    """The until of the login's latch mark GitHub named (LATCH_GITHUB_SOURCES) that ended less than reset_spread_s
    before NOW, or None: entries resume past it each at its own land_jitter, not all at its first second. Only a mark
    land_latch would have held on: a share or a REST login_only mark held no land, so its end spreads none."""
    width = pace_settings()["reset_spread_s"]
    best = None
    for pool in ("rest", "graphql"):
        doc = read_json(latch_state_dir() / f"{pool}-exhausted.json")
        if not isinstance(doc, dict) or doc.get("share") is True or (pool == "rest" and doc.get("login_only") is True) \
                or doc.get("source") not in LATCH_GITHUB_SOURCES \
                or (pool == "graphql" and doc.get("source") != LAND_LATCH_SECONDARY):
            continue
        until = doc.get("until")
        if isinstance(until, (int, float)) and not isinstance(until, bool) and until <= now < until + width:
            best = max(best or 0.0, float(until))
    return best


def land_budget_reading(pool: str) -> dict | None:
    """The daemon's last reading of the login's POOL (budget.json), for a reader with no daemon of its own (`land
    status`): land_latch judges its age and its reset itself."""
    doc = read_json(BASE / "budget.json")
    seen = doc.get(pool) if isinstance(doc, dict) else None
    return dict(seen) if isinstance(seen, dict) else None


def land_reading_state(seen: dict | None, mark_at: Any, now: float) -> str:
    """"fresh" when SEEN (a reading {remaining, limit, reset, seenAt}) was taken after the mark (MARK_AT), at most
    LAND_READING_MAX_AGE ago, and its reset is still ahead; "stale" when it exists but is not (a passed reset is an
    unknown count, never "0 left": cosmic-gray 2026-11-19 showed "graphql 0/5000 left, resets 09:37:39Z, seen 19m
    ago" after that reset); "unread" with none."""
    if not isinstance(seen, dict):
        return "unread"
    remaining, reset, at = seen.get("remaining"), seen.get("reset"), seen.get("seenAt")
    if not all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in (remaining, reset, at)):
        return "stale"
    if reset <= now or now - at > LAND_READING_MAX_AGE:
        return "stale"
    if isinstance(mark_at, (int, float)) and not isinstance(mark_at, bool) and at < mark_at:
        return "stale"
    return "fresh"


def land_window_reset(seen: dict | None, mark_at: Any, now: float) -> bool:
    """Whether SEEN, a reading taken after the mark (MARK_AT), names a reset after the mark that has passed by NOW:
    GitHub's window the mark was written in has refilled, so the mark (a primary limit's) holds no more. A stale
    reading's count is unknown; its reset is still GitHub's word for when that window ended."""
    if not isinstance(seen, dict) or not isinstance(mark_at, (int, float)) or isinstance(mark_at, bool):
        return False
    reset, at = seen.get("reset"), seen.get("seenAt")
    if not all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in (reset, at)):
        return False
    return at >= mark_at and mark_at < reset <= now


def land_latch_judge(now: float, reading: Callable[[str], dict | None] | None = None,
                     lands: bool = True) -> tuple[tuple[str, float] | None, list[dict]]:
    """land_latch's answer and, per held mark, what it found: {pool, source, by, at, until (as written), holds, why,
    heldUntil, reading ("fresh", "stale", "unread" or None: not asked), remaining, reset, seenAt, reserve}.

    LANDS (the land queue's question, not the daemon's reads): a GraphQL mark other than GitHub's secondary limit holds
    no land: land_judge judges over REST (its quota_held reads only the REST latch; a GraphQL-limited read goes on to
    `gh api repos/O/R/pulls/N`), and the shim refuses a `gh pr merge` on the GraphQL latch unsent, which parks the entry
    on its own words (park_quota). gcp-agent-lane-1 2026-11-19: a GraphQL "until HH:38:59Z" mark held every due land
    ~30 min each hour (07:11-07:38, 08:21-08:38, 09:06-09:38) while REST had ~2000 left.

    READING (Daemon.land_reading: GET /rate_limit, free) checks a held REST mark against GitHub's own count: a fresh
    reading (land_reading_state) above the pool's hard reserve (hard_reserve_floor, gh-quota.json hard_reserve_calls)
    holds no land, lands proceed in the reserve; at or under it the mark holds, ending at the reading's reset when that
    comes first (an "HH:MM:59" said-mark ends at GitHub's real reset). A reading never starts or extends a hold, and a
    stale one changes nothing. Not checked: a "secondary" mark (/rate_limit cannot see that limit; it holds to its own
    until, which nothing here extends), and a "retry-after" mark in its first secondary_hold_s (a secondary 403's
    Retry-After written by a caller that did not call it secondary)."""
    state = Path(os.environ.get("GH_QUOTA_STATE") or Path.home() / ".local/state/gh-quota")
    best: tuple[str, float] | None = None
    notes: list[dict] = []
    for pool in ("rest", "graphql"):
        doc = read_json(state / f"{pool}-exhausted.json")
        if not isinstance(doc, dict) or doc.get("share") is True or (pool == "rest" and doc.get("login_only") is True) \
                or doc.get("source") == LAND_LATCH_ECHO:
            continue
        until = doc.get("until")
        if not isinstance(until, (int, float)) or isinstance(until, bool) or not now < until:
            continue
        written = float(until)
        until = min(written, now + LAND_QUOTA_MAX_S)
        source = doc.get("source")
        note = {"pool": pool, "source": source, "by": doc.get("by"), "at": doc.get("at"), "until": written,
                "holds": True, "why": "mark", "heldUntil": until, "reading": None}
        notes.append(note)
        if lands and pool == "graphql" and source != LAND_LATCH_SECONDARY:
            note.update(holds=False, why="graphql_rest_judges", heldUntil=None)
            continue
        at = doc.get("at")
        if reading is None or source == LAND_LATCH_SECONDARY:
            note["why"] = "secondary" if source == LAND_LATCH_SECONDARY else "mark"
        elif source == "retry-after" and isinstance(at, (int, float)) and not isinstance(at, bool) \
                and now < float(at) + pace_settings()["secondary_hold_s"]:
            note["why"] = "retry_after_first_hold"
        else:
            seen = reading(pool)
            fresh = land_reading_state(seen, at, now)
            reserve = hard_reserve_floor()[pool]
            note["reading"] = fresh
            note["reserve"] = reserve
            if isinstance(seen, dict):
                note.update(remaining=seen.get("remaining"), reset=seen.get("reset"), seenAt=seen.get("seenAt"))
            if fresh == "fresh" and seen["remaining"] > reserve:
                note.update(holds=False, why="reading_above_reserve", heldUntil=None)
                continue
            if land_window_reset(seen, at, now):
                note.update(holds=False, why="window_reset", heldUntil=None)
                continue
            if fresh == "fresh" and float(seen["reset"]) < until:
                until = float(seen["reset"])
                note.update(why="ends_at_reading_reset", heldUntil=until)
            elif fresh == "fresh":
                note["why"] = "reading_under_reserve"
        if best is None or until > best[1]:
            best = (pool, until)
    return best, notes


def land_latch(now: float, reading: Callable[[str], dict | None] | None = None,
               lands: bool = True) -> tuple[str, float] | None:
    """(pool, until) of the login's latch mark that holds at NOW and ends last, or None (land_latch_judge: with
    READING a REST mark is checked against GitHub's own count; with LANDS False every pool's mark counts, the daemon's
    own reads' question).

    The contract (leo-workspace tools/gh_latch.py, lw#5626; glaeda never imports it, it reads the same files): dir
    $GH_QUOTA_STATE, else ~/.local/state/gh-quota; the host's login has rest-exhausted.json and graphql-exhausted.json,
    JSON {until, at, reset, source, by, identity} (older marks: until, at, counter); a mark holds iff now < until, and a
    reset is never more than MAX_S (3700 s) ahead. Writers are atomic and never shorten a held mark; a mark whose source
    is GitHub's own (x-ratelimit-reset, retry-after, said) is never voided early by a writer; the land queue checks it
    against a fresh /rate_limit (land_latch_judge) and never holds lands past GitHub's own count. A lane-share mark
    (share: true, the broker's refusal of a VM's share) does not hold a land: lands pass the share
    (gh_latch.held(share=False)). A REST mark with login_only: true (a broker client's refusal that named the shared
    login) holds no judgement either: land_judge's REST reads of a repo the broker's read pool covers go on its read
    Apps, and land_judge's own stop (quota_held) judges that per repo. A mark with source "echo" (LAND_LATCH_ECHO: our
    own refusal of a held mark read back, a guess no request to GitHub made) holds no entry either: each is judged and
    parks on its own refusal (park_quota). huge-blue 2026-11-18 09:05-09:43Z: such a read-back, marked as GitHub's
    word, held every land 37 min past its wake. The land queue only reads these marks: land_judge, the broker and the
    daemon write them."""
    return land_latch_judge(now, reading, lands)[0]


def land_seconds(value: Any, default: float, low: float = 1.0, high: float = 86400.0) -> float:
    try:
        f = float(value)
    except (TypeError, ValueError):
        return default
    return default if not math.isfinite(f) or f <= 0 else min(high, max(low, f))


def gh_cache_newest() -> float:
    """The newest write in the host's shared gh cache (leo-workspace tools/gh_shared_cache.py: entries under
    $GH_QUOTA_STATE/cache), as a mtime, or 0.0 when there is none to read. A cache-only judgment reads that cache and
    nothing else live, so this number moving is the only way its answer can change (cache_only_inputs)."""
    newest = 0.0
    with contextlib.suppress(OSError):
        with os.scandir(latch_state_dir() / "cache") as it:
            for entry in it:
                with contextlib.suppress(OSError):
                    newest = max(newest, entry.stat().st_mtime)
    return newest


class LandQueue:
    """The daemon's land queue (see the section comment). RUN runs one argv with a deadline and an environment and
    returns a CompletedProcess; CACHE_OF reads a cache entry by key; WATCH registers interest in a key as waited;
    NUDGE asks for a fresh read of a PR; NOTICE writes a notice line. INLINE runs jobs in the tick (tests).
    READS_UPSTREAM says whether this host's PR data is an upstream's copy, which REFRESH reads fresh by key
    (LAND_REFRESH_AFTER)."""

    def __init__(self, run: Callable[..., subprocess.CompletedProcess] | None = None,
                 cache_of: Callable[[str], dict | None] = read_cache,
                 watch: Callable[[str], None] | None = None, nudge: Callable[[str], None] | None = None,
                 notice: Callable[[str, str, str, dict], None] | None = None, inline: bool = False,
                 config: dict | None = None, reads_upstream: Callable[[], bool] = land_reads_upstream,
                 refresh: Callable[[str], str | None] = land_direct_read,
                 behind: Callable[[Path, int, float, float], str | None] = land_checkout_behind,
                 forward: Callable[[list[str], dict, float], dict] = land_forward,
                 broker_client: Callable[[], bool] = land_broker_client,
                 snapshot_of: Callable[[str], dict | None] = read_rollup,
                 peek: Callable[[str], None] | None = None,
                 head_watch: Callable[[str], None] | None = None,
                 reading: Callable[[str], dict | None] | None = land_budget_reading,
                 feed_quiet: Callable[[str, str, float], bool] | None = None) -> None:
        # (key, head, since) -> the webhook feed delivered nothing for that PR or head since (LAND_FEED_QUIET_MAX)
        self.feed_quiet = feed_quiet or (lambda key, sha, since: False)
        self.broker_client = broker_client
        self.reading = reading  # the login's reading of a pool, to check a latch mark against (land_latch_judge)
        self.overridden: set[tuple] = set()  # (pool, at, until) of marks a fresh reading voided, logged once each
        self.snapshot_of = snapshot_of
        self.run = run or (lambda argv, timeout, env: self._run_real(argv, timeout, env))
        self.forward = forward
        self.sending: set[str] = set()  # keys whose handoff is in flight to the executor (forward_tick)
        self.forward_thread: threading.Thread | None = None
        self.forward_after = float("-inf")  # no forward before this (a failed one backs off)
        self.forward_fails = 0
        self.overflowing: set[str] = set()  # keys whose overflow to a peer is in flight (overflow_tick)
        self.overflow_thread: threading.Thread | None = None
        self.overflow_after = float("-inf")
        self.cache_of = cache_of
        self.watch = watch or (lambda key: register(key, waited=True, reader=f"tool:{LAND_TAG}"))
        # one unwaited, one-off read of a key (LAND_PEEK_EVERY); a test's WATCH alone records both
        self.peek = peek or ((lambda key: register(key, reader=f"tool:{LAND_TAG}", once=True)) if watch is None
                             else self.watch)
        self.peeked: dict[str, float] = {}
        self.lean: set[str] = set()  # due entries past the tick's watch window (LAND_WATCH_AHEAD): read unwaited
        # A queued PR's head is registered with the checks store for land-judge (head_key), so the daemon holds its
        # checks before land-judge's first judgment asks; a test's WATCH alone records neither.
        self.head_watch = head_watch or ((lambda key: register(key, consumer=LAND_HEAD_CONSUMER,
                                                                reader=f"tool:{LAND_TAG}"))
                                         if watch is None else (lambda key: None))
        self.head_touched: dict[str, float] = {}
        self.changed_entries: set[str] = set()
        self.recovery_at = float("-inf")
        self.latch_started: float | None = None  # when the latch this pass sees began to hold (a window: hold)
        self.nudge = nudge or (lambda key: None)
        self.notice = notice or (lambda kind, level, text, data: None)
        self.inline = inline
        self.config_given = config
        self.reads_upstream = reads_upstream
        self.refresh = refresh
        self.behind = behind
        self.behind_at = float("-inf")
        self.stale_checkout: tuple[str, str | None] | None = None  # check_behind's last finding, numbers out
        self.mh_fallback: tuple[Path, Path] | None = None  # (land-judge configured, the release run instead)
        self.mh_refresh_at = float("-inf")  # when refresh_checkout last started ws-deploy (LAND_MH_REFRESH_EVERY)
        self.mh_refreshing = False
        self.mh_changed_at = float("-inf")  # when land_judge's checkout was refreshed or turned current (rearm)
        self.latched: tuple[str, int] | None = None
        self.latch_reading: str | None = None  # the reading state latch.json last said (latch_held)
        # The latch a previous daemon saw holding (land/latch.json): a restart or re-exec inside one hold is the same
        # window (hold), not a new one; its end is still logged and still marks latch_cleared.
        seen = read_json(land_dir() / LAND_LATCH_FILE)
        if isinstance(seen, dict) and isinstance(seen.get("pool"), str) \
                and isinstance(seen.get("until"), (int, float)) and not isinstance(seen.get("until"), bool):
            self.latched = (seen["pool"], round(seen["until"]))
            since = seen.get("since", seen.get("at"))
            if isinstance(since, (int, float)) and not isinstance(since, bool):
                self.latch_started = float(since)
        self.latch_cleared = float("-inf")  # when the login's latch last cleared: no cached head before it is pinned
        refused =read_json(land_dir() / LAND_REFUSED_FILE)
        self.refused: dict | None = refused if isinstance(refused, dict) else None
        self.lock = threading.RLock()
        self.local = threading.local()  # .gen: the request generation the worker's job started under
        self.entries: dict[str, dict] = {}
        self.jobs: dict[str, Any] = {}
        self.job_started: dict[str, tuple[float, str]] = {}  # key: (when its job took a worker, the job's name)
        self.slot_held_logged: set[str] = set()  # keys whose job was logged land-slot-held (LAND_SLOT_HELD), once
        self.touched: dict[str, float] = {}
        self.pass_gated, self.pass_first_gated = 0, None  # this pass's due judgments that waited for a worker
        self.pool_logged = float("-inf")
        self.pass_latch: tuple[str, float] | None = None  # the login's latch as this pass saw it (log_pool)
        self.pass_latched = 0  # open entries this pass skipped for it
        self.reset_judged: list[float] = []  # when each latch-held entry's judgment started (reset_staggered)
        self.window: dict[str, float] | None = None  # this quota window's start and spend (window_room), read lazily
        self.pass_capped = 0  # this pass's judgments the window cap left for a later window
        self.pass_held_by: dict[str, int] = {}  # this pass's due rows left out, per gate (note_late): "heldBy"
        self.pass_staggered = 0  # this pass's latch-held judgments that waited for their place in the stagger
        # owner -> (asked at, has an unlatched source, why not: the check's own reason, quoted by hold's notice)
        self.latch_free_seen: dict[str, tuple[float, bool, str]] = {}
        self.snapshot_waiting: set[str] = set()  # keys with a snapshot wait, run out or not (judge's cap)
        self.pool: Any = None
        self.now = time.time()
        quota = read_json(land_dir() / LAND_QUOTA_FILE)
        self.queue_quota_until = (float(quota.get("until")) if isinstance(quota, dict)
                                  and isinstance(quota.get("until"), (int, float))
                                  and not isinstance(quota.get("until"), bool) else 0.0)
        # redacted on the way in too: a park an older daemon stored carries gh's numeric user id (land_redact)
        self.queue_quota_reason = land_redact(quota.get("reason") or "") if isinstance(quota, dict) else ""
        self.queue_quota_at = (float(quota.get("at")) if isinstance(quota, dict)
                               and isinstance(quota.get("at"), (int, float))
                               and not isinstance(quota.get("at"), bool) else 0.0)
        self.queue_park_voided: tuple[float, str] | None = None  # (until, why) of a park a reading voided, logged once
        self.load()

    # -- files

    @staticmethod
    def entries_dir() -> Path:
        return land_dir() / "entries"

    @staticmethod
    def requests_dir() -> Path:
        return land_dir() / "requests"

    def config(self) -> dict:
        return self.config_given if self.config_given is not None else land_config()

    def path(self, name: str, default: Path) -> Path:
        given = self.config().get(name)
        return Path(os.path.expanduser(given)) if isinstance(given, str) and given else default

    def load(self) -> None:
        """Every entry from disk. One whose step was claimed and never finished, or that was being judged, is judged
        again: the step is not run a second time on the claim alone."""
        d = self.entries_dir()
        for p in sorted(d.glob("*.json")) if d.is_dir() else []:
            e = read_json(p)
            if not isinstance(e, dict) or not isinstance(e.get("key"), str) or e.get("state") not in LAND_STATES \
                    or not isinstance(e.get("repo"), str) or not str(e.get("number", "")).isdigit():
                continue
            e.pop("snapshotWait", None)  # a fresh daemon's waits start within its own cap (judge)
            if e.get("state") in ("judging", "acting"):
                claimed = e.get("action")
                self.history(e, "restart", note="re-judged after a restart",
                             **({"claimed": claimed.get("kind")} if isinstance(claimed, dict) else {}))
                if isinstance(claimed, dict):
                    e["interrupted"] = claimed
                e["action"] = None
                e["state"] = "queued"
                e["wakeAt"] = None
                e["wait"] = None
                before = str((claimed or {}).get("before") or "") if isinstance(claimed, dict) else ""
                if isinstance(claimed, dict) and claimed.get("kind") in ("update_branch", "retarget") and before:
                    # It may have pushed: never judge (or pin) the head from before it.
                    e["preStepHead"] = before
                    if claimed.get("kind") == "update_branch":  # sent once at that head (LAND_UPDATE_ONCE)
                        e["updateSent"] = {"head": before, "at": float(claimed.get("claimedAt") or self.now)}
                    e["state"] = "waiting"
                    e["wait"] = {"kind": "head_change", "before": before, "since": self.now}
                    e["wakeAt"] = self.now + LAND_HEAD_TIMEOUT
                self.save(e)
            self.entries[e["key"]] = e

    def save(self, e: dict) -> None:
        e["updated"] = self.now
        write_json(self.entries_dir() / file_name(e["key"]), e)

    def history(self, e: dict, event: str, **fields: Any) -> None:
        h = e.setdefault("history", [])
        h.append({"at": round(self.now, 3), "event": event, **{k: v for k, v in fields.items() if v not in (None, "")}})
        del h[:-LAND_HISTORY]

    def count(self, kind: str) -> None:
        """The steps taken, by kind and UTC day: the manual work the queue did (land status prints it)."""
        path = land_dir() / "counts.json"
        with bounded_lock(land_dir() / ".counts.lock"):
            doc = read_json(path)
            days = doc.get("days") if isinstance(doc, dict) and isinstance(doc.get("days"), dict) else {}
            day = days.setdefault(land_day(self.now), {})
            day[kind] = int(day.get(kind) or 0) + 1
            keep = sorted(days)[-LAND_COUNT_DAYS:]
            write_json(path, {"days": {k: days[k] for k in keep}})

    # -- the CLI's requests

    def ingest(self) -> None:
        d = self.requests_dir()
        if not d.is_dir():
            return
        for p in sorted(d.glob("*.json")):
            try:
                self.ingest_one(p)
            except Exception as error:  # noqa: BLE001  one bad request must not stall the queue
                log({"event": "land-error", "request": p.name, "error": describe(error), "site": error_site(error)})
                with contextlib.suppress(OSError):
                    p.rename(p.with_suffix(".bad"))

    def ingest_one(self, p: Path) -> None:
        """Apply one request, save the entry, then delete the request: a crash between the two applies it again,
        and an id already applied (requestId, cancelId) is not applied twice."""
        req = read_json(p)
        if not isinstance(req, dict) or not isinstance(req.get("key"), str):
            p.unlink(missing_ok=True)
            return
        try:
            key, repo, number = land_key(str(req.get("target") or ""))
        except WatchError:
            p.unlink(missing_ok=True)
            return
        with self.lock:
            self.apply(req, key, repo, number)
        p.unlink(missing_ok=True)

    def apply(self, req: dict, key: str, repo: str, number: int) -> None:
        e = self.entries.get(key)
        rid = req.get("id")
        if e and rid and rid in (e.get("requestId"), e.get("cancelId")):
            return  # applied before a crash took the request's deletion with it
        if req.get("op") == LAND_WITHDRAW:
            # A stopped entry is cancelled too: a stop that can clear by itself is re-armed (rearm), so leaving it
            # stopped let the next pass queue it again (hq#14618, 2026-11-21: `land cancel` at ~01:00Z did not hold,
            # and it re-armed at 01:55Z). Cancelled is never re-armed; a later `land` starts it over.
            if e and (e["state"] not in LAND_DONE or e["state"] == "stopped"):
                sent = e["state"] == "acting"
                e["state"] = "cancelled"
                e["wait"] = None
                e["cancelId"] = rid
                e["gen"] = int(e.get("gen") or 0) + 1
                self.history(e, "cancelled", by=req.get("requester"),
                             note="the step already sent runs to its end" if sent else None)
                self.save(e)
            return
        after = []
        for a in req.get("after") or []:
            with contextlib.suppress(WatchError):
                after.append(land_key(str(a))[0])
        fresh = e is None or e["state"] in LAND_DONE
        if e is None:
            e = {"key": key, "repo": repo, "number": number, "created": self.now, "history": [],
                 "mergeSha": "", "reviewed": []}
        e.update(after=[a for a in after if a != key], requester=str(req.get("requester") or ""),
                 requesterFrom=str(req.get("requesterFrom") or ""), queuedBy=str(req.get("queuedBy") or ""),
                 requestId=req.get("id"), gen=int(e.get("gen") or 0) + 1)
        # --sha pins the head this request lands; a request without one (a re-request too) lands whatever head is
        # judged, as before.
        try:
            pin = land_pin_sha(req.get("sha"))
        except WatchError:
            pin = ""
        if pin:
            e.update(pinSha=pin, pinSince=self.now)  # pin_wait: judged only once a read since this request shows it
        else:
            e.pop("pinSha", None)
            e.pop("pinSince", None)
        e.pop("pinWait", None)
        e.pop("pinSeen", None)
        e.pop("pinFollow", None)  # a re-request decides its own pin: no earlier head's parent wait
        if req.get("lane"):
            e.update(lane=str(req["lane"]), laneHost=str(req.get("laneHost") or ""))
        elif "lane" in req:  # a session-less re-request of an open entry (an --after added) keeps its lane
            if fresh or not e.get("lane"):
                e.update(lane="", laneHost="")
        elif fresh:  # an older sender's request: land_lane reads its requester, never an earlier queuer's lane
            e.pop("lane", None)
            e.pop("laneHost", None)
        if fresh or "override" in req:  # a re-request with none keeps an open entry's; a fresh entry has only its own
            e["override"] = land_request_override(req)
        if fresh:
            e.update(state="queued", head="", explain=None, action=None, streak=None, wakeAt=None,
                     wait=None, seen=None, seenHead="", mergeSha="", stop=None, preStepHead="",
                     lastAction=None, reviewed=[], updateSent=None, updateDeferred=None, waitRefused=None,
                     waitBudget=None, afterStopped=None, reruns=None, latchHeld=None, dueLate=None, dueAt=self.now,
                     stepTransient=None, lastStop=None)  # a land by hand is told its stop again (LAND_STOP_REPEAT)
            self.history(e, "queued", by=e["requester"], via=e["requesterFrom"], after=",".join(e["after"]),
                         **land_override_history(e))
        else:
            self.history(e, "updated", by=e["requester"], after=",".join(e["after"]), **land_override_history(e))
        self.entries[key] = e
        self.save(e)
        self.changed_entries.add(key)

    # -- the tick

    def tick(self, now: float | None = None, dirty: set[str] | None = None) -> None:
        self.now = time.time() if now is None else now
        recovery = self.now >= self.recovery_at
        if recovery:
            self.recovery_at = self.now + LAND_RECOVERY_SWEEP
        executor = land_executor(self.config())
        if executor is not None:
            self.forward_tick(executor)
            return
        self.ingest()
        self.changed_entries.update(key for key in dirty or () if key in self.entries)
        self.reap()
        if self.refuse():
            return
        if self.queue_quota_parked():
            # The park holds only the steps that need the login it spent: a judgment, a read, a watch or a nudge.
            # Every step that needs none runs on: a PR the cache shows ended leaves the queue (retire_ended), a row
            # whose own park has run out is re-queued (unpark_due), and the pool line still says where the queue is
            # (land-pool "queueParked").
            self.retire_ended()
            self.unpark_due()
            self.pass_gated, self.pass_first_gated, self.pass_latch = 0, None, None
            self.pass_latched = self.pass_staggered = self.pass_capped = 0
            self.pass_held_by = {}
            self.log_pool()
            return
        latch = self.latch_held()
        ended = land_latch_spread(self.now) if latch is None else None
        self.snapshot_waiting = {k for k, e in self.entries.items() if e.get("state") not in LAND_DONE
                                 and isinstance(e.get("snapshotWait"), dict)}
        self.pass_gated, self.pass_first_gated = 0, None
        self.pass_latch = latch
        self.pass_latched = 0
        self.pass_staggered = 0
        self.pass_capped = 0
        self.pass_held_by = {}
        # The rows this pass can judge, named before it prunes or re-arms anything, so a re-armed entry is judged from
        # the next pass as it always was. judge_order reads a cache file per row it sorts: a finished row (LAND_DONE
        # for up to LAND_KEEP, 7 days) or one a worker already holds would pay for that read and then be skipped on
        # the first lines of the body. gcp-agent-lane-2, 2026-11-21: 243 entries, 142 of them finished, sorted every
        # TICK (2s) -- 72,900 cache file reads per 600s window at 0.30 ms each, and the daemon's own row read "ticks
        # spent 22.2s, most in land (21.9s)". Sorting the 101 open rows is the same order with 2/5 of the reads.
        live = [k for k, e in self.entries.items() if e["state"] not in LAND_DONE and k not in self.jobs
                and k not in self.overflowing]
        for key in [k for k in self.entries if self.entries[k]["state"] in LAND_DONE]:
            try:
                e = self.entries[key]
                if self.now - float(e.get("updated") or 0) > LAND_KEEP:
                    (self.entries_dir() / file_name(key)).unlink(missing_ok=True)
                    del self.entries[key]
                    self.changed_entries.discard(key)
                elif e["state"] == "stopped" and key not in self.jobs:
                    with self.lock:
                        self.rearm(e)  # judged from the next pass
            except Exception as error:  # noqa: BLE001  one bad entry must not stop the others
                log({"event": "land-error", "key": key, "error": describe(error), "site": error_site(error)})
        if dirty is not None and not recovery and latch is None and ended is None:
            # The daemon tells us when a PR cache write or webhook changes a waiting head. A quiet CI wait
            # needs its watch renewed, but sorting it would reopen its cache on every daemon tick.
            awake = []
            for key in live:
                e = self.entries[key]
                w = e.get("wait") or {}
                if (e["state"] == "waiting" and w.get("kind") == "pr" and not w.get("rerun")
                        and key not in self.changed_entries and not self.due(e)
                        and not (e.get("latchHeld") or e.get("snapshotWait") or e.get("after"))):
                    self.keep_watching(e)
                else:
                    awake.append(key)
            live = awake
        if latch is None:
            self.overflow_tick(live)
            live = [k for k in live if k not in self.overflowing]
        order = sorted(live, key=self.judge_order)
        # Only the first LAND_WATCH_AHEAD per worker of the due entries, in the order workers take them, are read at
        # full pace; the rest are as far from a worker as an entry waiting on its checks (LAND_WATCH_AHEAD).
        due_keys = [k for k in order if self.due(self.entries[k])]
        self.lean = set(due_keys[max(1, self.workers() * LAND_WATCH_AHEAD):])
        for key in order:
            try:
                if self.queue_quota_parked():
                    break  # a worker parked the host while this pass was submitting judgments
                e = self.entries[key]
                with self.lock:
                    if self.retire_from_cache(e):
                        continue  # ended: no hold, park or worker needed to say so
                if latch is not None and not self.latch_free(e):
                    self.pass_latched += 1
                    with self.lock:
                        self.hold(e, latch)
                    continue  # a held latch: no judge, read, watch or nudge for this entry this pass
                if ended is not None and self.now < ended + land_jitter(key, ended) and not e.get("staggeredAt") \
                        and int((e.get("latchHeld") or {}).get("windows") or 0) < LAND_LATCH_STARVED_WINDOWS:
                    if self.reset_cap():
                        with self.lock:
                            self.keep_watching(e)  # read by the daemon's batch now, judged from that copy later
                    continue  # the latch just ended: this entry's place in the reset spread is still ahead
                with self.lock:
                    if self.parked(e):
                        continue
                    if e.get("latchHeld"):
                        # no mark holds it this pass (re-read above, never the until it stored): due now, and its
                        # status names no latch, even if no worker takes it yet (gated)
                        self.unhold(e)
                        self.save(e)
                    self.keep_watching(e)
                    self.changed_entries.discard(key)
                    self.consider(e)
            except Exception as error:  # noqa: BLE001  one bad entry must not stop the others
                log({"event": "land-error", "key": key, "error": describe(error), "site": error_site(error)})
        self.log_pool()

    # -- forwarding to the land executor (land_executor): this host judges nothing

    def forward_tick(self, command: list[str]) -> None:
        """One pass on a host that forwards its lands: apply here the requests for entries still open here, hand those
        entries to the executor, and send the rest of requests/ there, in order, off the tick."""
        self.reap()
        d = self.requests_dir()
        with self.lock:
            for path in sorted(d.glob("*.json")) if d.is_dir() else []:
                req = read_json(path)
                try:
                    key, repo, number = land_key(str((req or {}).get("target") or ""))
                except (WatchError, AttributeError):
                    path.unlink(missing_ok=True)
                    continue
                e = self.entries.get(key)
                if key in self.sending or e is None or e["state"] in LAND_DONE:
                    continue  # forwarded after the handoff in flight, or as it is (forward_batch)
                try:
                    self.apply(req, key, repo, number)
                except Exception as error:  # noqa: BLE001  one bad request must not stall the queue
                    log({"event": "land-error", "request": path.name, "error": describe(error),
                         "site": error_site(error)})
                    with contextlib.suppress(OSError):
                        path.rename(path.with_suffix(".bad"))
                    continue
                path.unlink(missing_ok=True)
            for key in list(self.entries):
                e = self.entries[key]
                if e["state"] in LAND_DONE and self.now - float(e.get("updated") or 0) > LAND_KEEP:
                    (self.entries_dir() / file_name(key)).unlink(missing_ok=True)
                    del self.entries[key]
        if self.forward_thread is not None and self.forward_thread.is_alive():
            return
        if self.now < self.forward_after:
            return
        batch, files, handed = self.forward_batch()
        if not batch:
            return
        self.sending = {key for key, _ in handed}
        args = (command, batch, files, handed)
        if self.inline:
            self.forward_send(*args)
        else:
            self.forward_thread = threading.Thread(target=self.forward_send, args=args, name="land-forward",
                                                   daemon=True)
            self.forward_thread.start()

    def forward_batch(self) -> tuple[list[dict], list[tuple[str, Path]], list[tuple[str, int]]]:
        """(the requests to send, (id, file) of each from requests/, (key, gen) of each entry handed off): the entries
        open here first (none whose step still runs), then requests/ in order, at most LAND_FORWARD_BATCH."""
        batch: list[dict] = []
        handed: list[tuple[str, int]] = []
        files: list[tuple[str, Path]] = []
        with self.lock:
            for key, e in sorted(self.entries.items(), key=lambda kv: float(kv[1].get("created") or 0)):
                if e["state"] in LAND_DONE or key in self.jobs or len(batch) >= LAND_FORWARD_BATCH:
                    continue
                batch.append(self.handoff_request(key, e))
                handed.append((key, int(e.get("gen") or 0)))
            d = self.requests_dir()
            blocked = {k for k, e in self.entries.items() if e["state"] not in LAND_DONE}
            for path in sorted(d.glob("*.json")) if d.is_dir() else []:
                if len(batch) >= LAND_FORWARD_BATCH:
                    break
                req = read_json(path)
                if not isinstance(req, dict) or not isinstance(req.get("target"), str):
                    continue
                if req.get("key") in blocked:
                    break  # this key's entry is handed off first: what follows waits, so the order holds
                rid = str(req.get("id") or "")
                if not LAND_REQUEST_ID.fullmatch(rid):
                    rid = path.stem
                batch.append({k: req.get(k) for k in ("op", "target", "after", "requester", "requesterFrom",
                                                      "queuedBy", "lane", "laneHost", "override") if k in req}
                             | {"id": rid})
                files.append((rid, path))
        return batch, files, handed

    @staticmethod
    def handoff_request(key: str, e: dict) -> dict:
        """E as one `land serve` request that hands it to another host's queue (an executor's, or a peer's overflow):
        its request id, requester, lane, --after and override kept, so a resend is applied once."""
        rid = str(e.get("requestId") or "")
        return ({"id": rid if LAND_REQUEST_ID.fullmatch(rid) else f"handoff-{file_name(key)[:16]}-"
                 f"{int(e.get('gen') or 0)}", "op": "land", "target": key_name(key),
                 "after": [key_name(a) for a in e.get("after") or []],
                 "requester": e.get("requester") or "", "requesterFrom": e.get("requesterFrom") or "",
                 "queuedBy": e.get("queuedBy") or "", "handoff": True}
                # an entry from before the lane was recorded names none there: its requester's
                # PARENT/CHILD would read as a session on the executor's host
                | {"lane": e.get("lane") or "", "laneHost": e.get("laneHost") or ""}
                | ({"override": e["override"]} if e.get("override") else {}))

    # -- overflow to peer land hosts (land_overflow): this host judges, and hands its late rows on

    def overflow_due(self, live: list[str]) -> list[str]:
        """Under the lock. The rows of LIVE a peer may take, oldest due first: due here LAND_OVERFLOW_AFTER past their
        due time, with no --after, latch hold or quota park (LAND_OVERFLOW_KEY's comment)."""
        rows = []
        for key in live:
            e = self.entries.get(key)
            if not e or e["state"] in LAND_DONE or key in self.jobs or not self.due(e):
                continue
            if e.get("after") or e.get("latchHeld") or (e.get("wait") or {}).get("kind") == "quota":
                continue
            since = self.due_since(e)
            if since and self.now - since >= LAND_OVERFLOW_AFTER:
                rows.append((since, key))
        return [k for _, k in sorted(rows)][:LAND_FORWARD_BATCH]

    def overflow_tick(self, live: list[str]) -> None:
        """At most once per LAND_OVERFLOW_EVERY, off the tick: the rows overflow_due names go to the peers in
        land.json "overflow" that have room (overflow_send); while they are in flight no worker here takes them."""
        peers = land_overflow(self.config())
        if not peers or self.now < self.overflow_after:
            return
        if self.overflow_thread is not None and self.overflow_thread.is_alive():
            return
        with self.lock:
            keys = self.overflow_due(live)
            if not keys:
                return
            self.overflow_after = self.now + LAND_OVERFLOW_EVERY
            self.overflowing = set(keys)
            rows = [(key, int(self.entries[key].get("gen") or 0), self.handoff_request(key, self.entries[key]))
                    for key in keys]
        if self.inline:
            self.overflow_send(peers, rows)
        else:
            self.overflow_thread = threading.Thread(target=self.overflow_send, args=(peers, rows),
                                                    name="land-overflow", daemon=True)
            self.overflow_thread.start()

    def overflow_send(self, peers: list[list[str]], rows: list[tuple[str, int, dict]]) -> None:
        """Ask each peer for its room and send it that many of ROWS; a row a peer accepted is "forwarded" here."""
        try:
            for command in peers:
                if not rows:
                    break
                name = land_forward_name(command)
                try:
                    answer = self.forward(command, {"op": "room"}, LAND_FORWARD_DEADLINE)
                    room = answer.get("room") if answer.get("ok") else 0
                    room = room if isinstance(room, int) and not isinstance(room, bool) else 0
                    if room <= 0:
                        log({"event": "land-overflow-full", "peer": name, "pending": len(rows)})
                        continue
                    sent, rows = rows[:room], rows[room:]
                    answer = self.forward(command, {"op": "batch", "requests": [r for _, _, r in sent],
                                                    "from": policy_host()}, LAND_FORWARD_DEADLINE)
                    if not answer.get("ok"):
                        raise WatchError(land_trim(answer.get("reason") or answer.get("code"), 200))
                    accepted = {str(a) for a in answer.get("accepted") or []}
                except Exception as error:  # noqa: BLE001  a peer that is down or refuses: the rows stay here
                    log({"event": "land-overflow-failed", "peer": name, "error": land_trim(
                        str(error) if isinstance(error, WatchError) else describe(error), 300)})
                    continue
                with self.lock:
                    for key, gen, req in sent:
                        e = self.entries.get(key)
                        if req["id"] not in accepted or not e or e["state"] in LAND_DONE or key in self.jobs \
                                or int(e.get("gen") or 0) != gen:
                            if req["id"] not in accepted:
                                rows.append((key, gen, req))  # the next peer may take it
                            continue
                        waited = round(self.now - self.due_since(e))
                        e.update(state=LAND_FORWARDED, wait=None, wakeAt=None, action=None, forwardedTo=name)
                        e.pop("dueLate", None)
                        self.history(e, "overflowed", to=name, request=req["id"], waited=waited)
                        self.save(e)
                log({"event": "land-overflowed", "peer": name, "sent": len(sent), "accepted": len(accepted)})
        finally:
            with self.lock:
                self.overflowing = set()

    def forward_send(self, command: list[str], batch: list[dict], files: list[tuple[str, Path]],
                     handed: list[tuple[str, int]]) -> None:
        name = land_forward_name(command)
        try:
            answer = self.forward(command, {"op": "batch", "requests": batch, "from": policy_host()},
                                  LAND_FORWARD_DEADLINE)
            if not answer.get("ok"):
                raise WatchError(f"land executor {name}: {land_trim(answer.get('reason') or answer.get('code'), 200)}")
            accepted = {str(a) for a in answer.get("accepted") or []}
            refused = {str(r.get("id")): str(r.get("why") or "refused") for r in answer.get("refused") or []
                       if isinstance(r, dict) and r.get("id")}
        except Exception as error:  # noqa: BLE001  an unreachable executor is retried, never fatal
            why = str(error) if isinstance(error, WatchError) else describe(error)
            with self.lock:
                self.sending = set()
                self.forward_fails += 1
                wait = min(LAND_FORWARD_RETRY_MAX, LAND_FORWARD_RETRY * 2 ** (self.forward_fails - 1))
                self.forward_after = self.now + wait
                write_json(land_dir() / LAND_FORWARD_FILE, {"executor": name, "state": "failing", "error": why,
                                                            "at": self.now, "pending": len(batch),
                                                            "retryAt": self.forward_after})
            log({"event": "land-forward-failed", "executor": name, "error": why, "pending": len(batch)})
            if self.forward_fails == 1:
                with contextlib.suppress(Exception):
                    self.notice("land-forward-failed", "warn", f"glaeda land could not hand {len(batch)} request(s) "
                                f"to its executor {name}: {why}; they stay queued here and are sent again",
                                {"executor": name, "error": why})
            return
        with self.lock:
            self.sending = set()
            self.forward_fails = 0
            self.forward_after = float("-inf")
            for rid, path in files:
                if rid in accepted:
                    path.unlink(missing_ok=True)
                elif rid in refused:
                    # Kept, never deleted: requests/NAME.refused holds it, and the notice says why and where.
                    with contextlib.suppress(OSError):
                        path.rename(path.with_suffix(".refused"))
                    why = f"{name} refused request {rid}: {land_trim(refused[rid], 200)}"
                    log({"event": "land-forward-refused", "request": rid, "why": why})
                    with contextlib.suppress(Exception):
                        self.notice("land-forward-refused", "warn", f"glaeda land: {why}; kept in "
                                    f"{path.with_suffix('.refused')}", {"executor": name, "request": rid})
            for (key, gen), req in zip(handed, batch):
                e = self.entries.get(key)
                if not e or e["state"] in LAND_DONE or int(e.get("gen") or 0) != gen:
                    continue
                if req["id"] in accepted:
                    e.update(state=LAND_FORWARDED, wait=None, wakeAt=None, action=None, forwardedTo=name)
                    self.history(e, "handed_off", to=name, request=req["id"])
                    self.save(e)
                elif req["id"] in refused:
                    self.stop(e, "forward_refused", f"the land executor {name} refused this PR's handoff: "
                              f"{refused[req['id']]}", f"glaeda-gh land {key_name(key)} again with a valid --notify")
            write_json(land_dir() / LAND_FORWARD_FILE, {"executor": name, "state": "ok", "at": self.now,
                                                        "sent": len(accepted)})
        log({"event": "land-forwarded", "executor": name, "sent": len(accepted), "handedOff": len(handed)})

    def latch_held(self) -> tuple[str, float] | None:
        """The login's latch (land_latch) before a judge pass; logged once when it starts holding and once when it
        clears, and kept in land/latch.json for `land status`. Each pass checks a held mark against the login's fresh
        reading (land_latch_judge; a window's end is such a pass too): a mark that reading voids is logged once
        (land-latch-overridden: pool, the mark's source, by and until, remaining, reset), so its before and after are
        measurable."""
        latch, notes = land_latch_judge(self.now, self.reading)
        for note in notes:
            if note["why"] not in LAND_LATCH_OVERRIDES:
                continue
            once = (note["pool"], note.get("at"), note["until"], note["why"])
            if once in self.overridden:
                continue
            self.overridden.add(once)
            log({"event": "land-latch-overridden", "pool": note["pool"], "why": note["why"],
                 "source": note.get("source"), "by": note.get("by"), "until": utc_clock(note["until"]),
                 "heldUntil": None if note.get("heldUntil") is None else utc_clock(note["heldUntil"]),
                 "remaining": note.get("remaining"), "reset": None if not isinstance(note.get("reset"), (int, float))
                 else utc_clock(note["reset"]), "seenAt": note.get("seenAt"), "reserve": note.get("reserve")})
        if len(self.overridden) > 64:
            self.overridden = {o for o in self.overridden if isinstance(o[2], (int, float)) and o[2] > self.now}
        held = None if latch is None else (latch[0], round(latch[1]))
        note = {} if held is None else next((n for n in notes if n["pool"] == held[0] and n["holds"]), {})
        # what the status says of GitHub's own count: fresh, stale (its reset passed: unknown, never 0 left) or unread
        reading = None if held is None else (note.get("reading") or "unread")
        if held != self.latched or (held is not None and reading != self.latch_reading):
            was, self.latched, self.latch_reading = self.latched, held, reading
            path = land_dir() / LAND_LATCH_FILE
            if held is None:
                path.unlink(missing_ok=True)
                self.latch_cleared = self.now  # every cached head is from before or during the park (fresh_head)
                self.latch_started = None
                log({"event": "land-latch-clear"})
            else:
                if was is None or self.latch_started is None:
                    self.latch_started = self.now  # a new hold: a new window (a longer until is the same one)
                write_json(path, {"pool": held[0], "until": held[1], "at": self.now, "since": self.latch_started,
                                  "source": note.get("source"), "by": note.get("by"), "reading": reading,
                                  "remaining": note.get("remaining"), "reset": note.get("reset")})
                log({"event": "land-latch-held", "pool": held[0], "until": held[1], "source": note.get("source"),
                     "by": note.get("by"), "reading": reading})
        return latch

    def due(self, e: dict) -> bool:
        """Whether E is owed a judgment now: queued, or waiting past its wake (any kind, a park's too)."""
        if e["state"] == "queued":
            return True
        wake = e.get("wakeAt")
        return e["state"] == "waiting" and isinstance(wake, (int, float)) and not isinstance(wake, bool) \
            and wake <= self.now

    def due_since(self, e: dict) -> float:
        """When E became due: its wake, else (queued) its last judgment, else when it was queued."""
        pace = e.get("paceSince")  # paced out and judged only from the caches since: its place from before
        wake = e.get("wakeAt")
        if e["state"] == "waiting" and isinstance(wake, (int, float)) and not isinstance(wake, bool):
            return min(float(wake), float(pace)) if isinstance(pace, (int, float)) else float(wake)
        at = e.get("dueAt")  # when it was last queued (apply, after_merged, unparked)
        if not isinstance(at, (int, float)) or isinstance(at, bool):
            at = (e.get("explain") or {}).get("at")
        if not isinstance(at, (int, float)) or isinstance(at, bool):
            at = e.get("created")
        return float(at) if isinstance(at, (int, float)) and not isinstance(at, bool) else 0.0

    def hold(self, e: dict, latch: tuple[str, float]) -> None:
        """E, due, was skipped for the login's LATCH this pass: its status says so (latchHeld, land_line), once per
        latch window in its history; at LAND_LATCH_STARVED_WINDOWS windows its requester is told once. An entry not
        due is only skipped: it owes no judgment yet."""
        if not self.due(e):
            return
        mark = e.get("latchHeld") or {}
        window = self.latch_started if self.latch_started is not None else self.now
        until = round(latch[1])
        if mark.get("window") == window:
            if mark.get("until") != until:
                mark["until"] = until
                self.save(e)
            return
        n = int(mark.get("windows") or 0) + 1
        e["latchHeld"] = mark = {"pool": latch[0], "until": until, "window": window, "windows": n,
                                 "since": float(mark.get("since") or self.now), "dueSince": self.due_since(e)}
        self.history(e, "latch_held", pool=latch[0], until=utc_clock(until), windows=n)
        if n == LAND_LATCH_STARVED_WINDOWS:
            self.notify(e, e.get("requester") or "",
                        f"glaeda land: {self.url(e)} has been due since {utc_clock(mark['dueSince'])} and not judged: "
                        f"the login's {'REST' if latch[0] == 'rest' else 'GraphQL'} latch has held through {n} "
                        f"windows (now until {utc_clock(until)}). It is judged first when the latch clears; nothing "
                        f"to do. Its reads have no source here but the login: {self.latch_free_why(e)}", wake=False)
        self.save(e)

    def unhold(self, e: dict) -> None:
        """E is judged: the latch no longer holds it (hold)."""
        mark = e.pop("latchHeld", None)
        if mark:
            waited = max(0.0, self.now - float(mark.get("dueSince") or self.now))
            # kept for the next judgment, whenever a worker takes it (LAND_WAIT_HELD): the latch has cleared by then
            e["heldFor"] = float(e.get("heldFor") or 0.0) + waited
            self.history(e, "latch_released", windows=mark.get("windows"), waited=round(waited))

    def parked(self, e: dict) -> bool:
        """True while E is parked on a quota refusal (park_quota): nothing is read for it. Past its wake it is judged
        afresh, as a queued entry."""
        if e["state"] != "waiting" or (e.get("wait") or {}).get("kind") != "quota":
            return False
        wake = e.get("wakeAt")
        if isinstance(wake, (int, float)) and self.now < wake:
            return True
        # nothing was read for it while parked; due since its wake
        e.update(state="queued", wait=None, wakeAt=None, freshAfter=self.now, dueAt=float(wake)
                 if isinstance(wake, (int, float)) and not isinstance(wake, bool) else self.now)
        self.history(e, "unparked")
        head = str(e.get("seenHead") or "")
        if head and self.feed_holds(e, head):
            # The wait judged before the refusal still stands: a retry the feed's next event for the PR judges (the
            # retry branch of consider), not a judgment now that reads GitHub to give it again (LAND_FEED_QUIET_MAX)
            e.update(state="waiting", wait={"kind": "retry", "why": "feed quiet"}, wakeAt=self.now)
        self.save(e)
        return False

    def retire_from_cache(self, e: dict) -> bool:
        """Under the lock. End E when the daemon's copy of its PR reads MERGED (a merge never reverts: any copy), or
        CLOSED in a copy read since E was queued (an older one may predate a reopen). A cache file read, no GitHub
        call, so every look at an entry takes it -- a parked queue, a held latch, a parked entry or a full pool too.
        gcp lane, 2026-11-21: hq#16308 merged and stayed listed for hours behind a host-wide quota park."""
        c = self.cache_of(e["key"]) or {}
        data = c.get("data") or {}
        state = str(data.get("state") or "")
        if state == "CLOSED":
            at = c.get("dataAt")
            if not isinstance(at, (int, float)) or isinstance(at, bool) or at < float(e.get("created") or 0):
                return False
        if self.ended(e, state if state in ("MERGED", "CLOSED") else "", e.get("mergeSha") or "",
                      "the cache shows it"):
            return True
        return self.stop_moved_pin(e, c, data)

    def stop_moved_pin(self, e: dict, c: dict, data: dict) -> bool:
        """Under the lock. Stop E head_moved when it is pinned and a copy of its PR read since the pin shows another
        full head that this queue's own update-branch did not make (pin_follow's case: no update was ever sent for
        E). A cache file read, no GitHub call, so a row gated behind busy workers, the load line or the pace cap stops
        as soon as the read lands instead of when a worker is free to judge it (judge and pin_wait stop it the same
        way). A lane host, 2026-11-22: a pinned row waiting on its stack sat 3 h on a head that had moved."""
        pin = str(e.get("pinSha") or "")
        head = str(data.get("headRefOid") or "").lower()
        if not pin or not SHA40.fullmatch(head) or not land_head_moved(pin, head):
            return False
        if e.get("updateSent") or e.get("preStepHead") or e.get("pinFollow"):
            return False  # this queue moved the head itself: pin_follow decides on the first parent
        since = float(e.get("pinSince") or e.get("created") or 0)
        at = c.get("dataAt")
        if not isinstance(at, (int, float)) or isinstance(at, bool) or at < since:
            return False  # a copy older than the pin may predate the push the pin names
        e.pop("pinWait", None)
        self.stop(e, "head_moved", f"the head is {head[:12]}, not the --sha {pin[:12]} it was queued for",
                  f"glaeda-gh land {e['repo']}#{e['number']} --sha {head}")
        return True

    def retire_ended(self) -> None:
        """Every open entry no worker holds whose cached PR has ended leaves the queue (retire_from_cache)."""
        for key in [k for k, e in self.entries.items() if e["state"] not in LAND_DONE and k not in self.jobs]:
            try:
                with self.lock:
                    self.retire_from_cache(self.entries[key])
            except Exception as error:  # noqa: BLE001  one bad entry must not stop the others
                log({"event": "land-error", "key": key, "error": describe(error), "site": error_site(error)})

    def unpark_due(self) -> None:
        """Every row whose own quota park (park_quota) has run out is re-queued, a host-wide park holding or not: its
        wake and state are this queue's own files, read and written with no GitHub call. Before, the host park
        returned before the pass that unparks them, so a row whose own wake had passed stayed "waiting (quota)" until
        the host park ended too, and its status named a park that was already over."""
        for key in [k for k, e in self.entries.items() if e["state"] == "waiting" and k not in self.jobs]:
            try:
                with self.lock:
                    self.parked(self.entries[key])
            except Exception as error:  # noqa: BLE001  one bad entry must not stop the others
                log({"event": "land-error", "key": key, "error": describe(error), "site": error_site(error)})

    def queue_park_voided_by(self) -> str | None:
        """Why GitHub's own count of the login says the host-wide park (park_queue_quota) holds nothing now, else None
        (it holds as written).

        The park is written from one row's refusal and gates every row's judgment, so it is checked against the
        login's reading every pass, exactly as a latch mark is (land_latch_judge): a fresh reading
        (land_reading_state: taken after the park was written, at most LAND_READING_MAX_AGE old, its reset still
        ahead) above the pool's hard reserve voids it, and so does a window the park was written in that has since
        refilled (land_window_reset). Lands judge over REST (land_latch's graphql_rest_judges), so REST's count
        decides: a GraphQL-only refusal never holds a queue REST can serve. A stale or missing reading changes
        nothing. One host, 2026-11-21 12:08Z: one row's classifier read (cmux#48940 at 93ecc731b278) was refused for
        the GraphQL limit and parked the queue until 12:40:59Z; /rate_limit at 12:07:37Z read 3873 REST and 4969
        GraphQL left, and 18 rows of 4 repos and 3 lanes sat "held: the land queue is parked" behind it."""
        if self.reading is None or not self.queue_quota_at:
            return None
        seen = self.reading("rest")
        reserve = hard_reserve_floor()["rest"]
        if land_reading_state(seen, self.queue_quota_at, self.now) == "fresh" and seen["remaining"] > reserve:
            return f"GitHub's count reads {seen['remaining']} REST left, over the {reserve} reserve"
        if land_window_reset(seen, self.queue_quota_at, self.now):
            return "GitHub's REST window the park was written in has refilled"
        return None

    def clear_queue_park(self) -> None:
        """Forget the host-wide park: its file and this queue's copy of it."""
        self.queue_quota_until = 0.0
        self.queue_quota_reason = ""
        self.queue_quota_at = 0.0
        (land_dir() / LAND_QUOTA_FILE).unlink(missing_ok=True)

    def queue_quota_parked(self) -> bool:
        """Whether a quota refusal has paused this host's whole land queue until its reset: only while GitHub's own
        count of the login agrees it is spent (queue_park_voided_by), which is logged once per park
        (land-queue-park-overridden), so its before and after are measurable. The refused row keeps its own park and
        its own reason (park_quota) either way."""
        with self.lock:
            if self.queue_quota_until > self.now:
                why = self.queue_park_voided_by()
                if why is None:
                    return True
                if self.queue_park_voided != (self.queue_quota_until, why):
                    self.queue_park_voided = (self.queue_quota_until, why)
                    log({"event": "land-queue-park-overridden", "until": utc_clock(self.queue_quota_until),
                         "why": why, "parkedAt": utc_clock(self.queue_quota_at),
                         "reason": land_reason(self.queue_quota_reason, 160)})
                self.clear_queue_park()
                return False
            if self.queue_quota_until:
                self.clear_queue_park()
            return False

    def park_queue_quota(self, until: float, text: str) -> None:
        """Pause every queued land until UNTIL, retaining a later existing hold across restarts."""
        if not isinstance(until, (int, float)) or isinstance(until, bool):
            return
        until = float(until)
        if until <= self.now:
            return
        with self.lock:
            if self.queue_quota_until >= until and self.queue_quota_until > self.now:
                return  # a later refusal must never shorten the host-wide hold
            self.queue_quota_until = max(self.queue_quota_until, until)
            self.queue_quota_reason = land_reason(land_redact(text), 300)
            self.queue_quota_at = self.now
            self.queue_park_voided = None
            write_json(land_dir() / LAND_QUOTA_FILE,
                       {"until": self.queue_quota_until, "at": self.now, "reason": self.queue_quota_reason})

    def park_quota(self, e: dict, text: str) -> None:
        """Park E on a quota refusal whose words are TEXT: until the reset it names plus this caller's jitter, else
        LAND_QUOTA_BACKOFF doubled per quota refusal in a row (at most LAND_QUOTA_BACKOFF_MAX). No step is taken."""
        n = int(e.get("quotaRefusals") or 0) + 1
        e["quotaRefusals"] = n
        said = land_quota_said(text, self.now)
        if said is not None:
            jitter = land_jitter(e["key"], said)
            wake = max(said, self.now) + jitter
            w = {"kind": "quota", "until": said, "said": True, "jitter": jitter}
        else:
            wake = self.now + min(LAND_QUOTA_BACKOFF_MAX, LAND_QUOTA_BACKOFF * (2 ** (n - 1)))
            w = {"kind": "quota", "until": wake, "said": False}
        if said is not None:
            # A reset GitHub named holds every land on this login: park the host until it. An entry's own doubling
            # backoff (no reset named: an unreadable read, a truncated secondary-limit text) parks only that entry.
            # gcp lane, 2026-11-21 07:44Z: one entry's 9th unnamed refusal (its 3600 s cap) parked the whole queue
            # until 08:44Z though the limit it hit ended about 07:52Z -- 40 lands "every worker busy" for an hour.
            self.park_queue_quota(said, text)
        self.history(e, "parked", until=utc_clock(wake), said=utc_clock(said) if said is not None else None, n=n)
        self.check(e)
        e.setdefault("parkedSince", self.now)  # held from here to the next judgment (LAND_WAIT_HELD)
        e["state"] = "waiting"
        e["wait"] = w
        e["wakeAt"] = wake
        self.save(e)

    def refuse(self) -> bool:
        """The startup check, every tick: True (no entry is judged or stepped) while no land-judge resolves.
        The refusal is said once (log, notice, land/refused.json), and once more when it clears."""
        mh, tried = land_judge(self.config())  # as configured: check_behind judges it, land_judge() may not run it
        path = land_dir() / LAND_REFUSED_FILE
        if mh is not None:
            if self.refused is not None:
                log({"event": "land-started", "landJudge": os.fspath(mh), "refusedAt": self.refused.get("at")})
                self.notice("land-started", "info", f"glaeda land started: land-judge is {mh}",
                            {"landJudge": os.fspath(mh)})
                path.unlink(missing_ok=True)
                self.refused = None
            self.check_behind(mh)
            return False
        why, nxt = land_judge_missing(tried)
        nxt += "; the land worker starts on its next tick"
        if self.refused is None or self.refused.get("reason") != why:
            self.refused = {"code": "land_judge_missing", "reason": why, "next": nxt, "at": self.now,
                            "tried": [os.fspath(p) for p in tried]}
            write_json(path, self.refused)
            log({"event": "land-refused", **self.refused})
            self.notice("land-refused", "warn", f"glaeda land refused to start: {why}. next: {nxt}", self.refused)
        return True

    def check_behind(self, mh: Path) -> None:
        """Judge land-judge's checkout MH (land_checkout_behind) at most every LAND_MH_BEHIND_EVERY. One not current
        is not run while the ws-sync release (LAND_JUDGE) is current: land_judge() runs the release instead,
        said once (log, notice, land/stale-checkout.json with "fallback"). With no current release MH still runs,
        and the warning, naming the command that makes one, is said once. Each is said once more when it clears. A
        reason that differs only in its numbers (hours, counts) is the same reason, never said again."""
        if self.now - self.behind_at < LAND_MH_BEHIND_EVERY:
            return
        self.behind_at = self.now
        cfg = self.config()
        commits = int(land_seconds(cfg.get("landJudgeBehindCommits"), LAND_MH_BEHIND_COMMITS, 0, 1e6))
        hours = land_seconds(cfg.get("landJudgeBehindHours"), LAND_MH_BEHIND_HOURS, 0.1, 1e4)
        release = LAND_JUDGE
        try:
            why = self.behind(mh, commits, hours, self.now)
            same = release.is_file() and os.path.realpath(release) == os.path.realpath(mh)
            use = None
            if why is not None and not same and release.is_file() and \
                    self.behind(release, commits, hours, self.now) is None:
                use = release
        except Exception as error:  # noqa: BLE001  a warning's own failure never stops the queue
            log({"event": "land-error", "site": "check_behind", "error": describe(error)})
            return
        path = land_dir() / LAND_STALE_CHECKOUT_FILE
        if why is not None and use is None:
            why += (f"; no current ws-sync release to run instead ({release} "
                    + ("is not current either)" if release.is_file() and not same else
                       "is this checkout)" if same else "does not exist)"))
        if why is not None and use is None:
            self.refresh_checkout(mh)  # what the warning names, run here rather than only said
        key = None if why is None else (re.sub(r"\d+(?:\.\d+)?|(?<=change)s\b", "N", why), os.fspath(use) if use else None)
        if key == self.stale_checkout:
            if why is not None:  # the same finding: keep the file's numbers current for `land status`, say nothing
                write_json(path, {**(read_json(path) or {}), "reason": why, "checkedAt": self.now})
            else:  # current from this daemon's first check: an earlier daemon's warning must not outlive it
                path.unlink(missing_ok=True)
            return
        was = self.mh_fallback
        self.stale_checkout = key
        self.mh_fallback = (mh, use) if use is not None else None
        if why is None:
            path.unlink(missing_ok=True)
            self.mh_changed_at = self.now  # a retry_deadline stop before it is re-armed (rearm)
            log({"event": "land-checkout-current", "landJudge": os.fspath(mh)})
            if was is not None:
                self.notice("land-checkout-current", "info", f"glaeda land: land-judge runs from {mh} again "
                            "(its checkout is current)", {"landJudge": os.fspath(mh)})
            return
        if use is not None:
            text = (f"land-judge runs from the ws-sync release {use}, not {mh}: {why}")
            write_json(path, {"reason": why, "at": self.now, "landJudge": os.fspath(mh), "fallback": os.fspath(use)})
            log({"event": "land-land-judge-fallback", "landJudge": os.fspath(mh), "fallback": os.fspath(use),
                 "reason": why})
            self.notice("land-land-judge-fallback", "info", f"glaeda land: {text}",
                        {"landJudge": os.fspath(mh), "fallback": os.fspath(use)})
            return
        write_json(path, {"reason": why, "at": self.now, "landJudge": os.fspath(mh)})
        log({"event": "land-checkout-stale", "reason": why})
        self.notice("land-checkout-stale", "warn", f"glaeda land: {why}", {"landJudge": os.fspath(mh)})

    def refresh_checkout(self, mh: Path) -> None:
        """Run `tools/ws-deploy --local` beside MH, the step check_behind's warning names (LAND_MH_REFRESH_EVERY's
        comment): off the tick, bounded, at most every LAND_MH_REFRESH_EVERY; the checkout is judged again on the next
        tick. Its outcome goes to the log and the stale-checkout record (`land status`)."""
        tool = mh.parent / "ws-deploy"
        if self.mh_refreshing or self.now - self.mh_refresh_at < LAND_MH_REFRESH_EVERY \
                or self.config().get("landJudgeRefresh") is False or not tool.is_file():
            return
        self.mh_refresh_at, self.mh_refreshing = self.now, True
        argv, started = [os.fspath(tool), "--local"], self.now

        def go() -> None:
            try:
                got = self.call(argv, LAND_MH_REFRESH_DEADLINE)
            finally:
                self.mh_refreshing = False
            said = land_tail(f"{got.stderr or ''}\n{got.stdout or ''}".strip(), 200)
            log({"event": "land-checkout-refresh", "argv": argv, "rc": got.returncode, "out": said})
            path = land_dir() / LAND_STALE_CHECKOUT_FILE
            rec = read_json(path)
            if isinstance(rec, dict):
                write_json(path, {**rec, "refresh": {"at": started, "rc": got.returncode, "out": said}})
            if got.returncode == 0:
                self.mh_changed_at = started
            self.behind_at = float("-inf")  # judged again on the next tick

        if self.inline:
            go()
        else:
            threading.Thread(target=go, name="land-checkout-refresh", daemon=True).start()

    def rearm(self, e: dict) -> bool:
        """Queue a stopped E again when its stop can clear by itself (LAND_REARM_CODES' comment). Under the lock."""
        st = e.get("stop") or {}
        code = str(st.get("code") or "")
        if not LAND_REARM_CODES.match(code):
            return False
        # A PR that merged or closed since the stop is over: it ends its entry (merged, or stopped "closed"), never a
        # re-arm. gcp-codex-swarm-06, 2026-11-20/21: hq#14618, merged long before, re-armed retry_deadline hour after
        # hour, and every re-arm judged a merged PR. The cache is enough: MERGED and CLOSED are terminal, so a cached
        # one is the truth however old.
        data = (self.cache_of(e["key"]) or {}).get("data") or {}
        state = str(data.get("state") or "").upper()
        if state in ("MERGED", "CLOSED"):
            merge_sha = str((data.get("mergeCommit") or {}).get("oid") or "") \
                if isinstance(data.get("mergeCommit"), dict) else ""
            self.ended(e, state, merge_sha, "re-arm: the PR's cached state shows it")
            return False
        at = float(st.get("at") or 0)
        cleared = code == "retry_deadline" and self.mh_changed_at > at
        latched = code == "retry_deadline" and self.latch_owed(e, at)
        if not cleared and not latched and self.now - at < LAND_REARM_AFTER:
            return False
        day = land_day(self.now)
        r = e.get("rearms") or {}
        n = int(r.get("n") or 0) if r.get("day") == day else 0
        if n >= LAND_REARM_CAP:
            return False
        e["rearms"] = {"day": day, "n": n + 1}
        e.update(state="queued", stop=None, wait=None, wakeAt=None, action=None, streak=None, updateSent=None,
                 lastStop=st, dueAt=self.now, gen=int(e.get("gen") or 0) + 1)
        if latched:
            e["waitBudget"] = None  # its budget was spent by the latch, not by land_judge: a whole one
        why = "land_judge's checkout was refreshed" if cleared else "the login's latch that held it cleared" \
            if latched else f"{self.now - at:.0f} s after the stop"
        self.history(e, "rearmed", code=code, why=why, n=n + 1)
        log({"event": "land-rearmed", "key": e["key"], "code": code, "why": why, "n": n + 1})
        self.save(e)
        return True

    def latch_owed(self, e: dict, at: float) -> bool:
        """Whether E's retry_deadline stop at AT is owed a whole budget now (LAND_WAIT_HELD): the login's latch held it
        during that budget, every judgment in it was unreadable, the budget was counted before held time was left out
        (no "held"), and the latch has cleared since the stop."""
        b = e.get("waitBudget") or {}
        if "held" in b or b.get("code") != "unreadable" or set(b.get("perKind") or {}) != {"retry"}:
            return False
        if self.latched is not None or self.latch_cleared <= at:
            return False
        since = float(b.get("since") or at)
        return any(h.get("event") == "latch_held" and since <= float(h.get("at") or 0) <= at
                   for h in e.get("history") or [])

    def reap(self) -> None:
        for key, fut in list(self.jobs.items()):
            if fut is None or fut.done():
                del self.jobs[key]
                started = self.job_started.pop(key, None)
                if started is not None:
                    self.count_hold(key, started[0])
                if key in self.slot_held_logged:
                    self.slot_held_logged.discard(key)
                    log({"event": "land-slot-freed", "key": key, "job": started[1] if started else None,
                         "heldS": round(self.now - started[0]) if started else None})
                err = fut.exception() if fut is not None else None
                if err is not None:
                    log({"event": "land-error", "key": key, "error": describe(err), "site": error_site(err)})
                    with self.lock:
                        e = self.entries.get(key)
                        if e and e["state"] in ("judging", "acting"):
                            e["state"], e["wakeAt"] = "waiting", self.now + LAND_RETRY_DEFAULT
                            e["wait"] = {"kind": "retry"}
                            self.history(e, "error", error=describe(err))
                            self.save(e)
        for key, (at, job) in list(self.job_started.items()):
            if key in self.jobs and key not in self.slot_held_logged and self.now - at >= LAND_SLOT_HELD:
                self.slot_held_logged.add(key)
                state = (self.entries.get(key) or {}).get("state")
                log({"event": "land-slot-held", "key": key, "job": job, "state": state, "heldS": round(self.now - at),
                     "workers": self.workers(), "busy": len(self.jobs)})

    def slot_held(self) -> dict | None:
        """The job holding its worker longest (the land-pool line's "slotHeld"), or None while no job runs."""
        live = [(at, key, job) for key, (at, job) in self.job_started.items() if key in self.jobs]
        if not live:
            return None
        at, key, job = min(live)
        return {"pr": key_name(key), "job": job, "heldS": int(self.now - at)}

    def count_hold(self, key: str, started: float) -> None:
        """Adds a finished job's time on its worker to its entry's holdWindow (LAND_HOLD_MAX)."""
        with self.lock:
            e = self.entries.get(key)
            if e is None:
                return
            w = e.get("holdWindow") or {}
            if not isinstance(w.get("since"), (int, float)) or self.now - float(w["since"]) >= LAND_HOLD_WINDOW:
                w = {"since": started, "heldS": 0.0}
            w["heldS"] = round(float(w.get("heldS") or 0.0) + max(0.0, self.now - started), 1)
            e["holdWindow"] = w
            self.save(e)

    def hold_spent(self, e: dict) -> bool:
        """True while E has held workers LAND_HOLD_MAX within its LAND_HOLD_WINDOW and its last answer judged nothing:
        it waits for the window to end (logged once per window, land-hold-capped)."""
        w = e.get("holdWindow") or {}
        since = w.get("since")
        if not isinstance(since, (int, float)) or self.now - float(since) >= LAND_HOLD_WINDOW:
            return False
        if float(w.get("heldS") or 0.0) < LAND_HOLD_MAX:
            return False
        if str((e.get("explain") or {}).get("code") or "") not in LAND_NOT_JUDGED:
            return False
        if not w.get("capped"):
            w["capped"] = self.now
            until = float(since) + LAND_HOLD_WINDOW
            self.history(e, "hold_capped", heldS=round(float(w["heldS"])), until=utc_clock(until))
            log({"event": "land-hold-capped", "key": e["key"], "heldS": round(float(w["heldS"])),
                 "windowS": LAND_HOLD_WINDOW, "until": utc_clock(until),
                 "code": (e.get("explain") or {}).get("code")})
            self.save(e)
        return True

    def reread(self, e: dict) -> bool:
        """True when E's last answer judged nothing (LAND_UNREAD_CODES) at the head the cache still shows: judging it
        again waits on the same failing reads (LAND_REREAD_SHARE)."""
        x = e.get("explain") or {}
        if str(x.get("code") or "") not in LAND_UNREAD_CODES:
            return False
        head = str(((self.cache_of(e["key"]) or {}).get("data") or {}).get("headRefOid") or "").lower()
        was = str(x.get("head") or (e.get("unreadRun") or {}).get("head") or "").lower()
        return not head or not was or head == was

    def reread_room(self, e: dict) -> bool:
        """Whether E may start a judgment under LAND_REREAD_SHARE: always unless it is a re-read (reread) and that
        share of the workers already judges re-reads."""
        if not self.reread(e):
            return True
        share = max(1, int(self.workers() * LAND_REREAD_SHARE))
        busy = sum(1 for k in self.jobs if (self.entries.get(k) or {}).get("state") == "judging"
                   and self.reread(self.entries[k]))
        return busy < share

    def latch_free(self, e: dict) -> bool:
        """Whether E's reads have a source the login's latch does not hold, so it is judged while the latch holds:
        LAND_LATCH_FREE_COMMAND (land.json latchFreeCommand, else gh_app_token.py beside land-judge) exits 0 for
        E's owner. huge-blue, 2026-11-18 15:24Z: GraphQL latched, workers busy=0, 382 open lands, nothing judged,
        though land_judge reads manaflow-ai through the lander App pools (gh_app_token.hop_dir). Asked once per owner
        per LAND_LATCH_FREE_EVERY; a missing tool, an error or a timeout is "no" (held, as before)."""
        owner = str(e.get("repo") or "").split("/")[0].lower()
        if not owner:
            return False
        seen = self.latch_free_seen.get(owner)
        if seen is not None and self.now - seen[0] < LAND_LATCH_FREE_EVERY:
            return seen[1]
        argv = self.latch_free_argv(owner)
        free, why = False, "no latch-free check on this host (land.json latchFreeCommand, or gh_app_token.py " \
            "beside land-judge)"
        broker = self.broker_read_owners() if self.broker_client() else None
        if broker is not None:
            # A lane VM holds no App credential by design, so the ready command always says no here. Its land's reads
            # carry LANE_GH_LAND (land_judge land_reads), pass the VM's own copy of the login's mark (lane-gh
            # land_read) and the broker answers them from its read App for an owner that App is installed on.
            # gcp-agent-lane-1, 2026-11-19 12:28-14:25Z: 16 lands held four windows by a copied login mark while
            # cosmic-gray judged the same PRs on the lander App.
            free = owner in broker
            why = "" if free else (f"the broker's read pool covers {', '.join(sorted(broker)) or 'no owner'}, "
                                   f"not {owner}")
        elif argv is not None:
            got = self.call(argv, LAND_LATCH_FREE_DEADLINE)
            free = got.returncode == 0
            why = "" if free else latch_free_reason(got)
        if seen is None or seen[1] != free:
            log({"event": "land-latch-free" if free else "land-latch-holds", "owner": owner,
                 **({} if free else {"why": why})})
        self.latch_free_seen[owner] = (self.now, free, why)
        return free

    def latch_free_why(self, e: dict) -> str:
        """Why E's owner has no source the latch does not hold, as the latch-free check last said (latch_free)."""
        seen = self.latch_free_seen.get(str(e.get("repo") or "").split("/")[0].lower())
        return (seen[2] if seen and not seen[1] else "") or "the latch-free check gave no reason"

    def broker_read_owners(self) -> set[str] | None:
        """On a broker client: the owners the lane-gh broker's read Apps are installed on (land.json brokerReadOwners,
        else every read_apps entry's owners in machines/lane-gh-broker.json beside land-judge's tools/, its on_host
        entries too), lower case; None when neither says (the ready command decides, as before)."""
        given = self.config().get("brokerReadOwners")
        if isinstance(given, list) and all(isinstance(o, str) for o in given):
            return {o.lower() for o in given}
        mh, _ = self.land_judge()
        doc = read_json(mh.parent.parent / "machines" / "lane-gh-broker.json") if mh is not None else None
        if not isinstance(doc, dict):
            return None
        apps = list(doc.get("read_apps") or [])
        for host in (doc.get("on_host") or {}).values():
            if isinstance(host, dict):
                apps += list(host.get("read_apps") or [])
        return {str(o).lower() for a in apps if isinstance(a, dict) for o in a.get("owners") or []}

    def latch_free_argv(self, owner: str) -> list[str] | None:
        given = self.config().get("latchFreeCommand")
        if isinstance(given, list) and given and all(isinstance(a, str) for a in given):
            return [a.replace("{owner}", owner) for a in given]
        mh, _ = self.land_judge()
        tool = mh.parent / "gh_app_token.py" if mh is not None else None
        if tool is None or not tool.is_file():
            return None
        return [self.path("python", Path(sys.executable)).as_posix(), os.fspath(tool), "ready", "--owner", owner]

    def workers(self) -> int:
        """The pool's ceiling: land.json "workers" (an operator's override), else one worker per LAND_CORES_EACH of
        this host's cores (land_worker_ceiling), read at each call."""
        return int(land_seconds(self.config().get("workers"), land_worker_ceiling(), 1, 1024))

    def login_workers(self) -> int:
        """land.json "loginWorkers": at most this many judgments at once whose reads spend the login (latch_free says
        no for their owner), else workers(). So "workers" can grow for lands read through the App pools (each its own
        installation quota) while the login's REST reserve, which landing reads spend down to 0, is spent no faster.
        huge-blue, 2026-11-19 14:00Z: 4 of 4 busy, 187 due, 123 dueLate, 32 cores at load ~10-14."""
        given = self.config().get("loginWorkers")
        if given is None:
            return self.workers()
        return min(self.workers(), int(land_seconds(given, self.workers(), 1, self.workers())))

    def login_room(self, e: dict) -> bool:
        """Whether E may start now under login_workers: an owner with an unlatched source always may."""
        cap = self.login_workers()
        if cap >= self.workers() or self.latch_free(e):
            return True
        on_login = 0
        for k in self.jobs:
            owner = str((self.entries.get(k) or {}).get("repo") or "").split("/")[0].lower()
            seen = self.latch_free_seen.get(owner)
            on_login += 0 if seen and seen[1] else 1
        return on_login < cap

    def gated(self, e: dict, why: str = "every worker busy") -> None:
        """E was due a judgment this pass and waits for a worker (judge): counted for the pass's land-pool line."""
        self.pass_gated += 1
        if self.pass_first_gated is None:
            self.pass_first_gated = e["key"]
        self.note_late(e, why)

    def note_late(self, e: dict, why: str) -> None:
        """E, due and not started this pass, has WHY on record as what holds it (dueLate) once it is LAND_DUE_LATE past
        its wake, and its record says the gate holding it now. Every gate in judge() that leaves a due row out calls
        this, not only the worker count: huge-blue, 2026-11-22 07:23Z, load 0.48/core under the line, 1 of 12 workers
        busy, 449 due late, and the rows still read "the host's load is over the line" from 05:41-06:46Z, because the
        gates holding them since (the quota pace, the reset stagger, a head read) left the old reason on the row."""
        if self.due(e):
            self.pass_held_by[why] = self.pass_held_by.get(why, 0) + 1
        if self.due(e) and self.now - self.due_since(e) >= LAND_DUE_LATE and not e.get("dueLate"):
            # A wait past its wake always has a reason on record: here, every worker was busy (LAND_DUE_LATE)
            load = land_load_per_core()
            e["dueLate"] = {"at": self.now, "since": self.due_since(e), "why": why, "workers": self.workers(),
                            "busy": len(self.jobs), "loadPerCore": None if load is None else round(load, 2)}
            self.history(e, "due_late", waited=round(self.now - self.due_since(e)), why=why,
                         workers=self.workers(), busy=len(self.jobs), loadPerCore=load,
                         holders=",".join(key_name(k) for k in list(self.jobs)[:8]))
            self.save(e)
        elif (dl := e.get("dueLate")) and dl.get("why") != why \
                and self.now - float(dl.get("whyAt") or dl.get("at") or 0) >= LAND_LATE_WHY_EVERY:
            # at most once per LAND_LATE_WHY_EVERY: a row whose gate flips each 2 s pass (a worker frees, a head read
            # is asked) would rewrite its file every pass, ~450 rows at once in the 07:25Z queue
            dl.update(why=why, whyAt=self.now, workers=self.workers(), busy=len(self.jobs))  # the reason it waits now, not its first
            load = land_load_per_core()
            dl["loadPerCore"] = None if load is None else round(load, 2)
            self.save(e)

    def log_pool(self) -> None:
        """Once per LAND_POOL_LOG_EVERY, the pool as the last pass left it: workers busy and on what, snapshot waits,
        how many due judgments waited for a worker (the first in line named), the open entries per state and per wait
        kind, the login's latch and how many entries it skipped, and how many are due (queued, or past their wake) with
        the one waiting longest. huge-blue, 2026-11-18 16:11Z: "busy 0, gated 0, open 399" every 5 min said nothing of
        where the other 397 were."""
        if self.now - self.pool_logged < LAND_POOL_LOG_EVERY:
            return
        self.pool_logged = self.now
        with self.lock:
            running = {k: (self.entries.get(k) or {}).get("state") for k in self.jobs}
            states: dict[str, int] = {}
            waits: dict[str, int] = {}
            due: list[tuple[float, str]] = []
            held = late = 0
            for k, e in self.entries.items():
                state = str(e.get("state") or "?")
                if state in LAND_DONE:
                    continue
                states[state] = states.get(state, 0) + 1
                if state == "waiting":
                    kind = str((e.get("wait") or {}).get("kind") or "?")
                    waits[kind] = waits.get(kind, 0) + 1
                if k not in self.jobs and self.due(e):
                    since = self.due_since(e)
                    due.append((since, k))
                    held += 1 if e.get("latchHeld") else 0
                    late += 1 if since and self.now - since >= LAND_DUE_LATE else 0
        oldest = min(due) if due else None
        latch = self.pass_latch
        with contextlib.suppress(OSError):
            write_json(land_dir() / LAND_POOL_FILE, {
                "at": self.now, "workers": self.workers(), "busy": len(running), "due": len(due), "dueLate": late,
                "loadPerCore": land_load_per_core(), "latch": None if latch is None else latch[0],
                "queueParked": self.queue_quota_until > self.now})
        log({"event": "land-pool", "workers": self.workers(), "loginWorkers": self.login_workers(),
             "workersFrom": "land.json" if "workers" in self.config() else f"cores:{land_cores()}",
             "loadPerCore": land_load_per_core(), "busy": len(running),
             "running": [f"{key_name(k)}:{v}" for k, v in running.items()][:16],
             "snapshotWaiting": len(self.snapshot_waiting), "gated": self.pass_gated,
             "firstGated": key_name(self.pass_first_gated) if self.pass_first_gated else None,
             "open": sum(states.values()), "states": states, "waits": waits,
             "latch": None if latch is None else {"pool": latch[0], "until": utc_clock(latch[1])},
             "latched": self.pass_latched, "staggered": self.pass_staggered, "capped": self.pass_capped,
             "heldBy": dict(sorted(self.pass_held_by.items(), key=lambda kv: -kv[1])[:8]),
             # due rows this pass reached no gate in judge(): left out before it (consider, a park, the latch)
             "dueNoGate": max(0, len(due) - sum(self.pass_held_by.values())), "due": len(due), "dueLatchHeld": held,
             "dueLate": late,
             "queueParked": {"until": utc_clock(self.queue_quota_until), "reason": land_reason(self.queue_quota_reason, 160)}
             if self.queue_quota_until > self.now else None,
             "oldestDue": None if oldest is None else {"pr": key_name(oldest[1]),
                                                       "waitingS": int(self.now - oldest[0]) if oldest[0] else None},
             "slotHeld": self.slot_held()})

    def reset_cap(self) -> int:
        """land.json "resetJudgesPerMinute", else LAND_RESET_JUDGES_PER_MIN; 0: no stagger after a latch lifts."""
        value = self.config().get("resetJudgesPerMinute")
        if value == 0 and not isinstance(value, bool):
            return 0  # off: held entries are judged as their place in the reset spread comes (land_latch_spread)
        return int(land_seconds(value, LAND_RESET_JUDGES_PER_MIN, 1, 600))

    def reset_staggered(self, e: dict) -> bool:
        """True while E, held by the login's latch (latchHeld) that cleared less than LAND_RESET_STAGGER_S ago, waits
        for its place in the stagger: reset_cap judgments of held entries started in the last 60 s. Noted once per
        latch window in its history and counted in the pass's land-pool line ("staggered")."""
        cap = self.reset_cap()
        if not cap or not land_latch_held(e) or self.latched is not None \
                or self.now - self.latch_cleared >= LAND_RESET_STAGGER_S:
            return False
        self.reset_judged = [t for t in self.reset_judged if self.now - t < 60.0]
        if len(self.reset_judged) < cap:
            return False
        self.pass_staggered += 1
        if float(e.get("staggeredAt") or float("-inf")) < self.latch_cleared:
            e["staggeredAt"] = self.now  # noted once per latch window; past the reset spread, waiting on the stagger
            self.history(e, "reset_staggered", perMinute=cap)
            self.save(e)
        return True

    def spent_until(self, error: str) -> tuple[str, float, dict | None] | None:
        """(pool, when it resets, the reading) for a read refused because the login's quota is spent (ERROR): the pool
        whose fresh live count is spent to the reserve (pace_next's spent case), the latest reset when both are, else
        the reset the refusal's own words name (land_quota_said), else the login latch's end; None when none says."""
        spent = []
        for pool, cost in LAND_JUDGE_COST.items():
            seen = self.reading(pool) if self.reading is not None else None
            if land_reading_state(seen, None, self.now) == "fresh" \
                    and float(seen["remaining"]) - hard_reserve_floor()[pool] < cost:
                spent.append((pool, float(seen["reset"]), seen))
        if spent:
            return max(spent, key=lambda got: got[1])
        said = land_quota_said(error, self.now)
        if said is not None:
            return "said", said, None
        if self.latched is not None and float(self.latched[1]) > self.now:
            return str(self.latched[0]), float(self.latched[1]), None
        return None

    def pace_next(self, pool: str, w: dict) -> tuple[float, dict | None] | None:
        """When POOL's next judgment may start under the login's live count (the pace comment above LAND_JUDGE_COST),
        and the reading it came from; None when the pool is unpaced (no fresh reading)."""
        seen = self.reading(pool) if self.reading is not None else None
        if land_reading_state(seen, None, self.now) != "fresh":
            return None
        cost = LAND_JUDGE_COST[pool]
        spendable = float(seen["remaining"]) - hard_reserve_floor()[pool]
        if spendable < cost:
            return float(seen["reset"]), seen  # spent to the reserve: the next judgment after the reset
        # From the last judgment's start, so the slot an entry is told to wake for does not move earlier as time
        # passes (measured from now, the slot crept ahead of every paced entry's wake and an entry already due took
        # it each time: 10 entries under 4 slots an hour, 6 never judged live in 8 h)
        at = float(w.get(f"{pool}At", float("-inf")))
        if at == float("-inf"):
            return at, seen
        return at + cost * max(0.0, float(seen["reset"]) - at) / spendable, seen

    def window_now(self) -> dict[str, float]:
        """This quota window's record ({"start", "rest", "graphql"}: what its judgments were charged), kept in the land
        dir so a restart does not open a second full window. A new one starts at the login latch's clear (the reset)
        or, once LAND_WINDOW_S has passed, now."""
        if self.window is None:
            doc = read_json(land_dir() / "window.json")
            self.window = {k: float(doc[k]) for k in ("start", "rest", "graphql", "restAt", "graphqlAt")
                           if isinstance(doc.get(k), (int, float)) and not isinstance(doc.get(k), bool)} \
                if isinstance(doc, dict) else {}
            self.window.setdefault("start", float("-inf"))
        w = self.window
        last = {k: w[k] for k in ("restAt", "graphqlAt") if k in w}  # the pace's clock outlives a window
        if self.latch_cleared > w["start"] and self.latch_cleared <= self.now:
            self.window = w = {"start": self.latch_cleared, "rest": 0.0, "graphql": 0.0, **last}
        elif self.now >= w["start"] + LAND_WINDOW_S:
            self.window = w = {"start": self.now, "rest": 0.0, "graphql": 0.0, **last}
        w.setdefault("rest", 0.0)
        w.setdefault("graphql", 0.0)
        return w

    def graphql_spent(self) -> bool:
        """Whether GraphQL's fresh live count is spent to its hard reserve (pace_next's spent case): no GraphQL read
        the daemon would make for this queue comes before its reset (LAND_REST_ROUTE)."""
        seen = self.reading("graphql") if self.reading is not None else None
        return land_reading_state(seen, None, self.now) == "fresh" \
            and float(seen["remaining"]) - hard_reserve_floor()["graphql"] < LAND_JUDGE_COST["graphql"]

    def rest_route_room(self, nexts: dict, seen: dict | None) -> bool:
        """Whether a judgment GraphQL's pace leaves out may go over REST now (LAND_REST_ROUTE): GraphQL's fresh reading
        is spent to its hard reserve (no slot opens before its reset), and REST has a fresh reading with paced room
        now. An unread REST pool is no room: this route spends only what GitHub's count shows."""
        if not isinstance(seen, dict) or float(seen["remaining"]) - hard_reserve_floor()["graphql"] \
                >= LAND_JUDGE_COST["graphql"]:
            return False  # GraphQL has points over its reserve: its next slot comes, as before
        rest = nexts.get("rest")
        return rest is not None and rest[0] <= self.now

    def cache_only_inputs(self, key: str, sha: str) -> list:
        """Everything a cache-only judgment of KEY at SHA reads: the head it is pinned to, the daemon's kept PR read,
        its rollup snapshot, and the newest write in the host's shared gh cache. Nothing else is read live, so an
        unmoved list means a probe that missed must miss again (window_room)."""
        c = self.cache_of(key) or {}
        snap = self.snapshot_of(key) or {}
        return [sha, c.get("fp"), c.get("fullAt"), c.get("dataAt"),
                snap.get("fp"), snap.get("readAt"), snap.get("complete"), gh_cache_newest()]

    def window_room(self, e: dict, sha: str = "") -> bool:
        """Whether one more judgment fits the login's live pace in every pool (the comment above LAND_JUDGE_COST). Left
        out: noted once per pace slot in E's history, its status says when the next slot opens and what GitHub's count
        read, counted in the pass's land-pool line ("capped")."""
        w = self.window_now()
        nexts = {pool: self.pace_next(pool, w) for pool in LAND_JUDGE_COST}
        over = [pool for pool, got in nexts.items() if got is not None and got[0] > self.now]
        e.pop("cacheOnlyJudge", None)
        e.pop("paceNext", None)
        e.pop("cacheOnlyInputs", None)
        first = e.pop("unreadCacheFirst", None)
        if self.latch_free(e) and not self.broker_client():
            # (A broker client's latch-free owner has its REST reads answered by the broker's read App, its GraphQL by
            # the login: paced as before.) Its reads go to the lander App pools (LAND_ENV_TAGS: every lander read routes to the lander App), not the
            # login this pace spreads: neither paced nor charged here, as the login's latch already does not hold it
            # (latch_free). huge-blue, 2026-11-22 07:12-07:25Z: load 0.56-0.65/core, 12 workers, busy 1-2, capped
            # 243-268 rows a pass, dueLate 425 -> 520 in 13 min: manaflow-ai rows waited on slots of the login's
            # GraphQL they never spend. The App's own refusals are what is measured for them (spent_until, the park).
            if first is not None:
                e["cacheOnlyJudge"] = "unread"
            return True
        if first is not None and not over:
            # The last answer was unreadable: the caches first, no read sent (LAND_UNREAD_SAME_STOP's comment)
            e["cacheOnlyJudge"] = "unread"
            return True
        if not over:
            return True
        pool = over[0]
        slot = float(w.get("graphqlAt", float("-inf")))
        nxt, seen = nexts[pool]
        if over == ["graphql"] and self.rest_route_room(nexts, seen):
            # GraphQL is spent to its reserve and REST has paced room: the caches first, then a live judgment over
            # REST, charged to REST alone (LAND_REST_ROUTE's comment).
            e["cacheOnlyJudge"] = "rest"
            return True
        if over == ["graphql"]:
            # Only GraphQL is paced out: judged from the caches, charged nothing (LAND_CACHE_ONLY_MAX_AGE's comment).
            # One that missed already waits, as any capped entry does: in that slot, and past it while nothing a
            # cache-only judgment reads has moved. The slot alone is no dedupe (it is the host's last charged judgment,
            # so every other entry's live judgment moves it): 2026-11-22, one host probed cmux#46507 at one unmoved
            # head 139 times in 24 h, holding a worker each time to read caches that could not answer.
            missed = e.get("cacheOnlyMissed") or {}
            inputs = self.cache_only_inputs(e["key"], sha)
            if missed.get("start") != slot and missed.get("inputs") != inputs:
                e["cacheOnlyJudge"] = slot
                e["cacheOnlyInputs"] = inputs
                e["paceNext"] = nxt
                return True
        self.pass_capped += 1
        # Held by the cap from here to its judgment: not counted toward its wait's deadline (LAND_WAIT_HELD), as a
        # latch or a quota park is. Router review of glaeda#2244, F1: a 200-entry simulation stopped an "unreadable"
        # entry after four judgments over 25,470 s although its retries asked for 420 s, the rest waiting its turn.
        e.setdefault("cappedSince", self.now)
        stamp = float(w.get(f"{pool}At", float("-inf")))
        if float((e.get("windowCapped") or {}).get("start") or float("-inf")) != stamp:
            e["windowCapped"] = {"start": stamp, "at": self.now, "pool": pool, "next": nxt,
                                 "remaining": (seen or {}).get("remaining"), "reset": (seen or {}).get("reset")}
            self.history(e, "window_capped", pool=pool, spent=round(w[pool]), next=utc_clock(nxt),
                         remaining=(seen or {}).get("remaining"))
            self.save(e)
        return False

    def window_charge(self, e: dict) -> None:
        """A judgment of E starts: this window is charged its LAND_JUDGE_COST, kept on disk; a cache-only judgment
        (window_room's cacheOnlyJudge) sends nothing and is charged nothing."""
        w = self.window_now()
        if self.latch_free(e) and not self.broker_client():  # read on the lander App pools: the login's window is not charged (window_room)
            e.pop("windowCapped", None)
            return
        if not isinstance(e.get("cacheOnlyJudge"), float):  # a pace slot's cache-only judgment sends nothing
            # a REST-route judgment (LAND_REST_ROUTE) sends no GraphQL the pace could give: charged to REST alone
            pools = ("rest",) if e.get("cacheOnlyJudge") == "rest" else LAND_JUDGE_COST
            for pool in pools:
                w[pool] += LAND_JUDGE_COST[pool]
                w[f"{pool}At"] = self.now
        e.pop("windowCapped", None)
        write_json(land_dir() / "window.json", w)

    def judge_tier(self, e: dict) -> int:
        """The cap's order (window_room leaves the last out): 0, judged ok at the head the cache shows with its merge
        step next; 1, due with a step its last refusal named (update-branch, rerun, review); 2, the rest."""
        x = e.get("explain") or {}
        head = str(((self.cache_of(e["key"]) or {}).get("data") or {}).get("headRefOid") or "").lower()
        kind = str((x.get("action") or {}).get("kind") or "")
        if x.get("ok") and kind == "merge" and head and str(x.get("head") or "").lower() == head:
            return 0
        if kind in ("update_branch", "rerun_failed", "review", "retarget") and self.due(e):
            return 1
        return 2

    def judge_order(self, key: str) -> tuple[int, int, int, float]:
        """The tick's order, so a free worker goes first to the land most likely to merge, then to the one that waited
        longest: a PR the cache shows CLEAN with no check running (one merge away) ahead of the rest, then by when it
        began to wait, its last judgment or else when it was queued (both on disk, so a restart does not start over
        from the same few). huge-blue, 2026-11-18 after glaeda#2161: "never judged" sorted first, so cmux#45661 (CLEAN,
        60/60 green, judged hours before) sat behind every PR queued since and got no worker between two restarts.
        Within each, an entry that is due (queued or past its wake: due) goes ahead of one judged only because its
        cache changed, oldest due first (by its wake, due_since), so a latch window's few workers go to the lands
        waiting longest past their wake. huge-blue, 2026-11-18 17:18-19:53Z: 22 lands woke at 17:18 and, sorted by
        their 17:17 judgment, sat behind 300 others through every short window between the login's latches."""
        e = self.entries[key]
        data = (self.cache_of(key) or {}).get("data") or {}
        head = str(data.get("headRefOid") or "")
        ready = data.get("state") == "OPEN" and data.get("mergeStateStatus") == "CLEAN" \
            and not land_checks_running(data, head)
        tier = self.judge_tier(e)
        # a re-read (reread: its last answer judged nothing at this head) is never "one merge away", and goes behind
        # every other due entry: a lane VM, 2026-11-22, three CLEAN-looking PRs judged "unreadable" every few
        # minutes sorted first each time a worker freed, and 27 lands due for hours never got one (LAND_REREAD_SHARE)
        again = self.reread(e)
        ready = ready and not again
        if self.due(e):
            return tier, (0 if ready else 1), (1 if again else 0), self.due_since(e)
        at = (e.get("explain") or {}).get("at")
        if not isinstance(at, (int, float)) or isinstance(at, bool):
            at = e.get("created")
        since = float(at) if isinstance(at, (int, float)) and not isinstance(at, bool) else 0.0
        return tier, (0 if ready else 1), 2, since

    def submit(self, key: str, fn: Callable[..., None], *args: Any) -> None:
        if self.inline:
            fn(*args)
            return
        if self.pool is None:
            import concurrent.futures
            # at the ceiling (threads start only as jobs need them): judge's cap is the live land.json "workers",
            # so changing it takes effect at once instead of at the next restart
            self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=max(land_cores(), self.workers()),
                                                              thread_name_prefix="land")
        self.jobs[key] = self.pool.submit(fn, *args)
        self.job_started[key] = (self.now, getattr(fn, "__name__", "job"))
        self.slot_held_logged.discard(key)

    def wake_near(self, e: dict) -> bool:
        """True while E is parked and its wake is within LAND_WAKE_PREFETCH: its PR is read at full pace for that last
        stretch, so the judgment its own timeout is about to ask for is handed a rollup snapshot inside
        LAND_SNAPSHOT_MAX_AGE instead of a cache as old as the wait it slept through (LAND_WAKE_PREFETCH). Decides
        only which reads the daemon's batch makes first, never when the judgment happens or what it answers."""
        wake = e.get("wakeAt")
        if e["state"] != "waiting" or not isinstance(wake, (int, float)) or isinstance(wake, bool):
            return False
        return 0.0 <= float(wake) - self.now <= LAND_WAKE_PREFETCH

    def keep_watching(self, e: dict) -> None:
        """The PR, its --after PRs and whatever it waits on stay watched and waited, so the daemon reads them at
        full pace: only while E is due (due), or waits on its own push's new head. Otherwise (LAND_PEEK_EVERY) its PR
        and --after PRs get one unwaited read per LAND_PEEK_EVERY, below every wait's in the daemon's order, and an
        --after PR with its own entry here none (that entry reads it, and its merge shows in its state). The run or
        comment a wait is on stays watched and waited: that is what it waits for."""
        w = e.get("wait") or {}
        due = self.due(e) and (e["key"] not in self.lean or bool(e.get("snapshotWait")))
        waited = due or w.get("kind") == "head_change" or self.wake_near(e)
        self.watch_head(e)
        keys = [e["key"]] if waited else []
        if w.get("kind") in ("run", "comment") and w.get("key"):
            keys.append(w["key"])
        for k in keys:
            if self.now - self.touched.get(k, float("-inf")) >= LAND_TOUCH:
                self.watch_now(k)
        peeks = [] if waited else [e["key"]]
        # (an --after PR whose entry here ended unmerged, stopped or forwarded, is read no more by its own entry: a
        # hand merge of it must still show, or this one waits out LAND_AFTER_STOPPED_WAIT and stops)
        peeks += [a for a in e.get("after", []) if (self.entries.get(a) or {}).get("state", LAND_FORWARDED)
                  in LAND_DONE - {"merged", "cancelled"}]
        for k in peeks:
            if self.now - self.peeked.get(k, float("-inf")) >= LAND_PEEK_EVERY:
                self.peeked[k] = self.now
                with contextlib.suppress(OSError, WatchError):
                    self.peek(k)

    def watch_head(self, e: dict) -> None:
        """Register the PR's current head (from its cached read) with the checks store as soon as the entry is open or
        its head moves, then every LAND_TOUCH: HEAD_INTEREST outlasts a queued PR's wait, and a head that moved is a
        new key, registered the same pass. Land-judge's first read of a head then finds the daemon's entry."""
        head = str(((self.cache_of(e["key"]) or {}).get("data") or {}).get("headRefOid") or "").lower()
        if not SHA40.fullmatch(head):
            return
        key = f"head:{e['repo'].lower()}@{head}"
        if self.now - self.head_touched.get(key, float("-inf")) < LAND_TOUCH:
            return
        self.head_touched[key] = self.now
        if len(self.head_touched) > 2000:
            self.head_touched = {k: t for k, t in self.head_touched.items() if self.now - t < LAND_TOUCH}
        with contextlib.suppress(OSError, WatchError):
            self.head_watch(key)

    def watch_now(self, key: str) -> None:
        self.touched[key] = self.now
        with contextlib.suppress(OSError, WatchError):
            self.watch(key)

    def consider(self, e: dict) -> None:
        """Whether this entry is judged now: only when something could have changed land_judge's answer."""
        c = self.cache_of(e["key"])
        if self.retire_from_cache(e):
            return  # before refresh_due: an ended PR never waits for a free worker to leave the queue
        if self.refresh_due(e, c):
            self.changed_entries.add(e["key"])
            return  # judged on the fresh copy, next tick
        data = (c or {}).get("data") or {}
        if self.ended(e, str(data.get("state") or ""), e.get("mergeSha") or "", "the cache shows it"):
            return
        pending, stopped = [], None
        for a in e.get("after") or []:
            ad = (self.cache_of(a) or {}).get("data") or {}
            ae = self.entries.get(a)
            if ad.get("state") == "MERGED" or (ae and ae["state"] == "merged"):
                continue
            if ad.get("state") == "CLOSED":
                self.stop(e, "after_closed", f"{key_name(a)}, which it lands after, was closed without being merged",
                          f"glaeda-gh land {key_name(e['key'])} (without --after) once its base is right")
                return
            if ae and ae["state"] == "cancelled":
                self.stop(e, "after_cancelled", f"{key_name(a)}, which it lands after, was cancelled",
                          f"glaeda-gh land {key_name(a)} && glaeda-gh land {key_name(e['key'])} --after {key_name(a)}")
                return
            if ae and ae["state"] == "stopped" and stopped is None:
                stopped = (a, ae)
            if ae is None and (e.get("afterStopped") or {}).get("key") == a:
                # It stopped, and its entry aged out (LAND_KEEP) before this one's wait ran out: nothing would ever
                # resume or stop this one (review of glaeda#2174, F3)
                self.stop(e, "after_stopped", f"{key_name(a)}, which it lands after, stopped and is no longer queued "
                          "(its land entry aged out)",
                          f"glaeda-gh land {key_name(a)} && glaeda-gh land {key_name(e['key'])} --after {key_name(a)}")
                return
            pending.append(a)
        if stopped and self.after_stopped(e, *stopped):
            return
        if not stopped and e.get("afterStopped"):
            self.history(e, "after_resumed", after=(e.pop("afterStopped") or {}).get("key"))
            self.save(e)
        if pending:
            if e["state"] != "waiting_after":
                e["state"] = "waiting_after"
                self.history(e, "waiting_after", after=",".join(pending))
                self.save(e)
            return
        if e["state"] == "waiting_after":
            e["state"], e["wait"], e["wakeAt"], e["dueAt"] = "queued", None, None, self.now
            self.history(e, "after_merged")  # judged at once: its base may need an update or a retarget
        head = str(data.get("headRefOid") or "").lower()
        fp = land_fingerprint(c)
        w = e.get("wait") or {}
        wake = e.get("wakeAt")
        woke = isinstance(wake, (int, float)) and self.now >= wake
        if not data:
            since = e.setdefault("noDataSince", self.now)
            self.nudge(e["key"])
            # land_judge reads the head; a full pin (land_full_pin) is judged at once on the caller's own read
            if (self.now - since >= LAND_NO_DATA_AFTER or land_full_pin(e)) and self.judge(e, "", fp, why="no_data"):
                e.pop("noDataSince", None)
            return
        e.pop("noDataSince", None)
        if e.get("pinSha") and not e.get("pinSeen") and self.pin_wait(e, c or {}, head):
            return
        running = land_checks_running(data, head)
        kind = w.get("kind")
        if e["state"] == "queued":
            if running:
                self.wait_running(e, head, fp)
            else:
                self.judge(e, head, fp, why="queued")
            return
        if kind == "head_change":
            # After a push-making step: never judge (or pin) a head read before it.
            if head and head != w.get("before"):
                if (e.get("lastAction") or {}).get("kind") == "update_branch":
                    e["updatedHead"] = head  # this queue's own base merge made it (update_again)
                    if self.pin_follow(e, head, data):
                        return  # the new head's first parent is not read yet: not judged on it
                self.wait_running(e, head, fp) if running else self.judge(e, head, fp, why="head_moved")
            elif woke:
                if self.judge(e, "", fp, why="head_timeout"):  # land_judge reads the head itself: the cache never showed the new one
                    self.history(e, "head_timeout", before=w.get("before"))
            elif float((c or {}).get("fetchedAt") or 0) < float(w.get("since") or 0) or self.now - float(
                    w.get("nudgedAt") or 0) >= NUDGE_MIN:
                w["nudgedAt"] = self.now
                self.nudge(e["key"])
            return
        if kind == "repin":
            self.judge(e, str(w.get("sha") or "") or head, fp, why="repin")
            return
        # Against the head the cache showed when it was last judged: land_judge's own head can differ from a stale cache.
        moved = bool(head and e.get("seenHead") and head != e.get("seenHead"))
        if kind == "run":
            rd = (self.cache_of(w.get("key", "")) or {}).get("data") or {}
            done = (rd.get("status") == "completed" or moved) and not running
            if done or woke:
                self.judge(e, head, fp, why=("head_moved" if moved else "run_done") if done else "woke")
            return
        if kind == "comment":
            seen = (self.comment_seen(w) or moved) and not running
            if seen or woke:
                self.judge(e, head, fp, why=("head_moved" if moved else "comment_seen") if seen else "woke")
            return
        if kind == "retry":
            if (moved and not running) or woke:
                if not moved and self.feed_holds(e, head):
                    return  # the wait judged before this could-not-judge answer stands (LAND_FEED_QUIET_MAX)
                self.judge(e, head, fp, why="head_moved" if moved and not running else "woke")
            return
        if running:
            if woke:  # a check that never finishes (a status never posted, no runner): land_judge says what now
                self.judge(e, head, fp, why="checks_woke")
            elif kind != "pr" or w.get("sha") != head:
                self.wait_running(e, head, fp)
            elif w.get("rerun"):
                before = (w.get("sawRunning"), w.get("ran"))
                w["sawRunning"] = True
                land_rerun_ran(w, data.get("checks") or [])
                if (w.get("sawRunning"), w.get("ran")) != before:
                    self.save(e)
            return
        # A rerun's wait: each rerun run ran and finished (land_rerun_ran). Red again shows the fingerprint it was judged
        # at, which alone would wait out the whole timeout before the same red is judged.
        reran = False
        if kind == "pr" and w.get("rerun"):
            before = w.get("ran")
            reran = land_rerun_ran(w, data.get("checks") or [])
            if w.get("ran") != before:
                self.save(e)
        if woke or fp != e.get("seen") or reran:
            if not woke and not reran and (self.verdict_holds(e, c, head, fp) or self.feed_holds(e, head)):
                return  # land_judge would answer the same wait (LAND_VERDICT_KEEP, LAND_FEED_QUIET_MAX)
            # A change alone (checks finished, mergeability computed) is not the step running its course: the same
            # refusal after it does not count toward the stop; after its timeout it does.
            self.judge(e, head, fp, counts=woke, why="woke" if woke else ("reran" if reran else "fp_moved"))

    def pin_follow(self, e: dict, head: str, data: dict) -> bool:
        """E's pin follows HEAD when HEAD is the merge commit this queue's own update-branch just made on top of the
        pinned head. True while the read does not yet say HEAD's first parent, so nothing is judged on a head whose
        provenance is unread (LAND_PIN_PARENT_WAIT bounds that wait; past it the pin stops the row as it always did).

        The daemon moved the head itself: judged tip_merge, ran update_branch at the pinned head, and GitHub made a
        merge commit, so on the next tick the head is not the pin and judge stops the row head_moved -- a refusal built
        from a state transition the refuser performed. manaflow-ai/cmux#48445, 2026-11-21: `step exit=0 kind=
        update_branch` at 13:05:45Z, then "the head is 5ac37fd9debf, not the --sha ae9916f4e43f it was queued for";
        5ac37fd9debf is "Merge branch 'feat-cmux-next' into lane/base-red-16" and its first parent is ae9916f4e43f,
        the pin. The row sat stopped until a person read the trace, read the new head from GitHub and re-queued it.

        Only that commit is followed, and land_pin_merged is the whole safety argument: the new head's first parent is
        the pin, and the update-branch was sent pinned (expected_head_sha) to that same commit. Any other head -- a
        push, a force-push, a merge made on top of something else -- still stops head_moved, unchanged. The pin the
        merge is made with follows too, so the pinned merge still refuses a head nobody judged."""
        pin = str(e.get("pinSha") or "")
        if not pin or not land_head_moved(pin, head):
            return False  # unpinned, or the head still is the pin: nothing to follow
        parent = str((data or {}).get("headParent") or "").lower()
        sent = str(((e.get("updateSent") or {}).get("head")) or "").lower() or str(e.get("preStepHead") or "").lower()
        if land_pin_merged(pin, parent, sent):
            e["pinSha"], e["pinSince"], e["pinSeen"] = head, self.now, True
            e.pop("pinFollow", None)
            # The trace reads as its own safety argument: the old pin, the new head, and the first parent that matched.
            self.history(e, "pin_followed", was=pin[:12], head=head[:12], parent=parent[:12], step="update_branch")
            self.save(e)
            return False
        if parent or not SHA40.fullmatch(head):
            e.pop("pinFollow", None)
            return False  # a parent that is not the pin: judge's head_moved stops it, as it always did
        # "the first parent could not be read" is not "the head moved": wait for a read that says it, then decide.
        w = e.get("pinFollow")
        if not isinstance(w, dict) or w.get("head") != head:
            w = e["pinFollow"] = {"head": head, "since": self.now}
            self.history(e, "pin_parent_wait", pin=pin[:12], head=head[:12])
            self.nudge(e["key"])
            self.save(e)
            return True
        if self.now - float(w.get("since") or 0) >= LAND_PIN_PARENT_WAIT:
            e.pop("pinFollow", None)
            self.history(e, "pin_parent_unread", head=head[:12])
            return False  # no read said this head's parent in time: the pin stops the row as it always did
        if self.now - float(w.get("nudgedAt") or 0) >= NUDGE_MIN:
            w["nudgedAt"] = self.now
            self.nudge(e["key"])
            self.save(e)
        return True

    def pin_wait(self, e: dict, c: dict, head: str) -> bool:
        """A land pinned with --sha/--match-head-commit (E's pinSha): True while E waits for a read of its PR made since
        the request, or when it stopped because that read shows another head. huge-blue, 2026-11-21 10:56Z:
        leo-workspace#7221, pinned at 53fa5568 just pushed, was judged within a minute on the cache's 5-minute-old copy
        of 0eb40dbac8fb and stopped on that head's conflict; the pin said a newer head existed. Until the cache shows
        the pinned head, or a read since the request shows another, no verdict on a cached head is taken (judge's own
        head_moved included): the PR is read again (nudged, or refreshed through the upstream), at most every
        NUDGE_MIN. Once the cache shows the pin (pinSeen), judge's head_moved check holds as it always did.

        Bounded: a nudge that brings no read within NUDGE_MIN is followed by a direct read of the PR (refresh_job), as
        on a host that reads through its upstream; LAND_PIN_READ_FAILS failed direct reads in a row stop the entry
        (pin_unread), naming the pin, the cached head and the read's error to its requester. A read refused for the
        login's spent quota (land_read_quota) is not counted: the entry holds until the window resets (spent_until,
        kept as windowCapped with pinRead), then reads again."""
        pin = str(e.get("pinSha") or "")
        if head and not land_head_moved(pin, head):
            e["pinSeen"] = True
            if e.pop("pinWait", None) is not None:
                self.history(e, "pin_seen", head=head[:12])
            self.save(e)
            return False
        since = float(e.get("pinSince") or 0)
        reads = [t for t in (c.get("dataAt"), c.get("updatedAtAt")) if isinstance(t, (int, float))
                 and not isinstance(t, bool)]
        if head and reads and max(reads) >= since:
            # GitHub, read since the request, says the head is not the pinned one: the pin refuses (as judge does)
            e.pop("pinWait", None)
            self.stop(e, "head_moved", f"the head is {head[:12]}, not the --sha {pin[:12]} it was queued for",
                      f"glaeda-gh land {e['repo']}#{e['number']} --sha {head}")
            return True
        w = e.get("pinWait")
        if not isinstance(w, dict):
            w = e["pinWait"] = {"since": self.now, "cached": head[:12]}
            self.history(e, "pin_wait", pin=pin[:12], cached=head[:12])
            self.save(e)
        refused = w.pop("quotaRefused", None)
        if refused:
            # The direct read was refused for the login's spent quota: not counted toward pin_unread. The entry holds,
            # as a capped one does (windowCapped, cappedSince), until that window resets, then reads again.
            got = self.spent_until(str(refused))
            if got is not None and got[1] > self.now:
                pool, until, seen = got
                e["windowCapped"] = {"start": until, "at": self.now, "pool": pool, "next": until, "pinRead": True,
                                     "remaining": (seen or {}).get("remaining"), "reset": (seen or {}).get("reset")}
                e.setdefault("cappedSince", self.now)
                self.history(e, "window_capped", pool=pool, pinRead="quota", next=utc_clock(until),
                             remaining=(seen or {}).get("remaining"))
            else:  # no reset known: read again on the usual cadence (NUDGE_MIN), still not counted
                self.history(e, "pin_read_quota", error=land_trim(str(refused), 120))
            self.save(e)
        capped = e.get("windowCapped") or {}
        if capped.get("pinRead"):
            if float(capped.get("next") or 0) > self.now:
                return True  # held until the reset: no read, no judgment of the cached head
            e.pop("windowCapped", None)
            w.pop("readAt", None)  # the window reset: read again now
            self.history(e, "pin_read_again", pool=capped.get("pool"))
            self.save(e)
        fails = int(w.get("directFails") or 0)
        if fails >= LAND_PIN_READ_FAILS:
            e.pop("pinWait", None)
            self.stop(e, "pin_unread",
                      f"waited for a read showing the --sha {pin[:12]} (cached head {head[:12] or 'none'}); "
                      f"{fails} direct reads of the PR failed, the last: {w.get('directError') or 'no error text'}",
                      f"glaeda-gh land {e['repo']}#{e['number']} --sha {pin}")
            return True
        last = w.get("readAt")
        if not isinstance(last, (int, float)) or isinstance(last, bool) or self.now - last >= NUDGE_MIN:
            if not self.reads_upstream() and not w.get("nudgedAt"):
                w["readAt"] = w["nudgedAt"] = self.now
                self.save(e)
                before = (c.get("dataAt"), c.get("updatedAtAt"))
                self.nudge(e["key"])
                again = self.cache_of(e["key"]) or {}  # a read the nudge already answered (the daemon's own pass)
                if (again.get("dataAt"), again.get("updatedAtAt")) != before:
                    # judged from that read on the next pass (consider holds this pass's copy), or stopped now
                    self.pin_wait(e, again, str((again.get("data") or {}).get("headRefOid") or "").lower())
                    self.changed_entries.add(e["key"])
                    return True
            elif len(self.jobs) < self.workers():  # no free worker: read on a later pass
                # (also where a nudge went unanswered for NUDGE_MIN: the PR is read directly, not nudged again)
                w["readAt"] = w["directAt"] = self.now
                e["refresh"] = {"at": self.now, "age": round(self.now - max(reads)) if reads else None}
                self.submit(e["key"], self.refresh_job, e["key"])
            self.save(e)
        return True

    def after_stopped(self, e: dict, a: str, ae: dict) -> bool:
        """E lands after A, whose land stopped (LAND_AFTER_STOPPED_WAIT): E keeps waiting for A, telling its requester
        once per stop of A; True when A has stayed stopped past the wait and E stopped, naming A and the command that
        re-queues E."""
        st = ae.get("stop") or {}
        mark = e.get("afterStopped") or {}
        if mark.get("key") != a or mark.get("stopAt") != st.get("at"):
            mark = {"key": a, "stopAt": st.get("at"), "since": self.now}
            e["afterStopped"] = mark
            self.history(e, "after_stopped_waiting", after=a, code=st.get("code"))
            self.save(e)
            self.notify(e, e.get("requester") or "",
                        f"glaeda land: {self.url(e)} waits: {key_name(a)}, which it lands after, stopped "
                        f"({st.get('code') or 'stopped'}); this land stays queued behind it until "
                        f"{utc_clock(self.now + LAND_AFTER_STOPPED_WAIT)}. next: glaeda-gh land {key_name(a)} once "
                        "its stop is cleared, or merge it; this one follows", wake=False)
            return False
        if self.now - float(mark.get("since") or self.now) < LAND_AFTER_STOPPED_WAIT:
            return False
        self.stop(e, "after_stopped",
                  f"{key_name(a)}, which it lands after, stayed stopped ({st.get('code') or 'stopped'}: "
                  f"{land_reason(st.get('reason'), 160)}) for {LAND_AFTER_STOPPED_WAIT:.0f} s",
                  f"glaeda-gh land {key_name(a)} && glaeda-gh land {key_name(e['key'])} --after {key_name(a)}")
        return True

    def note_feed_verdict(self, e: dict, answer: dict, act: dict, head: str, started: Any) -> None:
        """Keep the last verdict that judged something (not LAND_NOT_JUDGED, not a quota refusal) when it is a wait at a
        full head (feedVerdict, at the judgment's start): what feed_holds holds. Any other verdict drops it."""
        code = str(answer.get("code") or "")
        if code in LAND_NOT_JUDGED or LAND_QUOTA_REFUSAL.search(str(answer.get("reason") or "")):
            return  # judged nothing: the verdict before it still stands
        at = started if isinstance(started, (int, float)) and not isinstance(started, bool) else self.now
        if not answer.get("ok") and act.get("kind") in LAND_WAIT_KINDS and SHA40.fullmatch(head or ""):
            e["feedVerdict"] = {"head": head, "at": at, "code": code, "kind": act.get("kind")}
        else:
            e.pop("feedVerdict", None)

    def feed_holds(self, e: dict, head: str) -> bool:
        """True while E's last wait verdict at HEAD (feedVerdict) still stands because the webhook feed delivered nothing
        for the PR, its head or its branch since that judgment started (feed_quiet), within LAND_FEED_QUIET_MAX of it:
        land_judge, asked again, reads GitHub to give the same wait. Noted once per verdict (history "feed_quiet")."""
        v = e.get("feedVerdict") or {}
        at = v.get("at")
        if not head or v.get("head") != head or not isinstance(at, (int, float)) or isinstance(at, bool) \
                or self.now - at >= LAND_FEED_QUIET_MAX:
            return False
        if not self.feed_quiet(e["key"], head, at):
            return False
        if not v.get("noted"):  # counted once per verdict held, not per pass
            v["noted"] = True
            self.count("feed_held")
            self.history(e, "feed_quiet", head=head[:12], code=v.get("code"), age=round(self.now - at))
            self.save(e)
        return True

    def verdict_holds(self, e: dict, c: dict | None, head: str, fp: str) -> bool:
        """True while E's last verdict, a wait_pr at HEAD, still stands (LAND_VERDICT_KEEP): judged within the bound, at
        this head, on the check fingerprint the cache shows now, with no run of checks between (wait_running drops
        it). A change it keeps is noted once (history "kept") and judged when the bound runs out, if it still holds."""
        x = e.get("explain") or {}
        at = x.get("at")
        if not head or x.get("head") != head or e.get("seenHead") != head \
                or (x.get("action") or {}).get("kind") != "wait_pr":
            return False
        if not isinstance(at, (int, float)) or isinstance(at, bool) or self.now - at >= LAND_VERDICT_KEEP:
            return False
        if not e.get("seenChecks") or e["seenChecks"] != land_check_fingerprint(c):
            return False
        if e.get("keptFp") != fp:
            e["keptFp"] = fp
            self.count("kept")
            self.history(e, "kept", head=head[:12], code=x.get("code"), age=round(self.now - at))
            self.save(e)
        return True

    def refresh_due(self, e: dict, c: dict | None) -> bool:
        """On an upstream host, a read of the entry's PR through the broker when the upstream's copy is older than
        LAND_REFRESH_AFTER (see there), started on a worker: True when one was started."""
        at = (c or {}).get("dataAt")
        if not isinstance(at, (int, float)) or isinstance(at, bool) or self.now - at < LAND_REFRESH_AFTER:
            return False  # fresh, or never read (the no-data path judges it unpinned)
        urgent = e["state"] == "queued" or (e.get("wait") or {}).get("kind") == "head_change"
        last = (e.get("refresh") or {}).get("at")
        if isinstance(last, (int, float)) and self.now - last < (LAND_REFRESH_AFTER if urgent else LAND_REFRESH_EVERY):
            return False
        if not self.reads_upstream():
            return False  # a host with its own login: the nudge (and the stale valve) refresh it
        if self.now - at < LAND_FEED_QUIET_MAX and self.feed_quiet(e["key"], "", at):
            if e.get("feedNoRefresh") != at:  # counted once per copy not re-read, not per pass
                e["feedNoRefresh"] = at
                self.count("feed_norefresh")
            return False  # nothing reached the PR since that copy was read: reading it again reads the same
        if len(self.jobs) >= self.workers():
            return True  # read on a free worker, a later tick; judged after it
        e["refresh"] = {"at": self.now, "age": round(self.now - at)}
        self.save(e)
        self.submit(e["key"], self.refresh_job, e["key"])
        return True

    def refresh_job(self, key: str) -> None:
        error = self.refresh(key)
        with self.lock:
            e = self.entries.get(key)
            if e is None:
                return
            e["refresh"] = {**(e.get("refresh") or {}), "error": land_trim(error, 160) if error else None}
            w = e.get("pinWait")
            if isinstance(w, dict) and w.get("directAt") is not None:  # a pinned land's direct read (pin_wait)
                if error and land_read_quota(error):
                    w["quotaRefused"] = land_trim(error, 160)  # the login's state, not the PR's: held, not counted
                else:
                    w["directFails"] = int(w.get("directFails") or 0) + 1 if error else 0
                w["directError"] = land_trim(error, 160) if error else None
            log({"event": "land-refresh", "key": key, "age": e["refresh"].get("age"), "error": error})
            self.save(e)

    def comment_seen(self, w: dict) -> bool:
        cd = (self.cache_of(w.get("key", "")) or {}).get("data") or {}
        try:
            pattern = re.compile(str(w.get("match") or "SHIP|BLOCK"))
        except re.error:
            pattern = re.compile("SHIP|BLOCK")
        since = float(w.get("since") or 0)
        for cm in cd.get("comments") or []:
            at = max(iso_epoch(cm.get("createdAt")) or 0, iso_epoch(cm.get("editedAt")) or 0)
            if at >= since and pattern.search(str(cm.get("body") or "")):
                return True
        return False

    def wait_running(self, e: dict, head: str, fp: str) -> None:
        """Checks still run at the head: land_judge is not asked until they finish (the cache says when)."""
        e.update(state="waiting", wait={"kind": "pr", "sha": head, "why": "checks running"}, seen=fp, head=head,
                 wakeAt=self.now + LAND_WAIT_DEFAULT)
        e.pop("seenChecks", None)  # checks ran since the last verdict: the next is judged, even if they end the same
        self.unhold(e)  # not due now: its wake is ahead (hold, LAND_DUE_LATE)
        e.pop("dueLate", None)
        self.history(e, "checks_running", head=head[:12])
        self.save(e)

    def snapshot(self, key: str, sha: str) -> tuple[dict | None, str]:
        """(KEY's rollup snapshot at SHA, ready to hand land_judge, or None; why not: "" when it is ready, "wait" when
        the daemon's next full read will write it, else the reason no snapshot will come for this judgment)."""
        if not SHA40.fullmatch(sha or ""):
            return None, "unpinned"
        if self.reads_upstream():
            return None, "upstream"
        if self.graphql_spent():
            # The snapshot is a GraphQL full read's, and the daemon sends none while GraphQL is spent to its hard
            # reserve: no "wait", so no room ahead of the workers is held for it (judge) and the judgment goes on to
            # the REST route (LAND_REST_ROUTE). huge-blue, 2026-11-22 08:04-08:38Z: GraphQL 0/5000, 21-24 snapshot
            # waits filled the 24 places ahead of 12 workers (1-2 busy), and glaeda#2461 (2/2 green, pinned) sat
            # "every worker busy" 34 min without one judgment, never reaching the REST route.
            return None, "graphql spent"
        c = self.cache_of(key) or {}
        fp = c.get("fp")
        if not isinstance(fp, str) and c.get("via") != "graphql":
            return None, "no fingerprint"  # not a GraphQL full read (REST, a probe of one): no snapshot is kept for it
        data = c.get("data") or {}
        snap = self.snapshot_of(key)
        # A whole read is matched by its fingerprint. One the daemon kept partial (a fold of its own failed: a page
        # past the per-minute ceiling, a suite's last real attempt) has none, but its rollup capture may still be
        # whole: it is matched by being that same read (the snapshot's readAt is the cache's fullAt).
        if not isinstance(snap, dict):
            same = False
        elif isinstance(fp, str):
            same = snap.get("fp") == fp
        else:
            same = snap.get("fp") is None and snap.get("readAt") is not None and snap.get("readAt") == c.get("fullAt")
        if not isinstance(snap, dict) or str(data.get("headRefOid") or "").lower() != sha \
                or str(snap.get("head") or "").lower() != sha or not same:
            return None, "wait"
        at = c.get("dataAt")
        if not isinstance(at, (int, float)) or isinstance(at, bool) or self.now - at > LAND_SNAPSHOT_MAX_AGE:
            return None, "wait"
        if not snap.get("complete"):
            return None, "partial"
        return {**snap, "dataAt": at}, ""

    def snapshot_wait(self, e: dict, sha: str, free: bool = True) -> bool:
        """True while E waits for the daemon to read SHA's rollup snapshot (at most LAND_SNAPSHOT_WAIT, nudged). A wait
        that ran out with no worker FREE stays (True): it is judged live when one frees, never waits a second time."""
        _, why = self.snapshot(e["key"], sha)
        w = e.get("snapshotWait") or {}
        if why != "wait":
            e.pop("snapshotWait", None)
            self.snapshot_waiting.discard(e["key"])
            return False
        if w.get("sha") != sha:
            w = e["snapshotWait"] = {"sha": sha, "since": self.now}
            self.snapshot_waiting.add(e["key"])
            self.history(e, "snapshot_wait", head=sha[:12])
            self.nudge(e["key"])
            self.save(e)
        if self.now - float(w.get("since") or 0) < LAND_SNAPSHOT_WAIT or not free:
            return True
        e.pop("snapshotWait", None)
        self.snapshot_waiting.discard(e["key"])
        self.history(e, "snapshot_missing", head=sha[:12])
        return False

    def follow_own_update(self, e: dict, head: str) -> str | None:
        """Move E's pin to HEAD when HEAD is the base merge this queue's own update_branch made at the pinned head;
        None when it moved (or nothing was pinned elsewhere), else why HEAD still stops the land (head_moved).
        hq#14568 (glaeda#2377) followed it only when the cache showed the new head right after an update that returned
        0. cmux16, 2026-11-21 17:05Z: hq#15931's update at its pin 6a6234d0 made 4c8e0840, the cache never showed it
        (head_timeout), land_judge read it and named a repin, and the land stopped head_moved on its own base merge.
        An update that timed out (124) may have reached GitHub the same way. So every head check asks here: the update
        was sent at the pinned head (updateSent), and HEAD's parents, when the read carried them (headParents), include
        that head. A head whose parents do not is someone's push and still stops the land; land_judge still judges
        whatever head the pin follows to, in full, before any merge."""
        pin = str(e.get("pinSha") or "")
        head = str(head or "").lower()
        if not pin or not SHA40.fullmatch(head) or not land_head_moved(pin, head):
            return None
        sent = str((e.get("updateSent") or {}).get("head") or "").lower()
        if not sent or land_head_moved(pin, sent) or sent == head:
            return "no update_branch of this queue's was sent at the pinned head"
        data = (self.cache_of(e["key"]) or {}).get("data") or {}
        parents = data.get("headParents") if str(data.get("headRefOid") or "").lower() == head else None
        if parents is None and str(data.get("headRefOid") or "").lower() == head and data.get("headParent"):
            parents = [data["headParent"]]  # pr_head_parent's first parent (pin_follow's read) says it as well
        unread = [h for h in e.get("history") or [] if h.get("event") == "pin_parent_unread" and h.get("head") == head[:12]]
        if not isinstance(parents, list) and unread:  # glaeda#2364: pin_follow waited for its parent and none came
            return "no read of this head said its first parent within the wait, so it is not known to be this update"
        if isinstance(parents, list) and sent not in [str(p).lower() for p in parents]:
            return (f"its parents ({', '.join(str(p)[:12] for p in parents) or 'none'}) do not include {sent[:12]}, "
                    "where this queue's update_branch was sent: a push, not that update's base merge")
        e["pinSha"] = head
        e["updatedHead"] = head
        self.history(e, "repin_own_update", pin=pin[:12], head=head[:12],
                     parents="checked" if isinstance(parents, list) else "unread")
        self.save(e)
        return None

    def fresh_head(self, e: dict, sha: str, free: bool = True) -> str | None:
        """SHA when a judgement may pin it, "" when land_judge must read the head itself, None while E waits (nudged)
        for a read of its PR made after it was unparked or the login's latch last cleared (LAND_FRESH_WAIT): while
        either held, the daemon read nothing for it. Only a head the cache gave is checked: a pin land_judge named (a
        repin) is its own read. Past the wait with no worker FREE it stays None: unpinned on the next free one.
        A full pin the caller passed (land_full_pin) is trusted with no read: when the cache shows it, or shows no head
        (SHA ""), the judgement is pinned to it at once. The merge's --match-head-commit refuses it if it moved; waiting
        for a fresh read under a short quota (the latch, the reserve) never came, and unpinned land_judge read the head
        over REST itself (cmuxterm-hq#16805)."""
        full = land_full_pin(e)
        if full and (not sha or sha == full):
            e.pop("staleHead", None)
            return full
        c = self.cache_of(e["key"]) or {}
        if not sha or str(((c.get("data") or {}).get("headRefOid")) or "").lower() != sha:
            e.pop("staleHead", None)
            return sha
        after = max(float(e.get("freshAfter") or 0), self.latch_cleared)

        def read_since(cache: dict) -> bool:
            # When GitHub last showed this head: a read that changed it (dataAt) or confirmed it unchanged (updatedAtAt).
            reads = [t for t in (cache.get("dataAt"), cache.get("updatedAtAt")) if isinstance(t, (int, float))
                     and not isinstance(t, bool)]
            return bool(reads) and max(reads) >= after

        if read_since(c):
            e.pop("staleHead", None)
            return sha
        reads = [t for t in (c.get("dataAt"), c.get("updatedAtAt")) if isinstance(t, (int, float))
                 and not isinstance(t, bool)]
        if reads and self.now - max(reads) < LAND_FEED_QUIET_MAX and self.feed_quiet(e["key"], sha, max(reads)):
            # no push since that read: a push brings runs for the new head (LAND_FEED_QUIET_MAX's comment)
            e.pop("staleHead", None)
            if e.get("feedFresh") != sha:
                e["feedFresh"] = sha
                self.history(e, "feed_fresh", head=sha[:12], age=round(self.now - max(reads)))
            self.count("feed_fresh")
            return sha
        w = e.get("staleHead") or {}
        if w.get("sha") != sha:
            w = e["staleHead"] = {"sha": sha, "since": self.now}
            self.history(e, "head_stale", head=sha[:12])
            self.nudge(e["key"])
            self.save(e)
            c = self.cache_of(e["key"]) or {}  # a read the nudge already answered (the daemon's own, in its pass)
            head = str(((c.get("data") or {}).get("headRefOid")) or "").lower()
            if read_since(c):
                e.pop("staleHead", None)
                return sha if head == sha else None  # a new head: consider() judges it on its next pass
        if self.now - float(w.get("since") or 0) < LAND_FRESH_WAIT or not free:  # (unpinned on a free worker)
            return None
        e.pop("staleHead", None)
        self.history(e, "head_unpinned", head=sha[:12])
        return ""

    def judge(self, e: dict, sha: str, fp: str, counts: bool = True, why: str = "") -> bool:
        """Judge E at SHA on a free worker; WHY names what made it run (LAND_JUDGE_WHY). True when it was handed one. None free: it stays as it is and is considered
        again next tick (the tick goes least recently judged first), so the pool never queues. Ahead of the workers at
        most LAND_SNAPSHOT_AHEAD per worker start a snapshot wait (each puts its PR's read first); past that, one whose
        snapshot is ready (or that needs none) still takes a free worker, and the rest wait without nudging a read."""
        # Keep the event until we can submit the judgment. Workers, readiness and quota windows may
        # recover before either another event arrives or the recovery sweep runs.
        self.changed_entries.add(e["key"])
        if self.reset_staggered(e):
            self.note_late(e, "the login's reset stagger")
            return False  # its place in the stagger after the latch lifted is ahead: no read nudged, no wait begun
        workers = self.workers()
        free = len(self.jobs) < workers
        room = len(self.jobs) + len(self.snapshot_waiting) < workers * (1 + LAND_SNAPSHOT_AHEAD)
        if not free and not room and not e.get("snapshotWait"):
            self.gated(e)
            return False  # nothing it could start now: no head read nudged, no wait begun, ahead of its turn
        pin = self.fresh_head(e, sha, free)
        if pin is None:
            self.note_late(e, "waiting for the daemon's read of its head")
            return False  # judged once the daemon has read the PR since it was unparked or the latch cleared
        sha = pin
        if land_head_moved(str(e.get("pinSha") or ""), sha) and (own := self.follow_own_update(e, sha)):
            self.stop(e, "head_moved", f"the head is {sha[:12]}, not the --sha {e['pinSha'][:12]} it was queued for "
                      f"({own})", f"glaeda-gh land {e['repo']}#{e['number']} --sha {sha}")
            return False
        mine = (e.get("snapshotWait") or {}).get("sha") == sha
        if not mine and not room:
            if not free or self.snapshot(e["key"], sha)[1] == "wait":
                self.gated(e, "every worker busy" if not free else
                          "snapshot waits ahead fill the room (snapshotWaiting)")
                return False
        elif self.snapshot_wait(e, sha, free):
            self.note_late(e, "waiting for the daemon's snapshot of its head")
            return False  # judged on the daemon's next read of this head (one read, shared), not on land_judge's own
        if not free:
            self.gated(e)  # a judgment it could start: ready, waiting for a worker
            return False
        if not self.login_room(e):
            self.gated(e, "the login's share of the workers (loginWorkers) is busy")
            return False
        if self.hold_spent(e):
            self.gated(e, "held its workers LAND_HOLD_MAX this window judging nothing")  # LAND_HOLD_MAX
            return False
        if not self.reread_room(e):
            self.gated(e, "re-reads of unreadable PRs hold their share of the workers")  # LAND_REREAD_SHARE
            return False
        if not self.window_room(e, sha):
            self.note_late(e, f"the login's quota pace ({(e.get('windowCapped') or {}).get('pool') or '?'})")
            return False  # this window's share is spent: judged in a later one, its place kept
        c = self.cache_of(e["key"]) or {}
        head = str((c.get("data") or {}).get("headRefOid") or "").lower()
        if land_latch_held(e):
            self.reset_judged.append(self.now)  # a place in the stagger (reset_staggered)
        # A pace slot's cache-only judgment keeps the place the entry had (due_since): its miss's wake at the next slot
        # would otherwise put it behind every entry judged live meanwhile, and the same few keys took every slot (10
        # entries under 4 slots an hour: 6 never judged live in 8 h). A live judgment ends it.
        if isinstance(e.get("cacheOnlyJudge"), float):
            e.setdefault("paceSince", self.due_since(e))
        else:
            e.pop("paceSince", None)
        self.window_charge(e)
        e.pop("staggeredAt", None)
        self.unhold(e)
        # Held by the login's latch while due (unhold: heldFor), or parked on a quota refusal since (LAND_WAIT_HELD)
        held = float(e.pop("heldFor", None) or 0.0)
        # a park then the cap's wait after it: one span from the earlier (the two overlap, never counted twice)
        since = [float(v) for v in (e.pop("parkedSince", None), e.pop("cappedSince", None))
                 if isinstance(v, (int, float)) and not isinstance(v, bool)]
        if since:
            held += max(0.0, self.now - min(since))
        e.update(state="judging", seen=fp, seenHead=head, seenChecks=land_check_fingerprint(c), keptFp=None,
                 judging={"sha": sha, "at": self.now, "counts": counts, "held": held,
                          "why": why if why in LAND_JUDGE_WHY else "fp_moved"})
        e.pop("dueLate", None)
        e.pop("dueAt", None)
        self.save(e)
        self.submit(e["key"], self.job, e["key"], sha, int(e.get("gen") or 0))
        self.changed_entries.discard(e["key"])
        return True

    # -- a job: one judgment and the step it names (a worker thread)

    def env(self, e: dict | None = None) -> dict[str, str]:
        """The environment a land subprocess runs with; with E, a step's, which also names E's requester as the lane
        (land_lane): on a lane VM the broker client refuses a write with no lane before it reaches the broker."""
        env = {k: os.environ[k] for k in LAND_ENV if k in os.environ}
        parts = [p for p in env.get("PATH", "").split(":") if p]
        shim = self.gh()
        if shim:  # first, so every gh a step runs (router-review's own) goes through it
            parts = [os.path.dirname(shim)] + [p for p in parts if p != os.path.dirname(shim)]
        for extra in LAND_PATH_EXTRA:
            extra = os.path.expanduser(extra)
            if extra not in parts:
                parts.append(extra)
        env["PATH"] = ":".join(parts)
        extra_env = self.config().get("env")
        if isinstance(extra_env, dict):
            env.update({str(k): str(v) for k, v in extra_env.items() if k not in LAND_ENV_TAGS})
        env.update(LAND_ENV_TAGS)
        if e is not None:
            lane = land_lane(e) or (LAND_QUEUE_LANE if self.broker_client() else "")
            if lane:
                env[LAND_LANE_ENV] = lane
        return env

    @staticmethod
    def _run_real(argv: list[str], timeout: float, env: dict[str, str]) -> subprocess.CompletedProcess:
        with subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              text=True, start_new_session=True, env=env,
                              cwd=os.environ.get("HOME") or "/") as proc:
            try:
                out, err = proc.communicate(timeout=timeout)
            except subprocess.TimeoutExpired:
                with contextlib.suppress(OSError):
                    os.killpg(proc.pid, signal.SIGKILL)
                with contextlib.suppress(subprocess.TimeoutExpired, OSError, ValueError):
                    proc.communicate(timeout=2)
                raise subprocess.TimeoutExpired(argv, timeout) from None
        return subprocess.CompletedProcess(argv, proc.returncode, out, err)

    def call(self, argv: list[str], timeout: float, e: dict | None = None,
             extra: dict[str, str] | None = None) -> subprocess.CompletedProcess:
        """One child (land_judge, the gh-quota shim, lane-gh) and its output, with GitHub's numeric user id dropped
        from both streams (land_redact): every stored reason, cause and park text is captured here."""
        try:
            got = self.run(argv, timeout, {**self.env(e), **(extra or {})})
            return subprocess.CompletedProcess(got.args, got.returncode, land_redact(got.stdout) if got.stdout else
                                               got.stdout, land_redact(got.stderr) if got.stderr else got.stderr)
        except subprocess.TimeoutExpired:
            return subprocess.CompletedProcess(argv, 124, "", f"timed out after {timeout:.0f}s")
        except OSError as error:
            return subprocess.CompletedProcess(argv, 127, "", describe(error))

    def gh(self) -> str | None:
        """The gh-quota shim, or None: no merge (and no other write) is sent past land_judge's own judge."""
        p = self.path("gh", LAND_GH)
        return os.fspath(p) if p.exists() and os.access(p, os.X_OK) else None

    def land_judge(self) -> tuple[Path | None, list[Path]]:
        """(the land-judge to run, or None; every path tried): land.json's landJudge, then LAND_JUDGE_PATHS; the
        ws-sync release instead while check_behind found that one's checkout not current and the release current."""
        mh, tried = land_judge(self.config())
        fb = self.mh_fallback
        if fb is not None and mh == fb[0] and fb[1].is_file():
            return fb[1], tried
        return mh, tried

    def explain(self, e: dict, sha: str) -> dict:
        mh, tried = self.land_judge()
        if mh is None:
            # Gone between the tick's startup check and this job: a stop that names the file, never a retry.
            why, nxt = land_judge_missing(tried)
            nxt += f', then glaeda-gh land {e["repo"]}#{e["number"]}'
            return {"ok": False, "code": "land_judge_missing", "reason": why, "next": nxt, "head": sha,
                    "action": {"v": 1, "kind": "stop", "stop": "land_judge_missing", "why": why}}
        argv = [self.path("python", Path(sys.executable)).as_posix(), os.fspath(mh),
                "explain", e["repo"], str(e["number"])] + (["--sha", sha] if sha else []) + ["--json"]
        cache_only = e.pop("cacheOnlyJudge", None)
        pace_next = e.pop("paceNext", None)
        cache_inputs = e.pop("cacheOnlyInputs", None)
        cached = argv + ["--cache-only", str(LAND_CACHE_ONLY_MAX_AGE)]
        # After an unreadable answer: the caches first, live only on a miss (LAND_UNREAD_SAME_STOP's comment); paced out
        # of GraphQL: the caches alone (the comment above LAND_JUDGE_COST)
        tries = [cached, argv] if cache_only in ("unread", "rest") else [cached] if cache_only is not None else [argv]
        if cache_only in ("unread", "rest"):
            if cache_only == "rest":
                with self.lock:
                    self.count("rest_route")  # GraphQL spent to its reserve: judged over REST (LAND_REST_ROUTE)
            cache_only = None
        snap, _ = self.snapshot(e["key"], sha)
        extra = {}
        if snap is not None:
            # explain only: the merge (the shim's land_judge) reads its evidence live
            path = land_dir() / LAND_SNAPSHOT_DIR / file_name(e["key"])
            with contextlib.suppress(OSError):
                path.parent.mkdir(parents=True, exist_ok=True)
                write_json(path, {"schema": LAND_SNAPSHOT_SCHEMA, "repo": e["repo"], "number": int(e["number"]),
                                  "head": sha, "dataAt": snap["dataAt"], "readAt": snap.get("readAt"),
                                  "rollup": snap.get("rollup")})
                extra[LAND_SNAPSHOT_ENV] = os.fspath(path)
        with self.lock:
            self.count("snapshot" if extra else "live")
        for n, run_argv in enumerate(tries):
            got = self.call(run_argv, LAND_EXPLAIN_DEADLINE, extra=extra)
            answer = None
            for line in reversed((got.stdout or "").strip().splitlines()):
                with contextlib.suppress(ValueError):
                    doc = json.loads(line)
                    if isinstance(doc, dict):
                        answer = doc
                        break
            if answer is None or got.returncode not in (0, 1, 3):
                why = land_reason(got.stderr or got.stdout or f"exit {got.returncode}")
                return {"ok": False, "code": "explain_failed",
                        "reason": f"land_judge explain exit {got.returncode}: {why}",
                        "next": "", "head": sha, "action": {"v": 1, "kind": "retry", "after_s": LAND_RETRY_DEFAULT}}
            if got.returncode != 0:
                answer["ok"] = False
            if n + 1 < len(tries) and answer.get("cacheMiss") \
                    and not LAND_STEP_QUOTA.search(str(answer.get("reason") or "")):
                with self.lock:
                    self.count("unread_cache_miss")  # the caches could not judge it: read live now
                continue
            if n + 1 < len(tries):
                with self.lock:
                    self.count("unread_cache_hit")  # judged from the caches: no read sent, no broker queue waited on
            break
        if cache_only is not None and answer.get("cacheMiss") \
                and not LAND_STEP_QUOTA.search(str(answer.get("reason") or "")):  # a quota refusal parks as before
            # The caches could not judge it: it keeps its place under the cap until the pace's next slot, no strike, and
            # the time it waits there is not counted toward its wait's deadline (cappedSince, LAND_WAIT_HELD).
            nxt = float(pace_next) if isinstance(pace_next, (int, float)) else self.now + LAND_RETRY_DEFAULT
            with self.lock:
                e["cacheOnlyMissed"] = {"start": cache_only, "at": self.now, "inputs": cache_inputs}
                seen = (self.reading("graphql") if self.reading is not None else None) or {}
                e["windowCapped"] = {"start": cache_only, "at": self.now, "pool": "graphql", "next": nxt,
                                     "remaining": seen.get("remaining"), "reset": seen.get("reset")}
                e.setdefault("cappedSince", self.now)
                self.history(e, "window_capped", pool="graphql", cacheOnly="miss", next=utc_clock(nxt))
            return {"ok": False, "code": "host_cap", "head": sha, "cacheMiss": True,
                    "reason": f"not judged this window: host cap (graphql: the login's live pace), and this host's "
                              f"caches could not judge it "
                              f"({land_reason(answer.get('reason'), 200)})",
                    "next": f"none (judged again once the pace's next slot opens at {utc_clock(nxt)})",
                    "action": {"v": 1, "kind": "retry", "after_s": max(LAND_RETRY_DEFAULT, nxt - self.now)}}
        return answer

    def check(self, e: dict) -> None:
        """Raise LandCancelled when `land cancel`, or a newer `land` (new --after, a requeue), came in since this job
        started: its answer and its next step are no longer the entry's."""
        gen = getattr(self.local, "gen", None)
        if e["state"] == "cancelled" or (gen is not None and int(e.get("gen") or 0) != gen):
            raise LandCancelled(e["key"])

    def job(self, key: str, sha: str, gen: int = 0) -> None:
        """One judgment and the step it names. A `land cancel` or a newer `land` that arrives meanwhile wins
        (LandCancelled): the job ends, and a requeued entry is considered afresh on the next tick. A step already
        sent (claimed) runs to its end; what it did shows in the cache."""
        self.local.gen = gen
        try:
            self.judge_and_take(key, sha)
        except LandCancelled:
            with self.lock:
                e = self.entries[key]
                if e.get("action"):
                    self.finish(e, None, note="superseded")
                if e["state"] in ("judging", "acting"):
                    e["state"], e["wait"], e["wakeAt"] = "queued", None, None
                self.save(e)
        finally:
            self.local.gen = None

    def judge_and_take(self, key: str, sha: str) -> None:
        with self.lock:
            e = self.entries[key]
            if self.queue_quota_parked():
                if e["state"] == "judging":
                    e.pop("judging", None)
                    e.update(state="queued", wait=None, wakeAt=None)
                    self.save(e)
                return
            self.check(e)
            judging = e.pop("judging", None) or {}
            counts = judging.get("counts", True)
            held = float(judging.get("held") or 0.0)
            why = str(judging.get("why") or "")  # what made this judgment run (LAND_JUDGE_WHY)
            # The step after the last judgment was refused for quota (step_refused, do_merge): this judgment repeats
            # it and is not a new refusal of the PR's.
            counts = counts and not e.pop("stepQuotaParked", False)
        if not self.state_first(e, None):  # GitHub said it is closed: its state first, no judgment of a finished PR
            return
        answer = self.explain(e, sha)
        answer["pinned"] = bool(sha)  # judged at the cache's head; unpinned, land_judge read the head itself
        head = str(answer.get("head") or sha or "").lower()
        act = land_action(answer, head)
        # A base-changing step on a stale copy: the base change can be the PR's own merge commit (hq#13226). Read
        # before the refusal counts, so a finished PR never reaches the identical-refusal stop.
        if not self.state_first(e, act.get("kind")):
            with self.lock:
                self.count("explain")
            return
        hand = ""
        with self.lock:
            self.check(e)
            self.count("explain")
            e["head"] = head or e.get("head") or ""
            # What this judgment was made on (judge: seenChecks), so the next one can say whether anything moved: a
            # judgment at the same head on the same check fingerprint could only reach the verdict above it
            # (explain_unmoved in `land status`): measured, never acted on. Counted here and nowhere else on purpose:
            # the verdict's own wait is still honoured to the second, so this changes no step, wake or merge.
            # Counted again by what made it run (explain_unmoved_<why>), because the two kinds read alike and are not:
            # a bound of the queue's own running out (LAND_JUDGE_DUE) is the design, and only a change the verdict does
            # not depend on is redundant. Without the split, "45% unmoved" names a waste that is mostly backoff.
            checks = str(e.get("seenChecks") or "")
            prior = e.get("explain") or {}
            unmoved = bool(checks) and prior.get("head") == head and prior.get("checks") == checks
            if unmoved:
                self.count("explain_unmoved")
                self.count(f"explain_unmoved_{why or 'other'}")
            e["explain"] = {"at": self.now, "ok": bool(answer.get("ok")), "code": str(answer.get("code") or ""),
                            "reason": land_reason(answer.get("reason")), "next": land_trim(answer.get("next")),
                            "head": head, "action": act, "fallback": not isinstance(answer.get("action"), dict),
                            "checks": checks, "why": why}
            self.history(e, "judged", code=answer.get("code") or ("ok" if answer.get("ok") else ""),
                         head=head[:12], step=act.get("kind"), unmoved=unmoved or None, why=why or None,
                         due=True if unmoved and why in LAND_JUDGE_DUE else None)
            self.note_feed_verdict(e, answer, act, head, judging.get("at"))
            reason = str(answer.get("reason") or "")
            if str(answer.get("code") or "") == "quota" or LAND_QUOTA_REFUSAL.search(reason) \
                    or str(answer.get("code") or "") in LAND_UNREAD_CODES and LAND_UNREAD_QUOTA.search(reason):
                self.park_quota(e, f"{answer.get('reason') or ''} {answer.get('next') or ''}")
                return  # the login's state, not the PR's: no step, no streak
            e.pop("quotaRefusals", None)
            hand = self.unjudgeable_here(e, answer, act, head)
            if hand:
                e["handoffDue"] = {"kind": "judgment", "head": head, "why": hand, "reason": "unreadable here"}
                self.save(e)
        if hand:
            self.hand_off(e, head)  # off the lock, as step_refused's owner hand-off is
            return
        with self.lock:
            if self.unread_repeated(e, answer, head):
                return
            if answer.get("ok") or act.get("kind") in LAND_WAIT_KINDS:
                # A wait on the checks (bounded on its own: checks_stuck) between two waits gives the next its whole
                # deadline. Any other step between keeps the budget: a fetch, repin, review or retarget is bounded by
                # the streak, which each wait clears, so dropping the budget there too left no bound at all (review of
                # glaeda#2180: fetch, retry, fetch, retry... 55 h)
                e.pop("waitBudget", None)
            if answer.get("ok"):
                e["streak"] = None
            elif act.get("kind") in LAND_WAIT_DEADLINE:
                # Another wait: never a strike, a deadline (LAND_WAIT_DEADLINE's comment)
                if self.wait_spent(e, act, answer, head, held):
                    return
            elif act.get("kind") in LAND_WAIT_KINDS:
                # A wait on the checks is taken, never counted toward the identical-refusal stop (LAND_WAIT_STUCK).
                if self.wait_refused(e, head, str(answer.get("code") or "refused"), answer.get("reason"),
                                     answer.get("next")):
                    return
            elif act.get("kind") == "update_branch":
                # The refusal's step is the pinned update (any code: LAND_UPDATE_ONCE's comment): taken, never counted
                # toward the identical-refusal stop. update_branch sends it once per head and bounds the rest.
                pass
            elif self.streak(e, f"{answer.get('code')}|{head}|{act.get('kind')}", act.get("kind") in LAND_RETRY_KINDS,
                             counts):
                self.stop(e, str(answer.get("code") or "refused"),
                          f"{LAND_RETRY_STREAK_STOP if act.get('kind') in LAND_RETRY_KINDS else LAND_STREAK_STOP} identical "
                          f"refusals in a row: {land_reason(answer.get('reason'))}", land_trim(answer.get("next")))
                return
            self.save(e)
        self.take(e, act, answer)

    def unjudgeable_here(self, e: dict, answer: dict, act: dict, head: str) -> str:
        """Under the lock: why this lane VM should hand E at HEAD to the broker host's land queue instead of judging it
        again here, or "". A judgment that read nothing about the PR (LAND_HANDOFF_UNREAD) on a broker
        client: the VM reads GitHub through the broker's upstream, and when that is slow every judgment here costs a
        worker for minutes and reads nothing again. gcp-agent-lane-10, 2026-11-22: manaflow-ai/cmux#48064 at
        1ebd272819aa answered "unreadable" after 5m9s (store 22 s, GraphQL and REST timed out), about 25 green lands
        sat behind such answers, all 8 workers busy, none ever handed off. The broker host judges it with its own
        fresh reads (the same land_judge, nothing skipped) and merges it, or says why not. A host with its own login,
        a cache-only answer, a partial head and quota (park_quota, before this) stay as they were."""
        code = str(answer.get("code") or "")
        if code not in LAND_HANDOFF_UNREAD or answer.get("cacheOnly") or not SHA40.fullmatch(head):
            return ""
        if not self.broker_client() or e.get("state") == LAND_FORWARDED:
            return ""
        return land_trim(f"{code}: {land_reason(answer.get('reason'), 160)}", 200)

    def unread_repeated(self, e: dict, answer: dict, head: str) -> bool:
        """Under the lock, for each judged answer (LAND_UNREAD_SAME_STOP's comment): an "unreadable" one counts its
        text in a row at HEAD and sends the next judgment to the caches first (unreadCacheFirst); the run's
        LAND_UNREAD_SAME_STOP-th stops E naming the read, and True. A cache-only answer, and an answer that judged
        nothing about the PR (LAND_NOT_JUDGED: host_cap, quota, explain_failed), keep the run as it is; any other
        answer ends it."""
        code = str(answer.get("code") or "")
        if answer.get("cacheOnly"):
            return False
        if code in LAND_NOT_JUDGED and code not in LAND_UNREAD_CODES:
            # The host's state between two reads of the PR, not a read that worked: the login was paced out of a pool
            # (host_cap), its quota was spent (quota), or land_judge itself could not run (explain_failed). Ending the
            # run there put the stop out of reach exactly where reads fail most: one paced login, 2026-11-21, 82 host_cap
            # judgments beside 31 unreadable ones; manaflow-ai/cmux#46507 at 5a37519ddc7f answered unreadable at
            # 23:44:03Z and 23:50:00Z with three host_cap answers between 22:24Z and 23:02Z, and its run read 2, not
            # 5, while the same webview read had failed since 22:24Z. park_quota says it for the streak already ("the
            # login's state, not the PR's: no step, no streak"); this run counts reads, so it says the same.
            return False
        if code not in LAND_UNREAD_CODES:
            e.pop("unreadRun", None)
            e.pop("unreadCacheFirst", None)
            return False
        text = land_reason(answer.get("reason"), 200)
        same = re.sub(r"\d+", "#", text)
        run = e.get("unreadRun") or {}
        n = int(run.get("count") or 0) + 1 if run.get("text") == same and run.get("head") == head else 1
        e["unreadRun"] = {"text": same, "head": head, "count": n}
        raised = bool(LAND_UNREAD_RAISED.search(text)) and not LAND_UNREAD_TRANSIENT.search(text)
        if n < LAND_UNREAD_SAME_STOP or not raised:
            if str((answer.get("action") or {}).get("kind") or "retry") == "retry":
                e["unreadCacheFirst"] = head  # a step it names (a fetch) is work: run as named
            return False
        e.pop("unreadCacheFirst", None)
        self.stop(e, "unreadable_repeated", f"the same read could not complete {n} times in a row at "
                  f"{head[:12]}: {text}", land_trim(answer.get("next")) or
                  f"fix the read it names, then glaeda-gh land {e['repo']}#{e['number']}")
        return True

    def streak(self, e: dict, sig: str, retry: bool = False, counts: bool = True) -> bool:
        """Count one refusal; True when it is the one that stops the entry. COUNTS false: the same refusal again
        keeps the count where it was."""
        s = e.get("streak") or {}
        same = s.get("signature") == sig
        s = {"signature": sig, "count": int(s.get("count") or 0) + (1 if counts else 0) if same else 1}
        e["streak"] = s
        return s["count"] >= (LAND_RETRY_STREAK_STOP if retry else LAND_STREAK_STOP)

    def wait_spent(self, e: dict, act: dict, answer: dict, head: str, held: float = 0.0) -> bool:
        """One more judgment naming the wait ACT at HEAD (LAND_WAIT_DEADLINE's comment). Under the lock. It breaks the
        identical-refusal streak and counts toward nothing; True when the wait's budget is spent and E is stopped.
        HELD, the time E sat due and not judged before this judgment, is not counted (LAND_WAIT_HELD)."""
        kind = str(act.get("kind"))
        key = head  # one budget per head, whatever kind of wait (LAND_WAIT_DEADLINE's comment)
        train = LAND_TRAIN_HOLDER.search(str(answer.get("reason") or "")) \
            if str(answer.get("code") or "") == "train_wait" else None
        if train:
            key = f"{head}|train:{train.group(1)}@{train.group(2)}"  # LAND_TRAIN_HOLDER's comment
        size = max(LAND_WAIT_DEADLINE[kind], 2 * land_seconds(act.get("timeout_s"), 0.0, 0.0))
        if kind == "retry" and str(answer.get("code") or "") in LAND_UNREAD_CODES:
            size = max(size, LAND_UNREAD_DEADLINE)  # a read that could not complete (LAND_UNREAD_DEADLINE's comment)
        b = e.get("waitBudget") or {}
        if b.get("key") != key:
            b = {"key": key, "since": self.now, "deadline": size, "n": 0, "held": 0.0}
        else:
            b["held"] = float(b.get("held") or 0.0) + held
        per = dict(b.get("perKind") or {})
        per[kind] = int(per.get(kind) or 0) + 1  # a retry's backoff counts its own kind's judgments only
        b.update(kind=kind, code=str(answer.get("code") or ""), n=int(b.get("n") or 0) + 1, perKind=per,
                 deadline=max(float(b.get("deadline") or 0), size))
        e["waitBudget"] = b
        e["streak"] = None
        waited = self.now - float(b["since"]) - float(b["held"])
        if waited < b["deadline"]:
            return False
        idle = f"; {b['held']:.0f} s due and not judged, not counted" if b["held"] else ""
        self.stop(e, f"{kind}_deadline",
                  f"waited {waited:.0f} s (deadline {b['deadline']:.0f} s, {b['n']} judgments{idle}) at "
                  f"{head[:12] or '?'} "
                  f"for {LAND_WAIT_WHAT[kind]}, still {b['code'] or 'refused'}: {land_reason(answer.get('reason'))}",
                  land_trim(answer.get("next")))
        return True

    def wait_refused(self, e: dict, head: str, code: str, reason: Any, nxt: Any) -> bool:
        """One refusal whose step is a wait on the checks at HEAD (LAND_WAIT_STUCK's comment). Under the lock. It
        breaks the identical-refusal streak and counts toward nothing; True when nothing at HEAD has moved for
        LAND_WAIT_STUCK, and E is stopped naming the checks still unfinished."""
        c = self.cache_of(e["key"]) or {}
        data = c.get("data") or {}
        fp = land_check_fingerprint(c) if str(data.get("headRefOid") or "").lower() == head else ""
        w = e.get("waitRefused") or {}
        if w.get("head") != head:
            w = {"head": head, "since": self.now, "movedAt": self.now, "fp": fp, "count": 0}
        elif fp and fp != w.get("fp"):
            w.update(fp=fp, movedAt=self.now)
        w["count"] = int(w.get("count") or 0) + 1
        w["code"] = code
        e["waitRefused"] = w
        e["streak"] = None
        idle = self.now - float(w.get("movedAt") or self.now)
        self.history(e, "wait_refused", code=code, head=head[:12], n=w["count"], idle=round(idle))
        if idle < LAND_WAIT_STUCK:
            return False
        left = land_unfinished(data, self.now) if fp else ""
        self.stop(e, "checks_stuck", f"no check at {head[:12]} moved in {idle / 3600:.1f} h of waits ({code}, "
                  f"{w['count']} refusals naming a wait); still unfinished: {left or 'none the cache shows'}; "
                  f"{land_reason(reason, 200)}", land_trim(nxt))
        return True

    def claim(self, e: dict, kind: str, **args: Any) -> None:
        """Written before the step starts: a restart sees it and judges again instead of running it on its own."""
        self.check(e)
        e["action"] = {"kind": kind, "claimedAt": self.now, "head": e.get("head"), **args}
        e["state"] = "acting"
        self.save(e)
        self.count(kind)

    def finish(self, e: dict, got: subprocess.CompletedProcess | None, **fields: Any) -> None:
        a = e.get("action") or {}
        last = {**a, "endedAt": self.now, **fields}
        if got is not None:
            # the tail: a refusal and its `next:` come last, after land_judge's notes (cmux#45102's 300-char head
            # held only notes, so nobody could see why its merge failed 27 times)
            last.update(exit=got.returncode, out=land_tail((got.stderr or "") + " " + (got.stdout or ""), 600))
        e["lastAction"] = last
        e["action"] = None
        self.history(e, "step", kind=a.get("kind"), exit=None if got is None else got.returncode)

    def wait(self, e: dict, w: dict, seconds: float | None) -> None:
        self.check(e)
        e["state"] = "waiting"
        e["wait"] = w
        e["wakeAt"] = None if seconds is None else self.now + seconds
        self.save(e)

    def take(self, e: dict, act: dict, answer: dict) -> None:
        kind = act.get("kind")
        repo, number, head = e["repo"], str(e["number"]), e.get("head") or ""
        if act.get("repo") and str(act["repo"]).lower() != repo.lower() or (
                act.get("number") not in (None, "") and str(act.get("number")) != number):
            with self.lock:
                self.stop(e, "policy", f"land_judge's step names {act.get('repo')}#{act.get('number')}, not this PR",
                          land_trim(answer.get("next")))
            return
        if kind == "stop" and act.get("stop") == "own_red" and self.rerun_unrelated(e, act, answer, head):
            return
        if kind in ("stop", "command"):
            why = act.get("why") or answer.get("reason")
            nxt = " ".join(map(str, act["argv"])) if isinstance(act.get("argv"), list) else act.get("text")
            cls = str(act.get("stop") or answer.get("code") or kind)
            if cls in LAND_HOLD_CLAIM_STOPS and self.review_hold_claim(e, head, answer):
                return
            if land_override_takes(e, act, head):
                # LAND_OVERRIDE_TAKES' comment: the requester's override answers this refusal at the head judged now,
                # the queue's own update-branch's head included, as a pinned merge carrying it
                with self.lock:
                    self.history(e, "override_merge", code=cls, head=head[:12], **land_override_history(e))
                self.do_merge(e, head, {**answer, "ok": True, "action": {"v": 1, "kind": "merge", "sha": head}})
                return
            with self.lock:
                self.stop(e, cls, land_reason(why), land_trim(nxt or answer.get("next")))
            return
        if kind == "merge":
            sha = str(act.get("sha") or head).lower()
            if not answer.get("ok") or sha != head:
                with self.lock:
                    self.stop(e, "policy", f"land_judge named a merge at {sha[:12] or '?'} without passing that head "
                              f"(ok={bool(answer.get('ok'))}, judged {head[:12] or '?'})", land_trim(answer.get("next")))
                return
            self.do_merge(e, sha, answer)
            return
        if kind == "update_branch":
            sha = str(act.get("expected_head_sha") or head).lower()
            if not SHA40.fullmatch(sha) or sha != head:
                with self.lock:
                    self.stop(e, "policy", f"update_branch pinned to {sha[:12] or 'nothing'}, not the judged head "
                              f"{head[:12] or '?'}", land_trim(answer.get("next")))
                return
            needs = act.get("needs_newer_base")
            self.update_branch(e, sha, [str(n) for n in needs if str(n)] if isinstance(needs, list) else [])
            return
        if kind == "retarget":
            base = str(act.get("base") or "")
            if not BRANCH_SAFE.fullmatch(base):
                with self.lock:
                    self.stop(e, "policy", f"retarget to an unsafe base name {base!r}", land_trim(answer.get("next")))
                return
            self.push_step(e, "retarget", head, ["pr", "edit", number, "-R", repo, "--base", base], base=base)
            return
        if kind == "fetch":
            self.do_fetch(e, act, answer, head)
            return
        if kind == "rerun_failed":
            runs = [int(r) for r in act.get("runs") or [] if str(r).isdigit()]
            gh = self.gh()
            if not runs or gh is None:
                with self.lock:
                    self.stop(e, "command" if runs else "policy",
                              "no gh-quota shim to rerun through" if runs else "rerun_failed named no run",
                              land_trim(answer.get("next")))
                return
            stale = {r: why for r in runs if (why := self.stale_replay(e, gh, r))}  # STALE_REPLAY_BEHIND's comment
            with self.lock:
                self.check(e)  # a newer land since this judgment: its count is never written onto the new entry
                sent = {k: v for k, v in (e.get("reruns") or {}).items() if k.startswith(f"{head}|")}
                capped = [r for r in runs if int(sent.get(f"{head}|{r}") or 0) >= LAND_RERUN_CAP]
                if capped:
                    self.stop(e, "rerun_failed_cap",
                              f"run {', '.join(map(str, capped))} was rerun {LAND_RERUN_CAP} times at {head[:12]} and "
                              f"is still cancelled: {land_reason(answer.get('reason'))}",
                              f"gh run view {capped[0]} -R {repo}")
                    return
                for r in runs:  # counted before the send: a restart mid-send counts it
                    sent[f"{head}|{r}"] = int(sent.get(f"{head}|{r}") or 0) + 1
                e["reruns"] = sent
                if stale:  # a rerun replays a merge the base has moved past: a pinned base merge instead
                    for r, why in stale.items():
                        self.history(e, "stale_replay", run=r, head=head[:12], why=land_trim(why, 200))
                    self.count("stale_replay")
                    self.save(e)
                else:
                    self.claim(e, "rerun_failed", runs=runs)
                    checks = ((self.cache_of(e["key"]) or {}).get("data") or {}).get("checks") or []
                    marks = land_rerun_marks(checks if isinstance(checks, list) else [], runs)
            if stale:
                self.update_branch(e, head)
                return
            results =[self.call([gh, "run", "rerun", str(r), "--failed", "-R", repo], LAND_GH_DEADLINE, e)
                       for r in runs]
            no_lane = [g for g in results if g.returncode != 0 and LAND_NO_LANE.search(f"{g.stderr} {g.stdout}")]
            with self.lock:
                self.finish(e, results[-1], exits=[g.returncode for g in results])
                for r, g in zip(runs, results):
                    if g.returncode not in (0, 124):  # refused: never sent (a timeout may have reached GitHub)
                        k = f"{head}|{r}"
                        left = int((e.get("reruns") or {}).get(k) or 0) - 1
                        e["reruns"] = {**(e.get("reruns") or {}), k: left}
                        if left <= 0:
                            e["reruns"].pop(k)
                self.nudge(e["key"])
                if no_lane:
                    self.step_refused(e, "rerun_failed", head, no_lane[0])
                    return
                self.wait(e, {"kind": "pr", "sha": head, "why": "reran failed jobs", "rerun": True, "runs": marks},
                          LAND_WAIT_DEFAULT)
            return
        if kind == "review":
            self.do_review(e, head, answer)
            return
        with self.lock:
            if kind == "wait_pr":
                esc = act.get("escalate")
                if isinstance(esc, dict) and esc.get("to") and f"{head}|{esc['to']}" not in e.setdefault("escalated", []):
                    e["escalated"].append(f"{head}|{esc['to']}")
                    self.notify(e, str(esc["to"]), land_trim(f"glaeda land {self.url(e)}: {esc.get('message') or ''}"))
                self.wait(e, {"kind": "pr", "sha": str(act.get("sha") or head).lower(), "until": act.get("until") or "done"},
                          land_seconds(act.get("timeout_s"), LAND_WAIT_DEFAULT))
            elif kind == "wait_run":
                run = str(act.get("run") or "")
                if not run.isdigit():
                    self.stop(e, "policy", "wait_run named no run id", land_trim(answer.get("next")))
                    return
                key = parse_key("run", f"{repo}/{run}")
                self.wait(e, {"kind": "run", "key": key, "run": int(run)}, land_seconds(act.get("timeout_s"),
                                                                                       LAND_WAIT_DEFAULT))
                self.watch_now(key)
            elif kind == "wait_comment":
                key = parse_key("comment", f"{repo}#{number}")
                since = self.now - land_seconds(act.get("since_s"), 0.0, 0.0) if act.get("since_s") else self.now
                self.wait(e, {"kind": "comment", "key": key, "match": str(act.get("match") or "SHIP|BLOCK"),
                              "since": since}, land_seconds(act.get("timeout_s"), LAND_REVIEW_WAIT))
                self.watch_now(key)
            elif kind == "repin":
                sha = str(act.get("sha") or "").lower()
                cached = str(((self.cache_of(e["key"]) or {}).get("data") or {}).get("headRefOid") or "").lower()
                if SHA40.fullmatch(sha) and sha != head:
                    self.wait(e, {"kind": "repin", "sha": sha}, None)
                elif SHA40.fullmatch(sha) and sha == head == cached:
                    # land_judge's judge_again(), its fallback for a refusal with no step of its own: judge this same
                    # head again. Nothing is stale (the cache holds it), so no head_change wait: that one nudged reads
                    # for LAND_HEAD_TIMEOUT for a head that never came, then judged unpinned, a live read with no
                    # snapshot (hq boneheaded-designs §4.2: 816 live reads, 46 snapshot judgments, 2026-11-18).
                    # A retry, pinned at the cached head, backing off; LAND_STREAK_STOP identical answers still stop.
                    n = int((e.get("streak") or {}).get("count") or 1)
                    self.wait(e, {"kind": "retry", "why": "repin at the cached head"},
                              min(LAND_RETRY_MAX, LAND_RETRY_DEFAULT * (2 ** max(0, n - 1))))
                else:  # the cache's head was stale: wait for it to show another, then judge there
                    self.nudge(e["key"])
                    self.wait(e, {"kind": "head_change", "before": head, "since": self.now}, LAND_HEAD_TIMEOUT)
            elif kind == "retry" and answer.get("code") == "host_cap":
                # the pace's next slot, exactly: backed off like a refusal (to LAND_RETRY_MAX) it woke after that slot
                # had gone to an entry judged live meanwhile, every slot (10 entries, 4 slots an hour: 6 never judged
                # live in 8 h)
                self.wait(e, {"kind": "retry", "why": "the pace's next slot"},
                          land_seconds(act.get("after_s"), LAND_RETRY_DEFAULT))
            elif kind == "retry":
                n = int(((e.get("waitBudget") or {}).get("perKind") or {}).get("retry") or 1)
                after = land_seconds(act.get("after_s"), LAND_RETRY_DEFAULT) * (2 ** max(0, n - 1))
                self.wait(e, {"kind": "retry"}, min(LAND_RETRY_MAX, after))
            self.count(kind)

    def stale_replay(self, e: dict, gh: str, run: int | str) -> str:
        """Why a `--failed` rerun of RUN would replay a merge older than the base's fix (stale_replay_why), read through
        the gh-quota shim: the run, the base's newest commit at the run's creation, and its compare to the base now.
        "" (rerun as before) for anything else, every failed or unusable read included."""
        repo = e["repo"]

        def read(path: str, jq: str) -> str:
            got = self.call([gh, "api", path, "--jq", jq], LAND_GH_DEADLINE)
            if got.returncode != 0:
                raise RuntimeError(f"gh api {path}: exit {got.returncode}")
            return (got.stdout or "").strip()

        def base_then(ref: str, created: str) -> str:
            q = urllib.parse.urlencode({"sha": ref, "until": created, "per_page": 1})
            return read(f"repos/{repo}/commits?{q}", '.[0].sha // ""')

        def compare(that: str, ref: str) -> dict:
            return json.loads(read(f"repos/{repo}/compare/{that}...{urllib.parse.quote(ref, safe='')}",
                                   "{status, ahead_by, files: [.files[]?.filename]}"))

        try:
            doc = json.loads(read(f"repos/{repo}/actions/runs/{int(run)}",
                                  "{id, event, created_at, pull_requests: [.pull_requests[]? | {base: {ref: .base.ref}}]}"))
        except (RuntimeError, ValueError, TypeError):
            return ""
        data = (self.cache_of(e["key"]) or {}).get("data") or {}
        return stale_replay_why(doc, base_then, compare, default_base=str(data.get("baseRefName") or ""))

    def rerun_unrelated(self, e: dict, act: dict, answer: dict, head: str) -> bool:
        """An own_red stop whose red is in a job the PR's changed paths cannot affect (LAND_UNRELATED_REDS): one
        `gh run rerun RUN --failed` per (head, run), kept on the entry before it is sent, then a wait on the PR's
        checks at HEAD. A job its runner refused at setup (merge_hold: "it gets re-run, never excused") takes the
        same one rerun with no inert-path rule: no change makes a runner refuse a job; so does a job its step's SIGTERM
        ended with no failing test (LAND_SIGTERM_RED). True when it took that step;
        False: the stop goes ahead, as before."""
        repo, number = e["repo"], str(e["number"])
        data = (self.cache_of(e["key"]) or {}).get("data") or {}
        checks = data.get("checks") if isinstance(data.get("checks"), list) else []
        head_ok = bool(SHA40.fullmatch(head)) and str(data.get("headRefOid") or "").lower() == head
        flow, run, why = land_own_red(answer, act, checks, head_ok)
        said = f"{answer.get('reason') or ''} {act.get('why') or ''}"
        stopped = "refused at setup by its runner" if LAND_SETUP_REFUSED in said else (
            "stopped by SIGTERM with no failing test" if (first := LAND_OWN_RED_JOB.search(said))
            and said[first.end():].startswith(LAND_SIGTERM_RED) else "")
        setup = bool(run) and bool(stopped)
        rule = land_unrelated_rule(repo, flow, self.config()) if run and not setup else None
        if run and rule is None and not setup:
            why = f"workflow '{flow}' has no inert-path rule, so the change can affect it"
        take, files = setup or rule is not None, []
        done = f"{head}|{run}"
        if take and done in (e.get("unrelatedReruns") or []):
            take, why = False, f"run {run} was already rerun once at {head[:12]}"
        gh = self.gh() if take else None
        if take and gh is None:
            take, why = False, "no gh-quota shim to read the PR's files through"
        if take and rule is not None:
            # One JSON string per file, so a name keeps its exact characters (#2132 review F1: a stripped
            # " webviews/a.ts" matched an inert glob its real name does not)
            got = self.call([gh, "api", f"repos/{repo}/pulls/{number}/files?per_page=100", "--paginate",
                             "--jq", ".[].filename | @json"], LAND_GH_DEADLINE)
            files = land_file_names(got.stdout or "")
            if got.returncode != 0 or not files or len(files) >= LAND_FILES_MAX:
                take, why = False, (f"the PR's file list could not be read whole (exit {got.returncode}, "
                                   f"{len(files)} files)")
            elif touched := [f for f in files if not land_path_inert(f, rule)]:
                take, why = False, f"it changes {land_trim(touched[0], 160)}, which '{flow}' can read"
        stale = self.stale_replay(e, gh, run) if take and gh is not None else ""  # STALE_REPLAY_BEHIND's comment
        with self.lock:
            self.check(e)
            if not take:
                self.history(e, "no_unrelated_rerun", why=land_trim(why, 200))
                return False
            e["unrelatedReruns"] = [*(e.get("unrelatedReruns") or []), done][-LAND_UNRELATED_KEEP:]
            self.history(e, "unrelated_red", run=run, workflow=flow, files=len(files),
                         **({"why": stopped} if setup else {}))
            if stale:  # a rerun replays a merge the base has moved past: a pinned base merge instead
                self.history(e, "stale_replay", run=run, head=head[:12], why=land_trim(stale, 200))
                self.count("stale_replay")
                self.save(e)
            else:
                self.claim(e, "rerun_failed", runs=[run], unrelated=True)
        if stale:
            self.update_branch(e, head)
            return True
        got = self.call([gh, "run", "rerun", str(run), "--failed", "-R", repo], LAND_GH_DEADLINE, e)
        with self.lock:
            self.finish(e, got)
            if got.returncode != 0:  # refused: the stop goes ahead, naming the red as before
                self.history(e, "no_unrelated_rerun", why=land_trim(f"the rerun of run {run} failed: "
                                                                   f"{got.stderr or got.stdout}", 200))
                return False
            self.nudge(e["key"])
            self.wait(e, {"kind": "pr", "sha": head, "rerun": True, "runs": land_rerun_marks(checks, [run]),
                          "why": f"reran run {run}, " + (f"a job {stopped}" if setup
                                                         else "a red the change cannot affect")}, LAND_WAIT_DEFAULT)
        return True

    def push_step(self, e: dict, kind: str, head: str, args: list[str], **extra: Any) -> None:
        """A step that makes GitHub change the PR (update-branch, a base change): run it, then wait for the cache to
        show a head other than the one before it."""
        gh = self.gh()
        if gh is None:
            with self.lock:
                self.stop(e, "no_shim", f"no gh-quota shim at {self.path('gh', LAND_GH)}; {kind} is not sent around it",
                          "install the gh-quota shim (tools/host-baseline) or set gh in ~/.config/glaeda/land.json")
            return
        with self.lock:
            self.claim(e, kind, before=head, **extra)  # may raise LandCancelled (draining, a newer land): nothing sent
            if kind == "update_branch":
                e["updateSent"] = {"head": head, "at": self.now}  # a restart mid-send counts as sent (load)
                self.save(e)
        got = self.call([gh, *args], LAND_GH_DEADLINE, e)
        named = None
        with self.lock:
            if kind == "update_branch" and got.returncode not in (0, 124):
                # refused: not sent; step_refused counts and backs off its retries. A timeout (124) may have reached
                # GitHub: it stays sent.
                e.pop("updateSent", None)
            self.finish(e, got)
            e["preStepHead"] = head if got.returncode == 0 else ""
            if got.returncode == 0:
                e.pop("stepFail", None)
                e.pop("stepTransient", None)
            if got.returncode == 0 and kind == "update_branch":
                self.nudge(e["key"])
                self.wait(e, {"kind": "head_change", "before": head, "since": self.now}, LAND_HEAD_TIMEOUT)
            elif got.returncode == 0:
                self.nudge(e["key"])
                self.wait(e, {"kind": "retry"}, NUDGE_MIN * 3)  # a base change: judged again once the cache reads it
            else:
                # Refused at this head (moved, nothing to update, or a broker that cannot run this form): the refusal's
                # own next step, else a backoff that doubles, and a stop at LAND_STEP_STOP (step_refused).
                self.nudge(e["key"])
                named = self.step_refused(e, kind, head, got)
        if named == "hand_off":
            self.hand_off(e, head)
        elif named == "update_branch" and kind != "update_branch":
            self.update_branch(e, head)

    def do_fetch(self, e: dict, act: dict, answer: dict, head: str) -> None:
        """Fill this host's mirror as land_judge named (LAND_FETCH_DEADLINE's comment), then judge again soon. An argv
        that is not one of the two shapes, for this PR's repository and an existing mirror, stops as policy."""
        repo, argv = e["repo"], act.get("argv")
        form, mirror, why = land_fetch_shape(argv, repo)
        if not why and not os.path.isdir(mirror):
            why = f"the fetch step's mirror {mirror} is not a directory on this host"
        git = self.path("git", Path(shutil.which("git") or "/usr/bin/git")).as_posix()
        if not why:  # both forms write into the mirror: its origin must be this PR's repository
            got = self.call([git, "--git-dir", mirror, "config", "--get", "remote.origin.url"],
                            LAND_FETCH_CONFIG_DEADLINE)
            origin = land_fetch_origin(got.stdout or "") if got.returncode == 0 else ""
            if origin.lower() != repo.lower():
                why = (f"the mirror {mirror}'s origin is {land_trim(got.stdout, 120) or 'unreadable'}, "
                       f"not github.com/{repo}")
        if why:
            with self.lock:
                self.stop(e, "policy", land_trim(why), land_trim(answer.get("next")))
            return
        if form == "git":  # this host's own git login reads github.com: the bare env
            run, step_env = [git, *argv[1:]], None
        else:  # a broker read: the requester's lane only names it in the broker's audit log (land_lane)
            run, step_env = [self.path("laneGh", Path(LANE_GH_CMD)).as_posix(), *argv[1:]], e
        with self.lock:
            self.claim(e, "fetch", argv=list(argv), form=form)
        got = self.call(run, LAND_FETCH_DEADLINE, step_env)
        named = None
        with self.lock:
            self.finish(e, got)
            self.nudge(e["key"])
            if got.returncode == 0:
                e.pop("stepFail", None)
                e.pop("stepTransient", None)
                self.wait(e, {"kind": "retry", "why": "filled the mirror land_judge could not read"}, NUDGE_MIN * 3)
            else:
                named = self.step_refused(e, "fetch", head, got)
        if named == "update_branch":
            self.update_branch(e, head)

    def update_branch(self, e: dict, head: str, needs: list[str] | None = None) -> None:
        """The pinned base merge land_judge (or a refused step) named, unless the head's checks still run: an update
        while the last one's CI runs only restarts that CI (2026-11-17: 524 update-branch steps in a day). Waits on the
        cache (an event wait, no explain) instead. An update at a head that an update of this queue made, after its
        checks finished, is the base moving during CI: counted in history as update_again."""
        repo, number = e["repo"], str(e["number"])
        sent = e.get("updateSent") or {}
        if head and sent.get("head") == head:
            # Once per head (LAND_UPDATE_ONCE's comment): never a second update at this head. Wait for the new head
            # it makes; with none by the bound, stop and say so.
            waited = self.now - float(sent.get("at") or 0)
            with self.lock:
                if waited >= LAND_UPDATE_ONCE:
                    self.stop(e, "update_branch_no_new_head",
                              f"the update-branch sent at {head[:12]} {waited:.0f} s ago made no new head the queue "
                              "could read; it is sent once per head",
                              f"glaeda-gh status pr {repo}#{number}")
                    return
                self.history(e, "update_once", head=head[:12], why="already sent at this head: waiting for the new one")
                self.nudge(e["key"])
                self.wait(e, {"kind": "head_change", "before": head, "since": self.now}, LAND_UPDATE_ONCE - waited)
            return
        data = (self.cache_of(e["key"]) or {}).get("data") or {}
        held = e.get("updateDeferred") or {}
        stuck = held.get("head") == head and self.now - float(held.get("at") or 0) >= LAND_WAIT_DEFAULT
        if land_checks_running(data, head) and not stuck:
            # Deferred once per head. A check still running after the whole wait never finishes (stuck, no runner):
            # deferring again only re-judges it into the identical-refusal stop with the named update never sent
            # (cmux#44800 stale_green, cmux#45380 tip_merge, 2026-11-17: both stopped, a person updated them).
            with self.lock:
                if held.get("head") != head:
                    e["updateDeferred"] = {"head": head, "at": self.now}
                self.history(e, "update_deferred", head=head[:12], why="checks still running at the head")
                self.wait_running(e, head, land_fingerprint(self.cache_of(e["key"])))
            return
        if stuck:
            with self.lock:
                self.history(e, "update_past_stuck", head=head[:12],
                             why=f"checks still running {LAND_WAIT_DEFAULT:.0f} s after the update was deferred")
        e.pop("updateDeferred", None)
        if head and head == e.get("updatedHead"):
            with self.lock:
                self.history(e, "update_again", head=head[:12], why="the base moved during this update's CI")
        self.push_step(e, "update_branch", head,
                       land_update_branch_args(repo, number, head, list(needs or []), self.broker_client()))

    def step_refused(self, e: dict, kind: str, head: str, got: subprocess.CompletedProcess) -> str | None:
        """KIND, the step land_judge named, failed at HEAD (LAND_STEP_BACKOFF's comment). Under the lock. Waits or
        stops the entry; answers "update_branch" when the refusal names that step and the caller should take it now."""
        out = f"{got.stderr or ''}\n{got.stdout or ''}"
        if LAND_NO_LANE.search(out):
            self.history(e, "step_refused", kind=kind, head=head[:12], why="no lane", n=1)
            self.stop(e, "no_lane", f"the {kind} at {head[:12]} was refused before the broker: "
                      f"{land_trim(land_tail(out), 200)} (lane named: {land_lane(e) or 'none'})",
                      f"from the PR's lane session on {policy_host()}: glaeda-gh land {key_name(e['key'])}")
            return None
        if kind in LAND_HANDOFF_KINDS and LAND_NOT_OWNER.search(out) and self.broker_client():
            return self.owner_refused(e, kind, head, out)
        if LAND_STEP_QUOTA.search(out):
            self.park_quota(e, out)  # the login's state, not the PR's: parked, never counted toward a stop
            e["stepQuotaParked"] = True  # so the judgment after the reset does not count toward a stop either
            self.save(e)
            return None
        if LAND_STEP_DRAFT.search(out):
            # Permanent until someone marks it ready (LAND_STEP_DRAFT's comment): one refusal, one named step.
            self.history(e, "step_refused", kind=kind, head=head[:12], why="draft", n=1)
            name = key_name(e["key"])
            repo, _, number = name.partition("#")
            self.stop(e, f"{kind}_draft", f"the {kind} at {head[:12]} was refused while the PR is a draft: "
                      f"{land_trim(land_tail(out), 200)}",
                      f"gh pr ready {number} -R {repo}, then glaeda-gh land {name}")
            return None
        if LAND_STEP_CONFLICT.search(out) and not land_step_named(out):
            # Permanent at this head (LAND_STEP_CONFLICT's comment): one refusal, and the stop names the one step.
            # A conflict refusal that names a step this queue runs (an update-branch that could still merge the base
            # in, a wait) keeps its old path: the named step is taken, as before.
            self.history(e, "step_refused", kind=kind, head=head[:12], why="conflict", n=1)
            name = key_name(e["key"])
            repo, _, number = name.partition("#")
            self.stop(e, f"{kind}_conflict", f"the {kind} at {head[:12]} was refused for a merge conflict between the "
                      f"base and the head: {land_trim(land_tail(out), 200)}",
                      f"resolve the conflict: rebase the PR's branch onto its base (gh pr checkout {number} -R {repo}; "
                      f"git rebase origin/<its base>; git push --force-with-lease), then re-land it pinned to the new "
                      f"head: glaeda-gh land {name} --match-head-commit <the new 40-hex head>")
            return None
        if LAND_STEP_CLOSED.search(out) and e.get("stateOpen") != head:
            # GitHub says the PR is closed: no refusal counted, its state read before anything else (state_first).
            e["closedSeen"] = {"kind": kind, "head": head, "at": self.now, "why": land_trim(land_tail(out), 200)}
            self.history(e, "step_closed", kind=kind, head=head[:12], why=land_step_class(out))
            self.wait(e, {"kind": "retry", "why": f"{kind} refused: GitHub says the PR is closed; its state is read "
                          "next"}, float(NUDGE_MIN))
            return None
        cls = land_step_class(out)
        if got.returncode == 124 or LAND_STEP_TRANSIENT.search(out):
            # A timeout or a 5xx: never counted toward LAND_STEP_STOP (LAND_STEP_TRANSIENT's comment)
            last = e.get("stepTransient") or {}
            n = int(last.get("count") or 0) + 1 if last.get("head") == head else 1
            e["stepTransient"] = {"head": head, "kind": kind, "count": n, "at": self.now}
            self.history(e, "step_refused", kind=kind, head=head[:12], why=cls, n=0, transient=n)
            if n >= LAND_RETRY_STREAK_STOP:
                self.stop(e, f"{kind}_transient", f"the {kind} land_judge named timed out or met a GitHub 5xx {n} "
                          f"times in a row at {head[:12]}: {land_trim(land_tail(out), 300)}",
                          f"none: it is re-armed by itself (at most {LAND_REARM_CAP} times a day)")
                return None
            after = min(LAND_STEP_BACKOFF_MAX, LAND_STEP_BACKOFF * (2 ** (n - 1)))
            self.wait(e, {"kind": "retry", "why": f"{kind} at {head[:12]} transient ({cls}): backoff {after:.0f} s"},
                      after)
            return None
        # Every kind's refusals count per head whatever their words: the judgment's streak no longer bounds them
        # (LAND_UPDATE_ONCE), so a refusal whose text varies must not restart the count. The rule was written for
        # update_branch and is not special to it -- what reaches here is a non-transient refusal at a head that has
        # not moved (a timeout or 5xx is counted above and never lands here; draft, conflict and closed are answered
        # above), and no wording of such a refusal is progress. Keying the count on land_step_class as well let two
        # classes alternating at one head reset each other, so neither ever reached LAND_STEP_STOP.
        # efficiency-standing-lane, 2026-11-21: teamleaderleo/glaeda#2320 sat at 5f640aea6348 taking 13 merge calls,
        # each after its own full judgment, over 2h20m -- the designed bound is 6. Its refusals alternated "To have
        # the pull request merged after all the requirements have been met, add the `--auto` flag." (11 of them) with
        # "GraphQL: Pull Request has merge conflicts (mergePullRequest)" (2), and each conflict refusal restarted the
        # --auto count from n=1: the n sequence read 1,2, 1, 1,2,3, 1, 1,2,3,4,5,6. Seven of the thirteen merge calls
        # and their judgments bought nothing a prior one had not already answered.
        # The exception is a refusal that asks in its own words to be tried again (LAND_STEP_RETRYABLE): a held lease
        # or a busy broker App is a queue in front of this step, not an answer about the head, and alternating ones
        # must keep the entry waiting rather than stop it (glaeda#2239's router review). Those keep a count of their
        # own class, as every refusal here used to.
        sig = f"{kind}|{head}|{cls}" if LAND_STEP_RETRYABLE.search(out) else f"{kind}|{head}"
        named = land_step_named(out)
        if named and named["kind"] == "wait_pr":
            # Its next is a wait on the checks: taken, never counted toward LAND_STEP_STOP (LAND_WAIT_STUCK bounds it).
            self.history(e, "step_refused", kind=kind, head=head[:12], why=cls, n=0)
            if self.wait_refused(e, head, cls, land_tail(out, 300), land_tail(out, 200)):
                return None
            self.history(e, "refusal_named", step="wait_pr")
            self.wait(e, {"kind": "pr", "sha": head, "until": "done", "why": f"{kind} refused: its next is a wait"},
                      land_seconds(named.get("timeout_s"), LAND_WAIT_DEFAULT))
            return None
        last = e.get("stepFail") or {}
        n = int(last.get("count") or 0) + 1 if last.get("sig") == sig else 1
        e["stepFail"] = {"sig": sig, "kind": kind, "head": head, "class": cls, "count": n, "at": self.now}
        self.history(e, "step_refused", kind=kind, head=head[:12], why=cls, n=n)
        if n >= LAND_STEP_STOP:
            # A stop with an empty `next:` ends nobody's hold: the row sits until a person happens to read it. The
            # refusal's own words are the next step when it names a step this queue runs; when it names none, the
            # step that can end this hold is still nameable -- read what GitHub still requires at this head, clear
            # it, and re-land pinned to whatever head that leaves. glaeda#2320's stop carried "" for 95 min.
            # `--admin` is never the step: routing around a refused merge is forbidden (the rulebook's Safety rule),
            # and GitHub's own `--auto` hint is not it either -- auto-merge would merge it later unattended, which
            # is the opposite of handing the row back to its requester.
            name = key_name(e["key"])
            self.stop(e, f"{kind}_refused", f"the {kind} land_judge named was refused {n} times in a row at "
                      f"{head[:12]} (last: {cls}): {land_trim(land_tail(out), 300)}",
                      land_trim(land_tail(out), 200) if named
                      else (f"read what GitHub still requires at this head and clear it (a review, a required "
                            f"check, a branch rule -- never --admin): glaeda-gh status pr {name}; then re-land it "
                            f"pinned: glaeda-gh land {name} --match-head-commit <its 40-hex head then>"))
            return None
        if named and named["kind"] == "update_branch" and kind != "update_branch":
            self.history(e, "refusal_named", step="update_branch")
            return "update_branch"
        after = min(LAND_STEP_BACKOFF_MAX, LAND_STEP_BACKOFF * (2 ** (n - 1)))
        self.wait(e, {"kind": "retry", "why": f"{kind} refused at the same head ({cls}): backoff {after:.0f} s"}, after)
        return None

    def owner_refused(self, e: dict, kind: str, head: str, out: str) -> str | None:
        """KIND at HEAD was refused by the broker's owner check (LAND_NOT_OWNER). Under the lock. "hand_off" when the
        caller should hand the entry to the broker host's land queue now (hand_off, off the lock); None when this head
        was handed off before (the entry is left forwarded again, with no second call)."""
        why = land_trim(LAND_NOT_OWNER.search(out).group(0), 200)
        self.history(e, "owner_refused", kind=kind, head=head[:12], why=why)
        done = e.get("handedOff") or {}
        if done.get("head") == head and done.get("key") == e["key"]:
            e.update(state=LAND_FORWARDED, wait=None, wakeAt=None, action=None, forwardedTo=done.get("host") or "")
            self.history(e, "handed_off_before", head=head[:12], to=done.get("host") or "")
            self.save(e)
            return None
        e["handoffDue"] = {"kind": kind, "head": head, "why": why}
        self.save(e)
        return "hand_off"

    def hand_off(self, e: dict, head: str) -> None:
        """Hand E at HEAD to the broker host's land queue (`lane-gh call land_handoff`), after its owner check refused a
        step here (owner_refused) or this VM could not judge it (unjudgeable_here). Taken: the entry is forwarded, the requester told. Refused: counted per head like a
        step's refusal (backoff, then a stop at LAND_STEP_STOP)."""
        due = e.get("handoffDue") or {}
        reason = str(due.get("reason") or "ownership")
        if due.get("kind") == "judgment":
            what = f"this VM could not judge it at {head[:12]} ({due.get('why') or reason})"
        else:
            what = f"the broker refused this lane's {due.get('kind') or 'step'} at {head[:12]} ({due.get('why') or reason})"
        args: dict[str, Any] = {"number": int(e["number"]), "sha": head}
        requester = str(e.get("requester") or "")
        if requester.startswith(f"{policy_host()}/"):
            args["requester"] = requester  # the broker takes only a session on this VM; else it tells the VM's lane
        lane_gh = self.path("laneGh", Path(LANE_GH_CMD)).as_posix()
        with self.lock:
            self.claim(e, "hand_off", head=head)
        got = self.call([lane_gh, "call", LAND_HANDOFF_TOOL, e["repo"], json.dumps(args, sort_keys=True)],
                        LAND_HANDOFF_DEADLINE, e)
        # `lane-gh call` prints the broker's whole envelope ({"ok", "status", "data"}) as indented JSON over many lines
        # (tools/lane-gh main: json.dumps(answer, indent=1)): the whole stdout is one document.
        envelope: Any = None
        with contextlib.suppress(ValueError):
            envelope = json.loads(got.stdout or "")
        doc = envelope.get("data") if isinstance(envelope, dict) else None
        taken = got.returncode == 0 and isinstance(envelope, dict) and envelope.get("ok") is True \
            and not envelope.get("error") and isinstance(doc, dict) and doc.get("ok") is True
        with self.lock:
            self.finish(e, got)
            if taken:
                host = str(doc.get("host") or "the broker host")
                e.pop("handoffDue", None)
                e.pop("handoffFail", None)
                e["handedOff"] = {"key": e["key"], "head": head, "host": host, "at": self.now,
                                  "request": str(doc.get("request") or "")}
                e.update(state=LAND_FORWARDED, wait=None, wakeAt=None, action=None, forwardedTo=host)
                self.history(e, "handed_off", to=host, head=head[:12], why=reason)
                self.save(e)
                self.notify(e, requester, f"glaeda land: {self.url(e)} handed to {host}: {what}; {host}'s land queue judges it (land_judge) and merges it, or says why not "
                            f"(glaeda-gh land status there)", wake=False)
                return
            said = land_tail(f"{got.stderr or ''} {got.stdout or ''}", 300) or f"exit {got.returncode}"
            last = e.get("handoffFail") or {}
            n = int(last.get("count") or 0) + 1 if last.get("head") == head else 1
            e["handoffFail"] = {"head": head, "count": n, "at": self.now, "why": said}
            self.history(e, "handoff_refused", head=head[:12], why=land_trim(said, 160), n=n)
            if n >= LAND_STEP_STOP:
                self.stop(e, "handoff_refused", f"{what}, and handing it to the broker host's "
                          f"land queue was refused {n} times: {said}",
                          f"the PR's owner lane lands it, or from a host with its own login: glaeda-gh land "
                          f"{key_name(e['key'])}")
                return
            after = min(LAND_STEP_BACKOFF_MAX, LAND_STEP_BACKOFF * (2 ** (n - 1)))
            self.wait(e, {"kind": "retry", "why": f"the hand-off to the broker host's land queue was refused: "
                          f"backoff {after:.0f} s"}, after)

    def broker_land(self, e: dict, sha: str) -> subprocess.CompletedProcess:
        """A lane VM's pinned merge of E at SHA, sent straight to the broker's land (`lane-gh call land`), as a gh
        merge's (rc, stdout, stderr): rc 0 only when the broker's envelope and its data both say ok, else the broker's
        words on stderr, so the step's quota park (LAND_STEP_QUOTA) and owner hand-off (LAND_NOT_OWNER) read them as
        they read gh's. The broker judges the merge itself (merge_hold on its host) before it merges, and this queue
        judged it ok at SHA just before: the VM's gh would run a third, local merge_hold pass in between. lw#5963 at
        6f74ddb7, gcp-agent-lane-1, 2026-11-19: judged ok 23:47:37Z, and its `gh pr merge` ran the shim's full
        merge_hold pass again for 202 s before the broker's land answered 409 "REST rate limit is spent for login
        until 00:38Z": the window was gone inside its own merge step."""
        lane_gh = self.path("laneGh", Path(LANE_GH_CMD)).as_posix()
        args: dict[str, Any] = {"number": int(e["number"]), "sha": sha}
        extra = land_override_env(e)
        if extra:  # lane-gh land's own override, which the broker's land_judge reads (and logs) on its host
            args["override"] = {"reason": extra["LAND_JUDGE_OVERRIDE"], "receipt": extra["LAND_JUDGE_OVERRIDE_RECEIPT"]}
        got = self.call([lane_gh, "call", LAND_BROKER_MERGE_TOOL, e["repo"], json.dumps(args, sort_keys=True)],
                        LAND_MERGE_DEADLINE, e, extra)
        envelope: Any = None
        with contextlib.suppress(ValueError):
            envelope = json.loads(got.stdout or "")
        doc = envelope.get("data") if isinstance(envelope, dict) else None
        if got.returncode == 0 and isinstance(envelope, dict) and envelope.get("ok") is True \
                and not envelope.get("error") and (not isinstance(doc, dict) or doc.get("ok") is not False):
            return subprocess.CompletedProcess(got.args, 0, got.stdout, got.stderr)
        why = envelope.get("error") if isinstance(envelope, dict) else ""
        if not why and isinstance(doc, dict):
            why = doc.get("error") or doc.get("reason") or ""
        said = "\n".join(str(w).strip() for w in (got.stderr, why) if str(w or "").strip()) \
            or f"lane-gh call land: exit {got.returncode}"
        # The decoded refusal last, with no envelope in stdout: land_step_class names a refusal with no `refused [code`
        # by its last line, which for the indented envelope was `}`, so two different refusals (a lease busy, read
        # Apps busy) read as one, and six alternating ones stopped the entry (router review of glaeda#2239, F1).
        return subprocess.CompletedProcess(got.args, got.returncode or 1, "", said)

    def do_merge(self, e: dict, sha: str, answer: dict) -> None:
        if not SHA40.fullmatch(sha):
            with self.lock:
                self.stop(e, "policy", f"land_judge said merge but named no full head ({sha!r})", "")
            return
        if answer.get("pinned", True) and e.get("preStepHead") == sha \
                and (e.get("lastAction") or {}).get("kind") == "update_branch":
            # Pinned to the head read before update-branch: wait for the new one instead.
            with self.lock:
                self.history(e, "stale_pin", head=sha[:12])
                self.nudge(e["key"])
                self.wait(e, {"kind": "head_change", "before": sha, "since": self.now}, LAND_HEAD_TIMEOUT)
            return
        gh = self.gh()
        if gh is None:
            with self.lock:
                self.stop(e, "no_shim", f"no gh-quota shim at {self.path('gh', LAND_GH)}: a merge is never sent past "
                          "land_judge", "install the gh-quota shim (tools/host-baseline) or set gh in "
                          "~/.config/glaeda/land.json")
            return
        repo, number = e["repo"], str(e["number"])
        with self.lock:
            self.claim(e, "merge", sha=sha)
        if self.broker_client():
            got = self.broker_land(e, sha)
        else:
            got = self.call([gh, *land_merge_argv(answer, repo, number, sha)],
                            LAND_MERGE_DEADLINE, e, land_override_env(e))  # the shim's land_judge reads the override
        said = f"{got.stderr or ''} {got.stdout or ''}"
        if got.returncode != 0 and LAND_STEP_QUOTA.search(said):
            with self.lock:  # the shim's land_judge judged it on a spent quota: parked, and no `pr view` after it
                self.finish(e, got)
                self.park_quota(e, said)
                e["stepQuotaParked"] = True
                self.save(e)
            return
        view = self.call([gh, "pr", "view", number, "-R", repo, "--json", "state,mergeCommit,headRefOid"],
                         LAND_GH_DEADLINE)
        state, merge_sha = "", ""
        with contextlib.suppress(ValueError, AttributeError):
            doc = json.loads(view.stdout or "")
            state = str(doc.get("state") or "")
            merge_sha = str((doc.get("mergeCommit") or {}).get("oid") or "")
        with self.lock:
            self.finish(e, got, verified=state)
            if state == "MERGED":
                self.merged(e, merge_sha, "merged pinned")
                return
            if self.ended(e, state, merge_sha, "the read after its merge shows it"):
                return  # CLOSED: closed unmerged, no refusal counted
            self.nudge(e["key"])
            if got.returncode == 0 and not state:
                self.wait(e, {"kind": "retry", "why": "merged? the cache will say"}, LAND_RETRY_DEFAULT)
                return
            named = self.step_refused(e, "merge", sha, got)
        if named == "hand_off":
            self.hand_off(e, sha)
        elif named == "update_branch":
            self.update_branch(e, sha)

    def review_hold_claim(self, e: dict, head: str, answer: dict) -> bool:
        """A chat or iOS hold whose PR body claims a release (a Chat-hold: or iOS-hold: line) passes only with a SHIP
        at the head confirming that claim, and the queue reviews once per head: a claim written or changed after the
        head's review was never confirmed, and the entry stopped (cmux#45558, 2026-11-17). Reviews again once per
        (head, claim lines); True when it did, False to let the stop stand (no claim, the body unread, or reviewed)."""
        gh = self.gh()
        if gh is None or not SHA40.fullmatch(head or ""):
            return False
        got = self.call([gh, "pr", "view", str(e["number"]), "-R", e["repo"], "--json", "body", "--jq", ".body"],
                        LAND_HOLD_BODY_DEADLINE, e)
        claims = land_hold_claims(got.stdout or "") if got.returncode == 0 else ""
        if not claims:
            return False
        key = f"{head}|{hashlib.sha256(claims.encode()).hexdigest()[:12]}"
        if key in e.get("reviewed", []):
            return False
        with self.lock:
            self.history(e, "hold_claim_review", head=head[:12], claims=land_trim(claims, 160))
        self.do_review(e, head, answer, key=key)
        return True

    def do_review(self, e: dict, head: str, answer: dict, key: str = "") -> None:
        """router-review R N --post, at most once per head (claimed before it starts), detached; then wait for its
        receipt comment. KEY (default the head) is what counts as reviewed: review_hold_claim's adds the claim."""
        repo, number = e["repo"], str(e["number"])
        key = key or head
        with self.lock:
            if key in e.setdefault("reviewed", []):
                self.history(e, "review_already_run", head=head[:12])
            elif self.gh() is None:
                self.stop(e, "no_shim", f"no gh-quota shim at {self.path('gh', LAND_GH)}; router-review --post is not "
                          "run around it", f"router-review {repo} {number} --post")
                return
            else:
                rr, tried = land_router_review(self.config())
                if rr is None:
                    self.stop(e, "review_cannot_start",
                              "router-review is not at any of " + ", ".join(map(os.fspath, tried)),
                              f'set "routerReview" in {LAND_CONFIG} to router-review\'s path, then '
                              f"router-review {repo} {number} --post")
                    return
                e["reviewed"] = (e["reviewed"] + [key])[-10:]  # saved by the claim: a restart never posts it twice
                self.claim(e, "review", head=head)
                logs = land_dir() / "logs"
                logs.mkdir(parents=True, exist_ok=True, mode=0o700)
                try:
                    with open(logs / f"review-{repo.replace('/', '_')}-{number}-{head[:12]}.log", "ab") as sink:
                        subprocess.Popen([os.fspath(rr), repo, number, "--post"], stdin=subprocess.DEVNULL,
                                         stdout=sink, stderr=subprocess.STDOUT, env=self.env(e), start_new_session=True,
                                         close_fds=True, cwd=os.environ.get("HOME") or "/")
                    self.finish(e, None, started=True)
                except OSError as error:
                    e["reviewed"] = [h for h in e["reviewed"] if h != key]
                    why, nxt = land_review_start_failure(error, rr)
                    self.finish(e, None, error=why)
                    self.stop(e, "review_cannot_start", why,
                              f"{nxt}; or run the review by hand: router-review {repo} {number} --post")
                    return
            key = parse_key("comment", f"{repo}#{number}")
            self.wait(e, {"kind": "comment", "key": key, "match": "SHIP|BLOCK", "since": self.now}, LAND_REVIEW_WAIT)
            self.watch_now(key)

    # -- ends

    @staticmethod
    def url(e: dict) -> str:
        return f"https://github.com/{e['repo']}/pull/{e['number']}"

    def merged(self, e: dict, merge_sha: str, how: str) -> None:
        e.update(state="merged", mergeSha=merge_sha, wait=None, wakeAt=None, action=None)
        self.history(e, "merged", sha=merge_sha, how=how)
        self.save(e)
        self.notify(e, e.get("requester") or "",
                    f"glaeda land: {self.url(e)} merged" + (f" at {merge_sha}" if merge_sha else ""))

    def ended(self, e: dict, state: str, merge_sha: str, how: str) -> bool:
        """Under the lock. A PR that reads MERGED or CLOSED ends its entry (LAND_STEP_CLOSED's comment): merged with
        MERGE_SHA, or stopped "closed unmerged" naming no step. True when it ended."""
        if state == "MERGED":
            self.merged(e, merge_sha or e.get("mergeSha") or "", f"{how} merged")
            return True
        if state == "CLOSED":
            self.stop(e, "closed", f"closed unmerged ({how} closed)", "")
            return True
        return False

    def read_state(self, e: dict) -> tuple[str, str, str]:
        """One read of the PR's state through the gh shim (or the broker's gh): (state, merge commit, why not), state
        empty when it could not be read."""
        gh = self.gh()
        if gh is None:
            return "", "", "no gh to read the PR's state with"
        got = self.call([gh, "pr", "view", str(e["number"]), "-R", e["repo"], "--json", "state,mergeCommit"],
                        LAND_GH_DEADLINE, e)
        with contextlib.suppress(ValueError, AttributeError):
            doc = json.loads(got.stdout or "")
            state = str(doc.get("state") or "")
            if got.returncode == 0 and state in ("OPEN", "MERGED", "CLOSED"):
                return state, str((doc.get("mergeCommit") or {}).get("oid") or ""), ""
        return "", "", land_tail(f"{got.stderr or ''} {got.stdout or ''}".strip() or f"exit {got.returncode}", 300)

    def state_due(self, e: dict, kind: str | None) -> bool:
        """Under the lock. Whether the PR's state is read before KIND is taken: GitHub said the PR is closed
        (closedSeen), or a base-changing step on an upstream host's copy older than LAND_REFRESH_AFTER."""
        if e.get("closedSeen"):
            return True
        if kind not in LAND_STATE_FIRST_KINDS or not self.reads_upstream():
            return False
        at = (self.cache_of(e["key"]) or {}).get("dataAt")
        fresh = max(float(at) if isinstance(at, (int, float)) and not isinstance(at, bool) else 0.0,
                    float(e.get("stateReadAt") or 0))
        return self.now - fresh >= LAND_REFRESH_AFTER

    def state_first(self, e: dict, kind: str | None) -> bool:
        """Outside the lock. When state_due, read the PR's state before KIND is taken: True to go on (it reads OPEN,
        or no read was due); False when the entry ended (ended), was parked on quota, or waits to read it again."""
        with self.lock:
            if not self.state_due(e, kind):
                return True
        state, merge_sha, why = self.read_state(e)
        with self.lock:
            self.check(e)
            seen = e.get("closedSeen") or {}
            self.history(e, "state_read", state=state or "unreadable", before=kind,
                         why="GitHub said it is closed" if seen else "stale copy before a base-changing step")
            if self.ended(e, state, merge_sha, "a state read shows it"):
                return False
            if state == "OPEN":
                e.pop("closedSeen", None)
                e.pop("stateUnread", None)
                e["stateReadAt"] = self.now
                if seen:
                    e["stateOpen"] = seen.get("head") or e.get("head") or ""  # its next "closed" refusal counts
                self.save(e)
                return True
            if LAND_STEP_QUOTA.search(why):
                self.park_quota(e, why)  # the login's state, not the PR's: parked, never counted
                e["stepQuotaParked"] = True
                self.save(e)
                return False
            n = int(e.get("stateUnread") or 0) + 1
            e["stateUnread"] = n
            if n >= LAND_RETRY_STREAK_STOP:
                self.stop(e, "state_unreadable", f"the PR's state could not be read {n} times in a row before "
                          f"{kind or 'judging it'}" + (" (GitHub said it is closed)" if seen else "") + f": {why}",
                          f"gh pr view {e['number']} -R {e['repo']} --json state")
                return False
            after = min(LAND_STEP_BACKOFF_MAX, LAND_STEP_BACKOFF * (2 ** (n - 1)))
            self.wait(e, {"kind": "retry", "why": f"the PR's state is read before {kind or 'judging'}: unreadable, "
                          f"again in {after:.0f} s"}, after)
            return False

    def stop(self, e: dict, code: str, reason: str, nxt: str) -> None:
        self.check(e)
        st = {"code": code, "reason": land_reason(reason), "next": land_trim(nxt), "at": self.now,
              "head": e.get("head") or ""}
        repeat = land_stop_repeats(e.get("lastStop"), st)
        e.update(state="stopped", wait=None, wakeAt=None, action=None, stop=st)
        for held in ("parkedSince", "cappedSince", "heldFor", "latchHeld", "unreadCacheFirst", "unreadRun", "paceSince",
                     "holdWindow"):
            e.pop(held, None)  # a stopped entry is held by nothing, and a rearm or requeue starts its reads afresh
        self.history(e, "stopped", code=code, reason=land_reason(reason, 160), **({"quiet": "repeat"} if repeat else {}))
        self.save(e)
        msg = f"glaeda land: {self.url(e)} stopped: {code}: {land_reason(reason, 300)}"
        if nxt:
            msg += f" next: {land_trim(nxt, 300)}"
        if repeat:
            # LAND_STOP_REPEAT's comment: the requester already holds this exact stop; land status still shows it.
            log({"event": "land-stop-repeat-quiet", "key": e["key"], "code": code, "to": e.get("requester") or ""})
            return
        self.notify(e, e.get("requester") or "", msg)

    def notify(self, e: dict, to: str, message: str, wake: bool = True) -> None:
        """`acpmux send --no-wait HOST/SESSION MESSAGE`, off the tick; a failure is logged and a notice line, never
        a stop.

        A land tells its requester only what the requester acts on (LAND_NOTICE_CLASS): it merged, it stopped (a
        conflict, a red, a refusal naming its step), or a judge's escalation. Those go as class `block`, so an idle
        lane wakes at once instead of at its inbox's next FYI flush. Every other word (WAKE False: handed to the
        broker host, still waiting behind a stopped land, held by the login's latch) is a line in the log and the
        entry's history, read with `land status`, and sends nothing: each was a turn of an idle lane that read it
        and said "nothing to do". gcp-agent-lane-10, 2026-11-21 11Z-2026-11-22 07Z: 87 idle wakes carried only
        land notices, 37 of them "handed to huge-blue"; 16 in 06Z alone."""
        to = land_notify_target(e, to)
        if not wake:
            log({"event": "land-notice-quiet", "key": e["key"], "to": to, "message": land_trim(message, 300)})
            return
        if not to:
            # Nobody to tell (no --notify, no session in the queuing environment): still never silent.
            log({"event": "land-unnotified", "key": e["key"], "queuedBy": e.get("queuedBy"), "message": message})
            with contextlib.suppress(Exception):
                self.notice("land-unnotified", "warn", f"{message} (nobody to tell: queued by "
                            f"{e.get('queuedBy') or 'an unnamed caller'} with no --notify)",
                            {"pr": self.url(e), "queuedBy": e.get("queuedBy") or ""})
            return
        acpmux = self.path("acpmux", Path(shutil.which("acpmux", path=self.env()["PATH"]) or "acpmux"))
        # A notice from a named sender, never a bare send: acpmux records a bare send as the person's own words, and
        # leo-asks filed ~30 of these as Leo's asks (2026-11-19 12:28-12:31Z, Leo: "This needs to shut up").
        title = land_trim(message, 200)
        severity = "info" if message.startswith(f"glaeda land: {self.url(e)} merged") else "warn"
        argv = [os.fspath(acpmux), "send", "--no-wait", to, "--notice", "--severity", severity, "--sender", LAND_TAG,
                "--class", LAND_NOTICE_CLASS, "--title", title, message]

        def send() -> None:
            got = self.call(argv, LAND_NOTIFY_DEADLINE)
            if got.returncode != 0:
                why = land_trim(got.stderr or got.stdout or f"exit {got.returncode}", 200)
                log({"event": "land-notify-failed", "key": e["key"], "to": to, "why": why})
                with contextlib.suppress(Exception):
                    self.notice("land-notify-failed", "warn", f"glaeda land could not tell {to}: {message}",
                                {"to": to, "why": why, "pr": self.url(e)})
        if self.inline:
            send()
        else:
            threading.Thread(target=send, name="land-notify", daemon=True).start()


def land_entries() -> list[dict]:
    d = LandQueue.entries_dir()
    out = [e for p in sorted(d.glob("*.json")) if d.is_dir() for e in [read_json(p)] if isinstance(e, dict)]
    return sorted(out, key=lambda e: -float(e.get("updated") or 0))


def land_counts() -> dict:
    doc = read_json(land_dir() / "counts.json")
    return doc.get("days") if isinstance(doc, dict) and isinstance(doc.get("days"), dict) else {}


LAND_UNMOVED_PREFIX = "explain_unmoved_"


def land_unmoved_split(day: dict) -> dict:
    """A day's judgments that moved nothing, split by what made each run: "due", a bound of the queue's own running
    out (LAND_JUDGE_DUE: its backoff, its wake, a fresh row), and "redundant", a change the verdict does not depend
    on. Only the second is work the queue could have skipped, so `land status` never prints the one total alone:
    read together they name a waste that is mostly the backoff doing its job (hq#15832 Fix 120)."""
    by = {k[len(LAND_UNMOVED_PREFIX):]: int(v) for k, v in day.items()
          if k.startswith(LAND_UNMOVED_PREFIX) and isinstance(v, int) and not isinstance(v, bool)}
    due = {k: v for k, v in by.items() if k in LAND_JUDGE_DUE}
    red = {k: v for k, v in by.items() if k not in LAND_JUDGE_DUE}
    return {"judged": int(day.get("explain") or 0), "unmoved": int(day.get("explain_unmoved") or 0),
            "due": sum(due.values()), "redundant": sum(red.values()), "byWhy": by, "redundantByWhy": red}


_land_seq = 0
_land_written: dict[str, Path] = {}  # request id -> the requests/ file this process wrote for it (land_request_path)


def land_request_path(rid: str) -> Path:
    """The requests/ file land_request wrote for RID in this process."""
    return _land_written[rid]


LAND_OVERRIDE_REASON_MAX = 200  # lane-gh land's own "override" limits: reason and receipt, one line each
LAND_OVERRIDE_RECEIPT_MAX = 240


def fit_one_line(flag: str, text: str, most: int, *, stream=None) -> str:
    """TEXT as one line of at most MOST characters, said on STREAM when it had to change. A reason and a receipt are
    prose an agent writes for the record, so a newline or 2 characters too many is not worth a refused land and a
    second call: both are things this function can do itself (tools/guard_refusal.py fit, the same contract for a
    guard's own refusal text). What is left is what no guess can fix: an empty one, or only one of the pair."""
    fitted = " ".join(text.split())
    if len(fitted) > most:
        fitted = fitted[:most - 1].rstrip() + "\u2026"  # the head: a reason names its cause first
    if fitted != text:
        print(f"glaeda-gh land: {flag} fitted to one line of {most}: {fitted}",
              file=sys.stderr if stream is None else stream)
    return fitted


def land_override(reason: str | None, receipt: str | None) -> dict | None:
    """`land --override-reason R --override-receipt T` as the entry keeps it ({"reason", "receipt"}), or None with
    neither. A newline, padding or a text past LAND_OVERRIDE_REASON_MAX / LAND_OVERRIDE_RECEIPT_MAX characters is
    fitted (fit_one_line), not refused: on 2026-11-21 a 202-character reason cost a refusal and a second land call
    for 2 characters. Refused (WatchError) only for what no guess fixes: one of the two alone, or an empty one. Each
    merge try then runs with LAND_JUDGE_OVERRIDE and LAND_JUDGE_OVERRIDE_RECEIPT (a lane VM's: the broker land's
    "override")."""
    if reason is None and receipt is None:
        return None
    if reason is None or receipt is None:
        raise WatchError("--override-reason and --override-receipt go together: give both (the reason, and the "
                         "receipt naming the base run and job ids), or neither")
    out = {}
    for key, flag, text, most in (("reason", "--override-reason", reason, LAND_OVERRIDE_REASON_MAX),
                                  ("receipt", "--override-receipt", receipt, LAND_OVERRIDE_RECEIPT_MAX)):
        if not text.strip():
            raise WatchError(f"{flag} is empty")
        out[key] = fit_one_line(flag, text, most)
    return out


# The landing rulebook's override is the environment (`LAND_JUDGE_OVERRIDE="<why>"` before the pinned merge), and
# helpers set it before `glaeda-gh land` too; the land command read only its flags, so on hq#18032 (2026-11-22) a land
# run with LAND_JUDGE_OVERRIDE set queued with no override and its merge was refused as if none was given. With
# neither flag, a non-empty LAND_JUDGE_OVERRIDE is the reason and LAND_JUDGE_OVERRIDE_RECEIPT (else
# LAND_OVERRIDE_ENV_RECEIPT) the receipt; a flag given wins over the environment.
LAND_OVERRIDE_ENV_RECEIPT = "none given: LAND_JUDGE_OVERRIDE from the caller's environment"


def land_override_given(reason: str | None, receipt: str | None,
                        env: "dict[str, str] | os._Environ[str] | None" = None) -> tuple[str | None, str | None]:
    """The (reason, receipt) `land` queues: its --override-reason / --override-receipt flags, else the caller's
    LAND_JUDGE_OVERRIDE (and LAND_JUDGE_OVERRIDE_RECEIPT) as land-judge itself reads them."""
    if reason is not None or receipt is not None:
        return reason, receipt
    env = os.environ if env is None else env
    why = str(env.get("LAND_JUDGE_OVERRIDE") or "")
    if not why.strip():
        return None, None
    print("glaeda-gh land: LAND_JUDGE_OVERRIDE is set: queued with it as --override-reason", file=sys.stderr)
    return why, str(env.get("LAND_JUDGE_OVERRIDE_RECEIPT") or "").strip() or LAND_OVERRIDE_ENV_RECEIPT


def land_request_override(req: dict) -> dict | None:
    """A request's override as land_override takes it (fitted to the limits, not dropped for them), or None when it
    names none or one no guess fixes (an older sender's, an empty one): never a merge override no queue checked."""
    o = req.get("override")
    if not isinstance(o, dict) or not isinstance(o.get("reason"), str) or not isinstance(o.get("receipt"), str):
        return None
    try:
        return land_override(o["reason"], o["receipt"])
    except WatchError:
        return None


def land_override_env(e: dict) -> dict[str, str]:
    """The environment a merge try of E adds: its override, as land-judge and lane-gh read it."""
    o = e.get("override")
    if not isinstance(o, dict) or not o.get("reason") or not o.get("receipt"):
        return {}
    return {"LAND_JUDGE_OVERRIDE": str(o["reason"]), "LAND_JUDGE_OVERRIDE_RECEIPT": str(o["receipt"])}


# An entry queued with an override (`land --override-reason R --override-receipt T`) carried it only on the merge
# step, and land_judge explain, which runs without it, decides whether there is a merge step at all. So a refusal that
# names no step the queue runs stopped it, the override unused: cmux#47821 lost its override once the queue's own
# update-branch moved the head and the new head was refused, and hq#17374 (docs alone, head f4a442a5) was refused
# ci_never_ran three times on 2026-11-21 with --override-reason given, until its owner pushed an empty commit. Now
# such a refusal (a "command" step, or a stop outside LAND_STOP_CLASSES: own_red, ci_never_ran, a stuck check) at the
# head judged now -- whichever head that is, the queue's own update-branch's included -- is a pinned merge at that
# head carrying the override, which the shim's or the broker's land_judge logs. A hold, BLOCK, teammate, conflict or
# other LAND_STOP_CLASSES stop still stops: those are the PR's, not a check's. Waits and update-branch steps are
# taken as before, so an override never skips a check still running.
def land_override_takes(e: dict, act: dict, head: str) -> bool:
    """True when E's override answers ACT, a refusal's stop or command step at HEAD (the comment above)."""
    if not land_override_env(e) or not SHA40.fullmatch(head or ""):
        return False
    if act.get("kind") == "command":
        return True
    return act.get("kind") == "stop" and str(act.get("stop") or "") not in set(LAND_STOP_CLASSES.values())


def land_request(op: str, target: str, after: list[str], requester: str, source: str = "", rid: str = "",
                 queued_by: str = "", lane: tuple[str, str] | None = None, sha: str = "",
                 override: dict | None = None) -> str:
    """Write one request for the daemon's queue (requests/); its id. RID and QUEUED_BY are kept as given (a forwarded
    request's, so the executor applies a resend once): else a new id and this process's reader. LANE is (the lane its
    steps write as, the host that lane is on), the queuing process's (land_queue_lane) or a forwarded request's."""
    # The file is named for its arrival here (ingest applies requests/ in name order); the id inside is the request's.
    # A sequence number keeps a batch's requests apart and in order where time_ns() ticks in microseconds (macOS).
    global _land_seq
    _land_seq += 1
    name = f"{time.time_ns()}-{os.getpid()}-{_land_seq:06d}"
    rid = rid if rid and LAND_REQUEST_ID.fullmatch(rid) else name
    _land_written[rid] = LandQueue.requests_dir() / f"{name}.json"
    write_json(LandQueue.requests_dir() / f"{name}.json",
               {"id": rid, "op": op, "target": target, "key": land_key(target)[0], "after": after,
                "requester": requester, "requesterFrom": source, "queuedBy": queued_by or reader_name(),
                "at": time.time()} | ({"lane": lane[0], "laneHost": lane[1]} if lane is not None else {})
               | ({"sha": sha} if sha else {}) | ({"override": override} if override else {}))
    return rid


LAND_PIN_SHA = re.compile(r"[0-9a-f]{7,40}")


def land_pin_sha(text: Any) -> str:
    """A --sha as the queue keeps it (lowercase hex, 7 to 40), or "" for none; anything else is an error."""
    sha = str(text or "").strip().lower()
    if sha and not LAND_PIN_SHA.fullmatch(sha):
        raise WatchError(f"--sha is 7 to 40 hex characters: {str(text)[:60]!r}")
    return sha


def land_full_pin(e: dict) -> str:
    """E's --sha when it names a whole commit (40 hex), which a judgement and a merge may pin as given, else ""."""
    pin = str(e.get("pinSha") or "").lower()
    return pin if re.fullmatch(r"[0-9a-f]{40}", pin) else ""


def land_head_moved(pin: str, head: str) -> bool:
    """A head HEAD that is not the pinned PIN (a prefix pin matches a full head)."""
    return bool(pin and head) and not head.lower().startswith(pin)


def land_pin_merged(pin: str, parent: str, sent: str) -> bool:
    """True when a new head is safe for E's pin to follow: PARENT, the new head's first parent, is the pinned PIN, and
    SENT, the head the queue's own update-branch was pinned to (expected_head_sha), is that same commit. GitHub makes
    update-branch a merge commit on the head branch whose first parent is the branch tip it was pinned to, so a first
    parent that is the pin proves the pinned content is still exactly what is being merged, with only the base added.
    Anything else -- a push, a force-push, an unrelated commit, a merge made on top of something else -- is False, and
    the pin stops the row (head_moved) as it always did. An empty PARENT (a read that does not say) is False: a parent
    that could not be read is not a parent that matched."""
    # bool(parent) and bool(sent) are load-bearing: land_head_moved("pin", "") is False (an unread head has not
    # moved), so without them a read that said no parent at all would read as a parent that matched.
    return (bool(pin) and bool(parent) and not land_head_moved(pin, parent)
            and bool(sent) and not land_head_moved(pin, sent))


def land_request_lane(req: dict) -> tuple[str, str] | None:
    """A request's (lane, laneHost) as land_request takes it, or None when it records none (an older sender's)."""
    if "lane" not in req:
        return None
    lane, host = str(req.get("lane") or ""), str(req.get("laneHost") or "")
    return (lane, host) if land_session_lane(lane) == lane and re.fullmatch(r"[A-Za-z0-9._-]{0,100}", host) else ("", "")


def land_latch_held(e: dict) -> bool:
    """E was held by the login's latch and is not judged since: still marked (latchHeld), or released on the first pass
    no mark held it (LandQueue.tick's unhold) with its wait kept for the judgment (heldFor)."""
    return isinstance(e.get("latchHeld"), dict) or "heldFor" in e


LAND_LATCH_READ = object()  # land_line's default: read the login's latch now (land_latch)


def land_queue_parked(now: float) -> dict | None:
    """The host-wide quota park (LandQueue.park_queue_quota: land/quota.json) while it holds, else None."""
    doc = read_json(land_dir() / LAND_QUOTA_FILE)
    until = (doc or {}).get("until") if isinstance(doc, dict) else None
    if not isinstance(until, (int, float)) or isinstance(until, bool) or until <= now:
        return None
    return {"until": float(until), "reason": land_redact(doc.get("reason") or "")}  # a park an older daemon stored


def land_due_now(e: dict, now: float) -> bool:
    """Whether E is owed a judgment at NOW, as LandQueue.due reads it: queued, or waiting past its wake."""
    wake = e.get("wakeAt")
    if e.get("state") == "queued":
        return True
    return e.get("state") == "waiting" and isinstance(wake, (int, float)) and not isinstance(wake, bool) \
        and wake <= now


def land_line(e: dict, now: float, latch: Any = LAND_LATCH_READ, queue: dict | None = None) -> str:
    """E's status line. QUEUE is the host-wide quota park (land_queue_parked) when one holds: a due entry names it,
    never a stale "every worker busy" (gcp lane, 2026-11-21: 40 lines said every worker busy while the park, which
    status never named, held the queue for an hour). LATCH is the login's latch now ((pool, until) or None; read here by default): an entry the
    latch held (latchHeld) says so only while a mark holds, and names the mark's until as read now, never the one it
    stored. gcp-agent-lane-1 2026-11-19 11:18Z: with no mark on disk, 12 entries printed "held by the login latch until
    11:43Z", each its own stored until."""
    w = e.get("wait") or {}
    bits = [f"{key_name(e['key'])}", e.get("state", "?")]
    if e.get("head"):
        bits.append(f"head {str(e['head'])[:12]}")
    if e["state"] == "waiting" and w:
        what = w.get("kind")
        if w.get("run"):
            what += f" run {w['run']}"
        if w.get("before"):
            what += f" from {str(w['before'])[:12]}"
        bits.append(f"on {what}")
    if w.get("kind") == "quota" and e["state"] == "waiting" and isinstance(e.get("wakeAt"), (int, float)):
        bits.append(f"parked until {time.strftime('%H:%MZ', time.gmtime(e['wakeAt']))} (quota)")
    elif isinstance(e.get("wakeAt"), (int, float)) and e["state"] == "waiting":
        bits.append(f"{'woke' if e['wakeAt'] <= now else 'wakes'} {utc_clock(e['wakeAt'])}")
    held = e.get("latchHeld") or {}
    if held and e["state"] in ("queued", "waiting") and latch is LAND_LATCH_READ:
        latch = land_latch(now, land_budget_reading)
    if held and e["state"] in ("queued", "waiting") and latch is not None:
        # A due land the login's latch skips says so, never a silent wait past its wake (LandQueue.hold)
        bits.append(f"held by the login latch until {time.strftime('%H:%MZ', time.gmtime(float(latch[1])))}"
                    f" ({held.get('windows')} window{'s' if held.get('windows') != 1 else ''}, due since "
                    f"{utc_clock(float(held.get('dueSince') or 0))})")
    elif (e.get("windowCapped") or {}) and e["state"] in ("queued", "waiting") \
            and float(e["windowCapped"].get("next") or 0) > now:
        wc = e["windowCapped"]
        left = f": {int(wc['remaining'])} left{host_cap_why(str(wc.get('pool')), wc.get('remaining'))}, resets " \
            f"{time.strftime('%H:%MZ', time.gmtime(float(wc['reset'])))}" \
            if isinstance(wc.get("remaining"), (int, float)) and not isinstance(wc.get("remaining"), bool) \
            and isinstance(wc.get("reset"), (int, float)) else ""
        bits.append(f"not judged this window: host cap ({wc.get('pool')}{left}; next slot "
                    f"{time.strftime('%H:%M:%SZ', time.gmtime(float(wc['next'])))})")
    elif queue and land_due_now(e, now) and not (w.get("kind") == "quota" and e["state"] == "waiting"):
        # Only a row the park actually holds: a row whose own wake is still ahead waits for that wake, park or no
        # park, and saying it is held by the park read as the park being why it had not moved (18 such lines on
        # one host, 2026-11-21 12:08Z, 3 of them on rows whose next wake was past the park's own end).
        bits.append(f"held: the land queue is parked until {utc_clock(float(queue['until']))} (quota)")
    elif (e.get("dueLate") or {}) and e["state"] in ("queued", "waiting"):
        dl = e["dueLate"]
        why = str(dl.get("why") or "every worker busy")
        if isinstance(dl.get("busy"), int) and isinstance(dl.get("workers"), int):
            why += f" (busy {dl['busy']} of {dl['workers']}"
            why += f", load {dl['loadPerCore']}/core)" if isinstance(dl.get("loadPerCore"), (int, float)) else ")"
        bits.append(f"due since {utc_clock(float(dl.get('since') or 0))}: {why}")
    took = (e.get("judging") or {}).get("at") if e["state"] == "judging" else \
        (e.get("action") or {}).get("claimedAt") if e["state"] == "acting" else None
    if isinstance(took, (int, float)) and not isinstance(took, bool) and now - took >= LAND_SLOT_HELD:
        bits.append(f"holding a worker since {utc_clock(float(took))} (LAND_SLOT_HELD)")
    hw = e.get("holdWindow") or {}
    if hw.get("capped") and isinstance(hw.get("since"), (int, float)) and now - float(hw["since"]) < LAND_HOLD_WINDOW \
            and e["state"] in ("queued", "waiting"):
        bits.append(f"held workers {int(float(hw.get('heldS') or 0) // 60)} min judging nothing: no worker until "
                    f"{utc_clock(float(hw['since']) + LAND_HOLD_WINDOW)} (LAND_HOLD_MAX)")
    if e.get("after") and e["state"] == "waiting_after":
        bits.append("after " + ", ".join(key_name(a) for a in e["after"]))
    la = e.get("lastAction") or {}
    if la:
        ended = la.get("endedAt")
        bits.append(f"last {la.get('kind')} " + (age(float(ended)) if isinstance(ended, (int, float)) else "running"))
    s = e.get("streak") or {}
    if s.get("count", 0) > 1:
        bits.append(f"refused {s['count']}x ({str(s.get('signature', '')).split('|')[0]})")
    if e["state"] == "merged" and e.get("mergeSha"):
        bits.append(f"merge {e['mergeSha'][:12]}")
    if e["state"] == "stopped":
        st = e.get("stop") or {}
        bits.append(f"{st.get('code')}: {land_reason(st.get('reason'), 160)}")
    elif (e.get("explain") or {}).get("code") == "explain_failed":
        # land_judge itself failed (a crash, a bad python): its words, or the line reads like a quota wait.
        bits.append(f"explain_failed: {land_reason(e['explain'].get('reason'), 160)}")
    if e.get("requester"):
        bits.append(f"for {e['requester']}")
    o = e.get("override")
    if isinstance(o, dict) and o.get("reason"):
        bits.append(f"override: {land_trim(o.get('reason'), 120)} (receipt: {land_trim(o.get('receipt'), 120)})")
    return "  ".join(bits)


def land_override_history(e: dict) -> dict:
    """An entry's override as its queued/updated history line names it (reason and receipt, whole: each is one line
    of at most 240 characters)."""
    o = e.get("override")
    return {"override": o["reason"], "receipt": o["receipt"]} if isinstance(o, dict) and o.get("reason") else {}


def land_status_doc(target: str | None) -> dict:
    """What `land status` shows of this host's queue (`land serve`'s status answer too)."""
    entries = land_entries()
    if target:
        key = land_key(target)[0]
        entries = [e for e in entries if e.get("key") == key]
    refused = read_json(land_dir() / LAND_REFUSED_FILE)
    stale = read_json(land_dir() / LAND_STALE_CHECKOUT_FILE)
    return {"ok": True, "entries": entries, "steps": land_counts(), "refused": refused if isinstance(refused, dict)
            else None, "queueParked": land_queue_parked(time.time()), "stale": stale if land_stale_fresh(stale, time.time()) else None,
            "stoppedByCause": land_stopped_by_cause(entries)}


def land_stale_fresh(stale: Any, now: float) -> bool:
    """Whether check_behind's record STALE was written or confirmed within 2 x LAND_MH_BEHIND_EVERY: an older one is a
    verdict no running check holds any more. gcp-agent-lane-6, 2026-11-19: `land status` printed a 17:40Z "last fetched
    6.5 h ago" warning 15 h later, its checkout at origin/main, fetched minutes before, ws-deploy a no-op."""
    if not isinstance(stale, dict) or not stale.get("reason"):
        return False
    seen = [float(v) for v in (stale.get("at"), stale.get("checkedAt"))
            if isinstance(v, (int, float)) and not isinstance(v, bool)]
    return bool(seen) and now - max(seen) <= 2 * LAND_MH_BEHIND_EVERY


def land_stopped_by_cause(entries: list[dict]) -> dict[str, int]:
    """Stopped entries counted by their stop code, the detector's read of `land status` (stoppedByCause)."""
    out: dict[str, int] = {}
    for e in entries:
        if e.get("state") == "stopped":
            code = str((e.get("stop") or {}).get("code") or "unknown")
            out[code] = out.get(code, 0) + 1
    return dict(sorted(out.items(), key=lambda kv: (-kv[1], kv[0])))


def land_latch_note(note: dict) -> str:
    """One `land status` line for a held latch mark land_latch_judge looked at: whether it holds lands, and what
    GitHub's own count said of it (fresh, stale or unread)."""
    pool = "REST" if note["pool"] == "rest" else "GraphQL"
    mark = (f"the login's {pool} mark ({note.get('source')} by {note.get('by') or '?'}, "
            f"until {utc_clock(note['until'])})")
    reset = note.get("reset")
    count = (f"{note.get('remaining')} left, resets {utc_clock(reset)}" if isinstance(reset, (int, float))
             and not isinstance(reset, bool) else f"{note.get('remaining')} left")
    why = note["why"]
    if why == "graphql_rest_judges":
        return f"glaeda land: {mark} holds no land: land_judge judges over REST; a merge it refuses parks on its own"
    if why == "reading_above_reserve":
        return f"glaeda land: {mark} holds no land: GitHub's count reads {count} (hard reserve {note.get('reserve')})"
    if why == "window_reset":
        return f"glaeda land: {mark} holds no land: GitHub's window it was written in reset at {utc_clock(reset)}"
    if why == "ends_at_reading_reset":
        return f"glaeda land: {mark} ends at GitHub's reset {utc_clock(note['heldUntil'])} ({count})"
    if note.get("reading") == "stale":
        return f"glaeda land: {mark} holds; GitHub's count is stale ({count}, seen before the mark or its reset passed)"
    if note.get("reading") == "unread":
        return f"glaeda land: {mark} holds; GitHub's count is unread"
    if why == "reading_under_reserve":
        return f"glaeda land: {mark} holds: GitHub's count reads {count}, at or under the hard reserve"
    return f"glaeda land: {mark} holds ({why})"


def land_holders_line(entries: list[dict], now: float) -> str:
    """What holds the land workers now: each judging or acting row (its PR, its step and for how long), the pool's
    ceiling and the host's load per core (reported, not a gate). "" while no row is due and none runs. huge-blue,
    2026-11-22: `land status` said only "every worker busy" while one worker of 12 ran and the load line held the rest."""
    running = []
    for e in entries:
        if e.get("state") not in ("judging", "acting"):
            continue
        if e["state"] == "acting":
            a = e.get("action") or {}
            step, at = f"acting {a.get('kind') or '?'}", a.get("claimedAt")
        else:
            step, at = "judging", (e.get("judging") or {}).get("at")
        since = f" started {age(float(at))}" if isinstance(at, (int, float)) and not isinstance(at, bool) else ""
        running.append(f"{key_name(e['key'])} {step}{since}")
    late = sum(1 for e in entries if e.get("dueLate") and e.get("state") in ("queued", "waiting"))
    if not running and not late:
        return ""
    load = land_load_per_core()
    loads = "unknown" if load is None else f"{load:.2f}/core"
    given = land_config().get("workers")
    ceiling = int(land_seconds(given, land_worker_ceiling(), 1, 1024))
    return (f"glaeda land: workers {len(running)} busy of {ceiling} ({'land.json' if given is not None else 'cores'})"
            + (f": {'; '.join(running[:12])}" + (f" (+{len(running) - 12})" if len(running) > 12 else "")
               if running else "")
            + f"; load {loads}; {late} due late")


def cmd_land_status(target: str | None, as_json: bool) -> int:
    doc = land_status_doc(target)
    executor = land_executor()
    if executor is not None:
        # This host forwards its lands: the executor's queue, with what is still open or waiting here.
        name = land_forward_name(executor)
        mine = [e for e in doc["entries"] if e.get("state") != LAND_FORWARDED]
        try:
            remote = land_forward(executor, {"op": "status", "target": target})
            remote_entries = [e for e in remote.get("entries") or [] if isinstance(e, dict)]
            doc = {**remote, "entries": mine + remote_entries, "executor": name}
        except WatchError as error:
            doc = {**doc, "entries": mine, "executor": name, "executorError": str(error)}
        d = LandQueue.requests_dir()
        doc["pendingForward"] = len(list(d.glob("*.json"))) if d.is_dir() else 0
        doc["forward"] = read_json(land_dir() / LAND_FORWARD_FILE)
    entries, counts, refused = doc["entries"], doc.get("steps") or {}, doc.get("refused")
    doc["stoppedByCause"] = land_stopped_by_cause(entries)
    if as_json:
        print(json.dumps(doc, sort_keys=True))
        return EXIT_OK if entries or not target else EXIT_FAIL
    now = time.time()
    if executor is not None:
        print(f"glaeda land: this host forwards its lands to {doc['executor']}"
              + (f"; {doc['pendingForward']} request(s) wait here to be sent" if doc["pendingForward"] else "")
              + (f"; the executor did not answer: {doc['executorError']}" if doc.get("executorError") else ""))
    stale = doc.get("stale")
    if isinstance(stale, dict) and stale.get("reason") and stale.get("fallback"):
        print(f"glaeda land: land-judge runs from the ws-sync release {stale['fallback']}, not "
              f"{stale.get('landJudge')}: {stale['reason']}")
    elif isinstance(stale, dict) and stale.get("reason"):
        ran = stale.get("refresh") if isinstance(stale.get("refresh"), dict) else {}
        print(f"glaeda land: WARNING: {stale['reason']}" + (
            f" (the land ran ws-deploy --local itself at {utc_clock(float(ran.get('at') or 0))}: exit {ran.get('rc')}"
            f"{': ' + ran['out'] if ran.get('rc') and ran.get('out') else ''})" if ran else ""))
    if refused:
        print(f"glaeda land: REFUSED to start since {utc_clock(float(refused.get('at') or 0))}: "
              f"{refused.get('reason')}\nnext: {refused.get('next')}")
    latch, notes = land_latch_judge(now, land_budget_reading)
    for note in notes:
        print(land_latch_note(note))
    if latch:
        print(f"glaeda land: parked until {time.strftime('%H:%MZ', time.gmtime(latch[1]))} (quota): the login's "
              f"{'REST' if latch[0] == 'rest' else 'GraphQL'} latch holds; no entry is judged before it")
    queue = doc.get("queueParked") if isinstance(doc.get("queueParked"), dict) else None
    if queue and float(queue.get("until") or 0) <= now:
        queue = None
    if queue:
        print(f"glaeda land: the whole queue is parked until {utc_clock(float(queue['until']))} (quota): no entry is "
              f"judged before it; a PR the cache shows merged or closed still leaves. reason: "
              f"{land_reason(queue.get('reason'), 200)}")
    holders = land_holders_line(entries, now)
    if holders:
        print(holders)
    for e in entries:
        print(land_line(e, now, latch, queue))
        if target:
            for h in e.get("history") or []:
                extra = " ".join(f"{k}={v}" for k, v in h.items() if k not in ("at", "event"))
                print(f"  {utc_clock(float(h.get('at') or 0))} {h.get('event')} {extra}".rstrip())
            st = e.get("stop") or {}
            if e.get("state") == "stopped" and st.get("next"):
                print(f"next: {st['next']}")
    if not entries:
        print("glaeda land: nothing queued" + (f" for {target}" if target else ""))
    today = counts.get(land_day(now)) or {}
    week = {}
    for day in sorted(counts)[-7:]:
        for k, v in (counts[day] or {}).items():
            week[k] = week.get(k, 0) + int(v)
    def fmt(d: dict) -> str:
        return ", ".join(f"{k} {v}" for k, v in sorted(d.items(), key=lambda x: -x[1])
                         if not k.startswith(LAND_UNMOVED_PREFIX)) or "none"
    print(f"steps taken today: {fmt(today)}; last 7 days: {fmt(week)}")
    split = land_unmoved_split(today)
    doc["unmovedToday"] = split
    if split["unmoved"]:
        share = f" of {split['judged']}" if split["judged"] else ""
        why = ", ".join(f"{k} {v}" for k, v in sorted(split["redundantByWhy"].items(), key=lambda x: -x[1]))
        print(f"judgments that moved nothing today: {split['unmoved']}{share}; "
              f"{split['due']} a bound of the queue's own running out (its backoff, its wake: the design), "
              f"{split['redundant']} on a change the verdict does not depend on"
              + (f" ({why}): that share alone is skippable" if why else ": none skippable"))
    print(f"stopped by cause: {fmt(doc['stoppedByCause'])}")
    if target and not entries:
        return EXIT_FAIL
    return EXIT_OK


def land_outbox_busy(key: str) -> bool:
    """On a forwarding host: whether a request must wait in requests/ (the daemon forwards it in order) rather than go
    to the executor now: an older request is still waiting there, or KEY's entry is still open here."""
    d = LandQueue.requests_dir()
    if d.is_dir() and any(d.glob("*.json")):
        return True
    e = read_json(LandQueue.entries_dir() / file_name(key))
    return isinstance(e, dict) and e.get("state") not in LAND_DONE


def land_print_answer(out: dict, as_json: bool, key: str, where: str) -> None:
    entry = out.get("entry") if isinstance(out.get("entry"), dict) else None
    if as_json:
        print(json.dumps(out, sort_keys=True))
        return
    print((land_line(entry, time.time()) if entry else f"{key_name(key)} requested; the daemon takes it next tick")
          + f"  (on {where})")
    if not out.get("requester"):
        say_waiting("glaeda-gh land: no --notify and no session in the environment ($ACPMUX_SESSION_NAME, ...): "
                    "a stop or a merge is only a notice line (glaeda-gh land status shows it)")


def land_progress(entry: Any) -> Any:
    """What of a land entry counts as it moving, for `land --wait` (Leash): its state, its wait and every other field
    but the times a re-read rewrites, so a land that is still taking steps keeps its wait alive."""
    def strip(v: Any) -> Any:
        if isinstance(v, dict):
            return {k: strip(x) for k, x in v.items()
                    if not (k.endswith("At") or k in ("at", "checked", "until", "now", "seen", "touched"))}
        if isinstance(v, list):
            return [strip(x) for x in v]
        return v
    return json.dumps(strip(entry), sort_keys=True, default=str) if isinstance(entry, dict) else None


def land_forward_exit(out: dict, wait: float) -> int:
    state = out.get("state")
    if out.get("code") in LAND_REQUEST_REFUSED:
        return EXIT_FAIL
    if state == "merged":
        return EXIT_OK
    if state in ("stopped", "cancelled"):
        return EXIT_FAIL
    return EXIT_TIMEOUT if wait > 0 else EXIT_OK


def cmd_land_forwarded(executor: list[str], target: str, after: list[str], requester: str, source: str, wait: float,
                       as_json: bool, sha: str = "", override: dict | None = None,
                       ceiling: float | None = None) -> int:
    """`land` on a host that forwards its lands (land_executor): to the executor now, else into requests/, which the
    daemon forwards when the executor answers. Either way it is never lost."""
    key, repo, number = land_key(target)
    name = land_forward_name(executor)
    targets = [land_key(a)[1] + f"#{land_key(a)[2]}" for a in after]
    rid = f"{policy_host()}-{time.time_ns()}-{os.getpid()}"
    lane = land_queue_lane()
    req = {"op": "land", "target": f"{repo}#{number}", "after": targets, "requester": requester,
           "requesterFrom": source, "queuedBy": land_queued_by(), "id": rid, "wait": wait, "lane": lane,
           "laneHost": policy_host() if lane else ""} | ({"sha": sha} if sha else {}) \
        | ({"max": Leash(wait, ceiling).ceiling} if wait > 0 else {}) \
        | ({"override": override} if override else {})
    why = "an earlier request is still waiting to be forwarded" if land_outbox_busy(key) else ""
    # Staged first: a crash (or a kill) during the forward leaves it in requests/, which the daemon forwards. The
    # executor applies the same id once, so the daemon's send and this one never land it twice.
    staged = land_request_path(land_request("land", f"{repo}#{number}", targets, requester, source, rid=rid,
                                            queued_by=req["queuedBy"], lane=(req["lane"], req["laneHost"]), sha=sha,
                                            override=override))
    if not why:
        try:
            # the executor waits up to --max while the land keeps moving (an older one: --timeout in all)
            out = land_forward(executor, req, LAND_FORWARD_DEADLINE + (req.get("max") or wait))
        except WatchError as error:
            why = str(error)
        else:
            if out.get("ok") or out.get("code") in LAND_REQUEST_REFUSED:
                staged.unlink(missing_ok=True)  # taken (or refused for good, and said so below)
            else:
                why = f"{name}: {land_reason(out.get('reason') or out.get('code'), 200)}"
        if not why:
            if out.get("code") in LAND_REQUEST_REFUSED:
                # A request-time refusal, not a queued land: the human line is the refusal and its step, never
                # "requested; the daemon takes it next tick", which land_print_answer would print for an empty entry.
                if as_json:
                    print(json.dumps(out, sort_keys=True))
                else:
                    say_waiting(f"glaeda land: refused on {name}: {out.get('reason')}\nnext: {out.get('next')}")
            else:
                land_print_answer(out, as_json, key, name)
            return land_forward_exit(out, wait)
    out = {"ok": True, "key": key, "state": "requested", "requester": requester, "request": rid, "entry": None,
           "forwardTo": name, "pending": why}
    if as_json:
        print(json.dumps(out, sort_keys=True))
    else:
        print(f"{key_name(key)} requested; this host forwards it to {name} ({why})")
        if not daemon_running():
            say_waiting(f"glaeda-gh: {down_message()} The request stays queued for it.")
            say_waiting("next: glaeda-gh restart")
    return EXIT_OK


def land_queued_by() -> str:
    """Who queued a request, as the executor keeps it: HOST/READER (a forwarded request's reader is this host's)."""
    reader = reader_name()
    return reader if "/" in reader else f"{policy_host()}/{reader}"


# A pin the caller passes is trusted as given, with no head read, bar the one wrong pin a local git call can prove
# (land_pin_behind_refusal): the merge's own --match-head-commit (and land_judge's
# --sha) refuse a head that moved, and the executor stops head_moved on a read that shows another one. Reading the head
# here first (`gh api repos/R/pulls/N`) was what refused under a short quota: transcript-lessons (cmuxterm-hq#16805)
# found a spent shared quota blocking push, PR create and land 9 times in 7 sessions, `land --sha` among them with
# "cannot read OWNER/REPO#N's head to check --match-head-commit" while the PR it pinned was green.


def land_pin_is_another_checkouts_head(repo: str, pin: str, git: Callable[[list[str]], str | None] | None = None) -> str:
    """Why PIN cannot be REPO's head: it is the HEAD of the directory the caller ran in, and that directory is a
    checkout of another repository. "" when it is not that, which is every other case. No GitHub read, two local git
    calls, and only when a pin was passed.

    The guidance for pinning is `--match-head-commit $(git rev-parse HEAD)`, and a lane working in one repository's
    worktree while landing another's PR (a leo-workspace worktree landing a cmux PR) resolves it against the wrong
    checkout: the land is pinned to a sha the target repository does not have, and stops later reading as head
    movement. The right source when the cwd is not the target's checkout is a GitHub read, which this names."""
    def real(args: list[str]) -> str | None:
        try:
            got = run_bounded(["git", *args], 5)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return got.stdout.strip() if got.returncode == 0 else None
    git = git or real
    here = cwd_repo()
    if not here or here.lower() == repo.lower():
        return ""  # not a checkout, or the target's own checkout, where HEAD is a fair source
    head = str(git(["rev-parse", "HEAD"]) or "").lower()
    if not SHA40.fullmatch(head) or land_head_moved(pin.lower(), head):
        return ""
    return (f"--match-head-commit {pin[:12]} is the HEAD of {os.getcwd()}, a checkout of {here}, not of {repo}: "
            f"{repo} has no such commit, so the land would stop later for a reason that reads like a push")


def check_land_pin_shape(pin: str | None) -> None:
    """`land --match-head-commit SHA`'s shape alone, which costs nothing: no read of any kind, local or remote. A
    request this host can answer from its cache (land_draft_refusal) is answered after this and before
    check_land_pin, so such an answer spends no git call either -- what that test asserts by banning every
    subprocess."""
    if pin and not re.fullmatch(r"[0-9a-fA-F]{7,40}", pin):
        raise WatchError(f"--match-head-commit takes a commit SHA, not {pin!r}")


def check_land_pin(repo: str, number: int, pin: str | None,
                   git: Callable[[list[str]], str | None] | None = None) -> None:
    """`land --match-head-commit SHA` (gh pr merge's own pin, which agents type): its shape, and the one wrong source
    that is free to detect (land_pin_is_another_checkouts_head). No head read, so a land is queued whatever the quota;
    a head other than SHA stops it later (head_moved) and the pinned merge refuses it, so a land never takes a push
    that came after the one the caller judged.

    Two local git calls, so a caller that may still refuse from its cache runs check_land_pin_shape first and this
    only for a request it is about to queue."""
    check_land_pin_shape(pin)
    why = land_pin_is_another_checkouts_head(repo, pin, git) if pin else ""
    if why:
        raise WatchError(f"{why}\nnext: glaeda-gh gh api repos/{repo}/pulls/{number} --jq .head.sha, "
                         f"then glaeda-gh land {repo}#{number} --match-head-commit THAT")


# How old this host's last read of a PR may be for a pin to be judged against its head: a day, because the judgment
# below is not "the head is not the pin" (which a stale read gets wrong, pin_wait's own case) but "the pin is an
# ancestor of that head", which no later push can undo -- a branch only grows, and a force-push back onto an ancestor
# of its own tip is not a thing lands here meet. 2026-11-21: leo-workspace#7547 was landed pinned fc1415273c, the
# commit its own head 67646e98d6 had merged minutes earlier, and sat in pinWait nudging for its pinned head while
# GitHub was down, because a pin is trusted as given.
LAND_PIN_BEHIND_AGE = 86400.0


def land_pin_behind_refusal(repo: str, number: int, pin: str, head: str,
                            git: Callable[[list[str]], str | None] | None = None) -> tuple[str, str] | None:
    """(why, the step that clears it) when PIN is provably an older commit of the same branch than HEAD, this host's
    cached head of REPO#NUMBER, else None. No GitHub read: the proof is `git merge-base --is-ancestor` in the checkout
    the caller ran in, and a checkout that does not have both commits proves nothing and refuses nothing.

    A pin the caller passes is trusted as given (the comment above check_land_pin), and it has to be: the cache's head
    is routinely older than the head an agent just pushed and pinned, so "the cached head is not the pin" is no reason
    to refuse. An *ancestor* is the other direction and is certain -- the pinned commit is already in the head's
    history, so the head moved past it before the request -- and such a land can only stop head_moved later, or wait
    out its pin for a head that will never come back.

    GIT runs git and returns its stdout, or None when it failed, so a command that prints nothing on success (both of
    these) answers "" when it succeeded."""
    if not pin or not SHA40.fullmatch(head or "") or not land_head_moved(pin.lower(), head.lower()):
        return None

    def real(args: list[str]) -> str | None:
        try:
            got = run_bounded(["git", *args], 5)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return got.stdout.strip() if got.returncode == 0 else None
    git = git or real
    if any(git(["cat-file", "-e", f"{sha}^{{commit}}"]) is None for sha in (pin, head)):
        return None  # this checkout does not hold both commits: it cannot tell which came first
    if git(["merge-base", "--is-ancestor", pin, head]) is None:
        return None  # not an ancestor (or git could not say): a pin of a head newer than the cache, which is normal
    name = f"{repo}#{number}"
    return (f"--match-head-commit {pin[:12]} is an ancestor of {name}'s head {head[:12]}, by this host's last read of "
            f"it and this checkout's history: the head moved past that commit before the request, so the land would "
            f"wait out its checks and stop head_moved (or wait for a head that is already gone). Pin the head itself",
            f"glaeda-gh land {name} --match-head-commit {head}")


LAND_PIN_PREFIX = 12  # hex a pin must share with the cached head before a differing tail reads as hand-written


def land_pin_extends_head_refusal(repo: str, number: int, pin: str, head: str) -> tuple[str, str] | None:
    """(why, the step that clears it) when PIN is a 40-hex sha that starts with this host's cached head and then
    differs from it, else None. No read of any kind, local or remote: two strings.

    A pin is otherwise trusted as given (the comment above check_land_pin), and must be, because the cache's head is
    routinely older than the head an agent just pushed. This is the one shape that cannot be a real newer commit: a
    sha sharing LAND_PIN_PREFIX hex with the head and differing after it is one chance in 2^48 as two commits, and
    the everyday way to write one is to take the abbreviated head a command printed and fill in the rest. Measured
    twice on 2026-11-21: `71b0560d5f` plus zeros, for a head ending `ffc48103c984e90c77ec6672abaeac5`. Both requests
    were accepted, and a row pinned to a sha no commit has can only wait out a head that will never come."""
    if not pin or not SHA40.fullmatch(pin) or not SHA40.fullmatch(head or ""):
        return None
    pin, head = pin.lower(), head.lower()
    if pin == head or pin[:LAND_PIN_PREFIX] != head[:LAND_PIN_PREFIX]:
        return None
    name = f"{repo}#{number}"
    return (f"--match-head-commit {pin[:12]} starts with {name}'s head {head[:12]} and then differs from it: that is "
            f"an abbreviated head written out by hand, not another commit, and {repo} has no such sha, so the land "
            f"would wait out a head that cannot come. The whole head, as this host last read it, is {head}",
            f"glaeda-gh land {name} --match-head-commit {head}")


def land_cached_head(key: str, max_age: float) -> str:
    """The head this host's cache holds for KEY, when its read is at most MAX_AGE old and says the PR is open, else "".
    A failed, absent or stale read says nothing, as it does for land_draft_refusal."""
    cached = read_cache(key) or {}
    data, at = cached.get("data"), cached.get("dataAt")
    if cached.get("error") or not isinstance(data, dict) or not isinstance(at, (int, float)) \
            or isinstance(at, bool) or not 0 <= time.time() - at <= max_age \
            or data.get("state") != "OPEN" or data.get("merged"):
        return ""
    return str(data.get("headRefOid") or "").lower()


# The codes a land *request* answers with instead of queuing anything: a forwarded request carries them back from
# the executor unchanged (cmd_land_forwarded prints them and drops the staged copy, land_forward_exit fails on them),
# because the executor is the host that holds the cache and the land-judge the answer came from.
LAND_REQUEST_REFUSED = ("land_judge_missing", "land_draft", "land_pin_behind", "land_pin_invented")


def land_draft_refusal(key: str, repo: str, number: int, pin: str = "") -> tuple[str, str] | None:
    """(why, the step that clears it) when this host already knows REPO#NUMBER is a draft, else None.

    No read of its own (LAND_DRAFT_AGE's comment): this answers from the daemon's cache or not at all, so a land is
    still queued under a spent quota, and an absent, failed, stale or write-shadowed read refuses nothing. The
    merge-time check (LAND_STEP_DRAFT) stays either way."""
    cached = read_cache(key) or {}
    data, at = cached.get("data"), cached.get("dataAt")
    if cached.get("error") or not isinstance(data, dict) or not isinstance(at, (int, float)) \
            or isinstance(at, bool):
        return None
    now = time.time()
    if not 0 <= now - at <= LAND_DRAFT_AGE:
        return None  # older than the live-field bound (or stamped in the future): not an answer to refuse on
    if data.get("isDraft") is not True or data.get("state") != "OPEN" or data.get("merged"):
        return None
    writes = gh_cache_writes()
    if any(writes.get(stamp, 0.0) >= at for stamp in gh_cache_stamps(["pr", repo, str(number)], repo) or []):
        return None  # a write that could have marked it ready (`gh pr ready` itself) came after the read
    name = f"{repo}#{number}"
    pinned = f" --match-head-commit {pin}" if pin else ""
    return (f"{name} is a draft ({int(now - at)} s ago, by this host's last read of it): GitHub refuses every merge "
            f'on a draft ("Pull Request is still a draft"), so the land would wait out its checks, judge them, and '
            f"stop at the merge. Nothing here marks a PR ready: a draft can be a deliberate hold, so it stays yours",
            f"gh pr ready {number} -R {repo}, then glaeda-gh land {name}{pinned}")


def land_request_refused(key: str, code: str, why: str, nxt: str, as_json: bool) -> int:
    """Print one request-time refusal (LAND_REQUEST_REFUSED) the way `land` prints them, and its exit code."""
    if as_json:
        print(json.dumps({"ok": False, "key": key, "code": code, "reason": why, "next": nxt}, sort_keys=True))
    else:
        say_waiting(f"glaeda land: refused: {why}\nnext: {nxt}")
    return EXIT_FAIL


def cmd_land(target: str, after: list[str], notify: str | None, wait: float, as_json: bool,
             pin: str | None = None, override: dict | None = None, ceiling: float | None = None) -> int:
    """PIN (--sha or --match-head-commit) is trusted with no head read (check_land_pin) and kept with the request, so the
    executor stops (head_moved) if a read shows another head, and the pinned merge refuses one it did not see. OVERRIDE (land_override) rides every merge
    try."""
    key, repo, number = land_key(target)
    after = land_after_in(repo, after)
    check_land_pin_shape(pin)
    sha = land_pin_sha(pin)
    for a in after:
        land_key(a)
    draft = land_draft_refusal(key, repo, number, sha)
    if draft is not None:
        # Before the forward and before the queue: the request answers it, so no CI wait, judgment or merge call is
        # spent on an answer the first merge would have given ~20 min later (LAND_DRAFT_AGE's comment).
        return land_request_refused(key, "land_draft", *draft, as_json=as_json)
    # The pin's source is checked here, not above: its two local git calls belong to a request that will be queued,
    # not to one this host already answered from its cache.
    check_land_pin(repo, number, pin)
    cached = land_cached_head(key, LAND_PIN_BEHIND_AGE) if sha else ""
    invented = land_pin_extends_head_refusal(repo, number, sha, cached) if sha else None
    if invented is not None:
        # Before the ancestor check, which would say nothing here: no checkout holds a commit that does not exist.
        return land_request_refused(key, "land_pin_invented", *invented, as_json=as_json)
    behind = land_pin_behind_refusal(repo, number, sha, cached) if sha else None
    if behind is not None:
        # Same place, same reason as the draft answer: a pin the head has already passed can only stop later.
        return land_request_refused(key, "land_pin_behind", *behind, as_json=as_json)
    requester, source = land_requester_from(notify)
    executor = land_executor()
    if executor is not None:
        return cmd_land_forwarded(executor, target, after, requester, source, wait, as_json, sha, override,
                                  ceiling)
    mh, tried = land_judge(land_config())
    if mh is None:
        # The startup check's twin: nothing on this host could judge the merge, so it is not queued.
        why, nxt = land_judge_missing(tried)
        if as_json:
            print(json.dumps({"ok": False, "key": key, "code": "land_judge_missing", "reason": why, "next": nxt},
                             sort_keys=True))
        else:
            say_waiting(f"glaeda land: refused: {why}\nnext: {nxt}, then glaeda-gh land {repo}#{number}")
        return EXIT_FAIL
    lane = land_queue_lane()
    rid = land_request("land", f"{repo}#{number}", [land_key(a)[1] + f"#{land_key(a)[2]}" for a in after], requester,
                       source, lane=(lane, policy_host() if lane else ""), sha=sha, override=override)
    no_lane = (f"no lane here (${LAND_LANE_ENV}, $ACPMUX_SESSION_NAME): an entry queued with one keeps it, else its "
               f"steps write as {LAND_QUEUE_LANE}, which the broker refuses while another lane holds the PR's branch "
               "lease") if not lane and land_broker_client() else ""
    if no_lane and not as_json:
        say_waiting(f"glaeda-gh land: {no_lane}")
    running = daemon_running()
    leash = Leash(wait, ceiling)  # --timeout is no change in the land's entry for that long, up to --max
    entry = None
    while True:
        entry = read_json(LandQueue.entries_dir() / file_name(key))
        picked = isinstance(entry, dict) and entry.get("requestId") == rid
        if picked:
            leash.see(land_progress(entry))
        if not running or (picked and (wait <= 0 or entry.get("state") in LAND_DONE)) or leash.left() <= 0:
            break
        time.sleep(0.5 if not picked else 1.0)
    picked = isinstance(entry, dict) and entry.get("requestId") == rid
    state = entry.get("state") if picked else "requested"
    out = {"ok": running, "key": key, "state": state, "requester": requester, "request": rid,
           "entry": entry if picked else None, "lane": lane}
    if wait > 0 and running and state not in ("merged", "stopped", "cancelled"):
        out.update(leash.fields())
    if no_lane:
        out["laneWarning"] = no_lane
    if not running:
        out.update(code="daemon_down", reason=down_message(), next="glaeda-gh restart")
    if as_json:
        print(json.dumps(out, sort_keys=True))
    else:
        print(land_line(entry, time.time()) if picked else f"{key_name(key)} requested; the daemon takes it next tick")
        if not running:
            say_waiting(f"glaeda-gh: {down_message()} The request stays queued for it.")
            say_waiting("next: glaeda-gh restart")
        elif not requester:
            say_waiting("glaeda-gh land: no --notify and no session in the environment ($ACPMUX_SESSION_NAME, ...): "
                        "a stop or a merge is only a notice line (glaeda-gh land status shows it)")
    if not running:
        return EXIT_DOWN
    if state == "merged":
        return EXIT_OK
    if state in ("stopped", "cancelled"):
        return EXIT_FAIL
    return EXIT_TIMEOUT if wait > 0 else EXIT_OK


def cmd_land_cancel(target: str, as_json: bool) -> int:
    key = land_key(target)[0]
    executor = land_executor()
    if executor is not None and not land_outbox_busy(key):
        rid = f"{policy_host()}-{time.time_ns()}-{os.getpid()}"
        staged = land_request_path(land_request(LAND_WITHDRAW, target, [], land_requester(None), rid=rid,
                                                queued_by=land_queued_by()))  # before the forward (cmd_land_forwarded)
        try:
            got = land_forward(executor, {"op": LAND_WITHDRAW, "target": target, "after": [],
                                          "requester": land_requester(None), "queuedBy": land_queued_by(), "id": rid})
        except WatchError as error:
            say_waiting(f"glaeda land: {error}; the cancel waits here and is forwarded when it answers")
        else:
            if got.get("ok"):
                staged.unlink(missing_ok=True)
            else:
                say_waiting(f"glaeda land: {land_trim(got.get('reason') or got.get('code'), 200)}; the cancel waits "
                            "here and is forwarded when it answers")
    else:
        land_request(LAND_WITHDRAW, target, [], land_requester(None))
    if as_json:
        print(json.dumps({"ok": True, "key": key, "state": "cancel requested"}))
    else:
        print(f"{key_name(key)}: cancel requested")
    return EXIT_OK


def land_serve_one(req: Any) -> tuple[str | None, str]:
    """Write one forwarded land or withdraw request into this host's queue: (its id, "") or (None, why not)."""
    if not isinstance(req, dict) or req.get("op") not in ("land", LAND_WITHDRAW):
        return None, "a request is a land or a withdraw"
    try:
        land_key(str(req.get("target") or ""))
        after = [str(a) for a in req.get("after") or []]
        for a in after:
            land_key(a)
    except (WatchError, TypeError):
        return None, f"not a pull request: {str(req.get('target'))[:80]!r}"
    try:
        land_pin_sha(req.get("sha"))
    except WatchError as error:
        return None, str(error)
    requester = str(req.get("requester") or "")
    if requester and not LAND_REQUESTER_SHAPE.fullmatch(requester):
        return None, f"not a requester (HOST/SESSION, no spaces, at most 200): {requester[:80]!r}"
    queued_by = str(req.get("queuedBy") or "")
    queued_by = queued_by if re.fullmatch(r"[A-Za-z0-9._:/-]{1,200}", queued_by) else "tool:land-forward"
    rid = land_request(str(req["op"]), str(req["target"]), after, requester, str(req.get("requesterFrom") or "")[:80],
                       rid=str(req.get("id") or ""), queued_by=queued_by, lane=land_request_lane(req),
                       sha=land_pin_sha(req.get("sha")), override=land_request_override(req))
    return rid, ""


def cmd_land_serve(text: str) -> int:
    """`land serve`: the executor's end of land.json's "executor" on a forwarding host. One JSON request line on stdin
    ({"op": "land" | "withdraw" | "status" | "batch", ...}), one JSON answer line on stdout. A host that forwards its
    own lands is no executor: it refuses, so two hosts never hand a PR back and forth."""
    try:
        req = json.loads(text)
    except ValueError:
        req = None
    if not isinstance(req, dict) or req.get("op") not in LAND_SERVE_OPS:
        print(json.dumps({"ok": False, "code": "bad_request", "reason": f"land serve takes one JSON line with an op "
                                                                        f"of {', '.join(LAND_SERVE_OPS)}"}))
        return EXIT_FAIL
    executor = land_executor()
    if executor is not None:
        print(json.dumps({"ok": False, "code": "not_executor", "reason": f"{policy_host()} forwards its own lands to "
                          f"{land_forward_name(executor)} (land.json executor); it serves none"}))
        return EXIT_FAIL
    op = req["op"]
    if op == "room":
        # A peer's overflow asks before it sends (land_overflow): never room while the daemon is down
        running = daemon_running()
        print(json.dumps({"ok": True, "host": policy_host(), "running": running,
                          "room": land_room(read_json(land_dir() / LAND_POOL_FILE), time.time()) if running else 0},
                         sort_keys=True))
        return EXIT_OK
    if op == "status":
        target = req.get("target")
        try:
            print(json.dumps({**land_status_doc(target if isinstance(target, str) and target else None),
                              "host": policy_host()}, sort_keys=True))
        except WatchError as error:
            print(json.dumps({"ok": False, "code": "bad_request", "reason": str(error)}))
            return EXIT_FAIL
        return EXIT_OK
    mh, tried = land_judge(land_config())
    if mh is None and op in ("land", "batch"):
        why, nxt = land_judge_missing(tried)
        print(json.dumps({"ok": False, "code": "land_judge_missing", "reason": why, "next": nxt,
                          "host": policy_host()}, sort_keys=True))
        return EXIT_FAIL
    if op == "land":
        # The executor holds the cache (a forwarding host's may know nothing of the PR), so the request-time draft
        # answer is given here too, in the shape the forwarder prints and exits on (LAND_REQUEST_REFUSED).
        try:
            key, repo, number = land_key(str(req.get("target") or ""))
            pin = land_pin_sha(req.get("sha"))
        except (WatchError, TypeError):
            key = repo = pin = ""  # land_serve_one below answers a target or pin this host cannot read
            number = 0
        draft = land_draft_refusal(key, repo, number, pin) if key else None
        if draft is not None:
            print(json.dumps({"ok": False, "key": key, "code": "land_draft", "reason": draft[0], "next": draft[1],
                              "host": policy_host()}, sort_keys=True))
            return EXIT_FAIL
    if op == "batch":
        accepted, refused = [], []
        for item in (req.get("requests") or [])[:LAND_FORWARD_BATCH]:
            rid, why = land_serve_one(item)
            if rid is None:
                refused.append({"id": (item or {}).get("id") if isinstance(item, dict) else None, "why": why})
            else:
                accepted.append(rid)
        print(json.dumps({"ok": True, "accepted": accepted, "refused": refused, "host": policy_host(),
                          "running": daemon_running()}, sort_keys=True))
        return EXIT_OK
    rid, why = land_serve_one(req)
    if rid is None:
        print(json.dumps({"ok": False, "code": "bad_request", "reason": why}))
        return EXIT_FAIL
    key = land_key(str(req["target"]))[0]
    running = daemon_running()
    entry = None
    if op == "land":
        wait = req.get("wait") if isinstance(req.get("wait"), (int, float)) else 0
        ceiling = req.get("max") if isinstance(req.get("max"), (int, float)) and req.get("max") > 0 else None
        # as a local `land --wait`: no change for WAIT, never past its --max (or a day)
        leash = Leash(max(0.0, min(float(wait), 86400.0)),
                      None if ceiling is None else min(float(ceiling), 86400.0))
        leash.ceiling = min(leash.ceiling, 86400.0)
        while running:
            entry = read_json(LandQueue.entries_dir() / file_name(key))
            picked = isinstance(entry, dict) and entry.get("requestId") == rid
            if picked:
                leash.see(land_progress(entry))
            if (picked and (wait <= 0 or entry.get("state") in LAND_DONE)) or leash.left() <= 0:
                break
            time.sleep(0.5 if not picked else 1.0)
    picked = isinstance(entry, dict) and entry.get("requestId") == rid
    out = {"ok": True, "key": key, "state": entry.get("state") if picked else "requested", "request": rid,
           "requester": req.get("requester") or "", "entry": entry if picked else None, "host": policy_host(),
           "running": running}
    if not running:
        out.update(code="daemon_down", reason="the executor's daemon is down; the request stays queued there")
    print(json.dumps(out, sort_keys=True))
    return EXIT_OK


def utc_stamp(at: float) -> str:
    """An ISO UTC timestamp to the second (`2026-11-17T14:52:03Z`), or "unknown"."""
    try:
        return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(at))
    except (ValueError, OSError, OverflowError):
        return "unknown"


def refresh_log_write(line: str) -> None:
    """One refresh-failure line on stderr and in BASE/REFRESH_LOG, cut to its newest half past REFRESH_LOG_MAX.
    Never raises: writing down a failure must not become one."""
    with contextlib.suppress(Exception):
        print(line, file=sys.stderr, flush=True)
    path = BASE / REFRESH_LOG
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with path.open("a") as stream:
            stream.write(line + "\n")
        if path.stat().st_size > REFRESH_LOG_MAX:
            data = path.read_bytes()
            keep = data[len(data) - REFRESH_LOG_MAX // 2:]
            keep = keep[keep.find(b"\n") + 1:] if b"\n" in keep else b""
            tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
            tmp.write_bytes(keep)
            tmp.replace(path)
    except Exception:  # noqa: BLE001
        pass


def refresh_log_tail(n: int = REFRESH_LOG_SHOWN) -> list[str]:
    """The last N lines of BASE/REFRESH_LOG ([] when there is none)."""
    try:
        with (BASE / REFRESH_LOG).open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            stream.seek(max(0, stream.tell() - 64 * 1024))
            lines = stream.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []
    return lines[-n:] if n > 0 else []


def log(event: dict) -> None:
    print(json.dumps({"at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), **event}), flush=True)


def clear_failing() -> None:
    """Drop the previous process's "failing" record. A restart or a re-exec (which is how a fix
    arrives) must not leave clients exiting 3 on it until the first good tick, which can take minutes."""
    status = read_json(BASE / "daemon.json")
    if isinstance(status, dict) and "failing" in status:
        status.pop("failing")
        write_json(BASE / "daemon.json", status)


TEMP_FILE = re.compile(r"\.(?P<name>.+)\.(?P<pid>\d+)\.\d+\.tmp")  # write_json's temporary files


def sweep_temp_files(now: float | None = None) -> int:
    """Remove write_json's temporary files under BASE that an earlier write left when it was cut off (before
    write_json cleaned up after itself): only one whose writer pid is gone and that is an hour old. How many."""
    now = time.time() if now is None else now
    gone = 0
    for folder in (BASE, *(p for p in BASE.iterdir() if p.is_dir())) if BASE.is_dir() else ():
        for path in folder.glob(".*.tmp"):
            found = TEMP_FILE.fullmatch(path.name)
            if found is None or waiter_alive(int(found["pid"])):
                continue
            with contextlib.suppress(OSError):
                if now - path.stat().st_mtime >= 3600:
                    path.unlink()
                    gone += 1
    return gone


def first_heartbeat(now: float | None = None) -> None:
    """Write a heartbeat as soon as the lock is ours, before the first tick (which can take
    TICK_BUDGET and more). Until then daemon.json held the previous process's last heartbeat, so a
    restarted daemon still looked hung, and on 10-20 each session that read that restarted it again,
    killing the new daemon inside its first tick."""
    now = time.time() if now is None else now
    status = read_json(BASE / "daemon.json")
    status = status if isinstance(status, dict) else {}
    status.pop("failing", None)
    status.pop("staleWaited", None)  # the previous process's starvation is not this one's (daemon_starved)
    for stale in ("newestData", "stalled", "healthy"):  # nor its stalled refresh loop (stall_alarm)
        status.pop(stale, None)
    before = status.pop("stale", None)  # nor its verdict (stale_record): kept only as the last one, for `restart`
    if isinstance(before, dict):
        last = before if before.get("state") in ("held", "stale") else before.get("last")
        status["stale"] = {"state": "starting", **({"last": last} if isinstance(last, dict) else {})}
    write_json(BASE / "daemon.json", {**status, "pid": os.getpid(), "at": now, "startedAt": now,
                                      "heartbeat": HEARTBEAT_EVERY})


class Watchdog:
    """Exits the process (EXIT_WATCHDOG) once the serve loop has not come round for `limit` seconds,
    so launchd (KeepAlive) or systemd (Restart=always) starts a fresh daemon. A thread, so it fires
    while the loop is stuck where no deadline reaches: a name lookup, a full disk, a bug. Before it
    exits it prints where every thread was (file, line, function; no values) to stderr."""

    def __init__(self, limit: float, clock: Callable[[], float] = time.monotonic,
                 exit: Callable[[int], Any] = os._exit, backstop: float | None = None,
                 where: Callable[[], dict | None] | None = None,
                 reap: Callable[[], Any] | None = None) -> None:
        self.limit, self.clock, self.exit, self.backstop = limit, clock, exit, backstop
        self.reap = reap  # run on every check: frees slots held past their bound (Daemon.free_slots), even mid-tick
        self.where = where  # what the loop was doing (Daemon.progress: the request in flight and its age), logged
        self.last = clock()

    def beat(self) -> None:
        self.last = self.clock()
        if self.backstop is not None:  # re-arming cancels the previous timer
            faulthandler.dump_traceback_later(self.limit + self.backstop, exit=True)

    def check(self) -> bool:
        """True (after calling exit) when the loop is overdue."""
        if self.reap is not None:
            with contextlib.suppress(Exception):
                self.reap()
        lag = self.clock() - self.last
        if lag <= self.limit:
            return False
        doing = None
        with contextlib.suppress(Exception):  # read from another thread: a best-effort snapshot
            doing = self.where() if self.where is not None else None
        log({"event": "watchdog", "silentFor": int(lag), "limit": int(self.limit), "pid": os.getpid(),
             **({"thread": "main", "inCall": doing.get("inCall"), "lastCall": doing.get("lastCall")}
                if isinstance(doing, dict) else {})})
        with contextlib.suppress(Exception):  # stderr may not be a real file (tests)
            print(f"glaeda-gh: watchdog: the serve loop has not come round for {int(lag)}s (limit {int(self.limit)}s); "
                  f"exiting {EXIT_WATCHDOG} so the service manager restarts the daemon. Where each thread was:",
                  file=sys.stderr, flush=True)
            faulthandler.dump_traceback(file=sys.stderr, all_threads=True)
        self.exit(EXIT_WATCHDOG)
        return True

    def start(self) -> threading.Thread:
        def run() -> None:
            # hard_deadline's SIGALRM is meant for the main thread's blocking read. A process-directed
            # signal goes to any thread that does not block it, and taken here it interrupts nothing.
            if hasattr(signal, "pthread_sigmask"):
                signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGALRM})
            while not self.check():
                time.sleep(max(0.05, min(15.0, self.limit / 10)))

        thread = threading.Thread(target=run, name="glaeda-gh-watchdog", daemon=True)
        thread.start()
        self.beat()
        return thread


def try_lock(lock: Any) -> bool:
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def record_holder(lock: Any) -> None:
    """Name this process in daemon.lock, so a waiting daemon can tell whom to stop when it hangs."""
    lock.seek(0)
    lock.truncate()
    lock.write(json.dumps({"pid": os.getpid(), "since": time.time()}) + "\n")
    lock.flush()


def lock_holder(now: float | None = None) -> dict | None:
    """The recorded lock holder: {"pid", "silent"}, silent being the seconds since its last
    heartbeat (or since it took the lock, before its first). None without a record. A holder older
    than this record format writes none, so it is not known here."""
    now = time.time() if now is None else now
    try:
        record = json.loads((BASE / "daemon.lock").read_text() or "null")
    except (OSError, ValueError):
        return None
    pid = record.get("pid") if isinstance(record, dict) else None
    since = record.get("since") if isinstance(record, dict) else None
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0 or not isinstance(since, (int, float)):
        return None
    status = read_json(BASE / "daemon.json")
    at = status.get("at") if isinstance(status, dict) and status.get("pid") == pid else None
    last = max(since, at) if isinstance(at, (int, float)) else since
    return {"pid": pid, "silent": now - last}


def is_serve(pid: int) -> bool:
    """Whether `pid` is a live glaeda-gh serve other than this process (not a reused pid)."""
    if pid == os.getpid():
        return False
    try:
        os.kill(pid, 0)
    except OSError:  # gone, or another user's
        return False
    try:
        result = run_bounded(["ps", "-ww", "-o", "command=", "-p", str(pid)], 10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    words = result.stdout.split()
    return result.returncode == 0 and "serve" in words and any(Path(w).name == "glaeda-gh" for w in words)


def take_over(lock: Any, now: float | None = None) -> bool:
    """Stop a hung lock holder and take the lock. Only a recorded holder that is a live glaeda-gh
    serve and has been silent for more than STALE_HEARTBEAT is stopped: SIGTERM, then SIGKILL after
    TAKEOVER_GRACE. True once this process holds the lock."""
    holder = lock_holder(now)
    if holder is None or holder["silent"] <= STALE_HEARTBEAT or not is_serve(holder["pid"]):
        return False
    pid = holder["pid"]
    log({"event": "takeover", "pid": pid, "silentFor": int(holder["silent"]), "by": os.getpid()})
    for sig, grace in ((signal.SIGTERM, TAKEOVER_GRACE), (signal.SIGKILL, 5)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            pass
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            if try_lock(lock):
                return True
            time.sleep(0.2)
    return try_lock(lock)


def acquire_lock(lock: Any, sleep: Callable[[float], Any] = time.sleep) -> None:
    """Wait for the daemon lock (a second daemon waits instead of polling twice), taking it over
    from a holder whose heartbeat went stale."""
    waiting = False
    while not try_lock(lock):
        if not waiting:
            holder = lock_holder()
            log({"event": "waiting", "pid": os.getpid(), "holder": holder and holder["pid"]})
            waiting = True
        if take_over(lock):
            break
        sleep(LOCK_RETRY)
    record_holder(lock)


def hold_daemon_lock() -> Any:
    """Take the daemon lock on the file at BASE/daemon.lock. A daemon that waited on a file which was
    moved or replaced meanwhile (a daemon before it re-executed off it) lets that one go and waits on
    the current file instead, so two daemons never poll, each locking a different inode."""
    while True:
        BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
        lock = open(BASE / "daemon.lock", "a+")
        acquire_lock(lock)
        if not lock_replaced(lock):
            return lock
        log({"event": "relock", "pid": os.getpid()})
        lock.close()


# An update (the script on disk changed) re-executes the daemon, but not under a running land step, so the new daemon
# never sends a step beside one the old one runs. cosmic-gray, 2026-11-17: a busy land queue always had a step
# running (explains back to back), so the re-exec waited 11:41-12:06Z and again from 12:39Z until a forced restart:
# glaeda#2092 was installed at 12:41Z and the daemon ran the old code. Now a waiting re-exec starts no new land step
# (land_tick), so it waits only for the steps in flight, and at most REEXEC_DRAIN_MAX: a step's claim is written before
# it starts, and a restart judges a claimed step again rather than run it twice (LandQueue.claim).
REEXEC_DRAIN_MAX = 300.0
# A release update re-execs a daemon with land work running at most once per this many seconds of its uptime; until
# then the update waits and the land queue works on ("hold"). huge-blue, 2026-11-18: glaeda main merges re-exec'd the
# daemon at 14:51, 15:06, 15:09, 15:22 and 15:24Z, each dropping every judgment in flight. Idle, it re-execs at once.
REEXEC_UPDATE_GAP = 1800.0


def reexec_due(changed: bool, busy: bool, waiting_since: float | bool, now: float,
               up: float = REEXEC_UPDATE_GAP) -> str | None:
    """What serve does about an update: None (nothing changed), "hold" (land work runs and the daemon is up under
    REEXEC_UPDATE_GAP: it goes on, the update waits), "defer" (draining: the running land jobs end, no new one starts),
    "reexec", or a reason string for a re-exec past REEXEC_DRAIN_MAX with a job still running."""
    if not changed:
        return None
    if not busy:
        return "reexec"
    since = waiting_since if isinstance(waiting_since, (int, float)) and not isinstance(waiting_since, bool) else None
    if since is None and up < REEXEC_UPDATE_GAP:
        return "hold"
    if since is not None and now - since >= REEXEC_DRAIN_MAX:
        return f"a land step still ran after {int(REEXEC_DRAIN_MAX)} s; its claim is judged again"
    return "defer"


def serve(foreground_ok: bool = False) -> int:
    lock = hold_daemon_lock()
    first_heartbeat()
    # A daemon started by a gh call holding a GraphQL slot outlives it: its own gh calls (the land pool's) take slots.
    os.environ.pop(GRAPHQL_SLOT_ENV, None)
    with contextlib.suppress(OSError):
        swept = sweep_temp_files()
        if swept:
            log({"event": "swept", "tempFiles": swept})
    me = Path(__file__).resolve()
    stamp = me.stat().st_mtime
    started, held = time.monotonic(), False  # (REEXEC_UPDATE_GAP; "reexec-held" logged once)
    daemon = Daemon()
    log({"event": "start", "pid": os.getpid()})
    with contextlib.suppress(AttributeError, ValueError, RuntimeError, OSError):  # (no SIGUSR1: Windows)
        faulthandler.register(signal.SIGUSR1, file=sys.stderr, all_threads=True)  # STALE_DUMP_ADVICE
    watchdog = Watchdog(WATCHDOG_AFTER, backstop=WATCHDOG_BACKSTOP,
                        where=lambda: {"inCall": daemon.progress_call(), "lastCall": daemon.last_call},
                        reap=lambda: daemon.free_slots())  # (late-bound: a check's error is suppressed)
    watchdog.start()
    last = None
    while True:
        try:
            status = daemon.tick()
            summary = (status["modes"], status["paths"], status["errors"])
            if summary != last and (status["errors"] or last is not None):
                log({"event": "state", "modes": status["modes"], "paths": status["paths"], "errors": status["errors"]})
            last = summary
        except Exception as error:  # noqa: BLE001  keep serving; only the type name is logged
            site = error_site(error)  # plus where it was raised
            log({"event": "error", "error": describe(error), "site": site})
            try:
                daemon.tick_failed(describe(error), site)
            except Exception as report:  # noqa: BLE001  e.g. a full disk: keep serving
                log({"event": "error", "error": describe(report), "site": "tick_failed"})
        time.sleep(TICK)
        watchdog.beat()
        try:
            if daemon.valve_due is not None:
                # the stale valve (Daemon.stale_valve): a fresh daemon, the way an update starts one
                daemon.restart_self()
                os.execv(sys.executable, [sys.executable, os.fspath(me), "serve"] + (["--foreground-ok"] if foreground_ok else []))
            changed = me.stat().st_mtime != stamp
            due = reexec_due(changed, daemon.land_busy(), daemon.reexec_waiting, time.monotonic(),
                             time.monotonic() - started)
            if due == "hold":
                if not held:
                    held = True
                    log({"event": "reexec-held", "why": f"land work runs; the update waits until the daemon has been "
                                                        f"up {int(REEXEC_UPDATE_GAP)} s or the queue is idle"})
            elif due == "defer":
                if not daemon.reexec_waiting:
                    log({"event": "reexec-deferred", "why": "a land step is running; no new one starts until it ends"})
                    daemon.reexec_waiting = time.monotonic()
            elif due is not None:
                log({"event": "reexec", **({"why": due} if due != "reexec" else {})})
                os.execv(sys.executable, [sys.executable, os.fspath(me), "serve"] + (["--foreground-ok"] if foreground_ok else []))
            if lock_replaced(lock):
                # A cleanup moved or deleted BASE (huge-blue, 10-24: a hygiene pass trashed ~/.cache/glaeda):
                # this daemon still polls, but its lock is on a file nobody can see, so every client reads
                # "not running" and restart's start is a no-op on the active unit. Start over on the new path.
                log({"event": "reexec", "why": "daemon.lock was removed or replaced"})
                os.execv(sys.executable, [sys.executable, os.fspath(me), "serve"] + (["--foreground-ok"] if foreground_ok else []))
        except OSError:
            pass


def lock_replaced(lock: Any) -> bool:
    """Whether BASE/daemon.lock is no longer the file this daemon holds its lock on: removed, or another
    file now at that path. An unreadable path is not proof, so that answers False."""
    try:
        here = os.stat(BASE / "daemon.lock")
    except FileNotFoundError:
        return True
    except OSError:
        return False
    mine = os.fstat(lock.fileno())
    return (here.st_dev, here.st_ino) != (mine.st_dev, mine.st_ino)


SYSTEMD_UNIT = "glaeda-gh.service"


def under_service() -> bool:
    """Whether this process is the service manager's glaeda-gh (launchd names its job in
    XPC_SERVICE_NAME; systemd puts its unit in the process's cgroup)."""
    if os.environ.get("XPC_SERVICE_NAME") == LAUNCH_LABEL:
        return True
    try:
        return SYSTEMD_UNIT in Path("/proc/self/cgroup").read_text()
    except OSError:
        return False


def service_loaded() -> bool:
    """Whether this user's glaeda-gh service is loaded (launchd) or enabled or running (systemd), or about to be
    (a restart in progress). Between a restart's bootout and its bootstrap nothing is loaded, and a shell serve
    started then would take daemon.lock from the service, so the probes run holding restart.lock (cmd_restart):
    a restart that holds it counts as loaded, and none can begin while they run."""
    try:
        BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
        guard = open(BASE / "restart.lock", "a+")
    except OSError:
        return True  # cannot tell whether a restart is in progress
    with guard:
        return not try_lock(guard) or service_probed()


def service_probed() -> bool:
    """service_loaded's probes, without restart.lock."""
    if sys.platform == "darwin":
        # the LaunchAgent, the copy restart loads while nobody is logged in (launchd_domain), or the
        # same label as a system LaunchDaemon on a headless Mac. Only a definite "not there" (113, or 125 for a
        # gui domain nobody is logged in to) counts as not loaded: a probe that cannot tell refuses the shell serve
        for target, absent in ((f"gui/{os.getuid()}/{LAUNCH_LABEL}", (NOT_LOADED, NO_GUI_DOMAIN)),
                               (f"user/{os.getuid()}/{LAUNCH_LABEL}", (NOT_LOADED,)),
                               (f"system/{LAUNCH_LABEL}", (NOT_LOADED,))):
            try:
                if run_bounded(["launchctl", "print", target], 10).returncode not in absent:
                    return True
            except (OSError, subprocess.TimeoutExpired):
                return True
        return False
    else:
        probes = [["systemctl", "--user", "--quiet", "is-enabled", SYSTEMD_UNIT],
                  ["systemctl", "--user", "--quiet", "is-active", SYSTEMD_UNIT]]
    for probe in probes:
        try:
            if run_bounded(probe, 10).returncode == 0:
                return True
        except (OSError, subprocess.TimeoutExpired):
            continue
    return False


def serve_refusal() -> str:
    where = (f"the LaunchAgent {LAUNCH_LABEL} is loaded" if sys.platform == "darwin"
             else f"the systemd user unit {SYSTEMD_UNIT} is enabled")
    return (f"serve: refusing to start: {where}, and it runs the daemon. A serve started from a shell only "
            "waits for its lock, or takes it and stops every session's waits when it hangs or its shell goes "
            "away (10-20). Do not run serve yourself. If the daemon is down or hung: "
            f"{RESTART_ADVICE}. To run one in the foreground anyway (debugging): "
            "glaeda-gh serve --foreground-ok")


# ---------------------------------------------------------------- clients


def daemon_running(grace: float = 0.0) -> bool:
    """True while some process holds the daemon lock. With grace, keep looking that long: the lock is
    released for a moment while the daemon re-executes itself after an update."""
    deadline = time.monotonic() + grace
    while True:
        if lock_held():
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def lock_held() -> bool:
    try:
        with open(BASE / "daemon.lock", "r") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(lock, fcntl.LOCK_UN)
            return False
    except OSError:
        return False


LAUNCH_LABEL = "com.teamleaderleo.glaeda.gh-watch"


# launchctl's "5: Input/output error" (cosmic-gray, macOS 27, 10-20): bootstrap answers it whenever the
# service is already loaded (reproduced), so it says nothing about the service's health. kickstart
# answered it while launchd reported "spawn failed" for the job; unloading and loading it starts over.
LAUNCHCTL_ERROR_5 = (f"If launchctl answers \"5: Input/output error\": from bootstrap it means the service is "
                     f"already loaded (kickstart it instead); from kickstart, reload it: launchctl bootout "
                     f"gui/$(id -u)/{LAUNCH_LABEL}; launchctl bootstrap gui/$(id -u) "
                     f"~/Library/LaunchAgents/{LAUNCH_LABEL}.plist. Never run glaeda-gh serve yourself")


def start_hint(restart: bool = False, domain: str | None = None) -> str:
    """How to (re)start the daemon here, including when its service was never loaded."""
    if sys.platform == "darwin":
        domain = domain or launchd_domain()
        if domain is None:
            return DOMAIN_UNKNOWN_HINT[0].upper() + DOMAIN_UNKNOWN_HINT[1:]
        if domain.startswith("user/"):
            try:
                system = system_daemon_loaded()
            except (OSError, subprocess.TimeoutExpired):
                system = None
            if system is None:
                return (f"nobody is logged in here and {SYSTEM_UNKNOWN_HINT}, which loads a Background copy in "
                        f"user/$(id -u). Never run glaeda-gh serve yourself")
            if system:
                return SYSTEM_DAEMON_HINT[0].upper() + SYSTEM_DAEMON_HINT[1:] + ". Never run glaeda-gh serve yourself"
            return (f"nobody is logged in here, so gui/$(id -u) does not exist and the daemon runs from a Background "
                    f"copy of its LaunchAgent in user/$(id -u): launchctl bootout user/$(id -u)/{LAUNCH_LABEL}; "
                    f"launchctl bootstrap user/$(id -u) {background_copy_path()} (glaeda-gh restart writes that copy). "
                    f"Logging the user in, or a reboot with automatic login, brings the LaunchAgent back. "
                    f"Never run glaeda-gh serve yourself. Its log is ~/Library/Logs/glaeda-gh.err")
        try:
            system = system_daemon_loaded() is not False  # loaded, or launchctl cannot tell
            copy = not unloaded(f"user/{os.getuid()}/{LAUNCH_LABEL}")
        except (OSError, subprocess.TimeoutExpired):
            system = copy = True
        if system or copy:
            return (f"check first that neither the system LaunchDaemon (sudo launchctl print system/{LAUNCH_LABEL}) "
                    f"nor the Background copy of a logged-out restart (launchctl print "
                    f"user/$(id -u)/{LAUNCH_LABEL}) is loaded: either runs the daemon, and the LaunchAgent must "
                    f"not start beside it. Restart a loaded system daemon as root (sudo launchctl kickstart -k "
                    f"system/{LAUNCH_LABEL}); boot a loaded copy out (launchctl bootout user/$(id -u)/{LAUNCH_LABEL}) "
                    f"and run glaeda-gh restart again. Never run glaeda-gh serve yourself")
        if restart:
            return f"launchctl kickstart -k gui/$(id -u)/{LAUNCH_LABEL}. {LAUNCHCTL_ERROR_5}"
        return (f"launchctl kickstart gui/$(id -u)/{LAUNCH_LABEL} (if launchctl cannot find the service, load it: "
                f"launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/{LAUNCH_LABEL}.plist). "
                f"{LAUNCHCTL_ERROR_5}. Its log is ~/Library/Logs/glaeda-gh.err")
    if restart:
        return "systemctl --user restart glaeda-gh"
    return "systemctl --user start glaeda-gh (systemctl --user status glaeda-gh says why it stopped)"


# Every client message names this one command, never launchctl or systemctl: on 10-20 about ten
# sessions each ran `launchctl kickstart -k` on the same advice, every kickstart killed the daemon the
# last one had just started, and launchd throttled the respawns ("spawn scheduled", "spawn failed").
# `restart` is single-flight: one session restarts the daemon, the others are told to wait.
RESTART_ADVICE = ("glaeda-gh restart (safe to run from many sessions at once: one of them restarts it and the "
                  "others are told to wait; do not run launchctl or systemctl yourself)")

DOWN = ("glaeda-gh: the daemon is not running, so nothing is polling GitHub; do not poll GitHub yourself "
        "instead. Start it: " + RESTART_ADVICE + ". If it was never installed: glaeda-mini-setup --hygiene-only --apply."
        "\nnext: glaeda-gh restart")


class DownWait:
    """A wait that finds the daemon down: say so once, keep waiting DOWN_PATIENCE (or to the wait's
    own timeout), then print down_message and give up."""

    def __init__(self) -> None:
        self.said = False

    def patient(self, down_since: float, start: float, timeout: float) -> bool:
        now = time.monotonic()
        if now - down_since >= DOWN_PATIENCE or now - start >= timeout:
            say_waiting(down_message())
            return False
        if not self.said:
            say_waiting(f"glaeda-gh: the daemon is not running; waiting up to {DOWN_PATIENCE}s for it to "
                        "come back (a restart can take that long). Do not restart it from here.")
            self.said = True
        return True


def restart_record() -> dict | None:
    record = read_json(BASE / "restart.json")
    return record if isinstance(record, dict) and isinstance(record.get("at"), (int, float)) else None


def recent_restart(now: float | None = None, holding: bool = False) -> float | None:
    """Seconds since the last `glaeda-gh restart`, while that is under RESTART_COOLDOWN. A restart whose
    command failed does not count: sessions must not be told to wait on a restart that did not happen.
    One that ran but saw no heartbeat within RESTART_SETTLE does: the daemon it started may just be
    slow, and another session restarting it again would kill that one (the 10-19 kickstart storm).
    `holding`: the caller holds restart.lock, so no other restart is in progress, whatever pid wrote a
    "starting" record."""
    record = restart_record()
    if record is None or (record.get("ok") is False and not record.get("ran")):
        return None
    if record.get("how") == "starting" and (holding or not alive(record.get("by"))):
        return None  # a restart that died before it finished: nothing is starting a daemon
    ago = (time.time() if now is None else now) - record["at"]
    return ago if 0 <= ago < RESTART_COOLDOWN else None


def alive(pid: Any) -> bool:
    """Whether `pid` (the restart that wrote a "starting" record) still runs. Never touches restart.lock,
    so it cannot make a real restart's lock attempt fail."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:  # another user's: it exists
        return True
    return True


def down_message() -> str:
    ago = recent_restart()
    if ago is None:
        return DOWN
    return (f"glaeda-gh: the daemon is not running yet; a session restarted it {int(ago)}s ago and launchd can "
            "hold a respawn back for 30s. Do not restart it again and do not poll GitHub yourself: re-run your "
            f"command in a minute. If it is still down {RESTART_COOLDOWN}s after that restart: {RESTART_ADVICE}."
            "\nnext: none (a restart is under way; re-run this command in a minute)")


def daemon_stale() -> float | None:
    """Seconds since the daemon's last heartbeat, when that is so long ago that it looks hung."""
    holder = lock_holder() if lock_held() else None
    if holder is not None:
        # The holder's own record: its silence counts from its last heartbeat, or from when it took
        # the lock when daemon.json is its predecessor's (before its first heartbeat), missing or
        # unreadable. One read of daemon.json, so a heartbeat written meanwhile is never missed.
        lag = holder["silent"]
    else:
        status = read_json(BASE / "daemon.json")
        # an older daemon (no holder record) wrote daemon.json only when it fetched something: its
        # silence means nothing
        at = status.get("at") if isinstance(status, dict) and status.get("heartbeat") else None
        if not isinstance(at, (int, float)):
            return None
        lag = time.time() - at
    return lag if lag > STALE_HEARTBEAT else None


def unit_active_for() -> tuple[float, int] | None:
    """Linux: (seconds since glaeda-gh.service last became active, its main pid). None when it is not
    active, on macOS, or when systemctl cannot say."""
    if sys.platform == "darwin":
        return None
    try:
        result = run_bounded(["systemctl", "--user", "show", SYSTEMD_UNIT, "-p", "ActiveState",
                              "-p", "ActiveEnterTimestampMonotonic", "-p", "MainPID"], SUBPROCESS_DEADLINE)
    except (OSError, subprocess.TimeoutExpired):
        return None
    props = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if result.returncode != 0 or props.get("ActiveState") != "active":
        return None
    try:
        entered = int(props.get("ActiveEnterTimestampMonotonic", "")) / 1e6
        main = int(props.get("MainPID", ""))
    except ValueError:
        return None
    # systemd's monotonic timestamps and time.monotonic() are both CLOCK_MONOTONIC on Linux
    return (time.monotonic() - entered, main) if entered > 0 else None


def silent_unit() -> float | None:
    """Linux: seconds the active unit has written no heartbeat, when no daemon lock is visible and that
    is over STALE_HEARTBEAT (and the unit has been active that long). That daemon is hung where clients
    cannot see its lock (huge-blue, 10-23: a cleanup deleted ~/.cache/glaeda under it), and `systemctl
    --user start` is a no-op on an active unit, so only a restart recovers it. A daemon on this version
    whose lock was only moved re-execs onto the visible one within a tick, writing heartbeats meanwhile,
    so it never looks silent here. Only a heartbeat the unit's own main pid wrote counts: one left by an
    earlier daemon, or an older daemon's fetch record (no heartbeat), says nothing about this one."""
    unit = unit_active_for()
    if unit is None or unit[0] <= STALE_HEARTBEAT:
        return None
    active, main = unit
    status = read_json(BASE / "daemon.json")
    mine = isinstance(status, dict) and status.get("heartbeat") and status.get("pid") == main
    at = status.get("at") if mine else None
    silent = min(time.time() - at, active) if isinstance(at, (int, float)) else active
    return silent if silent > STALE_HEARTBEAT else None


def daemon_starved(status: Any = None) -> dict | None:
    """When the daemon's heartbeat may be fresh but the data a wait is blocked on is not: {"kind", "age", "quota"}
    for the kind with the oldest waited data past STALE_DATA_AFTER (daemon.json staleWaited), else None. "quota" is
    true when GitHub's own limits explain it (GraphQL stopped and REST stopped or at the daemon's share), which a
    restart cannot fix."""
    status = read_json(BASE / "daemon.json") if status is None else status
    if not isinstance(status, dict):
        return None
    verdict = status.get("stale")
    if isinstance(verdict, dict) and verdict.get("state") in ("fresh", "held", "stale"):
        # the daemon's own verdict, the one its alarm and valve acted on (stale_verdict): never judged again here
        if verdict["state"] == "fresh":
            return None
        at = status.get("at") if isinstance(status.get("at"), (int, float)) else time.time()
        age = verdict.get("age") if isinstance(verdict.get("age"), (int, float)) else 0
        reason = str(verdict.get("reason") or "") or None
        helps = verdict.get("restart") is True
        return {"kind": verdict.get("kind") or "pr", "age": age + max(0.0, time.time() - at), "quota": not helps,
                "why": None if helps else reason, "cause": reason}
    stale = status.get("staleWaited")
    if not isinstance(stale, dict):
        return None
    # The freshest live PR watch's data counts too (daemon.json newestData, stall_alarm): a refresh loop that reads
    # nothing starves every wait, including one that has not been blocked long enough for staleWaited to show it.
    newest = status.get("newestData") if isinstance(status.get("newestData"), dict) else {}
    stale = {k: max(v for v in (stale.get(k), newest.get(k)) if isinstance(v, (int, float)) and not isinstance(v, bool))
             for k in set(stale) | set(newest)
             if any(isinstance(v, (int, float)) and not isinstance(v, bool) for v in (stale.get(k), newest.get(k)))}
    bound = status.get("staleAfter") if isinstance(status.get("staleAfter"), (int, float)) else STALE_DATA_AFTER
    at = status.get("at") if isinstance(status.get("at"), (int, float)) else time.time()
    ages = {k: v + max(0.0, time.time() - at) for k, v in stale.items()
            if isinstance(v, (int, float)) and not isinstance(v, bool)}
    kind = max(ages, key=ages.get, default=None)
    if kind is None or ages[kind] <= bound:
        return None
    modes = status.get("modes") if isinstance(status.get("modes"), dict) else {}
    share = status.get("restShare") if isinstance(status.get("restShare"), dict) else {}
    quota = modes.get("graphql") == "stop" and (modes.get("rest") == "stop" or bool(share.get("capped")))
    upstream = (status.get("upstream") if isinstance(status.get("upstream"), dict) else {}).get("state") == "ok"
    held = (status.get("staleWhy") if isinstance(status.get("staleWhy"), dict) else {}).get(kind)
    held = held if isinstance(held, dict) and isinstance(held.get("why"), str) else None
    # The quota explained it until moments ago (STALE_CATCH_UP): the daemon is reading the backlog, and a restart
    # would only start that over (huge-blue 2026-11-15: five restarts, each seconds after an hourly reset).
    explained = status.get("staleExplainedAt") if isinstance(status.get("staleExplainedAt"), dict) else {}
    ended = explained.get(kind)
    ended = time.time() - ended if isinstance(ended, (int, float)) and not isinstance(ended, bool) else None
    catching = ended is not None and 0 <= ended < STALE_CATCH_UP
    why = ("this host reads GitHub through an upstream, whose daemon reads it" if upstream
           else held["why"] if held else "GitHub's quota is spent (GraphQL stopped, REST at its share)" if quota
           else (f"the quota held these reads until {int(ended)}s ago and the daemon is reading the backlog it left, "
                 "waited data first") if catching
           else None)
    causes = status.get("staleCause") if isinstance(status.get("staleCause"), dict) else {}
    cause = causes.get(kind) if isinstance(causes.get(kind), str) else None
    return {"kind": kind, "age": ages[kind],
            "quota": quota or upstream or bool(held and held.get("quota") is True) or catching, "why": why,
            "cause": cause}


def daemon_failing() -> dict | None:
    """The daemon's "failing" record, once every tick has raised for FAILING_AFTER seconds."""
    status = read_json(BASE / "daemon.json")
    broken = status.get("failing") if isinstance(status, dict) else None
    if not isinstance(broken, dict):
        return None
    at, since = status.get("at"), broken.get("since")
    if not isinstance(at, (int, float)) or not isinstance(since, (int, float)) or at - since < FAILING_AFTER:
        return None
    return broken


def failing_message(broken: dict) -> str:
    since = broken.get("since")
    when = dt.datetime.fromtimestamp(since, dt.timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ") \
        if isinstance(since, (int, float)) else "?"
    where = f" at {broken['site']}" if broken.get("site") else ""
    return (f"glaeda-gh: the daemon is running, but every cycle since {when} has failed with "
            f"{broken.get('error') or '?'}{where} ({broken.get('count', '?')} times), so nothing is being "
            "refreshed. Restarting it will not fix this: the installed glaeda-gh needs a fix (scripts/glaeda-gh "
            "in teamleaderleo/glaeda). Tell the user; do not poll GitHub yourself in a loop meanwhile."
            "\nnext: none (the installed glaeda-gh needs a fix; tell the user)")


def stale_message(lag: float) -> str:
    holder = lock_holder()
    who = ""
    if holder is not None and is_serve(holder["pid"]):
        # a holder outside the service is what a restart cannot reach: launchd restarts its own job,
        # which then waits behind the hung one (10-20)
        who = (f" The lock holder is pid {holder['pid']}; the service's waiting daemon stops it once it has been "
               f"silent for {STALE_HEARTBEAT}s, or stop it now: kill {holder['pid']}.")
    return (f"glaeda-gh: the daemon holds its lock but has not written a heartbeat for {int(lag)}s, so it "
            f"looks hung and nothing is being refreshed.{who} Restart it: {RESTART_ADVICE}"
            "\nnext: glaeda-gh restart")


def failing(checks: list[dict]) -> list[dict]:
    return [c for c in checks if (c.get("conclusion") or "").upper() in FAILED]


def cancelled_unstarted(c: dict) -> bool:
    """A PR check cancelled before any step ran: the rescue cancels a job still queued for a runner and
    re-runs it. Unknown steps (never read) count as started, so a real cancellation still fails."""
    return (c.get("conclusion") or "").upper() == "CANCELLED" and c.get("stepCount") == 0


def refused_check(c: dict) -> bool:
    """A PR check whose runner refused the job: its job-started hook step failed at job start."""
    return ((c.get("conclusion") or "").upper() == "FAILURE" and HOOK_STEP in (c.get("failedSteps") or [])
            and quick(c.get("startedAt"), c.get("completedAt")))


def refused_job(job: dict) -> bool:
    """A run's job that a glaeda runner refused (see refused_check); the runner is named, so check it."""
    glaeda = (GLAEDA_RUNNER.search(str(job.get("runner_name") or ""))
              or any(str(label).startswith("glaeda-") for label in job.get("labels") or []))
    return (job.get("conclusion") == "failure" and bool(glaeda) and HOOK_STEP in (job.get("failedSteps") or [])
            and quick(job.get("started_at"), job.get("completed_at")))


def classify(data: dict, now: float | None = None, grace: float = RESCUE_GRACE) -> dict[str, list[dict]]:
    """Split a PR's checks into passed, failed, pending and held. A failed check is held while a job
    of its workflow run was refused at runner setup less than `grace` seconds ago: the rescue re-runs
    that run's failed jobs, dependents such as an aggregate status check included. A check cancelled
    before any step ran is held as long: the rescue cancelled it in the queue and re-runs it."""
    now = time.time() if now is None else now
    checks = data.get("checks") or []
    def recent(c: dict) -> bool:
        return now - (iso_epoch(c.get("completedAt")) or 0) < grace
    held_runs = {c.get("runId") for c in checks if c.get("runId") and refused_check(c) and recent(c)}
    # the rescue cancels the whole run: its jobs that were running come back cancelled with steps
    queued_runs = {c.get("runId") for c in checks if c.get("runId") and cancelled_unstarted(c) and recent(c)}
    out: dict[str, list[dict]] = {"passed": [], "failed": [], "pending": [], "held": []}
    for c in checks:
        cancelled = (c.get("conclusion") or "").upper() == "CANCELLED"
        if c.get("status") != "COMPLETED":
            out["pending"].append(c)
        elif (c.get("conclusion") or "").upper() in FAILED:
            held = (c.get("runId") in held_runs or (cancelled_unstarted(c) and recent(c))
                    or (cancelled and c.get("runId") in queued_runs))
            out["held" if held else "failed"].append(c)
        else:
            out["passed"].append(c)
    return out


def expected_contexts(repo: str) -> tuple[str, ...]:
    """The checks or statuses every head of REPO gets (EXPECTED_CONTEXTS, and EXPECTED_CONFIG's entry, which wins)."""
    doc = read_json(EXPECTED_CONFIG)
    if isinstance(doc, dict) and isinstance(doc.get(repo), list):
        return tuple(str(c) for c in doc[repo] if c)
    return EXPECTED_CONTEXTS.get(repo, ())


def pr_repo(data: dict) -> str:
    match = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/", str(data.get("url") or ""))
    return match.group(1) if match else ""


def expected_missing(data: dict) -> list[str]:
    reported = {c.get("name") for c in data.get("checks") or []}
    return [name for name in expected_contexts(pr_repo(data)) if name not in reported]


def pushed_by(data: dict) -> float | None:
    """The latest the head can have been pushed: the PR's updatedAt (a push updates it) and the daemon's first
    sighting of the head, whichever is earlier; None when neither is known."""
    known = [t for t in (iso_epoch(data.get("updatedAt")), data.get("headSeenAt")) if isinstance(t, (int, float))]
    return min(known) if known else None


def settling(data: dict, now: float, settle: float = SETTLE_GRACE) -> float | None:
    """Seconds left of the head's settle window (SETTLE_GRACE), or None once it is over or cannot be placed."""
    pushed = pushed_by(data)
    if pushed is None:
        return None
    left = pushed + settle - now
    return left if left > 0 else None


def check_counts(contexts: dict) -> dict | None:
    """The rollup's check runs and statuses counted by state over every page (checkRunCountsByState,
    statusContextCountsByState), or None when the read did not ask for them."""
    runs, statuses = contexts.get("checkRunCountsByState"), contexts.get("statusContextCountsByState")
    if not isinstance(runs, list) or not isinstance(statuses, list):
        return None
    tally = lambda rows: {str(r.get("state")): int(r.get("count") or 0) for r in rows  # noqa: E731
                          if isinstance(r, dict) and isinstance(r.get("count"), int)}
    return {"runs": tally(runs), "statuses": tally(statuses)}


COUNT_PENDING = {"QUEUED", "IN_PROGRESS", "PENDING", "WAITING", "REQUESTED", "EXPECTED"}
COUNT_BAD = {"FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "STALE", "ERROR"}


def rollup_red_is_superseded(data: dict) -> bool:
    """Whether a truncated rollup's FAILURE is only superseded attempts: over every page nothing is pending, and no
    more contexts are red than the superseded red attempts shown. manaflow-ai/cmux#41298, 2026-11-11: 191 contexts,
    85 counted checks all passing, and `wait --until done` failed on the rollup's FAILURE from a superseded,
    cancelled "risk evidence" attempt a newer run had replaced. Unknown counts: False (the rollup decides)."""
    counts = data.get("checkCounts")
    if not isinstance(counts, dict):
        return False
    rows = [*(counts.get("runs") or {}).items(), *(counts.get("statuses") or {}).items()]
    if any(state in COUNT_PENDING and n for state, n in rows):
        return False
    red = sum(n for state, n in rows if state in COUNT_BAD)
    # only attempts the rollup itself listed: one add_last_real_contexts read by suite id is in no count (review of
    # #1958: an uncounted superseded red cancelled a real red past page 1)
    superseded = sum(1 for c in data.get("superseded") or []
                     if str(c.get("conclusion") or "").upper() in COUNT_BAD and not c.get("lastRealAttempt"))
    return red <= superseded


def pending_on_every_page(data: dict) -> int:
    """How many contexts of a truncated rollup are still unfinished on every page, shown or not, by the rollup's
    counts, less the superseded attempts shown as pending (those are not counted, as under 100 checks);
    0 when the read did not ask for the counts or the rollup is whole. manaflow-ai/cmux#43515 at f35486bc,
    2026-11-15: 247 contexts, an excused guard red on page 1 and every web / react-apps-check shard past it still
    running; `wait --until done` read 0 pending and exited 1 in 23 s while land_judge refused [webview] on those shards."""
    counts = data.get("checkCounts")
    if not data.get("checksTruncated") or not isinstance(counts, dict):
        return 0
    rows = [*(counts.get("runs") or {}).items(), *(counts.get("statuses") or {}).items()]
    pending = sum(n for state, n in rows if state in COUNT_PENDING)
    superseded = sum(1 for c in data.get("superseded") or []
                     if not c.get("conclusion") and not c.get("lastRealAttempt"))
    return max(0, pending - superseded)


# A job nothing requires, queued and never given a runner, held every `wait --until done` to its deadline: 2026-11-17,
# six cmux heads (cmux#45147 at 8941c2cc among them) waited their whole 90 minutes on "publish artifacts", "upload cmux-tui
# dSYMs" (the overflow runner's 8-vCPU label) and "web / react-apps-base-check" (its 16-vCPU label), queued
# 40+ minutes with runner_id 0 and no steps, while every check that decides had ended an hour before. Such a job
# (straggler_cut) no longer holds a done wait past STRAGGLER_AFTER: the wait ends on the finished checks' verdict and
# names the stragglers. A required one never ends it; it is named at the same bound and the wait goes on.
# STRAGGLER_AFTER is past the slow tail of jobs that did start on that label that day: 15 jobs of ci.yml run
# 44152015850 waited median 21.4 min, p90 25.0, max 25.05 (the stragglers: 40 and 52 min and counting).
STRAGGLER_AFTER = 30 * 60
STRAGGLER_REREAD = 300  # a head's queued check-run list is read again at most this often while it waits
STRAGGLER_FRESH = 90  # ... and once more before a wait ends on it, when it is older than this
STRAGGLER_JOB_READS = 6  # jobs read for labels per pass (each job once: its labels and attempt never change)
STRAGGLER_READ_BUDGET = 30  # seconds one pass's reads may take in a waiter's own process
STRAGGLER_TICK_BUDGET = 10  # ... and in the daemon's tick, through the broker on an upstream host
STRAGGLER_DIR = "stragglers"  # under BASE: one file per PR, the head's queued list and its jobs
STRAGGLER_NOTICE_EVERY = 3600  # one stragglers notice per runner label this often, whatever the heads
STRAGGLER_SEEN = "stragglers-seen.json"  # under BASE: {label: {key: [count, at]}} and when each label was noticed


def check_required(c: dict, data: dict) -> bool:
    """Whether GitHub, the base or this repository's expected contexts require the check C of DATA."""
    return (bool(c.get("required")) or c.get("name") in set(data.get("requiredNames") or [])
            or c.get("name") in expected_contexts(pr_repo(data)))


def queued_unfinished(data: dict) -> list[dict] | None:
    """Every unfinished context of DATA's head, each a queued check run ({name, workflow, startedAt, jobId}), or None:
    something else is unfinished (in progress, waiting, a pending status, a held red), a required check has not
    reported, or the head is past one page and its queued runs have not been read (queuedRuns, straggler_pass). On a
    truncated rollup the counts over every page decide what is unfinished, so it costs no read to say None."""
    checks = data.get("checks") or []
    if data.get("checksPageError") or data.get("requiredMissing") or data.get("requiredUnread"):
        return None
    if classify(data)["held"]:
        return None
    shown = [c for c in checks if c.get("status") != "COMPLETED"]
    if any(c.get("status") != "QUEUED" or not c.get("jobId") for c in shown):
        return None
    if not data.get("checksTruncated"):
        return shown
    counts = data.get("checkCounts")
    if not isinstance(counts, dict):
        return None
    runs, statuses = counts.get("runs") or {}, counts.get("statuses") or {}
    if any(n for state, n in statuses.items() if state in COUNT_PENDING):
        return None
    if any(n for state, n in runs.items() if state in COUNT_PENDING and state != "QUEUED"):
        return None
    superseded = sum(1 for c in data.get("superseded") or []
                     if not c.get("conclusion") and not c.get("lastRealAttempt"))
    total = max(0, int(runs.get("QUEUED") or 0) - superseded)
    read = data.get("queuedRuns")
    if not isinstance(read, list):
        return None
    merged = {c["jobId"]: c for c in shown}
    for c in read:
        if isinstance(c, dict) and c.get("jobId"):
            merged.setdefault(c["jobId"], c)
    if data.get("queuedRunsCount") != counts_print(data) or len(merged) < total:
        # read when any count was another (a queued run that started and finished while another was queued leaves
        # QUEUED the same, never the rest), or short of it: read again first (straggler_pass)
        return None
    return list(merged.values())


def num(value: Any) -> float:
    """VALUE as seconds since the epoch, 0 for anything that is not a number (a store written by hand or cut short)."""
    return float(value) if isinstance(value, (int, float)) and not isinstance(value, bool) else 0.0


def counts_print(data: dict) -> str:
    """DATA's rollup counts over every page and its context total, as one string: a queued list read at another print
    may name other runs, whatever its QUEUED count."""
    counts = data.get("checkCounts") if isinstance(data.get("checkCounts"), dict) else {}
    return json.dumps([counts.get("runs") or {}, counts.get("statuses") or {}, data.get("checksTotal")],
                      sort_keys=True, default=str)


def straggler_of(c: dict, data: dict, now: float, bound: float = STRAGGLER_AFTER) -> dict | None:
    """The queued check run C as a straggler {name, workflow, label, minutes, required}, or None while it may still
    start: queued less than BOUND, or its job is unread, has a runner, is not queued, or is a rerun (attempt past 1,
    which has no startedAt in the rollup either)."""
    started = iso_epoch(c.get("startedAt"))
    if started is None or now - started < bound:
        return None
    job = (data.get("queuedJobs") or {}).get(str(c.get("jobId")))
    if not isinstance(job, dict) or job.get("status") != "queued" or job.get("runner") or job.get("attempt") != 1:
        return None
    # a job's workflow_name is its run's name: a run-name such as "v1;sha=...;ref=..." names no workflow
    named = str(job.get("workflow") or "")
    return {"name": c.get("name"), "workflow": c.get("workflow") or ("" if ";" in named else named),
            "label": ",".join(job.get("labels") or []) or "?", "minutes": int((now - started) // 60),
            "required": check_required(c, data), "jobId": c.get("jobId")}


def straggler_cut(data: dict, now: float, bound: float = STRAGGLER_AFTER) -> dict | None:
    """DATA without its stragglers, when every unfinished context is one that nothing requires (straggler_of): the
    head as if they were not there, for check_verdict to judge as before (its "stragglers" name them). None when any
    unfinished context is not such a straggler, or the head has none."""
    if data.get("stragglers") is not None:
        return None  # already cut
    if data.get("checksTruncated") and now - float(data.get("queuedRunsAt") or 0) > STRAGGLER_REREAD + STRAGGLER_FRESH:
        return None  # the queued list past page 1 is too old to end a wait on (a read that keeps failing)
    queued = queued_unfinished(data)
    if not queued:
        return None
    found = [straggler_of(c, data, now, bound) for c in queued]
    if any(s is None or s["required"] for s in found):
        return None
    ids = {c.get("jobId") for c in queued}
    cut = {**data, "stragglers": found,
           "checks": [c for c in data.get("checks") or [] if c.get("jobId") not in ids]}
    if data.get("checksTruncated") and isinstance(data.get("checkCounts"), dict):
        counts = data["checkCounts"]
        runs = {state: n for state, n in (counts.get("runs") or {}).items() if state != "QUEUED"}
        cut["checkCounts"] = {**counts, "runs": runs}
        if data.get("checkState") not in {"FAILURE", "ERROR"}:
            rows = [*runs.items(), *(counts.get("statuses") or {}).items()]
            cut["checkState"] = "FAILURE" if any(n for state, n in rows if state in COUNT_BAD) else "SUCCESS"
    return cut


def straggler_lines(data: dict, now: float, bound: float = STRAGGLER_AFTER) -> list[str]:
    """What a done wait says of its stragglers: the ones it ended without, and a required one it goes on waiting for."""
    lines = []
    def said(items: list[dict]) -> str:
        return "; ".join(f"{s['name']} ({s['workflow'] or '?'}, {s['label']}, {s['minutes']} min)" for s in items)
    ended = [s for s in data.get("stragglers") or [] if not s.get("required")]
    if ended:
        lines.append(f"  stragglers, not required, queued with no runner past {int(bound // 60)} min (a done wait ends "
                     f"inconclusive on them, never success; land_judge counts them running, checks_queued_no_runner): "
                     f"{said(ended)}. "
                     + STRAGGLER_STEP.format(label="its label"))
    queued = queued_unfinished(data) if data.get("stragglers") is None else None
    required = [s for s in (straggler_of(c, data, now, bound) for c in queued or []) if s and s["required"]]
    if required:
        lines.append(f"  required, queued with no runner past {int(bound // 60)} min (the wait goes on): "
                     f"{said(required)}. " + STRAGGLER_STEP.format(label="its label"))
    return lines


def straggler_path(key: str) -> Path:
    return BASE / STRAGGLER_DIR / f"{file_name(key)}.json"


def straggler_wants(data: dict, now: float, bound: float = STRAGGLER_AFTER) -> tuple[bool, list[int]]:
    """(read the queued list, the job ids to read) that would let straggler_cut rule on DATA: nothing when something
    other than queued check runs is unfinished. Costs no request: the rollup's counts say so first."""
    if data.get("state") != "OPEN":
        return False, []
    probe = {**data, "queuedRuns": data.get("queuedRuns") or [], "queuedRunsCount": data.get("queuedRunsCount", -1)}
    trunc = bool(data.get("checksTruncated"))
    if trunc:
        counts = (data.get("checkCounts") or {}).get("runs") or {}
        if not counts.get("QUEUED"):
            return False, []
        probe["queuedRunsCount"] = counts_print(data)
        probe["queuedRuns"] = [{"jobId": -i - 1} for i in range(int(counts["QUEUED"]))]  # the shape alone
        if queued_unfinished(probe) is None:
            return False, []
    queued = queued_unfinished(data)
    if queued is None:
        return trunc, []
    jobs = data.get("queuedJobs") or {}
    old = [c for c in queued if (iso_epoch(c.get("startedAt")) or now) <= now - bound]
    return False, [int(c["jobId"]) for c in old if str(c["jobId"]) not in jobs][:STRAGGLER_JOB_READS]


def straggler_get(repo: str, paths: list[str], budget: float = STRAGGLER_READ_BUDGET) -> dict[str, Any]:
    """{path: doc or an error string} for each GET of /repos/REPO/PATH, read by this process the way direct_read
    reads: this host's login, or the broker's GET on an upstream host, within BUDGET seconds. Never a whole
    check-runs list: the callers ask for queued runs only, and single jobs. The daemon reads through its own queue
    instead (Daemon.straggler_reads)."""
    broker = direct_command() if upstream_command() is not None else None
    if upstream_command() is not None and broker is None:
        return {p: DIRECT_UPSTREAM for p in paths}
    if broker is not None:
        daemon = read_token_reader(f"pr:{repo}#0") or Daemon(
            transport=broker_transport(broker, lambda: daemon.tick_deadline), token=lambda: "",
            controller=None, upstream=None)
        daemon.reads_protection = False
        daemon.etags = isinstance(daemon.app_pool, ReadTokenPool)
    else:
        daemon = Daemon(controller=None, upstream=None)
    modes = (read_json(BASE / "daemon.json") or {}).get("modes")
    if daemon.mode("rest") == "stop" or (isinstance(modes, dict) and modes.get("rest") == "stop"):
        return {p: DIRECT_QUOTA for p in paths}
    daemon.charge_rest = lambda minute, n: None  # type: ignore[method-assign]  (as direct_read: a session's read)
    daemon.now = time.time()
    daemon.tick_deadline = time.monotonic() + budget
    out: dict[str, Any] = {}
    with daemon.calling(*caller_of(f"pr:{repo}#0"), "tool:glaeda-gh wait (queued jobs)"):
        for path in paths:
            try:
                state, doc, _ = daemon.get(f"/repos/{repo}/{path}", None)
            except OutOfTime:
                state, doc = "error", "out of time"
            out[path] = doc if state == "fresh" else str(doc)
    return out


head_runs_get = straggler_get  # head_runs_unfinished's reader outside the daemon (a test swaps in its fake)


def straggler_pass(key: str, data: dict, now: float, get: Callable[[str, list[str]], dict] | None = None,
                   bound: float = STRAGGLER_AFTER) -> dict:
    """DATA with what is known of its queued check runs (queuedRuns, queuedRunsCount, queuedJobs), reading only what
    straggler_wants names and only as often as STRAGGLER_REREAD allows: one `commits/SHA/check-runs?status=queued`
    (sized by the queued runs, not by the head's checks) and one `actions/jobs/ID` per queued run past BOUND."""
    head = str(data.get("headRefOid") or "")
    repo = pr_repo(data)
    if not head or not repo or data.get("state") != "OPEN":
        return data
    path = straggler_path(key)
    store = read_json(path)
    if not isinstance(store, dict) or store.get("head") != head:
        store = {"head": head, "jobs": {}}
    jobs = store.get("jobs") if isinstance(store.get("jobs"), dict) else {}
    merged = {**data, "queuedJobs": jobs}
    if isinstance(store.get("runs"), list):
        merged.update(queuedRuns=store["runs"], queuedRunsCount=store.get("count", -1), queuedRunsAt=store.get("at"))
    want_list, want_jobs = straggler_wants(merged, now, bound)
    count = counts_print(data)
    age = now - num(store.get("at"))
    if want_list:
        # unread, read at other counts (a run started, finished or was queued since), or old
        want_list = store.get("count") != count or age >= STRAGGLER_REREAD
    elif data.get("checksTruncated") and isinstance(store.get("runs"), list):
        # about to end on it: the list must be this fresh, so a run queued since is never missed
        # (judged as if it were fresh: straggler_cut refuses an old list, which only this read can renew)
        want_list = age >= STRAGGLER_FRESH and straggler_cut({**merged, "queuedRunsAt": now}, now, bound) is not None
    # a list read is tried at most once per STRAGGLER_FRESH, answered or not (a read that keeps failing is no loop)
    want_list = want_list and now - num(store.get("listTried")) >= STRAGGLER_FRESH
    if want_list:
        store["listTried"] = now
    tried = store.get("tried") if isinstance(store.get("tried"), dict) else {}
    want_jobs = [j for j in want_jobs if now - num(tried.get(str(j))) >= STRAGGLER_REREAD]
    noticed = now - num(store.get("seenAt")) < STRAGGLER_REREAD
    if not want_list and not want_jobs and noticed:
        return merged
    paths = ([f"commits/{head}/check-runs?status=queued&filter=latest&per_page=100"] if want_list else [])
    answers = (get or straggler_get)(repo, paths + [f"actions/jobs/{j}" for j in want_jobs]) \
        if paths or want_jobs else {}
    if want_list:
        doc = answers.get(paths[0])
        if isinstance(doc, dict) and isinstance(doc.get("check_runs"), list):
            store.update(at=now, count=count, runs=[
                {"name": r.get("name"), "workflow": None, "status": "QUEUED", "startedAt": r.get("started_at"),
                 "jobId": r.get("id")} for r in doc["check_runs"]
                if isinstance(r, dict) and r.get("status") == "queued" and r.get("id")])
    for j in want_jobs:
        doc = answers.get(f"actions/jobs/{j}")
        tried[str(j)] = now
        if isinstance(doc, dict) and doc.get("id"):
            jobs[str(j)] = {"status": doc.get("status"), "runner": doc.get("runner_name") or doc.get("runner_id") or "",
                            "attempt": doc.get("run_attempt"), "workflow": doc.get("workflow_name"),
                            "labels": [str(x) for x in doc.get("labels") or []]}
    merged = {**data, "queuedJobs": jobs}
    if isinstance(store.get("runs"), list):
        merged.update(queuedRuns=store["runs"], queuedRunsCount=store.get("count", -1), queuedRunsAt=store.get("at"))
    straggler_notice(key, merged, now, bound)  # the detector: every STRAGGLER_REREAD a head waits, and on each read
    store.update(jobs=jobs, tried=tried, seenAt=now)
    with contextlib.suppress(OSError, ValueError, TypeError):
        path.parent.mkdir(parents=True, exist_ok=True)
        write_json(path, store)
    return merged


# The incident ledger: one alert per incident, not one per hour it lasts. forum-surge-inbox, 2026-11-20, after the
# stale alarm said the same host's stale PR data again every ALARM_EVERY for hours (huge-blue: 15,762 s old) and each
# host's straggler notice repeated hourly per label; Leo: "when it gets to states like this all of you need to be able
# to temporarily let the messages go to some inbox that you later categorize/read". An incident opens on its
# condition's first firing and is sent then. While it is open a repeat is counted, never sent (NOW's glaeda line and
# daemon.json carry the ongoing state); only news is: a WARN becoming a FIRE, or what the caller calls news (the stale
# valve restarting the daemon). Quiet for INCIDENT_CLOSE_AFTER closes it with one recovery naming the repeats held
# back; firing again inside that window is the same incident (a flap), after it a fresh one with a new id. Held (the
# quota or an upstream explains the old data) keeps it open and is never a recovery. incidents.json holds the open
# ones; incidents.jsonl every decision (sent or held), so the sender's own rate can be counted beside the
# recipient's, with the agent forum's work-post fields (cmuxterm-hq RFD 0018: channel, thread, kind, key) for its
# producer adapter. Each send also carries its incident id as tell-coordinator's --source-key, coord_inbox's own
# ledger, so a lost incidents.json still sends one message per incident event.
INCIDENTS_FILE = "incidents.json"
INCIDENT_LEDGER = "incidents.jsonl"
INCIDENT_CLOSE_AFTER = 1800.0  # seconds the condition stays quiet before its incident closes (recovered)
INCIDENT_LEDGER_KEEP = 2000  # lines incidents.jsonl keeps (trimmed past a quarter more)


def incident_ledger_line(now: float, key: str, inc: dict, event: str, sent: bool, level: str) -> None:
    """One decision in incidents.jsonl, with the forum's work-post fields. Logged, never raised."""
    scope, _, thread = key.partition(":")
    line = {"ts": utc_stamp(now), "at": round(now, 3), "host": policy_host(), "key": key, "incident": inc.get("id"),
            "event": event, "sent": sent, "level": level, "repeats": int(num(inc.get("repeats"))),
            "sends": int(num(inc.get("sends"))), "channel": f"ops/glaeda-{scope}", "thread": thread or policy_host(),
            "kind": "receipt" if event == "recover" else "blocker" if level == "fire" else "warn"}
    try:
        path = BASE / INCIDENT_LEDGER
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a") as out:
            out.write(json.dumps(line, sort_keys=True) + "\n")
        lines = path.read_text().splitlines()
        if len(lines) > INCIDENT_LEDGER_KEEP * 5 // 4:
            tmp = path.with_suffix(".jsonl.tmp")
            tmp.write_text("\n".join(lines[-INCIDENT_LEDGER_KEEP:]) + "\n")
            tmp.replace(path)
    except OSError as error:
        log({"event": "incident-ledger-failed", "error": describe(error)})


def incident_update(now: float, scope: str, active: set[str], fired: dict[str, tuple[str, bool]],
                    close_after: float = INCIDENT_CLOSE_AFTER) -> dict[str, dict] | None:
    """One pass of SCOPE's incidents (keys "SCOPE:..."): each key in FIRED fired with (level, news); a key in ACTIVE
    and not FIRED is still on (held, or between a caller's own notices); every other open incident of SCOPE is quiet.
    Returns {key: {"event", "send", "incident"}} for the keys whose incident changed (open, escalate, news, repeat,
    recur, quiet, recover), or None when the ledger's lock was not had in time (nothing decided: the next pass is)."""
    BASE.mkdir(parents=True, exist_ok=True)
    out: dict[str, dict] = {}
    with bounded_lock(BASE / f"{INCIDENTS_FILE}.lock") as held:
        if not held:
            return None
        doc = read_json(BASE / INCIDENTS_FILE)
        incidents = doc.get("open") if isinstance(doc, dict) and isinstance(doc.get("open"), dict) else {}
        incidents = {k: v for k, v in incidents.items() if isinstance(v, dict) and isinstance(v.get("id"), str)}
        changed = False
        for key, (level, news) in fired.items():
            inc = incidents.get(key)
            if inc is None:
                inc = {"id": f"{key}@{utc_stamp(now)}", "opened": now, "level": level, "repeats": 0, "sends": 1,
                       "seen": now}
                event, send = "open", True
            else:
                flap = inc.pop("quietSince", None) is not None
                if level == "fire" and inc.get("level") != "fire":
                    inc["level"], event, send = "fire", "escalate", True
                elif news:
                    event, send = "news", True
                else:
                    inc["repeats"] = int(num(inc.get("repeats"))) + 1
                    event, send = ("recur" if flap else "repeat"), False
                inc["sends"] = int(num(inc.get("sends"))) + (1 if send else 0)
                inc["seen"] = now
            incidents[key] = inc
            changed = True
            out[key] = {"event": event, "send": send, "incident": dict(inc)}
            if event != "repeat":  # a repeat is only counted: one line a tick would be the flood again, kept locally
                incident_ledger_line(now, key, inc, event, send, level)
        for key in [k for k in incidents if k.startswith(scope + ":") and k not in fired]:
            inc = incidents[key]
            if key in active:
                if inc.pop("quietSince", None) is not None:
                    out[key] = {"event": "recur", "send": False, "incident": dict(inc)}
                    incident_ledger_line(now, key, inc, "recur", False, str(inc.get("level") or "warn"))
                    changed = True
                continue
            if "quietSince" not in inc:
                inc["quietSince"] = now
                out[key] = {"event": "quiet", "send": False, "incident": dict(inc)}
                incident_ledger_line(now, key, inc, "quiet", False, str(inc.get("level") or "warn"))
                changed = True
            elif now - num(inc["quietSince"]) >= close_after:
                del incidents[key]
                inc = {**inc, "closed": now, "sends": int(num(inc.get("sends"))) + 1}
                out[key] = {"event": "recover", "send": True, "incident": inc}
                incident_ledger_line(now, key, inc, "recover", True, "info")
                changed = True
        if changed:
            with contextlib.suppress(OSError, ValueError, TypeError):
                write_json(BASE / INCIDENTS_FILE, {"open": incidents})
    return out


def incident_said(step: dict) -> str:
    """What an incident's sent alert adds to its text: its id, and that repeats are held."""
    inc = step["incident"]
    if step["event"] == "open":
        return (f" Incident {inc['id']}: this is sent once; repeats are held until it recovers "
                f"({int(INCIDENT_CLOSE_AFTER // 60)} min quiet), and only a FIRE or a valve restart is sent again.")
    return (f" Incident {inc['id']}, open {int((num(inc.get('seen')) - num(inc.get('opened'))) // 60)} min, "
            f"{int(num(inc.get('repeats')))} repeat(s) held.")


def incident_recovered(step: dict, what: str) -> str:
    """The one line an incident's recovery sends."""
    inc = step["incident"]
    return (f"glaeda-gh on {policy_host()}: incident {inc['id']} recovered: {what}, quiet for "
            f"{int(INCIDENT_CLOSE_AFTER // 60)} min (opened {utc_stamp(num(inc.get('opened')))}, "
            f"{int(num(inc.get('repeats')))} repeat(s) held back).")


def incident_send(text: str, level: str, source_key: str, to: str = "", cls: str = "") -> None:
    """An incident's alert by the sender-side ledger: tell-coordinator (coord_inbox) with --source-key SOURCE_KEY,
    which sends a key once and folds a tool's fyi into its digest. Never coord_alert (forum-surge-inbox, 2026-11-20:
    straggler_notice must stop calling coord_alert_spawn, whose acpmux and lane-gh routes start a coordinator prompt per
    host): on a host without tell-coordinator (a lane VM) the incident stays in the ledger (incidents.jsonl, the
    notice line), which the forum adapter and NOW read. TO (HOST/NAME) sends it to that session instead of the
    coordinator, and CLS is its --class (fyi wakes nobody). In the background; logged, never raised."""
    if ALARM_CMD.is_file() and os.access(ALARM_CMD, os.X_OK):
        route = (["--to", to] if to else []) + (["--class", cls] if cls else [])
        try:
            subprocess.Popen([os.fspath(ALARM_CMD), "--from", "glaeda-gh", "--severity", level, *route, "--source-key",
                              source_key, text], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            log({"event": "alert", "via": ALARM_CMD.name, "sourceKey": source_key, "to": to or None, "text": text})
            return
        except OSError as error:
            log({"event": "alert-ledger-only", "why": describe(error), "sourceKey": source_key, "text": text})
            return
    log({"event": "alert-ledger-only", "why": f"no {ALARM_CMD}", "sourceKey": source_key, "text": text})


def notice_line(now: float, kind: str, level: str, text: str, data: dict) -> None:
    """One notice line (cmuxterm-hq tools/fleet-reconcilers/notices.py's schema) in NOTICES_DIR/glaeda-gh.jsonl."""
    line = {"ts": dt.datetime.fromtimestamp(now, dt.timezone.utc).isoformat(timespec="seconds"),
            "source": "glaeda-gh", "level": "warn" if level in ("warn", "fire") else "info", "kind": kind,
            "key": policy_host(), "text": text, "data": {**data, "severity": level}}
    try:
        NOTICES_DIR.mkdir(parents=True, exist_ok=True)
        path = NOTICES_DIR / "glaeda-gh.jsonl"
        with open(path, "a") as out:
            out.write(json.dumps(line, sort_keys=True) + "\n")
        lines = path.read_text().splitlines()
        if len(lines) > 2500:  # notices.py's KEEP, with its slack
            tmp = path.with_suffix(".jsonl.tmp")
            tmp.write_text("\n".join(lines[-2000:]) + "\n")
            tmp.replace(path)
    except OSError as error:
        log({"event": "notice-failed", "error": describe(error)})


def straggler_notice(key: str, data: dict, now: float, bound: float = STRAGGLER_AFTER) -> None:
    """The stragglers detector: KEY's queued runs with no runner past BOUND (required or not), kept per runner label
    over every watched head for STRAGGLER_NOTICE_EVERY, and one "stragglers" notice per label that often, naming the
    label, how many jobs and on how many heads (not one per head)."""
    found = [s for s in (straggler_of(c, data, now, bound) for c in queued_any(data)) if s]
    BASE.mkdir(parents=True, exist_ok=True)
    # every waiter and the daemon update the one file: held while read, changed and written, so no count is lost
    # and no label is noticed twice (a lock not had in time skips this pass; the next one counts it)
    with bounded_lock(BASE / f"{STRAGGLER_SEEN}.lock") as held:
        if not held:
            return
        doc = read_json(BASE / STRAGGLER_SEEN)
        doc = doc if isinstance(doc, dict) else {}
        seen = doc.get("seen") if isinstance(doc.get("seen"), dict) else {}
        noticed = {k: num(v) for k, v in (doc.get("noticed") if isinstance(doc.get("noticed"), dict) else {}).items()}
        for label in list(seen):
            heads = seen[label] if isinstance(seen[label], dict) else {}
            heads.pop(key, None)
            seen[label] = {k: [int(num(v[0])), num(v[1])] for k, v in heads.items()
                           if isinstance(v, list) and len(v) == 2 and now - num(v[1]) < STRAGGLER_NOTICE_EVERY}
        for s in found:
            heads = seen.setdefault(s["label"], {})
            heads[key] = [(heads.get(key) or [0])[0] + 1, now]
        due: dict[str, str] = {}
        for label, heads in seen.items():
            if not heads or now - noticed.get(label, 0.0) < STRAGGLER_NOTICE_EVERY:
                continue
            jobs = sum(v[0] for v in heads.values())
            text = (f"WARN glaeda-gh on {policy_host()}: {jobs} job(s) on runner label {label} queued with no runner "
                    f"past {int(bound // 60)} min on {len(heads)} watched head(s), e.g. {key_name(next(iter(heads)))}. "
                    f"{STRAGGLER_STEP.format(label=label)}")
            notice_line(now, "stragglers", "warn", text, {"label": label, "jobs": jobs, "heads": sorted(heads)})
            due[f"stragglers:{label}"] = text
            noticed[label] = now
        # the hourly notice line per label stays; the coordinator hears each label's incident once (incident_update),
        # and once more when no head has had a straggler on it for the hour seen keeps plus INCIDENT_CLOSE_AFTER
        steps = incident_update(now, "stragglers", {f"stragglers:{label}" for label, heads in seen.items() if heads},
                                {key: ("warn", False) for key in due})
        if steps is None:  # the ledger busy: these labels are due again on the next pass, not in an hour
            for key in due:
                noticed.pop(key.partition(":")[2], None)
            steps = {}
        for key, step in steps.items():
            inc, label = step["incident"], key.partition(":")[2]
            if step["event"] == "recover":
                straggler_fleet_send(label, "recover", "info", incident_recovered(
                    step, f"no watched head has a straggler on runner label {label}"), now)
            elif key in due and (step["send"] or now - num(inc.get("opened")) >= STRAGGLER_FLEET_FALLBACK):
                level = "fire" if inc.get("level") == "fire" else "warn"
                straggler_fleet_send(label, "open", level, due[key] + "." + incident_said(step), now,
                                     now - num(inc.get("opened")))
        seen = {label: heads for label, heads in seen.items() if heads}
        with contextlib.suppress(OSError, ValueError, TypeError):
            write_json(BASE / STRAGGLER_SEEN, {"seen": seen, "noticed": {
                k: v for k, v in noticed.items() if now - v < 2 * STRAGGLER_NOTICE_EVERY}})


# Fleet-once: a runner label with no runner is a fleet-wide fact, so one host says it, to its owner. 2026-11-20/21:
# "N job(s) on runner label X queued with no runner past 30 min" reached claude-sr2-coord from about 12 hosts, one per
# host, for the same labels: each host's incident ledger is local, and its key (the incident id, stamped with that
# host's own open time) differed per host, so neither coord_inbox's sender ledger nor acpmux's prompt id could fold
# them (cmuxterm-hq docs/handbook/per-host-dedup-still-floods-a-shared-owner.md: a local lock is no global dedup).
# Leo, 2026-11-21: "if you're recieving too many messages you can think of better solutions". The election needs no
# shared store, so it holds on Macs and lane VMs alike: the fleet reporter (the host of the registry's
# coordinators.fleet, else coordinators.current; GLAEDA_GH_FLEET_REPORTER overrides) sends a label's incident; every
# other host keeps it in its own notice line and incident ledger and sends only when its incident has stayed open
# STRAGGLER_FLEET_FALLBACK (the reporter may not watch a head on that label). Every send, reporter's or fallback's,
# carries the fleet key stragglers:LABEL:EVENT:<6 h bucket> as --source-key, the same on every host, so coord_inbox
# and acpmux's prompt id fold the fallbacks at the destination too; and a host sends a key at most once per
# STRAGGLER_FLEET_EVERY (FLEET_SENT). It goes to NOW's owner of STRAGGLER_AREA (now.json area_owners, the freshest
# owner seen within AREA_OWNER_FRESH, as leo-workspace tools/overload_inbox.py routes), else coordinators.fleet, as
# class fyi. A FIRE skips the election and the window and goes at once, class block.
STRAGGLER_FLEET_EVERY = 6 * 3600
STRAGGLER_FLEET_FALLBACK = 2 * 3600
STRAGGLER_AREA = "ci-fleet"
FLEET_SENT = "stragglers-fleet-sent.json"  # under BASE: {"LABEL:EVENT": when this host last sent it}
NOW_JSON = Path(os.environ.get("GLAEDA_GH_NOW_JSON") or Path.home() / ".cache/now/last-now-json")
AREA_OWNER_FRESH = 3 * 3600


def registry_coordinator(role: str) -> str:
    """The fleet registry's coordinators.ROLE (HOST/SESSION), or ""."""
    for doc in fleet_registries():
        coords = doc.get("coordinators")
        name = coords.get(role) if isinstance(coords, dict) else None
        if isinstance(name, str) and "/" in name:
            return name
    return ""


def fleet_reporter() -> str:
    """The one host that sends a fleet-wide fact: GLAEDA_GH_FLEET_REPORTER, else the host of the registry's
    coordinators.fleet, else of coordinators.current; "" when none is known (then every host is its own reporter)."""
    env = (os.environ.get("GLAEDA_GH_FLEET_REPORTER") or "").strip().lower()
    if env:
        return env
    for role in ("fleet", "current"):
        name = registry_coordinator(role)
        if name:
            return name.split("/", 1)[0].lower()
    return ""


def area_owner(area: str, now: float) -> str:
    """NOW's live owner of AREA as HOST/NAME (now.json area_owners: the owner seen most recently, within
    AREA_OWNER_FRESH), else the registry's coordinators.fleet, else "" (tell-coordinator's own default)."""
    doc = read_json(NOW_JSON)
    rows = ((doc.get("area_owners") or {}).get("rows") if isinstance(doc, dict) else None) or []
    best: tuple[float, str] = (0.0, "")
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict) or row.get("area") != area:
            continue
        for owner in row.get("owners") or []:
            try:
                seen = dt.datetime.fromisoformat(str(owner["last_seen"]).replace("Z", "+00:00")).timestamp()
                name = f"{owner['host']}/{owner['name']}"
            except (KeyError, TypeError, ValueError):
                continue
            if now - seen <= AREA_OWNER_FRESH and (seen, name) > best:
                best = (seen, name)
    return best[1] or registry_coordinator("fleet")


def straggler_fleet_send(label: str, event: str, level: str, text: str, now: float, age: float = 0.0) -> str:
    """LABEL's straggler incident EVENT ("open" or "recover"), open AGE seconds on this host, sent fleet-once (see
    above): "sent", or why it was held ("not-reporter", "window"). Every decision is logged; the notice line and
    incident ledger already hold it."""
    me, reporter, fire = policy_host(), fleet_reporter(), level == "fire"
    record = f"{label}:{event}"
    with bounded_lock(BASE / f"{FLEET_SENT}.lock") as held:
        doc = read_json(BASE / FLEET_SENT) if held else {}
        sent = {k: num(v) for k, v in (doc if isinstance(doc, dict) else {}).items()
                if now - num(v) < 2 * STRAGGLER_FLEET_EVERY}
        why = ""
        if not fire and reporter and me != reporter and event == "recover" and f"{label}:open" not in sent:
            why = "not-reporter"  # a recovery comes from whoever said the incident
        elif not fire and reporter and me != reporter and event == "open" and age < STRAGGLER_FLEET_FALLBACK:
            why = "not-reporter"  # the reporter says it; this host only if its incident outlasts the fallback
        elif not fire and now - sent.get(record, -math.inf) < STRAGGLER_FLEET_EVERY:
            why = "window"
        if why:
            log({"event": "alert-fleet-held", "why": why, "label": label, "incident": event, "reporter": reporter,
                 "text": text})
            return why
        sent[record] = now
        if held:
            with contextlib.suppress(OSError, ValueError, TypeError):
                write_json(BASE / FLEET_SENT, sent)
    bucket = int(now // STRAGGLER_FLEET_EVERY)
    incident_send(text, level, f"stragglers:{label}:{'fire' if fire else event}:{bucket}",
                  to=area_owner(STRAGGLER_AREA, now), cls="block" if fire else "fyi")
    return "sent"


# What ends such a job, said in the wait's line and the notice. 2026-11-17 (job 134322701364): a job rerun is refused
# while its run runs ("The workflow run containing this job is already running", HTTP 403), and runs-on is fixed when
# the job is queued (vars.RUNNER_POOLS), so a flipped runner variable reaches only jobs queued after it. Only a runner
# on that label, a cancel, or a new push ends it.
STRAGGLER_STEP = ("Nothing starts it until runner label {label} has a runner (runner capacity's owner); a rerun is "
                  "refused while its run runs, and a new push queues it under the runner variables then in force")
COORD_ALERT = Path(os.environ.get("GLAEDA_GH_COORD_ALERT")
                   or Path.home() / "Projects/leo-workspace/tools/coord_alert.py")


def coord_alert_spawn(text: str) -> None:
    """TEXT to the coordinator through leo-workspace's coord_alert (its routes: tell-coordinator, acpmux, then lane-gh
    send on a lane VM), in a process of its own so its bounded routes never hold a tick. Logged, never raised.
    With no coord_alert, the alert is a FIRE (coord_alert_missing), never only a log line."""
    if not COORD_ALERT.is_file():
        coord_alert_missing(text)
        return
    try:
        subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "coord-alert", text],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as error:
        log({"event": "alert-unsent", "why": describe(error), "text": text})


def coord_alert_missing(text: str) -> None:
    """TEXT with no coord_alert to send it: a FIRE naming the missing tool, as a notice line (written even with no
    inbox tool) and through the alarm path the daemon's other alarms use (ALARM_CMD, tell-coordinator), with TEXT in
    it. 2026-11-19: coord_alert.py never merged (leo-workspace#5760 open), and huge-blue logged 12 straggler alerts
    as alert-unsent over a day while nobody heard of any."""
    fire = (f"FIRE glaeda-gh on {policy_host()}: its alert tool {COORD_ALERT} is missing, so this alert came by "
            f"{ALARM_CMD.name} instead; restore the tool or set GLAEDA_GH_COORD_ALERT. The alert: {text}")
    notice_line(time.time(), "alert-tool-missing", "fire", fire, {"tool": os.fspath(COORD_ALERT)})
    if not (ALARM_CMD.is_file() and os.access(ALARM_CMD, os.X_OK)):
        log({"event": "alert-unsent", "why": f"no {COORD_ALERT} and no {ALARM_CMD}", "text": text})
        return
    try:
        subprocess.Popen([os.fspath(ALARM_CMD), "--from", "glaeda-gh", "--severity", "fire", fire],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as error:
        log({"event": "alert-unsent", "why": f"no {COORD_ALERT}; {ALARM_CMD}: {describe(error)}", "text": text})
        return
    log({"event": "alert", "alarm": "stragglers", "via": f"{ALARM_CMD} (no {COORD_ALERT}: FIRE)", "text": text})


def coord_alert_send(text: str) -> int:
    """`glaeda-gh coord-alert TEXT`: coord_alert.send(TEXT, "glaeda-gh"), the route it took logged (with no
    coord_alert, coord_alert_missing's FIRE)."""
    if not COORD_ALERT.is_file():
        coord_alert_missing(text)
        return EXIT_OK
    try:
        spec = importlib.util.spec_from_file_location("coord_alert", COORD_ALERT)
        module = importlib.util.module_from_spec(spec)  # type: ignore[arg-type]
        sys.modules[spec.name] = module  # before exec_module: a dataclass in the module looks its module up here
        spec.loader.exec_module(module)  # type: ignore[union-attr]
        via = module.send(text, "glaeda-gh", budget=180)
    except Exception as error:  # noqa: BLE001  an alert's failure is logged, never raised
        log({"event": "alert-unsent", "why": describe(error), "text": text})
        return EXIT_FAIL
    log({"event": "alert", "alarm": "stragglers", "via": via or None, "text": text})
    return EXIT_OK if via else EXIT_FAIL


def queued_any(data: dict) -> list[dict]:
    """DATA's queued check runs, shown or read past page 1, whatever else is unfinished (the detector's view)."""
    shown = [c for c in data.get("checks") or [] if c.get("status") == "QUEUED" and c.get("jobId")]
    merged = {c["jobId"]: c for c in shown}
    for c in data.get("queuedRuns") or []:
        if isinstance(c, dict) and c.get("jobId"):
            merged.setdefault(c["jobId"], c)
    return list(merged.values())


def check_verdict(data: dict, until: str = "green", now: float | None = None,
                  grace: float = RESCUE_GRACE, settle: float = SETTLE_GRACE) -> int | None:
    """The checks alone, whatever the PR's state or head: EXIT_OK, EXIT_FAIL, EXIT_NOTHING (nothing reported on the
    head past its settle window), EXIT_INCONCLUSIVE, or None while pending. Never EXIT_OK while any check is unfinished.
    --until done ends EXIT_INCONCLUSIVE on a head whose only unfinished checks are stragglers nothing requires
    (straggler_cut): they are still queued, and run if a runner comes, so the head is not done (hq#13438, hq#13202:
    the cut used to judge the head without them and said success while 7 and 8 of 13 checks were queued)."""
    now = time.time() if now is None else now
    if until == "done":
        cut = straggler_cut(data, now)
        if cut is not None:
            # a red already in stays a failure (it can never turn green); otherwise the head is not done
            return EXIT_FAIL if check_verdict(cut, "green", now, grace, settle) == EXIT_FAIL else EXIT_INCONCLUSIVE
    checks = data.get("checks") or []
    if data.get("checksPageError"):
        return None  # a partial cached rollup is not evidence of a green head
    marked_required = any(c.get("required") for c in checks)
    shown = classify(data, now, grace)
    if any(c.get("lastRealAttempt") and (until != "required" or c.get("required") or not marked_required)
           for c in shown["failed"]):
        # A red whose suite's newest attempt ran nothing (startup_failure): GitHub's rollup state omits it, it stands;
        # --until done still waits for every shown check to finish first.
        if until == "done" and (shown["pending"] or shown["held"] or pending_on_every_page(data)):
            return None
        return EXIT_FAIL
    # --until required on a truncated rollup that holds every name the base requires (on the first page, or read by
    # name), each marked required, decides on those checks, as under 100 checks: GitHub's rollup
    # also counts the optional contexts past the page, which a required wait ignores (leo-workspace#5184, cmux#43194).
    required_shown = {c.get("name") for c in checks if c.get("required")}
    every_required = (until == "required" and bool(data.get("requiredNames"))
                      and set(data["requiredNames"]).issubset(required_shown))
    if data.get("checksTruncated") and not every_required:
        # More than 100 checks: only the first 100 are here, so GitHub's rollup decides, except that a
        # check shown as held or still running defers its FAILURE (manaflow-ai/cmux#20733: a queued fast
        # tier the rescue cancelled read as a failure while 13 checks still ran).
        state = data.get("checkState")
        if state == "SUCCESS":
            return EXIT_OK
        if state not in {"FAILURE", "ERROR"}:
            return None
        groups = classify(data, now, grace)
        if until == "done" and (groups["pending"] or groups["held"] or pending_on_every_page(data)):
            return None  # every check finishes first, shown or past page 1 (counts), as under 100 checks
        if groups["failed"] and until != "required":
            return EXIT_FAIL
        # GitHub's rollup still counts a superseded attempt that failed or was cancelled, so its FAILURE
        # can be that attempt rather than a check past the first 100: with no shown failure, the shown
        # checks finish first, and then the rollup decides (manaflow-ai/cmux#24539: 0 failed and 7
        # running, yet the wait exited 1 after 5s). A failure past the first 100 fails that much later.
        if not groups["failed"] and groups["pending"] and data.get("superseded"):
            return None
        if not groups["failed"] and not groups["pending"] and not groups["held"] and rollup_red_is_superseded(data):
            return EXIT_OK  # every red context on every page is a superseded attempt
        return None if groups["held"] else EXIT_FAIL
    if not checks:
        # nothing has reported yet: not started while the head settles (or its push time is unknown), then said so
        return None if settling(data, now, settle) is not None or pushed_by(data) is None else EXIT_NOTHING
    marked = any(c.get("required") for c in checks)

    def decides(c: dict) -> bool:
        # Every check decides; only an explicit --until required ignores the ones GitHub does not require
        # (manaflow-ai/subrouter#612 merged red on "success" over two failed optional checks).
        return until != "required" or bool(c.get("required")) or not marked

    # GitHub's own merge state already counts a required check that never reported. A conflicted PR
    # (DIRTY) runs no pull_request workflows until the next push, and a merged one never will.
    waiting = (data.get("requiredMissing") and data.get("state") == "OPEN"
               and data.get("mergeStateStatus") not in {"CLEAN", "UNSTABLE", "HAS_HOOKS", "DIRTY"})
    groups = classify(data, now, grace)
    bad = [c for c in groups["failed"] if decides(c)]
    unfinished = [c for c in groups["pending"] + groups["held"] if decides(c)]
    if until in {"green", "required"} and bad:
        return EXIT_FAIL
    if unfinished or waiting:
        return None
    if data.get("requiredMissing") and data.get("state") == "OPEN" and data.get("mergeStateStatus") == "DIRTY":
        return EXIT_FAIL  # merge conflicts: the required checks will not run until the next push
    if bad:
        return EXIT_FAIL
    if data.get("state") == "OPEN" and expected_missing(data):
        return None  # a status every head of this repo gets has not been posted yet: unfinished, like a required one
    return EXIT_OK


def checks_state(data: dict, result: int | None) -> str:
    """A head's checks in one word for `status`: SUCCESS and FAILURE as check_verdict decides, INCONCLUSIVE when it
    says so or the read is partial (checksPageError: what was not read may be unfinished or red), else PENDING."""
    if result == EXIT_INCONCLUSIVE or (result != EXIT_FAIL and data.get("checksPageError")):
        return "INCONCLUSIVE"
    return {EXIT_OK: "SUCCESS", EXIT_FAIL: "FAILURE"}.get(result, "PENDING")  # type: ignore[arg-type]


def run_hold(data: dict, jobs: list[dict] | None, now: float | None = None,
             grace: float = RESCUE_GRACE) -> list[dict]:
    """The jobs a glaeda runner refused, while a rescue attempt of this failed run may still come.
    Empty once any job failed for another reason, when the job list is not this attempt's, or
    `grace` seconds after the run finished."""
    now = time.time() if now is None else now
    if (grace <= 0 or data.get("status") != "completed" or data.get("conclusion") not in {"failure", "cancelled"}
            or not jobs or jobs_attempt(jobs) < (data.get("run_attempt") or 1)):
        return []
    bad = [j for j in jobs if j.get("status") == "completed" and j.get("conclusion") not in RUN_OK]
    refused = [j for j in bad if refused_job(j)]
    # the rescue cancels what is still running before it re-runs, so cancelled jobs are expected
    if not refused or any(not refused_job(j) and j.get("conclusion") != "cancelled" for j in bad):
        return []
    finished = iso_epoch(data.get("updated_at")) or max(iso_epoch(j.get("completed_at")) or 0 for j in refused)
    return refused if now - finished < grace else []


def verdict(kind: str, data: dict | None, until: str = "green", sha: str | None = None,
            jobs: list[dict] | None = None, now: float | None = None, grace: float = RESCUE_GRACE,
            repo: str = "", settle: float = SETTLE_GRACE) -> int | None:
    """EXIT_OK, EXIT_FAIL, EXIT_CONFLICT (a PR that conflicts with its base), or None while still pending.
    A run is `sha`'s when its head is, or when it is a dispatch naming `sha` of `repo` (run_tests_commit)."""
    if not data:
        return None
    if kind == "run":
        if sha and not str(data.get("head_sha") or "").startswith(sha) and not run_tests_commit(data, repo, sha):
            return None
        if data.get("status") != "completed":
            return None
        if data.get("conclusion") in RUN_OK:
            return EXIT_OK
        return None if run_hold(data, jobs, now, grace) else EXIT_FAIL
    if data.get("state") == "CLOSED":
        return EXIT_FAIL
    if until == "merged":
        return EXIT_OK if data.get("state") == "MERGED" else None
    if data.get("state") == "MERGED":
        # A merged PR is final whatever --until says: it is never waited on (hq#16384, 2026-11-21: `--until required
        # --sha 6ca0a8fd` kept waiting 2400 s on a PR that had merged at head cbad338ab7, which could never match).
        if sha and not str(data.get("headRefOid") or "").startswith(sha):
            return EXIT_OK  # it merged at another head: the commit waited for is not the one that landed, nothing to wait for
        if until != "done":
            # at the head waited for: a finished red still decides, but a check still pending never holds a merged PR
            # (leo-workspace#7310, 2026-11-21: `wait pr` with no --until saw MERGED at 1398 s and ran to its 1800 s
            # timeout on one non-required check that was still pending)
            # (a runner refusal inside its rescue grace is held, not pending: it still holds, and ends with the grace)
            decided = check_verdict(data, until, now, grace, settle)
            return EXIT_OK if decided is None and not classify(data, now, grace)["held"] else decided
        # Nothing more runs for it: a merged PR is done whatever its head still shows (leo-workspace#4370, 2026-11-11:
        # `--until done` saw MERGED at 600 s, then waited 15 min more on "checks: none reported yet"). A finished red
        # still fails; a pending, missing or other-head check no longer holds the wait.
        # (judged as green would: under "done" a red waits for the running checks, and that None would read as OK)
        decided = check_verdict(data, "green", now, grace, settle)
        return EXIT_FAIL if decided == EXIT_FAIL else EXIT_OK
    if sha and not str(data.get("headRefOid") or "").startswith(sha):
        return None  # the push has not reached GitHub yet, or these are an older commit's checks
    if conflicting(data):
        return EXIT_CONFLICT  # no pull_request workflow runs until the next push
    return check_verdict(data, until, now, grace, settle)


def conflicting(data: dict) -> bool:
    """An open PR GitHub says conflicts with its base. UNKNOWN is still being computed: not a conflict."""
    # mergeStateStatus can lag mergeable (or read DRAFT), so mergeable alone decides.
    return data.get("state") == "OPEN" and data.get("mergeable") == "CONFLICTING"


def age(seconds: float | None) -> str:
    if seconds is None:
        return "never"
    s = int(max(0, time.time() - seconds))
    return f"{s}s ago" if s < 120 else f"{s // 60}m ago"


def label(c: dict) -> str:
    return f"{c['workflow']} / {c.get('name')}" if c.get("workflow") else str(c.get("name"))


# A red the PR's base also has is not the PR's to fix. cmuxterm-hq docs/ci/bottleneck-and-skip-candidates-2026-11-21.md:
# over 11-13..19, 3,765 PR heads were red only because of the base (25% of PR runner-minutes, 35% on 11-16/17), and
# 2,427 of them were pushed again, each push running the whole suite again. Leo, 2026-11-21: "we need to be hitting a
# 10x improvement in not running useless jobs". So `status pr` names those reds inherited and says do nothing.
# The set is the lander's own: next-autoland's `base_reds` (the reds it excuses when it lands a PR), read from its
# pass report on the cmuxterm-hq reconciler-state branch, so an agent reads what the lander decides, not a second
# guess. One REST read per BASE_REDS_TTL per host (BASE/base-reds.json); a report older than BASE_REDS_MAX_AGE is no
# evidence (next-autoland's own rule for base-red-watch's file), and an unread one marks nothing. land-judge still
# judges each red at the merge (the shared classifier, per step and per test): this only stops the re-push.
BASE_REDS_SOURCES = {("manaflow-ai/cmux", "feat-cmux-next"):
                     ("manaflow-ai/cmuxterm-hq", "reconciler-state/next-autoland", "report.json")}
BASE_REDS_TTL = 300
BASE_REDS_MAX_AGE = 1800
BASE_REDS_READ_S = 15
INHERITED_ADVICE = ("red on the base too (next-autoland's base-red set): not yours. Do not push, re-run or chase it; "
                    "the base's fix or revert clears it, and land-judge excuses it at the merge")


def read_base_reds_report(repo: str, ref: str, path: str) -> dict | None:
    """REPO's PATH at REF (the lander's pass report) as JSON, or None when it cannot be read in BASE_REDS_READ_S."""
    try:
        done = subprocess.run(["gh", "api", f"repos/{repo}/contents/{path}?ref={ref}",
                               "-H", "Accept: application/vnd.github.raw"],
                              capture_output=True, text=True, timeout=BASE_REDS_READ_S)
        doc = json.loads(done.stdout) if done.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return doc if isinstance(doc, dict) else None


def base_reds(repo: str, base: str | None, now: float | None = None, reader=None) -> frozenset[str] | None:
    """The checks red on BASE of REPO now, as the lander reads them ("workflow / job", or "workflow / job > step"),
    or None: no source for that base, the report unread, or older than BASE_REDS_MAX_AGE."""
    source = BASE_REDS_SOURCES.get((repo, base or ""))
    if not source:
        return None
    now = time.time() if now is None else now
    path = BASE / "base-reds.json"
    kept = read_json(path)
    kept = kept if isinstance(kept, dict) else {}
    key = f"{repo}:{base}"
    entry = kept.get(key)
    if not isinstance(entry, dict) or not (0 <= now - float(entry.get("readAt") or 0) < BASE_REDS_TTL):
        doc = (reader or read_base_reds_report)(*source)
        entry = {"readAt": now, "at": (doc or {}).get("at"), "reds": (doc or {}).get("base_reds")}
        kept[key] = entry
        try:
            write_json(path, kept)
        except OSError:
            pass  # an unwritable cache only costs the next caller its own read
    at = iso_epoch(entry.get("at")) if entry.get("at") else None
    reds = entry.get("reds")
    if at is None or now - at > BASE_REDS_MAX_AGE or not isinstance(reds, list):
        return None
    return frozenset(str(r) for r in reds)


def inherited(c: dict, reds: frozenset[str] | None) -> bool:
    """A failed (not cancelled or timed out) check whose job, or one of its steps, is in the base-red set REDS."""
    if not reds or (c.get("conclusion") or "").upper() != "FAILURE":
        return False
    name = label(c)
    return name in reds or any(r.startswith(f"{name} \u203a ") for r in reds)


def split_inherited(data: dict, failed: list[dict], now: float | None = None,
                    reds: frozenset[str] | None = None) -> tuple[list[dict], list[dict]]:
    """FAILED as (own, inherited) for the PR DATA: inherited when its base's red set has it (base_reds)."""
    if reds is None and failed:
        reds = base_reds(pr_repo(data), data.get("baseRefName"), now)
    own = [c for c in failed if not inherited(c, reds)]
    return own, [c for c in failed if inherited(c, reds)]


def steps_note(c: dict) -> str:
    names = c.get("failedSteps") or []
    if not names:
        return ""
    more = f" +{len(names) - 3}" if len(names) > 3 else ""
    return f" (step: {', '.join(names[:3])}{more})"


def outcome(conclusion: str | None) -> str:
    text = (conclusion or "").lower()
    return "failed" if text in {"failure", "error", ""} else text


# What a text summary lists by default. Agents read it, so it names the checks that need action and counts the rest:
# a superseded attempt is not counted toward the verdict, so it is one count line, not one line each (a green
# cmux PR printed seven of them, half its summary). --verbose or AGENT_VERBOSE=1 lists them all, as before; --json
# and --field never change.
SUMMARY_FAILED = 10
SUMMARY_FAILED_VERBOSE = 20


def full_output() -> bool:
    """True when the caller asked for every line (`--verbose`, or AGENT_VERBOSE=1 in its environment)."""
    return os.environ.get("AGENT_VERBOSE") == "1"


def summary(key: str, entry: dict | None, until: str = "done", grace: float = RESCUE_GRACE,
            verbose: bool | None = None) -> str:
    verbose = full_output() if verbose is None else verbose
    shown_failed = SUMMARY_FAILED_VERBOSE if verbose else SUMMARY_FAILED
    kind, owner, repo, number = split_key(key)
    name = f"{owner}/{repo}{'/' if kind == 'run' else '#'}{number}"
    if not entry:
        return f"{name}: no data yet"
    data = entry.get("data")
    lines = []
    if not data:
        lines.append(f"{name}: no data ({entry.get('error') or 'not fetched yet'})")
        return "\n".join(lines)
    now = time.time()
    if kind == "pr":
        head = (data.get("headRefOid") or "")[:10]
        draft = " draft" if data.get("isDraft") else ""
        lines.append(f"{name} {data.get('state')}{draft}  mergeable={data.get('mergeable')} "
                     f"({data.get('mergeStateStatus')})  review={data.get('reviewDecision')}  head {head}")
        data = split_unread(dict(data))  # (a cache written before requiredUnread existed reads the same)
        checks = data.get("checks") or []
        groups = classify(data, now, grace)
        marked = any(c.get("required") for c in checks)
        more = "+" if data.get("checksTruncated") else ""
        # A partial rollup (check pages held, a context GitHub could not read) says so on the checks line: its
        # PENDING is the unread pages', and a required name not shown is unread, not missing (cmux#43194).
        partial = (f" (partial: {len(checks)} of {data.get('checksTotal') or '?'} read; "
                   f"check pages held: {data['checksPageError']})") if data.get("checksPageError") else ""
        if checks:
            # the headline is this tool's own reading, the one `wait` decides by; GitHub's rollup also
            # counts superseded attempts and checks that are not required
            result = check_verdict(data, "done" if until == "merged" else until, now, grace)
            state = checks_state(data, result)
            held = f", {len(groups['held'])} held" if groups["held"] else ""
            rollup = data.get("checkState")
            differs = f"; GitHub's rollup says {rollup}" if rollup and rollup != state else ""
            # what the counts say still runs past the first 100 (cmux#43515: "0 pending" while every webview shard ran)
            past = max(0, pending_on_every_page(data) - len(groups["pending"]) - len(groups["held"]))
            held += f", {past} more unfinished past the first 100" if past else ""
            lines.append(f"checks {state}{partial}: {len(groups['passed'])} passed, {len(groups['failed'])} failed, "
                         f"{len(groups['pending'])} pending{held} (of {len(checks)}{more}, "
                         f"{sum(1 for c in checks if c.get('required'))} required){differs}")
        else:
            left = settling(data, now)
            lines.append("checks: none reported yet for this head commit"
                         + (f" (not started; settles in {int(left)}s)" if left is not None else "") + partial)
        if data.get("state") == "OPEN" and expected_missing(data):
            lines.append(f"  expected, not posted yet: {', '.join(expected_missing(data))}")
        if data.get("requiredMissing"):
            why = " (merge conflicts: they run after the next push)" if data.get("mergeStateStatus") == "DIRTY" else ""
            lines.append(f"  required, not reported yet: {', '.join(data['requiredMissing'])}{why}")
        if data.get("requiredUnread"):
            lines.append(f"  required, not read yet (check pages held): {', '.join(data['requiredUnread'])}")
        if until in ("done", "merged"):
            cut = straggler_cut(data, now)
            lines += straggler_lines(cut if cut is not None else data, now)
        # Required checks first, then real failures before cancelled ones: the capped list leads with what to fix.
        own_failed, inherited_failed = split_inherited(data, groups["failed"], now)
        bad = sorted(own_failed, key=lambda c: (marked and not c.get("required"),
                                                str(c.get("conclusion") or "").lower() == "cancelled"))
        for c in bad[:shown_failed]:
            optional = " (not required)" if marked and not c.get("required") else ""
            lines.append(f"  {outcome(c.get('conclusion'))}: {label(c)}{steps_note(c)}{optional}  {c.get('url') or ''}".rstrip())
        if len(bad) > shown_failed:
            lines.append(f"  ... {len(bad) - shown_failed} more failed (--json lists them)")
        if inherited_failed:
            names = ", ".join(label(c) for c in inherited_failed[:shown_failed])
            more = f" +{len(inherited_failed) - shown_failed}" if len(inherited_failed) > shown_failed else ""
            lines.append(f"  inherited from {data.get('baseRefName')}: {names}{more}: {INHERITED_ADVICE}")
            if not own_failed:
                lines.append("  every red here is inherited: nothing to do on this PR for them")
        for c in groups["held"][:shown_failed]:
            refused = any(refused_check(o) and o.get("runId") == c.get("runId") for o in checks)
            why = ("cancelled before any step ran" if cancelled_unstarted(c)
                   else "its run had a job refused at runner setup" if refused
                   else "its run was cancelled while a job was still queued")
            lines.append(f"  held: {label(c)}{steps_note(c)}: {why}; "
                         f"pending up to {int(grace)}s for the re-run  {c.get('url') or ''}".rstrip())
        replaced = [c for c in data.get("superseded") or [] if not c.get("ranNothing")]
        for c in replaced[:10] if verbose else []:
            optional = " (not required)" if marked and not c.get("required") else ""
            lines.append(f"  superseded: {label(c)} {outcome(c.get('conclusion')) if c.get('conclusion') else 'pending'}"
                         f"{optional}, "
                         "replaced by a newer attempt or run (not counted)")
        replaced_count = len(replaced) + int(data.get("supersededOmitted") or 0)
        if replaced_count and not verbose:
            lines.append(f"  {replaced_count} superseded, replaced by a newer attempt or run "
                         "(not counted; --verbose lists up to 10)")
        lines.append(str(data.get("url") or ""))
    elif kind == "comment":
        lines.append(f"{name} {str(data.get('type') or '').lower()} {data.get('state')}: "
                     f"{data.get('total')} comments  {data.get('url') or ''}".rstrip())
        for c in (data.get("comments") or [])[-5:]:
            first = (str(c.get("body") or "").strip().splitlines() or [""])[0][:100]
            lines.append(f"  {c.get('id')} {c.get('author')} {c.get('createdAt')}: {first}")
    else:
        lines.append(f"{name} {data.get('name')}: {data.get('status')}"
                     f"{' / ' + str(data.get('conclusion')) if data.get('conclusion') else ''}"
                     f"  attempt {data.get('run_attempt')}  {data.get('head_branch')} {str(data.get('head_sha') or '')[:10]}")
        jobs = entry.get("jobs")
        if jobs is not None:
            # Real failures before cancelled jobs: the capped list leads with what to fix.
            bad = sorted((j for j in jobs if j.get("conclusion") not in (None, *RUN_OK)),
                         key=lambda j: str(j.get("conclusion") or "").lower() == "cancelled")
            live = [j for j in jobs if j.get("status") != "completed"]
            covered = jobs_attempt(jobs)
            stale = (f" (from attempt {covered}; attempt {data.get('run_attempt')} not read yet)"
                     if 0 < covered < (data.get("run_attempt") or 1) else "")
            lines.append(f"jobs: {len(jobs)} total, {len(bad)} failed, {len(live)} not finished{stale}")
            for j in bad[:shown_failed]:
                refused = f" (refused by {j.get('runner_name')})" if refused_job(j) else ""
                lines.append(f"  {outcome(j.get('conclusion'))}: {j.get('name')}{steps_note(j)}{refused}  "
                             f"{j.get('html_url') or ''}".rstrip())
        held = run_hold(data, jobs, now, grace)
        if held:
            lines.append(f"  held: attempt {data.get('run_attempt')} failed only because a glaeda runner refused "
                         f"{', '.join(str(j.get('name')) for j in held[:5])} at setup; pending up to {int(grace)}s "
                         "for a rescue attempt")
        lines.append(str(data.get("html_url") or ""))
    note = f"  (last error: {entry['error']})" if entry.get("error") else ""
    via = {"rest": ", read over REST", "graphql": ", read over GraphQL",
           "graphql-probe": ", confirmed unchanged over GraphQL"}.get(entry.get("via"), "")
    lines.append(f"data {age(entry.get('dataAt'))}{via}{note}")
    return "\n".join(lines)


def render(key: str, entry: dict | None, as_json: bool, extra: dict | None = None, until: str = "done",
           grace: float = RESCUE_GRACE, verbose: bool | None = None) -> str:
    if as_json:
        return json.dumps({"key": key, **(entry or {}), **(extra or {})}, sort_keys=True) + "\n"
    rest = {k: v for k, v in (extra or {}).items() if k not in CONTRACT_KEYS}
    lines = [summary(key, entry, until, grace, verbose)] + [f"{k}: {v}" for k, v in rest.items()]
    if extra and extra.get("ok") is False:
        # the agent output contract (cmuxterm-hq docs/handbook/agent-facing-output.md): what is wrong, then
        # `next:` as the last line, on the stream the rest of the answer uses
        if extra.get("reason"):
            lines.append(f"glaeda-gh: {extra['reason']}")
        lines.append(f"next: {extra.get('next') or 'none'}")
    return "".join(f"{line}\n" for line in lines)


CONTRACT_KEYS = ("ok", "code", "reason", "next")
WAIT_PROGRESS_EVERY = 120  # a `wait pr|run` says how it stands this often while it blocks


def key_name(key: str) -> str:
    """OWNER/REPO#N for a PR or comment thread, OWNER/REPO/ID for a run: what a command takes back."""
    kind, owner, repo, number = split_key(key)
    return f"{owner}/{repo}{'/' if kind == 'run' else '#'}{number}"


def utc_clock(at: float) -> str:
    """A wall-clock time in UTC with a Z (`17:55:00Z`), or "unknown" past what a clock can hold."""
    try:
        return time.strftime("%H:%M:%SZ", time.gmtime(at))
    except (ValueError, OSError, OverflowError):
        return "unknown"


def ok_fields() -> dict:
    return {"ok": True, "code": "ok", "reason": "", "next": ""}


def fail_fields(code: str, reason: str, nxt: str) -> dict:
    return {"ok": False, "code": code, "reason": reason, "next": nxt}


def not_found_fields(key: str) -> dict:
    kind, owner, repo, _ = split_key(key)
    what = "run" if kind == "run" else "PR or issue"
    listing = f"gh run list -R {owner}/{repo} --limit 5" if kind == "run" else \
        f"gh pr list -R {owner}/{repo} --state all --limit 5"
    return fail_fields("not-found", f"{key_name(key)}: no such {what} on GitHub (or this token cannot see it)",
                       listing)


def wait_command(req: dict) -> str:
    """The same wait again: what a timed-out wait names as its `next:` (a wait is a next step only with a deadline)."""
    parts = ["glaeda-gh", "wait", req["kind"], key_name(req["key"])]
    if req["kind"] == "pr" and req.get("until", "green") != "green":
        parts += ["--until", req["until"]]
    if req.get("sha"):
        parts += ["--sha", str(req["sha"])]
    if req.get("jobs"):
        parts.append("--jobs")
    return " ".join(parts + ["--timeout", f"{float(req['timeout']):g}"]
                    + ([] if wait_max(req) == default_wait_max(float(req["timeout"])) else
                       ["--max", f"{wait_max(req):g}"]))


# The leash (Leo, 2026-11-21: "if it's too short, it's like bullshit because it just instantly flails over when it
# dies ... We can listen for success outputs"). `--timeout S` was a total wall-clock bound: a run that was still
# starting jobs and finishing steps at S ended "timeout" all the same, and its `next:` was the same wait again, so an
# agent re-waited a run that had never stopped moving. Now --timeout is "no progress for S": the deadline is S past
# the last time the waited thing's observed state changed (wait_progress_mark: a PR's checks, head or state; a run's
# status, attempt, updated_at and, with --jobs, its jobs and steps; a comment thread's comments; a file's size and
# mtime; a process's CPU time). A wait whose target does not move still ends at S, exactly as before. --max is the
# hard ceiling from the wait's start (default WAIT_MAX_TIMES x --timeout), so a target that keeps moving forever is
# still not waited on forever. The outcome says which ended it: `ended_by` success, failure, ..., no-progress or
# ceiling.
WAIT_MAX_TIMES = 4


def default_wait_max(timeout: float) -> float:
    return WAIT_MAX_TIMES * float(timeout)


def wait_max(req: dict) -> float:
    """The wait's hard ceiling, seconds from its start: never under its --timeout."""
    ceiling = req.get("max")
    ceiling = default_wait_max(float(req["timeout"])) if not isinstance(ceiling, (int, float)) or \
        isinstance(ceiling, bool) else float(ceiling)
    return max(float(req["timeout"]), ceiling)


def wait_moved_at(req: dict) -> float:
    """When the waited thing last changed as this wait saw it (its start, before any change)."""
    moved = req.get("moved") if isinstance(req.get("moved"), dict) else {}
    at = moved.get("at")
    began = float(req["began"])
    return max(began, float(at)) if isinstance(at, (int, float)) and not isinstance(at, bool) else began


def wait_deadline(req: dict) -> float:
    """When the wait ends with no answer: --timeout past the last change it saw, and never past its --max."""
    began = float(req["began"])
    return min(began + wait_max(req), wait_moved_at(req) + float(req["timeout"]))


def wait_ended_by(req: dict, now: float) -> str:
    """What ended a wait that got no answer: its ceiling, or --timeout with nothing changing."""
    return "ceiling" if now - float(req["began"]) >= wait_max(req) and \
        wait_moved_at(req) + float(req["timeout"]) > float(req["began"]) + wait_max(req) else "no-progress"


def run_progress_print(data: dict, jobs: Any) -> Any:
    """What of a run counts as it moving: its status, conclusion, attempt and updated_at, and each job's and step's."""
    steps = []
    for j in jobs if isinstance(jobs, list) else []:
        if isinstance(j, dict):
            steps.append([j.get("id"), j.get("status"), j.get("conclusion"),
                          [[s.get("number"), s.get("status"), s.get("conclusion")]
                           for s in j.get("steps") or [] if isinstance(s, dict)]])
    return [data.get(k) for k in ("status", "conclusion", "run_attempt", "updated_at")] + [steps]


def wait_progress_print(kind: str, entry: dict | None) -> str | None:
    """A fingerprint of what a `wait pr|run|comment` watches, or None before anything was read. Read times are left
    out on purpose: a re-read that finds the same state is not progress."""
    data = (entry or {}).get("data")
    if not isinstance(data, dict):
        return None
    if kind == "run":
        mark: Any = run_progress_print(data, (entry or {}).get("jobs"))
    elif kind == "comment":
        mark = [[c.get("id"), c.get("updatedAt") or c.get("createdAt")]
                for c in data.get("comments") or [] if isinstance(c, dict)]
    else:
        mark = [data.get(k) for k in ("state", "headRefOid", "mergeable", "checkState")] + [
            [c.get("name"), c.get("status"), c.get("conclusion"), c.get("startedAt"), c.get("completedAt")]
            for c in data.get("checks") or [] if isinstance(c, dict)]
    return hashlib.sha256(json.dumps(mark, sort_keys=True, default=str).encode()).hexdigest()[:16]


def wait_progress_mark(req: dict, mark: str | None, now: float, seen: str = "") -> bool:
    """Note what the wait sees now in REQ["moved"] ({"print", "at", "seen"}); True when it changed since the last
    look. The first thing read is where it starts, not a change: a target that never moves ends at --timeout."""
    if mark is None:
        return False
    moved = req.get("moved") if isinstance(req.get("moved"), dict) else None
    if moved is None:
        req["moved"] = {"print": mark, "at": float(req["began"]), "seen": seen, "changes": 0}
        return False
    if moved.get("print") == mark:
        return False
    req["moved"] = {"print": mark, "at": now, "seen": seen, "changes": int(moved.get("changes") or 0) + 1}
    return True


def wait_leash_fields(req: dict, now: float) -> dict:
    """What a wait that got no answer says about why it ended: --json's ended_by, last_progress_at and its limits."""
    moved = req.get("moved") if isinstance(req.get("moved"), dict) else {}
    out = {"ended_by": wait_ended_by(req, now), "no_progress_s": float(req["timeout"]), "max_s": wait_max(req),
           "progress_changes": int(moved.get("changes") or 0)}
    if moved.get("changes"):
        out["last_progress_at"] = utc_clock(wait_moved_at(req))
    return out


# A wait that cannot read its target must say so, name the bucket and the reset, and name a next step that can end
# the hold (docs/handbook/refusal-next-step-cannot-end-the-hold.md). Three states read as the same "no data yet"
# today and are not:
#   (a) the daemon has not got around to reading it yet: transient, and retrying is right;
#   (b) the daemon cannot read it, because the bucket its reads go over has stopped: it reads nothing for that kind
#       until a known reset, so the same wait again reads nothing either;
#   (c) a bucket whose own reading shows headroom is refused anyway: a fault of its own, with its own fix, and
#       never to be dressed up here as the shared quota running out.
# (b) is already on this host's disk from the first second, free: daemon.json's `paths` says which bucket each kind
# is read over now, `modes` what the quota lets that bucket do, `restShare.capped` whether this daemon's own REST
# share is spent, and budget.json carries that bucket's last reading with its reset. The wait path read none of it.
# Measured 2026-11-21, one GraphQL exhaustion window: three lanes ran `glaeda-gh wait pr ... --sha ... --timeout
# 1800` (leo-workspace#7208, leo-workspace#7188, cmuxterm-hq#16555). All three printed `...: no data yet` at every
# one of their fourteen progress lines for the full 1800 s, then `result: timeout`, `last seen: no data yet` and a
# `next:` that was the identical command -- which an agent takes. 90 minutes of blocked lane time in one window for
# a fact three file reads away, and `glaeda-gh budget` on the same host printed the bucket and the reset throughout.
BUCKET_NAME = {"rest": "REST", "graphql": "GraphQL"}
WAIT_UNTIL_SLACK = 30  # the `wait until RESET` a blocked wait names gets this much past the reset to be sure of it


def read_blocked(kind: str, now: float | None = None) -> dict | None:
    """Why nothing is being read for KIND's targets now, from the files the daemon already writes every heartbeat:
    no GitHub call, no quota spent. None when a route is open (state (a) above), or when there is no daemon record
    to read, or on a host whose reads go through another host's daemon (it has no bucket of its own to name).

    Else {"bucket", "label", "routed", "reset", "remaining", "limit", "exhausted", "text"}: `bucket` is what has to
    come back before anything is read for KIND and `routed` the bucket its reads go over now -- the same except when
    a spent REST share leaves a REST-routed kind waiting on GraphQL. `reset` is when reads really resume, and only
    then: None when no reading or hold names such a time, because a refusal that offers a reset which frees nothing
    sends its reader to a moment at which nothing changes (docs/handbook/refusal-next-step-cannot-end-the-hold.md).
    `exhausted` is whether `bucket`'s own reading backs the stop. False there is state (c): the stop is real and
    worth saying, its cause is not the shared quota running out, and the text must not claim it is."""
    now = time.time() if now is None else now
    status = read_json(BASE / "daemon.json")
    if not isinstance(status, dict) or not isinstance(status.get("modes"), dict):
        return None
    if isinstance(status.get("upstream"), dict):
        return None
    modes = status["modes"]
    paths = status.get("paths") if isinstance(status.get("paths"), dict) else {}
    share = status.get("restShare") if isinstance(status.get("restShare"), dict) else {}
    bucket = paths.get(kind) if paths.get(kind) in BUCKET_NAME else BUCKETS.get(kind)
    if bucket is None:
        return None
    # The bucket KIND is routed over has stopped. Daemon.route() already moves a kind off a stopped bucket when the
    # other one can take its reads, so a kind still routed over a stopped bucket has no second route this tick.
    routed = bucket  # the bucket KIND's reads go over right now
    # REST not stopped, but this daemon's own REST share spent while GraphQL is stopped: the route KIND sits on
    # carries nothing, and what frees its reads is GraphQL's reset, not REST's.
    shared_out = (modes.get(routed) != "stop" and routed == "rest" and share.get("capped") is True
                  and modes.get("graphql") == "stop")
    if modes.get(routed) != "stop" and not shared_out:
        return None
    if shared_out:
        # Measured on this host 2026-11-21: `wait run manaflow-ai/cmuxterm-hq/44907253327` refused with REST's
        # headroom (3573 of 5000) and REST's reset (13:27:38Z), while what held the reads was GraphQL at 0 of 5000
        # resetting 13:38:35Z -- eleven minutes later, and nothing changes at 13:27:38Z. A reset that frees nothing
        # is worse than none: `wait until 13:27:38Z && <the same wait>` reads nothing either. Name the bucket that
        # has to come back, and say the share as well, since that is why REST's own headroom is no answer.
        bucket = "graphql"
    seen = read_json(BASE / "budget.json") or {}
    seen = seen.get(bucket) if isinstance(seen.get(bucket), dict) else {}
    whole = lambda v: v if isinstance(v, int) and not isinstance(v, bool) else None  # noqa: E731
    remaining, limit = whole(seen.get("remaining")), whole(seen.get("limit"))
    reset = seen.get("reset")
    reset = float(reset) if isinstance(reset, (int, float)) and not isinstance(reset, bool) and reset > now else None
    label = BUCKET_NAME[bucket]
    reserve = daemon_policy()["floors"][bucket][1]
    exhausted = remaining is not None and remaining < reserve
    left = (f"{remaining} of {limit} left" if remaining is not None and limit is not None else
            f"{remaining} left" if remaining is not None else "its last reading is unknown")
    when = f", resets {utc_clock(reset)}" if reset is not None else " (its reading names no reset)"
    # A stop GitHub itself ordered (a secondary 403 holds both buckets, Daemon.secondary_until) is not the quota
    # running out and its own `until` is what ends it: that is the next step, not a quota reset it has nothing to do
    # with. Every branch below leaves `reset` set only when it is really when these reads resume, because that is the
    # only kind of time a refusal may offer as a deadline.
    hold = status.get("secondaryHold") if isinstance(status.get("secondaryHold"), dict) else {}
    until = hold.get("until")
    until = float(until) if isinstance(until, (int, float)) and not isinstance(until, bool) and until > now else None
    share_spent = (f"; this daemon's own REST share, which a {kind} is read over, is spent, so its REST reads "
                   "carry none of them either") if shared_out else ""
    if exhausted:
        text = (f"the shared {label} quota for this login is spent ({left}, under the {reserve} this daemon keeps "
                f"back for lands{when}): nothing is read for a {kind} until then, so the same wait again reads "
                f"nothing either{share_spent}")
    elif until is not None:
        reset = until
        text = (f"GitHub told this daemon to back off, so nothing is read for a {kind} before {utc_clock(until)}; "
                f"the shared {label} quota is not what stopped it ({left}){share_spent}")
    else:
        # State (c): the bucket's own reading backs no stop and no hold says when it ends, so its quota reset frees
        # nothing and must not be offered -- a reader sent to a time at which nothing changes waits it out twice.
        reset = None
        text = (f"this daemon has stopped its {label} reads, so nothing is read for a {kind} now; its own last "
                f"{label} reading still shows headroom ({left}), so this is not the shared quota running out and "
                f"no quota reset ends it: `glaeda-gh budget` says what the daemon is doing{share_spent}")
    return {"bucket": bucket, "label": label, "routed": routed, "reset": reset, "remaining": remaining,
            "limit": limit, "exhausted": exhausted, "text": text}


_blocked_memo: dict[tuple, dict | None] = {}


def _blocked_stamp() -> tuple:
    """What the answer depends on: the two records' mtimes. A memo on this and not on a clock cannot answer from a
    file that has since changed (the daemon rewrites both every tick)."""
    out = []
    for name in ("daemon.json", "budget.json"):
        try:
            out.append((BASE / name).stat().st_mtime_ns)
        except OSError:
            out.append(None)
    return tuple(out)


def blocked_now(kind: str, now: float | None = None) -> dict | None:
    """read_blocked, but never the reason a wait fails: a bad record or an unreadable config costs the note, not
    the wait. Memoized on the records' mtimes, so the daemon serving many waits in one tick reads them once."""
    at = time.time() if now is None else now
    try:
        key = (kind, str(BASE), int(at // 1), _blocked_stamp())
    except Exception:  # noqa: BLE001
        key = None
    if key is not None and key in _blocked_memo:
        return _blocked_memo[key]
    try:
        answer = read_blocked(kind, at)
    except Exception:  # noqa: BLE001  a diagnostic never stops a wait
        answer = None
    if key is not None:
        if len(_blocked_memo) > 64:
            _blocked_memo.clear()
        _blocked_memo[key] = answer
    return answer


def blocked_next(req: dict, blocked: dict) -> str:
    """The `next:` of a wait a stopped bucket blocked: a wait that ends, then the same wait -- never the
    invocation that just returned nothing, which is worse than no next step because an agent takes it.
    `wait until HH:MM:SSZ` is the reset this host read itself; `wait until quota` is the fallback when the reading
    names no reset (it waits out this host's gh-quota marks and is read again on every pass)."""
    again = wait_command(req)
    reset = blocked.get("reset")
    if isinstance(reset, (int, float)) and not isinstance(reset, bool):
        return (f"glaeda-gh wait until {utc_clock(reset)} "
                f"--timeout {max(1, int(reset - time.time()) + WAIT_UNTIL_SLACK)} && {again}")
    if not blocked.get("exhausted"):
        # State (c): no quota ran out, so `wait until quota` would wait for the end of something that never began.
        # What can end this is the daemon itself, so the step is to look at it (`restart` refuses when restarting
        # would not fix it, and says what would).
        return f"glaeda-gh budget && glaeda-gh restart && {again}"
    return f"glaeda-gh wait until quota --timeout {float(req['timeout']):g} && {again}"


def feed_covers(key: str, now: float | None = None) -> bool:
    """Whether the build controller's change feed covers KEY's repository now, from the two facts Daemon.fed itself
    uses (published in daemon.json's `controller`): the feed answered within CONTROLLER_FRESH and delivered an event
    for that repository within FED_REPO_KEEP. Such a run's finish arrives over the feed, which costs no quota, so a
    stopped read bucket does not mean nothing can be learned about it. Unknown counts as covered: an older daemon
    publishes neither field, and the one thing a wait must not do on a guess is give up early."""
    now = time.time() if now is None else now
    status = read_json(BASE / "daemon.json")
    feed = status.get("controller") if isinstance(status, dict) and isinstance(status.get("controller"), dict) else None
    if feed is None or "fedRepos" not in feed:
        return True
    ok_at = feed.get("okAt")
    if not isinstance(ok_at, (int, float)) or isinstance(ok_at, bool) or now - ok_at > CONTROLLER_FRESH:
        return False
    _, owner, repo, _ = split_key(key)
    fed = feed.get("fedRepos") if isinstance(feed.get("fedRepos"), dict) else {}
    at = fed.get(f"{owner}/{repo}".lower())
    return isinstance(at, (int, float)) and not isinstance(at, bool) and now - at <= FED_REPO_KEEP


def blocked_before_deadline(kind: str, key: str, deadline: float, now: float) -> dict | None:
    """The blocked record when nothing will be read for KEY before DEADLINE, so every second of the wait left would
    be spent the way its first ones were -- on nothing -- else None. The caller returns now and names the wait that
    ends instead of the one that just did not.

    One rule for every kind, because the reason is one: no read comes, and the time that would free them is past
    this wait's own end. A run is the single exception, and only where it is true: while the controller's feed
    covers its repository its finish still arrives over the feed, costing no quota (feed_covers)."""
    blocked = blocked_now(kind, now)
    if blocked is None or blocked["reset"] is None or blocked["reset"] < deadline:
        return None  # readable again inside this wait, or held by something no reset ends (then there is no deadline
        # to compare: that stop is the refusal's own fault to fix, and read_blocked says so rather than guessing)
    if kind == "run" and feed_covers(key, now):
        return None
    return blocked


def blocked_start_line(key: str, kind: str) -> str | None:
    """What a wait says before it blocks when nothing can be read for it now: said immediately, because the whole
    loss this fixes was learning it at the deadline instead."""
    blocked = blocked_now(kind)
    if blocked is None:
        return None
    resumes = (f" This wait reads nothing before {utc_clock(blocked['reset'])}: "
               f"`glaeda-gh wait until {utc_clock(blocked['reset'])}` is the wait that ends."
               if blocked.get("reset") is not None else "")
    return f"glaeda-gh: {key_name(key)} cannot be read right now: {blocked['text']}.{resumes}"


def progress_state(key: str, entry: dict | None, until: str = "done", grace: float = RESCUE_GRACE) -> str:
    """How a waited PR or run stands, on one line: the summary's headline (and a PR's checks line). When nothing
    is being read for its kind (read_blocked) and the data is not fresh, the line names the bucket and the reset
    as well: "no data yet" alone reads as "its CI has not started", which is the one thing it does not mean."""
    lines = [line.strip() for line in summary(key, entry, until, grace, False).splitlines()]
    keep = lines[:2] if split_key(key)[0] == "pr" else lines[:1]
    state = "; ".join(line for line in keep if line and not line.startswith("http"))
    at = (entry or {}).get("dataAt")
    fresh = (entry or {}).get("data") and isinstance(at, (int, float)) and not isinstance(at, bool) \
        and time.time() - at < WAIT_PROGRESS_EVERY
    blocked = None if fresh else blocked_now(split_key(key)[0])
    return f"{state}; {blocked['text']}" if blocked is not None else state


def progress_line(req: dict, state: str, now: float | None = None) -> str:
    """What a wait says every WAIT_PROGRESS_EVERY while it blocks. BLOCKER prints the same words."""
    now = time.time() if now is None else now
    began, timeout = float(req["began"]), float(req["timeout"])
    return (f"glaeda-gh: still waiting on {req['key']}: {int(max(0.0, now - began))}s, no change for "
            f"{int(max(0.0, now - wait_moved_at(req)))}s of {timeout:g}s, deadline {utc_clock(wait_deadline(req))} "
            f"(moves while it progresses; ceiling {utc_clock(began + wait_max(req))})" + (f"; {state}" if state else ""))


# A progress line that repeats the one before it is not information. teamleaderleo/leo-workspace#7188, 2026-11-21
# 09:30-10:06Z: one `wait pr ... --timeout 1800` printed
#   o/r#7188 OPEN  mergeable=MERGEABLE (UNSTABLE); checks PENDING: 1 passed, 0 failed, 1 pending (of 2, 0 required)
# at seven consecutive progress lines -- 840 s, half its budget -- and then timed out, while the fact worth saying sat
# in that same data from the first of them: one check had been pending alone for 14 minutes beside the only sibling it
# had, which had already passed. That is a stuck check and it is actionable (requeue it, override, or go look at why it
# never started); the wait said nothing of it, and the reader's context filled with seven identical paragraphs.
# WAIT_STUCK_AFTER is two progress intervals: the first line says the state, the second would be the first identical
# repeat, so the diagnosis takes a repeat's place instead of adding a line. (WAIT_DIAGNOSE_AFTER, 120 s, bounds the
# other silence -- a wait that cannot read at all, glaeda#2316. The two must stay apart: that one says "I cannot see",
# this one says "I can see, and nothing is moving".)
WAIT_STUCK_AFTER = 2 * WAIT_PROGRESS_EVERY
STUCK_NAMED = 5  # how many pending checks a stuck diagnosis names, oldest first


def stuck_next(c: dict, key: str) -> str:
    """A next step for a check that is not moving: its own run, which says whether its job ever got a runner. The wait
    cannot end before that check does, so the step is about the check and never another identical wait
    (docs/handbook/wait-that-cannot-end.md)."""
    _, owner, repo, _ = split_key(key)
    return f"gh run view {c['runId']} -R {owner}/{repo}" if c.get("runId") \
        else f"glaeda-gh status pr {key_name(key)} --verbose"


def unseen_next(data: dict, key: str) -> str:
    """A next step for an unfinished check this wait cannot name, because the rollup it read stopped at 100 contexts:
    the page past that one, listing what has not completed. Never this same wait again
    (docs/handbook/wait-that-cannot-end.md: every `next:` names something that can change the state it waits on)."""
    _, owner, repo, _ = split_key(key)
    sha = data.get("headRefOid") or ""
    return (f"""gh api "repos/{owner}/{repo}/commits/{sha}/check-runs?per_page=100&page=2" """
            """--jq '.check_runs[]|select(.status!="completed")|.name'""" if sha
            else f"glaeda-gh status pr {key_name(key)} --verbose")


def stuck_note(key: str, entry: dict | None, unchanged: float, grace: float = RESCUE_GRACE,
               now: float | None = None) -> str | None:
    """What a wait says once its own rendered state has not changed for WAIT_STUCK_AFTER: which checks are still
    pending and how long each has been (the age is the load-bearing part -- "pending" alone reads the same at 20 s and
    at 14 min), that their siblings have finished when they have, and a next step for a check that is not moving.

    None while there is nothing to say: the state has not been still that long, the target is not a PR (a run's status
    is its own state), or nothing is pending. Never the blind read of glaeda#2316, which is the opposite case: there
    nothing was read and the words name the bucket and the reset; here the data is current and no part of it moves."""
    now = time.time() if now is None else now
    if unchanged < WAIT_STUCK_AFTER or split_key(key)[0] != "pr":
        return None
    data = (entry or {}).get("data")
    if not isinstance(data, dict) or not isinstance(data.get("checks"), list) or not data["checks"]:
        return None
    if not all(isinstance(c, dict) for c in data["checks"]):
        return None  # a cache this shape is a bug elsewhere; the note is never the thing that raises into a wait
    groups = classify(data, now, grace)
    pending = groups["pending"]
    # What the rollup's own counts say is unfinished past the 100 contexts it returned. The one check that decided
    # manaflow-ai/cmux#48834 (1501 s, 2026-11-21) was there, so everything 25 minutes of waiting said about it was
    # "0 pending, 1 more unfinished past the first 100" -- a line that reads as self-contradictory because the count
    # it can see and the count it cannot are in the same breath. A read that did not happen is unknown
    # (docs/handbook/missing-read-counted-as-a-value.md): the wait names that part as unseen instead of absorbing it.
    unseen = max(0, pending_on_every_page(data) - len(pending) - len(groups["held"]))
    if not pending and not unseen:
        return None

    def since(c: dict) -> float | None:
        started = iso_epoch(c.get("startedAt"))
        return started if started is not None and started <= now else None

    def said(c: dict) -> str:
        started = since(c)
        return (f"{label(c)} pending {span(now - started)} (since {utc_clock(started)})" if started is not None
                else f"{label(c)} pending (GitHub reports no start time for it)")
    oldest = sorted(pending, key=lambda c: since(c) if since(c) is not None else now)
    named = "; ".join(said(c) for c in oldest[:STUCK_NAMED])
    more = f"; +{len(oldest) - STUCK_NAMED} more pending" if len(oldest) > STUCK_NAMED else ""
    done = len(groups["passed"]) + len(groups["failed"])
    siblings = (f", and its {done} sibling(s) have finished ({len(groups['passed'])} passed, "
                f"{len(groups['failed'])} failed)" if done else "")
    alone = (" A lone check pending beside siblings that all passed is usually stuck, not slow."
             if len(pending) == 1 and not unseen and groups["passed"] and not groups["failed"]
             and not groups["held"] else "")
    # The rollup can already be red while a `--until done` wait goes on (it ends on the checks, not on the rollup):
    # cmux#48834 said PENDING against a rollup FAILURE for 25 minutes and never said the two were not the same test.
    rollup = str(data.get("checkState") or "").upper()
    disagrees = (f" GitHub's rollup already says {rollup}; this wait ends on the checks it counts, not on the rollup, "
                 "so a red there does not end it." if rollup in COUNT_BAD else "")
    stands = (f"{len(pending)} of {len(data['checks'])} checks are still pending" if pending
              else f"every one of the {len(data['checks'])} checks it can read has finished")
    lines = [f"glaeda-gh: WARNING: {key_name(key)} has not changed for {span(unchanged)}: "
             f"{stands}{siblings}.{alone}{disagrees}"]
    if pending:
        lines.append(f"  not moving: {named}{more}")
    if unseen:
        lines.append(f"  cannot see: {unseen} unfinished context(s) past the first {len(data['checks'])} this "
                     "rollup returned; pagination, not this PR, decided that this wait cannot name them")
    lines.append(f"next: {stuck_next(oldest[0], key) if pending else unseen_next(data, key)}")
    return "\n".join(lines)


def progress_update(seen: dict, req: dict, entry: dict | None, now: float | None = None) -> str | None:
    """What a wait's next progress line carries, or None for "say nothing": the state whenever it differs from the one
    the last line carried, that state and a one-time stuck diagnosis (stuck_note) once it has not changed for
    WAIT_STUCK_AFTER, and nothing at all while it is the state this wait has already said. SEEN is the wait's memory
    of its own output ({"state", "at", "stuck"}), updated in place; the daemon path keeps the same three on the
    request, and its blocker drops a line it already printed the same way."""
    now = time.time() if now is None else now
    grace = float(req.get("grace", RESCUE_GRACE))
    state = progress_state(req["key"], entry, str(req.get("until") or "done"), grace)
    if state != seen.get("state"):
        seen.update(state=state, at=now, stuck=False)
        return state
    if seen.get("stuck"):
        return None  # the same state, already diagnosed: silence until something actually changes
    note = stuck_note(req["key"], entry, now - float(seen.get("at") or now), grace, now)
    if note is None:
        return None
    seen["stuck"] = True
    return f"{state}\n{note}"


def wait_outcome(req: dict, result: int, entry: dict | None, waited: int) -> dict:
    """ok, code, reason and next for a decided or timed-out `wait pr|run` (agent output contract)."""
    key, kind = req["key"], req["kind"]
    name = key_name(key)
    _, owner, repo, number = split_key(key)
    data = (entry or {}).get("data") or {}
    if result == EXIT_OK:
        return ok_fields()
    if result in (EXIT_TIMEOUT, EXIT_INCONCLUSIVE) and kind == "pr" and data.get("state") in ("MERGED", "CLOSED"):
        # a PR that finished is never waited on again (a timeout cannot come from one, but the line must not say so)
        return fail_fields("timeout" if result == EXIT_TIMEOUT else "inconclusive",
                           f"waited {waited} s for {name}, which is {data.get('state')}",
                           f"gh pr view {number} -R {owner}/{repo}")
    if result == EXIT_TIMEOUT:
        state = progress_state(key, entry, req.get("until", "done"), float(req.get("grace", RESCUE_GRACE)))
        deadline = utc_clock(wait_deadline(req))
        blocked = blocked_now(kind)
        now = time.time()
        moved = req.get("moved") if isinstance(req.get("moved"), dict) else {}
        changes = int(moved.get("changes") or 0)
        last = (f"last change {utc_clock(wait_moved_at(req))} ({changes} change(s) seen)" if changes
                else "no change since the wait began")
        if wait_ended_by(req, now) == "ceiling":
            # still moving at its --max: the same wait again is a wait on something that is going (it can end)
            return fail_fields("timeout", f"waited {waited} s for {name}, its ceiling (--max {wait_max(req):g}), while "
                               f"it was still changing ({last}); last seen: {state}",
                               blocked_next(req, blocked) if blocked else wait_command(req))
        return fail_fields("timeout", f"waited {waited} s for {name}: no change for {float(req['timeout']):g} s "
                           f"(deadline {deadline}; {last}); last seen: {state}",
                           blocked_next(req, blocked) if blocked else wait_command(req))
    if result == EXIT_CONFLICT:
        return fail_fields("conflict", f"{name} conflicts with its base (mergeable CONFLICTING)",
                           "none (merge or rebase onto the base and push; checks run after that push)")
    if result == EXIT_INCONCLUSIVE:
        if data.get("checksPageError") or req.get("runsUnread"):
            why = data.get("checksPageError") or "its Actions runs could not be read"
            blocked = blocked_now(kind)
            return fail_fields("inconclusive", f"{name}: the last read was partial ({why})",
                               blocked_next(req, blocked) if blocked else wait_command(req))
        return fail_fields("inconclusive", f"{name}: {inconclusive_note(data, time.time())}",
                           f"glaeda-gh status pr {name} (the queued checks' runner label; land_judge counts them "
                           "running)")
    if result == EXIT_NOTHING:
        head = str(data.get("headRefOid") or "")[:10]
        return fail_fields("nothing-reported", f"no check or status ever reported on {name} head {head}",
                           "none (its CI never started: push again, or check the repository's workflow triggers)")
    if kind == "pr" and data.get("state") == "CLOSED":
        return fail_fields("pr-closed", f"{name} was closed without being merged",
                           f"gh pr view {number} -R {owner}/{repo}")
    if kind == "run":
        return fail_fields("run-failed", f"run {name} finished {data.get('conclusion') or 'unsuccessfully'}",
                           f"glaeda-gh status run {name} --jobs")
    failed = classify(data, time.time(), float(req.get("grace", RESCUE_GRACE)))["failed"] if data else []
    run_id = next((c.get("runId") for c in failed if c.get("runId")), None)
    return fail_fields("checks-failed", f"{name}: {len(failed)} check(s) failed",
                       f"glaeda-gh status run {owner}/{repo}/{run_id} --jobs" if run_id
                       else "none (fix the failed checks listed above, push, and wait again)")


def emit(key: str, entry: dict | None, as_json: bool, extra: dict | None = None, until: str = "done",
         grace: float = RESCUE_GRACE) -> None:
    sys.stdout.write(render(key, entry, as_json, extra, until, grace))


BARE_NUMBER = re.compile(r"#?(\d+)")


def status_keys(kind: str, targets: list[str]) -> list[str]:
    """The cache keys of `status`'s targets, in order and each once. For PRs and comments a bare `#N` or
    `N` names that number in the repository of the target before it, so `o/r#1 #2 3` is three PRs."""
    keys: list[str] = []
    repo: str | None = None
    for text in targets:
        bare = BARE_NUMBER.fullmatch(text.strip()) if kind in ("pr", "comment") else None
        if bare and repo is not None:
            key = f"{kind}:{repo}#{int(bare.group(1))}"
        elif bare:
            # no target before it to borrow a repository from: parse_key reads the one the caller stands in
            key = parse_key(kind, text)
            repo = split_key(key)[1] + "/" + split_key(key)[2]
        else:
            key = parse_key(kind, text)
            repo = split_key(key)[1] + "/" + split_key(key)[2]
        if key not in keys:
            keys.append(key)
    return keys


def register_all(keys: list[str], jobs: bool = False, once: bool = False) -> None:
    """register() for several keys under one hold of the lock, so the daemon's next tick finds every
    one of them and reads them together (one batched GraphQL query per GQL_BATCH PRs) rather than
    one per tick as each arrives."""
    watch_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    with bounded_lock(watch_dir() / ".register.lock"):
        for key in keys:
            _register_locked(watch_dir() / file_name(key), key, jobs, None, once=once)


def status_view(key: str, entry: dict | None, grace: float = RESCUE_GRACE) -> dict:
    """What `--field` reads: the `--json` object with its `data` lifted to the top, plus `head` (the head
    commit) and, for a PR, `checks` as this tool reads them: {state, passed, failed, pending, held,
    total, required}, each group a list of checks (printed as their names)."""
    entry = entry or {}
    data = entry.get("data") if isinstance(entry.get("data"), dict) else {}
    view: dict[str, Any] = {"key": key, **{k: v for k, v in entry.items() if k != "data"}, **data}
    if not data:
        return view
    kind = split_key(key)[0]
    if kind == "pr":
        view["head"] = data.get("headRefOid")
        groups = classify(data, time.time(), grace)
        checks = data.get("checks") or []
        result = check_verdict(data, "done", time.time(), grace) if checks else None
        own, inherited_failed = split_inherited(data, groups["failed"])
        view["checks"] = {"state": checks_state(data, result),
                          **groups, "own": own, "inherited": inherited_failed,
                          "total": len(checks), "required": [c for c in checks if c.get("required")]}
    elif kind == "run":
        view["head"] = data.get("head_sha")
    return view


def field_value(view: dict, path: str) -> Any:
    here: Any = view
    walked: list[str] = []
    for part in path.split("."):
        if not isinstance(here, dict) or part not in here:
            where = ".".join(walked) or "the top level"
            valid = ", ".join(sorted(here)) if isinstance(here, dict) else "none (not an object)"
            raise WatchError(f"--field {path}: no {part!r} at {where}; valid keys there: {valid}")
        here = here[part]
        walked.append(part)
    return here


def field_text(value: Any) -> str:
    """A list prints comma-joined, a check (any object with a name) as its name alone; other objects as JSON."""
    if value is None:
        return ""
    if isinstance(value, bool):
        return str(value).lower()
    if isinstance(value, list):
        return ",".join(str(v.get("name")) if isinstance(v, dict) and "name" in v else field_text(v) for v in value)
    if isinstance(value, dict):
        return json.dumps(value, sort_keys=True)
    return str(value).replace("\t", " ").replace("\n", " ")


def render_fields(keys: list[str], entries: dict[str, dict | None], fields: list[str]) -> str:
    """One line per key, `fields` tab-separated, prefixed by OWNER/REPO#N when there are several keys. A
    field an entry with data does not have is an error.

    A row the daemon has no answer for prints its outcome code -- `no-data-yet`, or `not-found` for a
    ref GitHub does not have -- in every column, and its reason and `next:` step go to fd 2 (the rest
    of the answer is the table on fd 1).

    It used to print empty columns, which made "the daemon has not looked yet" byte-identical to "this
    field has no value": `status pr A B C D --field state,mergedAt,title` over four PRs, three unread,
    printed three rows of blanks, and `mergedAt` is empty on every open PR anyway, so there was nothing
    in the row to tell the two apart. A lander batching one `status` read -- the cheap, quota-correct
    thing, and what we tell landers to do -- reads those blanks as facts about the PRs and acts on
    them, while the exit code says only that *something* was unread, never which row. A sentinel is one
    extra token a parser must learn; a blank is a wrong answer it cannot detect."""
    lines, problems = [], []
    for key in keys:
        entry = entries.get(key)
        has = bool((entry or {}).get("data"))
        view = status_view(key, entry)
        if not has and split_key(key)[0] == "pr":
            # no data yet: check the names against the shape every PR has, so a typo is refused now
            # rather than printing an empty column until the first read lands
            shape = status_view(key, {"data": parse_pr({"state": "OPEN"})})
            for f in fields:
                field_value(shape, f)
        if has:
            values = [field_text(field_value(view, f)) for f in fields]
        else:
            outcome = status_outcome(key, entry)
            values = [outcome["code"]] * len(fields)
            problems.append(outcome)
        if len(keys) > 1:
            kind, owner, repo, number = split_key(key)
            values.insert(0, f"{owner}/{repo}{'/' if kind == 'run' else '#'}{number}")
        lines.append("\t".join(values))
    for outcome in problems:
        # the agent output contract: what is wrong, then `next:` as the last line (say_waiting's fd 2,
        # so a caller reading the table off stdout still reads only the table)
        say_waiting(f"glaeda-gh: {outcome['reason']}\nnext: {outcome['next'] or 'none'}")
    return "".join(f"{line}\n" for line in lines)


def parse_fields(text: str | None) -> list[str] | None:
    if text is None:
        return None
    fields = [f.strip() for f in text.split(",")]
    if not fields or any(not f or any(not part for part in f.split(".")) for f in fields):
        raise WatchError(f"--field takes a comma list of dotted names (head,checks.failed), not {text!r}")
    return fields


def say_daemon_problem(code: str, message: str, as_json: bool) -> None:
    """A daemon message (it ends with `next:`) on fd 2, and with --json the one object on stdout."""
    say_waiting(message)
    if as_json:
        text, _, nxt = message.rpartition("\nnext: ")
        print_json_error(code, (text or message).removeprefix("glaeda-gh: "), nxt or "glaeda-gh restart")


STATUS_DIRECT_MAX = 5  # direct reads one `status` makes for keys the daemon has not read when its wait ends


def cmd_status(kind: str, target: str | list[str], jobs: bool, as_json: bool, first_wait: float | None = None,
               fields: list[str] | None = None) -> int:
    """One look at one or more PRs, runs or comment threads. Several targets are registered together
    and waited for together, so the daemon gathers them in one tick. One target prints exactly what it
    always has; several print one block (or `--json` object, in a list) each, in the order given."""
    if first_wait is None:
        first_wait = daemon_policy()["cycle"] + 10.0  # a first read lands within one configured cycle
    keys = status_keys(kind, [target] if isinstance(target, str) else list(target))
    if not daemon_running(grace=DOWN_GRACE):
        say_daemon_problem("daemon-down", down_message(), as_json)
        return EXIT_DOWN
    broken = daemon_failing()
    if broken is not None:
        say_daemon_problem("daemon-failing", failing_message(broken), as_json)
        return EXIT_DOWN
    lag = daemon_stale()
    if lag is not None:
        say_waiting(stale_message(lag))
    # one look: the watch is dropped once the daemon has read it, unless something asks again (once_answered)
    if len(keys) == 1:
        register(keys[0], jobs, once=True)
    else:
        register_all(keys, jobs, once=True)
    deadline = time.monotonic() + first_wait

    def unready(entry: dict | None) -> bool:
        return entry is None or (jobs and "jobs" not in entry and not entry.get("error"))
    entries = {key: read_cache(key) for key in keys}
    while any(unready(e) for e in entries.values()) and time.monotonic() < deadline:
        time.sleep(1)
        entries = {key: entry if not unready(entry) else read_cache(key) for key, entry in entries.items()}
    # A key the daemon still has not read (an upstream-fed host asks its upstream for a new key only every
    # UPSTREAM_NEW, and the upstream may take a cycle or more) gets the one direct read `wait` gives a starved
    # target, under the same refusals (spent bucket, daemon stop, no login): a PR nobody watches yet is
    # answered, not "no data yet" after a full cycle. Bounded: STATUS_DIRECT_MAX reads, each DIRECT_READ_BUDGET.
    began = time.time()
    for key in [k for k in keys if unready(entries[k]) and split_key(k)[0] in ("pr", "run")][:STATUS_DIRECT_MAX]:
        kind = split_key(key)[0]
        blocked = blocked_now(kind)
        if blocked is not None and blocked.get("exhausted") and blocked["routed"] == blocked["bucket"]:
            say_waiting(f"glaeda-gh: not reading {key_name(key)} directly: {blocked['text']}.")
            continue
        say_waiting(f"glaeda-gh: the daemon has not read {key_name(key)} yet; reading GitHub directly once.")
        error = direct_read({"key": key, "kind": kind, "jobs": jobs, "began": began})
        if error:
            say_waiting(f"glaeda-gh: direct read failed: {error}.")
        entries[key] = read_cache(key)
    outcomes = {key: status_outcome(key, entries[key]) for key in keys}
    if fields is not None:
        sys.stdout.write(render_fields(keys, entries, fields))
    elif len(keys) == 1:
        emit(keys[0], entries[keys[0]], as_json, outcomes[keys[0]])
    elif as_json:
        sys.stdout.write(json.dumps([{"key": k, **(entries[k] or {}), **outcomes[k]} for k in keys],
                                    sort_keys=True) + "\n")
    else:
        for key in keys:
            emit(key, entries[key], False, outcomes[key])
    if all(o["ok"] for o in outcomes.values()):
        return EXIT_OK
    # not found is an answer (1); a target the daemon has not read yet is one it could not judge (3)
    return EXIT_FAIL if any(o["code"] == "not-found" for o in outcomes.values()) else EXIT_DOWN


def status_outcome(key: str, entry: dict | None) -> dict:
    """ok, code, reason and next for one `status` target (agent output contract)."""
    if entry and entry.get("data"):
        return ok_fields()
    if entry and entry.get("missing"):
        return not_found_fields(key)
    kind = split_key(key)[0]
    error = (entry or {}).get("error")
    return fail_fields("no-data-yet", f"{key_name(key)}: the daemon has not read it from GitHub yet"
                       + (f" (last error: {error})" if error else ""),
                       f"glaeda-gh wait {kind} {key_name(key)} --timeout 600" if kind in ("pr", "run")
                       else f"glaeda-gh status {kind} {key_name(key)}")


def git_rev_parse(prefix: str) -> str | None:
    """The full id of `prefix` in the current checkout, if it names exactly one commit. Local only."""
    try:
        result = run_bounded(["git", "rev-parse", "--verify", "--quiet", f"{prefix}^{{commit}}"], 5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    full = result.stdout.strip().lower()
    return full if result.returncode == 0 and re.fullmatch(r"[0-9a-f]{40}", full) and full.startswith(prefix) else None


def resolve_sha(sha: str) -> tuple[str, bool]:
    """(commit, exact). A 40-hex id is exact. A prefix is resolved in the current checkout; one that
    does not resolve stays a prefix, which must then match the head GitHub shows (see cmd_wait)."""
    if not re.fullmatch(r"[0-9a-fA-F]{7,40}", sha):
        raise WatchError(f"--sha must be a commit id (git rev-parse HEAD), 40 hex digits or a prefix of at least 7, not {sha!r}")
    sha = sha.lower()
    if len(sha) == 40:
        return sha, True
    full = git_rev_parse(sha)
    return (full, True) if full else (sha, False)


def waiting_line(key: str, until: str, sha: str | None, exact: bool, timeout: float,
                 ceiling: float | None = None, leash: bool = True) -> str:
    """What this wait is about, printed before it blocks.

    The point is what its *absence* means. A `wait` started from an agent session's foreground
    shell is reaped with that shell, silently, leaving a zero-byte output file -- which looks
    exactly like "blocked and still waiting", so the caller goes on waiting for something that is
    gone. Three of one lane's waits died that way in an afternoon before anyone noticed. With this
    line, an empty file means it never started and a file holding it means it did, which is a
    one-look diagnosis instead of a guess.

    On stderr, so a `--json` consumer still reads exactly one JSON document on stdout -- and
    through `say_waiting`, which is where the rules about not becoming the problem live.

    The deadline is a wall-clock time as well as a duration, because the duration alone cannot be
    compared with anything: a reader looking at a line in a file does not know when the process
    started, so "giving up after 3600s" says nothing about whether this wait is still inside its
    timeout. The time does."""
    return (f"glaeda-gh: waiting on {key} until {until}"
            + (f" at {sha}{'' if exact else '... (a prefix: it must match the head GitHub shows)'}"
               if sha else "")
            + (f", giving up after {timeout:g}s with no change (at {deadline_clock(timeout)} unless it changes; "
               f"ceiling {deadline_clock(max(timeout, default_wait_max(timeout) if ceiling is None else ceiling))})"
               if leash else f", giving up after {timeout:g}s (at {deadline_clock(timeout)})"))


def seconds(text: str) -> float:
    """A timeout `argparse` can refuse, rather than one the wait loop cannot honour.

    `type=float` took `inf` and `nan`. `inf` blocks forever, which is a process nobody is waiting
    for on purpose; `nan` is worse -- every comparison against it is false, so the loop never
    reaches its deadline and never exits (measured: killed from outside after 3 s). A formatter
    printing "unknown" for those was treating the symptom one layer too late.

    A duration with a unit (90s, 20m, 1h, 1d) is the same count: `wait until` already reads 45m,
    and `--timeout 20m` refused as "not a number of seconds" was a wasted call that came back."""
    unit = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([smhd])\s*", text)
    try:
        value = float(unit.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit.group(2)] if unit else float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{text!r} is not a number of seconds or a duration (90s, 20m, 1h)") from None
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(
            f"{text!r} is not a number of seconds this can wait for: a finite count, not negative")
    return value


def deadline_clock(timeout: float, now: float | None = None) -> str:
    """When this wait gives up, UTC with a Z (`HH:MM:SSZ`, the agent output contract), or "unknown" past what
    a clock can hold.

    `now if now is None` and not `now or`: a caller passing `0.0` meant the epoch and got the wall
    clock, which made the parameter a lie in the one case a test would use it."""
    try:
        return utc_clock((time.time() if now is None else now) + timeout)
    except (ValueError, OSError, OverflowError):
        return "unknown"


DIAGNOSTIC_WRITE_S = 0.2  # how long a wait lets its own diagnostic hold it up
_DIAGNOSTIC_WRITING = threading.Lock()


def say_waiting(line: str) -> None:
    """Put a diagnostic on fd 2 without ever becoming the reason the wait does not happen.

    Three measured ways `print(..., file=sys.stderr)` turned this into the failure it exists to
    diagnose, each one found by a review round:

    - stderr a pipe whose reader is gone -- `wait ... 2>&1 | head -1`, or the `setsid nohup ... &`
      the skill recommends, from a shell being reaped. `print` raised at interpreter shutdown and
      the process died in 0.19 s with exit **120** (CPython's "failed to flush stderr"), where it
      used to wait its full timeout and exit 2.
    - stderr closed (`2>&-`). `sys.stderr` is then `None`, and `print(file=None)` is documented as
      printing to **stdout** -- so the line became the first line of `--json` output.
    - stderr a *blocking pipe that is already full*, reader alive but not reading (a shared
      `{ ...; glaeda-gh wait ...; } 2>&1 | slow`, or a stopped reader). `os.write` then blocks
      forever: a 1 s wait hung past 5 s, which is worse for the caller than exiting 120. Errors are
      not the only way a write can be the problem; backpressure is the other.

    So the write runs on a daemon thread and the wait gives it `DIAGNOSTIC_WRITE_S`; a write still
    blocked after that is left behind (it lands if the reader drains, or dies with the process), and
    later lines are dropped while it is. Neither earlier answer held. Asking `select` first: writable
    promises room for PIPE_BUF bytes on a pipe (a 100 KB `--contains` line blocked a nearly full one),
    and 512-byte writes blocked on a full socket and on a terminal. Making fd 2 non-blocking for the
    write: O_NONBLOCK belongs to the file description, which the parent and every sibling share, so
    two overlapping waits left the parent's stderr non-blocking for good. (Cutting the line to 512
    bytes also lost the end of the serve refusal, which names `--foreground-ok`.)
    It is encoded with backslashreplace, because a filename's surrogate-escaped bytes raised
    `UnicodeEncodeError` and the wait died with exit 1 and no JSON.

    One path, which is the production path: an earlier version printed to `sys.stderr` when a
    caller had replaced it, so the suite's in-process assertions ran through a branch nothing else
    reached -- and a mutation deferring the real write to `atexit` (the line arriving *after* the
    wait, which is exactly no use) passed all 337 tests. The tests read fd 2 of the real CLI now,
    while it is still blocked."""
    data = (line + "\n").encode(errors="backslashreplace")
    if not _DIAGNOSTIC_WRITING.acquire(blocking=False):
        return  # the last line is still stuck on fd 2

    def write() -> None:
        try:
            rest = data
            while rest:
                rest = rest[os.write(2, rest):]
        except OSError:
            pass
        finally:
            _DIAGNOSTIC_WRITING.release()

    try:
        writer = threading.Thread(target=write, name="say-waiting", daemon=True)
        writer.start()
    except RuntimeError:  # no thread to be had: drop the line rather than risk the wait
        _DIAGNOSTIC_WRITING.release()
        return
    writer.join(DIAGNOSTIC_WRITE_S)


def wait_request(kind: str, target: str, until: str, timeout: float, jobs: bool, as_json: bool,
                 sha: str | None, exact: bool, grace: float, settle: float = SETTLE_GRACE,
                 ceiling: float | None = None) -> dict:
    """What a `wait pr|run` is ruled on: the same fields whether the client polls (cmd_wait) or the
    daemon rules on it (subscribe_wait). `began` is wall-clock time: only data fetched after it counts.
    TIMEOUT is "no change for this long" and CEILING (--max) the bound from `began` (wait_deadline)."""
    return {"key": parse_key(kind, target), "kind": kind, "target": target, "until": until, "timeout": timeout,
            "max": max(timeout, default_wait_max(timeout) if ceiling is None else ceiling),
            "jobs": jobs, "json": as_json, "sha": sha, "exact": exact, "grace": grace, "settle": settle,
            "began": time.time(), "verbose": full_output()}


def rest_run(data: dict | None) -> dict:
    """What a direct GitHub read (REST or GraphQL) showed of a run: kept as restRun, the proof a finish is GitHub's."""
    data = data or {}
    return {k: data.get(k) for k in ("run_attempt", "status", "conclusion")}


def controller_unconfirmed(entry: dict | None, now: float | None = None) -> bool:
    """A finished run whose finish came from the controller (directly, or through an upstream daemon) and that no
    direct GitHub read has shown (restRun, written only by fetch_run and the GraphQL run read): the controller can
    miss a rerun's deliveries and keep the last attempt's finish (manaflow-ai/cmux run 40434431701, 2026-10-27).
    Bounded: once the record is REST_SAFETY old (dataAt, which an unchanged record keeps) it counts, so a wait still
    rules when GitHub cannot be read and the controller is all there is."""
    entry = entry or {}
    # an upstream that does not say where its data came from (an older version) is treated as the controller's
    origin = (entry.get("origin") or "controller") if entry.get("source") == "upstream" else entry.get("source")
    data = entry.get("data")
    if origin != "controller" or not terminal("run", data):
        return False
    if entry.get("restRun") == rest_run(data):
        return False
    return (time.time() if now is None else now) - (entry.get("dataAt") or 0) < REST_SAFETY


_CONFIRM_REFUSED: dict[str, Any] = {}  # daemon.json's mtime -> confirm_refused's answer (wait_step runs every poll)


def confirm_refused() -> str | None:
    """Why the daemon cannot read GitHub to confirm a finished run now, or None: both of its routes stopped by the
    quota (GraphQL stopped, REST stopped or at the daemon's share), as daemon.json says. A wait then rules on the
    finish it has instead of sitting out the confirmation bounds (RUN_CONFIRM_MAX, REST_SAFETY) on a read that cannot
    happen: manaflow-ai/cmux run 43054254048, 2026-11-11 ~16:05Z, showed completed/success at 253 s and its wait ran
    past 857 s, both buckets stopped. A host reading through an upstream never says so (its upstream confirms)."""
    path = BASE / "daemon.json"
    try:
        info = path.stat()
        stamp = (info.st_mtime_ns, info.st_size)
    except OSError:
        return None
    if _CONFIRM_REFUSED.get("stamp") == stamp:
        return _CONFIRM_REFUSED.get("why")
    status = read_json(path)
    why = None
    if isinstance(status, dict) and not isinstance(status.get("upstream"), dict):
        modes = status.get("modes") if isinstance(status.get("modes"), dict) else {}
        share = status.get("restShare") if isinstance(status.get("restShare"), dict) else {}
        if modes.get("graphql") == "stop" and (modes.get("rest") == "stop" or share.get("capped") is True):
            why = ("GitHub's quota stops the daemon's reads (GraphQL stopped, REST "
                   f"{'stopped' if modes.get('rest') == 'stop' else 'at its share'})")
    _CONFIRM_REFUSED.clear()
    _CONFIRM_REFUSED.update(stamp=stamp, why=why)
    return why


def run_confirmed_since(entry: dict | None) -> float:
    """When a wait may last have been answered by an older attempt: a `gh run rerun` this host brokered (rerunAt)."""
    at = (entry or {}).get("rerunAt")
    return float(at) if isinstance(at, (int, float)) and not isinstance(at, bool) else 0.0


def run_unconfirmed(entry: dict | None, since: float, now: float) -> bool:
    """A finished run that no direct GitHub read (restRun, at restRunAt) has shown since SINCE, nor since the last rerun:
    the newest attempt may not be this one (RUN_CONFIRM_MAX). Bounded, so a wait still rules when GitHub cannot be
    read."""
    entry = entry or {}
    data = entry.get("data")
    if not terminal("run", data):
        return False
    since = max(since, run_confirmed_since(entry))
    shown = entry.get("restRunAt")
    if (isinstance(shown, (int, float)) and not isinstance(shown, bool) and shown >= since
            and entry.get("restRun") == rest_run(data)):
        return False
    return now - since < RUN_CONFIRM_MAX


def wait_step(req: dict, now: float, get: Callable[[str, list[str]], dict] | None = None) -> tuple[int, str] | None:
    """One look at a `wait pr|run` (wait_request): (exit code, what it prints) once it is decided or out
    of time, else None. Rules only on data the daemon fetched after the wait began, never on an older
    cache. A short --sha that GitHub's head resolves is written back into REQ. Raises WatchError."""
    key, kind, until, grace, began = req["key"], req["kind"], req["until"], req["grace"], req["began"]
    sha, exact, as_json = req.get("sha"), req.get("exact", True), req.get("json", False)
    entry = read_cache(key)
    fresh = entry is not None and (entry.get("fetchedAt") or 0) >= began
    waited = int(max(0.0, now - began))
    if fresh and not entry.get("data") and entry.get("missing"):
        # GitHub says NOT_FOUND; transport errors and 5xx stay pending
        return EXIT_FAIL, render(key, entry, as_json, {"result": "failure", "waited_s": waited, **not_found_fields(key)},
                                 until, grace, bool(req.get("verbose")))
    data = (entry or {}).get("data")
    if fresh and data:
        # a fresh read: whether the target moved since the last one stretches this wait's deadline (wait_deadline)
        wait_progress_mark(req, wait_progress_print(kind, entry), now)
    # only a merge is final; a completed run can be rerun and a closed PR reopened
    final = kind == "pr" and data and data.get("state") == "MERGED"
    usable = data and ((entry.get("dataAt") or 0) >= began or final)
    unconfirmed = usable and kind == "run" and (controller_unconfirmed(entry, now) or run_unconfirmed(entry, began, now))
    refused = confirm_refused() if unconfirmed else None
    if unconfirmed and refused is None:
        # the daemon reads GitHub once first (Daemon.due's confirm): the controller's finish, or a finish that may be
        # a superseded attempt's
        usable = False
    _, owner, repo, _ = split_key(key)
    if usable and sha:
        head = str(data.get("headRefOid" if kind == "pr" else "head_sha") or "").lower()
        if kind == "run" and head and not head.startswith(sha) and exact and data.get("event") == "workflow_dispatch":
            if run_tests_commit(data, f"{owner}/{repo}", sha):
                head = ""  # a dispatch that names the commit it tested: that commit is the one to match
            elif data.get("display_title") is None:
                # a record without the run-name (the controller's): neither refused nor ruled on until GitHub's read
                head, usable = "", False
        if head and not head.startswith(sha):
            if kind == "run":
                raise WatchError(f"run {req['target']} is for commit {head[:12]}, not {sha[:12]}; a run's commit never "
                                 "changes, and its run-name does not name that full commit as the one it tested")
            if not exact and not final:
                raise WatchError(f"--sha {sha} is not a commit in this checkout and is not the head GitHub shows "
                                 f"({head[:12]}); pass the full id (git rev-parse HEAD) to wait for a push "
                                 "GitHub has not seen yet")
        elif head and not exact:
            # resolved: a later push now counts as pending, as for a full id
            req["sha"], req["exact"] = sha, exact = head, True
    settle = float(req.get("settle", SETTLE_GRACE))
    if usable and kind == "pr" and until == "done" and data.get("state") == "OPEN":
        try:
            # the queued runs a done wait may end without (straggler_cut), read only once nothing else is unfinished
            data = straggler_pass(key, data, now, get)
            entry = {**entry, "data": data}
        except Exception as error:  # noqa: BLE001  a straggler read never stops the wait
            log({"event": "straggler-pass-failed", "key": key, "error": describe(error)})
    result = (verdict(kind, data, until, sha, (entry or {}).get("jobs"), time.time(), grace, f"{owner}/{repo}", settle)
              if usable else None)
    if result == EXIT_OK and kind == "pr" and until in ("done", "green") and data.get("state") == "OPEN":
        runs = head_runs_unfinished(key, data, now, get)
        if runs is None:
            req["runsUnread"] = True  # held; at the deadline, inconclusive
            result = None
        elif runs:
            req.pop("runsUnread", None)
            req["runsUnfinished"] = runs[:10]
            result = None  # a run queued or running at the head: not done, whatever the rollup shows
        else:
            req.pop("runsUnread", None)
            req.pop("runsUnfinished", None)
    if result is not None:
        merged = kind == "pr" and data.get("state") == "MERGED" and result == EXIT_OK
        outcome_name = {EXIT_OK: "merged" if merged else "success", EXIT_CONFLICT: "conflict", EXIT_NOTHING: "nothing-reported",
                        EXIT_INCONCLUSIVE: "inconclusive"}.get(result, "failure")
        extra: dict[str, Any] = {"result": outcome_name, "waited_s": waited, "ended_by": outcome_name}
        if kind == "pr" and result == EXIT_NOTHING:
            extra["note"] = (f"no check or status reported on this head within {int(settle)}s of its push: "
                             "its CI has not started (not a pass)")
        elif kind == "pr" and result == EXIT_INCONCLUSIVE:
            extra["note"] = inconclusive_note(data, time.time())
        elif kind == "pr" and result == EXIT_CONFLICT:
            extra["note"] = ("PR conflicts with its base (mergeable CONFLICTING): no checks run until you "
                             "merge or rebase onto the base and push")
        elif kind == "pr" and data.get("state") == "CLOSED":
            extra["note"] = "PR was closed without being merged"
        elif kind == "pr" and data.get("state") == "MERGED":
            merge_sha = str((data.get("mergeCommit") or {}).get("oid") or "")
            extra["note"] = ("PR was merged" + (f" at {merge_sha[:10]}" if merge_sha else "") + (
                f" (head {str(data.get('headRefOid') or '')[:10]}, not {sha[:10]})"
                if sha and not str(data.get("headRefOid") or "").startswith(sha) else "")
                + ": done, whatever its checks still show")
            if merge_sha:
                extra["merge_sha"] = merge_sha
        if unconfirmed and refused is not None:
            extra["note"] = f"finish not confirmed by a GitHub read: {refused}"
        if kind == "run" and result == EXIT_FAIL and grace > 0 and run_hold(data, entry.get("jobs"), time.time(), float("inf")):
            extra["note"] = f"a glaeda runner refused this attempt at setup and no rescue attempt followed within {int(grace)}s"
        extra.update(wait_outcome(req, result, entry, waited))
        return result, render(key, entry, as_json, extra, until, grace, bool(req.get("verbose")))
    # Nothing can be read for this kind until a reset that is past this wait's own deadline, so every second left
    # would be spent the way the first ones were: on nothing. Return now and name the wait that ends instead of
    # the one that just did not. Same exit code and the same "timeout" in --json as any other expired wait, so no
    # consumer has to learn a new one. Every kind, by the same comparison (blocked_before_deadline): a run only when
    # the build controller's feed does not cover its repository, because a covered run's finish still arrives over
    # the feed, costing no quota at all. Measured 2026-11-21: a `wait run` on an uncovered repository held its whole
    # timeout against a bucket whose reset was past the end of it, and its refusal named a reset in the past.
    deadline = wait_deadline(req)
    # Cached data this wait can use is no reason to sit out the hold either (glaeda#2311, 2026-11-21: a wait holding
    # one fresh read of "18 passed, 1 pending" spent its remaining 28 min on a bucket whose reset was 15 min past its
    # deadline). What settles it is whether the data in hand can still rule with no further read: every transition
    # time alone can make -- a head's settle window, a runner refusal's rescue grace, a done wait's straggler cut --
    # turns on `now`, so the same verdict asked at the deadline is the one this wait would reach there. Still None
    # there means only a read could decide it, and no read comes before the deadline.
    stuck = result is None and (
        not usable or verdict(kind, data, until, sha, (entry or {}).get("jobs"), deadline, grace,
                              f"{owner}/{repo}", settle) is None)
    blocked = blocked_before_deadline(kind, key, deadline, now) if stuck else None
    if blocked:
        extra = {"result": "timeout", "waited_s": waited, "ended_by": "blocked",
                 "note": f"{blocked['text']}, and its reset ({utc_clock(blocked['reset'])}) is past this wait's "
                         f"deadline ({utc_clock(deadline)}): waiting the rest of it reads "
                         "nothing"}
        extra.update(fail_fields("blocked", f"{key_name(key)} cannot be read before this wait's deadline: "
                                           f"{blocked['text']}", blocked_next(req, blocked)))
        return EXIT_TIMEOUT, render(key, entry, as_json, extra, until, grace, bool(req.get("verbose")))
    unread = (data or {}).get("checksPageError") or (
        "the head's Actions runs could not be read (actions/runs?head_sha)" if req.get("runsUnread") else None)
    if now >= deadline and kind == "pr" and until in ("done", "green") and data and unread:
        # the deadline passed on a read that never came back whole: not a pass and not a plain timeout
        extra = {"result": "inconclusive", "waited_s": waited, **wait_leash_fields(req, now),
                 "note": f"the last read of this PR was partial ({unread}): its checks are unknown"}
        extra.update(wait_outcome(req, EXIT_INCONCLUSIVE, entry, waited))
        return EXIT_INCONCLUSIVE, render(key, entry, as_json, extra, until, grace, bool(req.get("verbose")))
    if now >= deadline:
        extra = {"result": "timeout", "waited_s": waited, **wait_leash_fields(req, now)}
        if req.get("runsUnfinished"):
            extra["note"] = "Actions runs at the head not finished: " + ", ".join(req["runsUnfinished"])
        if sha and entry and entry.get("data"):
            head = entry["data"].get("headRefOid") or entry["data"].get("head_sha") or ""
            if not str(head).startswith(sha) and not (kind == "run" and run_tests_commit(entry["data"], f"{owner}/{repo}", sha)):
                extra["note"] = f"GitHub still shows head {str(head)[:10]}, not {sha[:10]}"
        extra.update(wait_outcome(req, EXIT_TIMEOUT, entry, waited))
        return EXIT_TIMEOUT, render(key, entry, as_json, extra, until, grace, bool(req.get("verbose")))
    return None


# A green rollup is not a done head while an Actions run at the head is unfinished: a run queued with no runner may
# have made no check run yet, so the rollup never shows it (land_judge's unfinished_runs reads the same list).
# claude-sr2-coord-old, 2026-11-18: `wait pr manaflow-ai/cmuxterm-hq#13397 --until done --sha a6534f4d` said success
# twice after 185-192 s (the first read after the wait began: HEAD_PENDING_FED_TTL) while 7 jobs sat queued on one
# runner label, counting only the 3 checks that had finished. Before a done or green wait says success on an open PR,
# it reads `actions/runs?head_sha=` once (kept HEAD_RUNS_REREAD per head): an unfinished run holds it, and a read that
# fails holds it too and ends it inconclusive at its deadline, never success.
HEAD_RUNS_REREAD = 60
HEAD_RUNS_PAGE = 100


def head_runs_path(key: str) -> Path:
    return BASE / STRAGGLER_DIR / f"{file_name(key)}.runs.json"


def head_runs_unfinished(key: str, data: dict, now: float,
                         get: Callable[[str, list[str]], dict] | None = None) -> list[str] | None:
    """The names of DATA's head's Actions runs not completed (queued, in progress, waiting, requested, pending), [] when
    every one completed, or None when they could not be read (no head or repository, a failed read, or more runs than
    one page holds: unread, never "none")."""
    head, repo = str(data.get("headRefOid") or ""), pr_repo(data)
    if not SHA40.fullmatch(head) or not repo:
        return None
    path = head_runs_path(key)
    kept = read_json(path)
    if isinstance(kept, dict) and kept.get("head") == head and now - num(kept.get("at")) < HEAD_RUNS_REREAD:
        # an answer, or a failed read, is kept as long: a read that keeps failing costs one GET a minute, not one a tick
        return [str(n) for n in kept["unfinished"]] if isinstance(kept.get("unfinished"), list) else None

    def keep(unfinished: list[str] | None) -> None:
        with contextlib.suppress(OSError, ValueError, TypeError):
            path.parent.mkdir(parents=True, exist_ok=True)
            write_json(path, {"head": head, "at": now, "unfinished": unfinished})
    query = f"actions/runs?head_sha={head}&per_page={HEAD_RUNS_PAGE}"
    try:
        doc = (get or head_runs_get)(repo, [query]).get(query)
    except Exception as error:  # noqa: BLE001  a failed read is unread, never "none"
        log({"event": "head-runs-failed", "key": key, "error": describe(error)})
        keep(None)
        return None
    runs = doc.get("workflow_runs") if isinstance(doc, dict) else None
    if not isinstance(runs, list):
        keep(None)
        return None
    unfinished = [str(r.get("name") or r.get("id")) for r in runs
                  if isinstance(r, dict) and str(r.get("status") or "").lower() != "completed"]
    if int(doc.get("total_count") or 0) > len(runs) and not unfinished:
        keep(None)  # more runs than one page: an unfinished one may be past it
        return None
    keep(unfinished)
    return unfinished


def inconclusive_note(data: dict, now: float) -> str:
    """What an inconclusive done wait says: how many checks are still queued with no runner, and any red already in."""
    cut = straggler_cut(data, now)
    queued = len((cut or {}).get("stragglers") or [])
    failed = len(classify(data, now)["failed"])
    red = f"; {failed} finished check(s) failed" if failed else ""
    return (f"not done: {queued} queued with no runner past {int(STRAGGLER_AFTER // 60)} min, nothing requires them, "
            f"and they still run if a runner comes{red} (not a pass)")


def cmd_wait(kind: str, target: str, until: str, timeout: float, jobs: bool, as_json: bool,
             sha: str | None = None, grace: float = RESCUE_GRACE, settle: float = SETTLE_GRACE,
             ceiling: float | None = None) -> int:
    """The polling wait: this process re-reads the cache until wait_step decides. `wait pr|run` uses it
    only when the daemon cannot rule on the wait itself (subscribe_wait). Says the waiting line once,
    before it blocks; poll_wait does not, so a wait handed back to it (resume_wait) is not said twice."""
    key = parse_key(kind, target)  # a bad target is the first thing said
    exact = True
    if sha:
        sha, exact = resolve_sha(sha)
    # One call: say_waiting drops a line while an earlier write is stuck, and the blocker is the line that
    # matters most. Said now, not at the deadline -- learning it at the deadline is the whole measured loss.
    blocked_note = blocked_start_line(key, kind)
    say_waiting(waiting_line(key, until, sha, exact, timeout, ceiling) + (f"\n{blocked_note}" if blocked_note else ""))
    return poll_wait(wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, settle, ceiling))


# A wait whose target was never read once learns why at WAIT_DIAGNOSE_AFTER instead of STALE_DATA_AFTER (600 s, and
# in practice the wait's whole timeout: Daemon.serve_wait hands a wait back only when nothing already explains the
# silence, so a quota stop deferred the probe to the deadline). Three 1800 s waits in the 2026-11-21 window learned
# the cause in their last second. Once per wait, and only when read_blocked() sees no stop on disk: during a real
# quota stop the answer is free from the files, so this spends no call to be told what is already known -- which is
# what keeps the hard reserve (the calls kept back for lands) out of it however many waits block at once.
WAIT_DIAGNOSE_AFTER = 120


def direct_gap(req: dict, bound: float) -> float:
    """How long after its last direct read (directAt) a wait may read its target directly again: BOUND, doubled for
    each read in a row that found nothing new (directQuiet), at most DIRECT_QUIET_MAX (never under BOUND)."""
    quiet = req.get("directQuiet")
    quiet = quiet if isinstance(quiet, int) and not isinstance(quiet, bool) and quiet > 0 else 0
    return max(bound, min(DIRECT_QUIET_MAX, bound * 2 ** min(quiet, 16)))


def note_direct_quiet(req: dict, before: str | None, after: str | None, error: str | None) -> None:
    """After a wait's direct read: one more in a row that found nothing new (the same wait_progress_print as before
    it), or back to none when it found a change. A failed read changes nothing."""
    if error:
        return
    if before is not None and after == before:
        req["directQuiet"] = int(req.get("directQuiet") or 0) + 1
    else:
        req.pop("directQuiet", None)


def wait_starved(req: dict, entry: dict | None, now: float) -> float | None:
    """How old the data a wait is blocked on is, when it is starved: the wait has run STALE_DATA_AFTER and nothing was
    read for its target in that long (since the wait began, for a target never read), and no direct read was tried
    in that long. None otherwise. Only for an undecided wait: wait_step rules first."""
    began = float(req["began"])
    # An upstream host that reads one target itself through the broker: UPSTREAM_DIRECT_AFTER (the broker host keeps
    # waited keys fresher than that), else STALE_DATA_AFTER.
    bound = UPSTREAM_DIRECT_AFTER if upstream_command() is not None and direct_command() is not None \
        else STALE_DATA_AFTER
    seen_at = (entry or {}).get("dataAt")
    never_read = not isinstance(seen_at, (int, float)) or isinstance(seen_at, bool)
    if never_read and not req.get("diagnosed") and bound > WAIT_DIAGNOSE_AFTER \
            and blocked_now(req.get("kind"), now) is None:
        bound = WAIT_DIAGNOSE_AFTER
    if now - began < bound:
        return None
    if now - float(req.get("directAt") or float("-inf")) < direct_gap(req, bound):
        return None
    seen = (entry or {}).get("dataAt")
    view = (entry or {}).get("upstreamFeed")
    if not never_read and isinstance(view, dict) and upstream_feed_quiet(view, "", float(seen), now):
        # The upstream's feed saw nothing for this PR since its copy and answered after it (feed_view): the copy is
        # current, however old. Before, every wait on a lane VM re-read its PR directly every UPSTREAM_DIRECT_AFTER
        # (huge-blue, 2026-11-22 01:45-02:45Z: 9,125 of 11,257 glaeda-upstream GETs a path that VM had read before).
        return None
    age_s = now - (seen if isinstance(seen, (int, float)) and not isinstance(seen, bool) else began)
    return age_s if age_s > bound else None


def _direct_read(req: dict) -> str | None:
    """_read_one, with this host's read token first when it has one, then the broker's GET if that read failed: a
    land's read keeps two routes (hq docs/handbook/read-with-one-quota-route.md)."""
    used: list[bool] = []
    why = _read_one(req, used)
    if why is not None and any(used):
        return _read_one(req, None)
    return why


def _read_one(req: dict, used: list[bool] | None) -> str | None:
    """One read of the wait's target from GitHub by this process, outside the daemon's queue, stored in the cache the
    way the daemon stores it (so wait_step rules on it): a PR over GraphQL, a run over REST. The fallback for a wait
    whose daemon heartbeats but has not refreshed this target (wait_starved). None, or why it could not read."""
    key, kind = req["key"], req["kind"]
    if kind not in ("pr", "run"):
        return f"no direct read for a {kind}"
    # An upstream host (no login) reads its one target through direct_command, over REST: the broker's GET.
    broker = direct_command() if upstream_command() is not None else None
    bucket = "graphql" if kind == "pr" and broker is None else "rest"
    try:
        if upstream_command() is not None and broker is None:
            return DIRECT_UPSTREAM
        if broker is not None:
            reader = read_token_reader(key) if used is not None else None
            if used is not None:
                used.append(reader is not None)  # the read token was tried: a failure goes again through the broker
            daemon = reader or Daemon(
                transport=broker_transport(broker, lambda: daemon.tick_deadline), token=lambda: "",
                controller=None, upstream=None)
            daemon.reads_protection = False
            daemon.etags = isinstance(daemon.app_pool, ReadTokenPool)
        else:
            daemon = Daemon(controller=None, upstream=None)
    except Exception as failure:  # noqa: BLE001  a fallback read never stops the wait
        return f"{describe(failure)} at {error_site(failure)}"
    # The daemon's own view as well as budget.json's: a secondary hold or a backoff lives only in its memory, and
    # daemon.json's modes carry it (a fresh Daemon here starts with no backoff).
    modes = (read_json(BASE / "daemon.json") or {}).get("modes")
    if daemon.mode(bucket) == "stop" or (isinstance(modes, dict) and modes.get(bucket) == "stop"):
        return DIRECT_QUOTA
    # A wait's own read is a session's request, not the daemon's polling: it is not charged to the daemon's REST share,
    # and above all this process must never write rest-spend.json from the copy it read at construction, which would
    # overwrite the minutes the daemon counted since (review of glaeda#1942).
    daemon.charge_rest = lambda minute, n: None  # type: ignore[method-assign]
    daemon.now = time.time()
    budget = float(req.get("budget") or DIRECT_READ_BUDGET)
    daemon.tick_deadline = time.monotonic() + budget
    entry = {"key": key, "jobs": bool(req.get("jobs")), "cache": read_cache(key), "touched": daemon.now,
             "waitedAt": daemon.now, "waitBegan": float(req["began"]), "readers": [], "reader": "", "consumers": {}}
    if broker is not None:
        daemon.repo_parts.update(direct_parts_load(daemon.now))
    try:
        with daemon.calling(*caller_of(key), "tool:glaeda-gh wait (direct read)"):
            if kind == "pr" and broker is not None:
                daemon.fetch_pr_rest(entry)
                error = None
            elif kind == "pr":
                daemon.gql_reason = "pr-direct"
                error = daemon.fetch_prs([entry])
            else:
                daemon.fetch_run(entry)
                error = None
    except OutOfTime:
        return f"no answer within {budget:g}s"
    except Exception as failure:  # noqa: BLE001  a fallback read never stops the wait
        return f"{describe(failure)} at {error_site(failure)}"
    finally:
        if broker is not None:
            direct_parts_save(daemon.repo_parts, daemon.now)
    if error:
        return error
    cached = read_cache(key) or {}
    return None if (cached.get("dataAt") or 0) >= daemon.now else (cached.get("error") or "no data stored")


def _land_direct_cache_fresh(key: str, now: float) -> bool:
    """Whether a recent successful land refresh already answered KEY."""
    cached = read_cache(key) or {}
    at = cached.get("dataAt")
    return isinstance(at, (int, float)) and not isinstance(at, bool) and 0 <= now - at < LAND_DIRECT_REUSE \
        and isinstance(cached.get("data"), dict) and not cached.get("error")


def direct_read(req: dict) -> str | None:
    """Read a wait target, coalescing same-key land refreshes across worker processes."""
    if not req.get("land"):
        return _direct_read(req)
    key = req["key"]
    lock_path = BASE / f".land-direct-{file_name(key)}.lock"
    with bounded_lock(lock_path, LAND_DIRECT_LOCK_WAIT) as held:
        if not held:
            return "land refresh lock unavailable"
        now = time.time()
        if _land_direct_cache_fresh(key, now):
            return None
        return _direct_read(req)


# A lane VM's direct reads (direct_read through the broker: a starved wait, the land worker's refresh) are one process
# each, so the Daemon's repo_parts, which shares a repository's or base's answer between watches for
# REST_REPO_PART_TTL, began empty every time, and every read asked for the base's rulesets and the repository's
# workflow list again. And the broker answers no ETag, so rest_pull's issues/N probe could never vouch for anything.
# gcp-codex-lane-12, 2026-11-17 07:00-07:55Z (lane-gh calls): 166 direct reads made 1,571 of the VM's 1,857 broker
# GETs, every one an App or login request: rules/branches 166, actions/workflows 166, issues/N 228 among them. The
# rulesets and workflow list are kept here for REST_REPO_PART_TTL, shared by every direct read on the host (the same
# window the daemon gives them), and the probe is not sent (Daemon.etags): 7 GETs a read become 4, 9 become 6.
DIRECT_PARTS = "direct-parts.json"  # under BASE (read when used: tests move BASE)
DIRECT_PARTS_RE = re.compile(r"^/repos/[^/]+/[^/]+/(?:rules/branches/[^?]+|actions/workflows)\?")
DIRECT_PARTS_MAX = 200


def direct_parts_load(now: float) -> dict[str, dict]:
    """The repository-level answers an earlier direct read on this host kept, still within REST_REPO_PART_TTL."""
    doc = read_json(BASE / DIRECT_PARTS)
    parts = doc.get("parts") if isinstance(doc, dict) else None
    if not isinstance(parts, dict):
        return {}
    return {path: v for path, v in parts.items()
            if DIRECT_PARTS_RE.match(path) and isinstance(v, dict) and isinstance(v.get("part"), dict)
            and isinstance(v.get("at"), (int, float)) and not isinstance(v.get("at"), bool)
            and 0 <= now - v["at"] < REST_REPO_PART_TTL}


def direct_parts_save(repo_parts: dict[str, dict], now: float) -> None:
    """Keep REPO_PARTS' repository-level answers for the next direct read (best effort: a lost write costs a read)."""
    try:
        kept = direct_parts_load(now)
        for path, v in repo_parts.items():
            if DIRECT_PARTS_RE.match(path) and isinstance(v, dict) and isinstance(v.get("at"), (int, float)) \
                    and "doc" in (v.get("part") or {}) and v["at"] >= (kept.get(path) or {}).get("at", float("-inf")):
                kept[path] = v
        newest = sorted(kept, key=lambda p: kept[p]["at"], reverse=True)[:DIRECT_PARTS_MAX]
        write_json(BASE / DIRECT_PARTS, {"parts": {p: kept[p] for p in newest}})
    except (OSError, ValueError, TypeError):
        pass


def poll_wait(req: dict) -> int:
    """Re-read the cache until wait_step decides REQ, saying what a down, failing or stale daemon means.
    A wait the daemon stopped ruling on (resume_wait) carries on here, from when it began."""
    timeout, jobs = req["timeout"], req["jobs"]
    start = time.monotonic() - max(0.0, time.time() - req["began"])
    touched = -TOUCH_EVERY
    said = time.monotonic()
    seen: dict = {}  # what the last progress line carried (progress_update): an unchanged state is not said twice
    warned = False
    down, down_since = DownWait(), None
    while True:
        if not daemon_running(grace=DOWN_GRACE):
            down_since = time.monotonic() if down_since is None else down_since
            if not down.patient(down_since, start, timeout):
                if req.get("json"):
                    print_json_error("daemon-down", "the daemon is not running, so nothing is polling GitHub",
                                     down_message().rpartition("\nnext: ")[2])
                return EXIT_DOWN
            time.sleep(WAIT_POLL)
            continue
        down_since = None
        broken = daemon_failing()
        if broken is not None:
            say_daemon_problem("daemon-failing", failing_message(broken), bool(req.get("json")))
            return EXIT_DOWN
        lag = daemon_stale()
        if lag is not None and not warned:
            say_waiting(stale_message(lag))
            warned = True
        now = time.monotonic()
        if now - touched >= TOUCH_EVERY:
            register(req["key"], jobs, waited=True, began=req["began"])  # (the same start every touch)
            touched = now
        done = wait_step(req, time.time())
        if done is None or done[0] in (EXIT_TIMEOUT, EXIT_INCONCLUSIVE):  # (a partial read at the deadline too)
            starved = wait_starved(req, read_cache(req["key"]), time.time())
            if starved is not None:
                # The daemon heartbeats but has not refreshed this target: say so, loudly, and read it once here
                # instead of waiting out the timeout on data that old.
                req["directAt"] = time.time()
                req["diagnosed"] = True
                blocked = blocked_now(req["kind"])
                if blocked is not None and blocked.get("exhausted") and blocked["routed"] == blocked["bucket"]:
                    # The files already say why, and a direct read over that bucket is refused before it is sent:
                    # say the bucket and the reset rather than spend a call to be told the same thing. Only when the
                    # spent bucket is the one this read would go over: a kind the daemon's own spent REST share holds
                    # waits on GraphQL, and yet one direct read over REST's untouched headroom can still answer.
                    say_waiting(f"glaeda-gh: WARNING: the daemon has not refreshed {key_name(req['key'])} for "
                                f"{int(starved)}s (its heartbeat is fresh, its data is not), because "
                                f"{blocked['text']}.")
                else:
                    say_waiting(f"glaeda-gh: WARNING: the daemon has not refreshed {key_name(req['key'])} for "
                                f"{int(starved)}s (its heartbeat is fresh, its data is not); reading GitHub "
                                "directly once.")
                    before = wait_progress_print(req["kind"], read_cache(req["key"]))
                    error = direct_read(req)
                    note_direct_quiet(req, before, wait_progress_print(req["kind"], read_cache(req["key"])), error)
                    say_waiting("glaeda-gh: direct read " + (f"failed: {error}" if error else "answered") + "."
                                + ("" if error in (DIRECT_QUOTA, DIRECT_UPSTREAM) or upstream_command() is not None
                                   else "\nnext: glaeda-gh restart"))
                done = wait_step(req, time.time())
        if done is not None:
            sys.stdout.write(done[1])
            return done[0]
        if time.monotonic() - said >= WAIT_PROGRESS_EVERY:
            said = time.monotonic()
            with contextlib.suppress(Exception):  # a progress line never stops the wait
                state = progress_update(seen, req, read_cache(req["key"]), time.time())
                if state is not None:
                    say_waiting(progress_line(req, state))
        time.sleep(min(WAIT_POLL, max(0.1, wait_deadline(req) - time.time())))


WAITS_CONTRACT = 1  # daemon.json "waits": this daemon rules on `wait pr|run` requests (Daemon.serve_waits)
WAITS_CHECK = 60  # a blocker hands its wait back to Python when no tick has ruled on waits for this long
WAITS_LEFTOVER = 600  # a request this far past its deadline has no blocker left (a reused pid): dropped
WAITS_MAX_TIMEOUT = 1e8  # longer (or inf) waits poll, as before: bash keeps time in whole seconds
BASH = "/bin/bash"
# The whole waiter once the request is written: bash blocked reading the FIFO until the daemon writes
# the exit code (Daemon.serve_waits), then what the wait prints. `3<>` opens without waiting for a
# writer. Every WAITS_CHECK it looks at waits/.served, which each tick touches; at the wait's deadline,
# once no tick has served waits since its last look (the daemon is down, failing, hung, or an older
# one), or once its FIFO is gone (the daemon dropped the request), it execs "$@": `glaeda-gh
# wait-resume ID` (resume_wait). That argument list is a contract with every live blocker: keep it.
# Every GLAEDA_WAIT_PROGRESS seconds (env, set by block) it says how the wait stands on fd 2, from the
# one line the daemon keeps in $out.state (serve_wait), in progress_line's words. The printf runs in the
# background with SIGPIPE ignored and fd 1 and 3 not held, and only one at a time: like say_waiting, a closed
# or full stderr never stops or delays the wait. One still blocked on a full stderr when the wait ends is
# killed, so repeated waits leave no writers behind: only while that PID is still this shell's child, so a
# writer that already exited and whose PID was reused is never signalled. SIGKILL, because a caller can
# hand down SIGTERM ignored, and then the reap would wait on the blocked writer forever.
BLOCKER = r"""fifo=$1 out=$2 limit=$3 served=$4 check=$5
shift 5
trap '' PIPE
every=${GLAEDA_WAIT_PROGRESS:-0} said=$SECONDS sayer= last=
case "$every" in ''|*[!0-9]*) every=0 ;; esac
mark=$out.mark
exec 3<>"$fifo" || exec "$@"
: > "$mark"
end=$((SECONDS + limit))
rc=
while :; do
  left=$((end - SECONDS))
  [ "$left" -gt 0 ] || break
  [ "$left" -gt "$check" ] && left=$check
  IFS= read -r -t "$left" rc <&3 && break
  rc=
  [ -p "$fifo" ] && [ "$served" -nt "$mark" ] || break
  : > "$mark"
  if [ "$every" -gt 0 ] && [ $((SECONDS - said)) -ge "$every" ]; then
    said=$SECONDS state=
    [ -f "$out.state" ] && IFS= read -r state < "$out.state"
    if [ -n "$state" ] && [ "$state" = "$last" ]; then
      : # the state it printed last time, to the character: say nothing until something changes
    elif [ -z "$sayer" ] || ! kill -0 "$sayer" 2>/dev/null; then
      [ -n "$state" ] && last=$state  # an empty read is a read that did not happen, not a new state: keeping the
      # last state it printed is what stops the same paragraph coming back after one poll found the file missing
      # or half-written (docs/handbook/missing-read-counted-as-a-value.md)
      printf '%s\n' "glaeda-gh: still waiting on $GLAEDA_WAIT_KEY: $((${GLAEDA_WAIT_ELAPSED:-0} + SECONDS))s, ends after ${GLAEDA_WAIT_TIMEOUT}s with no change, deadline $GLAEDA_WAIT_DEADLINE${state:+; $state}" 1>&2 2>/dev/null 3<&- &
      sayer=$!
    fi
  fi
done
if [ -n "$sayer" ] && [ "$(ps -o ppid= -p "$sayer" 2>/dev/null | tr -d ' ')" = "$$" ]; then
  kill -KILL "$sayer" 2>/dev/null && wait "$sayer" 2>/dev/null
fi
exec 3<&-
rm -f "$mark" "$out.state"
case "$rc" in ''|*[!0-9]*) exec "$@" ;; esac
[ -f "$out.err" ] && cat "$out.err" >&2
[ -f "$out" ] && cat "$out"
rm -f "$fifo" "$out" "$out.err" "$out.rc"
exit "$rc"
"""
WAIT_FILES = (".json", ".fifo", ".out", ".out.err", ".out.rc", ".out.mark", ".out.state")


# How fresh waits/.served may be and still not be touched again. A blocker asks `.served -nt .out.mark` once every
# WAITS_CHECK (60 s), its mark made at its previous look; touched at most every SERVED_QUIET plus a tick, a live
# daemon's .served is always newer than a mark 60 s old. Touching it every TICK (2 s) was ~30 fseventsd events a
# minute on cosmic-gray for no blocker's benefit (2026-11-05).
SERVED_QUIET = 10.0


def mark_waits_served() -> None:
    """Tell the blockers a daemon that rules on waits is ticking (BLOCKER reads waits/.served), at most once every
    SERVED_QUIET."""
    with contextlib.suppress(OSError):
        if waits_dir().is_dir():
            served = waits_dir() / ".served"
            with contextlib.suppress(OSError):
                if 0 <= time.time() - served.stat().st_mtime < SERVED_QUIET:
                    return
            served.touch()


def waits_dir() -> Path:
    return BASE / "waits"  # `wait pr|run` requests the daemon rules on: <id>.json, .fifo, .out, .out.rc, ...


def write_wait_request(kind: str, target: str, until: str, timeout: float, jobs: bool, as_json: bool,
                       sha: str | None, exact: bool, grace: float, pid: int, began: float | None = None,
                       settle: float = SETTLE_GRACE, ceiling: float | None = None,
                       moved: dict | None = None) -> str:
    """Leave a wait for the daemon: its FIFO first, then the request, so the daemon never sees a request
    without one. Interest is registered at once, as a polling wait does. Returns the request's id. A handoff
    (BEGAN) passes the TIMEOUT left of it, its CEILING from BEGAN, and what it has seen move (MOVED)."""
    req = wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, settle, ceiling)
    if began is not None:  # a handoff keeps the wait's start (data read since then still counts), same deadline
        req["timeout"] += max(0.0, req["began"] - began)
        req["began"] = began
        req["max"] = max(req["timeout"], default_wait_max(req["timeout"]) if ceiling is None else ceiling)
    if isinstance(moved, dict):
        req["moved"] = moved
    rid = f"{pid}-{os.urandom(4).hex()}"
    waits_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    os.mkfifo(waits_dir() / f"{rid}.fifo", 0o600)
    register(req["key"], jobs, waited=True, began=req["began"])
    write_json(waits_dir() / f"{rid}.json", {**req, "pid": pid, "touched": req["began"], "reader": reader_name()})
    return rid


def serving_waits() -> bool:
    """Whether the daemon runs, rules on waits (WAITS_CONTRACT), and is neither failing nor hung."""
    status = read_json(BASE / "daemon.json") or {}
    return (isinstance(status.get("waits"), int) and status["waits"] >= WAITS_CONTRACT and lock_held()
            and daemon_failing() is None and daemon_stale() is None)


def controller_wait_run(key: str, timeout: float) -> dict | None:
    """Use one bounded controller long-poll and publish it through the cache write lock."""
    controller = Controller.from_env()
    if controller is None:
        return None
    _, owner, repo, run_id = split_key(key)
    wait = max(0, min(CLIENT_RUN_LONG_POLL, CONTROLLER_RUN_MAX_WAIT, int(timeout)))
    try:
        baseline = controller.run(run_id, wait=0)
        if not isinstance(baseline, dict) or str(baseline.get("id")) != str(run_id):
            return None
        expected_repo = f"{owner}/{repo}"
        if str(baseline.get("repo") or "").lower() != expected_repo:
            return None
        expected_attempt = baseline.get("attempt")
        run = controller.run(run_id, wait=wait)
    except (NoReceiver, WatchError, OSError):
        return None
    if (not isinstance(run, dict) or str(run.get("id")) != str(run_id)
            or str(run.get("repo") or "").lower() != expected_repo
            or run.get("attempt") != expected_attempt):
        return None
    candidate = controller_run(run)
    cache_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    cache = cache_dir() / file_name(key)
    with bounded_lock(cache_dir() / ".write.lock") as held:
        if not held:
            return None
        prior = read_json(cache) or {}
        prior_data = prior.get("data") or {}
        try:
            if (prior_data.get("run_attempt") is not None
                    and int(candidate.get("run_attempt") or 0) < int(prior_data["run_attempt"])):
                return None
        except (TypeError, ValueError):
            return None
        prior_updated = iso_epoch(prior_data.get("updated_at"))
        candidate_updated = iso_epoch(candidate.get("updated_at"))
        if prior_updated is not None and candidate_updated is not None and candidate_updated < prior_updated:
            return None
        now = time.time()
        rest_at = (prior.get("restAt") if prior.get("source") == "controller"
                   and isinstance(prior.get("restAt"), (int, float)) else now)
        # An unchanged queued or in-progress record keeps its time, as apply_run's does: a long-poll that ends
        # on the same stale record must not make it look fresh and push back the daemon's STALE_RUN_REREAD.
        data_at = now
        if (not terminal("run", candidate) and isinstance(prior.get("dataAt"), (int, float))
                and all(prior_data.get(k) == candidate.get(k) for k in ("status", "conclusion", "run_attempt", "updated_at"))):
            data_at = prior["dataAt"]
            if isinstance(prior.get("restAt"), (int, float)):
                rest_at = prior["restAt"]
        entry = {"key": key, "fetchedAt": now, "dataAt": data_at, "restAt": rest_at,
                 "data": candidate, "error": None, "source": "controller"}
        for field in ("etag", "jobs", "jobsEtag", "jobsAt", "jobsTried", "jobsDone", "restParts", "restRun", "restRunAt", "rerunAt"):
            if field in prior:
                entry[field] = prior[field]
        write_json(cache, entry)
    return entry


def wait_refusal(req: dict, code: str, reason: str, nxt: str) -> tuple[tuple[int, str], str]:
    """A daemon-ruled wait that cannot be ruled on: ((64, its --json object or nothing), its stderr lines)."""
    out = json.dumps({"ok": False, "code": code, "reason": reason, "next": nxt}) + "\n" if req.get("json") else ""
    return (64, out), f"glaeda-gh: {reason}\nnext: {nxt}\n"


def subscribe_wait(kind: str, target: str, until: str, timeout: float, jobs: bool, as_json: bool,
                   sha: str | None = None, grace: float = RESCUE_GRACE, settle: float = SETTLE_GRACE,
                   ceiling: float | None = None) -> int:
    """`wait pr|run` as a request the daemon rules on: this process writes it and becomes BLOCKER, a bash
    asleep on a FIFO, instead of a Python interpreter re-reading the cache every WAIT_POLL (89 of those
    held 1.6 GB on cosmic-gray, 2026-10-21). Same arguments, output and exit codes as cmd_wait, which it
    falls back to when the daemon is not serving waits (down, failing, hung or older than WAITS_CONTRACT),
    there is no bash, or the timeout is not a finite number of seconds bash can count. (The CLI's
    `seconds` already refuses inf, nan and negative timeouts; the range check here is for direct callers
    and for finite timeouts past WAITS_MAX_TIMEOUT.)

    The waiting line is said exactly once: by cmd_wait on the first fallback, here before BLOCKER
    otherwise -- say_waiting writes fd 2 directly, so nothing is left buffered across the exec -- and
    not again on the late fallback, which goes straight to poll_wait."""
    if not (0 <= max(timeout, default_wait_max(timeout) if ceiling is None else ceiling) <= WAITS_MAX_TIMEOUT) \
            or not os.access(BASH, os.X_OK) or not serving_waits():
        return cmd_wait(kind, target, until, timeout, jobs, as_json, sha, grace, settle, ceiling)
    key = parse_key(kind, target)
    exact = True
    if sha:
        sha, exact = resolve_sha(sha)
    # One call: say_waiting drops a line while an earlier write is stuck, and the blocker is the line that
    # matters most. Said now, not at the deadline -- learning it at the deadline is the whole measured loss.
    blocked_note = blocked_start_line(key, kind)
    say_waiting(waiting_line(key, until, sha, exact, timeout, ceiling) + (f"\n{blocked_note}" if blocked_note else ""))
    req = wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, settle, ceiling)
    if kind == "run" and not jobs:
        # the daemon keeps reading while this blocks (a lost finish is re-read past STALE_RUN_REREAD)
        register(key, jobs, waited=True, began=req["began"])
        started = time.monotonic()
        controller_wait_run(key, timeout)
        done = wait_step(req, time.time())
        if done is not None:
            sys.stdout.write(done[1])
            return done[0]
        # The one-shot request may have returned an in-progress run or a transport fallback. The
        # remaining deadline is recomputed after the blocking call before the FIFO wait begins.
        timeout = max(0.0, timeout - (time.monotonic() - started))
    try:
        rid = write_wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, os.getpid(),
                                 began=req["began"], settle=settle, ceiling=req["max"], moved=req.get("moved"))
    except OSError:
        late = dict(req)  # the same start, limits and what it has seen move
        return poll_wait(late)
    block(rid, wait_deadline(req) - time.time(), req)
    return EXIT_DOWN  # not reached


def block(rid: str, left: float, req: dict | None = None) -> None:
    """Become BLOCKER for request RID, with LEFT seconds to its deadline. The same pid carries on: the
    daemon tells a gone waiter by it. REQ (the wait_request) gives the words of its progress lines."""
    d = waits_dir()
    sys.stdout.flush()
    sys.stderr.flush()
    # BLOCKER reads these from its environment: os.environ, which execv hands on (the process is replaced)
    os.environ.pop("GLAEDA_WAIT_PROGRESS", None)
    if req is not None:
        began, timeout = float(req["began"]), float(req["timeout"])
        # LEFT runs to the no-change deadline as it stands now (wait_deadline); a change the daemon sees moves it,
        # and at LEFT the blocker hands back to resume_wait, which blocks again to the moved deadline
        os.environ.update({"GLAEDA_WAIT_KEY": str(req["key"]), "GLAEDA_WAIT_TIMEOUT": f"{timeout:g}",
                    "GLAEDA_WAIT_DEADLINE": f"{utc_clock(wait_deadline(req))} unless it changes (ceiling "
                                            f"{utc_clock(began + wait_max(req))})",
                    "GLAEDA_WAIT_ELAPSED": str(int(max(0.0, time.time() - began))),
                    "GLAEDA_WAIT_PROGRESS": str(WAIT_PROGRESS_EVERY)})
    os.execv(BASH, [BASH, "-c", BLOCKER, "glaeda-gh-wait", os.fspath(d / f"{rid}.fifo"), os.fspath(d / f"{rid}.out"),
                    str(max(1, int(left + 0.999))), os.fspath(d / ".served"), str(WAITS_CHECK),
                    sys.executable, os.path.abspath(__file__), "wait-resume", rid])


def resume_wait(rid: str) -> int:
    """Where BLOCKER hands a wait back: at its deadline, or once no tick has ruled on waits for WAITS_CHECK.
    The daemon's answer if it left one; else back to sleep while the daemon serves waits and time is left;
    else on as the polling wait (poll_wait), which says what a down, failing or stale daemon means and
    rules on the timeout itself."""
    d = waits_dir()
    with contextlib.suppress(OSError, ValueError):
        code = int((d / f"{rid}.out.rc").read_text())
        with contextlib.suppress(OSError):
            sys.stderr.write((d / f"{rid}.out.err").read_text())
        with contextlib.suppress(OSError):
            sys.stdout.write((d / f"{rid}.out").read_text())
        drop_wait(rid)
        return code
    req = read_json(d / f"{rid}.json")
    if not isinstance(req, dict) or not all(k in req for k in ("key", "kind", "began", "timeout", "until", "grace")):
        drop_wait(rid)
        say_waiting("glaeda-gh: this wait's request is gone; run the wait again")
        say_waiting("next: glaeda-gh wait --help")
        return EXIT_DOWN
    left = wait_deadline(req) - time.time()  # moved by every change the daemon saw (wait_progress_mark)
    if left > 0 and serving_waits() and req.get("stale") is None:  # (a stale one was handed back on purpose)
        register(req["key"], bool(req.get("jobs")), waited=True, began=float(req["began"]))
        block(rid, left, req)
    drop_wait(rid)
    try:
        return poll_wait(req)
    except WatchError as error:
        if req.get("json"):  # main's wait-resume handler says it on fd 2; the saved request knows --json
            print_json_error("refused", str(error), "glaeda-gh wait --help")
        raise


def waiter_alive(pid: Any) -> bool:
    """Whether a wait's blocker still runs: one signal-0 per request, no `ps` (a tick may hold many)."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def wake_waiter(fifo: Path, code: int) -> bool:
    """Write the exit code to a blocker's FIFO. False while no blocker has it open (not started yet, or
    handing the wait back to Python), or if it went away mid-write."""
    try:
        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        os.write(fd, f"{code}\n".encode())
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def drop_wait(rid: str) -> None:
    for suffix in WAIT_FILES:
        with contextlib.suppress(OSError):
            (waits_dir() / f"{rid}{suffix}").unlink()


def file_ready(pattern: str, mode: str, contains: re.Pattern | None) -> str | None:
    """The first path matching the glob `pattern` that satisfies `mode` (nonempty, exists, gone), else None."""
    path = os.path.expanduser(pattern)
    matches = glob.glob(path) if glob.has_magic(path) else ([path] if os.path.lexists(path) else [])
    if mode == "gone":
        return pattern if not matches else None
    for found in sorted(matches):
        if mode == "exists" and contains is None:
            return found  # even a dangling symlink exists
        try:
            size = os.stat(found).st_size
            if mode == "nonempty" and size == 0 and not os.path.isdir(found):
                continue
            if contains is not None and not contains.search(Path(found).read_text(errors="replace")):
                continue
        except OSError:
            continue
        return found
    return None


class Leash:
    """The no-change deadline of a wait that runs in this process (file, pid, comment, land --wait): TIMEOUT past the
    last change it saw (see), never past CEILING from its start (wait_deadline's rule, on the monotonic clock)."""

    def __init__(self, timeout: float, ceiling: float | None = None) -> None:
        self.timeout = float(timeout)
        self.ceiling = max(self.timeout, default_wait_max(self.timeout) if ceiling is None else float(ceiling))
        self.start = self.moved = time.monotonic()
        self.mark: Any = None
        self.changes = 0

    def see(self, mark: Any) -> bool:
        """Note what the wait sees; True when it changed (the first look is where it starts, not a change)."""
        if mark is None:
            return False
        if self.mark is None:
            self.mark = mark
            return False
        if mark == self.mark:
            return False
        self.mark, self.moved, self.changes = mark, time.monotonic(), self.changes + 1
        return True

    def deadline(self) -> float:
        return min(self.start + self.ceiling, self.moved + self.timeout)

    def left(self) -> float:
        return self.deadline() - time.monotonic()

    def ended_by(self) -> str:
        return "ceiling" if self.moved + self.timeout > self.start + self.ceiling else "no-progress"

    def fields(self) -> dict:
        out: dict[str, Any] = {"ended_by": self.ended_by(), "no_progress_s": self.timeout, "max_s": self.ceiling,
                               "progress_changes": self.changes}
        if self.changes:
            out["last_progress_at"] = utc_clock(time.time() - (time.monotonic() - self.moved))
        return out

    def words(self) -> str:
        """Why it ended, for the text form."""
        if self.ended_by() == "ceiling":
            return f"its ceiling of {self.ceiling:g}s, still changing ({self.changes} change(s))"
        return (f"no change for {self.timeout:g}s" + (f" ({self.changes} change(s) before that)"
                                                       if self.changes else ""))


def file_progress(pattern: str) -> Any:
    """What of a file wait's glob counts as it moving: each match's size and mtime (a log being written)."""
    path = os.path.expanduser(pattern)
    out = []
    for found in sorted(glob.glob(path) if glob.has_magic(path) else [path]):
        with contextlib.suppress(OSError):
            info = os.stat(found)
            out.append((found, info.st_size, info.st_mtime_ns))
    return out


def pid_cpu(pid: int) -> Any:
    """A process's CPU time so far (utime+stime ticks from /proc; `ps -o time=` without it, which cmd_wait_pid asks
    at most every ZOMBIE_CHECK_S): a process that is computing is progressing. None when it cannot be read."""
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rpartition(")")[2].split()
        return int(fields[11]) + int(fields[12])
    except (OSError, IndexError, ValueError):
        pass
    try:
        return subprocess.run(["ps", "-o", "time=", "-p", str(pid)], capture_output=True, text=True,
                              timeout=5).stdout.strip() or None
    except (OSError, subprocess.SubprocessError):
        return None


def cmd_wait_file(target: str, timeout: float, as_json: bool, mode: str = "nonempty",
                  contains: str | None = None, ceiling: float | None = None) -> int:
    """Block until a file exists and is not empty (`[ -s FILE ]`), exists (--exists), or is gone (--gone),
    optionally with a line matching --contains. PATH may be a glob. Local stat calls only; no GitHub."""
    try:
        pattern = re.compile(contains, re.M) if contains else None
    except re.error as error:
        raise WatchError(f"--contains {contains!r} is not a regular expression: {error}")
    if contains and mode == "gone":
        raise WatchError("--contains does not apply to --gone")
    say_waiting(waiting_line(target, mode + (f" and matching {contains}" if contains else ""),
                             None, True, timeout, ceiling))
    leash = Leash(timeout, ceiling)
    start = leash.start
    while True:
        found = file_ready(target, mode, pattern)
        waited = int(time.monotonic() - start)
        if found is not None:
            print(json.dumps({"result": "success", "path": found, "waited_s": waited, "ended_by": "success"})
                  if as_json else f"glaeda-gh: {found} {'is gone' if mode == 'gone' else 'is ready'} after {waited}s")
            return EXIT_OK
        leash.see(file_progress(target))  # a file still being written is not a stalled one
        if leash.left() <= 0:
            print(json.dumps({"result": "timeout", "path": target, "waited_s": waited, **leash.fields()}) if as_json
                  else f"glaeda-gh: {target} not ready after {waited}s (timeout: {leash.words()})")
            return EXIT_TIMEOUT
        time.sleep(min(WAIT_FILE_POLL, max(0.05, leash.left())))


# Without /proc (macOS) the zombie check forks `ps`, so a pid wait runs it at most this often per pid; kill -0 still
# answers every WAIT_FILE_POLL. A `ps` a second per waiter, each one scanned by XProtect, was part of cosmic-gray's
# 223 spawns/s on 2026-11-17 (load 30 on 15 cores, 18 glaeda-gh processes at 81% CPU).
ZOMBIE_CHECK_S = 15.0
_zombie_checked: dict[int, float] = {}


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    # a zombie has exited; its parent just has not reaped it
    try:
        return Path(f"/proc/{pid}/stat").read_text().rpartition(")")[2].split()[0] != "Z"
    except (OSError, IndexError):
        pass
    now = time.monotonic()
    if now - _zombie_checked.get(pid, -ZOMBIE_CHECK_S) < ZOMBIE_CHECK_S:
        return True
    _zombie_checked[pid] = now
    try:
        state = subprocess.run(["ps", "-o", "stat=", "-p", str(pid)], capture_output=True, text=True, timeout=5).stdout
        return not state.strip().startswith("Z") and bool(state.strip())
    except (OSError, subprocess.SubprocessError):
        return True


def cmd_wait_pid(target: str, timeout: float, as_json: bool, ceiling: float | None = None) -> int:
    """Block until the process exits (the `while kill -0 PID` loop). Exit 0 when it is gone, 2 once its CPU time has
    not moved for TIMEOUT (or at CEILING)."""
    if not target.isdigit() or not 0 < int(target) < 2 ** 31:
        raise WatchError(f"wait pid takes a process id, not {target!r}")
    pid = int(target)
    say_waiting(waiting_line(f"pid {pid}", "it exits", None, True, timeout, ceiling))
    leash = Leash(timeout, ceiling)
    start, cpu_at, proc = leash.start, -ZOMBIE_CHECK_S, os.path.exists(f"/proc/{pid}/stat")
    while pid_alive(pid):
        waited = int(time.monotonic() - start)
        # with /proc a CPU read is a file read, every poll; without it a `ps`, at most every ZOMBIE_CHECK_S
        if proc or time.monotonic() - cpu_at >= min(ZOMBIE_CHECK_S, max(1.0, timeout / 4)):
            cpu_at = time.monotonic()
            leash.see(pid_cpu(pid))  # a process still using CPU is working, not hung
        if leash.left() <= 0:
            print(json.dumps({"result": "timeout", "pid": pid, "waited_s": waited, **leash.fields()}) if as_json
                  else f"glaeda-gh: process {pid} still running after {waited}s (timeout: {leash.words()})")
            return EXIT_TIMEOUT
        time.sleep(min(WAIT_FILE_POLL, max(0.05, leash.left())))
    waited = int(time.monotonic() - start)
    print(json.dumps({"result": "success", "pid": pid, "waited_s": waited, "ended_by": "success"}) if as_json
          else f"glaeda-gh: process {pid} exited after {waited}s")
    return EXIT_OK


def until_epoch(target: str, now: float) -> float | None:
    """`wait until`'s time: an ISO time (2026-11-18T14:40:00Z), a UTC clock time today or tomorrow (14:40Z), a
    duration from now (45m), or `quota`: the latest of this host's gh-quota marks (None when no pool is spent)."""
    text = target.strip()
    if text in ("quota", "quota:rest", "quota:graphql"):
        marks = exhausted_marks(now)
        pools = [text.split(":")[1]] if ":" in text else list(marks)
        return max([marks[p]["until"] for p in pools if p in marks] or [0.0]) or None
    match = re.fullmatch(r"(\d+)([smhd])", text)
    if match:
        return now + int(match.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]
    match = re.fullmatch(r"([01]?\d|2[0-3]):([0-5]\d)(?::([0-5]\d))?Z", text)  # 24:30Z and 14:61Z fall through to the refusal
    if match:
        day = dt.datetime.fromtimestamp(now, dt.timezone.utc)
        at = day.replace(hour=int(match.group(1)), minute=int(match.group(2)), second=int(match.group(3) or 0),
                         microsecond=0).timestamp()
        return at if at > now else at + 86400
    at = iso_epoch(text) if re.match(r"\d{4}-\d\d-\d\dT", text) and re.search(r"(Z|[+-]\d\d:\d\d)$", text) else None
    if at is None:
        raise WatchError(f"wait until takes quota, quota:rest, quota:graphql, an ISO time with a zone "
                         f"(2026-11-18T14:40:00Z), a UTC time (14:40Z or 14:40:05Z) or a duration (45m), not {target!r}")
    return at


def cmd_wait_until(target: str, timeout: float, as_json: bool) -> int:
    """Block until a time, or until GitHub quota this host marked spent resets (`wait until quota`): the one wait for
    "go on at T" every agent hook accepts, with no head SHA to read while quota is spent. A quota mark is read again
    on each pass, so a pool spent again on the way is waited out too. Exit 0 at the time, 2 on --timeout."""
    start = time.monotonic()
    deadline = until_epoch(target, time.time())
    say_waiting(waiting_line(f"until {target}", "the time comes", None, True, timeout, leash=False))
    while deadline is not None and time.time() < deadline:
        waited = int(time.monotonic() - start)
        if time.monotonic() - start >= timeout:
            print(json.dumps({"result": "timeout", "until": deadline, "waited_s": waited}) if as_json
                  else f"glaeda-gh: still {int(deadline - time.time())}s before {target} after {waited}s (timeout)")
            return EXIT_TIMEOUT
        time.sleep(max(0.05, min(WAIT_UNTIL_POLL, deadline - time.time(), timeout - (time.monotonic() - start))))
        if target.startswith("quota"):
            deadline = until_epoch(target, time.time())
    waited = int(time.monotonic() - start)
    print(json.dumps({"result": "success", "until": deadline, "waited_s": waited}) if as_json
          else f"glaeda-gh: {target} reached after {waited}s")
    return EXIT_OK


def head_served(entry: dict | None, now: float, max_age: float) -> tuple[dict | None, bool]:
    """(data, fresh): a head's data, and whether it is recent enough. Settled data is good for
    HEAD_SETTLED_TTL and two of the daemon's head cycles (the configured one, as the daemon paces
    by it), pending data for max_age."""
    data = (entry or {}).get("data")
    if not data:
        return None, False
    age = now - ((entry or {}).get("dataAt") or 0)
    if not data.get("settled"):
        return data, age < max_age
    return data, age < HEAD_SETTLED_TTL + 2 * daemon_policy()["cycles"]["head"]


PR_ROLLUP_ROUTE = "pr-rollup"
PR_ROLLUP_GREEN = frozenset({"SUCCESS", "SKIPPED", "NEUTRAL"})


def pr_rollup_head(repo: str, number: int, sha: str, now: float) -> tuple[dict | None, str]:
    """The second route for a head `checks` holds no entry for (hq docs/handbook/read-with-one-quota-route.md): PR
    NUMBER's own cached read, when its headRefOid is SHA and its rollup is whole and green. Returns (the head as
    `checks` serves it, "") or (None, why not). A read of the head can fail (the upstream's 60 s timeout on lane hosts,
    glaeda#2396 2026-11-21) while the PR's read beside it already holds every check of that head.

    Green only: every check finished success, skipped or neutral, no required check missing, the list not cut short
    (checksTruncated, checksPageError). Anything else, a red or one still running, stays unread, so the caller's live
    read decides: the rollup keeps no check-run ids, suites or step counts, which judging a red needs. The answer is
    marked route=pr-rollup, with `at` the PR read's own time and `stale` by head_served's settled rule. It holds the
    head's own repository's checks only (never a CHECKS_OF_RECORD repository's), as land-judge judges them."""
    entry = read_cache(parse_key("pr", f"{repo}#{number}")) or {}
    data = entry.get("data") if isinstance(entry.get("data"), dict) else {}
    at = entry.get("dataAt")
    if not data or not isinstance(at, (int, float)) or isinstance(at, bool):
        return None, f"no cached read of #{number}"
    if str(data.get("headRefOid") or "").lower() != sha:
        return None, f"#{number}'s cached head is {str(data.get('headRefOid') or 'unknown')[:12]}"
    checks = data.get("checks")
    if not isinstance(checks, list) or not checks or not all(isinstance(c, dict) for c in checks):
        return None, f"#{number}'s cached read lists no checks"
    if data.get("checksTruncated") or data.get("checksPageError"):
        return None, f"#{number}'s cached rollup is cut short"
    if data.get("requiredMissing"):
        return None, f"#{number} has required checks not reported: {', '.join(map(str, data['requiredMissing']))[:120]}"
    not_green = sorted(str(c.get("name")) for c in checks
                       if c.get("status") != "COMPLETED" or str(c.get("conclusion") or "").upper() not in PR_ROLLUP_GREEN)
    if not_green:
        return None, f"#{number}'s cached rollup is not all green ({', '.join(not_green)[:120]}): the live read decides"
    found: dict[str, list] = {}
    states: dict[str, str] = {}
    rollup = []
    for c in checks:
        conclusion = str(c.get("conclusion") or "").lower()
        status_context = "id" not in c and not c.get("workflow")  # parse_pr writes no id for a StatusContext
        key = f"status / {c.get('name')}" if status_context else f"{c.get('workflow') or 'check'} / {c.get('name')}"
        found[key] = ["completed", conclusion]
        if status_context:
            states[key] = conclusion
        rollup.append({"name": c.get("name"), "workflow": c.get("workflow"), "status": "COMPLETED",
                       "conclusion": conclusion.upper(), "required": bool(c.get("required")),
                       "runId": c.get("runId"), "statusContext": status_context})
    settled_age = HEAD_SETTLED_TTL + 2 * daemon_policy()["cycles"]["head"]
    return {"found": found, "ids": {}, "settled": True, "statusStates": states, "at": at,
            "stale": now - at >= settled_age, "route": PR_ROLLUP_ROUTE, "pr": number,
            "age": round(max(0.0, now - at), 1), "rollup": rollup}, ""


# `checks --pr N` when this host holds no read of PR N at all: one direct read of it here (direct_read: on a lane VM
# `lane-gh call get`, which reads GitHub with the VM's own read-only token where hq#17426 gives it one, else the
# broker), bounded by CHECKS_PR_DIRECT_BUDGET, then the rollup route again. A failed one is not tried again for the
# same PR for CHECKS_PR_DIRECT_BACKOFF (a stalled upstream would cost every caller the budget, every call); the
# watch registered beside it lets the daemon's own read land the first answer after the upstream recovers.
CHECKS_PR_DIRECT_BUDGET = 20.0
CHECKS_PR_DIRECT_BACKOFF = 120.0
CHECKS_PR_DIRECT_FAILS = "checks-pr-direct.json"  # {key: the time a direct read of it last failed}


def checks_pr_direct(key: str, now: float) -> str | None:
    """One bounded direct read of the PR KEY for `checks --pr`, unless one failed within CHECKS_PR_DIRECT_BACKOFF or
    the bucket it would go over is spent. None when it stored a read, else why not (said in `unread`)."""
    path = BASE / CHECKS_PR_DIRECT_FAILS
    fails = read_json(path) or {}
    last = fails.get(key) if isinstance(fails, dict) else None
    if isinstance(last, (int, float)) and not isinstance(last, bool) and 0 <= now - last < CHECKS_PR_DIRECT_BACKOFF:
        return f"its direct read failed {int(now - last)}s ago"
    blocked = blocked_now("pr")
    if blocked is not None and blocked.get("exhausted") and blocked["routed"] == blocked["bucket"]:
        return f"no direct read: {blocked['text']}"
    error = direct_read({"key": key, "kind": "pr", "jobs": False, "began": now, "budget": CHECKS_PR_DIRECT_BUDGET})
    with contextlib.suppress(OSError, ValueError, TypeError):
        kept = {k: v for k, v in (fails if isinstance(fails, dict) else {}).items()
                if isinstance(v, (int, float)) and 0 <= now - v < CHECKS_PR_DIRECT_BACKOFF and k != key}
        if error:
            kept[key] = now
        write_json(path, kept)
    return f"its direct read failed: {error}" if error else None


def cmd_checks(repo: str, shas: list[str], consumer: str, max_age: float, wait: float, as_json: bool,
               pr: int | None = None) -> int:
    """Every check of each commit, from the daemon's cache. The daemon reads each head once for all
    sessions, within the consumer's hourly budget; a head it may not read is served stale or reported
    unread, and this command never reads GitHub itself. With PR, a head the store has no entry for is
    served from that PR's cached rollup when it is of this head and all green (pr_rollup_head); each
    head names its route (head or pr-rollup). PR N is registered for the daemon's read as well, and a PR this host
    holds no read of gets one bounded direct read (checks_pr_direct) before the head is called unread."""
    if not CONSUMER_RE.fullmatch(consumer or ""):
        raise WatchError("--consumer must be a short name (letters, digits, . _ -), e.g. autoland")
    keys = {}
    for sha in shas:
        keys[sha.lower()] = parse_key("head", f"{repo}@{sha}")
    pr_key = parse_key("pr", f"{repo}#{pr}") if pr is not None else None
    began, start = time.time(), time.monotonic()
    touched = -TOUCH_EVERY
    down, down_since = DownWait(), None
    while True:
        if not daemon_running(grace=DOWN_GRACE):
            down_since = time.monotonic() if down_since is None else down_since
            if not down.patient(down_since, start, wait):
                return EXIT_DOWN
            time.sleep(WAIT_POLL)
            continue
        down_since = None
        broken = daemon_failing()
        if broken is not None:
            say_waiting(failing_message(broken))
            return EXIT_DOWN
        now = time.monotonic()
        if now - touched >= TOUCH_EVERY:
            for key in keys.values():
                register(key, consumer=consumer)
            if pr_key is not None:  # one look: dropped once the daemon has read it, unless asked again
                register(pr_key, once=True)
            touched = now
        served, missing = {}, []
        for sha, key in keys.items():
            entry = read_cache(key)
            data, fresh = head_served(entry, time.time(), max_age)
            if entry and entry.get("missing") and not data:
                missing.append(sha)
            elif data is not None:
                served[sha] = (data, fresh, entry.get("dataAt"))
        ledger = (read_json(BASE / CONSUMERS_FILE) or {}).get("consumers", {}).get(consumer) or {}
        spent = (ledger.get("deniedAt") or 0) >= began - 1
        settled_for_now = all(sha in served and served[sha][1] or sha in missing for sha in keys)
        if settled_for_now or time.monotonic() - start >= wait or (spent and all(
                sha in served or sha in missing or spent for sha in keys)):
            break
        time.sleep(min(WAIT_FILE_POLL, max(0.1, wait - (time.monotonic() - start))))
    heads, unread = {}, {}
    for sha in keys:
        if sha in served:
            data, fresh, at = served[sha]
            heads[sha] = {"found": data.get("found", {}), "ids": data.get("ids", {}), "settled": bool(data.get("settled")),
                          "statusStates": data.get("statusStates", {}), "at": at, "stale": not fresh, "route": "head",
                          **({"statusDescriptions": data["statusDescriptions"]}
                             if isinstance(data.get("statusDescriptions"), dict) else {})}
            if isinstance(data.get("runs"), dict):  # each check run's id and times (head_data's `runs`)
                heads[sha]["runs"] = data["runs"]
        elif sha in missing:
            unread[sha] = "no such commit"
        else:
            why = "budget spent" if spent else "not read yet"
            second, why_not = pr_rollup_head(repo, pr, sha, time.time()) if pr is not None else (None, "")
            if pr_key is not None and second is None and not (read_cache(pr_key) or {}).get("data"):
                direct_why = checks_pr_direct(pr_key, time.time())
                second, why_not = pr_rollup_head(repo, pr, sha, time.time())
                if direct_why and second is None:
                    why_not = f"{why_not}; {direct_why}"
            if second is not None:
                heads[sha] = second
            else:
                unread[sha] = f"{why}; {why_not}" if why_not else why
    partial = bool(unread) or any(h["stale"] for h in heads.values())
    out = {"consumer": consumer, "heads": heads, "unread": unread,
           "budget": {"spent": ledger.get("spent"), "limit": ledger.get("limit"), "denied": spent}}
    if as_json:
        print(json.dumps(out, sort_keys=True))
    else:
        for sha, h in heads.items():
            red = sorted(k for k, (st, co) in h["found"].items() if st == "completed" and co not in ("success", "neutral", "skipped"))
            note = ("stale, " if h["stale"] else "") + ("settled" if h["settled"] else "checks running") + f", {age(h['at'])}"
            print(f"{sha[:12]}: {len(h['found'])} checks, {note}" + (f"; not green: {', '.join(red[:6])}" if red else ""))
        for sha, why in unread.items():
            print(f"{sha[:12]}: unread ({why})")
    return EXIT_PARTIAL if partial else EXIT_OK


def parse_since(text: str | None, began: float) -> tuple[int | None, float | None]:
    """(comment id, epoch): a comment id or URL, an ISO time, or a duration back from now (10m)."""
    if not text:
        return None, began
    text = text.strip()
    match = re.fullmatch(r"(?:https://github\.com/\S*#issuecomment-)?(\d+)", text)
    if match:
        return int(match.group(1)), None
    match = re.fullmatch(r"(\d+)([smhd])", text)
    if match:
        return None, began - int(match.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]
    at = iso_epoch(text) if re.match(r"\d{4}-\d\d-\d\d", text) else None
    if at is None:
        raise WatchError(f"--since must be a comment id or URL, an ISO time (2026-09-25T18:00:00Z) or a "
                         f"duration such as 10m, not {text!r}")
    return None, at


def login(name: str | None) -> str:
    """GraphQL names the Actions bot `github-actions`, REST and the web `github-actions[bot]`."""
    return re.sub(r"\[bot\]$", "", str(name or "").strip().lower().removeprefix("app/"))


def outbox_edits() -> frozenset:
    """The comment ids the outbox edited in place (POST_EDITS)."""
    edits = read_json(BASE / POST_EDITS)
    return frozenset(x for x in edits if isinstance(x, int)) if isinstance(edits, list) else frozenset()


def comment_matches(c: dict, author: str | None, pattern: re.Pattern | None, since_id: int | None,
                    since_time: float | None, edited_ids: set | frozenset = frozenset()) -> bool:
    """A comment the outbox edited in place (a writer's status, POST_STATUS_MAX; its ids in EDITED_IDS) was said
    again when it was edited, so a wait that began before the edit, or names that comment, sees the new text.
    Anyone else's edit (a typo fix, a ticked box, a bot's sticky comment) is not a new comment."""
    edited = iso_epoch(c.get("editedAt")) if c.get("editedAt") and c.get("id") in edited_ids else None
    if since_id is not None and (c.get("id") or 0) <= since_id:
        # `--since` this very comment: an outbox edit of it is newer than it, whenever the wait began. An older one's
        # edit is not (the outbox edits a comment only while it is the thread's last, so before the named one).
        if edited is None or (c.get("id") or 0) < since_id:
            return False
    if since_time is not None and max(iso_epoch(c.get("createdAt")) or 0, edited or 0) < int(since_time):
        return False
    if author and login(c.get("author")) != login(author):
        return False
    return not pattern or bool(pattern.search(str(c.get("body") or "")))


def cmd_wait_comment(target: str, timeout: float, as_json: bool, author: str | None = None,
                     match: str | None = None, since: str | None = None, ceiling: float | None = None) -> int:
    """Wait for a comment on an issue or PR by `author` whose body matches `match`, posted after
    `since` (by default after this wait began). Exits 0 with the comment, 1 when the issue does not
    exist, 2 on timeout."""
    key = parse_key("comment", target)
    try:
        pattern = re.compile(match) if match else None
    except re.error as error:
        raise WatchError(f"--match is not a regular expression: {error}") from None
    began, start = time.time(), time.monotonic()
    say_waiting(waiting_line(key, "a comment" + (f" by {author}" if author else "")
                             + (f" matching {match}" if match else ""), None, True, timeout, ceiling))
    leash = Leash(timeout, ceiling)
    since_id, since_time = parse_since(since, began)
    touched = -TOUCH_EVERY
    warned = False
    down, down_since = DownWait(), None
    _, owner, repo, number = split_key(key)
    name = f"{owner}/{repo}#{number}"
    while True:
        if not daemon_running(grace=DOWN_GRACE):
            down_since = time.monotonic() if down_since is None else down_since
            if not down.patient(down_since, start, timeout):
                return EXIT_DOWN
            time.sleep(WAIT_POLL)
            continue
        down_since = None
        broken = daemon_failing()
        if broken is not None:
            say_waiting(failing_message(broken))
            return EXIT_DOWN
        lag = daemon_stale()
        if lag is not None and not warned:
            say_waiting(stale_message(lag))
            warned = True
        now = time.monotonic()
        if now - touched >= TOUCH_EVERY:
            register(key)
            touched = now
        entry = read_cache(key)
        waited = int(now - start)
        if entry and (entry.get("fetchedAt") or 0) >= began and not entry.get("data") and entry.get("missing"):
            emit(key, entry, as_json, {"result": "failure", "waited_s": waited})
            return EXIT_FAIL
        comments = ((entry or {}).get("data") or {}).get("comments") or []
        edits = outbox_edits()
        found = next((c for c in comments if comment_matches(c, author, pattern, since_id, since_time, edits)),
                     None)
        if found:
            if as_json:
                print(json.dumps({"key": key, "result": "success", "waited_s": waited, "comment": found,
                                  "url": (entry.get("data") or {}).get("url")}, sort_keys=True))
            else:
                body = str(found.get("body") or "").splitlines()
                print(f"{name}: comment {found.get('id')} by {found.get('author')} at {found.get('createdAt')}")
                print(found.get("url") or "")
                for line in body[:40]:
                    print(f"  {line}")
                if len(body) > 40:
                    print(f"  ... {len(body) - 40} more lines")
                print(f"result: success\nwaited_s: {waited}")
            return EXIT_OK
        if entry and (entry.get("fetchedAt") or 0) >= began:
            leash.see(wait_progress_print("comment", entry))  # a thread still being written in counts as moving
        if leash.left() <= 0:
            newer = sum(1 for c in comments if comment_matches(c, None, None, since_id, since_time, edits))
            where = "since the wait began" if not since else f"after {since}"
            hint = "; to include a reply posted before the wait, pass --since with your own comment's URL" if not since else ""
            emit(key, entry, as_json, {"result": "timeout", "waited_s": waited, **leash.fields(),
                                       "note": f"{newer} comments {where}, none matched{hint} ({leash.words()})"})
            return EXIT_TIMEOUT
        time.sleep(min(WAIT_POLL, max(0.1, leash.left())))


def controller_line(ctl: dict) -> str:
    state = ctl.get("state")
    scope = "" if ctl.get("token") else ", public repos only (no token)"
    if state == "ok":
        return (f"controller: webhook events ok, {ctl.get('runs', 0)} watched runs from it, last delivery "
                f"{age(iso_epoch(ctl.get('lastDelivery')))}{scope}")
    if state in {"down", "absent"}:
        why = "no run-events receiver there" if state == "absent" else f"unreachable ({ctl.get('error')})"
        return f"controller: {why}; polling GitHub meanwhile, next try in {max(0, int((ctl.get('retryAt') or 0) - time.time()))}s"
    if state == "off":
        return "controller: none configured; polling GitHub"
    return "controller: starting"


def controller_fallback_line(doc: Any) -> str:
    """`budget`'s line for the controller fallbacks that cost REST quota: how many deadlines the controller
    missed, how many run reads went to REST because of them, and the window both cover (CONTROLLER_FALLBACK_FILE,
    Daemon.note_controller_fallback). Empty when this host has never had one."""
    hours = doc.get("hours") if isinstance(doc, dict) else None
    if not isinstance(hours, dict):
        return ""
    kept = {h: b for h, b in hours.items() if isinstance(b, dict)}

    def total(what: str, only: set[str] | None = None) -> int:
        return sum(int(b.get(what) or 0) for h, b in kept.items() if only is None or h in only)

    this_hour = {time.strftime("%Y-%m-%dT%HZ", time.gmtime(time.time()))}
    missed, runs = total("deadline"), total("restRuns")
    if not missed and not runs:
        return ""
    since = doc.get("since")
    window = f"since {age(since)}" if isinstance(since, (int, float)) else f"over the {len(kept)} hours kept"
    return (f"controller fallback: {missed} missed deadlines sent {runs} run reads to the shared REST quota "
            f"that the controller would have served free, {window} ({total('deadline', this_hour)} and "
            f"{total('restRuns', this_hour)} this hour); last missed deadline {age(doc.get('lastAt'))}")


def spend_lines(spend: Any) -> list[str]:
    """`budget`'s spend tables from daemon.json spendBy (Daemon.spend_by)."""
    if not isinstance(spend, dict):
        return []
    rest, gql = spend.get("rest") or {}, spend.get("graphql") or {}
    out = [f"spend by path, last {int(spend.get('window') or 3600) // 60} min: {rest.get('counted', 0)} counted REST "
           f"of {rest.get('requests', 0)} sent (304s and rate_limit are free), {gql.get('points', 0)} GraphQL points "
           f"in {gql.get('queries', 0)} queries ({SPEND_FILE})"]
    for r in spend.get("restByRoute") or []:
        held = f"; waiter {r['topWaiter']} {r.get('topWaiterCounted', 0)}" if r.get("topWaiter") else ""
        out.append(f"  REST {r.get('counted', 0):>5} of {r.get('requests', 0):>5}  {r.get('route')}  "
                   f"(most: {r.get('topCaller') or '?'} {r.get('topCallerCounted', 0)}; {r.get('callers', 0)} callers{held})")
    for r in spend.get("restByCaller") or []:
        out.append(f"  REST {r.get('counted', 0):>5} of {r.get('requests', 0):>5}  {r.get('route')}  "
                   f"by {r.get('kind')} {r.get('repo') or ''}".rstrip() + waiters_text(r, "counted"))
    for r in spend.get("graphqlByQuery") or []:
        out.append(f"  GraphQL {r.get('points', 0):>5} points in {r.get('queries', 0):>4}  {r.get('query')}  "
                   f"by {r.get('kind')} {r.get('repo') or ''}".rstrip() + waiters_text(r, "points"))
    return out


# ---------------------------------------------------------------- budget across hosts

# What each host prints for fleet_budget: the files it already keeps and its gh-quota usage, between marker lines.
# POSIX sh (a Mac's login shell may be zsh; `sh -c` keeps it one dialect). The daemon's state dir is the default one:
# GLAEDA_GH_DIR is a test's or an operator's override and an ssh session does not carry it.
# gh-quota is the first of FLEET_GH_QUOTA_PATHS present: a full setup links ~/.local/bin/gh-quota, and a lighter one
# links ~/.local/lib/gh-quota/bin/gh-quota beside the gh shim. 2026-11-17: two hosts with only the second answered
# "gh-quota usage gave nothing" and read as 0 REST while one of them alone spent about 760 an hour, so most of the
# login's hour looked like calls from nowhere.
FLEET_GH_QUOTA_PATHS = tuple(f"$HOME/{p}" for p in GH_QUOTA_PATHS)
FLEET_HOST_SCRIPT = (
    'd="${GLAEDA_GH_DIR:-$HOME/.cache/glaeda/gh}"; '
    'echo "@@budget"; cat "$d/budget.json" 2>/dev/null; echo; '
    'echo "@@daemon"; cat "$d/daemon.json" 2>/dev/null; echo; '
    'q=; for c in ' + " ".join(f'"{p}"' for p in FLEET_GH_QUOTA_PATHS) + '; do [ -x "$c" ] && { q="$c"; break; }; '
    'done; '
    'echo "@@usage"; [ -n "$q" ] && "$q" usage --json 2>/dev/null; echo; '
    'echo "@@end"')


def parse_host_report(text: str) -> dict:
    """FLEET_HOST_SCRIPT's output as {"budget", "daemon", "usage"}, each None when the host had nothing parseable."""
    parts: dict[str, list[str]] = {}
    current = None
    for line in (text or "").splitlines():
        if line.startswith("@@"):
            current = line[2:].strip()
            parts.setdefault(current, [])
        elif current is not None:
            parts[current].append(line)
    out: dict[str, Any] = {}
    for name in ("budget", "daemon", "usage"):
        try:
            out[name] = json.loads("\n".join(parts.get(name) or []))
        except ValueError:
            out[name] = None
    if "end" not in parts:
        out["truncated"] = True
    return out


def local_host_report() -> dict:
    """This host's own FLEET_HOST_SCRIPT answer, read in place (BASE, SPENDERS_CMD) instead of through a shell."""
    usage = None
    try:
        done = run_bounded([SPENDERS_CMD, "usage", "--json"], timeout=FLEET_HOST_TIMEOUT)
        usage = json.loads(done.stdout) if done.returncode == 0 and (done.stdout or "").strip() else None
    except (OSError, subprocess.SubprocessError, ValueError):
        usage = None
    return {"budget": read_json(BASE / "budget.json"), "daemon": read_json(BASE / "daemon.json"), "usage": usage}


def fleet_hosts() -> list[str]:
    """The hosts signed in to the shared login: GLAEDA_GH_BUDGET_HOSTS (comma-separated), else the fleet registry's
    origins (leo-workspace machines/fleet-registry.json, beside gh-quota's checkout, or reach's installed copy), else
    FLEET_BUDGET_HOSTS. This host comes first whether it is one or not (a lane VM's own sessions spend through the
    broker, and its gh-quota log names them)."""
    env = os.environ.get("GLAEDA_GH_BUDGET_HOSTS")
    hosts: list[str] = [h.strip() for h in env.split(",") if h.strip()] if env else []
    if not env:
        for doc in fleet_registries():
            origins = doc.get("origins")
            if isinstance(origins, dict) and origins:
                hosts = [str(h) for h in origins]
                break
        hosts = hosts or list(FLEET_BUDGET_HOSTS)
    me = policy_host()
    return [me] + [h for h in hosts if h != me]


def fleet_registries() -> list[dict]:
    """The fleet registries this host can read, in order: leo-workspace machines/fleet-registry.json beside gh-quota's
    checkout, then reach's installed copy."""
    docs = [read_json(path) for path in (Path(SPENDERS_CMD).resolve().parent.parent / "machines/fleet-registry.json",
                                         Path.home() / ".ssh/config.d/fleet-registry.json")]
    return [doc for doc in docs if isinstance(doc, dict)]


FLEET_MACHINES_TTL = 300.0
_fleet_machines: tuple[float, frozenset[str]] | None = None


def fleet_machines() -> frozenset[str]:
    """Every machine name the fleet registry knows (its "machines" with their aliases, and its "origins"), read at most
    once per FLEET_MACHINES_TTL; empty when no registry is readable. What tells a peer's HOST/SESSION from a
    sub-session's PARENT/CHILD (land_session_host)."""
    global _fleet_machines
    now = time.monotonic()
    if _fleet_machines is not None and now - _fleet_machines[0] < FLEET_MACHINES_TTL:
        return _fleet_machines[1]
    names: set[str] = set()
    for doc in fleet_registries():
        for field in ("machines", "origins"):
            table = doc.get(field)
            for name, spec in table.items() if isinstance(table, dict) else ():
                names.add(str(name))
                aliases = spec.get("aliases") if isinstance(spec, dict) else None
                if isinstance(aliases, list):
                    names.update(a for a in aliases if isinstance(a, str))
    _fleet_machines = (now, frozenset(n for n in names if n))
    return _fleet_machines[1]


def hard_reserve_floor() -> dict:
    """{"rest": N, "graphql": N}: the calls the daemon's own reads on the login never spend, waited reads included:
    hard_reserve() (leo-workspace machines/gh-quota.json hard_reserve_calls, kept in step with leo-workspace#5618's
    tools/gh_reserve.py), never under HARD_RESERVE_DEFAULT (a policy may raise a pool's reserve, never lower or empty
    it). The login is Leo's own: his Claude app and gh read the same hour (2026-11-17, REST at 0 of 5000 at 04:15Z
    and 05:05Z; Leo: "this is... interesting. so claude desktop shows rate limit on hover of the github links
    sometimes...")."""
    named = hard_reserve()
    return {pool: max(default, named.get(pool, default) if isinstance(named.get(pool), int) else default)
            for pool, default in HARD_RESERVE_DEFAULT.items()}


def host_cap_why(pool: str, remaining: float | int | None) -> str:
    """Why POOL's pace left a land out, when the login's live count is REMAINING: the words that say whether the pool
    itself is spent or Leo's reserve is what is left. "host cap (graphql: 55 left)" reads as a pool with room and a
    queue that will not use it; the 55 are under hard_reserve_floor's 500, which no agent caller spends (its comment),
    so the pace is right and only the line was missing its reason. Measured 2026-11-22 00:04Z: teamleaderleo/glaeda#2411
    sat "host cap (graphql: 55 left, resets 00:38Z)" and reading the pace to find out why cost four calls. Empty when
    the pool has spendable room (another pool, or the per-judgment cost, is what held it)."""
    if not isinstance(remaining, (int, float)) or isinstance(remaining, bool):
        return ""
    floor = hard_reserve_floor().get(pool)
    cost = LAND_JUDGE_COST.get(pool)
    if floor is None or cost is None:
        return ""
    if float(remaining) - float(floor) < float(cost):
        return f", all of it under the {floor}-point reserve no caller spends"
    return ""


def quota_policy_path() -> Path:
    return Path(os.environ.get("GLAEDA_GH_QUOTA_POLICY")
                or Path(SPENDERS_CMD).resolve().parent.parent / "machines/gh-quota.json")


def pace_settings() -> dict:
    """PACE_DEFAULTS overlaid with gh-quota.json's positive values for the same keys."""
    doc = read_json(quota_policy_path())
    out = dict(PACE_DEFAULTS)
    if isinstance(doc, dict):
        for key in out:
            v = doc.get(key)
            if isinstance(v, (int, float)) and not isinstance(v, bool) and v > 0:
                out[key] = float(v)
    return out


def pace_spread(caller: str, reset: float, spread: float | None = None) -> float:
    """CALLER's own offset in [0, reset_spread_s] past RESET: leo-workspace gh_pace.spread_s's hash, so one caller is
    told one time per reset and N callers spread evenly over the window."""
    width = pace_settings()["reset_spread_s"] if spread is None else spread
    digest = hashlib.sha256(f"{caller}\0{int(reset)}".encode()).digest()
    return int.from_bytes(digest[:4], "big") / 0xFFFFFFFF * width


def latch_state_dir() -> Path:
    return Path(os.environ.get("GH_QUOTA_STATE") or Path.home() / ".local/state/gh-quota")


def latch_write_secondary(now: float, until: float, by: str = "glaeda-gh") -> None:
    """Both pools' login marks (leo-workspace tools/gh_latch.py's files and fields) after GitHub's secondary limit, so
    every caller on the host stops, not just the one that met it. Never shortens a mark that holds."""
    for pool in ("rest", "graphql"):
        path = latch_state_dir() / f"{pool}-exhausted.json"
        old = read_json(path)
        old_until = old.get("until") if isinstance(old, dict) else None
        if isinstance(old_until, (int, float)) and not isinstance(old_until, bool) and old_until >= until > now:
            continue
        with contextlib.suppress(OSError):
            write_json(path, {"until": until, "at": now, "reset": None, "source": "secondary", "by": by[:60],
                              "identity": "login"})


def latch_secondary_until(now: float) -> float | None:
    """The latest until of a login mark another caller wrote for GitHub's secondary limit that holds at NOW."""
    best = None
    for pool in ("rest", "graphql"):
        doc = read_json(latch_state_dir() / f"{pool}-exhausted.json")
        if not isinstance(doc, dict) or doc.get("source") != "secondary":
            continue
        until = doc.get("until")
        if isinstance(until, (int, float)) and not isinstance(until, bool) and now < until:
            best = max(best or 0.0, min(float(until), now + PACE_HOLD_MAX))
    return best


def hard_reserve() -> dict:
    """gh-quota's hard reserve per pool: leo-workspace machines/gh-quota.json hard_reserve_calls (GLAEDA_GH_QUOTA_POLICY
    names another file), an int for both pools or {"rest": N, "graphql": N}; HARD_RESERVE_DEFAULT where it says
    nothing."""
    path = quota_policy_path()
    doc = read_json(path)
    value = doc.get("hard_reserve_calls") if isinstance(doc, dict) else None
    out = dict(HARD_RESERVE_DEFAULT)
    found = False
    for pool in out:
        v = value if isinstance(value, int) else value.get(pool) if isinstance(value, dict) else None
        if isinstance(v, int) and not isinstance(v, bool) and v >= 0:
            out[pool], found = v, True
    return {**out, "source": f"{path.name} hard_reserve_calls" if found
            else f"default: {path.name} has no hard_reserve_calls yet"}


def spend_unread_why(report: dict) -> str | None:
    """Why a reached host's login spend was not read (its gh-quota usage gave nothing, an empty list, rows with no
    REST count from an older gh-quota, or an answer cut short), or None when it was. 2026-11-19: three Linux hosts
    printed "REST 0" from cosmic-gray while the read hosts explained well under half the ~3000 REST spent:
    an unread host is unknown, not idle."""
    usage = report.get("usage")
    if report.get("truncated"):
        return "its answer was cut short"
    if usage is None:
        return "gh-quota usage gave nothing"
    if not isinstance(usage, list) or not usage:
        return "gh-quota usage listed no caller"
    rows = [r for r in usage if isinstance(r, dict)]
    if not rows or not any("rest" in r or "graphql" in r for r in rows):
        return "gh-quota usage has no rest or graphql counts (an older gh-quota)"
    return None


def summarize_host(report: dict, now: float) -> dict:
    """One reachable host's row: its callers (gh-quota usage, which already counts the daemon and the broker's VMs),
    the REST and GraphQL they spent, what was free (304s the daemon got, reads served from a cache or mirror), and
    the account reading its daemon last took."""
    rows = report.get("usage") if isinstance(report.get("usage"), list) else []

    def n(v: Any) -> int:
        return v if isinstance(v, int) and not isinstance(v, bool) and v > 0 else 0

    callers = []
    for r in rows:
        if not isinstance(r, dict) or not isinstance(r.get("caller"), str):
            continue
        rest, gql = n(r.get("rest")), n(r.get("graphql")) + n(r.get("search"))
        served = n(r.get("cache")) + n(r.get("mirror")) + n(r.get("glaeda"))
        if rest or gql or served:
            callers.append({"caller": r["caller"], "rest": rest, "graphql": gql, "served": served,
                            "source": r.get("source")})
    callers.sort(key=lambda c: (-c["rest"], -c["graphql"], c["caller"]))
    daemon = report.get("daemon") if isinstance(report.get("daemon"), dict) else {}
    hour = daemon.get("lastHour") if isinstance(daemon.get("lastHour"), dict) \
        and isinstance(daemon.get("at"), (int, float)) and now - daemon["at"] < 3600 else {}
    out = {"ok": True, "rest": sum(c["rest"] for c in callers), "graphql": sum(c["graphql"] for c in callers),
           "notModified": n(hour.get("rest304")), "served": sum(c["served"] for c in callers), "callers": callers,
           "usage": report.get("usage") is not None}
    why = spend_unread_why(report)
    if why:  # reached, but its spend was not read: unknown (None), never 0 (sweep_tally leaves it out of the sum)
        out.update(rest=None, graphql=None, unread=why)
    budget = report.get("budget") if isinstance(report.get("budget"), dict) else {}
    out["readings"] = {b: {k: budget[b].get(k) for k in ("remaining", "limit", "reset", "seenAt")}
                       for b in ("rest", "graphql") if isinstance(budget.get(b), dict)}
    return out


# A bucket with no fresh reading on any host is still readable, for free: GET /rate_limit reports every resource
# family at once and counts against no primary limit (the daemon's own counter calls those "rate_limit reads (free)",
# and `GET /rate_limit` sits at "REST 0 of 30" in its spend table). So the account's answer has three routes, tried in
# this order: this host's own daemon reading, then the freshest peer's, then one free read here.
#
# Measured on one host 2026-11-21, 25 minutes apart: `budget` printed "GraphQL unknown (no reachable host's daemon has
# a fresh reading)" both times while REST answered to the call (4458/5000, then 4822/5000), with two of five hosts
# "unreachable (no answer in 25s)". A daemon's GraphQL reading only refreshes when it sends a GraphQL query or
# /rate_limit answers, while every REST answer carries its own headers -- so an idle or REST-leaning daemon has a
# fresh REST reading and no GraphQL one, and the fleet's GraphQL answer went unknown while the number was free to
# obtain. GraphQL is the bucket every PR state read spends (`reading: PRs over GraphQL, ... comments over GraphQL`),
# so it is the one number a lander needs and the one `budget` was least likely to hold: in that same window three
# `wait pr` calls each burned a full 1800 s timeout on "no data yet" with the shared login's GraphQL bucket at 0 and
# ~3,300 REST calls left, and nothing an operator could run would have said so.
#
# docs/handbook/measurement-unknown-when-shared-quota-spent.md decides the shape: a measurement on a shared quota has
# a second source that does not share it, and says which one answered and how old it is. Here the second source costs
# no quota at all, so it is the last route rather than a carried reading, and a bucket that still cannot be read says
# who was asked, what each answered and the one next step -- never a bare "unknown".
FREE_READ_BUDGET = 10.0  # one free GET /rate_limit here must not hold `budget` longer than this
ACCOUNT_ROUTES = ("local", "peer", "direct")  # in preference order; every reading carries the one that answered


def account_reading(hosts: dict, now: float, me: str | None = None) -> dict:
    """The login's REST and GraphQL as the freshest live reading any host's daemon took (each host's "rest" is already
    the poorest core counter it sees), with the host that read it and the route that answered -- "local" for this
    host's own daemon, "peer" for another's. An unreachable host is skipped, so it can never by itself make a bucket
    unknown; neither route reads GitHub, and the free direct read (free_account_reading) is the third route, taken by
    host_sweep when this returns nothing for a bucket.

    Freshest wins rather than local first, and a tie goes to local. Every host reads the same shared pool, so the
    freshest reading is the truest one, and `budget` prints the host and the age either way. Preferring local would
    report a 600 s-old reading here (4000 REST left) over a peer's 30 s-old one (12 left) -- and sweep_tally's
    unattributed gap is "limit - remaining" of this very reading, so an old one understates the account's spend as
    well as overstating what a lander may take."""
    out: dict[str, dict] = {}
    for bucket in ("rest", "graphql"):
        live: list[dict] = []
        for name, h in hosts.items():
            r = (h.get("readings") or {}).get(bucket) if h.get("ok") else None
            try:
                seen, reset = float(r["seenAt"]), float(r["reset"])
                int(r["remaining"]), int(r["limit"])
            except (TypeError, KeyError, ValueError):
                continue
            if reset <= now or now - seen > FLEET_READING_MAX_AGE:
                continue
            live.append({**r, "host": name, "route": "local" if name == me else "peer"})
        best = max(live, key=lambda r: (r["seenAt"], r["route"] == "local"), default=None)
        if best is not None:
            out[bucket] = best
    return out


def free_account_reading(now: float, make: Callable[[], Any] | None = None) -> dict:
    """GitHub's own count of every bucket from one GET /rate_limit here. That read counts against no primary limit, so
    it is the route that answers when no daemon on the fleet holds a fresh reading, and asking it costs a lander
    nothing. The shared login's count only: Daemon.request offers a call to an App pool only when it is not free, so
    an App pool's headroom can never be read back as the login's. {"readings": {bucket: reading}} or {"error": why};
    this never raises, because reporting the budget must not fail on the read that would have filled it in."""
    if upstream_command() is not None:
        return {"error": "this host reads GitHub through its upstream (upstream.json) and has no login to ask"}
    try:
        daemon = (make or (lambda: Daemon(controller=None, upstream=None)))()
    except Exception as failure:  # noqa: BLE001  a free reading is never the command failing
        return {"error": f"{describe(failure)} at {error_site(failure)}"}
    # A session's own free read, not the daemon's polling: it must never write rest-spend.json from the copy it read
    # at construction, which would overwrite the minutes the daemon has counted since (review of glaeda#1942).
    daemon.charge_rest = lambda minute, n: None  # type: ignore[method-assign]
    daemon.now = now
    daemon.tick_deadline = time.monotonic() + FREE_READ_BUDGET
    try:
        daemon.read_rate_limit()
    except OutOfTime:
        return {"error": f"no answer within {FREE_READ_BUDGET:g}s"}
    except Exception as failure:  # noqa: BLE001
        return {"error": f"{describe(failure)} at {error_site(failure)}"}
    if daemon.rate_limit_at < now:  # read_rate_limit stamps this only when /rate_limit answered
        why = next((e for e in reversed(daemon.errors) if e.startswith("rate_limit: ")), None)
        return {"error": why[len("rate_limit: "):] if why else "/rate_limit gave no reading"}
    # budget.json was loaded at construction, so only a bucket this answer refreshed is reported: its seenAt is NOW.
    out = {b: {**r, "seenAt": now} for b in ("rest", "graphql")
           if isinstance(r := daemon.budget.get(b), dict) and isinstance(r.get("remaining"), int)
           and float(r.get("seenAt") or 0) >= now}
    return {"readings": out} if out else {"error": "/rate_limit named no core or graphql resource"}


def reading_gaps(hosts: dict, bucket: str, now: float) -> dict:
    """Why each host holds no live BUCKET reading: its own error when it did not answer, else what its daemon's
    reading was. A host that could not be reached and a host whose daemon has simply never taken a reading of that
    bucket are different conditions, and `budget` must not print one of them for the other."""
    out: dict[str, str] = {}
    name_of = POOL_NAMES.get(bucket, bucket)
    for host, h in hosts.items():
        if not h.get("ok"):
            out[host] = h.get("error") or "unreachable"
            continue
        r = (h.get("readings") or {}).get(bucket)
        if not isinstance(r, dict) or not isinstance(r.get("remaining"), int):
            out[host] = f"answered; its daemon has taken no {name_of} reading (it sends no {name_of} request)"
        elif float(r.get("reset") or 0) <= now:
            out[host] = f"answered; its {name_of} window reset {hhmm(r.get('reset'))} and nothing read it since"
        elif now - float(r.get("seenAt") or 0) > FLEET_READING_MAX_AGE:
            out[host] = (f"answered; its {name_of} reading is {int(now - float(r['seenAt']))}s old, over the "
                         f"{FLEET_READING_MAX_AGE:g}s an account reading may be")
        else:
            out[host] = f"answered; live {name_of} reading"
    return out


def exhausted_marks(now: float) -> dict:
    """gh-quota's own marks on this host that a pool is spent until a time (rest-exhausted.json, graphql-exhausted.json
    under ~/.local/state/gh-quota): the only account reading a lane VM, which has no daemon budget of its own, holds."""
    state = Path(os.environ.get("GH_QUOTA_STATE") or Path.home() / ".local/state/gh-quota")
    out = {}
    for bucket in ("rest", "graphql"):
        doc = read_json(state / f"{bucket}-exhausted.json")
        until = doc.get("until") if isinstance(doc, dict) else None
        if isinstance(until, (int, float)) and until > now:
            out[bucket] = {"until": until, "at": doc.get("at")}
    return out


def spend_view() -> dict:
    """The lane-gh broker's spend_view (cmuxterm-hq hq#12421): the login's spend on every host per host and session,
    from each host's NOW census, against GitHub's own used count for the window; no GitHub call. {"ok": True, "data"}
    or {"ok": False, "error"} where lane-gh is absent, refuses (a host that is no broker client) or does not answer."""
    if not os.access(LANE_GH_CMD, os.X_OK):
        return {"ok": False, "error": "no lane-gh here"}
    try:
        done = run_bounded([LANE_GH_CMD, "call", "spend_view", SPEND_VIEW_REPO, json.dumps({"top": SPEND_VIEW_TOP})],
                           timeout=FLEET_HOST_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"lane-gh spend_view gave no answer in {FLEET_HOST_TIMEOUT:g}s"}
    except (OSError, subprocess.SubprocessError):
        return {"ok": False, "error": "lane-gh spend_view did not run"}
    try:
        answer = json.loads(done.stdout)
    except ValueError:
        lines = [x.strip() for x in (done.stderr or "").splitlines() if x.strip()]
        return {"ok": False, "error": "lane-gh spend_view: " + (lines[-1][:200] if lines else "no answer")}
    data = answer.get("data") if isinstance(answer, dict) else None
    if not isinstance(data, dict) or not answer.get("ok") or not isinstance(data.get("pools"), list):
        why = (answer or {}).get("error") if isinstance(answer, dict) else None
        why = why or (data.get("error") if isinstance(data, dict) else None) or "no spend_view in its answer"
        return {"ok": False, "error": f"lane-gh spend_view: {str(why)[:200]}"}
    return {"ok": True, "data": {k: v for k, v in data.items() if k != "markdown"}}


def fetch_host(host: str, local: bool) -> dict:
    """One host's report: this host's in place, another's through one `reach HOST sh -c FLEET_HOST_SCRIPT`."""
    if local:
        return local_host_report()
    try:
        done = run_bounded([REACH_CMD, host, "sh", "-c", shlex.quote(FLEET_HOST_SCRIPT)], timeout=FLEET_HOST_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {"error": f"unreachable (no answer in {FLEET_HOST_TIMEOUT:g}s)"}
    except OSError as error:
        return {"error": f"unreachable ({Path(REACH_CMD).name}: {error.strerror or error})"}
    report = parse_host_report(done.stdout)
    if done.returncode != 0 and all(report.get(k) is None for k in ("budget", "daemon", "usage")):
        lines = [x.strip() for x in (done.stderr or "").splitlines() if x.strip()]
        return {"error": f"unreachable (exit {done.returncode}: {(lines[-1] if lines else 'no output')[:160]})"}
    return report


def sweep_rows(names: list[str], me: str, clock: float, fetch: Callable[[str, bool], dict]) -> dict[str, dict]:
    """Each of NAMES read at once, one fetch each, joined within FLEET_HOST_TIMEOUT: its summarize_host row, or
    {"ok": False, "error"}."""
    reports: dict[str, dict] = {}

    def one(host: str) -> None:
        try:
            reports[host] = fetch(host, host == me)
        except Exception as error:  # a host's read is never the command failing
            reports[host] = {"error": f"unreachable ({type(error).__name__})"}

    names = list(dict.fromkeys(names))  # one read per name (router review of glaeda#2248, F3)
    threads = [threading.Thread(target=one, args=(h,), daemon=True) for h in names]
    for t in threads:
        t.start()
    for t in threads:
        t.join(FLEET_HOST_TIMEOUT + 5)
    rows: dict[str, dict] = {}
    for host in names:
        report = dict(reports.get(host) or {"error": "unreachable (no answer)"})
        rows[host] = {"ok": False, "error": report["error"]} if report.get("error") else summarize_host(report, clock)
    return rows


def host_sweep(clock: float, fetch: Callable[[str, bool], dict],
               free: Callable[[float], dict] | None = None) -> dict:
    """spend_view's stand-in: every host at once, one fetch each, joined within FLEET_HOST_TIMEOUT. Then each lane VM
    no read host's broker:VM rows carry is read itself (its own gh-quota log names every call it sent through its
    broker), so a VM whose broker host is unread or idle is a row of its own, not "no broker:VM row". The coordinator,
    2026-11-20: "budget can't read lane VMs ('no broker:VM row'), so the biggest spender is invisible" (cosmic-gray at
    23:39Z the night before: 280 of 542 REST unattributed). Only the VMs no read host carries are read, but that
    includes an idle VM whose broker host answered with no row for it: one `reach` per such VM per sweep, all at once
    within FLEET_HOST_TIMEOUT, at most once per FLEET_BUDGET_TTL (router review of glaeda#2248, F2)."""
    hosts = fleet_hosts()
    me = hosts[0]
    rows = sweep_rows(hosts, me, clock, fetch)
    if rows[me].get("ok") and UPSTREAM_CONFIG.exists():  # no login here: every call went through a broker
        rows[me]["brokerClient"] = True
    doc: dict[str, Any] = {"hosts": rows, "account": account_reading(rows, clock, me),
                           "exhausted": exhausted_marks(clock)}
    fill_account(doc, rows, clock, me, free)
    vms = fleet_lane_vms()
    carried = set(sweep_tally(doc, [])["laneVms"]["brokered"]) | set(rows)
    missing = [vm for vm in vms if vm not in carried]
    vm_rows = sweep_rows(missing, me, clock, fetch) if missing else {}
    for row in vm_rows.values():
        if row.get("ok"):
            row["brokerClient"] = True
    doc["laneVmRows"] = vm_rows
    doc["total"] = sweep_tally(doc, vms)
    return doc


def fill_account(doc: dict, rows: dict, clock: float, me: str, free: Callable[[float], dict] | None = None) -> None:
    """The third route, and what to say when none of them answered. Any bucket account_reading left without a live
    reading is read here for free (one GET /rate_limit answers both at once, so this costs one bounded read per sweep
    at most, kept FLEET_BUDGET_TTL with the rest of the answer), and every bucket still unread records who was asked
    and what each answered (accountGaps) so `budget` prints that instead of a bare "unknown". A gh-quota mark that a
    bucket is spent is not an answer to what is left in it: a marked bucket is read too, and both are printed."""
    missing = [b for b in ("rest", "graphql") if b not in doc["account"]]
    if missing:
        answer = (free or free_account_reading)(clock)
        doc["freeRead"] = {"error": answer["error"]} if answer.get("error") else {"at": clock, "buckets": missing}
        for bucket in missing:
            r = (answer.get("readings") or {}).get(bucket)
            if isinstance(r, dict) and float(r.get("reset") or 0) > clock:
                doc["account"][bucket] = {**r, "host": me, "route": "direct"}
    doc["accountGaps"] = {b: reading_gaps(rows, b, clock) for b in ("rest", "graphql") if b not in doc["account"]}


def account_unknown(bucket: str, doc: dict) -> str:
    """Why a bucket has no number, which hosts were asked, what each answered, and the one next step. Never a bare
    "unknown": an operator who cannot see the GraphQL bucket cannot tell a lander's 1800 s of "no data yet" from a
    slow run (docs/handbook/missing-read-counted-as-a-value.md: a thing whose read did not happen is unknown, and
    says so)."""
    gaps = (doc.get("accountGaps") or {}).get(bucket) or {}
    free = (doc.get("freeRead") or {}).get("error")
    answered = [h for h, why in gaps.items() if why.startswith("answered")]
    if bucket in (doc.get("accountDropped") or ()):  # kept from a sweep whose window has since ended (budget_served)
        return (f"unknown: the kept reading's window has reset since it was read; next: run `glaeda-gh budget` again, "
                f"past the {FLEET_BUDGET_TTL:g}s an answer is kept for every session")
    lead = (f"unknown: no host answered ({len(gaps)} asked)" if gaps and not answered
            else f"unknown: {len(answered)} of {len(gaps)} hosts answered, none with a live reading" if gaps
            else "unknown: no host reading was collected")
    if free:
        step = ("ask a host that holds the login (`glaeda-gh budget` there)"
                if "upstream" in free else
                f"fix that read -- it is the only route left: `glaeda-gh gh api /rate_limit --jq .resources.{bucket}` "
                f"here, which spends nothing")
    else:
        step = f"`glaeda-gh gh api /rate_limit --jq .resources.{bucket}` here, which spends nothing"
    where = "; ".join(f"{host}: {why}" for host, why in gaps.items())
    route = f"the free GET /rate_limit here: {free}" if free else "the free GET /rate_limit here was not tried"
    return f"{lead}" + (f" ({where})" if where else "") + f"; {route}; next: {step}"


def account_line(bucket: str, reading: dict, marks: dict) -> str:
    """One bucket's number with the route that answered it and how old it is, as `budget` has always shown REST."""
    route = reading.get("route")
    by = (f"read here by a free GET /rate_limit {age(reading.get('seenAt'))}" if route == "direct"
          else f"read by {reading.get('host')} {age(reading.get('seenAt'))}")
    mark = marks.get(bucket)
    spent = f"; gh-quota's mark here says spent until {hhmm(mark.get('until'))}" if isinstance(mark, dict) else ""
    return (f"{POOL_NAMES[bucket]} {reading.get('remaining')}/{reading.get('limit')} left, resets "
            f"{hhmm(reading.get('reset'))} ({by}){spent}")


def fleet_lane_vms() -> list[str]:
    """The lane VMs that spend the login through a broker: GLAEDA_GH_BUDGET_LANE_VMS (comma-separated; set and empty
    is none), else the fleet registry's machines marked agent_vm and not retired."""
    env = os.environ.get("GLAEDA_GH_BUDGET_LANE_VMS")
    if env is not None:  # each name once: two reads of one VM race, and a failed one could replace a good one (F3)
        return list(dict.fromkeys(v.strip() for v in env.split(",") if v.strip()))
    for doc in fleet_registries():
        machines = doc.get("machines")
        if isinstance(machines, dict) and machines:
            return sorted(str(name) for name, spec in machines.items()
                          if isinstance(spec, dict) and spec.get("agent_vm") and not spec.get("retired"))
    return []


def broker_vm(caller: str) -> str | None:
    """VM of a broker host's "broker:VM" or "broker:VM/SESSION" caller row, else None."""
    if not caller.startswith("broker:"):
        return None
    return caller[len("broker:"):].split("/", 1)[0] or None


def sweep_tally(doc: dict, lane_vms: list[str]) -> dict:
    """The host sweep's sum over the hosts whose spend was read, with every host and lane VM it does not cover named
    (unread, with why) and the account's own count beside it (unattributed). Each lane VM is counted once: in a read
    broker host's broker:VM rows; a broker client (this host, a VM) is added from its own log only when no read host
    has a broker row for it; a VM in neither is unread, never absent."""
    hosts = doc.get("hosts") or {}
    rest = gql = 0
    read: list[str] = []
    unread: dict[str, str] = {}
    brokered: dict[str, str] = {}  # VM -> the read host whose broker rows carry it
    for host, h in hosts.items():
        if h.get("ok") and not h.get("unread"):
            for c in h.get("callers") or []:
                vm = broker_vm(str(c.get("caller", "")))
                if vm:
                    brokered.setdefault(vm, host)
    for host, h in hosts.items():
        if not h.get("ok"):
            unread[host] = h.get("error") or "unreachable"
            continue
        if h.get("unread"):
            unread[host] = h["unread"]
            continue
        read.append(host)
        if h.get("brokerClient") and host in brokered:
            continue  # already in brokered[host]'s broker:VM rows
        rest += h.get("rest") or 0
        gql += h.get("graphql") or 0
    vm_read: list[str] = []
    vm_why: dict[str, str] = {}
    for vm, h in (doc.get("laneVmRows") or {}).items():
        if vm in brokered or vm in hosts:
            continue  # counted in a read host's broker:VM rows or as a host: never twice
        if not h.get("ok") or h.get("unread"):
            vm_why[vm] = f"no broker:{vm} row on any read host, and its own log was not read: " \
                + str(h.get("error") or h.get("unread") or "unreachable")
            continue
        vm_read.append(vm)
        rest += h.get("rest") or 0
        gql += h.get("graphql") or 0
    covered = set(read) | set(brokered) | set(vm_read)
    vms_unread = {vm: vm_why.get(vm) or "no broker:" + vm + " row on any read host (idle, or its broker host is unread)"
                  for vm in lane_vms if vm not in covered and vm not in unread}
    out: dict[str, Any] = {"rest": rest, "graphql": gql, "hosts": len(hosts), "read": read, "unread": unread,
                           "laneVms": {"brokered": brokered, "read": vm_read, "unread": vms_unread},
                           "lowerBound": bool(unread or vms_unread)}
    gaps: dict[str, Any] = {}
    for bucket, spent in (("rest", rest), ("graphql", gql)):
        r = (doc.get("account") or {}).get(bucket)
        if not r:
            gaps[bucket] = None
            continue
        used = int(r["limit"]) - int(r["remaining"])
        gaps[bucket] = {"used": used, "attributed": spent, "unattributed": used - spent, "reset": r.get("reset"),
                        "host": r.get("host")}
    out["unattributed"] = gaps
    return out


def fleet_budget(now: float | None = None, fetch: Callable[[str, bool], dict] | None = None,
                 view: Callable[[], dict] | None = None, free: Callable[[float], dict] | None = None) -> dict:
    """Who spent the login's quota this hour, per host and session, with the account's reading and the hard reserve:
    the FLEET_BUDGET_FILE answer when it is under FLEET_BUDGET_TTL old, else spend_view, else one read per host (all
    at once). One reader at a time under a lock, so sessions asking together share one read."""
    fetch, view = fetch or fetch_host, view or spend_view
    path = BASE / FLEET_BUDGET_FILE
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(BASE / "fleet-budget.lock", "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        clock = time.time() if now is None else now
        cached = read_json(path)
        kept = cached.get("keptFrom", cached.get("at")) if isinstance(cached, dict) else None
        if isinstance(kept, (int, float)) and not isinstance(kept, bool) and 0 <= clock - kept < FLEET_BUDGET_TTL:
            return budget_served(cached, clock)
        doc: dict[str, Any] = {"at": clock, "thisHost": policy_host(), "hardReserve": hard_reserve()}
        try:
            seen = view()
        except Exception as error:  # the view is never the command failing
            seen = {"ok": False, "error": f"lane-gh spend_view: {type(error).__name__}"}
        if seen.get("ok"):
            doc.update(source="spend_view", view=seen["data"])
        else:
            doc.update(source="hosts", spendView=seen.get("error"), **host_sweep(clock, fetch, free))
        # when the read ended, by the wall clock read then (router review of glaeda#2252, F2: a start time plus a
        # monotonic length put it past the real end after a backward clock step)
        doc["keptFrom"] = FLEET_BUDGET_CLOCK()
        write_json(path, doc)
        return doc


def budget_served(doc: dict, clock: float) -> dict:
    """A kept host-sweep answer as of CLOCK: an account reading whose window reset since it was read is dropped, with
    its pool's unattributed gap (the gap is that reading's used count less what the hosts' logs hold); a gh-quota mark
    whose "until" passed is dropped by itself. Router review of glaeda#2252, F1: a 75 s sweep that crossed a reset kept
    showing "0/5000 left" from the window that had ended for another minute. Each on its own clock (review of
    glaeda#2253, F1): a short retry mark ending used to drop its pool's still-current reading and gap too."""
    account, marks = dict(doc.get("account") or {}), dict(doc.get("exhausted") or {})
    reset = {b for b, r in account.items() if not isinstance(r, dict) or float(r.get("reset") or 0) <= clock}
    ended = {b for b, m in marks.items() if not isinstance(m, dict) or float(m.get("until") or 0) <= clock}
    if not reset and not ended:
        return doc
    out = {**doc, "account": {b: r for b, r in account.items() if b not in reset},
           "exhausted": {b: m for b, m in marks.items() if b not in ended},
           # named, so `budget` says the kept answer's window has ended rather than reporting the sweep's host
           # answers, which were about a window that is over (account_unknown)
           "accountDropped": sorted(reset)}
    total = doc.get("total")
    if reset and isinstance(total, dict) and isinstance(total.get("unattributed"), dict):
        out["total"] = {**total, "unattributed": {b: None if b in reset else g
                                                  for b, g in total["unattributed"].items()}}
    return out


def hhmm(epoch: Any) -> str:
    return dt.datetime.fromtimestamp(float(epoch), dt.timezone.utc).strftime("%H:%MZ") \
        if isinstance(epoch, (int, float)) else "?"


POOL_NAMES = {"rest": "REST", "graphql": "GraphQL"}
# Where settle_counters keeps each bucket's live counters; rest_counters(budget, key) reads them.
COUNTER_KEYS = {"rest": "restCounters", "graphql": "graphqlCounters"}


def view_lines(view: dict) -> list[str]:
    """spend_view's answer as `budget` lines: each pool against GitHub's count, then hosts, sessions, lane VMs."""
    out = [f"account (the shared login, every host; lane-gh spend_view at {view.get('at', '?')}):"]
    for p in view.get("pools") or []:
        if not isinstance(p, dict):
            continue
        counters = [c for c in p.get("counters") or [] if isinstance(c, dict)]
        left = "; ".join(f"{c.get('remaining')}/{c.get('limit')} left in {c.get('window')} "
                         f"(read {c.get('reading_age_s', '?')} s ago{', ' + ','.join(c['tags']) if c.get('tags') else ''})"
                         for c in counters) or "no reading of GitHub's count"
        used = p.get("used")
        acct = (f"GitHub counted {used}, the hosts' logs hold {p.get('attributed')} ({p.get('accounted_pct')}%), "
                f"{p.get('unaccounted')} in no host's log") if used is not None \
            else f"the hosts' logs hold {p.get('attributed')} in {p.get('since')} .. {p.get('until')}"
        out.append(f"  {POOL_NAMES.get(p.get('pool'), p.get('pool'))}: {left}; {acct}")
    out.append("by host (the window; a broker client's calls are in its broker host's broker:VM rows):")
    for h in view.get("hosts") or []:
        if isinstance(h, dict) and not isinstance(h.get("rest"), int):  # no count is unread, never 0
            out.append(f"  {str(h.get('host')):<22} unread ({h.get('note') or h.get('source') or 'no count'})")
        elif isinstance(h, dict):
            out.append(f"  {str(h.get('host')):<22} REST {h.get('rest', 0):>5}  GraphQL {h.get('graphql', 0):>5}  "
                       f"search {h.get('search', 0):>3}  {h.get('source', '')}, {int(h.get('age_s') or 0) // 60} min old"
                       + (f"; {h['note']}" if h.get("note") else ""))
    for key, total, label in (("sessions", "sessions_total", "top sessions and callers"),
                              ("lane_vm_sessions", "lane_vm_sessions_total",
                               "lane VM sessions (through a broker; already in its broker:VM rows, not added again)")):
        rows = [r for r in view.get(key) or [] if isinstance(r, dict)]
        out.append(f"{label} ({len(rows)} of {view.get(total, len(rows))}):")
        for r in rows:
            out.append(f"  {str(r.get('host')):<18} {str(r.get('caller')):<44} REST {r.get('rest', 0):>5}  "
                       f"GraphQL {r.get('graphql', 0):>5}")
    apps = [a for a in view.get("app_pools") or [] if isinstance(a, dict)]
    if apps:
        out.append("App installation pools (their own quota, not the login's): " + "; ".join(
            f"{a.get('name')} {a.get('remaining', '?')}/{a.get('limit', '?')}" for a in apps))
    silent = [h for h in view.get("silent_hosts") or [] if isinstance(h, dict)]
    if silent:
        out.append("hosts on the login whose spend is not here (their calls are in the unaccounted remainder):")
        for h in silent:
            out.append(f"  {h.get('host')}: {h.get('why')}; reports: {h.get('report')}")
    for gap in (view.get("gaps") or [])[:10]:
        out.append(f"not seen: {gap}")
    for pool, label in (("rest", "REST"), ("graphql", "GraphQL")):
        rows = [r for r in (view.get("sessions") or [])
                if isinstance(r, dict) and isinstance(r.get(pool), int)]
        rows.sort(key=lambda r: (-r[pool], str(r.get("caller") or "?"), str(r.get("host") or "?")))
        total = sum(r[pool] for r in rows)
        top = ", ".join(f"{r.get('host', '?')}:{r.get('caller', '?')}={r[pool]}" for r in rows[:5]) or "none"
        out.append(f"ledger {label}: {total} listed session spend; top consumers {top}")
    return out


def sweep_lines(doc: dict) -> list[str]:
    """The host sweep's answer (spend_view unavailable) as `budget` lines."""
    account, marks = doc.get("account") or {}, doc.get("exhausted") or {}
    parts = []
    for bucket in ("rest", "graphql"):
        r = account.get(bucket)
        if r:
            parts.append(account_line(bucket, r, marks))
        elif marks.get(bucket):
            parts.append(f"{POOL_NAMES[bucket]} spent until {hhmm(marks[bucket].get('until'))} (gh-quota's mark here)")
        else:
            parts.append(f"{POOL_NAMES[bucket]} {account_unknown(bucket, doc)}")
    out = ["account (the shared login, every host): " + "; ".join(parts),
           f"{doc.get('spendView') or 'lane-gh spend_view unavailable'}; read each host instead",
           "who spent it, last hour, per host and caller (REST counted; 304s and cache, mirror or glaeda answers are "
           "free and not counted):"]
    tally = doc.get("total") if isinstance(doc.get("total"), dict) else sweep_tally(doc, [])
    brokered = (tally.get("laneVms") or {}).get("brokered") or {}
    for host, h in (doc.get("hosts") or {}).items():
        mine = " (this host)" if host == doc.get("thisHost") else ""
        if not h.get("ok"):
            out.append(f"  {host}{mine}: unread ({h.get('error') or 'unreachable'})")
            continue
        if h.get("unread"):
            out.append(f"  {host}{mine}: unread ({h['unread']}); not summed")
            continue
        if h.get("brokerClient"):
            mine += (f" (a broker client: in {brokered[host]}'s broker:{host} rows, so not added below)"
                     if host in brokered else
                     " (a broker client: no read host has a broker:" + host + " row, so its own log is added below)")
        free = f"free: {h.get('notModified', 0)} daemon 304s, {h.get('served', 0)} served from a cache"
        out.append(f"  {host}{mine}: REST {h.get('rest', 0)}, GraphQL {h.get('graphql', 0)} ({free})")
        callers = h.get("callers") or []
        for c in callers[:FLEET_CALLERS_TOP]:
            out.append(f"    {c['caller']:<40} REST {c['rest']:>5}  GraphQL {c['graphql']:>5}"
                       + (f"  ({c['served']} free)" if c.get("served") else ""))
        rest_of = callers[FLEET_CALLERS_TOP:]
        if rest_of:
            out.append(f"    ... {len(rest_of)} more callers: REST {sum(c['rest'] for c in rest_of)}, "
                       f"GraphQL {sum(c['graphql'] for c in rest_of)}")
    for vm in (tally.get("laneVms") or {}).get("read") or []:
        h = (doc.get("laneVmRows") or {}).get(vm) or {}
        out.append(f"  {vm} (a lane VM no read host's broker rows carry: its own log): REST {h.get('rest', 0)}, "
                   f"GraphQL {h.get('graphql', 0)}")
        for c in (h.get("callers") or [])[:FLEET_CALLERS_TOP]:
            out.append(f"    {c['caller']:<40} REST {c['rest']:>5}  GraphQL {c['graphql']:>5}")
    unread = tally.get("unread") or {}
    vms_unread = (tally.get("laneVms") or {}).get("unread") or {}
    if vms_unread:
        out.append(f"  lane VMs unread ({len(vms_unread)}: no broker:VM row on any read host; idle, or its broker host "
                   f"is unread): {', '.join(vms_unread)}")
        for vm, why in vms_unread.items():
            if "its own log was not read" in why:
                out.append(f"    {vm}: {why}")
    read_n, hosts_n = len(tally.get("read") or []), tally.get("hosts", 0)
    names = ", ".join(unread) + ("; " if unread and vms_unread else "") \
        + (f"{len(vms_unread)} lane VMs" if vms_unread else "")
    out.append(f"  read hosts together: REST {tally.get('rest', 0)}, GraphQL {tally.get('graphql', 0)} "
               f"({read_n} of {hosts_n} hosts read"
               + (f"; unread: {names}; a lower bound)" if tally.get("lowerBound") else ")"))
    gaps = tally.get("unattributed") or {}
    parts = []
    for bucket in ("rest", "graphql"):
        g = gaps.get(bucket)
        if not isinstance(g, dict):
            parts.append(f"{POOL_NAMES[bucket]} unknown (no fresh reading of the account's count)")
        elif g["unattributed"] >= 0:
            parts.append(f"{g['unattributed']} {POOL_NAMES[bucket]} (GitHub counted {g['used']} in the window to "
                         f"{hhmm(g.get('reset'))}, the read hosts' logs hold {g['attributed']})")
        else:
            parts.append(f"0 {POOL_NAMES[bucket]} (the read hosts' last hour holds {-g['unattributed']} more than "
                         f"GitHub's window to {hhmm(g.get('reset'))} counted, {g['used']}: the windows differ)")
    out.append("  unattributed: " + "; ".join(parts))
    for pool, label in (("rest", "REST"), ("graphql", "GraphQL")):
        rows = []
        for host, report in (doc.get("hosts") or {}).items():
            if not isinstance(report, dict) or not report.get("ok") or report.get("unread"):
                continue
            if report.get("brokerClient") and host in brokered:
                continue
            for caller in (report.get("callers") or []) if isinstance(report, dict) else []:
                if isinstance(caller, dict) and isinstance(caller.get(pool), int):
                    rows.append({"caller": f"{host}:{caller.get('caller', '?')}", pool: caller[pool]})
        rows.sort(key=lambda r: (-r[pool], r["caller"]))
        top = ", ".join(f"{r['caller']}={r[pool]}" for r in rows[:5]) or "none"
        out.append(f"ledger {label}: {sum(r[pool] for r in rows)} listed host spend; top consumers {top}")
    return out


def fleet_lines(doc: dict) -> list[str]:
    """`budget`'s cross-host section, from fleet_budget's answer."""
    reserve = doc.get("hardReserve") or {}
    out = view_lines(doc["view"]) if doc.get("source") == "spend_view" and isinstance(doc.get("view"), dict) \
        else sweep_lines(doc)
    out.insert(1 if doc.get("source") != "spend_view" else len(out),
               f"hard reserve: {reserve.get('rest', '?')} REST, {reserve.get('graphql', '?')} GraphQL kept for lands "
               f"({reserve.get('source', '?')})")
    out.append(f"(read {age(doc.get('at'))}; kept {FLEET_BUDGET_TTL:g} s for every session; --local for this host's "
               f"daemon only)")
    return out


def account_bucket(bucket: str, now: float | None = None) -> dict:
    """The shared login's reading for one bucket ("rest" or "graphql") as `budget` reports it, for any caller that
    needs to name the bucket a read spends and when it resets. The wait side's stale trigger is the caller this is
    for: it prints "the daemon has not refreshed <ref> for 1800s" and then names the identical failed invocation as
    the next step, because it has no bucket reading to name. Answers from fleet_budget's kept sweep (one sweep per
    FLEET_BUDGET_TTL shared by every session on the host, whose last route is a free GET /rate_limit), so a poll may
    call it and it spends no quota in any case.

    {"bucket", "remaining", "limit", "reset", "seenAt", "ageS", "host", "route", "spent", "hardReserve", "says"} when
    the bucket could be read, else {"bucket", "unknown"} carrying the same sentence `budget` prints -- who was asked,
    what each answered and the one next step. "mark" is gh-quota's own hold on this host when it has one."""
    clock = time.time() if now is None else now
    doc = fleet_budget(clock)
    reserve = (doc.get("hardReserve") or {}).get(bucket)
    out = {"bucket": bucket, "mark": (doc.get("exhausted") or {}).get(bucket), "hardReserve": reserve}
    r = (doc.get("account") or {}).get(bucket)
    if not isinstance(r, dict):
        return {**out, "unknown": account_unknown(bucket, doc)}
    seen = float(r.get("seenAt") or clock)
    left = r.get("remaining")
    return {**out, "remaining": left, "limit": r.get("limit"), "reset": r.get("reset"), "seenAt": seen,
            "ageS": max(0.0, round(clock - seen, 1)), "host": r.get("host"), "route": r.get("route"),
            "spent": isinstance(left, int) and left <= 0,
            "says": account_line(bucket, r, doc.get("exhausted") or {})}


def cmd_budget(as_json: bool, fleet: bool = False) -> int:
    running = daemon_running(grace=DOWN_GRACE)
    budget = read_json(BASE / "budget.json") or {}
    status = read_json(BASE / "daemon.json") or {}
    lag = daemon_stale() if running else None
    broken = daemon_failing() if running else None
    watching = sum(1 for p in watch_dir().glob("*.json") if not (read_json(p) or {}).get("dormant")) \
        if watch_dir().is_dir() else 0
    spread = fleet_budget() if fleet else None
    if as_json:
        doc = {"daemon": running, "stale": lag is not None, "failing": broken is not None,
               "budget": budget, "watching": watching, "last": status,
               "controllerFallback": read_json(BASE / CONTROLLER_FALLBACK_FILE) or {},
               "healthy": running and lag is None and broken is None and not isinstance(status.get("stalled"), dict),
               # buckets whose reading's reset has passed: their "remaining" is unknown now, not what it says
               "resetPassed": [b for b in ("rest", "graphql") if isinstance(budget.get(b), dict)
                               and isinstance(budget[b].get("reset"), (int, float))
                               and budget[b]["reset"] <= time.time()]}
        if spread is not None:
            doc["fleet"] = spread
        print(json.dumps(doc, sort_keys=True))
    else:
        for line in fleet_lines(spread) if spread is not None else []:
            print(line)
        if spread is not None:
            print(f"this host's daemon ({policy_host()}):")
        print(f"daemon: {'running' if running else 'NOT RUNNING'}, watching {watching}, "
              f"last heartbeat {age(status.get('at'))}")
        stalled = status.get("stalled")
        if running and isinstance(stalled, dict):
            why = ("the quota explains it" if stalled.get("explained")
                   else "nothing explains it: the daemon restarts itself (stale valve)")
            print(f"NOT HEALTHY: no PR refreshed for {stalled.get('age', '?')}s (over {STALE_DATA_AFTER}s) though the "
                  f"heartbeat is fresh; {why}")
        down = status.get("graphqlDown")
        if running and isinstance(down, dict) and isinstance(down.get("until"), (int, float)):
            until = dt.datetime.fromtimestamp(down["until"], dt.timezone.utc)
            print(f"GraphQL is out (5xx answers) until {until:%H:%M:%SZ}: its reads go to REST meanwhile "
                  f"(strike {down.get('strikes', '?')})")
        for bucket in ("rest", "graphql"):
            b = budget.get(bucket)
            if not b:
                print(f"{bucket:<8} not seen yet")
                continue
            reset = b.get("reset")
            if isinstance(reset, (int, float)) and not isinstance(reset, bool) and reset <= time.time():
                # the window this reading counted has ended: what is left now is unknown, never its old "0 left"
                print(f"{bucket:<8} unknown: reset passed {hhmm(reset)}, not read since "
                      f"(last reading {age(b.get('seenAt'))})")
                continue
            when = dt.datetime.fromtimestamp(reset, dt.timezone.utc).strftime("%H:%M:%SZ") if reset else "?"
            rate = (status.get("perMinute") or {}).get(bucket)
            spend = f", {rate}/min to spend until then" if isinstance(rate, (int, float)) and rate >= 0 else ""
            print(f"{bucket:<8} {b.get('remaining')}/{b.get('limit')} left, resets {when}{spend}, seen {age(b.get('seenAt'))}")
            # Both buckets answer from two counters with their own windows (settle_counters), and GET /rate_limit
            # reports only one of them, so a reader who cross-checks this line against /rate_limit can see a rich
            # counter while the one their reads actually spend is at zero -- 2026-11-21: `budget` said GraphQL 0 left
            # resetting 11:38Z while /rate_limit said 4751 left resetting 12:02Z, and four parked waits were stopped
            # as "stale" on the strength of it. Both were true. Name every live counter for GraphQL too, so the split
            # is visible here instead of looking like a disagreement between two tools.
            counters = [c for c in rest_counters(budget, COUNTER_KEYS[bucket]) if c["reset"] > time.time()]
            if len(counters) > 1:
                label = "core" if bucket == "rest" else POOL_NAMES[bucket]
                print(f"         {label} counters (the poorest is the one above, and the one a read is refused "
                      f"against): " + "; ".join(
                    f"{c['remaining']}/{c.get('limit')} until "
                    f"{dt.datetime.fromtimestamp(c['reset'], dt.timezone.utc).strftime('%H:%M:%SZ')}" for c in counters))
        paths, reads = status.get("paths"), status.get("reads")
        if isinstance(paths, dict):
            name = {"graphql": "GraphQL", "rest": "REST"}
            print("reading: " + ", ".join(f"{label} over {name.get(paths.get(kind), '?')}" for kind, label in
                                          (("pr", "PRs"), ("run", "runs"), ("comment", "comments")))
                  + " (each goes to the richer bucket for the time left until its reset)")
            if isinstance(reads, dict):
                print("reads in the last hour: " + "; ".join(
                    f"{label} {(reads.get(kind) or {}).get('graphql', 0)} GraphQL / {(reads.get(kind) or {}).get('rest', 0)} REST"
                    for kind, label in (("pr", "PRs"), ("run", "runs"), ("comment", "comments"), ("head", "heads"))
                    if kind in reads))
        oldest = status.get("oldestData")
        if isinstance(oldest, dict):
            def span(v: Any) -> str:
                return "-" if not isinstance(v, (int, float)) else f"{int(v)}s" if v < 120 else f"{int(v // 60)}m"
            batch = status.get("batch") or {}
            print("oldest data of an open watch: " + ", ".join(
                f"{label} {span(oldest.get(kind))}" for kind, label in (("pr", "PRs"), ("run", "runs"), ("comment", "comments")))
                  + f" (GraphQL batch: {batch.get('pr', '?')} PRs, {batch.get('run', '?')} runs, "
                    f"{batch.get('comment', '?')} comment watches per query)")
        ledger = read_json(BASE / CONSUMERS_FILE)
        if isinstance(ledger, dict) and ledger.get("consumers"):
            print("head-read budget per hour (glaeda-gh checks --consumer NAME): " + "; ".join(
                f"{name} {c.get('spent', 0)}/{c.get('limit', '?')}{' reserved' if c.get('reserved') else ''}"
                + (f", refused {age(c['deniedAt'])}" if c.get("deniedAt") else "")
                for name, c in sorted(ledger["consumers"].items())))
        ctl = status.get("controller")
        if isinstance(ctl, dict):
            print(controller_line(ctl))
        fell_back = controller_fallback_line(read_json(BASE / CONTROLLER_FALLBACK_FILE))
        if fell_back:
            print(fell_back)
        hour = status.get("lastHour")
        if isinstance(hour, dict):
            print(f"daemon requests in the last hour: {hour.get('rest', 0)} REST, {hour.get('rest304', 0)} more "
                  f"REST answered 304 (free), {hour.get('graphql', 0)} GraphQL, "
                  f"{hour.get('free', 0)} rate_limit reads (free), {hour.get('write', 0)} REST for queued writes, "
                  f"{hour.get('kept', 0)} completed-attempt job lists answered from disk (no request)"
                  + (f", {hour['app']} REST on the {APP_POOL_ROLE} App (not the login)" if hour.get("app") else ""))
        pool = status.get("appPool")
        for pool in ([pool, *(pool.get("spares") or [])] if isinstance(pool, dict) else []):
            seen = pool.get("seen") if isinstance(pool.get("seen"), dict) else {}
            print(f"{pool.get('role', APP_POOL_ROLE)} App pool: {pool.get('served', 0)} reads served, "
                  f"{pool.get('fellBack', 0)} sent again on the login"
                  + (f", {seen.get('remaining')}/{seen.get('limit')} left" if seen.get("remaining") is not None else "")
                  + (f"; resting: {pool['why']}" if pool.get("resting") and pool.get("why") else ""))
        share = status.get("restShare")
        if isinstance(share, dict):
            print(f"daemon REST spend {share.get('spent', '?')}/{share.get('cap', '?')} this hour "
                  f"(restShare {share.get('share', '?')}"
                  + ("; at the cap, so REST is lean and PRs and runs read over GraphQL)" if share.get("capped") else ")"))
        for line in spend_lines(status.get("spendBy")):
            print(line)
        for name, alarm in sorted((status.get("alarms") or {}).items()):
            if isinstance(alarm, dict) and not alarm.get("cleared"):
                print(f"alarm {name} ({alarm.get('level')}, sent {age(alarm.get('at'))}): {alarm.get('text')}")
        if status.get("errors"):
            print("last errors: " + "; ".join(status["errors"][:3]))
        tail = refresh_log_tail()
        if tail:
            print(f"last refresh failures ({BASE / REFRESH_LOG}):")
            for line in tail:
                print("  " + line)
    if not running:
        say_waiting(down_message())
        return EXIT_DOWN
    if broken is not None:
        say_waiting(failing_message(broken))
        return EXIT_DOWN
    if lag is not None:
        say_waiting(stale_message(lag))
        return EXIT_DOWN
    return EXIT_OK


# ---------------------------------------------------------------- the gh broker
#
# `glaeda-gh gh ARG...` stands in front of the real `gh`. Every agent session on the account shares
# one 5000/h REST pool and one 5000/h GraphQL pool, and `gh` itself has no cache and no idea what
# the other sessions are doing: measured over 96,102 logged calls on one host, 22% of them re-read
# something another session had read within the previous 90 seconds and 7.5% read repository source
# through the API. The broker does four things and nothing else:
#
#   serve   `pr view --json` and `run view --json` from the daemon's cache when it is fresh enough
#           and covers every field asked for. The daemon already reads those in one batched query
#           for every watched PR at once, over whichever bucket is richer.
#   refuse  reading a repository's source through the API (contents, git/blobs, git/trees) when
#           that repository is checked out on this host. `git show` answers for nothing.
#   pass    everything else, unchanged: mutations, logs, anything unrecognised, and any read the
#           cache cannot cover completely.
#   route   a `pr view`/`run view` miss whose own bucket (GraphQL for pr view, REST for run view) is
#           spent while the other is not: registered with the daemon, which reads it over the
#           other bucket, and served from that read if it lands within BROKER_SPENT_WAIT.
#
# Serving is deliberately timid, because a wrong answer is far worse than a spent request. A call
# is served only when every flag on it is one of a short per-subcommand list: an unknown flag means
# the broker does not know what the caller asked for, so it does not answer. `gh run view ID
# --attempt 2` and `--exit-status` are the shape of that hazard -- the cache holds the latest
# attempt and always exits 0, so answering either would be wrong, and they pass through instead.
#
# A second read of the same target within BROKER_REPEAT seconds registers a watch, so the daemon
# starts covering it and the third read is free; a target read once is never watched. A read that
# is about to spend a request on something this caller just read is held for
# CMUX_GH_MIN_REPEAT_SECONDS first -- the cmuxterm-hq PATH guard's rule, applied here because only
# this side knows whether the call costs anything; a served read never waits. Every path
# fails open: an error anywhere in the broker execs the real `gh`, because a wrapper around `gh` is
# never allowed to be the reason a call fails. A refusal exits 2, and GLAEDA_GH_ALLOW_API_SOURCE=1
# passes one of those through. Exit 127 is the broker's own refusal to run: no real gh on PATH,
# a chain that has been through here BROKER_MAX_HOPS times, or an exec that failed.

BROKER_MAX_AGE = 90.0  # cache entries older than this are not served (the daemon's cycle is 60 s)
BROKER_LEAN_AGE = 600.0  # below the floor, stale data beats spending the last of the quota
BROKER_REPEAT = 600.0  # a target read twice this far apart is worth watching
# The API gh itself spends on each brokered read: `pr view` is GraphQL, `run view` is REST. When
# that bucket is spent, a cache miss passed to gh is a 403, while the daemon can still read the same
# target over the other bucket (it reads each kind from whichever is richer). So the miss is handed
# to the daemon instead, and the call waits up to BROKER_SPENT_WAIT for its first read: a new watch
# is filled within one TICK.
BROKER_GH_BUCKET = {"pr": "graphql", "run": "rest"}
BROKER_SPENT_WAIT = 15.0
BROKER_SEEN_KEEP = 2000  # targets remembered for repeat detection
BROKER_LOG_MAX = 8 * 1024 * 1024  # the decision log is rotated once past this
# The call log is rotated too, and far later: it is the audit's whole input, and the audit reads
# the rotated file as well, so the window it reports spans a rotation. Uncapped it reached 117 MB
# on cosmic-gray, and nothing was ever going to shorten it.
GUARD_LOG_MAX = 64 * 1024 * 1024
BROKER_EXIT_REFUSED = 2
BROKER_EXIT_NO_GH = 127
# What `glaeda-gh gh --probe` answers with. A wrapper in front of gh delegates only to a broker
# that passes the probe, so everything in this block is part of one contract: serving, the
# refusal, the hop count, the shared log line, and the repeat delay below. Bump it when any of
# those changes in a way a wrapper can see: the log line's shape, the meaning of an exit code, the
# env vars read or exported across the hand-off, or the probe's own output. Adding a served field
# or a refused path does not need a bump -- a wrapper cannot tell.
BROKER_CONTRACT = 2  # 2: the hand-off env changed (see BROKER_MARK, BROKER_DEPTH)
BROKER_MARK = "GLAEDA_GH_BROKERED"  # "count:pid" -- this call's own history, across an exec
BROKER_MIN_REPEAT = 30.0  # seconds between two identical reads that would each spend quota
BROKER_MAX_HOPS = 2  # this broker, plus one wrapper it could not recognise. Past that, refuse.
# Two counters, because a wrapper loop comes in two shapes and one counter cannot bound both.
#
# BROKER_MARK is scoped to a pid: an exec keeps the pid, so a call handed straight back here still
# carries its own history, while a `gh` that gh *spawns* (an extension, an alias, a $EDITOR hook)
# starts a fresh call rather than inheriting its parent's count and eventually being refused for a
# loop that does not exist. That is what it is for, and it is why it cannot bound the other shape:
# a wrapper that *forks* `gh` instead of exec'ing it gets a new pid every generation, so a
# pid-scoped count resets to one forever and the chain never ends.
#
# BROKER_DEPTH is therefore unscoped and counts generations whatever the wrapper does. The bound is
# loose on purpose: a real extension or editor chain is two or three deep and must never notice it,
# while a loop reaches it in under a second.
#
# Both counters live in the environment, so neither survives a wrapper that clears it: with a `gh`
# on PATH whose body is `exec env -i PATH="$PATH" gh "$@"` -- the shape of `sudo -i` or a
# login-shell wrapper -- the chain ran as long as it was left alone, every generation reporting
# mark=1 depth=1. That is not a hole in the counters; no env-carried count can cross `env -i`. It
# is a limit worth stating rather than claiming these two bound every chain. Nothing env-carried
# closes it -- the hq guard's own CMUX_GH_GUARD_DEPTH is cleared by the same wrapper -- so what
# would is a mark in the state dir, keyed by caller and wall clock. Not built: a wrapper that
# sanitises the environment around `gh` has not been seen on these hosts, and the two counters
# cover both shapes that have.
BROKER_DEPTH = "GLAEDA_GH_DEPTH"
BROKER_MAX_DEPTH = 8
BROKER_REPOS_TTL = 600.0
# How long the checkout scan behind the refusal may take. It is the one thing here that walks the
# filesystem, it runs in front of a real gh call, and 2.4 s cold on 6566 directories is the good
# case -- a root on a hung mount is the bad one. Generous enough that the scan normally finishes.
BROKER_SCAN_DEADLINE = 5.0
BROKER_ROOTS = ("~/Projects", "~/wt", "~/.cmux/worktrees")
# Long flags that take a separate value. Only needed to keep that value out of the positional
# words; a flag not on the safe list below stops the call from being served either way.
BROKER_VALUE_FLAGS = {
    "-R", "--repo", "-X", "--method", "-H", "--header", "-F", "--field", "-f", "--raw-field",
    "-q", "--jq", "-t", "--template", "--json", "--input", "--cache", "--hostname", "--interval",
    "-L", "--limit", "-B", "--base", "--head", "-S", "--search", "--state", "--author",
    "--assignee", "--label", "-l", "-b", "--body", "--body-file", "--title", "--attempt", "--job",
}
# Short flags whose value may be glued on (`-Ro/r`) as well as separate. Cobra accepts both, and
# reading `-Ro/r` as a positional word once served another repository's PR under its number. Taken
# from the list above rather than written out again, so the two cannot disagree.
BROKER_SHORT_VALUE = "".join(sorted(f[1] for f in BROKER_VALUE_FLAGS if len(f) == 2))
# A short flag and the long spelling of the same flag, so a later one wins as cobra has it
# (`-R a/b --repo c/d` is c/d) and the safe list below can name one spelling.
BROKER_FLAG_ALIAS = {"-R": "--repo", "-X": "--method"}
# The only flags a served call may carry. Anything else -- `--jq`, `--template`, `--web`,
# `--attempt`, `--job`, `--exit-status`, or a flag gh adds next year -- means pass it on.
BROKER_SAFE_FLAGS = {"--repo", "--json"}
# Flags that keep a read from being served but not from being counted toward a watch. A `--jq`
# read prints gh's filtered output, which the broker does not compute, so it always goes to gh; but
# it asks about the same PR or run with the same `--json` fields, so a watch on that target answers
# the next plain `--json` read and keeps gh_cache_watch's copy current. Until 2026-11-14 such a
# read was never counted, and a PR polled only with `--jq` was never watched.
BROKER_COUNT_ONLY_FLAGS = {"--jq", "-q"}
# Not github.com: the daemon's cache is github.com's, and an enterprise host has its own PR 7.
BROKER_GITHUB_HOSTS = {"github.com", "www.github.com", "api.github.com"}
# gh `pr view --json FIELD` -> (key in a cached PR entry, the Go type gh prints it as). gh renders a
# null string field as "", and a null time as null.
#
# A field is here only when every source the daemon reads a PR from fills it. A PR entry has two
# writers (fetch_pr_rest and the GraphQL read behind fetch_aliased) and a run entry has three, and
# some of them leave a key None to mean "this source does not carry it", which is not the same as
# GitHub answering null: serving the second as the first prints a confident wrong answer. `reviewDecision` is the dangerous one -- fetch_pr_rest keeps GraphQL's
# last value (REST has no equivalent), so it is None until some GraphQL read fills it, and stale
# afterwards however fresh `dataAt` looks. Printing "" there says "nobody has reviewed this" for a
# PR that is CHANGES_REQUESTED, which is exactly the answer a lane must not get wrong.
BROKER_PR_FIELDS = {
    "number": ("number", "int"), "url": ("url", "str"), "title": ("title", "str"),
    "state": ("state", "str"), "isDraft": ("isDraft", "bool"), "mergeable": ("mergeable", "str"),
    "mergeStateStatus": ("mergeStateStatus", "str"), "headRefOid": ("headRefOid", "str"),
    "headRefName": ("headRefName", "str"),
    "updatedAt": ("updatedAt", "time"), "mergedAt": ("mergedAt", "time"),
}
# gh `run view --json FIELD` -> the same, over slim_run's REST names. Four are missing for the
# reason above. REST's `name` is the run-name when a workflow sets one and GraphQL's is the
# workflow name, so `name` and `workflowName` could not be answered consistently; and
# `controller_run` has no `display_title` or `created_at` in the webhook record and an empty
# `head_branch` when the delivery omits it, so `displayTitle`, `createdAt` and `headBranch` are
# None or "" for any run the controller's feed is tracking.
BROKER_RUN_FIELDS = {
    "databaseId": ("id", "int"),
    "status": ("status", "str"), "conclusion": ("conclusion", "str"), "url": ("html_url", "str"),
    "headSha": ("head_sha", "str"), "event": ("event", "str"),
    "attempt": ("run_attempt", "int"),
    "updatedAt": ("updated_at", "time"),
}
# What automation pivots on: a push, a rerun, a merge or a ready-for-review changes these, and
# acting on a stale one means waiting on a superseded head, calling a run green, or reading a
# merged PR as open. The lean horizon never covers them. `updatedAt` is the mutation clock itself,
# so anything using it as a change detector would be told "nothing changed" for the whole horizon.
BROKER_LIVE_FIELDS = {"headRefOid", "conclusion", "status", "state", "attempt",
                      "mergeStateStatus", "mergeable", "mergedAt", "isDraft", "updatedAt"}
# The other half of the same decision, and the reason it is written down rather than implied: a
# served field that is in neither set is served stale under the lean horizon, and nothing noticed.
# Adding `merged` to BROKER_PR_FIELDS and leaving it unclassified served `{"merged": false}` from
# a ten-minute-old entry for a PR that had merged, with every test green. A test asserts these two
# sets cover the tables exactly, so a new served field cannot be added without classifying it.
# Stable means a change here costs nothing a lane pivots on: a number and a URL are fixed for the
# life of the object, a run's event and head sha are fixed when it is created, and a title or a
# branch name read a few minutes late is not an answer anything acts on.
BROKER_STABLE_FIELDS = {"number", "url", "title", "headRefName", "databaseId", "headSha", "event"}
BROKER_SOURCE_RE = re.compile(
    rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/(contents/|git/(?:blobs|trees)/)")
BROKER_RAW_RE = re.compile(rf"^https?://raw\.githubusercontent\.com/({NAME})/({NAME})/")
# github.com has to be the *host* of the URL, not a substring of it. Unanchored, this read
# `https://notgithub.com/o/r`, `https://gitlab.com/mirror/github.com/o/r` and
# `/srv/mirrors/github.com/o/r` as github.com's `o/r` -- a mirror's checkout offered as the
# upstream repository's, which is the one thing broker_repo's one-remote rule exists to prevent.
# The two forms are a URL with a scheme and git's scp-like `[user@]host:path`; a userinfo part
# (`https://user:token@github.com/o/r`) belongs to either.
# Split in two, because matching the whole URL in one pattern could only answer "understood" or
# "not mine", and those are different answers: a github URL whose shape is not understood has to
# poison the whole config (see broker_remotes), while another forge's is simply skipped.
# The userinfo part runs to the *last* `@` of the authority, and the host holds none: with the
# userinfo stopping at the first `@` and the host group permitting one,
# `https://user@name@github.com/cli/cli` read its host as `name@github.com`, which is not github's,
# so the remote was skipped -- and a skipped remote is a subset, which is what broker_remotes
# exists to prevent. An embedded-credential remote whose password contains `@` is all it takes.
# git hands the whole authority to curl or to ssh, both of which take the last `@` (measured: git
# 2.53.0 runs `ssh ... a@b@github.com` for `ssh://a@b@github.com/o/r`), and gh parses it with
# net/url, which does the same.
BROKER_URL_HOST_RE = re.compile(r"^(?:https?|git|ssh)://(?:[^/\s]*@)?([^/:@\s]+)(?::\d+)?(/.*)?$",
                                re.IGNORECASE)
# The scp-like form splits at the first colon, so its userinfo cannot cross one: for
# `user:pw@github.com:o/r` git runs `ssh user git-upload-pack 'pw@github.com:o/r'` -- the host is
# `user` and github.com is part of the path. Reading that as github's `o/r` would serve a
# repository git does not even clone from.
BROKER_SCP_HOST_RE = re.compile(r"^(?:[^/:\s]*@)?([^/:@\s]+):(.*)$")
BROKER_REPO_PATH_RE = re.compile(rf"^({NAME})/({NAME}?)(?:\.git)?/?$")
# Hosts whose `OWNER/REPO` the daemon's github.com cache answers for. `api.github.com` is in
# BROKER_GITHUB_HOSTS because gh's hosts.yml names it; it is not a clone host, so a remote
# pointing there is a shape we do not understand rather than one we serve.
BROKER_REMOTE_HOSTS = {"github.com", "www.github.com"}
# A git config is read by section, not scanned: see git_config_remote_urls. git accepts a key on
# the header's own line (`[remote "origin"] url = ...`), so group 3 is whatever follows the header,
# and the subsection may be quoted (`[remote "origin"]`) or dotted (`[remote.origin]`).
GIT_CONFIG_HEADER_RE = re.compile(r'^\[([^]"]*?)(?:\s+"((?:[^"\\]|\\.)*)")?\]\s*(.*)$')
GIT_CONFIG_SECTION_NAME_RE = re.compile(r"[A-Za-z0-9-]+")
# A key with no value is valid git (`[core] bare`), and is never a url.
GIT_CONFIG_KEY_RE = re.compile(r"^([A-Za-z][A-Za-z0-9-]*)\s*(?:=\s*(.*))?$")
GIT_CONFIG_ESCAPES = {"n": "\n", "t": "\t", "b": "\b", '"': '"', "\\": "\\"}
# GitHub's own credential shapes, never written to the shared log whatever slot they arrived in
BROKER_SECRET_RE = re.compile(r"gh[posur]_[A-Za-z0-9._-]{20,}|github_pat_[A-Za-z0-9_]{20,}", re.IGNORECASE)
# How long git may take to say what this checkout's remotes are. Two forks in front of a real gh
# call, so it is bounded like everything else here: a checkout on a hung mount declines, which
# costs one request, rather than hanging the call. Tighter than SUBPROCESS_DEADLINE because nothing
# is waiting on the answer except a decision to decline.
BROKER_GIT_DEADLINE = 5.0


def guard_log() -> Path:
    """The PATH guard's call log (cmuxterm-hq tools/local-build-guards/gh), so one audit covers
    every host. The guard writes it only when it has no broker to hand the call to; with the broker
    installed the broker is the one writer, and there is one format to read."""
    return Path(os.environ.get("CMUX_GH_LOG") or Path.home() / ".local/state/cmux-gh/calls.log")


def broker_log() -> Path:
    return BASE / "broker.jsonl"


def broker_seen_path() -> Path:
    return BASE / "broker-seen.json"


def broker_repos_path() -> Path:
    return BASE / "broker-repos.json"


def broker_words(args: list[str]) -> tuple[list[str], str, set[str], dict[str, str]]:
    """(positional words, HTTP method, flags present, flag values).

    A flag that takes a value consumes it, separately (`-R o/r`, `--json state`), glued
    (`-Ro/r`, `-XPOST`) or with `=` (`--json=state`), so no value is ever read as a positional
    word. A value flag given no value at all (`gh pr view 7 --json`, which gh rejects) is recorded
    as present with no value, so the call is never served. `flags present` names every flag seen,
    by its canonical spelling, including ones this does not know: the caller decides what to do
    about those."""
    words, method, seen, values = [], "GET", set(), {}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            words.extend(args[i + 1:])
            break
        if arg.startswith("--") and "=" in arg:
            name, value = arg.split("=", 1)
            name = BROKER_FLAG_ALIAS.get(name, name)
            seen.add(name)
            values[name] = value
        elif arg.startswith("--"):
            name = BROKER_FLAG_ALIAS.get(arg, arg)
            seen.add(name)
            if arg in BROKER_VALUE_FLAGS:
                if i + 1 < len(args):
                    values[name] = args[i + 1]
                    i += 1
                else:
                    # No value at all, so gh exits 1. An earlier occurrence's value must not stand
                    # in for it (`--json state ... --json`), or the broker answers a line gh rejects.
                    values.pop(name, None)
        elif arg.startswith("-") and arg != "-":
            # A short cluster, read as cobra reads it: its letters are boolean flags until one that takes a value,
            # which takes the rest of the word (`-Ro/r`, `-iXPOST`) or, at the word's end, the next word (`-iX POST`).
            for at, letter in enumerate(arg[1:], start=1):
                name = BROKER_FLAG_ALIAS.get(f"-{letter}", f"-{letter}")
                seen.add(name)
                if letter not in BROKER_SHORT_VALUE:
                    continue
                if at < len(arg) - 1:
                    values[name] = arg[at + 1:]
                elif i + 1 < len(args):
                    values[name] = args[i + 1]
                    i += 1
                else:
                    values.pop(name, None)  # `-R o/r ... -R`: gh exits 1, so never serve it
                break
        else:
            words.append(arg)
        i += 1
    if "--method" in values:
        method = values["--method"]
    elif {"-f", "--raw-field", "-F", "--field", "--input"} & seen:
        method = "POST"  # gh POSTs when it is given fields or a body, with no -X on the line
    return words, method.upper(), seen, values


def broker_local_repos(now: float | None = None) -> dict[str, str]:
    """owner/repo (lowercased) -> a checkout of it on this host. Built from the GitHub remote in each
    checkout's config under BROKER_ROOTS, at most two levels deep, and cached for BROKER_REPOS_TTL."""
    now = time.time() if now is None else now
    cached = read_json(broker_repos_path())
    if isinstance(cached, dict) and now - (cached.get("at") or 0) < BROKER_REPOS_TTL:
        found = cached.get("repos")
        if isinstance(found, dict):
            return found
    roots = [Path(p).expanduser() for p in
             (os.environ.get("GLAEDA_GH_REPO_ROOTS") or os.pathsep.join(BROKER_ROOTS)).split(os.pathsep) if p]
    found: dict[str, str] = {}
    # Bounded, because this runs in front of a real gh call. Two levels under three roots is 6566
    # candidate directories on this host and 2.4 s cold, each one a config read, and the TTL cache
    # bounds how *often* that happens but not how long it takes: a root on a hung mount hung the
    # call. This was the only step in the brokered path with no deadline, in a file that bounds
    # everything else. On expiry the partial map is used and not cached, so the next call tries
    # again -- and a map that is missing a repo only means the refusal declines and gh runs, which
    # is the safe direction.
    complete = True
    # Two bounds for one deadline, because each covers what the other cannot. The clock check
    # bounds the *loop* and works everywhere, including off the main thread where hard_deadline is
    # a documented no-op; SIGALRM is what interrupts a single read that is already blocked on a
    # hung mount, which no amount of checking between reads can reach. ScanDeadline rather than
    # DeadlineTimeout because this block's own frames catch OSError -- see ScanDeadline.
    deadline = time.monotonic() + BROKER_SCAN_DEADLINE
    try:
        with hard_deadline(BROKER_SCAN_DEADLINE, ScanDeadline):
            for root in roots:
                for depth in (1, 2):
                    try:
                        candidates = list(root.glob("/".join(["*"] * depth)))
                    except OSError:
                        continue
                    for d in candidates:
                        if time.monotonic() >= deadline:
                            raise ScanDeadline(f"no complete scan within {BROKER_SCAN_DEADLINE:g}s")
                        for owner_repo in broker_remotes(d):
                            if broker_better_checkout(d, found.get(owner_repo), owner_repo):
                                found[owner_repo] = str(d)
    except ScanDeadline:
        complete = False
    if complete:
        write_json(broker_repos_path(), {"at": now, "repos": found})
    return found


def broker_better_checkout(candidate: Path, current: str | None, owner_repo: str) -> bool:
    """Which checkout of `owner_repo` to name in a refusal. Glob order is arbitrary, and a host has
    many: the one whose directory is the repository's own name is the one the reader means, and
    failing that the shortest path (a clone, not a worktree or a one-off scratch copy)."""
    if current is None:
        return True
    name = owner_repo.split("/")[-1]
    return (candidate.name == name, -len(str(candidate))) > (Path(current).name == name, -len(current))


def git_config_text(checkout: Path) -> str | None:
    """A checkout's config file text. A worktree's `.git` is a file naming the common directory,
    where the config actually lives."""
    dot = checkout / ".git"
    try:
        if dot.is_dir():
            config = dot / "config"
        elif dot.is_file():
            gitdir = dot.read_text(errors="replace").strip()
            if not gitdir.startswith("gitdir:"):
                return None
            target = Path(re.sub(r"/worktrees/[^/]+/?$", "", gitdir.split(":", 1)[1].strip()))
            # git resolves a relative gitdir against the directory holding the `.git` file, not
            # against the process's cwd -- and relative is the shape it writes for a submodule and
            # for `git worktree add --relative-paths`. Resolving it against cwd read another
            # checkout's config: `gitdir: ../real/.git` from `a/inner` answered `wrong/repo` where
            # git answers `right/repo`, so the broker could serve a different repository's PR.
            if not target.is_absolute():
                target = checkout / target
            config = target / "config"
        else:
            return None
        return config.read_text(errors="replace")
    except (OSError, ValueError):
        return None


def git_config_value(raw: str) -> str | None:
    """One git config value: quoted runs, backslash escapes, and an unquoted `#` or `;` ending it.

    None for text this cannot finish reading -- a trailing backslash (the value continues on the
    next physical line), an unterminated quote, an escape git has and this does not. See
    git_config_remote_urls for why that is not the same as an empty value."""
    out: list[str] = []
    # Whether each character came from inside quotes or from an escape. git trims the whitespace
    # around a value but keeps what quotes protect, and a flat `.strip()` kept neither apart, so
    # `url = "  https://github.com/me/cli"` read as `me/cli` where git's own value is
    # `  https://github.com/me/cli`.
    #
    # An earlier version of this comment said gh "does not recognise it as a github remote at all",
    # and that is false: measured, `git config --get remote.origin.url` keeps the spaces and gh
    # resolves `me/cli` anyway, because gh reads remotes from `git remote -v`, whose output is
    # whitespace-split -- the leading spaces are field separators gh never sees. So this is not a
    # case of the broker answering where gh would not. It is simply the value git holds, which is
    # what a reader of this text is entitled to, and the serve path no longer reads this text at
    # all (git_remotes). What it costs is one entry in the local index, so a refusal declines and
    # the call goes to gh: the safe direction, for a shape no real config has.
    protected: list[bool] = []
    quoted = False
    i = 0
    while i < len(raw):
        char = raw[i]
        if char == "\\":
            mapped = GIT_CONFIG_ESCAPES.get(raw[i + 1:i + 2])
            if mapped is None:
                return None
            out.append(mapped)
            protected.append(True)
            i += 2
            continue
        if char == '"':
            quoted = not quoted
        elif not quoted and char in "#;":
            break
        else:
            out.append(char)
            protected.append(quoted)
        i += 1
    if quoted:
        return None
    start, end = 0, len(out)
    while start < end and not protected[start] and out[start].isspace():
        start += 1
    while end > start and not protected[end - 1] and out[end - 1].isspace():
        end -= 1
    return "".join(out[start:end])


def git_config_remote_urls(text: str) -> list[str] | None:
    """The `remote.*.url` values of a git config, in file order, or None for a config this cannot
    read in full.

    Read by section, because scanning the text for a github.com URL matched things that are not
    remotes: `[submodule "x"] url = ...`, an `[url "..."] insteadOf = ...` rewrite rule, and a
    commented-out line. On big-red that put 81 repositories in the local index -- every submodule
    and vendored dependency of the cmux checkout among them -- so the broker refused
    `gh api /repos/manaflow-ai/homebrew-cmux/contents/...` and pointed the caller at a cmux
    worktree whose submodules are not initialised, where the advised `git show` cannot answer.
    It also meant `broker_repo()` saw ten "remotes" in any cmux checkout and so served nothing
    there, in the repository the fleet reads most.

    All-or-nothing, because the dangerous failure is not missing every remote, it is missing *one*.
    This used to claim that a config it did not understand "yields no remote, which is the safe
    direction"; the review that followed showed the claim was false, by construction: broker_repo()
    serves when it sees exactly one remote, so a parser that drops one of two remotes turns a
    decline into answering one repository's question with another's. A fork+upstream config written
    `[remote.upstream]`, or one byte-order mark in front of `[remote "origin"]`, did exactly that --
    the BOM case served the *upstream* as the checkout's repository. So anything not understood here
    -- an unclassifiable line, an `[include]` this would have to follow, a value that continues on
    the next line -- returns None, and the caller reads None as "no remote at all", so the local
    index declines to refuse. git's own parser accepts a key on the section-header line and skips a
    UTF-8 BOM, so this does both.

    All-or-nothing is still the rule here, but it is no longer what makes a *served* answer safe:
    being exact about a config this reads in full says nothing about the scopes it never opens, and
    the round that followed measured five more ways to a subset through this file alone. That is
    git_remotes' job now, and the index is allowed to be approximate because a wrong entry there
    only costs a request (broker_source_refusal confirms the one it is about to name)."""
    urls: list[str] = []
    section, subsection = "", ""
    for raw in text.removeprefix("\ufeff").splitlines():  # git skips one; without this the first [ is not a header
        line = raw.strip()
        while True:
            if not line or line[0] in "#;":
                break
            if line[0] == "[":
                header = GIT_CONFIG_HEADER_RE.match(line)
                if header is None:
                    return None
                name, quoted_sub, line = header.group(1).strip(), header.group(2), header.group(3).strip()
                if quoted_sub is not None:
                    section, subsection = name, quoted_sub
                else:  # the deprecated `[section.subsection]` form, which git still reads
                    section, _, subsection = name.partition(".")
                section, subsection = section.strip().lower(), subsection.strip()
                if not GIT_CONFIG_SECTION_NAME_RE.fullmatch(section):
                    return None
                if section in ("include", "includeif"):
                    # git reads the named file in here, so the remotes of this checkout are not all
                    # in this text. Reproduced: with an `[include]`d upstream remote, `git remote -v`
                    # shows two and this showed one, so the broker served the fork for both.
                    return None
                continue
            key = GIT_CONFIG_KEY_RE.match(line)
            if key is None:
                return None
            if key.group(2) is None:
                break  # a valueless key, which git reads as true and is never a url
            value = git_config_value(key.group(2))
            if value is None:
                return None  # including a continuation, whose next line is this value, not a key
            if section == "remote" and subsection and key.group(1).lower() == "url" and value:
                urls.append(value)
            break
    return urls


def broker_remote_target(url: str) -> tuple[str, str] | None:
    """(host lowercased, path without its leading slash) for a remote URL that names a host, or
    None for one that does not -- a local path, a relative remote, `file://`, anything unparseable.

    git reads `host:path` as scp-like syntax only when there is no `://` and nothing before the
    first colon is a slash, so `/srv/mirrors/a:b` is a path and `git@github.com:o/r` is a host."""
    # Not stripped here: git_config_value already trims the whitespace git trims and keeps what
    # quotes protect, and stripping again would undo exactly that distinction. The old pattern
    # ended `\s*$`, which is how a quoted trailing space got in.
    if "://" in url:
        match = BROKER_URL_HOST_RE.match(url)
        if match is None:
            return None
        path = match.group(2) or ""
    else:
        match = BROKER_SCP_HOST_RE.match(url)
        if match is None or "/" in url.split(":", 1)[0]:
            return None
        path = match.group(2)
    # Exactly one leading slash, never `lstrip`: `https://github.com//cli/cli` is not a URL whose
    # repository we can claim to know, and stripping both slashes would have turned it into one.
    return match.group(1).lower(), path[1:] if path.startswith("/") else path


def broker_remotes(checkout: Path) -> list[str]:
    """The owner/repo of every github.com remote in `checkout`'s config text, lowercased, in config
    order.

    For the local index only (broker_local_repos), which is a scan of thousands of candidate
    directories and so cannot afford a fork each. What a checkout's remotes *are* is git's answer,
    not this file's -- see git_remotes, which is what the serve path asks, and what confirms an
    index entry before a refusal names it. The two differ wherever a scope this text does not hold
    has something to say, and only the one that can serve a cached answer has to be exact.

    Empty for a config this cannot read *in full*, which is the same answer as "no github remotes
    here" on purpose: the caller declines on it.

    "In full" includes every github remote's URL, not only the file's syntax. An earlier cut read
    the config all-or-nothing and then silently skipped any URL its one pattern missed, which left
    a strict *subset* of the remotes git lists -- and a subset of two is one, which is exactly what
    broker_repo's one-remote rule acts on. Measured: a checkout with `git@github.com:me/cli.git`
    and `https://www.github.com/cli/cli` left `['me/cli']`, so the broker served the fork's PR 7
    from cache where gh resolves the base repository and answers the parent's. Same for
    `https://GITHUB.COM/cli/cli`, a query string, a doubled slash and an extra path segment. So a
    URL whose host is github's and whose shape is not understood now poisons the whole config."""
    text = git_config_text(checkout)
    if text is None:
        return []
    urls = git_config_remote_urls(text)
    if urls is None:
        return []
    found: list[str] = []
    for url in urls:
        if not broker_add_remote(url, found):
            return []
    return found


def broker_add_remote(url: str, found: list[str]) -> bool:
    """Add the owner/repo of `url` to `found` when it is a github.com remote. False for a github URL
    whose shape is not understood, which the caller must answer for with "no remotes known" -- never
    with the subset it did read (see broker_remotes)."""
    target = broker_remote_target(url)
    if target is None:
        return True  # not a URL with a host at all: another kind of remote, never ours
    host, path = target
    if host != "github.com" and not host.endswith(".github.com"):
        return True  # another forge, and `notgithub.com` is one of them
    match = BROKER_REPO_PATH_RE.match(path)
    if host not in BROKER_REMOTE_HOSTS or match is None:
        return False
    name = f"{match.group(1).lower()}/{match.group(2).lower()}"
    if name not in found:
        found.append(name)
    return True


def git_remote_repo(url: str) -> str | None:
    """`owner/repo`, lowercased, for a remote URL that is a github.com clone URL this understands,
    or None for every other URL -- another forge, another GitHub host, a local path, a shape it
    cannot read.

    git_remotes declines the whole checkout on a None (see there); only broker_remotes' index,
    where being approximate costs a request and nothing else, skips them."""
    target = broker_remote_target(url)
    if target is None:
        return None
    host, path = target
    match = BROKER_REPO_PATH_RE.match(path)
    if host not in BROKER_REMOTE_HOSTS or match is None:
        return None
    return f"{match.group(1).lower()}/{match.group(2).lower()}"


GIT_FILTER_RE = re.compile(r"\[[^\s\[\]]+\]")  # `[blob:none]`, `[tree:0]`, `[blob:limit=1m]`


def git_remotes(where: Path) -> list[str] | None:
    """The owner/repo of every github.com remote git lists for the repository at or above `where`,
    lowercased, or None when that cannot be known exactly -- no repository there, a config git
    refuses, a shape this does not understand, or a `gh-resolved` entry pointing gh at a repository
    this cannot see.

    Asked of git, because `<checkout>/.git/config` is not where the answer lives. gh resolves
    remotes by running `git remote -v` and `git config --get-regexp '^remote\\..*\\.gh-resolved$'`
    (observed under GH_DEBUG=api), and both compose every config scope and apply
    `url.<base>.insteadOf` rewriting. Reading the one file left a strict *subset* of the remotes git
    lists, and a subset of two is one, which is exactly what broker_repo's one-remote rule acts on.
    Measured against git 2.53.0 and gh 2.98.0, each one serving a fork's PR 7 where gh answers the
    upstream's:
      - `remote.upstream.url` set in `~/.gitconfig`, a scope this text read nothing of;
      - `url.<base>.insteadOf` in `~/.gitconfig`, which changes the host git uses. With
        `insteadOf = https://github.com/` pointing at a mirror, gh exits 1 ("none of the git remotes
        ... point to a known GitHub host") and the broker answered `cli/cli` with exit 0 -- inventing
        success where gh refuses, which is worse than a wrong repository;
      - `gh:cli/cli` with a global `insteadOf` making it a github URL, which this read as another
        forge's and skipped;
      - a remote with a `pushurl` and no `url`, which `git remote -v` lists and gh resolves;
      - `gh-resolved` written on the section-header line, or spelled `GH-Resolved`: git config keys
        are case-insensitive and a line-anchored case-sensitive pattern over the text saw neither.
    Two forks of git, weighed against one request out of the 5000/h every agent on this account
    shares, is the right trade. git missing or unrunnable is None, which is also what gh would have
    to answer: gh resolves repositories by running git too."""
    args = ["git", "-C", str(where)]
    try:
        # git walks up from here exactly as gh does. Looking only at the directory itself meant
        # `gh pr view 7` run from `repo/src` -- which is most of how agents run it -- resolved no
        # repository and spent a request on something the cache was holding.
        resolved = run_bounded([*args, "config", "--get-regexp", r"^remote\..*\.gh-resolved$"],
                               timeout=BROKER_GIT_DEADLINE)
        listed = run_bounded([*args, "remote", "-v"], timeout=BROKER_GIT_DEADLINE)
    except (subprocess.TimeoutExpired, OSError, UnicodeDecodeError):
        # UnicodeDecodeError because a remote URL that is not UTF-8 makes run_bounded(text=True)
        # raise, and this answers "cannot be known exactly" for that the same way it does for a
        # config git refuses. cmd_gh's catch-all would exec gh anyway; declining here says it.
        return None
    # `--get-regexp` exits 1 for "asked, and no key matches"; anything else non-zero (128) is a
    # config or a repository git will not read, and neither will gh.
    if resolved.returncode not in (0, 1) or listed.returncode != 0:
        return None
    if resolved.stdout.strip():
        return None  # `gh repo set-default`: gh resolves through it, and this cannot see where to
    found: list[str] = []
    for line in listed.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        # `NAME<TAB>URL (fetch|push)`. A remote with only a pushurl prints `NAME<TAB>` with no URL
        # and no marker for its fetch line (measured), which is a shape we know rather than one we
        # cannot read; its push line is then the URL gh resolves (also measured: `gh browse -n` in
        # such a checkout asks for `repos/cli/cli`, because gh falls back to the push URL when a
        # remote has no fetch URL). Anything else -- a URL with whitespace in it, which git keeps
        # inside quotes and this output cannot express -- is unknown, and gh, which splits this
        # same text, cannot read it either.
        if len(fields) == 1:
            continue
        # A partial clone's fetch line ends in its filter: `origin<TAB>URL (fetch) [blob:none]`
        # (git 2.56.0, any remote with a partialclonefilter). gh's own remote pattern is not
        # anchored at the end, so it reads that line as it reads any other; declining it declined
        # every checkout on a host whose clones are blobless, which is the fleet's default. On
        # cosmic-gray that let 353 source reads an hour of manaflow-ai/cmux through to the API
        # past the refusal below, and kept the cache from serving any read made inside one.
        if len(fields) == 4 and fields[2] == "(fetch)" and GIT_FILTER_RE.fullmatch(fields[3]):
            fields = fields[:3]
        if len(fields) != 3 or fields[2] not in ("(fetch)", "(push)"):
            return None
        # Every URL of every remote, fetch and push, and a URL this cannot read as a github.com
        # repository ends the answer rather than being skipped. That is what makes the one-name
        # answer sound: when exactly one name comes out, every URL in the checkout names that one
        # repository, so it does not matter which remote gh prefers or which of its URLs gh reads.
        # Skipping instead was a wrong answer twice over, both measured against gh 2.98.0:
        #   - `url = https://gitlab.com/a/b.git` with `pushurl = https://github.com/cli/cli.git`:
        #     gh exits 1 ("none of the git remotes ... point to a known GitHub host") because it
        #     resolves the *fetch* URL and falls back to the push URL only when there is no fetch
        #     URL at all. Reading the push line as an answer left one GitHub remote, and the broker
        #     served `cli/cli` from cache with exit 0 -- inventing success where gh refuses.
        #   - `origin = https://github.com/o/r` with `upstream = https://ghe.example/acme/thing`
        #     and both hosts in gh's hosts.yml: gh resolves `acme/thing` **on ghe.example**
        #     (measured: `gh pr view 7` posts to `https://ghe.example/api/graphql`), because it
        #     picks a remote by name across every host it has credentials for -- `upstream`, then
        #     `github`, then `origin`, then the rest alphabetically. Skipping the enterprise remote
        #     as "another forge" left `o/r` and answered another host's repository out of
        #     github.com's cache.
        # Deciding which foreign hosts gh really ignores means reproducing gh's set of known hosts
        # (hosts.yml, $GH_HOST, enterprise tokens) exactly, and being wrong there is that second
        # case again. So any remote that is not github.com's declines: a checkout with a GitLab
        # mirror alongside its GitHub remote costs one request, where gh does resolve the GitHub
        # one.
        name = git_remote_repo(fields[1])
        if name is None:
            return None
        if name not in found:
            found.append(name)
    return found


def gh_hosts_file() -> Path | None:
    """gh's own hosts.yml, where `gh auth login` records the hosts it has credentials for, or None
    when there is nowhere it could be.

    This reads `$HOME` rather than calling `Path.home()`, but not for the reason an earlier version
    of this docstring gave: it claimed `Path.home()` *raises* with no HOME, and on Linux and macOS
    it does not -- it falls back to the password database, so `env -u HOME glaeda-gh gh pr view 7
    -R o/r --json state` runs fine, and `BASE` at import time would have been the first casualty if
    it really raised. The reason is that a job with no HOME -- a launchd job, a systemd unit --
    also has no gh config to read, and answering with *some other* home's hosts.yml on the way to
    deciding which host a call is for is worse than not answering: gh's built-in default is the
    honest answer, and the caller uses it."""
    directory = os.environ.get("GH_CONFIG_DIR")
    if not directory:
        base = os.environ.get("XDG_CONFIG_HOME") or os.environ.get("HOME")
        if not base:
            return None
        directory = str(Path(base) / "gh" if os.environ.get("XDG_CONFIG_HOME")
                        else Path(base) / ".config/gh")
    return Path(directory) / "hosts.yml"


def gh_default_host() -> str | None:
    """The host real gh uses when neither the command line nor the environment names one, or None
    for a hosts.yml this cannot read as a list of hosts.

    gh does not simply default to github.com: with exactly one host logged in, that host is its
    default, so on an enterprise-only machine every unqualified call goes there. Found by running
    it -- with GH_CONFIG_DIR naming a config whose only host was `ghe.invalid.example`, gh 2.98.0
    tried to connect there while this still printed the github.com source refusal and still served
    `pr view 7 -R acme/thing --json state` out of the github.com cache. Same wrong-answer shape as
    an explicit `--hostname`, through the one channel broker_elsewhere did not read.

    The parse is top-level YAML keys and nothing else, because that is all the question needs; a
    file it cannot read that way is None, and broker_elsewhere reads None as "not github.com",
    which declines instead of answering for a host it cannot identify."""
    path = gh_hosts_file()
    if path is None:
        return "github.com"
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return "github.com"  # no hosts.yml at all: gh's built-in default, and the normal case
    hosts: list[str] = []
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#") or line[:1].isspace():
            continue  # blank, a comment, or indented: a value under some host, not a host
        match = re.fullmatch(r"([A-Za-z0-9][A-Za-z0-9.:-]*):\s*(?:#.*)?", line.rstrip())
        if match is None:
            return None
        hosts.append(match.group(1).lower())
    if len(hosts) == 1 and hosts[0] not in BROKER_GITHUB_HOSTS:
        return hosts[0]
    return "github.com"


def broker_elsewhere(values: dict[str, str]) -> bool:
    """True when the call names, or gh would resolve, a GitHub host that is not github.com.

    `repos/acme/thing` on an enterprise host is not the same repository as `acme/thing` on
    github.com, so neither the cache nor the local-checkout refusal has anything to say about it.
    broker_repo() always declined these; the refusal did not, and sent
    `gh api --hostname ghe.example.com /repos/acme/thing/contents/README.md` to read a github.com
    clone of that path -- a different repository's bytes, offered as the same ones."""
    host = (values.get("--hostname") or os.environ.get("GH_HOST") or gh_default_host() or "").lower()
    if host not in BROKER_GITHUB_HOSTS:
        return True
    return bool(os.environ.get("GH_ENTERPRISE_TOKEN") or os.environ.get("GITHUB_ENTERPRISE_TOKEN"))


def broker_source_refusal(words: list[str]) -> str | None:
    """The message for an API read of repository source, when that repository is on this host."""
    for word in words[1:]:
        match = BROKER_SOURCE_RE.match(word) or BROKER_RAW_RE.match(word)
        if not match:
            continue
        owner, repo = match.group(1).lower(), match.group(2).lower()
        where = broker_local_repos().get(f"{owner}/{repo}")
        if where is None:
            return None
        # The index is built from config *text*, which is not where the answer lives (git_remotes):
        # a remote rewritten by an `insteadOf` in a scope that text does not hold, or one written
        # in another scope entirely, puts an entry here that names a checkout of some other
        # repository -- and this message tells the reader to run `git show` in it, so a wrong entry
        # hands back another repository's bytes as these. Confirmed with git before it is named.
        # Declining costs one request and says nothing untrue; the scan itself stays a cheap text
        # read, because one fork per candidate directory is not affordable and a miss there only
        # declines.
        if f"{owner}/{repo}" not in (git_remotes(Path(where)) or []):
            return None
        return (f"glaeda-gh: reading {owner}/{repo} source through the GitHub API spends the quota every agent "
                f"on this account shares (5000/h between all of them), and git has the same bytes for nothing.\n"
                f"  {owner}/{repo} is checked out at {where}:\n"
                f"    git -C {where} fetch origin <ref>\n"
                f"    git -C {where} show <ref>:<path>\n"
                f"  GLAEDA_GH_ALLOW_API_SOURCE=1 passes one call through, for a path git really cannot answer.")
    return None


def broker_repo(values: dict[str, str]) -> str | None:
    """OWNER/REPO for this call, or None when it cannot be known beyond doubt.

    `-R`/`--repo` first, then $GH_REPO, then the checkout the process's own working directory is in
    -- the caller's, because the broker execs in place -- but only when git lists exactly one
    GitHub remote there and no `gh-resolved` entry (`gh repo set-default`, which would point gh
    somewhere this cannot see). git does the walking up, as it does for gh (git_remotes). Guessing
    here answers one repository's question with another's.

    Anything aimed at another GitHub host is None: gh takes `[HOST/]OWNER/REPO` and reads $GH_HOST,
    and an enterprise host's PR 7 is not the PR 7 in this cache."""
    if broker_elsewhere(values):
        return None
    named = values.get("--repo") or os.environ.get("GH_REPO")
    if named:
        parts = named.rstrip("/").split("/")
        if len(parts) > 2 and parts[-3].lower() not in BROKER_GITHUB_HOSTS:
            return None
        return f"{parts[-2].lower()}/{parts[-1].lower()}" if len(parts) >= 2 else None
    if any(os.environ.get(name) for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_CEILING_DIRECTORIES",
                                             "GIT_DISCOVERY_ACROSS_FILESYSTEM")):
        # These change where git -- and so gh -- starts or stops looking. Hooks set GIT_DIR, and
        # under it this walk can land on a different repository than gh would, which since the
        # walk was added is a wrong answer rather than a wasted request.
        return None
    here = git_remotes(Path.cwd())
    if here is None:
        return None
    # Still exactly one, now that the remotes are read the way git reads them. The cmux checkout
    # really does have five (the fork a lane pushes from, and contributors' forks), so this
    # declines there and `gh pr view 7` without `-R` costs a request. Picking `origin` instead
    # would be wrong, not just bolder: with several remotes and no `gh-resolved`, gh picks a remote
    # **by name** -- `upstream`, then `github`, then `origin`, then the rest alphabetically, with no
    # request of its own (measured: in a checkout with `origin = me/cli` and `upstream = cli/cli`,
    # `gh browse -n` asks for `repos/cli/cli`; with `aaa` and `zzz`, for `aowner/arepo`). So in a
    # fork checkout `origin` answers the fork's PR 7 where gh answers the upstream's. An earlier
    # version of this comment said gh resolved the base repository through the API and landed on
    # the parent; the conclusion was right and the mechanism was not. Declining costs a request;
    # guessing answers one repository's question with another's.
    return here[0] if len(here) == 1 else None


def broker_target(words: list[str], values: dict[str, str], kind: str) -> str | None:
    """The cache key for a `pr view N` or `run view ID`, or None when it is not that exact shape.

    `gh pr view` also takes a URL or a branch name; `gh run view` takes a run ID only, so a URL
    there is a call gh rejects and this must not answer."""
    if len(words) != 3:
        return None
    target = words[2]
    if re.fullmatch(r"\d+", target):
        repo = broker_repo(values)
        return None if repo is None else parse_key(kind, f"{repo}{'#' if kind == 'pr' else '/'}{target}")
    if kind == "run":
        return None
    try:
        return parse_key(kind, target)  # a full PR URL carries its own repository
    except WatchError:
        return None


def broker_fields(values: dict[str, str], table: dict[str, tuple[str, str]],
                  raw_args: list[str]) -> list[str] | None:
    """The --json field list, if every field asked for is one the cache holds. gh unions repeated
    --json flags; only the last reaches `values`, so more than one of them is not served."""
    raw = values.get("--json")
    if not raw or sum(1 for a in raw_args if a == "--json" or a.startswith("--json=")) != 1:
        return None
    wanted = [f for f in raw.split(",") if f]
    return wanted if wanted and all(f in table for f in wanted) else None


def broker_seen_count(key: str, now: float) -> int:
    """How many times this host has read `key` since the first read in the current window. The
    first read's time is kept, not the latest, so a target read every BROKER_REPEAT-1 seconds for
    an hour does not slide its way into a watch."""
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Read-modify-write, and the callers are every gh call on the host at once: two sessions reading
    # the same PR in the same second are exactly the pair that should add up to a watch. Bounded,
    # because this count is advisory and a gh call is not: at worst two concurrent readers both
    # write their own count and the promotion to a watch happens one read later.
    with bounded_lock(BASE / ".broker-seen.lock"):
        doc = read_json(broker_seen_path())
        seen = doc if isinstance(doc, dict) else {}
        seen = {k: v for k, v in seen.items()
                if isinstance(v, list) and len(v) == 2 and now - (v[0] or 0) < BROKER_REPEAT}
        first, count = seen.get(key) or [now, 0]
        seen[key] = [first, count + 1]
        if len(seen) > BROKER_SEEN_KEEP:
            seen = dict(sorted(seen.items(), key=lambda kv: kv[1][0], reverse=True)[:BROKER_SEEN_KEEP])
        write_json(broker_seen_path(), seen)
    return count + 1


def broker_max_age(fields: list[str]) -> float:
    """The cache horizon for a read of `fields`.

    It widens as the shared quota drains: spending the last of it on a read the daemon already
    made a few minutes ago is the worst trade available. But not for the fields automation pivots
    on -- a ten-minute-old headRefOid means waiting on a head that was superseded, and a
    ten-minute-old conclusion means calling a run green -- and a spent quota is exactly when every
    session is hammering gh, so those keep the normal horizon."""
    if set(fields) & BROKER_LIVE_FIELDS:
        # Before the override, not after. GLAEDA_GH_MAX_AGE=999999 served a two-hour-old
        # `{"state":"MERGED","mergeable":"MERGEABLE"}`, so one export in a shell profile silently
        # turned off the single protection the merge path depends on. The override widens the
        # horizon for fields where staleness only costs a request; it is not a way to turn that
        # distinction off.
        return BROKER_MAX_AGE
    # A daemon configured to poll less often than every BROKER_MAX_AGE - 30 s would leave its cache
    # always older than the horizon, and every read would go to gh: the horizon follows the cycle.
    # (Not for the live fields above: their horizon is a correctness bound, not a cost.)
    cycle = daemon_policy()["cycle"]
    normal = max(BROKER_MAX_AGE, cycle + 30.0)
    lean = max(BROKER_LEAN_AGE, cycle * LEAN_FACTOR + 30.0)  # below the floor the daemon reads that rarely
    try:
        age = float(os.environ["GLAEDA_GH_MAX_AGE"])
        return age if age >= 0 else normal
    except (KeyError, ValueError):
        pass
    budget = read_json(BASE / "budget.json")
    if not isinstance(budget, dict):
        return normal
    now = time.time()
    for bucket, (floor, _reserve) in daemon_policy()["floors"].items():
        seen = budget.get(bucket)
        if not isinstance(seen, dict) or (seen.get("reset") or 0) <= now:
            continue
        remaining = seen.get("remaining")
        if isinstance(remaining, int) and remaining < floor:
            return lean
    return normal


def broker_bucket_spent(key: str, now: float) -> bool:
    """True when the bucket gh would spend on `key` is below its reserve until a reset that has not
    come yet, throttled (the daemon stopped it: GitHub refused it), or named in forceLow, and the other
    bucket is none of these: then the daemon can read what gh cannot. Below its floor alone is not
    enough here: one gh call costs one request, and waiting for the daemon costs the caller seconds."""
    budget = read_json(BASE / "budget.json")
    budget = budget if isinstance(budget, dict) else {}
    policy = daemon_policy()
    floors = policy["floors"]
    status = read_json(BASE / "daemon.json")
    modes = status.get("modes") if isinstance(status, dict) and isinstance(status.get("modes"), dict) else {}
    fresh = isinstance(status, dict) and isinstance(status.get("at"), (int, float)) and now - status["at"] < 2 * CYCLE

    def spent(bucket: str) -> bool:
        if bucket in policy["forceLow"] or (fresh and modes.get(bucket) == "stop"):
            return True
        seen = budget.get(bucket)
        if not isinstance(seen, dict) or (seen.get("reset") or 0) <= now:
            return False
        remaining = seen.get("remaining")
        return isinstance(remaining, int) and remaining < floors[bucket][1]

    mine = BROKER_GH_BUCKET.get(key.split(":", 1)[0])
    return mine is not None and spent(mine) and not spent(OTHER[mine])


def broker_await(args: list[str], key: str) -> str | None:
    """Register `key` and wait up to BROKER_SPENT_WAIT for the daemon to read it; the `--json` line
    once the cache answers every field asked for, else None (the call then goes to gh as before)."""
    register(key)
    started = time.monotonic()
    try:
        while True:
            route, line, _key = broker_plan(args, time.time())
            if route == "serve":
                return line
            if time.monotonic() - started >= BROKER_SPENT_WAIT:
                return None
            time.sleep(0.5)
    finally:
        extend_lock_budget(time.monotonic() - started)  # a deliberate wait, as broker_hold's is


def broker_value(stored: Any, kind: str) -> Any:
    """What gh prints for a stored value. gh unmarshals into Go structs, so a null string field
    comes out "" (an unreviewed PR's reviewDecision, a running job's conclusion) while a null time
    stays null. A null where gh expects a number or a bool is not something to guess at."""
    if stored is not None:
        return stored
    if kind == "str":
        return ""
    if kind == "time":
        return None
    raise WatchError(f"cached {kind} is null")


def broker_serve(key: str, fields: list[str], table: dict[str, tuple[str, str]], now: float) -> str | None:
    """The `gh --json` line for `key`, or None when the cache cannot answer it."""
    entry = read_cache(key)
    if not isinstance(entry, dict) or entry.get("error"):
        return None
    data, at = entry.get("data"), entry.get("dataAt")
    if not isinstance(data, dict) or not isinstance(at, (int, float)) or now - at > broker_max_age(fields):
        return None
    out = {}
    for field in fields:
        stored, kind = table[field]
        if stored not in data:
            return None  # the daemon did not store it at all
        try:
            out[field] = broker_value(data[stored], kind)
        except WatchError:
            return None
    return json.dumps(out, sort_keys=True, separators=(",", ":"))


def broker_note(event: dict) -> None:
    """One line per decision, for the before/after numbers. Never raises."""
    path = broker_log()
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if (path.parent.stat().st_mode & 0o077) != 0:
            path.parent.chmod(0o700)  # mode= misses a directory an earlier run already created
        if path.exists() and path.stat().st_size > BROKER_LOG_MAX:
            # Under a lock, and measured again inside it -- the same race the call log's rotation
            # fixed, still here 170 lines above it. Two callers straddling the threshold both
            # `stat` then both `replace`, and the second rotation overwrote the full `.1` with the
            # handful of bytes the first had just started: the whole decision history in neither
            # file. Reproduced with two real processes and a 2 s deschedule between one caller's
            # stat and its replace. Not rotating when the lock is held is safe: the log grows a
            # little past the cap and the next call rotates it.
            with bounded_lock(path.parent / ".broker-log-rotate.lock") as held:
                if held and path.exists() and path.stat().st_size > BROKER_LOG_MAX:
                    path.replace(path.with_name(path.name + ".1"))
        with path.open("a") as stream:
            stream.write(json.dumps({"at": round(time.time()), **event}, sort_keys=True) + "\n")
    except Exception:  # noqa: BLE001  not even an unserialisable event may fail a gh call
        pass


def broker_logged_target(words: list[str], values: dict[str, str]) -> str:
    """What may be written next to the subcommand: an identifier, never content.

    Only an API path (query cut) and a resolved cache key qualify. Everything else is dropped,
    because the tail of a command line is not safe to keep: `gh secret set NAME --body VALUE` and
    `gh pr create --title T BODY` both put text worth hiding in a positional slot, and the log is
    a long-lived plain file every session appends to."""
    if words and words[0] == "api":
        path = (words[1] if len(words) > 1 else "").split("?")[0]
        # A path, not whatever else sat in that slot: an endpoint starts with a letter, a slash or
        # a scheme, so `gh api "$BODY"` with a mistyped flag leaves nothing in the log.
        return path if re.fullmatch(r"(?:https?://)?/?[A-Za-z0-9_][A-Za-z0-9_./:#@~-]{0,199}", path) else ""
    if len(words) >= 3 and words[0] in ("pr", "run", "issue"):
        kind = "run" if words[0] == "run" else "pr"
        try:
            return broker_target(words[:3], values, kind) or ""
        except (WatchError, OSError):
            return ""
    return ""


def broker_caller() -> str:
    """Who is making this call, by the same rule the PATH guard uses, so one log has one notion
    of a caller: the agent session if there is one, else the parent process.

    Shape-checked, because this is an environment variable going into a line-oriented log that
    AUDIT_LINE reads as three whitespace-separated fields. The subcommand slot is checked the same
    way; leaving this one open would just move the hole.

    GH_QUOTA_CALLER first: the gh-quota shim in front of this exports the caller it charged the call to (`session:NAME`
    or `tool:NAME`, leo-workspace tools/gh_quota.py caller_of), so a timer with no session id is named by its tool,
    not a parent pid nothing maps back (huge-blue's 95.6k calls a day could not be split by caller, 2026-11-17)."""
    quota = os.environ.get("GH_QUOTA_CALLER") or ""
    if re.fullmatch(r"(?:session|tool):[A-Za-z0-9_.@-]{1,64}", quota):
        return quota
    named = os.environ.get("CLAUDE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID") or ""
    if re.fullmatch(r"[A-Za-z0-9_.:-]{1,64}", named):
        return named
    return f"ppid-{os.getppid()}"


# A read worth holding when the same caller repeats it: the ones a polling loop is written out of,
# named as (subcommand, verb). `gh api` GET joins them, by method rather than by name. Reads that
# are not poll shapes (`pr diff`, `issue view`) are left alone -- the delay is for the loop that
# drained the pool three times in a day, not a toll on reading.
BROKER_THROTTLED = {("pr", "view"), ("pr", "checks"), ("pr", "list"),
                    ("run", "view"), ("run", "list"), ("issue", "list")}


def endpoint_re(name: str) -> "re.Pattern[str]":
    """One top-level API endpoint, however `gh api` was given it: bare, rooted, or an absolute URL.

    Any host, not `api.github.com` alone: this file handles GHE remotes deliberately. Pinning the
    one host meant `https://ghe.example/api/graphql` read as an ordinary path -- undercounting the
    audit's category, and (through `BROKER_FREE_RE`) holding a GHE host's free `rate_limit` read
    behind the repeat delay. One function, so widening one endpoint's spellings cannot leave the
    other behind again.

    Both of a GHE host's bases, because they are not the same one and an earlier version of this
    said they were: GraphQL is at `/api/graphql` and REST is under `/api/v3/`, so
    `https://ghe.example/api/v3/rate_limit` is the spelling a GHE host actually serves for the free
    call -- and with `/api/` alone it was still filed as an ordinary path and still held 30 s, which
    is the defect this helper claimed to have removed (measured by a review: 0.0 s then 29.9 s).
    `/api/rate_limit` stays matched too; it 404s on GHE, so matching it costs nothing.

    `re.escape`, because this reads as the general helper and a name with a `.` or a `+` in it
    would quietly widen the pattern."""
    return re.compile(rf"^(?:https?://[^/]+/(?:api/(?:v3/)?)?)?/?{re.escape(name)}/?$")


# `GET /rate_limit` is documented as costing neither pool, and this file already treats it as free
# (`request(free=True)`, audit_category's "rate_limit (free)"). Holding it punishes the session
# doing the right thing: checking the budget around a batch of calls. `--web` opens a browser.
BROKER_FREE_RE = endpoint_re("rate_limit")


def broker_repeat_wait(args: list[str], words: list[str], method: str, seen: set[str],
                       now: float) -> float:
    """How long to hold this call before it spends the shared quota on something this caller just
    read. Nothing else in the broker sleeps.

    The rule is the cmuxterm-hq PATH guard's (2026-10-04: no agent polls GitHub faster than every
    30 s, after Lawrence's REST pool ran out three times in a day), but applied here instead of
    there, because only this side knows whether the call is about to cost a request at all. In the
    guard it also delayed the reads the cache answers for nothing -- the 22% of all traffic this
    broker exists to serve, made slower by the thing meant to protect the quota they do not spend.

    The bound is per call, not per target: the slot is stamped before the sleep, so a serial
    polling loop is held `delay` apart each time around, but a parallel fan-out of n identical
    reads is held once and then released *together*, one `delay` later -- the wait is capped at
    `delay`, so the n-th does not wait n*delay, and every lane after the first wakes at the same
    moment. A thundering herd, on purpose: queueing fifty lanes behind each other would be an
    outage, not a rate limit. So this is a brake on a loop, not a quota. What actually keeps a
    fan-out off GitHub is the cache above it."""
    try:
        delay = float(os.environ.get("CMUX_GH_MIN_REPEAT_SECONDS") or BROKER_MIN_REPEAT)
    except ValueError:
        delay = BROKER_MIN_REPEAT
    if delay <= 0:
        return 0.0
    first, second = (words + ["", ""])[:2]
    if (first, second) not in BROKER_THROTTLED and not (first == "api" and method == "GET"):
        return 0.0
    if first == "api" and any(BROKER_FREE_RE.match(word) for word in words[1:2]):
        return 0.0  # costs no quota, so there is nothing to protect by waiting
    if "--web" in seen:
        # Not free -- the argument-less forms resolve the PR or run over the API before opening a
        # URL -- but a person opening a browser twice is not the polling loop this delay is for,
        # and holding an interactive command 30 s is worse than the request. Read from `seen`, not
        # from a scan of args, or a flag whose *value* is "--web" would exempt the call.
        return 0.0
    if sys.stdout.isatty():
        # The same exemption, for the same reason, and the review that asked for broker_plan's tty
        # branch is what found this: that branch returns "pass" *before* cmd_gh reaches this brake,
        # so a person's second interactive `gh pr view 7 -R o/r --json state` went from served
        # instantly to held 30 s. Measured on a real pty: 0.12 s, then 30.00 s. A tty is a person,
        # and what this brake is for is a loop. Agents' calls are piped, so they still get it.
        return 0.0
    digest = hashlib.sha256("\0".join([broker_caller(), *args]).encode()).hexdigest()[:32]
    path = BASE / "broker-repeat.json"
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Bounded for the same reason as broker_seen_count: the delay is there to save a request, and
    # holding `gh` on a lock to decide whether to hold it 30 s is the wrong way round.
    with bounded_lock(BASE / ".broker-repeat.lock"):
        doc = read_json(path)
        seen = {k: v for k, v in (doc if isinstance(doc, dict) else {}).items()
                if isinstance(v, (int, float)) and not isinstance(v, bool) and now - v < 2 * delay}
        wait = max(0.0, min(delay, (seen.get(digest) or 0.0) + delay - now))
        seen[digest] = now + wait
        if len(seen) > BROKER_SEEN_KEEP:
            seen = dict(sorted(seen.items(), key=lambda kv: -kv[1])[:BROKER_SEEN_KEEP])
        write_json(path, seen)
    return wait


def broker_hold(seconds: float) -> None:
    """The one place the broker sleeps, and the only one: a test replaces this rather than the
    clock, because the daemon's own waits are built on that."""
    if seconds <= 0:
        return
    print(f"glaeda-gh: this caller read the same thing moments ago and the cache cannot answer it; "
          f"waiting {int(round(seconds))} s before spending a request on it again "
          f"(CMUX_GH_MIN_REPEAT_SECONDS)", file=sys.stderr)
    time.sleep(seconds)
    extend_lock_budget(seconds)


def broker_log_call(words: list[str], values: dict[str, str]) -> str:
    """Append this call to the shared log: time, caller, the subcommand, and an identifier. Returns
    that subcommand-and-identifier text, which the decision log keeps too (cmd_audit's "reached
    GitHub" figure), whether or not the PATH guard already wrote the call log's line.

    The PATH guard writes the same shape when it has no broker to delegate to, so `glaeda-gh audit`
    reads one format from every host."""
    line = broker_call_line(words, values)
    if os.environ.get("CMUX_GH_GUARD_LOGGED") == "1":
        return line
    caller = broker_caller()
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    path = guard_log()
    try:
        # 0700 like every other state path here: credentials are stripped, but this is every repo,
        # PR, run and API path every session on the host reads, and no other local account needs it.
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        # The same for the file, which said 0700 above and came out 0664 under a normal umask --
        # and so did the world-readable `.1` it was rotated into. Repaired rather than only set at
        # creation, because the loose copies already exist on every host this has run on. Never
        # through a symlink: chmod follows one, so a CMUX_GH_LOG pointing at a link would narrow
        # whatever the link names instead.
        if path.exists() and not path.is_symlink() and (path.stat().st_mode & 0o077):
            path.chmod(0o600)
        # Rotated like the decision log. One line per gh call per host is 117 MB on cosmic-gray
        # already, and this is the one append here that had no cap at all. `audit` reads the
        # rotated file too, so nothing is lost until the next rotation past it.
        if path.exists() and path.stat().st_size > GUARD_LOG_MAX:
            # Under a lock, and measured again inside it: `stat` then `replace` with two callers
            # straddling the threshold rotated twice, and the second rotation replaced the full
            # `.1` with the 51-byte log the first one had just started -- the entire audit history
            # in neither file, which is the one thing rotation exists to keep. Driven directly to
            # confirm it. Not rotating when the lock is held is safe: the log grows a little past
            # the cap and the next call rotates it.
            with bounded_lock(path.parent / ".guard-log-rotate.lock") as held:
                if held and path.exists() and path.stat().st_size > GUARD_LOG_MAX:
                    path.replace(path.with_name(path.name + ".1"))
        # Created 0600 rather than created loose and repaired on the next call, so the window in
        # which it is readable by other local accounts is no window at all.
        with os.fdopen(os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600), "a") as stream:
            stream.write(f"{stamp} {caller} {line}\n")
    except OSError:
        pass
    return line


def broker_call_line(words: list[str], values: dict[str, str]) -> str:
    """The subcommand words and one identifier for this call, as the call log keeps them."""
    # `api` carries its path in words[1], and the target is that path with its query cut: one or
    # the other, never both, or the query comes back in through the subcommand.
    head = words[:1] if words[:1] == ["api"] else words[:2]
    # A subcommand is a word. Anything else in that slot (`gh "pr view 7\n2026-..."`, or a value a
    # flag this does not know about left behind) must not reach a line-oriented shared log.
    kept: list[str] = []
    for word in head:
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}", word):
            break
        kept.append(word)
    head = kept
    line = " ".join(x for x in [*head, broker_logged_target(words, values)] if x)
    # A backstop under the parse above, which is a parse of someone else's command line: however a
    # credential reached this line, it does not stay in it.
    line = BROKER_SECRET_RE.sub("[redacted]", line)
    return line


def broker_hops() -> int:
    """How many times *this* call has already been through the broker. Carried across the exec in
    BROKER_MARK as "count:pid", and honoured only in the process the mark was written for.

    The pid is what makes the mark about one call rather than one environment. A PATH loop is a
    chain of execs, and an exec keeps the pid, so a call that really is coming back here still
    carries its own mark and the chain stays finite. A `gh` that *spawns* `gh` -- an extension,
    an alias, an $EDITOR hook -- is a new process, so it starts at zero: it gets brokered, served
    and logged like any other call, instead of inheriting its parent's hop count and eventually
    being refused for a loop that does not exist.

    Anything unreadable in the mark counts as one hop, which only ever ends the chain sooner.
    Older versions wrote a bare count, which still reads as one hop in any process."""
    raw = os.environ.get(BROKER_MARK) or ""
    if not raw:
        return 0
    count, _, owner = raw.partition(":")
    if owner and owner != str(os.getpid()):
        return 0  # another process's mark: it is not this call's history
    try:
        return max(0, int(count))
    except ValueError:
        return 1


def broker_depth() -> int:
    """How many brokered `gh` generations deep this process is, however it got here.

    Unscoped, unlike broker_hops: a wrapper that forks `gh` rather than exec'ing it gets a new pid
    each time, so only a counter that ignores the pid can end that chain. Anything unreadable
    counts as the limit, which ends it sooner rather than later."""
    raw = os.environ.get(BROKER_DEPTH) or ""
    if not raw:
        return 0
    try:
        return max(0, int(raw))
    except ValueError:
        return BROKER_MAX_DEPTH


def broker_is_wrapper(candidate: Path) -> bool:
    """Whether this `gh` is something that would come back here: this broker's own shim, or the
    cmuxterm-hq PATH guard. The marker is also why a brokered call carries BROKER_MARK across the
    exec -- a wrapper whose wording changes must not become an endless loop."""
    try:
        with candidate.open("rb") as stream:
            head = stream.read(4096)
    except OSError:
        # A gh that cannot be read is not a Python or bash wrapper; it is a binary, or a file this
        # account may execute but not read. Calling it a wrapper steps over a perfectly runnable
        # gh, and if no fallback path exists the broker is then the reason the call failed.
        return False
    return BROKER_MARK.encode() in head or b"gh guard" in head


# lane-vm-bootstrap's credential chain on a lane VM: gh with a per-command token from the lane-gh broker.
# GLAEDA_GH_LANE_CHAIN names another path (tests point it into their own HOME).
LANE_VM_GH = Path(".local/lib/lane-gh/bin/gh")


def lane_vm_gh() -> str | None:
    """The lane VM credential chain's gh, or None off a lane VM."""
    candidate = Path(os.environ.get("GLAEDA_GH_LANE_CHAIN") or Path.home() / LANE_VM_GH)
    if candidate.is_file() and os.access(candidate, os.X_OK) and not broker_is_wrapper(candidate):
        return str(candidate)
    return None


QUOTA_HOP = "GLAEDA_GH_QUOTA_HOP"  # a hand-off to the gh-quota guard that is neither a merge nor a create: this
# broker's own mark for it, carrying the pid like BROKER_MARK, so a guard generation that stops exporting
# GH_QUOTA_CHECKED costs one extra exec rather than an endless chain, while a `gh` the call's own gh goes on to
# spawn is a new pid and reaches the guard as a plain `gh` would.
GLAEDA_INTERNAL = "GLAEDA_GH_INTERNAL"  # this daemon's own `gh api` reads: left on the route they have today


def file_head(path: Path) -> bytes:
    """The first 4096 bytes of `path`, or b"" when it cannot be read (broker_is_wrapper's reason: a gh this account
    may execute but not read is a binary, not a wrapper, and must not be judged by what it does not say)."""
    try:
        with path.open("rb") as stream:
            return stream.read(4096)
    except OSError:
        return b""


def path_gh_after(directory: Path) -> Path | None:
    """The first executable `gh` on PATH in a directory after `directory`: what a guard in `directory` execs next,
    resolved the way the guard resolves it (PATH order, first match after its own directory)."""
    seen = False
    for entry in (os.environ.get("PATH") or "").split(os.pathsep):
        if not entry:
            continue
        if not seen:
            seen = Path(entry) == directory
            continue
        candidate = Path(entry) / "gh"
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    return None


def broker_guard_comes_back(guard: Path) -> bool:
    """Whether the gh-quota guard would hand the call back to this broker: the next `gh` after it on PATH is this
    broker's own shim. A merge and a create go to the guard either way (one is refused without it, the other has a
    pause only it can ask), but for every other call this is the condition that makes the hand-off free: without
    it the guard runs the real gh behind this broker's back, and the call loses the answer cache, the source
    refusal and the repeat hold -- a worse trade than the quota route it would gain."""
    following = path_gh_after(guard.parent)
    return following is not None and BROKER_MARK.encode() in file_head(following)


def broker_real_gh() -> str:
    """The real gh: the binary a guard that delegated here named in GLAEDA_GH_REAL, else the next
    `gh` on PATH that is not a wrapper, else one of the usual install paths (a LaunchAgent's PATH
    is nearly empty, which is where find_gh's list comes from).

    GLAEDA_GH_REAL is checked the same way as a PATH candidate. Mid-rollout a host can have two
    generations of the PATH guard on PATH, and the older one's idea of "the real gh" is the newer
    one -- taking its word for it would hand the call straight back here."""
    named = os.environ.get("GLAEDA_GH_REAL")
    if named and os.access(named, os.X_OK) and not Path(named).is_dir() \
            and not broker_is_wrapper(Path(named)):
        return named
    # A lane VM holds no GitHub login: its gh is lane-vm-bootstrap's wrapper (a "gh guard", stepped over below), and
    # the authenticated gh is the credential chain behind it. Only the wrapper names that in GLAEDA_GH_REAL, so a call
    # that reached the broker another way (`glaeda-gh gh ...` typed directly, the daemon's own reads) found the
    # distribution's /usr/bin/gh next, which is signed in to nothing: cloud-item-5 on gcp-codex-lane-1, 2026-11-01,
    # `glaeda-gh gh api repos/O/R/issues/N/comments` answered "To get started with GitHub CLI, please run: gh auth
    # login". Where the chain exists it is the real gh.
    lane = lane_vm_gh()
    if lane is not None:
        return lane
    on_path = [Path(entry) / "gh" for entry in os.environ.get("PATH", "").split(os.pathsep) if entry]
    elsewhere = [Path.home() / ".local/bin/gh", Path("/opt/homebrew/bin/gh"),
                 Path("/usr/local/bin/gh"), Path("/usr/bin/gh")]
    for candidate in on_path + elsewhere:
        if candidate.is_dir() or not os.access(candidate, os.X_OK) or broker_is_wrapper(candidate):
            continue
        return str(candidate)
    raise WatchError("no real gh found on PATH")


def broker_plan(args: list[str], now: float) -> tuple[str, str | None, str | None]:
    """(route, payload, key). route is 'serve', 'refuse' or 'pass'. Pure: no watch is registered and
    nothing is written, so a test can read the decision without touching the daemon's state."""
    words, method, seen, values = broker_words(args)
    if (words and words[0] == "api" and method == "GET" and not broker_elsewhere(values)
            and not os.environ.get("GLAEDA_GH_ALLOW_API_SOURCE")):
        # Only a GET reads source. A POST is a write, and `-f`/`-F` make gh POST without `-X`,
        # which is why the method is read from the whole command line rather than assumed.
        refusal = broker_source_refusal(words)
        if refusal:
            return "refuse", refusal, None
    head = " ".join(words[:2])
    count_only = seen - BROKER_SAFE_FLAGS
    if head not in ("pr view", "run view") or count_only - BROKER_COUNT_ONLY_FLAGS:
        return "pass", None, None
    if any(flag in seen and flag not in values for flag in BROKER_SAFE_FLAGS | count_only):
        # `--json`, `--repo` or `--jq` with no value: gh errors, so never answer or count it
        return "pass", None, None
    kind = "pr" if head == "pr view" else "run"
    table = BROKER_PR_FIELDS if kind == "pr" else BROKER_RUN_FIELDS
    fields = broker_fields(values, table, args)
    key = broker_target(words, values, kind)
    if fields is None or key is None:
        # Nothing to gain from watching a target the cache could not have answered anyway.
        return "pass", None, None
    if count_only:
        # `--jq`: the cache holds every field asked for, but not gh's filter. Counted, never served.
        return "pass", None, key
    line = broker_serve(key, fields, table, now)
    if line is not None and sys.stdout.isatty():
        # Real gh indents and colours `--json` output when stdout is a tty; this prints the compact
        # json.dumps. Answering a person's interactive call would be the same data in a different
        # shape, so what "byte-for-byte" means stays true by not answering it. A tty is a person,
        # not the polling that drains the quota, so there is nothing to save here anyway.
        return "pass", None, key
    return ("serve", line, key) if line is not None else ("pass", None, key)


# -- the answer cache: identical read-only calls within GH_CACHE_TTL share one request
#
# The daemon's cache above answers only `pr view`/`run view --json` with the fields it already
# holds. Most repeated reads are not that shape: a `gh api .../jobs --jq ...`, a `pr view 7` with a
# field the daemon does not keep, a `run view 12 --log-failed`. Measured on one host, 38% of `pr
# view` calls re-read the same PR within 90 s, mostly another session asking the same question. So
# the broker also keeps whole answers -- stdout, stderr and the exit code of one real gh run --
# keyed on the exact arguments plus everything else that can change what gh prints, and hands an
# identical call the same bytes for GH_CACHE_TTL seconds.
#
# Only reads are kept (`pr view`, `run view`, `gh api` GET, and a `gh api graphql` query -- never a
# mutation -- keyed on its query text and variables in any order), only answers that exited 0, only
# from a stdout that is not a terminal (gh prints a person a different shape), and never a
# `--web` or `--watch`. Any call that might write -- every subcommand not on GH_CACHE_PURE, every
# non-GET `gh api`, and a GraphQL call carrying a mutation -- stamps the time for its repository
# (or for all of them when it names none), and an answer older than that stamp is not served: this
# host's own write is never answered with what it read just before. A write from another host is
# bounded by the TTL, which is the trade this makes.
#
# A write is stamped no wider than what it can change (gh_cache_write_scope): a comment on PR 7
# stamps PR 7 and the repository's lists, not every answer the host holds for the repository. Until
# 2026-10-31 every write stamped its whole repository, and on cosmic-gray a write to manaflow-ai/cmux
# came about every 30 s (comments, dispatches, reruns, merges), so most answers were thrown away
# before anyone asked again: 1,000 of 17,090 calls were answered here over 8 hours, against 40% of
# reads repeating within 90 s. Replaying that host's log, scoping alone took the PR and run reads
# answered here from 12% to 16%, and the 90 s window to 18%.
#
# Each answer about one PR or run also remembers what glaeda's daemon held for that target when it
# was read (gh_cache_watch). The daemon reads its watched targets every cycle and hears the
# controller's webhooks within a tick, so when its copy changes the answer is dropped at once, from
# whichever host the change came; and a completed run the daemon still watches, unchanged since the
# answer, is kept for GH_CACHE_DONE_TTL, because a rerun would show up there first.
#
# Identical calls arriving together are filled once: the first takes the key's lock and runs gh,
# the rest wait up to GH_CACHE_FILL_WAIT on that lock and then read its answer. Identical means the
# same question, not the same bytes (gh_cache_canonical): `-R O/R --json b,a` and `--json=a,b
# --repo o/r` share one answer and one fill.
GH_CACHE_TTL = 90.0  # the window cosmic-gray's repeats fall in (glaeda-gh audit: AUDIT_WINDOW)
# The head-read budget's consumer for the commits whose checks the broker sees read twice (cmd_gh): one shared
# daemon read in place of every session's REST pages. Its hourly budget is the consumer budget every head has.
BROKER_HEAD_CONSUMER = "gh-broker"
# An answer that cannot change: a completed job, a completed attempt's jobs, or a completed run the
# daemon still watches and has seen no change in. As long as an answer is kept at all (GH_CACHE_KEEP).
GH_CACHE_DONE_TTL = float(TERMINAL_REFRESH)
GH_CACHE_MAX_BYTES = 2 * 1024 * 1024  # a bigger answer (a whole log) is passed on, not stored
GH_CACHE_FILL_WAIT = 30.0
GH_CACHE_KEEP = 600.0  # stored answers older than this are deleted
GH_CACHE_PRUNE_EVERY = 60.0
GH_CACHE_DRAIN = 3.0  # after a fill is killed, how long its pipes are read before they are dropped
GH_CACHE_FILL_DEADLINE = 600.0
GH_CACHE_LOCK_KEEP = 3600.0  # a fill lock file is removed this long after its last use  # a filling gh still running after this is killed with its process group
GH_CACHE_DEBUG_ENV = ("GH_DEBUG", "DEBUG")  # gh prints request headers under these: never stored
# What changes the bytes gh prints for the same arguments: colour, a forced tty, the markdown style,
# the width. Part of the key, so a caller is never handed output rendered for another.
GH_CACHE_OUTPUT_ENV = ("GH_FORCE_TTY", "CLICOLOR_FORCE", "CLICOLOR", "NO_COLOR", "GLAMOUR_STYLE",
                       "GH_MDWIDTH", "COLUMNS", "TERM", "GH_PAGER", "PAGER", "LANG", "LC_ALL",
                       "GH_NO_UPDATE_NOTIFIER", "GH_SPINNER_DISABLED", "GH_PROMPT_DISABLED")
GH_CACHE_READS = {("pr", "view"), ("run", "view")}  # and `api` GET
# Reads of one object named on the line, kept like `pr view` -- but only when that object is a number
# or a github.com URL, and nothing else is a positional word. With no target gh reads the checked-out
# branch's PR, which is not on the line, and a value flag this does not know (`pr diff --color never`)
# would read as one: either way two worktrees on different branches would share an answer.
GH_CACHE_TARGETED = {("pr", "checks"), ("pr", "diff"), ("issue", "view")}
GH_CACHE_TARGET_RE = re.compile(rf"^(?:\d+|https://github\.com/{NAME}/{NAME}/(?:pull|issues)/\d+/?)$")
# Lists, which read no branch: the repository gh resolves is in the key (broker_repo), the rest is on the
# line. Measured on cosmic-gray over 20,000 calls (2026-10-29), the reads repeated most within 90 s:
# `issue list` 82%, `pr list` 64%, `search prs` 61%, `run list` 46% -- none of which this kept before.
GH_CACHE_LISTS = {("pr", "list"), ("issue", "list"), ("run", "list"), ("label", "list"),
                  ("release", "list"), ("workflow", "list")}
# `gh search` asks GitHub's search index, never the working directory's repository, so it needs none.
GH_CACHE_ANYWHERE = {"search"}
# Flags that make gh print data rather than a rendered view: with stdout not a terminal and nothing
# forcing one, what it prints then does not depend on the width, the terminal, the locale, the pager
# or the markdown style, so those are left out of the key and sessions with different terminals share
# one answer. Colour can still be forced on a pipe, so the forcing variables stay in.
GH_CACHE_DATA_FLAGS = {"--json", "-q", "--jq", "-t", "--template"}
GH_CACHE_FORCE_ENV = ("GH_FORCE_TTY", "CLICOLOR_FORCE", "CLICOLOR", "NO_COLOR")
# A finished job's log never changes (a rerun is a new job id), and it is the read a lane repeats while
# it works out why something failed: kept for GH_CACHE_KEEP, not GH_CACHE_TTL.
GH_CACHE_LONG_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/{NAME}/{NAME}/actions/jobs/\d+/logs/?$")
GH_CACHE_LONG_TTL = 600.0
GH_CACHE_NEVER = {"--web", "-w", "--watch", "--verbose", "--include", "-i"}
# (subcommand, verb) pairs that never write; `None` as the verb is every verb of that subcommand.
# A call not named here stamps a write. Listing reads rather than writes is deliberate: a write gh
# adds next year then clears the cache instead of being answered from it.
GH_CACHE_PURE = {
    ("pr", "view"), ("pr", "list"), ("pr", "checks"), ("pr", "diff"), ("pr", "status"),
    ("run", "view"), ("run", "list"), ("run", "watch"), ("run", "download"),
    ("issue", "view"), ("issue", "list"), ("issue", "status"), ("repo", "view"), ("repo", "list"),
    ("release", "view"), ("release", "list"), ("release", "download"), ("workflow", "view"),
    ("workflow", "list"), ("label", "list"), ("cache", "list"), ("search", None), ("auth", "status"), ("auth", "token"),
    ("status", None), ("browse", None), ("help", None), ("version", None), ("--version", None),
}
GH_CACHE_REPO_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})(?:[/?]|$)")
GH_CACHE_MUTATION_RE = re.compile(r"\bmutation\b")
# What one answer is about, read off an API path: a PR or issue (one number space), a run, or a job.
GH_CACHE_API_PR_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/(?:pulls|issues)/(\d+)(?:[/?]|$)")
GH_CACHE_API_RUN_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/runs/(\d+)(?:[/?]|$)")
GH_CACHE_API_JOB_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/jobs/(\d+)(?:[/?]|$)")
# One commit's checks: its check runs, combined status, statuses or check suites, by full sha. Kept as a "head" answer:
# made old by a write that can start or rerun a check (the "heads" scope), not by every comment or update-branch on the
# repository, and checked against glaeda's own read of that head (`glaeda-gh checks`) when the daemon holds it.
GH_CACHE_API_HEAD_RE = re.compile(
    rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/commits/([0-9a-fA-F]{{40}})/"
    r"(?:check-runs|check-suites|status|statuses)/?(?:\?|$)")
GH_CACHE_PR_URL_RE = re.compile(rf"^https://github\.com/({NAME})/({NAME})/(?:pull|issues)/(\d+)/?$")
# Lists of workflow runs: the REST reads repeated most on cosmic-gray (1,092 of 1,400 within 90 s over
# 8 hours, 2026-10-30), which a comment or a label cannot change.
GH_CACHE_API_RUNS_LIST_RE = re.compile(
    rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/(?:workflows/[^/?]+/)?runs/?(?:\?.*)?$")
# Reads that never change what GitHub holds, so they stamp nothing. `auth git-credential` is git
# asking gh for a password on every https fetch: it stamped every answer on the host, about once
# every 40 minutes on cosmic-gray.
GH_CACHE_PURE |= {("auth", "git-credential"), ("variable", "list"), ("variable", "get"), ("secret", "list"),
                  ("ruleset", "list"), ("ruleset", "view"), ("gist", "view"), ("gist", "list")}
# Boolean flags the canonical form may move: with every flag on a line known to take a value or not,
# reordering them cannot attach a value to the wrong flag. A flag in neither list keeps the line as
# typed (gh_cache_canonical returns None), which costs an answer, never a wrong one.
GH_CACHE_BOOL_FLAGS = {"--log", "--log-failed", "--exit-status", "--paginate", "--slurp", "--name-only",
                       "--patch", "--comments", "--required", "--verbose", "--include", "--silent",
                       "--web", "--watch", "--fail-fast"}
# Not `-i`, `-w` or any other one-letter flag: `-i` is `--include` to `gh api` and `--interval VALUE` to
# `gh pr checks`, so a short flag's arity depends on the command and the line is kept as typed.
# Two spellings of one flag, beyond the pair broker_words knows: only those that mean the same in
# every read gh has. `-b` is `--body` in one command and `--branch` in another, so it stays as typed;
# `-f` and `-F` are not aliases (a string and a typed value) and stay apart.
GH_CACHE_FLAG_ALIAS = {**BROKER_FLAG_ALIAS, "-q": "--jq", "-t": "--template", "-L": "--limit", "-H": "--header",
                       "-f": "--raw-field", "-F": "--field"}
# Request fields, string or typed: one ordered group, because gh sends them in the order given and the
# last of a repeated name wins whichever of the two spellings carried it. Sorting them apart by flag
# name answered `-f state=open --raw-field state=closed` with `--raw-field state=closed -f state=open`.
GH_CACHE_FIELD_GROUP = {"--raw-field", "--field"}
# The subcommand verbs that change one PR or issue named on the line, and nothing else about the
# repository but its lists.
GH_CACHE_TARGET_WRITES = {"comment", "edit", "ready", "close", "reopen", "review", "lock", "unlock"}
# `gh run` verbs that change one run named on the line (a rerun, or stopping it). This only reads the
# caller's command line to decide what to invalidate; the broker runs that write as it was typed.
GH_CACHE_RUN_WRITES = {"rerun", "cancel"}
# Verbs that change one PR and, through the base branch, every other PR's mergeability.
GH_CACHE_BASE_WRITES = {"merge"}
# Verbs that move one PR's head and nothing else: `update-branch` merges the base into the PR's own
# branch, so the base -- and every other PR's mergeability -- is what it was. Until 2026-11-17 it was
# stamped as a base write, and on one lane VM the land loop's 471 update-branch calls a day dropped
# every PR answer of manaflow-ai/cmux each time. A stacked PR whose base is this PR's branch can see its
# mergeability move; that is bounded by the TTL and the daemon's watch, as a push from another host is.
GH_CACHE_HEAD_WRITES = {"update-branch"}
# The flags of those writes, by whether they take a value, so their one positional word (the PR) can
# be found. A write carrying a flag in neither set is stamped as wide as before.
GH_CACHE_WRITE_VALUE_FLAGS = BROKER_VALUE_FLAGS | {
    "--match-head-commit", "--subject", "--author-email", "--add-label", "--remove-label", "--milestone",
    "--add-reviewer", "--remove-reviewer", "--add-assignee", "--remove-assignee", "--add-project",
    "--remove-project", "-r", "-a", "-m", "-T", "--template", "-e", "--comment", "-c", "--reason"}
GH_CACHE_WRITE_BOOL_FLAGS = {
    "--squash", "-s", "--merge", "--rebase", "--auto", "--disable-auto", "--delete-branch", "-d", "--admin",
    "--approve", "--request-changes", "--undo", "--yes", "--edit-last", "--create-if-none", "--delete-last",
    "--draft", "--failed", "--debug", "--force", "--remove-milestone", "--fill", "--fill-first",
    "--fill-verbose", "--no-maintainer-edit", "--dry-run", "--editor", "--web", "-w"}


# -- vouched `pr view` answers: kept while the PR's head and updatedAt stay what they were
#
# Agent sessions type `gh pr view` by hand -- with a number, a branch, or no target at all (the checked-out branch's
# PR), with and without `--json` -- and keep typing it while they wait: on 2026-11-17 15:30-17:30Z the gh-quota logs on
# four agent hosts held 140 such charged reads (70 an hour), many minutes apart, past
# GH_CACHE_TTL. Each reads the same answer as the one before whenever the PR has not changed, and GitHub moves a PR's
# updatedAt on every push, comment, review, label, title or body edit, state change and review request: everything
# plain `pr view` prints except its `projects:` line and, unproven, its `auto-merge:` line. Replaying those 140 calls
# against each PR's real change times: 110 still reach GitHub (the 90 s cache alone: 120; a perfect oracle: 95), since
# 20 are a merge's own preflight, 35 read a branch with no PR (gh exits 1: nothing is kept), and most of the rest
# follow the session's own push or comment.
#
# So a `pr view` answer whose output depends only on what moves updatedAt or the head (GH_CACHE_VOUCH_UNSAFE names the
# `--json` fields that move without them: checks, mergeability against the base, review decision, auto-merge,
# projects) remembers the head and updatedAt it was read at ("vouch"), and is answered again for GH_CACHE_VOUCH_KEEP as
# long as glaeda's daemon holds that PR at the same head and updatedAt, read from GitHub in the last
# GH_CACHE_VOUCH_FRESH seconds (updatedAtAt: a whole GraphQL read, a probe, or a confirming first page), and no write
# from this host touched it since. Anything else reads afresh, as before. The vouch comes from the answer itself when
# it prints both (`--json headRefOid,updatedAt,...`), else from what the daemon held just before gh ran: a vouch older
# than the answer can only drop it early, never keep it past a change.
#
# Never for a gate: a caller that set GLAEDA_GH_CACHE_TTL (land_judge, land_ready, merge recovery) or a landing read
# (GH_QUOTA_LANDING_READ) asked for GitHub within its own bound, and gets the TTL rules alone. A write or a merge never
# reads the answer cache at all (gh_cache_write).
GH_CACHE_VOUCH_KEEP = 3600.0
GH_CACHE_VOUCH_FRESH = BROKER_MAX_AGE
# `pr view --json` fields whose value can change while the head and updatedAt stay: a check finishing, the base moving
# (mergeable, mergeStateStatus, baseRefOid, potentialMergeCommit), branch protection (reviewDecision), the merge queue,
# auto-merge, project boards, reactions, and issues that link the PR from their own side.
GH_CACHE_VOUCH_UNSAFE = {"statusCheckRollup", "mergeable", "mergeStateStatus", "reviewDecision", "autoMergeRequest",
                         "projectCards", "projectItems", "potentialMergeCommit", "baseRefOid", "isInMergeQueue",
                         "isMergeQueueEnabled", "reactionGroups", "closingIssuesReferences"}
# The flags a vouched `pr view` may carry. `--web` never reaches here (GH_CACHE_NEVER); anything else is passed on.
GH_CACHE_VOUCH_FLAGS = {"--repo", "--json", "--jq", "--template", "--comments"}
GH_CACHE_VOUCH_URL_RE = re.compile(rf"^url:\thttps://github\.com/({NAME})/({NAME})/pull/(\d+)$", re.M)


def gh_cache_vouch_gate() -> bool:
    """Whether this caller may be answered by a vouch: not a gate that bounds its own staleness."""
    return "GLAEDA_GH_CACHE_TTL" not in os.environ and not os.environ.get("GH_QUOTA_LANDING_READ")


def gh_cache_vouch_shape(words: list[str], values: dict[str, str], seen: set[str]) -> bool:
    """A `pr view` whose output the PR's head and updatedAt decide: plain, or `--json` fields none of which moves
    without them, with no flag but GH_CACHE_VOUCH_FLAGS."""
    if tuple(words[:2]) != ("pr", "view") or len(words) > 3:
        return False
    if {BROKER_FLAG_ALIAS.get(f, f) for f in seen} - GH_CACHE_VOUCH_FLAGS - {"-q", "-t"}:
        return False
    fields = {f for f in (values.get("--json") or "").split(",") if f}
    if "--json" in seen and not fields:
        return False
    return not fields & GH_CACHE_VOUCH_UNSAFE


def gh_cache_vouch_held(daemon_key: str, now: float | None = None) -> tuple[str, str] | None:
    """(headRefOid, updatedAt) glaeda's daemon holds for one PR, when it read them from GitHub together
    (updatedAtAt) and, with `now`, no longer ago than GH_CACHE_VOUCH_FRESH; None otherwise. Never raises."""
    try:
        entry = read_cache(daemon_key)
    except Exception:  # noqa: BLE001  a lookup in front of a gh call
        return None
    if not isinstance(entry, dict) or entry.get("error") or not isinstance(entry.get("data"), dict):
        return None
    seen_at, data = entry.get("updatedAtAt"), entry["data"]
    if not isinstance(seen_at, (int, float)) or isinstance(seen_at, bool):
        return None
    if now is not None and not 0 <= now - seen_at <= GH_CACHE_VOUCH_FRESH:
        return None
    head, upd = data.get("headRefOid"), data.get("updatedAt")
    return (head, upd) if isinstance(head, str) and head and isinstance(upd, str) and upd else None


def gh_cache_answer_pr(out: bytes, repo: str | None) -> tuple[str | None, tuple[str, str] | None]:
    """(the daemon key of the PR an answer is about, (head, updatedAt) when it prints both), read off what gh printed:
    a `--json` object's url (or number, in `repo`), or plain `pr view`'s url line. (None, None) when it says neither."""
    text = out.decode("utf-8", "replace")
    try:
        doc = json.loads(text)
    except ValueError:
        doc = None
    if isinstance(doc, dict):
        key = None
        match = GH_CACHE_PR_URL_RE.match(str(doc.get("url") or ""))
        if match and "/pull/" in str(doc.get("url")):
            key = f"pr:{match.group(1).lower()}/{match.group(2).lower()}#{int(match.group(3))}"
        elif isinstance(doc.get("number"), int) and not isinstance(doc.get("number"), bool) and repo:
            key = f"pr:{repo.lower()}#{doc['number']}"
        head, upd = doc.get("headRefOid"), doc.get("updatedAt")
        own = (head, upd) if isinstance(head, str) and head and isinstance(upd, str) and upd else None
        return key, own
    match = GH_CACHE_VOUCH_URL_RE.search(text)
    if match:
        return f"pr:{match.group(1).lower()}/{match.group(2).lower()}#{int(match.group(3))}", None
    return None, None


def gh_cache_branch_state() -> list[str] | None:
    """What gh reads from the working directory to find the checked-out branch's PR: the branch, and the branch,
    remote and push configuration (its upstream, push remote, gh-merge-base). None on a detached head or when git
    cannot say, so a `pr view` with no target is then not kept."""
    try:
        head = subprocess.run(["git", "symbolic-ref", "-q", "--short", "HEAD"], capture_output=True, text=True,
                              timeout=5, stdin=subprocess.DEVNULL)
        if head.returncode != 0 or not head.stdout.strip():
            return None
        config = subprocess.run(["git", "config", "--get-regexp", r"^(branch|remote|push)\."], capture_output=True,
                                text=True, timeout=5, stdin=subprocess.DEVNULL)
        if config.returncode not in (0, 1):
            return None
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=5,
                             stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return [head.stdout.strip(), config.stdout, top.stdout.strip()]


def gh_cache_vouch_note(meta: dict, words: list[str], values: dict[str, str], seen: set[str], repo: str | None,
                        key: str) -> None:
    """Before gh runs: the PR this answer is likely about (the line's own target, or the PR the last answer for this
    key named) and what the daemon holds for it now, kept in `meta` for gh_cache_vouch_after. No-op for a shape that
    cannot be vouched."""
    if not gh_cache_vouch_shape(words, values, seen):
        return
    meta["vouchable"] = True
    target = gh_cache_target(words, values, repo)
    pr = f"pr:{target[1]}#{int(target[2])}" if target and target[0] == "pr" else None
    if pr is None:
        prior = read_json(gh_cache_dir() / f"{key}.json")
        pr = prior.get("pr") if isinstance(prior, dict) and isinstance(prior.get("pr"), str) else None
    held = gh_cache_vouch_held(pr) if pr else None
    if pr:
        meta["prBefore"] = pr
    if held:
        meta["heldBefore"] = list(held)


def gh_cache_vouch_after(meta: dict, out: bytes, repo: str | None, explicit: bool) -> str | None:
    """After gh answered: settle the vouch in `meta` (the answer's own head and updatedAt, else what the daemon held
    before the read for the same PR) and return the PR's daemon key, or None when the answer names no PR it can be
    tied to. `explicit`: the line named the PR, so an answer that prints no url is still about it."""
    before = meta.pop("prBefore", None)
    held = meta.pop("heldBefore", None)
    if not meta.pop("vouchable", False):
        return None
    pr, own = gh_cache_answer_pr(out, repo)
    if pr is None and explicit:
        pr = before
    if pr is None:
        return None
    meta["pr"] = pr
    if isinstance(meta.get("stamps"), list):
        # A write from this host to that PR makes the answer old however the line named it (a branch, no target).
        _kind, owner, name, number = split_key(pr)
        meta["stamps"] = list(dict.fromkeys(meta["stamps"] + (gh_cache_stamps(["pr", f"{owner}/{name}", str(number)],
                                                                             f"{owner}/{name}") or [])))
    if own is not None:
        meta["vouch"] = [pr, *own]
    elif held and pr == before:
        meta["vouch"] = [pr, *held]
    return pr


def gh_cache_vouched(doc: dict, now: float) -> bool:
    """Whether a kept answer's vouch still holds: the daemon holds its PR, freshly read, at the same head and
    updatedAt, and the answer is younger than GH_CACHE_VOUCH_KEEP. The caller checks the write stamps."""
    vouch = doc.get("vouch")
    if not (isinstance(vouch, list) and len(vouch) == 3 and all(isinstance(x, str) for x in vouch)):
        return False
    if not gh_cache_vouch_gate() or not 0 <= now - float(doc["at"]) < GH_CACHE_VOUCH_KEEP:
        return False
    return gh_cache_vouch_held(vouch[0], now) == (vouch[1], vouch[2])


def gh_cache_dir() -> Path:
    return BASE / "answers"


def gh_cache_ttl() -> float:
    """GLAEDA_GH_CACHE_TTL seconds (0 turns the cache off), else GH_CACHE_TTL."""
    try:
        ttl = float(os.environ.get("GLAEDA_GH_CACHE_TTL") or GH_CACHE_TTL)
    except ValueError:
        return GH_CACHE_TTL
    return ttl if 0 <= ttl <= 3600 else GH_CACHE_TTL


def gh_cache_repo(words: list[str], values: dict[str, str]) -> str | None:
    """The repository a call is about, lowercased, when the line says so; None when it does not."""
    repo = values.get("--repo") or ""
    if re.fullmatch(rf"{NAME}/{NAME}", repo):
        return repo.lower()
    if words and words[0] == "api" and len(words) > 1:
        match = GH_CACHE_REPO_RE.match(words[1])
        return f"{match.group(1)}/{match.group(2)}".lower() if match else None
    for word in words[2:3]:
        match = re.match(rf"^https://github\.com/({NAME})/({NAME})/", word)
        if match:
            return f"{match.group(1)}/{match.group(2)}".lower()
    return None


def gh_cache_opaque(args: list[str]) -> bool:
    """Whether part of a `gh api` request comes from somewhere not on the line: `--input`, or a typed
    field whose value is `@FILE`."""
    for i, arg in enumerate(args):
        if arg == "--input" or arg.startswith("--input="):
            return True
        value = None
        if arg in ("-F", "--field") and i + 1 < len(args):
            value = args[i + 1]
        elif arg.startswith("--field="):
            value = arg[len("--field="):]
        elif arg.startswith("-F") and len(arg) > 2:
            value = arg[2:]
        if value is not None and value.partition("=")[2].startswith("@"):
            return True
    return False


def gh_cache_anywhere(words: list[str]) -> bool:
    """A read whose answer does not depend on which repository the working directory is in."""
    return bool(words) and words[0] in GH_CACHE_ANYWHERE


def gh_cache_is_write(args: list[str], words: list[str], method: str) -> bool:
    """Whether this call may change something on GitHub. Unknown counts as a write."""
    first, second = (words + ["", ""])[:2]
    if first == "api":
        if method != "GET" and not AUDIT_GRAPHQL_RE.match(second):
            return True
        # GraphQL is a POST whether it reads or writes; only the query says which. A body this
        # cannot read (`--input FILE`, `-F query=@FILE`) counts as a write.
        if not AUDIT_GRAPHQL_RE.match(second):
            return False
        return any(GH_CACHE_MUTATION_RE.search(a) for a in args) or gh_cache_opaque(args)
    if not first:
        return False  # bare `gh`, or only flags: help
    return (first, second) not in GH_CACHE_PURE and (first, None) not in GH_CACHE_PURE


def gh_cache_identity(real: str | None, data: bool = False) -> str:
    """A digest of who gh will be and which gh it is: any token in the environment, the config
    directory and the contents of its hosts.yml (the active account; `gh auth switch` rewrites it),
    and the real gh's path. Only the digest is kept, never a token. With `data` (gh prints JSON or a
    template to a pipe: GH_CACHE_DATA_FLAGS), only the variables that can force a terminal's output
    onto a pipe are in it, not the whole output environment."""
    parts = [os.environ.get(name) or "" for name in ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN",
                                                       "GITHUB_ENTERPRISE_TOKEN", "GH_CONFIG_DIR")]
    hosts = gh_hosts_file()
    try:
        parts.append(hosts.read_text() if hosts is not None else "")
    except OSError:
        parts.append("?")
    parts.append(real or "")
    output = GH_CACHE_FORCE_ENV if data and not any(os.environ.get(n) for n in ("GH_FORCE_TTY", "CLICOLOR_FORCE")) \
        else GH_CACHE_OUTPUT_ENV
    parts += [f"{name}={os.environ.get(name, '')}" for name in output]
    return hashlib.sha256("\0".join(parts).encode()).hexdigest()


def gh_cache_key(args: list[str], words: list[str], values: dict[str, str], seen: set[str],
                 method: str, real: str | None = None) -> str | None:
    """The answer cache's key for this call, or None when it is not a call the cache keeps."""
    if gh_cache_ttl() <= 0 or os.environ.get("GLAEDA_GH_CACHE_DISABLE") == "1" or sys.stdout.isatty() \
            or any(os.environ.get(name) for name in GH_CACHE_DEBUG_ENV):
        return None
    head = tuple(words[:2])
    branch: list[str] | None = None
    graphql = head[:1] == ("api",) and len(words) > 1 and bool(AUDIT_GRAPHQL_RE.match(words[1]))
    if graphql:
        # A GraphQL read is a POST, so the method says nothing: the query does. gh_cache_is_write
        # calls a mutation, or a body read from a file, a write; anything else is a read.
        if gh_cache_is_write(args, words, method):
            return None
    elif head[:1] == ("api",):
        if method != "GET" or len(words) < 2 or BROKER_FREE_RE.match(words[1]):
            return None
    elif head in GH_CACHE_TARGETED:
        if len(words) != 3 or not GH_CACHE_TARGET_RE.match(words[2]):
            return None  # see GH_CACHE_TARGETED
    elif head in GH_CACHE_LISTS or gh_cache_anywhere(words):
        pass
    elif head == ("pr", "view") and len(words) == 2:
        # No target: gh reads the checked-out branch's PR. Kept only in the shape a vouch can hold (gh_cache_vouch),
        # keyed on what gh reads to find that PR (gh_cache_branch_state), so another branch or worktree is another key.
        if not gh_cache_vouch_shape(words, values, seen):
            return None
        branch = gh_cache_branch_state()
        if branch is None:
            return None
    elif head not in GH_CACHE_READS or len(words) < 3:
        return None
    if seen & GH_CACHE_NEVER:
        return None
    # The repository gh resolves from the working directory when the line names none, and the
    # `{owner}`/`{repo}`/`{branch}` placeholders `gh api` fills from it, make the directory part of
    # the question. The token is too (an installation token sees other repositories than the
    # user's), so its digest is in the key; the token itself is never written anywhere.
    if any("{branch}" in a for a in args) or gh_cache_opaque(args):
        return None  # the checked-out branch, or a file's contents: neither is on the line
    placeholders = any(p in a for a in args for p in ("{owner}", "{repo}"))
    resolved = None
    if placeholders or (head[:1] != ("api",) and not gh_cache_anywhere(words)
                        and gh_cache_repo(words, values) is None):
        # gh fills these from the working directory's checkout. Keyed on the repository that
        # resolves to, by broker_repo's rule (which declines anything it cannot be sure of), so a
        # directory whose remote changed is a different question.
        resolved = broker_repo(values)
        if resolved is None:
            return None
    # A GraphQL question is its query and variables, in whatever order the flags came: two
    # scripts asking for the same page share one answer.
    question = gh_cache_graphql_question(args) if graphql else (gh_cache_canonical(args) or args)
    data = head[:1] == ("api",) or bool(seen & GH_CACHE_DATA_FLAGS)
    ident = [question, resolved, os.environ.get("GH_REPO") or "", os.environ.get("GH_HOST") or "",
             gh_cache_identity(real, data)]
    if branch is not None:
        ident.append(branch)
    return hashlib.sha256(json.dumps(ident).encode()).hexdigest()[:40]


GH_CACHE_FIELD_FLAGS = {"-f": "f", "--raw-field": "f", "-F": "F", "--field": "F"}


def gh_cache_graphql_question(args: list[str]) -> list:
    """[fields as `f:name=value` / `F:name=value`, every other argument in order]. The kind stays in
    each field because `-F n=1` sends a number and `-f n=1` a string."""
    fields, other, i = [], [], 0
    while i < len(args):
        arg = args[i]
        name, eq, value = arg.partition("=")
        if arg in GH_CACHE_FIELD_FLAGS and i + 1 < len(args):
            fields.append(f"{GH_CACHE_FIELD_FLAGS[arg]}:{args[i + 1]}")
            i += 2
            continue
        if eq and name in ("--raw-field", "--field"):
            fields.append(f"{GH_CACHE_FIELD_FLAGS[name]}:{value}")
        elif arg[:2] in ("-f", "-F") and len(arg) > 2:
            fields.append(f"{arg[1]}:{arg[2:]}")
        else:
            other.append(arg)
        i += 1
    # gh keeps the last of a repeated field and sends `name[]` fields as an array in order, so a field
    # name that repeats makes the order part of the question: sorted only when every name is unique.
    names = [f[2:].partition("=")[0] for f in fields]
    if len(set(names)) == len(names) and not any(n.endswith("[]") for n in names):
        fields = sorted(fields)
    return [fields, other]


# What a GraphQL read is about, read off its query and variables (gh_cache_graphql_scope). Root fields that can reach
# any repository, or none named on the line: a query using one stays unscoped, so every write on the host still makes
# it old. `node(`/`nodes(` need their parenthesis: a connection's `nodes { ... }` is no lookup.
GH_CACHE_GRAPHQL_ANYWHERE_RE = re.compile(
    r"\b(?:node|nodes|user|organization|repositoryOwner|enterprise|resource|topic|codeOfConduct|license|"
    r"securityAdvisory|securityAdvisories|securityVulnerabilities|sponsorables|marketplaceListing)\s*\(|\bviewer\b")
GH_CACHE_GRAPHQL_REPO_RE = re.compile(r"\brepository\s*\(([^)]*)\)")
GH_CACHE_GRAPHQL_SEARCH_RE = re.compile(r"\bsearch\s*\(([^)]*)\)")
GH_CACHE_GRAPHQL_ONE_RE = re.compile(r"\b(?:pullRequest|issue|issueOrPullRequest)\s*\(([^)]*)\)")
GH_CACHE_GRAPHQL_MANY_RE = re.compile(r"\b(?:pullRequests|issues|refs|ref|object|commit|defaultBranchRef|"
                                      r"discussions?|releases?|deployments|milestones?|labels|projects?)\b")
GH_CACHE_GRAPHQL_SEARCH_REPO_RE = re.compile(rf"(?:^|\s)repo:({NAME}/{NAME})(?=\s|$)")


def gh_cache_graphql_scope(args: list[str]) -> tuple[str | None, list | None]:
    """(repository, target) a GraphQL read is about: the one repository every `repository(...)` and `search(...)` in
    its query names, by literal or by a variable on the line (`-f owner=o -f name=r`, a search string's `repo:o/r`),
    and, when the query reads exactly one PR or issue of it and nothing else of the repository, ["pr", repo, N]. (None,
    None) when it names none, more than one, any it cannot resolve, or a root field that can read anywhere (node,
    viewer, user, ...): such an answer is made old by every write on the host, as before. A read scoped here is made
    old only by a write to its repository (or one naming none), as a REST read of that repository is; until
    2026-11-17 every GraphQL read was dropped by any write anywhere, and a lane VM's land loop writes every 30 s."""
    fields, _other = gh_cache_graphql_question(args)
    variables: dict[str, str] = {}
    query = None
    for field in fields:
        name, _eq, value = field[2:].partition("=")
        if name == "query":
            if query is not None:
                return None, None  # gh sends the last one; two are not worth reasoning about
            query = value
        else:
            variables[name] = value
    if not query or GH_CACHE_MUTATION_RE.search(query) or GH_CACHE_GRAPHQL_ANYWHERE_RE.search(query):
        return None, None

    def resolve(text: str) -> str | None:
        text = text.strip()
        if text.startswith("$"):
            return variables.get(text[1:])
        if len(text) >= 2 and text[0] == text[-1] == '"':
            return text[1:-1]
        return None

    def arguments(text: str) -> dict[str, str | None]:
        found: dict[str, str | None] = {}
        for match in re.finditer(r'(\w+)\s*:\s*("(?:[^"\\]|\\.)*"|\$\w+|[\w.-]+)', text):
            found[match.group(1)] = resolve(match.group(2)) if match.group(2)[0] in '"$' else match.group(2)
        return found

    repos: set[str] = set()
    for match in GH_CACHE_GRAPHQL_REPO_RE.finditer(query):
        said = arguments(match.group(1))
        owner, name = said.get("owner"), said.get("name")
        if not owner or not name or not re.fullmatch(NAME, owner) or not re.fullmatch(NAME, name):
            return None, None
        repos.add(f"{owner}/{name}".lower())
    searches = list(GH_CACHE_GRAPHQL_SEARCH_RE.finditer(query))
    for match in searches:
        text = arguments(match.group(1)).get("query")
        named = GH_CACHE_GRAPHQL_SEARCH_REPO_RE.findall(text or "")
        if len(named) != 1 or re.search(r"(?:^|\s)(?:org|user|owner|repo):", GH_CACHE_GRAPHQL_SEARCH_REPO_RE.sub(" ", text)):
            return None, None  # several repositories, or an owner-wide qualifier besides the one repo
        repos.add(named[0].lower())
    if len(repos) != 1:
        return None, None
    repo = repos.pop()
    if searches:
        return repo, None
    ones = list(GH_CACHE_GRAPHQL_ONE_RE.finditer(query))
    if len(ones) != 1:
        return repo, None
    number = arguments(ones[0].group(1)).get("number")
    if not number or not re.fullmatch(r"\d+", number):
        return repo, None
    # One PR, and nothing else of the repository read beside it (a list, a ref, a commit): the query with that PR's
    # own selection set taken out must read nothing more of the repository.
    start = query.find("{", ones[0].end())
    depth, end = 0, -1
    for i in range(start, len(query)) if start >= 0 else ():
        depth += {"{": 1, "}": -1}.get(query[i], 0)
        if depth == 0:
            end = i
            break
    if end < 0:
        return repo, None
    outside = query[:ones[0].start()] + query[end + 1:]
    if GH_CACHE_GRAPHQL_MANY_RE.search(outside):
        return repo, None
    return repo, ["pr", repo, str(int(number))]


def gh_cache_answer_repo(args: list[str], words: list[str], values: dict[str, str]) -> str | None:
    """The repository whose writes make a kept answer old; None is every write on the host. A GraphQL read's is the
    one its query names (gh_cache_graphql_scope), never the working directory's: until 2026-11-17 its braces read
    as gh's `{owner}` placeholders, so a query about one repository run in a checkout of another was made old only
    by the checkout's writes, and one run outside a checkout by every write anywhere."""
    if words[:1] == ["api"] and len(words) > 1 and AUDIT_GRAPHQL_RE.match(words[1]):
        return gh_cache_graphql_scope(args)[0]
    if gh_cache_anywhere(words):
        return None  # a search spans repositories, so any write on this host makes its answer old
    return gh_cache_repo(words, values) or (
        None if words[:1] == ["api"] and not any("{" in a for a in args) else broker_repo(values))


def gh_cache_canonical(args: list[str]) -> list | None:
    """The question a non-GraphQL call asks, with the spelling taken out: flags in one order (a flag
    given twice keeps its occurrences in order, since gh keeps the last or appends), each by one
    name, glued values split off, `--repo` and `--json` lists normalised, an API path without its
    host or leading slash and with its query in order, and a PR URL as its number and repository.

    None -- the line is used as typed -- when any flag on it is one this does not know to take a
    value or not, or the line has a `--`: moving such a flag could hand it the next word."""
    words: list[str] = []
    flags: list[tuple[str, str | None]] = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            return None
        if arg.startswith("--") and "=" in arg:
            name, value = arg.split("=", 1)
            if name not in BROKER_VALUE_FLAGS:
                return None
        elif arg.startswith("-") and arg != "-":
            name, value = arg, None
            if not arg.startswith("--") and len(arg) > 2:
                if arg[:2] not in BROKER_VALUE_FLAGS:
                    return None  # `-abc`: several short flags in one word
                name, value = arg[:2], arg[2:]
            elif name in BROKER_VALUE_FLAGS:
                if i + 1 >= len(args):
                    return None  # gh rejects it; keep the line as typed
                value = args[i + 1]
                i += 1
            elif name not in GH_CACHE_BOOL_FLAGS:
                return None
        else:
            words.append(arg)
            i += 1
            continue
        name = GH_CACHE_FLAG_ALIAS.get(name, name)
        if name == "--repo" and value is not None:
            value = value.rstrip("/").lower()
        elif name == "--json" and value is not None:
            # gh prints the fields as one JSON object whose keys Go sorts, so the order asked in and
            # a field asked twice change nothing gh prints.
            value = ",".join(sorted({f for f in value.split(",") if f}))
        flags.append((name, value))
        i += 1
    if words[:1] == ["api"] and len(words) > 1:
        # gh drops a leading slash from a path. The host stays: `https://api.github.com/x` and `x` are
        # one request only when gh's own host is github.com, which this does not decide.
        path = words[1] if "://" in words[1] else words[1].lstrip("/")
        base, mark, query = path.partition("?")
        pairs = [q for q in query.split("&") if q]
        if mark and len({q.partition("=")[0] for q in pairs}) == len(pairs):
            query = "&".join(sorted(pairs))  # a name given twice is an array: order kept
        words[1] = base + (f"?{query}" if mark and query else "")
    elif tuple(words[:2]) in {("pr", "view"), ("pr", "checks"), ("pr", "diff"), ("issue", "view")} \
            and len(words) == 3 and not any(name == "--repo" for name, _ in flags):
        match = GH_CACHE_PR_URL_RE.match(words[2])
        # `issue view` of a pull URL is answered by gh as the PR, and `pr view` of an issues URL is
        # an error: only the URL kind that matches the subcommand is rewritten.
        kind = "issues" if words[0] == "issue" else "pull"
        if match and f"/{kind}/" in words[2]:
            words[2] = match.group(3)
            flags.append(("--repo", f"{match.group(1)}/{match.group(2)}".lower()))
    # Stable: one flag's repeats keep their order, and so do all request fields together.
    flags.sort(key=lambda flag: "--field" if flag[0] in GH_CACHE_FIELD_GROUP else flag[0])
    return ["canonical", words, [list(flag) for flag in flags]]


def gh_cache_target(words: list[str], values: dict[str, str], repo: str | None) -> list | None:
    """[kind, owner/repo, id] for an answer about one PR or issue ("pr"), run ("run") or job ("job"),
    or None for anything else (a list, a search, an endpoint about the repository)."""
    first, second = (words + ["", ""])[:2]
    if first == "api" and len(words) > 1:
        for kind, pattern in (("pr", GH_CACHE_API_PR_RE), ("run", GH_CACHE_API_RUN_RE), ("job", GH_CACHE_API_JOB_RE)):
            match = pattern.match(words[1])
            if match:
                return [kind, f"{match.group(1)}/{match.group(2)}".lower(), match.group(3)]
        match = GH_CACHE_API_HEAD_RE.match(words[1])
        if match:
            return ["head", f"{match.group(1)}/{match.group(2)}".lower(), match.group(3).lower()]
        return None
    if (first, second) in {("pr", "view"), ("pr", "checks"), ("pr", "diff"), ("issue", "view")} and len(words) == 3:
        match = GH_CACHE_PR_URL_RE.match(words[2])
        if match:
            return ["pr", f"{match.group(1)}/{match.group(2)}".lower(), match.group(3)]
        if re.fullmatch(r"\d+", words[2]) and repo:
            return ["pr", repo, str(int(words[2]))]
        return None
    if (first, second) == ("run", "view") and repo:
        if len(words) == 3 and re.fullmatch(r"\d+", words[2]):
            return ["run", repo, words[2]]
        if len(words) == 2 and re.fullmatch(r"\d+", values.get("--job") or ""):
            return ["job", repo, values["--job"]]
    return None


# -- one PR or run read with fewer fields: answered from a kept read of more of them
#
# The answer cache above keys a call on its whole line, so `pr view 7 --json title,headRefOid,...` and,
# a second later, `pr view 7 --json headRefOid --jq .headRefOid` were two questions and two requests.
# Measured on one lane VM (2026-11-17, 24 h of the call log): half of all `pr view` calls (2,028 of
# 4,037) re-read a PR read within 15 s, yet the broker answered 75 of 3,241 it could key, because the
# callers ask for different field sets: land_judge's hold read takes 15 fields, its head read one.
#
# So a `pr view N` or `run view ID` that is nothing but `--json F` (and `-R`), stored, is also indexed by
# its target (gh_cache_superset_key), and a later read of that target asking for a subset of F -- with
# or without a `--jq` that is a plain path to one value -- is printed from it, under the same TTL, write
# stamps and daemon watch as the stored answer itself (gh_cache_get, with the caller's own TTL, so a
# caller asking for at most 15 s old gets at most 15 s old). Printed the way gh prints `--json` to a
# pipe (Go's encoder: sorted keys, compact, no HTML escaping), and only when the stored answer
# re-encodes to the exact bytes gh printed, so a value this encoder would print differently is never
# reshaped: that answer is just not used.
GH_CACHE_SUPERSET_HEADS = {("pr", "view"): "pr", ("run", "view"): "run"}
GH_CACHE_SUPERSET_FLAGS = {"--repo", "--json", "--jq"}
GH_CACHE_JQ_PATH_RE = re.compile(r"^(?:\.[A-Za-z_][A-Za-z0-9_]*)+$")


def gh_cache_superset_spec(args: list[str], words: list[str], values: dict[str, str],
                           repo: str | None) -> tuple[list, list[str], str | None] | None:
    """(target, the --json fields, the --jq path or None) for a read the superset index can hold or
    answer; None for anything else (another flag, a template, a field list given twice, a --jq that is
    not a plain path)."""
    kind = GH_CACHE_SUPERSET_HEADS.get(tuple(words[:2]))
    canonical = gh_cache_canonical(args)
    if kind is None or len(words) != 3 or canonical is None:
        return None
    names = [name for name, _value in canonical[2]]
    if len(names) != len(set(names)) or not set(names) <= GH_CACHE_SUPERSET_FLAGS or "--json" not in names:
        return None
    flags = dict((name, value) for name, value in canonical[2])
    jq = flags.get("--jq")
    if jq is not None and not GH_CACHE_JQ_PATH_RE.match(jq):
        return None
    # In the order asked: lane-gh's gh (a lane VM's) prints the fields in that order, gh sorts them.
    fields = list(dict.fromkeys(f for f in (values.get("--json") or "").split(",") if f))
    target = gh_cache_target(words, values, repo)
    if not fields or target is None or target[0] != kind:
        return None
    return target, fields, jq


def gh_cache_superset_key(target: list, real: str | None) -> str:
    """The index's key for one PR or run: the target, and everything besides the line that changes what
    gh prints for it (gh_cache_key's identity, as for any `--json` read)."""
    ident = ["superset", target, os.environ.get("GH_REPO") or "", os.environ.get("GH_HOST") or "",
             gh_cache_identity(real, True)]
    return "t-" + hashlib.sha256(json.dumps(ident).encode()).hexdigest()[:40]


def gh_json_bytes(doc: Any, style: str = "gh") -> bytes:
    """What prints `--json` to a pipe. "gh": gh's own, Go's encoding/json with HTML escaping off, map keys
    sorted, one line (Go also escapes U+2028 and U+2029, which Python leaves as they are). "lane": a lane
    VM's gh, lane-gh's (leo-workspace tools/lane_gh_vm.py pick_json), Python's indent=2 in the order asked."""
    if style == "lane":
        return (json.dumps(doc, indent=2) + "\n").encode()
    text = json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return (text.replace("\u2028", "\\u2028").replace("\u2029", "\\u2029") + "\n").encode()


def gh_cache_superset_note(spec: tuple | None, key: str, at: float, real: str | None) -> None:
    """Index a kept plain `--json` answer under its target. Lossy by design: two fills racing may keep
    only one of their entries, which costs the next subset read a request, never a wrong answer."""
    if spec is None or spec[2] is not None:
        return
    target, fields, _jq = spec
    path = gh_cache_dir() / f"{gh_cache_superset_key(target, real)}.json"
    doc = read_json(path)
    entries = doc.get("entries") if isinstance(doc, dict) and isinstance(doc.get("entries"), dict) else {}
    entries = {k: v for k, v in entries.items()
               if isinstance(v, dict) and isinstance(v.get("at"), (int, float)) and at - v["at"] < GH_CACHE_VOUCH_KEEP}
    entries[key] = {"at": at, "fields": sorted(set(fields))}
    write_json(path, {"entries": entries})


def gh_cache_superset_get(spec: tuple | None, repo: str | None, real: str | None, now: float) -> dict | None:
    """An answer for a read of some fields of one PR or run, printed from a kept read of more of them;
    None when no such read is kept and still good (gh_cache_get decides that, as for its own line)."""
    if spec is None:
        return None
    target, fields, jq = spec
    doc = read_json(gh_cache_dir() / f"{gh_cache_superset_key(target, real)}.json")
    entries = doc.get("entries") if isinstance(doc, dict) and isinstance(doc.get("entries"), dict) else {}
    wanted = set(fields)
    found = sorted(((v.get("at"), k) for k, v in entries.items()
                    if isinstance(v, dict) and isinstance(v.get("at"), (int, float))
                    and isinstance(v.get("fields"), list) and wanted <= set(v["fields"])), reverse=True)
    for _at, key in found:
        answer = gh_cache_get(key, repo, now)
        if answer is None or answer["rc"] != 0 or answer["err"]:
            continue
        try:
            whole = json.loads(answer["out"])
        except ValueError:
            continue
        if not isinstance(whole, dict) or not wanted <= set(whole):
            continue
        style = next((s for s in ("gh", "lane") if gh_json_bytes(whole, s) == answer["out"]), None)
        if style is None:
            continue  # not printed the way this would print it: never reshaped
        part = {name: whole[name] for name in fields}
        if jq is None:
            return {"rc": 0, "out": gh_json_bytes(part, style), "err": b""}
        value: Any = part
        for name in jq[1:].split("."):
            if not isinstance(value, dict) or name not in value:
                value = None
                break
            value = value[name]
        if isinstance(value, str):
            return {"rc": 0, "out": (value + "\n").encode() if value else b"\n", "err": b""}
        if value is None or isinstance(value, (bool, int)):
            return {"rc": 0, "out": (json.dumps(value) + "\n").encode(), "err": b""}
        return None  # an object, a list or a float: gh's jq prints those its own way
    return None


def gh_cache_stamps(target: list | None, repo: str | None, words: list[str] | None = None) -> list[str] | None:
    """The writes.json entries that make an answer old: one about `target`, or about `repo` when it
    is about nothing narrower (a list of workflow runs has a scope of its own, "runlists"). None when the
    answer names no repository (every write counts)."""
    if target is None and repo and words and (
            tuple(words[:2]) == ("run", "list")
            or (words[:1] == ["api"] and len(words) > 1 and GH_CACHE_API_RUNS_LIST_RE.match(words[1]))):
        return ["*", repo, f"{repo} runlists"]
    if target:
        kind, repo, ident = target
        narrow = {"pr": [f"{repo} pr {ident}", f"{repo} prs"], "run": [f"{repo} run {ident}", f"{repo} runs"],
                  "job": [f"{repo} jobs", f"{repo} runs"], "head": [f"{repo} heads"]}[kind]
        return ["*", repo, *narrow]
    if repo:
        return ["*", repo, f"{repo} other"]
    return None


def gh_cache_write_scope(args: list[str], words: list[str], method: str,
                         values: dict[str, str]) -> tuple[str | None, list[str]]:
    """(repository or None, the scopes this write stamps): "pr N", "run ID", "prs" (every PR's
    mergeability or checks), "runs" (every run), "jobs", "runlists" (the lists of workflow runs: a
    write that can start one), "heads" (one commit's checks: a write that can start or rerun one; never
    merge or update-branch, whose runs are on a new commit) and "other" (the other lists, and everything not one target). [] is
    the whole repository, as every write was before; a write naming no repository stamps every one.

    Narrow only where what the write changes is known: anything else, a GraphQL mutation included,
    stays as wide as it was."""
    repo = gh_cache_repo(words, values)
    if repo is None:
        repo = broker_repo(values) if words[:1] != ["api"] else None
    if repo is None:
        return gh_cache_write_remotes(words, values), []
    first, second = (words + ["", ""])[:2]
    rest = words[2:]
    if first == "api":
        if AUDIT_GRAPHQL_RE.match(second):
            return repo, []
        path = re.sub(r"^https://api\.github\.com/", "", second).lstrip("/").split("?")[0]
        tail = path.split("/")[3:]  # after repos/OWNER/REPO
        if len(tail) >= 2 and tail[0] in ("pulls", "issues") and tail[1].isdigit():
            if tail[0] == "pulls" and tail[2:3] and tail[2] in GH_CACHE_BASE_WRITES:
                return repo, [f"pr {int(tail[1])}", "prs", "runlists", "other"]
            if tail[0] == "pulls" and tail[2:3] and tail[2] in GH_CACHE_HEAD_WRITES:
                return repo, [f"pr {int(tail[1])}", "runlists", "other"]  # a push: pull_request.synchronize
            # An edit, a label, a comment or a review: each can start a workflow (pull_request,
            # issues, issue_comment, pull_request_review), so the run lists go with them.
            return repo, [f"pr {int(tail[1])}", "runlists", "heads", "other"]
        if tail in (["issues"], ["pulls"]):
            return repo, ["runlists", "heads", "other"]  # a new issue or PR: issues.opened, pull_request
        if len(tail) >= 3 and tail[:2] == ["actions", "runs"] and tail[2].isdigit():
            return repo, [f"run {tail[2]}", "runlists", "heads", "jobs", "prs", "other"]
        if len(tail) >= 3 and tail[:2] == ["actions", "jobs"] and tail[2].isdigit():
            return repo, ["runs", "runlists", "heads", "jobs", "prs", "other"]
        if len(tail) >= 4 and tail[:2] == ["actions", "workflows"] and tail[3] == "dispatches":
            return repo, ["runlists", "heads", "prs", "other"]  # a new run: its checks reach a PR on that branch
        return repo, []
    rest = gh_cache_write_positionals(args)
    if rest is None:
        return repo, []
    rest = rest[2:]
    number = next((w for w in rest[:1] if re.fullmatch(r"\d+", w)), None)
    url = GH_CACHE_PR_URL_RE.match(rest[0]) if rest else None
    if url:
        number = url.group(3)
    if first in ("pr", "issue") and number is not None and len(rest) == 1:
        if first == "pr" and second in GH_CACHE_BASE_WRITES:
            return repo, [f"pr {int(number)}", "prs", "runlists", "other"]
        if first == "pr" and second in GH_CACHE_HEAD_WRITES:
            return repo, [f"pr {int(number)}", "runlists", "other"]
        if second in GH_CACHE_TARGET_WRITES:
            # A label, a ready-for-review, a reopen, a comment or a review can each start a workflow
            # (pull_request, issue_comment, pull_request_review): the run lists go with them.
            return repo, [f"pr {int(number)}", "runlists", "heads", "other"]
    if (first, second) in {("pr", "create"), ("issue", "create")}:
        return repo, ["runlists", "heads", "other"]  # pull_request, issues.opened
    if first == "run" and second in GH_CACHE_RUN_WRITES and rest[:1] and rest[0].isdigit() and len(rest) == 1:
        return repo, [f"run {rest[0]}", "runlists", "heads", "jobs", "prs", "other"]
    if (first, second) == ("workflow", "run"):
        return repo, ["runlists", "heads", "prs", "other"]
    return repo, []


def gh_cache_write_remotes(words: list[str], values: dict[str, str]) -> list[str] | None:
    """The repositories a `gh pr|issue|run ...` write with no repository on its line can be about: every
    GitHub remote of the checkout it runs in, since gh picks one of them (broker_repo declines to say
    which when there are several). None -- every answer on the host -- when that is not known exactly.

    A checkout of manaflow-ai/cmux has five remotes, so every `gh pr create` or `gh pr edit` there with
    no -R stamped "*" and dropped every answer the host held, for every repository."""
    if not words or words[0] == "api" or broker_elsewhere(values) or os.environ.get("GH_REPO") or any(
            os.environ.get(name) for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_CEILING_DIRECTORIES",
                                              "GIT_DISCOVERY_ACROSS_FILESYSTEM")):
        return None
    with contextlib.suppress(Exception):
        found = git_remotes(Path.cwd())
        if found:
            return sorted(set(found))
    return None


def gh_cache_write_positionals(args: list[str]) -> list[str] | None:
    """The positional words of a `gh pr|issue|run|workflow` write, or None when a flag on it is in
    neither GH_CACHE_WRITE_VALUE_FLAGS nor GH_CACHE_WRITE_BOOL_FLAGS (its value could be read as the
    PR's number) or the line has a `--`."""
    words, i = [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            return None
        if arg.startswith("-") and arg != "-":
            name = arg.split("=", 1)[0]
            if "=" in arg and name.startswith("--"):
                pass
            elif not name.startswith("--") and len(name) > 2:
                if name[:2] not in GH_CACHE_WRITE_VALUE_FLAGS:
                    return None  # `-abc`, or a glued value on a flag this does not know
            elif name in GH_CACHE_WRITE_VALUE_FLAGS:
                i += 1
            elif name not in GH_CACHE_WRITE_BOOL_FLAGS:
                return None
        else:
            words.append(arg)
        i += 1
    return words


def gh_cache_post_scopes(item: dict) -> list[str]:
    """What a queued `post` changes, as gh_cache_write_scope has it for the same write made directly: a
    comment or review its PR or issue, the lists and the run lists (it can start a workflow); a new PR
    the lists and the run lists. Anything else stamps the whole repository."""
    number = item.get("number")
    if item.get("kind") in ("comment", "review") and isinstance(number, int) and not isinstance(number, bool):
        return [f"pr {number}", "runlists", "heads", "other"]
    if item.get("kind") == "pr":
        return ["runlists", "heads", "other"]
    return []


GH_CACHE_WATCH_KIND = {"pr": "pr", "run": "run", "head": "head"}


def gh_cache_watch(target: list | None) -> tuple[str, dict] | None:
    """(daemon key, its cached entry) for the PR or run an answer is about, when glaeda's daemon holds
    data for it; None otherwise. Never raises: this is a lookup in front of a gh call."""
    if not target or target[0] not in GH_CACHE_WATCH_KIND:
        return None
    kind, repo, ident = target
    try:
        key = parse_key(kind, f"{repo}{ {'pr': '#', 'head': '@'}.get(kind, '/') }{ident}")
        entry = read_cache(key)
    except (WatchError, OSError, ValueError):
        return None
    if not isinstance(entry, dict) or not isinstance(entry.get("data"), dict):
        return None
    return key, entry


def gh_cache_watch_mark(kind: str, entry: dict) -> str:
    """A digest of what the daemon holds for one target: its data, and a run's jobs. It changes when
    the daemon has seen the target change, which is what an answer kept beside it is checked against."""
    held = {"data": entry.get("data"), "jobs": entry.get("jobs") if kind == "run" else None}
    return hashlib.sha256(json.dumps(held, sort_keys=True, default=str).encode()).hexdigest()[:32]


def gh_cache_done(words: list[str], seen: set[str], out: bytes) -> bool:
    """Whether a stored answer can no longer change: a completed job, or every job of one attempt
    completed. Read from the answer itself, so only for a raw `gh api` read (no --jq or template)."""
    if words[:1] != ["api"] or len(words) < 2 or seen & {"--jq", "-q", "--template", "-t", "--paginate"}:
        return False
    path = re.sub(r"^https://api\.github\.com/", "", words[1]).lstrip("/").split("?")[0]
    try:
        doc = json.loads(out)
    except ValueError:
        return False
    if not isinstance(doc, dict):
        return False
    if re.fullmatch(rf"repos/{NAME}/{NAME}/actions/jobs/\d+/?", path):
        return doc.get("status") == "completed"
    if re.fullmatch(rf"repos/{NAME}/{NAME}/actions/runs/\d+/attempts/\d+/jobs/?", path):
        jobs = doc.get("jobs")
        return (isinstance(jobs, list) and bool(jobs) and doc.get("total_count") == len(jobs)
                and all(isinstance(j, dict) and j.get("status") == "completed" for j in jobs))
    return False


def gh_cache_writes() -> dict[str, float]:
    doc = read_json(gh_cache_dir() / "writes.json")
    return {str(k): float(v) for k, v in (doc if isinstance(doc, dict) else {}).items()
            if isinstance(v, (int, float)) and not isinstance(v, bool)}


GH_RERUN_API_RE = re.compile(r"^/?repos/[^/]+/[^/]+/actions/runs/\d+/rerun(?:-failed-jobs)?/?$")


def note_run_rerun(repo: str | None, scopes: list[str] | None, words: list[str], now: float) -> None:
    """A brokered `gh run rerun N` (or its API POST) on a run this host caches: stamp the entry rerunAt, so a wait
    and `Daemon.due` treat its cached finish as attempt-unknown until GitHub is read again (run_unconfirmed).
    Stamped when the write starts and again when it ends (gh_cache_write), so a read while it was in flight does not
    count; a rerun that fails costs one more read, never a wrong answer."""
    rerun = (words[:2] == ["run", "rerun"]
             or (words[:1] == ["api"] and len(words) > 1 and bool(GH_RERUN_API_RE.match(words[1]))))
    run_id = next((x.split(" ", 1)[1] for x in scopes or [] if x.startswith("run ")), None)
    if not rerun or not repo or not run_id:
        return
    key = f"run:{repo}/{run_id}"
    cache = cache_dir() / file_name(key)
    with contextlib.suppress(OSError), bounded_lock(cache_dir() / ".write.lock") as held:
        entry = read_json(cache) if held and cache.exists() else None
        if isinstance(entry, dict):
            write_json(cache, {**entry, "rerunAt": now})


def gh_cache_note_write(repo: str | list[str] | None, now: float, scopes: list[str] | None = None) -> None:
    """Stamp a write, so no answer read before it is served after it. A write is stamped when it
    starts and again when it finishes (gh_cache_write), so a read that began while it was in flight
    is older than the second stamp and is not served either. Bounded like every lock here: losing
    a stamp to a wedged sibling costs at most one TTL of staleness, never the gh call.

    `scopes` (gh_cache_write_scope) narrows the stamp to what the write can change within `repo`;
    none stamps the whole repository, and no repository stamps every answer on the host. A list of
    repositories (gh_cache_write_remotes) stamps each of them whole."""
    if isinstance(repo, list):
        names = list(repo) or ["*"]
    else:
        names = [f"{repo} {scope}" for scope in scopes] if repo and scopes else [repo or "*"]
    with bounded_lock(gh_cache_dir().parent / ".answers-writes.lock"):
        writes = {k: v for k, v in gh_cache_writes().items() if now - v < GH_CACHE_KEEP}
        for name in names:
            writes[name] = max(writes.get(name, 0.0), now)
        write_json(gh_cache_dir() / "writes.json", writes)


def gh_cache_get(key: str, repo: str | None, now: float) -> dict | None:
    """The stored answer for `key`, if it is younger than the TTL and than every write that could
    have changed it, and glaeda's daemon has seen no change in the PR or run it is about."""
    doc = read_json(gh_cache_dir() / f"{key}.json")
    if not isinstance(doc, dict) or doc.get("key") != key or not isinstance(doc.get("at"), (int, float)):
        return None
    at = float(doc["at"])
    if gh_cache_vouched(doc, now):
        # The PR is where it was when this was read (gh_cache_vouch): the daemon's change mark and the TTL do not
        # apply -- a check finishing moves the mark and nothing this prints -- but this host's writes still do.
        answer = gh_cache_unstamped(doc, repo, at)
        return None if answer is None else {**answer, "vouched": doc["vouch"][0]}
    ttl = gh_cache_ttl()
    long = ttl > 0 and doc.get("long") is True
    if long:
        ttl = max(ttl, GH_CACHE_LONG_TTL)
    watch = doc.get("watch")
    watched = None  # the daemon's entry when it still holds what it held at the read; None unknown
    if isinstance(watch, list) and len(watch) == 3 and all(isinstance(x, str) for x in watch):
        daemon_key, mark, kind = watch
        entry = None
        with contextlib.suppress(Exception):
            entry = read_cache(daemon_key)
        if isinstance(entry, dict) and isinstance(entry.get("data"), dict):
            if gh_cache_watch_mark(kind, entry) != mark:
                # The daemon read this PR or run again since the answer was taken, and what it read
                # is different: a push, a new check, a rerun, a merge -- from this host or any other.
                return None
            watched = entry
        # No entry any more (the watch lapsed): nothing to compare with, so the TTL and the write
        # stamps decide, as for an answer the daemon never held.
    if ttl > 0 and not long and (doc.get("done") is True or (
            watched and doc.get("doneWhenRead") is True and isinstance(watched.get("fetchedAt"), (int, float))
            and now - watched["fetchedAt"] < TERMINAL_REFRESH + 2 * CYCLE
            # A settled head (every check finished) is kept past the TTL only for a caller that did not ask for a
            # shorter one: a merge gate reading with GLAEDA_GH_CACHE_TTL=15 still reads it within 15 s.
            and (watch[2] != "head" or ttl >= GH_CACHE_TTL))):
        # Cannot change (a completed job), or a completed run whose daemon copy is still being read
        # and has not changed since. A rerun reaches that copy through the controller's webhook
        # within a tick, or the daemon's own re-read of a finished run (TERMINAL_REFRESH) when the
        # controller misses it -- the same bound `wait run` lives with -- and a rerun from this host
        # stamps the run at once. Never past what the daemon would see: GH_CACHE_DONE_TTL is
        # TERMINAL_REFRESH.
        ttl = max(ttl, GH_CACHE_DONE_TTL)
    if not 0 <= now - at < ttl:
        return None
    return gh_cache_unstamped(doc, repo, at)


def gh_cache_unstamped(doc: dict, repo: str | None, at: float) -> dict | None:
    """A kept answer as {rc, out, err}, unless a write that could have changed it was stamped at or after `at`."""
    writes = gh_cache_writes()
    stamps = doc.get("stamps")
    if isinstance(stamps, list) and all(isinstance(x, str) for x in stamps):
        newest = max([writes.get(name, 0.0) for name in stamps] + [0.0])
    else:
        # An answer kept before writes were scoped, or one naming no repository: every write to its
        # repository counts, however narrowly it was stamped.
        newest = max([writes.get("*", 0.0)] + ([v for k, v in writes.items() if k == repo or k.startswith(f"{repo} ")]
                                               if repo else list(writes.values())))
    if newest >= at:
        return None
    try:
        return {"rc": int(doc["rc"]), "out": base64.b64decode(doc["out"]), "err": base64.b64decode(doc["err"])}
    except (KeyError, TypeError, ValueError):
        return None


def gh_cache_put(key: str, at: float, rc: int, out: bytes, err: bytes, long: bool = False,
                 meta: dict | None = None) -> None:
    """Keep one answer. `meta` carries what makes it old (gh_cache_meta): the write stamps it is
    checked against, the daemon entry it is checked against, and whether it can still change."""
    if rc != 0 or len(out) + len(err) > GH_CACHE_MAX_BYTES:
        return
    doc = {"key": key, "at": at, "rc": rc, "long": long,
           "out": base64.b64encode(out).decode(), "err": base64.b64encode(err).decode()}
    doc.update({k: v for k, v in (meta or {}).items() if k in ("stamps", "watch", "doneWhenRead", "done", "vouch", "pr")})
    write_json(gh_cache_dir() / f"{key}.json", doc)
    gh_cache_prune(at)


def gh_cache_meta(words: list[str], values: dict[str, str], repo: str | None, args: list[str] | None = None) -> dict:
    """What an answer about to be read must be checked against later, taken before gh runs: the write
    stamps for its target (gh_cache_stamps) and, when glaeda's daemon holds the PR or run, a mark of
    what it holds now. A mark taken before the read can only be older than the answer, so a change
    the daemon sees afterwards always drops it -- never the other way round. A GraphQL read's target is
    read off its query (gh_cache_graphql_scope), when ARGS are given."""
    target = gh_cache_target(words, values, repo)
    if args is not None and words[:1] == ["api"] and len(words) > 1 and AUDIT_GRAPHQL_RE.match(words[1]):
        scoped, target = gh_cache_graphql_scope(args)
        if scoped != repo:
            target = None  # stamped by what the caller keyed it under, never narrower
    meta: dict[str, Any] = {}
    stamps = gh_cache_stamps(target, repo, words)
    if stamps is not None:
        meta["stamps"] = stamps
    held = gh_cache_watch(target)
    if held is not None:
        daemon_key, entry = held
        kind = daemon_key.split(":", 1)[0]
        meta["watch"] = [daemon_key, gh_cache_watch_mark(kind, entry), kind]
        meta["doneWhenRead"] = (kind == "run" and terminal("run", entry.get("data"))) or (
            kind == "head" and bool((entry.get("data") or {}).get("settled")))
    return meta


def gh_cache_prune(now: float) -> None:
    """Delete stored answers past GH_CACHE_KEEP, and fill locks past GH_CACHE_LOCK_KEEP, at most once a
    GH_CACHE_PRUNE_EVERY. A lock file is removed only while this holds it, and a fill checks after taking
    its lock that the file is still the one at the path (gh_cache_fill_lock), so a fill that took a lock just
    removed gives up rather than run beside one holding the new file."""
    stamp = gh_cache_dir() / ".pruned"
    with contextlib.suppress(OSError):
        if now - stamp.stat().st_mtime < GH_CACHE_PRUNE_EVERY:
            return
    with contextlib.suppress(OSError):
        stamp.touch()
        for path in gh_cache_dir().glob("*.json"):
            age = now - path.stat().st_mtime
            if path.name == "writes.json" or age <= GH_CACHE_KEEP:
                continue
            if age <= GH_CACHE_VOUCH_KEEP:
                doc = read_json(path)
                if isinstance(doc, dict) and (doc.get("vouch") or doc.get("pr") or "entries" in doc):
                    continue  # a vouched answer, the PR a no-target read named, or a superset index (its own entries)
            path.unlink(missing_ok=True)
        for path in gh_cache_dir().glob(".*.lock"):
            if now - path.stat().st_mtime <= GH_CACHE_LOCK_KEEP:
                continue
            with contextlib.suppress(OSError), open(path, "a+") as handle:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    continue  # a fill holds it: in use, so not old
                if now - os.fstat(handle.fileno()).st_mtime > GH_CACHE_LOCK_KEEP:
                    path.unlink(missing_ok=True)


def gh_cache_emit(answer: dict) -> int:
    """Print a stored answer exactly as gh printed it."""
    for stream, data in ((sys.stdout, answer["out"]), (sys.stderr, answer["err"])):
        if not data:
            continue
        target = getattr(stream, "buffer", None)
        if target is not None:
            stream.flush()
            target.write(data)
            target.flush()
        else:
            stream.write(data.decode("utf-8", "replace"))
            stream.flush()
    return answer["rc"]


def gh_cache_child(real: str, args: list[str], capture: bool, deadline: float | None) -> tuple[int, bytes, bytes]:
    """Run the real gh once as a child, in the caller's own process group, so whoever bounds the
    caller (run_bounded kills a whole group) bounds gh too. With `capture`, a deadline after which
    gh is killed (exit 124); without, it shares the terminal and the caller's stdio. ^C reaches gh
    from the terminal as it would without the broker; the broker ignores it only once gh is running,
    so it waits for gh's own exit and stamps the write."""
    env = dict(os.environ)
    # A child, not an exec, so the hop mark (scoped to this pid) means nothing to it; the depth
    # count is what keeps a wrapper that hands gh back here finite.
    env[BROKER_DEPTH] = str(broker_depth() + 1)
    env.pop(BROKER_MARK, None)
    if capture:
        with subprocess.Popen([real, *args], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE) as proc:
            try:
                out, err = proc.communicate(timeout=deadline)
            except subprocess.TimeoutExpired:
                proc.kill()
                # A grandchild may still hold the pipes; it is in the caller's group, so the
                # caller's own bound reaches it. Not waiting for it here is what keeps this one.
                with contextlib.suppress(subprocess.TimeoutExpired):
                    proc.communicate(timeout=GH_CACHE_DRAIN)
                return 124, b"", f"glaeda-gh: gh ran past {int(deadline or 0)} s and was stopped\n".encode()
            return proc.returncode, out, err
    with subprocess.Popen([real, *args], env=env) as proc:
        # Set only after the fork: a disposition of SIG_IGN would survive gh's exec, and ^C would
        # then not stop a write it stops without the broker.
        previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
        forward = signal.signal(signal.SIGTERM, lambda *_: proc.send_signal(signal.SIGTERM))
        try:
            code = proc.wait()
        finally:
            signal.signal(signal.SIGTERM, forward)
            signal.signal(signal.SIGINT, previous)
    return (128 - code if code < 0 else code), b"", b""


@contextlib.contextmanager
def gh_cache_fill_lock(path: Path, seconds: float):
    """bounded_lock for a fill, plus one check: once held, the file must still be the one at `path`. The
    pruner removes an old lock file only while holding it, but a fill that opened the file before the removal
    can take it after; that fill yields False, as for a lock it could not get, instead of filling beside a
    fill holding the new file."""
    try:
        handle = open(path, "a+")
    except OSError:
        yield False
        return
    held = False
    deadline = time.monotonic() + seconds
    try:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = True
                break
            except OSError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.02)
        if held:
            try:
                held = os.stat(path).st_ino == os.fstat(handle.fileno()).st_ino
            except OSError:
                held = False
            if held:
                os.utime(path)  # in use: the pruner's clock starts again
        yield held
    finally:
        with contextlib.suppress(OSError):
            handle.close()


def gh_cache_fill(real: str, args: list[str], key: str, repo: str | None, ran: list[int],
                  note: dict | None = None) -> int | None:
    """Run the real gh once for `key` and keep its answer; an identical call already doing that is
    waited for instead. None when the key's lock could not be had in GH_CACHE_FILL_WAIT: the caller
    then runs gh the ordinary way. Once gh has run its exit code is in `ran`, so a caller that
    catches an error from here knows not to run it a second time.

    `note` is the call's "pass" decision: written when gh runs here, replaced by a "cache" one when a
    sibling's answer serves it, and left to the caller when the lock could not be had. One decision
    per call, so the audit does not count a waited call as both."""
    gh_cache_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    note = note if note is not None else {"route": "pass"}
    with gh_cache_fill_lock(gh_cache_dir() / f".{key}.lock", GH_CACHE_FILL_WAIT) as held:
        if not held:
            return None  # the caller runs gh, and writes the note
        answer = gh_cache_get(key, repo, time.time())
        if answer is not None:
            broker_note({"route": "cache", "waited": True, **({"line": note["line"]} if "line" in note else {})})
            ran.append(answer["rc"])
            return gh_cache_emit(answer)
        words, _method, seen, values = broker_words(args)
        meta: dict = {}
        with contextlib.suppress(Exception):
            meta = gh_cache_meta(words, values, repo, args)
        with contextlib.suppress(Exception):
            gh_cache_vouch_note(meta, words, values, seen, repo, key)
        broker_note({**{k: v for k, v in note.items() if k != "written"}, "filled": True})
        note["written"] = True  # the caller's record: it must not write the decision a second time
        watched_final = None
        with contextlib.suppress(Exception):
            watched_final = gh_run_jobs_watched(words)
        at = time.time()
        slot = gh_graphql_slot_for(args)  # held while gh runs: a GraphQL read is one of the login's slots on the host
        try:
            if slot is not None:
                os.environ[GRAPHQL_SLOT_ENV] = str(os.getpid())  # gh_cache_child copies it: nested gh uses this slot
            rc, out, err = gh_cache_child(real, args, True, GH_CACHE_FILL_DEADLINE)
        finally:
            if slot is not None:
                os.environ.pop(GRAPHQL_SLOT_ENV, None)
                graphql_slot_release(slot)
        ran.append(rc)
        with contextlib.suppress(Exception):
            long = words[:1] == ["api"] and len(words) > 1 and bool(GH_CACHE_LONG_RE.match(words[1]))
            meta["done"] = rc == 0 and gh_cache_done(words, seen, out)
            pr = gh_cache_vouch_after(meta, out, repo or broker_repo(values),
                                      gh_cache_target(words, values, repo) is not None) if rc == 0 else None
            gh_cache_put(key, at, rc, out, err, long, meta)
            if pr and note.get("key") is None and daemon_running() and broker_seen_count(pr, time.time()) >= 2:
                # A read broker_plan could not count (plain `pr view`, a branch, no target): counted here by the PR
                # it named, so a PR read by hand again is watched and its next answer is vouched for.
                register(pr)
            if rc == 0 and not err and len(out) <= GH_CACHE_MAX_BYTES:
                gh_cache_superset_note(gh_cache_superset_spec(args, words, values, repo), key, at, real)
        with contextlib.suppress(Exception):
            final_run = gh_run_jobs_final(words, seen, out) if rc == 0 else None
            if rc == 0 and final_run is None and watched_final is not None \
                    and seen & {"--jq", "-q", "--template", "-t"} and not seen & {"--paginate", "--include"}:
                final_run = watched_final  # a filtered answer its text cannot vouch for: the daemon's copy does
            if rc == 0 and (final_run or meta.get("done")):
                gh_cache_final_put(key, at, out, err, final_run)
            if final_run and daemon_running():
                register(parse_key("run", f"{final_run[0]}/{final_run[1]}"))  # its copy is what keeps the answer
    return gh_cache_emit({"rc": rc, "out": out, "err": err})


def gh_cache_write(real: str, args: list[str], repo: str | None, ran: list[int],
                   scopes: list[str] | None = None, words: list[str] | None = None) -> int:
    """Run a write as a child and stamp it again once it finished, so nothing read while it was in
    flight outlives it (a rerun's run entry too: note_run_rerun)."""
    try:
        rc, _out, _err = gh_cache_child(real, args, False, None)
        ran.append(rc)
    finally:
        if ran:
            with contextlib.suppress(Exception):
                gh_cache_note_write(repo, time.time(), scopes)
            with contextlib.suppress(Exception):
                note_run_rerun(repo, scopes, words or [], time.time())
    return rc


# -- a finished job's log through the shim: read once per host, never per caller
#
# huge-blue, 2026-11-17 (24 h of its calls.log): 8,399 `gh api .../actions/jobs/N/logs` reads (cmux 5,822, cmuxterm-hq
# 2,577) and 9,610 `.../actions/runs/N/jobs` reads, most from the lane-gh broker's ci_log (ci_wait and ws_check_post read
# every job's log of a finished cmux-ci run, again on each retry and again per post) and land_judge's job-log reads. A
# finished job's log never changes (a rerun is a new job id), so a plain read of one is answered from the log store
# `glaeda-gh log job` keeps (job_log_get), else from the build controller (its own App token: no user REST), and only
# then by gh, whose answer is kept when it ends with the runner's closing line. Anything not that plain shape (a --jq,
# an --include, a header) goes the ordinary way. LOG_CONTROLLER_DOWN_S keeps an unreachable controller from costing
# every read its LOG_CONTROLLER_TIMEOUT.
GH_JOB_LOG_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/jobs/(\d+)/logs/?$")
GH_JOB_LOG_FLAGS = {"--allow-escape-sequences"}
LOG_CONTROLLER_DOWN_S = 300.0


def gh_job_log_read(words: list[str], method: str, seen: set[str]) -> tuple[str, int] | None:
    """(repo, job id) when this call is a plain read of one job's log: `gh api [--allow-escape-sequences]
    repos/O/R/actions/jobs/N/logs`, a GET, stdout not a terminal. None for anything else."""
    if words[:1] != ["api"] or len(words) != 2 or method != "GET" or seen - GH_JOB_LOG_FLAGS:
        return None
    match = GH_JOB_LOG_RE.match(words[1])
    if not match or sys.stdout.isatty():
        return None
    return f"{match.group(1)}/{match.group(2)}".lower(), int(match.group(3))


def log_controller_down(now: float) -> bool:
    with contextlib.suppress(OSError):
        return now - (BASE / ".log-controller-down").stat().st_mtime < LOG_CONTROLLER_DOWN_S
    return False


def gh_job_log_kept(repo: str, job: int, controller: Any = "env") -> tuple[bytes | None, str]:
    """(JOB's finished log, where it came from) from this host's log store, else the controller; (None, why) when
    neither has it. The controller's answer is kept (it serves only finished jobs). Never raises."""
    try:
        text = job_log_get(repo, job)
        if text is not None:
            return text, "cache"
        now = time.time()
        if log_controller_down(now):
            return None, "controller down"
        ctl = Controller.from_env() if controller == "env" else controller
        if ctl is None:
            return None, "no controller"
        status, body = controller_job_log(ctl, repo, job)
        if status == 0:
            with contextlib.suppress(OSError):
                BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
                (BASE / ".log-controller-down").touch()
        if status == 200 and body and len(body) <= JOB_LOG_RAW_MAX:
            with contextlib.suppress(OSError):
                job_log_put(repo, job, body)
            return body, "controller"
        return None, f"controller HTTP {status}"
    except Exception as error:  # noqa: BLE001  a lookup in front of a gh call
        return None, describe(error)


def gh_job_log_answer(real: str, args: list[str], repo: str, job: int, said: dict,
                      controller: Any = "env") -> int:
    """Answer one plain job-log read: kept, else the controller, else gh once (identical reads wait on its lock), whose
    answer is kept when the job had finished. The decision log says which (`joblog`)."""
    text, source = gh_job_log_kept(repo, job, controller)
    if text is None:
        gh_cache_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
        lock = gh_cache_dir() / f".joblog-{hashlib.sha256(f'{repo}/{job}'.encode()).hexdigest()[:24]}.lock"
        with gh_cache_fill_lock(lock, GH_CACHE_FILL_WAIT):
            text = job_log_get(repo, job)  # a sibling may have filled it while this waited
            if text is None:
                broker_note({"route": "pass", "joblog": "gh", **said})
                rc, out, err = gh_cache_child(real, args, True, GH_CACHE_FILL_DEADLINE)
                if rc == 0 and job_log_finished(out):
                    with contextlib.suppress(OSError):
                        job_log_put(repo, job, out)
                return gh_cache_emit({"rc": rc, "out": out, "err": err})
            source = "cache"
    broker_note({"route": "cache" if source == "cache" else "serve", "joblog": source, **said})
    return gh_cache_emit({"rc": 0, "out": text, "err": b""})


# -- a finished run's job list: kept while glaeda's daemon still sees that run completed at that attempt
#
# `runs/N/jobs` (the latest attempt's list) changes only with a rerun, which makes a new attempt: an answer listing every
# job completed (and every job: total_count) is final for its attempt. It is kept (GH_CACHE_FINAL_DIR, no TTL, least
# recently read out first past GH_CACHE_FINAL_MAX_BYTES) and answered while the daemon's copy of the run, still being
# read, is completed at that same attempt with no rerun since; the fill registers the run with the daemon so it
# has that copy (a rerun reaches it from the controller's webhook within a tick, or its TERMINAL_REFRESH re-read). An
# answer that can never change (a completed `jobs/N`, a completed attempt's `runs/N/attempts/A/jobs`) needs no copy.
GH_CACHE_FINAL_DIR = "answers-final"
GH_CACHE_FINAL_MAX_BYTES = 128 * 1024 * 1024
GH_RUN_JOBS_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/runs/(\d+)/jobs/?"
                            r"(?:\?(.*))?$")
GH_RUN_JOBS_QUERY = {"per_page", "filter", "page"}


def gh_run_jobs_final(words: list[str], seen: set[str], out: bytes) -> tuple[str, int, int] | None:
    """(repo, run id, attempt) when OUT, a raw `gh api repos/O/R/actions/runs/N/jobs` answer of the latest attempt,
    lists every job of the run and every one completed: final while that attempt is the run's newest. Else None."""
    if words[:1] != ["api"] or len(words) != 2 or seen & {"--jq", "-q", "--template", "-t", "--paginate", "--include"}:
        return None
    match = GH_RUN_JOBS_RE.match(words[1])
    if not match:
        return None
    query = dict(urllib.parse.parse_qsl(match.group(4) or "", keep_blank_values=True))
    if set(query) - GH_RUN_JOBS_QUERY or query.get("filter", "latest") != "latest" or query.get("page", "1") != "1":
        return None
    try:
        doc = json.loads(out)
    except ValueError:
        return None
    jobs = doc.get("jobs") if isinstance(doc, dict) else None
    if not isinstance(jobs, list) or not jobs or doc.get("total_count") != len(jobs) \
            or not all(isinstance(j, dict) and j.get("status") == "completed" for j in jobs):
        return None
    attempts = {j.get("run_attempt") for j in jobs}
    if len(attempts) != 1 or not isinstance(next(iter(attempts)), int):
        return None
    return f"{match.group(1)}/{match.group(2)}".lower(), int(match.group(3)), int(next(iter(attempts)))


def gh_run_jobs_watched(words: list[str]) -> tuple[str, int, int] | None:
    """(repo, run id, attempt) when this is a read of a run's latest job list (any --jq) and glaeda's daemon holds that
    run completed now, read in the last TERMINAL_REFRESH + 2 cycles: the answer about to be read is that attempt's
    final list (a --jq answer cannot be checked by its own text). A rerun that started in between is caught the same
    way gh_cache_final_get catches one later: the daemon's next read shows a new attempt."""
    if words[:1] != ["api"] or len(words) != 2:
        return None
    match = GH_RUN_JOBS_RE.match(words[1])
    if not match:
        return None
    query = dict(urllib.parse.parse_qsl(match.group(4) or "", keep_blank_values=True))
    if set(query) - GH_RUN_JOBS_QUERY or query.get("filter", "latest") != "latest":
        return None
    repo, run_id = f"{match.group(1)}/{match.group(2)}".lower(), int(match.group(3))
    entry = read_cache(parse_key("run", f"{repo}/{run_id}")) or {}
    data, fetched = entry.get("data"), entry.get("fetchedAt")
    if not isinstance(data, dict) or not terminal("run", data) or not isinstance(fetched, (int, float)) \
            or not 0 <= time.time() - fetched < TERMINAL_REFRESH + 2 * CYCLE or entry.get("rerunAt"):
        return None
    attempt = data.get("run_attempt") or 1
    return (repo, run_id, attempt) if isinstance(attempt, int) and not isinstance(attempt, bool) else None


def gh_cache_final_path(key: str) -> Path:
    return BASE / GH_CACHE_FINAL_DIR / f"{key}.json.gz"


def gh_cache_final_put(key: str, at: float, out: bytes, err: bytes, run: tuple[str, int, int] | None) -> None:
    """Keep a final answer (rc 0): RUN is (repo, run id, attempt) for a latest-attempt job list, None for an answer
    that never changes. Never raises."""
    if len(out) + len(err) > GH_CACHE_MAX_BYTES * 4:
        return
    path = gh_cache_final_path(key)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{time.monotonic_ns()}.tmp")
    doc = {"key": key, "at": at, "out": base64.b64encode(out).decode(), "err": base64.b64encode(err).decode(),
           **({"run": list(run)} if run else {})}
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with open(tmp, "wb") as f:
            f.write(gzip.compress(json.dumps(doc).encode(), mtime=0))
        os.replace(tmp, path)
    except OSError:
        with contextlib.suppress(OSError):
            tmp.unlink()
        return
    with contextlib.suppress(Exception):
        gh_cache_final_evict()


def gh_cache_final_evict(max_bytes: int | None = None) -> None:
    """Least recently read final answers out first past GH_CACHE_FINAL_MAX_BYTES; a crash's temp files after an hour."""
    max_bytes = GH_CACHE_FINAL_MAX_BYTES if max_bytes is None else max_bytes
    root = BASE / GH_CACHE_FINAL_DIR
    kept, now = [], time.time()
    for p in root.glob("*"):
        with contextlib.suppress(OSError):
            st = p.stat()
            if p.name.endswith(".tmp"):
                if now - st.st_mtime > JOB_LOG_TMP_KEEP:
                    p.unlink()
                continue
            kept.append((st.st_mtime, st.st_size, p))
    total = sum(size for _, size, _ in kept)
    for _, size, p in sorted(kept):
        if total <= max_bytes:
            break
        with contextlib.suppress(OSError):
            p.unlink()
            total -= size


def gh_cache_final_get(key: str, now: float) -> dict | None:
    """The final answer kept for KEY, or None. A latest-attempt job list only while the daemon's copy of its run was
    completed at that same attempt, with no rerun this host started since the answer, and is still being read
    (TERMINAL_REFRESH + 2 cycles): a rerun from anywhere reaches that copy within those bounds. A hit is marked used (mtime). Never raises."""
    path = gh_cache_final_path(key)
    try:
        doc = json.loads(gzip.decompress(path.read_bytes()))
        if not isinstance(doc, dict) or doc.get("key") != key:
            return None
        run = doc.get("run")
        if run is not None:
            repo, run_id, attempt = run
            entry = read_cache(parse_key("run", f"{repo}/{run_id}"))
            data = (entry or {}).get("data")
            fetched = (entry or {}).get("fetchedAt")
            if (not isinstance(data, dict) or not terminal("run", data) or (data.get("run_attempt") or 1) != attempt
                    or not isinstance(fetched, (int, float))
                    or not 0 <= now - fetched < TERMINAL_REFRESH + 2 * CYCLE
                    or float((entry or {}).get("rerunAt") or 0) >= doc["at"]):
                return None
        answer = {"rc": 0, "out": base64.b64decode(doc["out"]), "err": base64.b64decode(doc["err"])}
    except Exception:  # noqa: BLE001  missing, damaged or not this key: a miss
        return None
    with contextlib.suppress(OSError):
        os.utime(path)
    return answer


# -- occupancy sweeps: one runners read instead of a jobs read per run
#
# "Which runners are busy" was being answered by listing the in-progress runs and then reading
# every run's jobs (or every job) for its runner_name: 60-200 REST requests per sweep, from a loop
# that ran every few minutes. `glaeda-gh runners OWNER` answers the same question from GitHub's
# runner list, which carries `busy` and the labels for each runner: a page per 100 runners, shared
# by every session on the host for the answer cache's TTL. A caller still sweeping per-job reads
# past GH_SWEEP_MAX distinct runs or jobs in GH_SWEEP_WINDOW is refused with a message naming it.
# Polling one run's jobs is one target however often it is read, so it is never counted as a sweep.
GH_SWEEP_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/"
                         r"(?:runs/(\d+)(?:/attempts/\d+)?/jobs|jobs/(\d+))/?(?:\?.*)?$")
GH_SWEEP_MAX = 30
GH_SWEEP_WINDOW = 600.0
GH_SWEEP_EXIT = 2


def gh_sweep_target(words: list[str], method: str) -> str | None:
    """`o/r run 5` or `o/r job 7` for a per-run jobs read or a per-job read; None for anything else."""
    if len(words) < 2 or words[0] != "api" or method != "GET":
        return None
    match = GH_SWEEP_RE.match(words[1])
    if not match:
        return None
    owner, repo, run, job = match.groups()
    return f"{owner}/{repo} run {run}".lower() if run else f"{owner}/{repo} job {job}".lower()


def gh_sweep_refusal(words: list[str], method: str, now: float) -> str | None:
    """The refusal for a caller past GH_SWEEP_MAX distinct jobs targets in GH_SWEEP_WINDOW, or None.
    Bounded like every lock here: an unheld lock lets the call through uncounted."""
    target = gh_sweep_target(words, method)
    if target is None or os.environ.get("GLAEDA_GH_SWEEP_OK") == "1":
        return None
    caller = broker_caller()
    path = BASE / "broker-sweeps.json"
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with bounded_lock(BASE / ".broker-sweeps.lock") as held:
        if not held:
            return None
        doc = read_json(path)
        callers: dict[str, dict[str, float]] = {}
        for who, seen in (doc if isinstance(doc, dict) else {}).items():
            if isinstance(seen, dict):
                kept = {t: float(at) for t, at in seen.items()
                        if isinstance(at, (int, float)) and now - float(at) < GH_SWEEP_WINDOW}
                if kept:
                    callers[str(who)] = kept
        mine = callers.setdefault(caller, {})
        if target not in mine and len(mine) >= GH_SWEEP_MAX:
            owner = target.split("/")[0]
            return (f"glaeda-gh: refused: this caller read the jobs of {len(mine)} different runs or jobs in the last "
                    f"{int(GH_SWEEP_WINDOW // 60)} minutes, which is a runner-occupancy sweep and spends a REST request "
                    f"each from the quota every session shares. `glaeda-gh runners {owner}` answers which runners are "
                    f"busy, and with which labels, from one read the whole host shares. A read that really needs "
                    f"every job can set GLAEDA_GH_SWEEP_OK=1.")
        mine[target] = now
        write_json(path, callers)
    return None


def read_runners(path: str) -> list[dict]:
    """One runners listing (org or repo path), through this broker, piped, so the answer cache shares the read
    whether or not the gh shim is on PATH."""
    try:
        done = run_bounded([sys.executable, str(Path(__file__).resolve()), "gh", "api", "--paginate",
                            f"{path}?per_page=100", "--jq",
                            ".runners[] | {name, status, busy, labels: [.labels[].name]}"], timeout=120,
                           env=internal_env())
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WatchError(f"gh api {path}: {describe(error)}") from None
    if done.returncode != 0:
        raise WatchError(f"gh api {path}: {(done.stderr or '').strip()[:300]}")
    try:
        return [json.loads(line) for line in done.stdout.splitlines() if line.strip()]
    except ValueError as error:
        raise WatchError(f"gh api {path}: unreadable answer: {error}") from None


# CI_RUNNER_STATE (cmuxterm-hq build-fleet/mini-ops/RUNNER-STATE.md): the fleet's runner-heal owner, which holds the
# org-admin read this host's token lacks, publishes its census of the repo's runners and the approved org groups
# (glaeda-minis: every glaeda-gui-std / glaeda-side-std pool) as a gzip+base64 repository variable every 120 s.
# Reading it is one variable GET through this broker, no new grant and no ssh to the minis. Older than
# RUNNER_STATE_MAX_AGE_S, incomplete, or for another repository, it is not used.
RUNNER_STATE_VARIABLE = "CI_RUNNER_STATE"
RUNNER_STATE_SCHEMA = "runner-state/v1"
RUNNER_STATE_MAX_AGE_S = 600


def read_runner_state(repo: str) -> tuple[list[dict] | None, str]:
    """The org-group runners from `repo`'s published CI_RUNNER_STATE census, as read_runners rows, and its
    source line; or None and why it could not be used."""
    path = f"repos/{repo}/actions/variables/{RUNNER_STATE_VARIABLE}"
    where = f"{RUNNER_STATE_VARIABLE} on {repo}"
    try:
        done = run_bounded([sys.executable, str(Path(__file__).resolve()), "gh", "api", path, "--jq", ".value"],
                           timeout=60, env=internal_env())
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, f"{where} not read ({describe(error)})"
    if done.returncode != 0:
        return None, f"{where} not read ({(done.stderr or '').strip()[:120]})"
    try:
        doc = json.loads(gzip.decompress(base64.b64decode(done.stdout.strip(), validate=True)))
    except (ValueError, OSError, EOFError, zlib.error) as error:
        return None, f"{where} unreadable ({describe(error)})"
    if not isinstance(doc, dict) or doc.get("schema") != RUNNER_STATE_SCHEMA:
        return None, f"{where} has no {RUNNER_STATE_SCHEMA} document"
    if str(doc.get("repository") or "").lower() != repo.lower():
        return None, f"{where} is for {doc.get('repository')}"
    if doc.get("complete") is not True:
        return None, f"{where} is incomplete"
    try:
        at = dt.datetime.fromisoformat(str(doc.get("generated_at")).replace("Z", "+00:00"))
        if at.tzinfo is None:
            raise ValueError("no UTC offset")
        age = time.time() - at.timestamp()
    except (TypeError, ValueError):
        return None, f"{where} has no readable generated_at"
    if not -60 <= age <= RUNNER_STATE_MAX_AGE_S:
        return None, f"{where} is {int(age)} s old"
    groups = doc.get("runner_groups")
    if not isinstance(groups, dict) or not all(isinstance(rows, list) for rows in groups.values()):
        return None, f"{where} has no runner groups"
    rows = []
    for row in (r for group in groups.values() for r in group):
        if not isinstance(row, dict) or not isinstance(row.get("name"), str):
            continue
        labels = [lab.get("name") if isinstance(lab, dict) else lab for lab in row.get("labels") or []]
        rows.append({"name": row.get("name"), "status": row.get("status"), "busy": bool(row.get("busy")),
                     "labels": [lab for lab in labels if isinstance(lab, str)]})
    return rows, f"{where}, {int(max(age, 0))} s old"


def cmd_runners(scope: str, label: str | None, as_json: bool) -> int:
    """Self-hosted runners of an org or repository: online, busy and idle, per label. Read through
    `gh` so the answer cache shares it with every session on the host for its TTL.

    GitHub's repo listing holds only runners registered to that repo (the trusted-only and nightly ones); the
    org's runners, which run most of a repo's jobs, are a different listing. 2026-11-15: `runners OWNER/REPO
    --label glaeda-side-std-xcode-26.6` read 0 online of 39 while the org pool had 8 online, all busy, and a
    lane took the label for down. So OWNER/REPO reads the repo's runners and the owner's org runners, merged by
    name, and says which it read (`scopes`). The org listing needs an org-admin token; without one the org rows
    come from the repo's published CI_RUNNER_STATE census, and with neither the counts are unknown (`online`
    null, `unknown` says why), never 0: a scope this reader cannot see is not an empty pool."""
    unread = unknown = None
    if re.fullmatch(NAME, scope):
        runners = read_runners(f"orgs/{scope}/actions/runners")
        scopes = {"org": len(runners)}
    elif re.fullmatch(rf"{NAME}/{NAME}", scope):
        runners = read_runners(f"repos/{scope}/actions/runners")
        scopes = {"repo": len(runners)}
        owner = scope.split("/")[0]
        try:
            org = read_runners(f"orgs/{owner}/actions/runners")
        except WatchError as error:
            org, unread = [], f"org {owner} not read ({str(error)[:120]})"
            state, source = read_runner_state(scope)
            if state is None:
                unknown = (f"org runners are not visible to this token; read from {RUNNER_STATE_VARIABLE} on "
                           f"{scope} (cmuxterm-hq build-fleet/mini-ops/RUNNER-STATE.md) or an org-admin "
                           f"`gh api orgs/{owner}/actions/runners`: {source}")
            else:
                org, unread = state, f"org {owner} read from {source}"
                scopes[RUNNER_STATE_VARIABLE] = len(state)
        else:
            scopes["org"] = len(org)
        have = {r.get("name") for r in runners}
        runners += [r for r in org if r.get("name") not in have]
    else:
        raise WatchError("runners takes OWNER or OWNER/REPO")
    online = [r for r in runners if r.get("status") == "online" and (not label or label in r.get("labels", []))]
    labels: dict[str, dict[str, int]] = {}
    for r in online:
        for name in r.get("labels") or []:
            row = labels.setdefault(name, {"online": 0, "busy": 0})
            row["online"] += 1
            row["busy"] += bool(r.get("busy"))
    doc = {"scope": scope, "scopes": scopes, "label": label, "runners": len(runners), "online": len(online),
           "busy": sum(1 for r in online if r.get("busy")), "labels": labels,
           "busyRunners": sorted(r["name"] for r in online if r.get("busy"))}
    if unread:
        doc["unread"] = unread
    if unknown:
        # the repo rows alone are a lower bound, kept under their own name; the totals are unknown
        doc.update(online=None, busy=None, runners=None, labels={}, busyRunners=None, unknown=unknown,
                   repoOnly={"runners": len(runners), "online": len(online), "labels": labels,
                             "busyRunners": doc["busyRunners"]})
    if as_json:
        print(json.dumps(doc, sort_keys=True))
        return EXIT_OK
    read = " + ".join(f"{n} {k}" for k, n in scopes.items())
    if unknown:
        print(f"{scope}" + (f" (label {label})" if label else "") + f": unknown: {unknown} [read: {read}]")
        if online:
            print(f"  repo runners alone (a lower bound): {len(online)} listening")
        return EXIT_OK
    print(f"{scope}: {doc['online']} online of {doc['runners']} registered, {doc['busy']} busy"
          + (f" (label {label})" if label else "") + f" [read: {read}]" + (f" [{unread}]" if unread else ""))
    for name, row in sorted(labels.items(), key=lambda kv: (-kv[1]["online"], kv[0])):
        print(f"  {name:48} {row['busy']:4} busy {row['online'] - row['busy']:4} idle")
    return EXIT_OK


# ---------------------------------------------------------------- search (issues and pull requests)

# An agent who needs to find a PR or issue had no subcommand here, so it reached for `gh search issues|prs` or
# `gh api search/...`: 30 such calls from 20 session transcripts on this host in the week to 2026-11-21. Those
# spend the shared REST quota this daemon exists to protect, and REST search carries its own 30-a-minute limit,
# so one sweep of a few repositories blinds every PR wait on the host for a minute -- the fleet has run the
# quota to zero this way. `search` asks GraphQL's search connection instead, through this broker (read_runners'
# route), so a call costs 1 GraphQL point and no REST at all, and an identical search from the next session
# within GLAEDA_GH_CACHE_TTL is served from the kept answer with no request at all. gh_cache_graphql_scope
# already reads a `repo:o/r` search's scope, so a kept answer is made old by a write to that repository.
SEARCH_LIMIT_MAX = 100  # GraphQL's `first:` ceiling; more would need paging, which no caller has asked for
SEARCH_KINDS = {"issues": "is:issue", "prs": "is:pr", "both": ""}
# What an agent types for each kind, `gh search` words included; `both` is a bare query with no kind word.
SEARCH_KIND_WORDS = {"issues": "issues", "issue": "issues", "prs": "prs", "pr": "prs", "pulls": "prs",
                     "pull-requests": "prs", "both": "both"}
SEARCH_STATES = {"open": "state:open", "closed": "state:closed", "merged": "is:merged", "all": ""}
SEARCH_SERVED = "glaeda-gh search issues|prs QUERY [--repo OWNER/REPO]"
# `gh search code|commits|repos` have no GraphQL search type these fields come from: each names the form that works.
SEARCH_UNSERVED = {
    "code": f"code search is not served here (no cached route): grep a checkout instead "
            f"(wt new REPO BRANCH --files), or for a pull request or issue `{SEARCH_SERVED}`",
    "commits": f"commit search is not served here (no cached route): `git log` in a checkout, or for the pull "
               f"request that carried it `{SEARCH_SERVED}`",
    "repos": f"repository search is not served here (no cached route): for a pull request or issue `{SEARCH_SERVED}`"}
SEARCH_QUALIFIER_RE = {
    "kind": re.compile(r"(?:^|\s)(?:is:(?:pr|issue)|type:\S+)(?=\s|$)"),
    "state": re.compile(r"(?:^|\s)(?:state:\S+|is:(?:open|closed|merged|unmerged))(?=\s|$)"),
    "repo": re.compile(r"(?:^|\s)repo:\S+(?=\s|$)"),
    "author": re.compile(r"(?:^|\s)author:\S+(?=\s|$)")}
# The fields `status pr` prints, from the one search node: `head` is the head commit there too (status_view), so
# `--field head,state,checks.state` reads the same values off a search row as off a status.
SEARCH_NODE_FIELDS = (
    "__typename "
    "... on Issue { number title url state createdAt updatedAt author { login } repository { nameWithOwner } } "
    "... on PullRequest { number title url state isDraft merged createdAt updatedAt author { login } "
    "repository { nameWithOwner } headRefName headRefOid baseRefName "
    "commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } }")
SEARCH_GQL = ("query($q: String!, $n: Int!) { rateLimit { cost remaining } "
              "search(type: ISSUE, query: $q, first: $n) { issueCount nodes { " + SEARCH_NODE_FIELDS + " } } }")


def search_terms(kind: str, words: list[str], repos: list[str], state: str, author: str | None) -> str:
    """The one GitHub search string a call sends: the words as typed, then a qualifier for each flag given. A
    qualifier already in the words wins and the flag's is left out, so `search prs 'repo:o/r is:merged'` sends
    exactly that; naming repositories both ways at once is refused rather than ANDed into no results."""
    typed = " ".join(words).strip()
    if repos and SEARCH_QUALIFIER_RE["repo"].search(typed):
        raise WatchError("name the repositories one way, not both: --repo OWNER/REPO (repeatable) or repo:OWNER/REPO "
                         f"in the query -- `{SEARCH_SERVED}`")
    parts = [typed] if typed else []
    for what, value in (("kind", SEARCH_KINDS[kind]), ("state", SEARCH_STATES[state]),
                        ("repo", " ".join(f"repo:{r}" for r in repos)),
                        ("author", f"author:{author}" if author else "")):
        if value and not SEARCH_QUALIFIER_RE[what].search(typed):
            parts.append(value)
    terms = " ".join(p for p in parts if p).strip()
    if not terms:
        raise WatchError("search takes a query, --repo, --author or --state to look for: "
                         f"`{SEARCH_SERVED}`")
    return terms


def search_read(terms: str, limit: int) -> dict:
    """One GraphQL search, piped through this broker, so its answer is kept for every session on the host and
    nothing touches REST (read_runners' route: the cache shares the read whether or not the shim is on PATH)."""
    argv = [sys.executable, str(Path(__file__).resolve()), "gh", "api", "graphql",
            "-f", f"query={SEARCH_GQL}", "-f", f"q={terms}", "-F", f"n={limit}"]
    try:
        done = run_bounded(argv, timeout=120, env=internal_env())
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WatchError(f"gh api graphql (search): {describe(error)}") from None
    if done.returncode != 0:
        raise WatchError(f"gh api graphql (search): {(done.stderr or '').strip()[:300]}")
    try:
        doc = json.loads(done.stdout or "{}")
    except ValueError as error:
        raise WatchError(f"gh api graphql (search): unreadable answer: {error}") from None
    found = ((doc.get("data") or {}).get("search")) if isinstance(doc, dict) else None
    if not isinstance(found, dict) or not isinstance(found.get("nodes"), list):
        said = (doc.get("errors") if isinstance(doc, dict) else None) or doc
        raise WatchError(f"search was not answered: {json.dumps(said, sort_keys=True)[:300]}")
    return found


def search_row(node: dict) -> dict:
    """One search node as this tool's row: the `status pr` names (head, headRefOid, state, checks.state, merged,
    url, title, number) plus where it lives, so a row is a `status`, `wait` or `land` target as printed."""
    repo = (node.get("repository") or {}).get("nameWithOwner")
    number = node.get("number")
    pr = node.get("__typename") == "PullRequest"
    row: dict[str, Any] = {
        "kind": "pr" if pr else "issue", "repo": repo, "number": number,
        "target": f"{repo}#{number}" if repo and isinstance(number, int) else None,
        "title": node.get("title"), "url": node.get("url"),
        "state": (node.get("state") or "").lower() or None,
        "author": (node.get("author") or {}).get("login"),
        "createdAt": node.get("createdAt"), "updatedAt": node.get("updatedAt")}
    if not pr:
        return row
    commit = ((node.get("commits") or {}).get("nodes") or [{}])[0] or {}
    rollup = ((commit.get("commit") or {}).get("statusCheckRollup") or {}).get("state")
    check_state = (rollup or "").lower() or None
    row.update(head=node.get("headRefOid"), headRefOid=node.get("headRefOid"), headRef=node.get("headRefName"),
               baseRef=node.get("baseRefName"), merged=bool(node.get("merged")), draft=bool(node.get("isDraft")),
               checkState=check_state, checks={"state": check_state})
    return row


def search_line(row: dict) -> str:
    """`OWNER/REPO#N state [checks] title (author, 2h ago)`: the target first, to paste into status, wait or land."""
    marks = [row.get("state") or "?"]
    if row.get("draft"):
        marks.append("draft")
    if row.get("checkState"):
        marks.append(f"checks {row['checkState']}")
    when = iso_epoch(row.get("updatedAt"))
    who = ", ".join(x for x in (row.get("author"), age(when) if when else "") if x)
    title = land_trim(row.get("title") or "", 100)
    return f"{row.get('target') or '?'} {' '.join(marks)}  {title}" + (f"  ({who})" if who else "")


def cmd_search(kind: str, words: list[str], repos: list[str], state: str, author: str | None, limit: int,
               as_json: bool, fields: list[str] | None = None) -> int:
    """Find pull requests and issues by query, over GraphQL search, through this host's one cached route.

    The fields are `status pr`'s, so a row's `target` is what `status`, `wait` and `land` take next, and
    `--field head,state,checks.state` reads the same names here as there."""
    if not 1 <= limit <= SEARCH_LIMIT_MAX:
        raise WatchError(f"--limit must be 1 to {SEARCH_LIMIT_MAX} (GraphQL search's page): "
                         f"`{SEARCH_SERVED} --limit {SEARCH_LIMIT_MAX}`")
    bad = [r for r in repos if not re.fullmatch(rf"{NAME}/{NAME}", r)]
    if bad:
        raise WatchError(f"--repo takes OWNER/REPO, not {bad[0]!r}: `{SEARCH_SERVED}`")
    terms = search_terms(kind, words, repos, state, author)
    found = search_read(terms, limit)
    rows = [search_row(n) for n in found["nodes"] if isinstance(n, dict)]
    if kind != "both":
        rows = [r for r in rows if r["kind"] == ("pr" if kind == "prs" else "issue")]
    total = found.get("issueCount")
    if fields:
        for row in rows:
            print("\t".join(field_text(field_value(row, f)) for f in fields))
        return EXIT_OK
    if as_json:
        print(json.dumps({"query": terms, "total": total, "shown": len(rows), "rows": rows}, sort_keys=True))
        return EXIT_OK
    more = f", {len(rows)} shown (--limit {limit})" if isinstance(total, int) and total > len(rows) else ""
    print(f"{terms}: {total if isinstance(total, int) else len(rows)} found{more}")
    for row in rows:
        print(f"  {search_line(row)}")
    if not rows:
        print("  nothing matched (qualifiers are ANDed: drop one, or --state all)")
    return EXIT_OK


# A merge reaches GitHub only through the host's gh-quota guard (leo-workspace tools/gh-quota-shim, PACE_CLI; the
# GLAEDA_MERGE_GUARD path overrides): land_judge's holds, BLOCKs, review and pin checks, the merge line, the landing
# record and the transient-error retry all live there. broker_real_gh steps over every "gh guard" file, so a call
# typed as `glaeda-gh gh ...` reached the real gh with none of that: on 2026-11-05 leo-workspace#3589 was landed with
# `glaeda-gh gh api --method PUT .../pulls/3589/merge` after `gh pr merge` failed on GitHub's side, and land_judge
# never saw it. A merge-shaped call that the guard has not judged (no GH_QUOTA_CHECKED, which the guard exports before
# it runs the next gh) is handed to the guard instead, PATH led by the guard's dir so it finds the gh after it as
# usual. The guard then reaches this broker again with GH_QUOTA_CHECKED set, and the call passes as before.
# A host with no guard refuses the merge rather than run it unjudged: nothing on the fleet merges through
# `glaeda-gh gh` on purpose, and `gh pr merge` is the documented route.
# A create (a comment, review, PR, issue, status, release: GitHub's secondary content-creation limit) is handed to the
# guard the same way, because the guard asks the login's create pause before it: a create typed as `glaeda-gh gh`
# reached gh unasked and could renew the pause for every writer on the login. The lists mirror the guard's own
# (gh_quota.py CREATE_WORDS, CREATE_API, CREATE_MUTATIONS, plus its landing creates). Unlike a merge, a create on a
# host with no guard runs as before: creates are routine everywhere, and such a host has no pause to ask.
# Every other call goes the same way, for the same reason one step further on: the guard is where a call gets its
# second route (a GraphQL read answered over REST once GraphQL is spent, and the reverse), and its ledger entry.
# Only where the guard would hand the call back to this broker, so nothing is run behind the answer cache's back:
# broker_guard_comes_back. Not for this daemon's own reads (GLAEDA_GH_INTERNAL) and not under a person's
# CMUX_GH_BROKER_DISABLE, which a merge and a create override and an ordinary call does not.
MERGE_GUARD_ENV = "GLAEDA_MERGE_GUARD"
# (command, subcommand) -> None (always a create) or the flags without which it creates nothing (a close's comment)
BROKER_CREATE_WORDS: dict[tuple[str, str], tuple[str, ...] | None] = {
    ("pr", "comment"): None, ("pr", "review"): None, ("pr", "create"): None, ("issue", "create"): None,
    ("issue", "comment"): None, ("release", "create"): None, ("gist", "create"): None,
    ("pr", "close"): ("--comment", "-c"), ("pr", "reopen"): ("--comment", "-c"),
    ("issue", "close"): ("--comment", "-c"), ("issue", "reopen"): ("--comment", "-c")}
# The value flags of `pr|issue close|reopen` that BROKER_VALUE_FLAGS does not list (broker_flag_given).
BROKER_CLOSE_VALUE_FLAGS = {"--comment", "--reason", "--duplicate-of"}
BROKER_CLOSE_SHORT_VALUE = "cr"
BROKER_CREATE_API = re.compile("|".join((
    r"repos/[^/]+/[^/]+/(?:pulls|issues)(?:/\d+/comments)?",
    r"repos/[^/]+/[^/]+/pulls/\d+/(?:reviews|comments)(?:/\d+/(?:events|replies))?",
    r"repos/[^/]+/[^/]+/pulls/comments/\d+/replies",
    r"repos/[^/]+/[^/]+/statuses/[0-9a-fA-F]{7,40}",
    r"repos/[^/]+/[^/]+/check-runs",
    r"repos/[^/]+/[^/]+/commits/[0-9a-fA-F]{7,40}/comments",
    r"repos/[^/]+/[^/]+/releases",
    r"gists(?:/[0-9a-fA-F]+/comments)?",
    r"(?:orgs/[^/]+/teams/[^/]+|teams/\d+)/discussions(?:/\d+/comments)?")))
BROKER_CREATE_MUTATIONS = re.compile(
    r"\b(?:addComment|addDiscussionComment|createDiscussion|createIssue|createPullRequest|addPullRequestReview"
    r"|submitPullRequestReview|addPullRequestReviewComment|addPullRequestReviewThread|addPullRequestReviewThreadReply"
    r"|createCheckRun|createCommitOnBranch)\s*\(")
BROKER_MERGE_MUTATIONS = re.compile(r"\b(?:mergePullRequest|enablePullRequestAutoMerge|enqueuePullRequest)\b")
BROKER_REST_MERGE = re.compile(r"^/?(?:https?://[^/]+/(?:api/v3/)?)?repos/[^/]+/[^/]+/pulls/\d+/merge/?$")


def broker_merge_call(args: list[str]) -> bool:
    """Whether this gh call can merge a PR: `gh pr merge`, a non-GET `gh api .../pulls/N/merge`, or a `gh api graphql`
    that names a merge mutation inline or reads any file or stdin (`--input`, `-F k=@F`). A file is never read here:
    it could change between this read and gh's (router-review F2 on #1878), so the guard, which snapshots it before it
    judges (land_judge.snapshot), gets every such call. A `?query` suffix on the endpoint is ignored (F1)."""
    words, method, seen, _values = broker_words(args)
    if broker_help(args, seen):
        return False  # gh prints help and does nothing else
    if words[:2] == ["pr", "merge"]:
        return True
    if words[:1] != ["api"] or len(words) < 2:
        return False
    endpoint = words[1].split("?", 1)[0].split("#", 1)[0]
    # gh takes `HTTPS://API.GITHUB.COM/...` as well: the scheme and host are matched lowercased (F1, second review).
    endpoint = re.sub(r"^[A-Za-z][A-Za-z0-9+.-]*://[^/]*", lambda m: m.group(0).lower(), endpoint)
    if method != "GET" and BROKER_REST_MERGE.match(endpoint):
        return True
    if not AUDIT_GRAPHQL_RE.match(endpoint):
        return False
    for i, arg in enumerate(args):
        if arg == "--input" or arg.startswith("--input="):
            return True
        value = None
        if arg in ("-F", "--field") and i + 1 < len(args):
            value = args[i + 1].partition("=")[2]
        elif arg.startswith("--field="):
            value = arg[len("--field="):].partition("=")[2]
        elif arg.startswith("-F") and len(arg) > 2:
            value = arg[2:].partition("=")[2]
        if value and value.startswith("@"):
            return True
    return bool(BROKER_MERGE_MUTATIONS.search("\n".join(args)))


def broker_help(args: list[str], seen: set[str]) -> bool:
    """Whether gh only prints help for this call (router-review F3 on #1878)."""
    return "--help" in seen or "-h" in seen or any(a.lower() in ("--help=true", "--help=1") for a in args)


def broker_flag_given(args: list[str], names: tuple[str, ...]) -> bool:
    """Whether any of `names` (a long flag and its one-letter short) is given, read as cobra reads a close or reopen:
    a short cluster runs its letters as boolean flags until one that takes a value, which takes the rest of the word
    (`-dc x` is --delete-branch then --comment x, `-dcx` and `-cx` the same, `-Rc` the repository "c"), and a value
    flag given apart takes the next word whatever it starts with (`--reason -c` gives no comment)."""
    takes = BROKER_SHORT_VALUE + BROKER_CLOSE_SHORT_VALUE
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            return False
        if arg.startswith("--"):
            name = arg.split("=", 1)[0]
            if name in names:
                return True
            if "=" not in arg and (arg in BROKER_VALUE_FLAGS or arg in BROKER_CLOSE_VALUE_FLAGS):
                i += 1  # its value, whatever it looks like
        elif arg.startswith("-") and arg != "-":
            for at, letter in enumerate(arg[1:], start=1):
                if f"-{letter}" in names:
                    return True
                if letter in takes:
                    if at == len(arg) - 1:
                        i += 1  # the value is the next word
                    break
        i += 1
    return False


def broker_create_call(args: list[str]) -> bool:
    """Whether this gh call creates content (BROKER_CREATE_WORDS, a POST to a BROKER_CREATE_API path, or a `gh api
    graphql` mutation naming a BROKER_CREATE_MUTATIONS field inline). A graphql call that reads a file or stdin is
    broker_merge_call's, and goes to the guard already."""
    words, method, seen, _values = broker_words(args)
    if broker_help(args, seen):
        return False
    if words[:1] != ["api"]:
        if tuple(words[:2]) not in BROKER_CREATE_WORDS:
            return False
        need = BROKER_CREATE_WORDS[tuple(words[:2])]
        return need is None or broker_flag_given(args, need)
    if len(words) < 2:
        return False
    endpoint = words[1].split("?", 1)[0].split("#", 1)[0]
    if AUDIT_GRAPHQL_RE.match(endpoint):
        text = "\n".join(args)
        return bool(re.search(r"\bmutation\b", text) and BROKER_CREATE_MUTATIONS.search(text))
    path = re.sub(r"^/?(?:[A-Za-z][A-Za-z0-9+.-]*://[^/]*/(?:api/v3/)?)?", "", endpoint).rstrip("/")
    return method == "POST" and bool(BROKER_CREATE_API.fullmatch(path))


# `OWNER/REPO#N` on a brokered `gh` line: the one form this tool prints everywhere and the one real gh has
# never read. `gh pr comment teamleaderleo/glaeda#2323` is not a number and not a URL, so gh's PR finder
# falls through to its last case and looks for a *branch* of that name: "no pull requests found for branch
# \"teamleaderleo/glaeda#2323\"", exit 1, after a round trip. The target is unambiguous -- a git branch name
# cannot hold a `#` (git check-ref-format forbids it) -- so it is `--repo OWNER/REPO` plus the number, which
# is what gh does read. Narrower than KEY_RES on purpose: a plain `OWNER/REPO/N` is a shape a branch name can
# have (`feature/v2/3`), and on this surface the fallthrough it would steal is the branch form, which some
# caller may rely on. A URL already works in gh and is left alone.
BROKER_HASH_TARGET_RE = re.compile(rf"({NAME})/({NAME})#(\d+)")
# A run target is a run id, never a branch, so `/` is unambiguous here as it is for RUN_KEY_RE.
BROKER_RUN_TARGET_RE = re.compile(rf"({NAME})/({NAME})[#/](\d+)")
# The three word-one commands whose third word is one PR, issue or run, and the kind prefix each may carry.
BROKER_TARGET_WORDS = {"pr": ("pr", BROKER_HASH_TARGET_RE), "issue": ("comment", BROKER_HASH_TARGET_RE),
                       "run": ("run", BROKER_RUN_TARGET_RE)}


def broker_canonical_target(args: list[str]) -> list[str]:
    """ARGS with an `OWNER/REPO#N` target rewritten to the `--repo OWNER/REPO` + `N` gh reads, or ARGS
    unchanged when it is not that exact shape.

    One normalisation at the broker boundary, so every gh verb that takes a PR, issue or run gets it at once
    (`comment`, `edit`, `close`, `review`, `merge`, `update-branch`, `view`, `checks`, `rerun`, ...) and the
    answer cache can key and narrowly stamp a call it previously saw only as an opaque word. It never
    half-rewrites: anything it cannot canonicalise is returned as typed, for gh to rule on."""
    words, _, _, values = broker_words(args)
    if len(words) < 3 or words[0] not in BROKER_TARGET_WORDS:
        return args
    kind, pattern = BROKER_TARGET_WORDS[words[0]]
    # From the third word on, not the third word alone: broker_words knows the flags gh *reads* take, so the
    # value of a write-only flag it does not know (`--add-label x`) lands among the words, and agents type
    # flags before the target as often as after. Only the first word that is a target is touched.
    for typed in words[2:]:
        target = typed
        split = split_kind_prefix(target)
        if split is not None:
            # `pr:o/r#5` as this tool prints it. A prefix naming another kind is not read as this one, here
            # as in drop_kind_prefix: `gh pr view run:o/r/123` stays as typed, not pull request 123.
            if split[0] != kind and not (kind == "comment" and split[0] in ("pr", "comment")):
                return args
            target = split[1]
        match = pattern.fullmatch(target)
        if match:
            break
    else:
        return args
    owner, repo, number = match.groups()
    named = values.get("--repo")
    if named is not None and named.lower() != f"{owner}/{repo}".lower():
        return args  # `-R` already names a different repository: ambiguous, so gh decides, not this
    if sum(1 for a in args if a == typed) != 1:
        return args  # the same word twice (a value as well as the target): no index to rewrite safely
    at = args.index(typed)
    if at > 0 and args[at - 1].startswith("-"):
        # The word after a flag may be that flag's value rather than the target, and whether it is depends on
        # the verb (`-b` is `--body` to one gh command and `--branch` to another). Left as typed.
        return args
    fixed = [*args[:at], number, *args[at + 1:]] + ([] if named is not None else ["--repo", f"{owner}/{repo}"])
    print(f"glaeda-gh: read as `gh {typed_line(fixed)}` ({typed} is this tool's own form for the target; gh "
          f"takes the number with --repo, and reads OWNER/REPO#N as a branch name)", file=sys.stderr)
    return fixed


def broker_answered_here(args: list[str]) -> bool:
    """Whether this broker can answer the call without GitHub: broker_plan serves it from the daemon's own state,
    or refuses it. Then the guard has nothing to add -- there is no protocol to fall back to and nothing to
    charge -- and the hand-off would be pure latency on the commonest call there is. Measured 2026-11-21, one
    served `pr view --json state`: 0.33 s this way, 0.84 s through the guard. broker_plan is pure (it registers no
    watch and writes nothing), so asking it twice costs local reads only."""
    try:
        route, _payload, _key = broker_plan(args, time.time())
    except Exception as error:  # noqa: BLE001  unknown is "not answered here": the hand-off is the safe side
        broker_note({"route": "error", "error": describe(error), "site": "broker_answered_here"})
        return False
    return route in ("serve", "refuse")


def broker_merge_handoff(args: list[str]) -> int | None:
    """Hand a merge or a create the gh-quota guard has not judged to the guard (exec, so this returns only on
    failure), or None when the call is neither, or is a create and no guard can be run here."""
    if os.environ.get("GH_QUOTA_CHECKED"):
        return None
    if not broker_merge_call(args):
        create = broker_create_call(args)
        # And every other call the guard has not judged, for the same reason one step further on: the guard is
        # where a call gets its second route. A GraphQL read it answers over REST once GraphQL is spent, and the
        # reverse; a write whose refusal it reads and re-sends over the other protocol. Typed as `glaeda-gh gh`
        # -- which is what this tool's own next-step lines print -- the call had one route and no ledger entry.
        # Measured 2026-11-21 on a workstation carrying both guards: `glaeda-gh gh pr edit 2358 -R
        # teamleaderleo/glaeda --body-file -` refused with "GraphQL: API rate limit already exceeded" while the
        # identical bare `gh pr edit` answered over REST at once. Unlike a merge or a create, this hand-off is taken only when the guard would hand the
        # call back here (broker_guard_comes_back) and not for this daemon's own reads, which keep their route.
        # CMUX_GH_BROKER_DISABLE is honoured here, unlike for a merge or a create: a merge may never be sent
        # past land_judge and a create may never skip the login's pause, but for an ordinary call that switch is
        # a person asking for the real gh and the line they typed, and it is the escape hatch the loop message
        # advertises -- it has to reach every route this broker adds.
        other = not create and not os.environ.get(GLAEDA_INTERNAL) \
            and os.environ.get("CMUX_GH_BROKER_DISABLE") != "1" \
            and os.environ.get(QUOTA_HOP) != str(os.getpid()) and not os.environ.get(BROKER_MARK) \
            and not broker_answered_here(args)
        if create or other:
            try:
                guard = Path(os.environ.get(MERGE_GUARD_ENV) or PACE_CLI)
                if guard.is_file() and os.access(guard, os.X_OK) \
                        and (create or broker_guard_comes_back(guard)):
                    # execve, not a mutated os.environ then execv: the hand-off's PATH and its hop mark belong
                    # to the process being started. Mutating this process first leaves the guard's directory on
                    # PATH and the hop mark set for every later call in the same process, which is wrong for
                    # every in-process caller (a test, the daemon) whenever the exec does not happen.
                    # execve keeps the pid, so the pass back here reads QUOTA_HOP as its own.
                    env = {**os.environ, QUOTA_HOP: str(os.getpid()),
                           "PATH": os.pathsep.join([str(guard.parent), os.environ.get("PATH", "")])}
                    os.execve(str(guard), [str(guard), *args], env)
            except Exception as error:  # noqa: BLE001
                broker_note({"route": "error", "error": describe(error), "site": "broker_create_handoff"})
        return None  # no guard to ask (or it cannot run): the call runs as before
    # From here the call is a merge: anything that fails refuses it, never runs it unguarded (F2, second review).
    try:
        guard = Path(os.environ.get(MERGE_GUARD_ENV) or PACE_CLI)
        usable = guard.is_file() and os.access(guard, os.X_OK)
    except Exception as error:  # noqa: BLE001
        print(f"glaeda-gh: refused: {' '.join(['gh', *args][:3])} merges, and the gh-quota guard could not be "
              f"found: {describe(error)}", file=sys.stderr)
        return BROKER_EXIT_REFUSED
    if not usable:
        print(f"glaeda-gh: refused: {' '.join(['gh', *args][:3])} merges, and merges go through the host's gh-quota "
              f"guard (land_judge), which is not at {guard}. Run `gh pr merge N --squash --match-head-commit SHA` "
              f"on a host with the guard (leo-workspace tools/host-baseline gh-quota).", file=sys.stderr)
        return BROKER_EXIT_REFUSED
    try:
        os.environ["PATH"] = os.pathsep.join([str(guard.parent), os.environ.get("PATH", "")])
        os.execv(str(guard), [str(guard), *args])
    except Exception as error:  # noqa: BLE001
        print(f"glaeda-gh: refused: cannot run the merge guard {guard}: {describe(error)}", file=sys.stderr)
        return BROKER_EXIT_REFUSED
    return EXIT_OK  # unreachable: execv replaces this process


def cmd_gh(args: list[str]) -> int:
    """Stand in front of one `gh` invocation. Fails open: anything unexpected runs the real gh."""
    # The target comes first, so every path below -- the merge handoff's guard, the answer cache's key and
    # write scope, and gh itself -- sees one canonical line. Not under CMUX_GH_BROKER_DISABLE: whoever sets
    # that wants the real gh and the line they typed, unchanged.
    if os.environ.get("CMUX_GH_BROKER_DISABLE") != "1":
        try:
            args = broker_canonical_target(args)
        except Exception as error:  # noqa: BLE001  a rewrite never fails a call: fail open, as typed
            broker_note({"route": "error", "error": describe(error), "site": "broker_canonical_target"})
    # Before anything else, CMUX_GH_BROKER_DISABLE included: that switch skips this broker, never land_judge.
    try:
        handed = broker_merge_handoff(args)
    except Exception as error:  # noqa: BLE001  the broker never fails a call: that is the whole contract
        broker_note({"route": "error", "error": describe(error), "site": "broker_merge_handoff"})
        handed = None
    if handed is not None:
        return handed
    if os.environ.get("CMUX_GH_BROKER_DISABLE") == "1":
        # A person's unconditional switch, and the escape hatch the fatal message below advertises.
        # Nothing here read it, so the only documented way out of a wedged chain was a no-op. It is
        # honoured before any other work: whoever sets this wants the real gh and nothing else.
        try:
            real = broker_real_gh()
        except Exception:  # noqa: BLE001
            print("glaeda-gh: no real gh on PATH", file=sys.stderr)
            return BROKER_EXIT_NO_GH
        os.execv(real, [real, *args])
    now = time.time()
    real = None
    hops = broker_hops()
    cache_key, cache_repo, writing, write_repo, write_scopes = None, None, False, None, []
    pending: dict | None = None  # the "pass" record of a read the answer cache fills, written once it is known
    try:
        real = broker_real_gh()
        if hops:
            # Already been through here: a `gh` on PATH that this did not recognise as a wrapper
            # would otherwise be an endless exec between the two.
            raise WatchError("already brokered")
        words, method, seen, values = broker_words(args)
        # One budget for every lock this call takes, so the bound is the number the caller cares
        # about -- when gh runs -- and not three bounds that add up behind their own backs. The
        # repeat hold inside gives its own time back (see broker_hold): the budget bounds waiting
        # on a sibling, and a deliberate 30 s brake is not that.
        with lock_budget():
            # The call's logged identifier rides on each read's decision, so `audit` can say how many
            # repeat reads still reached GitHub, not only how many were asked for.
            line = broker_log_call(words, values)
            said = {"line": line} if audit_category(line.split())[1] else {}
            route, payload, key = broker_plan(args, now)
            if route == "refuse":
                broker_note({"route": "refuse"})
                print(payload, file=sys.stderr)
                return BROKER_EXIT_REFUSED
            if route == "serve":
                if key is not None:
                    touch_interest(key)
                broker_note({"route": "serve", "key": key, **said})
                print(payload)
                return EXIT_OK
            # Only a call broker_plan could serve is worth waiting on: a `--jq` read carries a key
            # to be counted, and waiting on the daemon would cost it BROKER_SPENT_WAIT for nothing.
            if key is not None and not seen - BROKER_SAFE_FLAGS and not sys.stdout.isatty() \
                    and broker_bucket_spent(key, now) and daemon_running():
                answered = broker_await(args, key)
                if answered is not None:
                    broker_note({"route": "serve", "key": key, "spent": True, **said})
                    print(answered)
                    return EXIT_OK
            job_log = gh_job_log_read(words, method, seen)
            if job_log is not None and not gh_cache_is_write(args, words, method):
                return gh_job_log_answer(real, args, job_log[0], job_log[1], said)
            if gh_cache_is_write(args, words, method):
                write_repo, write_scopes = gh_cache_write_scope(args, words, method, values)
                gh_cache_note_write(write_repo, now, write_scopes)
                note_run_rerun(write_repo, write_scopes, words, now)
                writing = gh_cache_ttl() > 0
            else:
                cache_key = gh_cache_key(args, words, values, seen, method, real)
                if cache_key is not None:
                    if words[1:2] and AUDIT_GRAPHQL_RE.match(words[1]):
                        # A GraphQL read's log line is only `api graphql`: its key's prefix lets `audit` count
                        # the same question asked again, which the line alone cannot show.
                        said = {**said, "graphql": cache_key[:12]}
                    cache_repo = gh_cache_answer_repo(args, words, values)
                    answer = gh_cache_get(cache_key, cache_repo, now)
                    subset = False
                    if answer is None:
                        answer = gh_cache_final_get(cache_key, now)
                    if answer is None:
                        answer = gh_cache_superset_get(gh_cache_superset_spec(args, words, values, cache_repo),
                                                       cache_repo, real, now)
                        subset = answer is not None
                    if answer is not None:
                        if key is not None or answer.get("vouched"):
                            # a read all the same: the daemon's watch stays wanted (a vouch needs it read)
                            touch_interest(key or answer["vouched"])
                        broker_note({"route": "cache", **({"subset": True} if subset else {}),
                                     **({"vouched": True} if answer.get("vouched") else {}), **said})
                        return gh_cache_emit(answer)
                refusal = gh_sweep_refusal(words, method, now)
                if refusal:
                    broker_note({"route": "refuse", "sweep": True})
                    print(refusal, file=sys.stderr)
                    return GH_SWEEP_EXIT
            broker_hold(broker_repeat_wait(args, words, method, seen, now))
            # No grace here, unlike every other caller. DOWN_GRACE exists so a client waiting on
            # the daemon rides out a re-exec; this answer only decides whether to register a watch,
            # which is worthless if the daemon really is down. Polling for it cost 5.20 s on the
            # hottest read shape on the host (measured: `gh pr view 7 -R o/r --json state` with no
            # daemon, 26x plain gh's startup), per call, exactly when none of the cache's value
            # exists to pay for it.
            if key is None and cache_key is not None:
                # A commit's checks read through REST (`commits/SHA/check-runs`, `/status`): read twice in
                # BROKER_REPEAT, the head becomes the daemon's to read once for every session (`glaeda-gh checks`),
                # and the answer kept here is checked against that read (gh_cache_watch) instead of every write.
                target = gh_cache_target(words, values, None)
                if target and target[0] == "head":
                    head_key = parse_key("head", f"{target[1]}@{target[2]}")
                    if daemon_running() and broker_seen_count(head_key, now) >= 2:
                        register(head_key, consumer=BROKER_HEAD_CONSUMER)
            if key is not None and daemon_running() and broker_seen_count(key, now) >= 2:
                # read twice in BROKER_REPEAT: worth a watch, so the next read of it is free. A
                # target read once is never watched, or a sweep over fifty PRs would cost more
                # than it saves.
                register(key)
                pending = {"route": "pass", "key": key, "watched": True, **said}
            else:
                pending = {"route": "pass", "key": key, **said}
            if cache_key is None:
                broker_note(pending)
                pending = None
    except Exception as error:  # noqa: BLE001  the broker never fails a call: that is the whole contract
        cache_key, writing, pending = None, False, None
        if not isinstance(error, WatchError) or str(error) != "already brokered":
            broker_note({"route": "error", "error": describe(error), "site": error_site(error)})
        if real is None:
            try:
                real = broker_real_gh()
            except Exception:  # noqa: BLE001
                print("glaeda-gh: no real gh on PATH", file=sys.stderr)
                return BROKER_EXIT_NO_GH
    depth = broker_depth()
    if hops >= BROKER_MAX_HOPS or depth >= BROKER_MAX_DEPTH:
        # The marks only stop this broker from *working* twice on one call; they cannot stop a
        # wrapper from handing it back, and `exec` leaves nothing to unwind. Counting is what makes
        # the chain finite, so a wrapper this does not recognise costs an error rather than a hang:
        # hops ends an exec chain at the second pass, depth ends a chain that forks (where every
        # generation is a new pid and hops can never climb). Named in full because whoever sees
        # this has a loop to find.
        reached = (f"{BROKER_MARK}={hops}" if hops >= BROKER_MAX_HOPS else f"{BROKER_DEPTH}={depth}")
        # The depth count is nesting under any brokered gh, not generations of one call, so it can
        # also be reached by a genuinely deep chain of gh calls with no loop in it anywhere. The
        # message says both rather than naming a loop it cannot actually tell apart.
        print(f"glaeda-gh: {' '.join(['gh', *args][:3])} has been through this broker "
              f"{max(hops, depth)} times ({reached}); either something on PATH hands `gh` back "
              f"here, or gh calls are nested this deep under one another. Not running {real} "
              f"again -- run the real gh by path, and CMUX_GH_BROKER_DISABLE=1 keeps this broker "
              f"out.", file=sys.stderr)
        return BROKER_EXIT_NO_GH
    if (cache_key is not None or writing) and real is not None:
        ran: list[int] = []
        try:
            if writing:
                return gh_cache_write(real, args, write_repo, ran, write_scopes, words)
            filled = gh_cache_fill(real, args, cache_key, cache_repo, ran, pending)
            if filled is not None:
                return filled
        except Exception as error:  # noqa: BLE001  fails open, but never runs gh twice
            broker_note({"route": "error", "error": describe(error), "site": error_site(error)})
            if ran:
                return ran[0]  # its decision is written: gh ran inside the fill
    if pending is not None and not pending.get("written"):
        broker_note(pending)
    try:
        # Survives the exec, so this call is not brokered twice; tagged with the pid so it means
        # nothing to anything gh goes on to spawn (see broker_hops). execv keeps the pid, which is
        # why the tag is written before it and not after.
        os.environ[BROKER_MARK] = f"{hops + 1}:{os.getpid()}"
        os.environ[BROKER_DEPTH] = str(depth + 1)  # unscoped: survives a fork as well as an exec
        # If `real` turns out to be the cmuxterm-hq PATH guard after all, this is what stops it
        # delegating the call straight back here. Scoped to this pid, so a guard that gh spawns
        # later is guarding a different call and brokers it normally. CMUX_GH_BROKER_DISABLE is
        # deliberately NOT set: it is a person's unconditional switch, and setting it here turned
        # it off for every descendant -- including, once it was inherited, for the person.
        os.environ["GLAEDA_GH_BROKER_PID"] = str(os.getpid())
        # A GraphQL read takes one of the login's slots on the host before gh runs. The lock lives on the open file,
        # which gh inherits across the exec, so the slot is held until gh (and anything it left holding the file)
        # exits; gh calls nested under it use it (GRAPHQL_SLOT_ENV) rather than wait on their own parent.
        slot = gh_graphql_slot_for(args)
        if slot is not None:
            os.set_inheritable(slot.fileno(), True)
            os.environ[GRAPHQL_SLOT_ENV] = str(os.getpid())
        os.execv(real, [real, *args])
    except OSError as error:
        print(f"glaeda-gh: cannot run {real}: {describe(error)}", file=sys.stderr)
        return BROKER_EXIT_NO_GH
    return EXIT_OK  # unreachable: execv replaces this process


BROKER_SHIM = """#!/usr/bin/env bash
# GLAEDA_GH_BROKERED shim: every `gh` call on this host goes through the broker, which serves what
# glaeda's daemon already holds, refuses reading repository source through the API, and passes
# everything else to the real gh unchanged. It fails open. Written by `glaeda-gh gh --install-shim`.
exec {broker} gh "$@"
"""


AUDIT_LINE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) (\S+) (.*)$")
AUDIT_WINDOW = 90.0  # a read this soon after the same target was read is one a cache would serve
AUDIT_READS = {("pr", "view"), ("pr", "checks"), ("pr", "list"), ("pr", "diff"),
               ("run", "view"), ("run", "list"), ("issue", "view"), ("issue", "list"),
               ("search", "prs"), ("label", "list")}
# A read whose line carries no identifier (the guard logged it before 2026-10-21, or the repository
# could not be resolved) is counted, but never as a repeat: `pr view 7` in two repositories is two
# different reads, and treating them as one would overstate what a cache can do.
AUDIT_BARE = re.compile(r"^(?:pr|run|issue|search|label) [\w-]+(?: \d+)?$")
# The GraphQL endpoint, however it was typed -- four spellings: `graphql`, `/graphql`, and an
# absolute URL on either kind of host. See `endpoint_re`, which `BROKER_FREE_RE` shares: pinning
# api.github.com put a GHE host's `https://ghe.example/api/graphql` in a category of its own, so
# the count undercounted and the sentence below it could go missing altogether.
AUDIT_GRAPHQL_RE = endpoint_re("graphql")
# A logged line of the shape the broker and today's guard write: subcommand words, then an
# identifier (a cache key, an api path, or a number), then the guard's `-R owner/repo`. Anything
# else is counted but never printed back (see cmd_audit).
AUDIT_SAFE = re.compile(r"[a-z][a-z0-9-]{0,30}(?: [a-z][a-z0-9-]{0,30})?"
                        r"(?: (?:https?://)?/?[A-Za-z0-9_][A-Za-z0-9_./:#@~-]{0,199})?"
                        r"(?: [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?")


AUDIT_ENDPOINT_RE = re.compile(r"/?[A-Za-z0-9_.~-]+(?:/[A-Za-z0-9_.~:@-]+)*/?")
AUDIT_TOKEN_RE = re.compile(r"gh[pousr]_|github_pat_", re.IGNORECASE)


def audit_category(words: list[str]) -> tuple[str, bool]:
    """(category, whether repeating it would be a cache hit) for one logged call."""
    first, second = (words + ["", ""])[:2]
    if first == "api":
        if re.search(r"/(contents|git/blobs|git/trees|git/commits|git/refs)", " ".join(words)):
            return "source read through the API", False
        # One endpoint, four spellings, and the log keeps whichever the caller typed. Counted as
        # one category each, because a category split four ways is four small rows that no
        # summary line covers -- and `api /graphql` is a shape this file's own brake test pins as
        # one a script would write. `BROKER_FREE_RE` is the same pattern for rate_limit.
        if AUDIT_GRAPHQL_RE.match(second):
            return "raw gh api graphql", False
        if BROKER_FREE_RE.match(second):
            return "rate_limit (free)", False
        if re.search(r"/actions/runs/\d+/jobs", " ".join(words)):
            return "api .../actions/runs/N/jobs", True
        # A category is printed back, so only an endpoint of a path's shape is. A log written before
        # the guard cut query strings and flag values can hold anything in this word, a token included.
        if second and not (AUDIT_ENDPOINT_RE.fullmatch(second) and not AUDIT_TOKEN_RE.search(second)):
            return "api (endpoint not shown)", False
        return f"api {second}".rstrip(), False
    if (first, second) in AUDIT_READS:
        return f"{first} {second}", True
    return f"{first} {second}".strip() or "(none)", False


AUDIT_CALLER_UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def audit_caller(caller: str) -> str:
    """One calls.log caller field as a group: `session:X` and `tool:X` as written (the gh-quota shim's GH_QUOTA_CALLER);
    an acpmux `NAME.ID` as `session:NAME`; a bare session or thread id as `session-id`; a parent pid, which nothing
    maps back to a tool, as `unnamed (ppid)`."""
    if caller.startswith(("session:", "tool:")):
        return caller
    if caller.startswith("ppid-") or caller in ("", "unknown"):
        return "unnamed (ppid)"
    name, dot, rest = caller.partition(".")
    if dot and rest and not AUDIT_CALLER_UUID.match(name):
        return f"session:{name}"
    return "session-id" if re.fullmatch(r"[0-9a-f-]{20,}", caller) else f"session:{caller}"


def audit_by_caller(lines: list[str], top: int = 3) -> list[dict]:
    """Calls per caller group (audit_caller), most first, each with its TOP categories (audit_category)."""
    groups: dict[str, dict[str, int]] = {}
    for line in lines:
        match = AUDIT_LINE.match(line)
        if not match:
            continue
        _stamp, caller, text = match.groups()
        category, _ = audit_category(text.split())
        bucket = groups.setdefault(audit_caller(caller), {})
        bucket[category] = bucket.get(category, 0) + 1
    rows = [{"caller": who, "calls": sum(cats.values()),
             "top": [{"category": c, "calls": n} for c, n in sorted(cats.items(), key=lambda kv: (-kv[1], kv[0]))[:top]]}
            for who, cats in groups.items()]
    rows.sort(key=lambda r: (-r["calls"], r["caller"]))
    return rows


def cmd_audit_by_caller(lines: list[str], as_json: bool, top: int = 20) -> int:
    """`audit --by caller`: who on this host makes its gh calls, and what each mostly reads."""
    rows = audit_by_caller(lines)
    total = sum(r["calls"] for r in rows)
    if not total:
        raise WatchError("no gh calls logged")
    if as_json:
        print(json.dumps({"calls": total, "byCaller": rows}, sort_keys=True))
        return EXIT_OK
    print(f"gh calls by caller: {total}")
    for r in rows[:top]:
        cats = "; ".join(f"{c['category']} {c['calls']}" for c in r["top"])
        print(f"  {r['calls']:>7}  {100 * r['calls'] / total:5.1f}%  {r['caller']}  ({cats})")
    if len(rows) > top:
        print(f"  ... {len(rows) - top} more callers: {sum(r['calls'] for r in rows[top:])} calls")
    unnamed = next((r["calls"] for r in rows if r["caller"] == "unnamed (ppid)"), 0)
    if unnamed:
        print(f"{unnamed} calls name only a parent pid: logged before the gh-quota shim exported GH_QUOTA_CALLER, or "
              "by a gh that skipped the shim")
    return EXIT_OK


def audit_lines(path: Path, last: int) -> list[str]:
    """The call log's lines, its rotated predecessor first (as cmd_audit reads them), the last LAST (0: all)."""
    try:
        text = path.read_text(errors="replace")
    except OSError as error:
        raise WatchError(f"cannot read {path}: {describe(error)}") from error
    with contextlib.suppress(OSError):
        older = (path.with_name(path.name + ".1")).read_text(errors="replace")
        if older:
            text = older.rstrip("\n") + "\n" + text
    lines = text.splitlines()
    return lines[-last:] if last else lines


def cmd_audit(path: Path, last: int, as_json: bool) -> int:
    """What this host's gh traffic is, and how much of it a cache would have answered.

    Reads the shared call log: the broker writes it where it is installed, the PATH guard where it
    is not. Both write a subcommand and an identifier (an API path with its query cut, or a cache
    key) and never the tail of a command line, so this never reads a token or a comment body."""
    try:
        text = path.read_text(errors="replace")
    except OSError as error:
        raise WatchError(f"cannot read {path}: {describe(error)}") from error
    # The log is rotated once past GUARD_LOG_MAX, so without its predecessor the window this
    # reports would end at the rotation. Optional: there is none until the first one.
    with contextlib.suppress(OSError):
        older = (path.with_name(path.name + ".1")).read_text(errors="replace")
        # One newline between them, because concatenating them bare glued a rotated file's last
        # line to the current log's first and lost *both* records: a truncated `.1` turned two
        # calls into one counted as `api repos/o/r/pulls2026-10-20T00:00:05Z`.
        if older:
            text = older.rstrip("\n") + "\n" + text
    lines = text.splitlines()
    if last:
        lines = lines[-last:]
    total = 0
    counts: dict[str, int] = {}
    reads, repeats = 0, 0
    per_read: dict[str, list[int]] = {}
    seen: dict[str, float] = {}
    hot: dict[str, int] = {}
    since = None  # the first call in the window: the decision records counted below start there
    for line in lines:
        match = AUDIT_LINE.match(line)
        if not match:
            continue
        stamp, _caller, text = match.groups()
        words = text.split()
        at = iso_epoch(stamp)
        if since is None and at is not None:
            since = at
        total += 1
        category, cacheable = audit_category(words)
        counts[category] = counts.get(category, 0) + 1
        if not cacheable or at is None:
            continue
        reads += 1
        bucket = per_read.setdefault(category, [0, 0])
        bucket[0] += 1
        if AUDIT_BARE.fullmatch(text):
            continue  # no repository in the line: cannot tell one repo's PR 7 from another's
        hot[text] = hot.get(text, 0) + 1
        # Not below zero: concurrent writers can append out of order, and a line stamped before the
        # one it follows is not a re-read of it. With that, every line counted here has an earlier
        # read of the same target within the window, so it is a repeat in time order too, and the
        # figure stays a floor whatever order the log was written in.
        if 0 <= at - seen.get(text, float("-inf")) <= AUDIT_WINDOW:
            repeats += 1
            bucket[1] += 1
        seen[text] = at
    if not total:
        raise WatchError(f"no gh calls logged in {path}")
    served = {}
    # What became of the repeats: a decision record that names its read (`line`, written since
    # 2026-10-31) says whether the cache answered it or it reached GitHub. Counted over the same
    # window as the call log above, and with the same rule for a repeat, so "reached GitHub" is the
    # part of `repeatsWithin` a cache did not absorb -- the number the cache exists to bring down.
    named = {"reads": 0, "repeats": 0, "repeatsReachedGitHub": 0}
    named_seen: dict[str, float] = {}
    # Both files, newest last, for the same reason the call log reads its predecessor: these counts
    # are the broker's before/after number, and reading only the live file truncated them at every
    # rotation. Each line is self-contained JSON, so unlike the call log there is nothing to glue.
    decisions = broker_log()
    for source in (decisions.with_name(decisions.name + ".1"), decisions):
        try:
            text = source.read_text(errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            try:
                record = json.loads(line)
            except ValueError:
                continue  # a torn last line at a rotation boundary is one record, not the file
            route = record.get("route") if isinstance(record, dict) else None
            if not isinstance(route, str):
                continue  # a record of some other shape is not a decision
            served[route] = served.get(route, 0) + 1
            said, at = record.get("line"), record.get("at")
            if (not isinstance(said, str) or not isinstance(at, (int, float)) or since is None or at < since - 1
                    or route not in ("pass", "cache", "serve") or AUDIT_BARE.fullmatch(said)):
                continue
            named["reads"] += 1
            if 0 <= at - named_seen.get(said, float("-inf")) <= AUDIT_WINDOW:
                named["repeats"] += 1
                named["repeatsReachedGitHub"] += route == "pass"
            if route == "pass":
                named_seen[said] = at  # a repeat is a re-read of what last came from GitHub
    # Not a second JSON field: this is `categories["raw gh api graphql"]` by construction, and a
    # count under two names is a count that can disagree with itself.
    batched = counts.get("raw gh api graphql", 0)
    if as_json:
        print(json.dumps({"calls": total, "categories": counts, "cacheableReads": reads,
                          "repeatsWithin": {"seconds": AUDIT_WINDOW, "calls": repeats},
                          "perRead": {k: {"reads": v[0], "repeats": v[1]} for k, v in per_read.items()},
                          "brokerDecisions": served, "decisionReads": named}, sort_keys=True))
        return EXIT_OK
    print(f"{total} gh calls logged in {path}\n")
    print(f"{'category':<34}{'calls':>8}{'share':>8}")
    for category, n in sorted(counts.items(), key=lambda kv: -kv[1])[:20]:
        print(f"{category:<34}{n:>8}{100 * n / total:>7.1f}%")
    print(f"\n{'read':<34}{'calls':>8}{'repeat within ' + str(int(AUDIT_WINDOW)) + 's':>22}")
    for category, (n, again) in sorted(per_read.items(), key=lambda kv: -kv[1][0]):
        print(f"{category:<34}{n:>8}{f'{again} ({100 * again / n:.0f}%)':>22}")
    print(f"{'all cacheable reads':<34}{reads:>8}"
          f"{f'{repeats} ({100 * repeats / max(reads, 1):.0f}%)':>22}")
    print(f"\n{repeats} calls ({100 * repeats / total:.1f}% of all of them) re-read something this host had read "
          f"within {int(AUDIT_WINDOW)} seconds.")
    # Only lines of the shape today's writers produce are quoted back. A log written before
    # 2026-10-21 kept the value of a flag it did not know took one, and an audit is read and pasted
    # into reports: whatever is in those old lines stays counted but unquoted.
    hot = {text: n for text, n in hot.items() if AUDIT_SAFE.fullmatch(text)}
    if hot:
        print("hottest targets: " + "; ".join(f"{text} x{n}" for text, n in
                                              sorted(hot.items(), key=lambda kv: -kv[1])[:5]))
    if named["reads"]:
        reached = named["repeatsReachedGitHub"]
        print(f"of {named['reads']} cacheable reads the broker recorded in this window, {reached} "
              f"({100 * reached / named['reads']:.1f}%) re-read within {int(AUDIT_WINDOW)} seconds what this host had "
              f"read from GitHub and still reached it; the cache answered {named['repeats'] - reached} other repeats.")
    if served:
        print("\nbroker decisions so far: " + ", ".join(f"{k} {v}" for k, v in sorted(served.items())))
    if batched:
        # Coverage, not cost. An earlier version of this line said a batching caller "looks
        # cheaper here than its GraphQL points are", which was backwards: GitHub prices a GraphQL
        # call at the requests needed for its connections divided by 100, rounded, minimum 1, so
        # one aliased query over forty PRs is about 1 point against about 40 for the loop --
        # skills/github-ci-wait/SKILL.md says so, and this contradicted it. Per-call shares are
        # the right unit for GraphQL points. What a `graphql` line really hides is *reads*: the
        # category is not cacheable, so none of the objects inside it reaches `cacheableReads`,
        # `repeatsWithin` or `perRead`, and the repeat *count* is a floor rather than an estimate.
        # The count and not the shares beside it. A hidden read written out can land on either
        # side of a share, so a share can go up, down or stay put -- all three are in
        # AuditGraphqlTest, which is what finally made the sentence checkable rather than
        # reviewable. Four earlier drafts each inferred a direction instead: "both *fall*" from the
        # denominator alone, "either direction" said of the two counts rather than the share,
        # "grows the numerator and the denominator" -- which reads as both always growing, and a
        # review measured 33.3% -> 25.0% where only the denominator did -- and then "can grow the
        # numerator and does grow the denominator", where a review measured 33.3% -> 33.3% by
        # writing the hidden read out in place of the batched call it was carried by. Say what is
        # measured, nothing about mechanism, and let a test hold it.
        # "The calls are counted above" because the total line counts them, and the repeat
        # percentage's denominator is that total. Not "in their own category row": the category
        # table is the top 20 by count, so on a host with more than twenty distinct categories
        # this row is not in it -- measured, 21 distinct `api` paths and the graphql row gone, with
        # the sentence still true. An earlier draft said "None of them is counted above", which the
        # total contradicts. What is not counted is the *objects* inside them, and what follows
        # from that is only that no graphql call is a cacheable read or a repeat.
        # "however many ... asked for" covers zero, which is the only thing needed: the log keeps
        # the path and never the document, so a batched read of forty and a call that reads nothing
        # are the same line here, and a floor needs the hidden reads to be >= 0. Earlier drafts
        # named the mutation and the one-object probe as carrying nothing, and both were claims
        # about GitHub's API that this log cannot see -- a mutation selects its payload, and a probe
        # of an object read nearby hides a repeat. "each carrying", not "each one request": with
        # `--paginate` one command line is several HTTP requests, and the log keeps neither the
        # flags (broker_logged_target drops them) nor the request count.
        # "the same-target re-reads a cache could have been asked for", not "what a cache could
        # have answered": this broker's cache keys on the target, and the repeat count is
        # flag-blind in the other direction -- `pr view X --json state` and `pr view X --json
        # files` log the same target and score as one repeat, while the broker would have to fetch
        # the second field set. So the figure is a floor against hidden GraphQL reads and can
        # overcount against the cache's own hit rate; naming same-target re-reads is the part that
        # holds both ways.
        # The floor is over the calls in *this report*. With `--last N` the window is the last N
        # lines, so writing hidden reads out as separate lines pushes older ones out and the
        # comparison runs over two different sets of calls -- measured, and pinned as a known limit
        # by test_the_floor_is_over_one_set_of_calls: 1 repeat becomes 0 under `--last 3`. Held to
        # one set it cannot fall, because at most one repeat is counted per line per target, so the
        # figure can never exceed the true same-target re-read count; two reviews found no
        # counterexample, in 4000 and in 1800 random insertions, for repeats, reads and calls alike.
        # No pricing claim here on purpose -- this file is read as durable output, and a price is
        # the part that goes stale.
        # "was" for one call: N=1 is the common case on a host that batches rarely, and it is what
        # the crowded-table fixture prints.
        print(f"\n{batched} of those calls {'was' if batched == 1 else 'were'} `gh api graphql`, "
              f"each carrying however many objects "
              f"the caller asked for, which this cannot see. The calls are counted above; none of "
              f"the objects inside them is, so none of them is counted as a cacheable read or as a "
              f"repeat. That makes the repeat count a floor on the same-target re-reads a cache "
              f"could have been asked for in this report, not an estimate. The shares beside it "
              f"are not floors: a hidden read written out can land on either side of a share, so "
              f"a share can go up, down or stay where it is.")
    return EXIT_OK


def cmd_gh_install_shim(print_only: bool) -> int:
    broker = Path(__file__).resolve()
    text = BROKER_SHIM.format(broker=shlex.quote(str(broker)))
    if print_only:
        print(text, end="")
        return EXIT_OK
    target = Path.home() / ".local/lib/glaeda-gh/bin"
    target.mkdir(parents=True, exist_ok=True)
    shim = target / "gh"
    shim.write_text(text)
    shim.chmod(0o755)
    print(f"glaeda-gh: wrote {shim}. Put it in front of the real gh:\n"
          f"    export PATH={shlex.quote(str(target))}:$PATH\n"
          f"  Then `gh pr view N -R OWNER/REPO --json state` is served from glaeda's cache when it is "
          f"fresh. Undo by removing that line and the file.")
    return EXIT_OK


# launchctl's answer for a gui/UID domain that does not exist: "125: Domain does not support specified
# action". A Mac whose user was logged out (cmux16, 2026-10-24: the console sat at the login window with
# no reboot to log it back in) has no gui domain, so its LaunchAgent cannot load there at all.
NO_GUI_DOMAIN = 125


def launchd_domain() -> str | None:
    """gui/UID while this user has a login session; user/UID when launchd says there is none; None when
    launchctl cannot tell (any other answer, or none): callers then change nothing."""
    gui = f"gui/{os.getuid()}"
    try:
        code = run_bounded(["launchctl", "print", gui], 10).returncode
    except (OSError, subprocess.TimeoutExpired):
        return None
    return gui if code == 0 else f"user/{os.getuid()}" if code == NO_GUI_DOMAIN else None


DOMAIN_UNKNOWN_HINT = (f"launchctl could not say whether anyone is logged in here (launchctl print gui/$(id -u) "
                       f"answered neither 0 nor {NO_GUI_DOMAIN}), so nothing was started or stopped: run "
                       f"glaeda-gh restart again, and if it persists check launchctl print gui/$(id -u), "
                       f"launchctl print user/$(id -u)/{LAUNCH_LABEL} and sudo launchctl print "
                       f"system/{LAUNCH_LABEL} by hand. Never run glaeda-gh serve yourself")


def background_copy_path() -> Path:  # read BASE at call time: tests move it
    return BASE / f"{LAUNCH_LABEL}.background.plist"


def background_plist() -> str:
    """The LaunchAgent's plist, as a copy the user domain loads. launchd refuses an Aqua job there
    ("5: Input/output error"); the same job marked Background runs. The LaunchAgent stays the one
    source: the copy is rewritten from it on every user-domain restart and lives only until the next reboot."""
    source = Path.home() / "Library/LaunchAgents" / f"{LAUNCH_LABEL}.plist"
    with open(source, "rb") as handle:
        job = plistlib.load(handle)
    if not isinstance(job, dict):
        raise ValueError(f"{source} is a plist {type(job).__name__}, not a job")
    job["LimitLoadToSessionType"] = "Background"
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    copy = background_copy_path()
    # launchctl refuses a job file group or others can write, and a umask of 002 would make it one; a rename
    # also leaves an older copy's mode behind
    part = copy.with_name(copy.name + ".part")
    fd = os.open(part, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as handle:
        os.fchmod(handle.fileno(), 0o600)
        plistlib.dump(job, handle)
    os.replace(part, copy)
    return os.fspath(copy)


# launchctl print's answer for a service its domain does not have (measured on cmux16 and cmux17, macOS 27, in
# the user, system and gui domains). Any other failure says nothing either way, so callers fail closed on it.
NOT_LOADED = 113


def unloaded(target: str) -> bool:
    """Whether launchctl says TARGET (domain/label) is not loaded; False when it is, or when it cannot tell."""
    return run_bounded(["launchctl", "print", target], 10).returncode == NOT_LOADED


def system_daemon_loaded() -> bool | None:
    """Whether a headless Mac's system LaunchDaemon with the service's label is loaded (service_loaded): None
    when launchctl's answer is neither loaded (0) nor not loaded (113)."""
    code = run_bounded(["launchctl", "print", f"system/{LAUNCH_LABEL}"], 10).returncode
    return True if code == 0 else False if code == NOT_LOADED else None


SYSTEM_UNKNOWN_HINT = (f"launchctl could not say whether the system LaunchDaemon system/{LAUNCH_LABEL} is loaded: "
                       f"check with sudo launchctl print system/{LAUNCH_LABEL} before starting anything. If it is "
                       f"loaded: sudo launchctl kickstart -k system/{LAUNCH_LABEL}; if not: glaeda-gh restart")


SYSTEM_DAEMON_HINT = (f"the system LaunchDaemon system/{LAUNCH_LABEL} runs the daemon on this headless Mac; restart "
                      f"it as root: sudo launchctl kickstart -k system/{LAUNCH_LABEL}")


def launchd_state(domain: str | None = None) -> str | None:
    """The service's `state = ...` line (running, spawn scheduled, not running), or None."""
    domain = domain or launchd_domain()
    if domain is None:
        return None
    try:
        result = run_bounded(["launchctl", "print", f"{domain}/{LAUNCH_LABEL}"], 10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    found = re.search(r"^\s*state = (.+)$", result.stdout, re.M)
    return found.group(1).strip() if found else None


def restart_service(hung: bool) -> tuple[bool, str]:
    """Restart (hung) or start the service once. (started, what was run)."""
    if sys.platform != "darwin":
        # a unit that hit its start limit refuses start and restart until this
        run_bounded(["systemctl", "--user", "reset-failed", SYSTEMD_UNIT], SUBPROCESS_DEADLINE)
        argv = ["systemctl", "--user", "restart" if hung else "start", SYSTEMD_UNIT]
        result = run_bounded(argv, SUBPROCESS_DEADLINE)
        return result.returncode == 0, typed_line(argv)
    domain = launchd_domain()
    if domain is None:
        # booting a copy out, or loading one, on a guess about the login session could leave no daemon at all
        return False, "nothing: " + DOMAIN_UNKNOWN_HINT
    target = f"{domain}/{LAUNCH_LABEL}"
    # A headless Mac's system LaunchDaemon (service_loaded) runs the daemon there: neither a copy nor the
    # LaunchAgent may start beside it, whether or not someone is logged in
    system = system_daemon_loaded()
    if system is None:
        return False, "nothing: " + SYSTEM_UNKNOWN_HINT
    if system:
        return False, "nothing: " + SYSTEM_DAEMON_HINT
    if domain.startswith("user/"):
        # Always reload, never kickstart and never wait on a scheduled respawn: either would keep running a copy
        # of an older LaunchAgent
        try:
            plist = background_plist()
        except Exception as error:  # OSError, plistlib's and expat's parse errors, a plist that is not a job
            return False, f"no Background copy for {domain}: {type(error).__name__}: {error}"
        if launchd_domain() != domain:
            return False, "nothing: someone logged in or out while restarting; run glaeda-gh restart again"
        loaded = reload_job(target, domain, plist)
        how = (f"launchctl bootout and bootstrap {target} from {plist} "
               f"(nobody is logged in, so gui/{os.getuid()} does not exist)")
        return loaded == 0, how + ("" if loaded == 0 else f" (bootstrap exit {loaded})")
    # Logged in again: the copy a logged-out restart loaded would keep a second KeepAlive daemon (waiting on
    # daemon.lock behind this one) and is what a hung-holder stop would hit first, so it goes now
    if launchd_domain() != domain:
        return False, "nothing: someone logged in or out while restarting; run glaeda-gh restart again"
    gone, dropped = drop_background_copy()
    if not gone:
        return False, dropped + f"; not starting {target} beside it"
    if not hung and launchd_state(domain) == "spawn scheduled":
        return True, dropped + "nothing: launchd has already scheduled the respawn"
    argv = ["launchctl", "kickstart"] + (["-k"] if hung else []) + [target]
    result = run_bounded(argv, SUBPROCESS_DEADLINE)
    if result.returncode == 0:
        return True, dropped + typed_line(argv)
    # 5 (launchd reported "spawn failed") or 113 (not loaded): unload and load it, once, here
    plist = os.fspath(Path.home() / "Library/LaunchAgents" / f"{LAUNCH_LABEL}.plist")
    loaded = reload_job(target, domain, plist)
    how = f"{dropped}{typed_line(argv)} (exit {result.returncode}), then launchctl bootout and bootstrap"
    return loaded == 0, how + ("" if loaded == 0 else f" (bootstrap exit {loaded})")


def reload_job(target: str, domain: str, plist: str) -> int:
    """launchctl bootout TARGET, then bootstrap PLIST into DOMAIN; bootstrap's exit code."""
    run_bounded(["launchctl", "bootout", target], SUBPROCESS_DEADLINE)
    # bootout can return before the job is torn down, and bootstrap answers 5 while it is still loaded
    deadline = time.monotonic() + BOOTSTRAP_RETRY
    while True:
        loaded = run_bounded(["launchctl", "bootstrap", domain, plist], SUBPROCESS_DEADLINE)
        if loaded.returncode == 0 or time.monotonic() >= deadline:
            return loaded.returncode
        time.sleep(1)


def drop_background_copy() -> tuple[bool, str]:
    """Boot out the user-domain copy if one is loaded. (no copy is left loaded, what was done: a prefix for
    restart's report, or why the copy is still there)."""
    copy = f"user/{os.getuid()}/{LAUNCH_LABEL}"
    if unloaded(copy):
        return True, ""
    out = run_bounded(["launchctl", "bootout", copy], SUBPROCESS_DEADLINE)
    # bootout can return before the job is torn down (reload_job): it is gone when print says it is not loaded,
    # and a print that cannot tell keeps the LaunchAgent off like a copy still there
    deadline = time.monotonic() + BOOTSTRAP_RETRY
    while not unloaded(copy):
        if time.monotonic() >= deadline:
            return False, (f"launchctl bootout {copy} (the Background copy from a logged-out restart) exited "
                           f"{out.returncode} and it is still loaded after {BOOTSTRAP_RETRY}s")
        time.sleep(1)
    return True, f"launchctl bootout {copy} (the Background copy from a logged-out restart), then "


def cmd_restart(force: bool = False) -> int:
    """Restart the daemon at most once across every session: single-flight under restart.lock, and
    a no-op within RESTART_COOLDOWN of the last restart or while the daemon is healthy."""
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(BASE / "restart.lock", "a+") as guard:
        if not try_lock(guard):
            print("glaeda-gh: another session is restarting the daemon right now. Do not restart it too: "
                  "re-run your wait in a minute.")
            return EXIT_OK
        running = daemon_running(grace=DOWN_GRACE)
        broken = daemon_failing() if running else None
        if broken is not None:
            say_waiting(failing_message(broken))
            return EXIT_DOWN
        lag = daemon_stale() if running else None
        # A fresh heartbeat is not health: the data it vouches for must be fresh too (STALE_DATA_AFTER)
        starved = daemon_starved() if running and lag is None else None
        # "Held" is not forever (STALE_HELD_MAX): past it, whatever explains the old data, a plain restart restarts.
        # 2026-11-21: NOW showed "waited PR data 371 min old (stale)" while `restart` declined on a held verdict
        # (restart false: a quota stop, then "reading the backlog it left") and every session paid a --force call.
        overheld = starved is not None and starved["quota"] and starved["age"] > STALE_HELD_MAX
        if starved is not None and starved["quota"] and not overheld and not force:
            print(f"glaeda-gh: the daemon is running, but its {starved['kind']} data for waits is "
                  f"{int(starved['age'])}s old because {starved['why']}. "
                  "A restart would not read any sooner; a wait reads its own target once (direct_read). "
                  f"Not restarted until the data is {STALE_HELD_MAX}s old; --force to restart anyway.")
            return EXIT_OK
        if running and lag is None and starved is None and not force:
            status = read_json(BASE / "daemon.json")
            last = ((status.get("stale") if isinstance(status, dict) else None) or {}).get("last")
            cleared = ""
            if isinstance(last, dict) and isinstance(last.get("at"), (int, float)):
                cleared = (f" The daemon's last stale verdict, at {utc_clock(last['at'])} ({last.get('kind')} data "
                           f"{last.get('age')}s old: {last.get('reason') or last.get('state')}), cleared since.")
            print("glaeda-gh: the daemon is running, its heartbeat is fresh and the data its waits are blocked on is "
                  f"under {STALE_DATA_AFTER}s old; nothing to restart: healthy; --force to restart anyway.{cleared} "
                  "If a wait printed an older warning, re-run it.")
            return EXIT_OK
        if starved is not None:
            slowed = f" The quota slows it ({starved['why']}), which alone should not leave it this old." \
                if starved.get("why") else " Nothing recorded explains it."
            if overheld:
                slowed = (f" It has been held past {STALE_HELD_MAX}s ({starved.get('why') or starved.get('cause')}), "
                          "which is starvation, not pacing.")
            if starved.get("cause"):
                slowed += f" The daemon's reads: {starved['cause']}."
            slowed += f" Before it restarts, for the record: {STALE_DUMP_ADVICE}."
            print(f"glaeda-gh: the daemon's heartbeat is fresh, but its {starved['kind']} data for waits is "
                  f"{int(starved['age'])}s old (over {STALE_DATA_AFTER}s): it is not refreshing, so restarting it."
                  f"{slowed}")
        ago = recent_restart(holding=True)
        if ago is not None and not force:
            record = restart_record() or {}
            print(f"glaeda-gh: the daemon was restarted {int(ago)}s ago (pid {record.get('by', '?')}: "
                  f"{record.get('how', '?')}). Do not restart it again: a new daemon writes a heartbeat as soon "
                  f"as it holds its lock. Re-run your wait; after {RESTART_COOLDOWN}s a restart is allowed again.")
            return EXIT_OK
        # running but silent (or starved), or an active unit silent with no visible lock: restart; not running: start
        hung = running or silent_unit() is not None
        holder = lock_holder() if running else None
        killed = None
        began = time.time()
        write_json(BASE / "restart.json", {"at": began, "by": os.getpid(), "how": "starting"})
        if holder is not None and holder["silent"] > STALE_HEARTBEAT and is_serve(holder["pid"]):
            # Stop the hung holder itself: when it is a serve outside the service, kickstart cannot
            # reach it and the service's daemon waits behind it. When it is the service's own, launchd
            # respawns it (KeepAlive), so the start below must not kill that respawn again (no -k).
            if stop_process(holder["pid"]):
                killed = holder["pid"]
        try:
            started, how = restart_service(hung and killed is None)
        except (OSError, subprocess.TimeoutExpired) as error:
            started, how = False, f"failed: {type(error).__name__}"
        if killed is not None:
            how = f"SIGTERM to the hung lock holder pid {killed}, then {how}"
        # Success is a heartbeat written after the restart began (a new daemon writes one as soon as
        # it holds the lock), not merely a held lock: a hung holder that survived holds it too.
        ok = started and new_heartbeat(began, RESTART_SETTLE)
        # macOS keeps its rule (a restart without a heartbeat starts no cooldown): its "spawn scheduled"
        # path succeeds without running anything
        ran = started and sys.platform != "darwin"
        write_json(BASE / "restart.json", {"at": began, "by": os.getpid(), "how": how, "ok": ok, "ran": ran})
        if ok:
            print(f"glaeda-gh: restarted the daemon ({how}); a new daemon holds its lock and wrote its heartbeat. "
                  "Re-run your wait.")
            return EXIT_OK
        print(f"glaeda-gh: tried to {'restart' if hung else 'start'} the daemon ({how}), but no new daemon wrote a "
              f"heartbeat within {RESTART_SETTLE}s. Tell the user. By hand: {start_hint(restart=hung)}", file=sys.stderr)
        return EXIT_DOWN


def stop_process(pid: int) -> bool:
    """SIGTERM, then SIGKILL after TAKEOVER_GRACE (as take_over does). True once `pid` is gone."""
    for sig, grace in ((signal.SIGTERM, TAKEOVER_GRACE), (signal.SIGKILL, 5)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return True
        except OSError:
            return False
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                return True
            except OSError:
                return False
            time.sleep(0.2)
    return False


def new_heartbeat(since: float, grace: float) -> bool:
    """Whether, within `grace` seconds, the lock is held and daemon.json has a heartbeat newer than `since`."""
    deadline = time.monotonic() + grace
    while True:
        status = read_json(BASE / "daemon.json")
        at = status.get("at") if isinstance(status, dict) else None
        if isinstance(at, (int, float)) and at >= since and lock_held():
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


# ---------------------------------------------------------------- post: one paced writer for every session


def post_request(item: dict) -> tuple[str, str, dict]:
    """The REST call for a queued write."""
    repo = item["repo"]
    if item["kind"] == "comment":
        return "POST", f"/repos/{repo}/issues/{item['number']}/comments", {"body": item["body"]}
    if item["kind"] == "review":
        return "POST", f"/repos/{repo}/pulls/{item['number']}/reviews", {"body": item["body"], "event": item["event"]}
    if item["kind"] == "pr":
        return "POST", f"/repos/{repo}/pulls", {"title": item["title"], "head": item["head"], "base": item["base"],
                                                "body": item["body"], "draft": False}
    raise WatchError(f"unknown write kind {item['kind']!r}")


def read_body(body: str | None, body_file: str | None) -> str:
    if (body is None) == (body_file is None):
        raise WatchError("post takes one of --body and --body-file (- for stdin)")
    if body_file is not None:
        try:
            body = sys.stdin.read() if body_file == "-" else Path(body_file).read_text()
        except OSError as error:
            raise WatchError(f"--body-file {body_file}: {error.strerror or type(error).__name__}") from None
    if len(body.encode()) > POST_BODY_MAX:
        raise WatchError(f"the body is over GitHub's {POST_BODY_MAX} bytes")
    return body


def post_item(args: argparse.Namespace) -> dict:
    item: dict[str, Any] = {"kind": args.kind, "body": read_body(args.body, args.body_file), "queuedAt": time.time(),
                            "attempts": 0, "by": os.environ.get("CMUX_SURFACE_ID") or os.environ.get("ACPMUX_SESSION")
                            or os.getcwd()}
    if args.kind == "pr":
        if not re.fullmatch(rf"{NAME}/{NAME}", args.target):
            raise WatchError("post pr takes OWNER/REPO")
        if not args.head or not args.base or not args.title:
            raise WatchError("post pr needs --head, --base and --title")
        item.update(repo=args.target, head=args.head, base=args.base, title=args.title, reviewers=args.reviewer or [])
    else:
        # `pr:o/r#5` and `comment:o/r#5` (this tool's own notation for the thread) name the same thread here,
        # whichever of them the caller copied out of a wait line, so both are accepted for either kind.
        target = drop_kind_prefix(args.target, args.kind, also=("pr", "comment"))
        # Through the one shared parser, as land_key is: until 2026-11-21 this matched the *strict* PR_RE /
        # ISSUE_RE, so `post comment o/r/5`, a bare `5` and even `pr:o/r/5` -- a string status, wait and land
        # all read, and one this tool prints -- refused here. The kind is named one word to the left, so the
        # separator before the number is whichever the caller typed (see PR_KEY_RE). `post review` keeps the
        # pr form: PR_KEY_RE has no `/issues/`, and an issue has no reviews.
        kind = "pr" if args.kind == "review" else "comment"
        m = KEY_RES[kind].fullmatch(target)
        if not m and not BARE_NUMBER.fullmatch(target):
            raise WatchError(f"post {args.kind} takes {KIND_FORMS[kind]}, not {args.target!r}")
        if args.head or args.base or args.title or args.reviewer:
            raise WatchError("--head, --base, --title and --reviewer are for post pr")
        if args.kind == "comment" and args.event != "comment":
            raise WatchError("--event is for post review")
        key = getattr(args, "status_key", None)
        if key is not None and not isinstance(key, str):
            key = None  # a caller's own namespace without the flag (an older argv, a test's Mock)
        if key:
            if args.kind != "comment" or not STATUS_KEY.fullmatch(key):
                raise WatchError("--status-key is for post comment: letters, digits and . : = @ / - (120 at most)")
            item["status"] = key
        if getattr(args, "gate", False) is True:
            item["gate"] = True  # a receipt a merge waits on: sent ahead of the rest (outbox_gate)
        # parse_key resolves a bare number against the repository the caller stands in (or raises, naming the
        # form to type); a repository that was in the string keeps the case it was typed in, as land_key does.
        _, owner, repo, number = split_key(parse_key(kind, target))
        item.update(repo=f"{m.group(1)}/{m.group(2)}" if m else f"{owner}/{repo}", number=int(number))
        if args.kind == "review":
            item["event"] = args.event.upper().replace("-", "_")
    item["id"] = f"{time.time_ns() // 1_000_000:013d}-{os.getpid()}-{os.urandom(3).hex()}"
    return item


def post_state(post_id: str) -> dict | None:
    if not POST_ID.fullmatch(post_id):
        raise WatchError(f"{post_id!r} is not a post id (glaeda-gh post status lists them)")
    done = read_json(posted_dir() / f"{post_id}.json")
    if isinstance(done, dict):
        return done
    queued = read_json(outbox_dir() / f"{post_id}.json")
    if not isinstance(queued, dict):
        return None
    order = [p.stem for p, _ in outbox_queue()]
    ahead = order.index(post_id) if post_id in order else 0  # in send order: a receipt jumps the awareness comments
    outbox = (read_json(BASE / "daemon.json") or {}).get("outbox") or {}
    pause = outbox.get("pause") if isinstance(outbox.get("pause"), dict) else None
    return {k: v for k, v in queued.items() if k != "body"} | {"state": "queued", "ahead": ahead,
                                                                "holdUntil": outbox.get("holdUntil"), "pause": pause}


def span(seconds: float) -> str:
    """A length of time: 42s, 3m. (age() reads an epoch time; given a length it printed decades.)"""
    s = int(max(0, seconds))
    return f"{s}s" if s < 120 else f"{s // 60}m"


def pause_line(pause: Any) -> list[str]:
    """The login's create pause and the outbox's ask of it, as `post status` prints them (daemon.json outbox.pause)."""
    if not isinstance(pause, dict):
        return []
    parts = []
    until = pause.get("until")
    if isinstance(until, (int, float)) and not isinstance(until, bool) and until > time.time():
        parts.append(f"the login's create pause holds creates for {span(until - time.time())}")
    failures = pause.get("failures")
    if isinstance(failures, int) and failures > 0:
        ago = pause.get("answeredAgo")
        parts.append(f"pause ask failed {failures} in a row ({pause.get('timeouts') or 0} timed out; last: "
                     f"{pause.get('lastError')}); last answer "
                     + (f"{span(ago)} ago" if isinstance(ago, (int, float)) else "never"))
    if pause.get("absent"):
        parts.append("the pause keeper has no content-pause (an older gh-quota): creates go out as with no keeper")
    if pause.get("holding"):
        parts.append("creates wait until the pause is known")
    return parts


def post_line(state: dict) -> str:
    if state["state"] == "posted":
        return (state.get("url") or "posted") + (f" ({state['note']})" if state.get("note") else "")
    if state["state"] == "failed":
        return f"failed: {state.get('error')}"
    if state["state"] == "superseded":
        return f"superseded, not sent: {state.get('note')}"
    parts = [f"queued as {state['id']}", f"{state.get('ahead', 0)} ahead"]
    if state.get("holdUntil") and state["holdUntil"] > time.time():
        parts.append(f"GitHub holds writes for {span(state['holdUntil'] - time.time())}")
    parts.extend(pause_line(state.get("pause")))
    if state.get("lastError"):
        parts.append(f"last attempt: {state['lastError']}")
    return "; ".join(parts)


# The host's public-body guard (leo-workspace tools/public_body_guard.py, next to gh_quota.py where PACE_CLI's link
# points; GLAEDA_BODY_GUARD overrides): the check the gh shim runs on `gh pr|issue create|comment` and `gh api`
# writes. A post skips the shim (the daemon writes through REST), so it asks the same guard before it queues: no
# fleet host, session id or readable agent link in a repo not known private, and an agent's PR ends with its
# agent-identity footer. On 2026-10-28 ten public cmux PRs named fleet hosts after lanes opened them with
# `glaeda-gh post pr` (cmuxterm-hq#4946, pattern D). A host without the guard posts as before, as the shim does.
BODY_GUARD_ENV = "GLAEDA_BODY_GUARD"


def body_guard_path() -> Path | None:
    named = os.environ.get(BODY_GUARD_ENV)
    if named:
        return Path(named)
    try:
        found = PACE_CLI.resolve().parent / "public_body_guard.py"
    except OSError:
        return None
    return found if found.is_file() else None


def body_guard_args(item: dict, body_file: str) -> list[str]:
    """The gh call this post stands for, as the guard reads gh's arguments (with -R, so no checkout is asked)."""
    repo = item["repo"]
    if item["kind"] == "pr":
        return ["pr", "create", "-R", repo, "--title", item["title"], "--head", item["head"], "--base", item["base"],
                "--body-file", body_file]
    if item["kind"] == "review":
        return ["pr", "review", str(item["number"]), "-R", repo, "--body-file", body_file]
    return ["issue", "comment", str(item["number"]), "-R", repo, "--body-file", body_file]


def body_guard_refusal(item: dict) -> str | None:
    """The guard's refusal of this post, or None (allowed, or no guard on this host). The guard asks GitHub
    whether the repo is private (cached an hour); an unknown answer counts as public."""
    path = body_guard_path()
    if path is None:
        return None
    if not path.is_file():
        return f"the body guard {path} ({BODY_GUARD_ENV}) is missing"
    import importlib.util
    spec = importlib.util.spec_from_file_location("public_body_guard", path)
    if spec is None or spec.loader is None:
        return f"the body guard {path} could not be loaded"
    guard = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = guard  # before exec_module: a dataclass in the guard looks its module up here
    spec.loader.exec_module(guard)
    fd, name = tempfile.mkstemp(suffix=".md", prefix="glaeda-post-")
    try:
        with os.fdopen(fd, "w") as fh:  # inside the try: a failed write still removes the file
            fh.write(item["body"])
        args = body_guard_args(item, name)
        return guard.refusal(args, os.environ) or guard.footer_refusal(args, os.environ)
    finally:
        with contextlib.suppress(OSError):
            os.unlink(name)


# What the lane-gh broker writes for a host with no login of its own (cmuxterm-hq lane-gh-broker): the write runs
# with a token minted for the call, so it needs no token here. Until 2026-11-21 `post` queued every write on such a
# host and upstream_refuse_posts failed it one tick later, so `post pr` exited 0 and no PR was opened: a lane hit
# that twice in one session and opened both PRs by hand with `gh pr create`. A write the broker has a tool for is
# made here instead, and one it has no tool for is refused at accept, with its body written out and the command that
# posts it named (cmuxterm-hq docs/handbook/printed-step-not-a-command.md).
BROKER_POST_TOOLS = {"pr": "pr_create", "comment": "comment"}
BROKER_POST_DEADLINE = 600.0  # a busy broker queues a write behind other lanes' (hq broker-caller-admission)


def unsent_dir() -> Path:
    return BASE / "unsent"  # a write this host cannot make: its body, kept for the command that can


def broker_post_args(item: dict) -> tuple[str, dict] | None:
    """The `lane-gh call` tool and arguments for a queued write, or None where the broker has no form for it: a
    review, and the queue's own features (a status key, a merge gate, reviewers), which the broker does not carry."""
    tool = BROKER_POST_TOOLS.get(str(item.get("kind")))
    if not tool or item.get("status") or item.get("gate") or item.get("reviewers"):
        return None
    if tool == "pr_create":
        return tool, {"repo": item["repo"], "base": item["base"], "head": item["head"],
                      "title": item["title"], "body": item["body"]}
    return tool, {"repo": item["repo"], "number": item["number"], "body": item["body"]}


def broker_post_next(item: dict, body: Path | None = None) -> str:
    """The command that makes a write this host cannot, with every field this queue already knows filled in
    (cmuxterm-hq docs/handbook/printed-step-not-a-command.md). A lane VM's `gh` reaches the broker's own tools, and
    the broker has none for a review, so a review is posted from the broker host, where this queue has a login."""
    repo, number = item.get("repo") or "OWNER/REPO", item.get("number")
    body_file = str(body) if body is not None else "F"
    if item["kind"] == "review":
        return ("post it from the broker host, which has a login for this queue: "
                f"glaeda-gh post review {repo}#{number} "
                f"--event {str(item.get('event') or 'comment').lower()} --body-file {body_file}")
    if item["kind"] == "pr":
        return (f"write it with gh, which routes through this host's broker: gh pr create --repo {repo} "
                f"--base {item.get('base')} --head {item.get('head')} "
                f"--title {shlex.quote(str(item.get('title') or ''))} --body-file {body_file}")
    return ("write it with gh, which routes through this host's broker: "
            f"gh pr comment {number} --repo {repo} --body-file {body_file}")


def no_login_refusal(item: dict, body: Path | None = None) -> str | None:
    """Why this host cannot make a write, and what makes it. None where this host has a login of its own.
    (gcp-agent-lane-2, 2026-11-21: three comments were believed queued for an hour, then all three had failed in
    the daemon with this reason -- upstream_refuse_posts. The caller hears it at accept time instead.)"""
    if upstream_command() is None:
        return None
    return (f"this host reads GitHub through its upstream ({UPSTREAM_CONFIG}) and has no login to post with; "
            f"nothing was queued. {broker_post_next(item, body)}")


def broker_post_unsent(item: dict, chosen: tuple[str, dict] | None) -> int:
    """Say that this write was not sent, where its body is, and what sends it. Exit 3: nothing was queued."""
    path = unsent_dir() / f"{item['id']}.md"
    with contextlib.suppress(OSError):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(item["body"])
    lacks = "the lane-gh broker has no tool for this write" if chosen is not None else "no lane-gh runs here"
    why = no_login_refusal(item, path) or "this host has no login to post with"
    print(f"glaeda-gh: not queued: {why} ({lacks}; its body is kept at {path})", file=sys.stderr)
    return 3


def broker_post(item: dict) -> int:
    """Make a queued write through the lane-gh broker and say what it did. Exit 0 written, 1 the broker said no or
    gave no answer, 3 not sent at all (its body and the command that sends it are named)."""
    chosen = broker_post_args(item)
    if chosen is None:
        return broker_post_unsent(item, None)
    if not os.access(LANE_GH_CMD, os.X_OK):
        return broker_post_unsent(item, chosen)
    tool, call_args = chosen
    argv = [LANE_GH_CMD, "call", tool, item["repo"], json.dumps(call_args)]
    try:
        done = run_bounded(argv, timeout=BROKER_POST_DEADLINE)
    except subprocess.TimeoutExpired:
        print(f"glaeda-gh: the lane-gh broker gave no answer in {BROKER_POST_DEADLINE:g}s; the write may still have "
              f"been made, so read {item['repo']} before sending it again", file=sys.stderr)
        return 1
    except (OSError, subprocess.SubprocessError) as error:
        print(f"glaeda-gh: lane-gh did not run ({type(error).__name__}: {error})", file=sys.stderr)
        return 1
    answer: Any = None
    with contextlib.suppress(ValueError):
        answer = json.loads(done.stdout)
    if not isinstance(answer, dict) or not answer.get("ok"):
        said = (answer.get("error") if isinstance(answer, dict) else None) or ""
        if not said:
            lines = [x.strip() for x in (done.stderr or "").splitlines() if x.strip()]
            said = lines[-1] if lines else "no answer"
        print(f"glaeda-gh: the lane-gh broker did not make this {item['kind']}: {str(said)[:300]}", file=sys.stderr)
        return 1
    data = answer.get("data")
    where = None
    if isinstance(data, dict):
        where = data.get("url") or data.get("html_url") or data.get("number")
    print(f"{item['kind']} made through the lane-gh broker (this host holds no token)"
          + (f": {where}" if where else ""))
    return 0


def cmd_post(args: argparse.Namespace) -> int:
    item = post_item(args)
    try:
        why = body_guard_refusal(item)
    except Exception as error:  # noqa: BLE001 - a guard that can't judge the text: nothing is posted unread
        why = f"the body guard failed ({type(error).__name__}: {error})"
    if why:
        print(f"glaeda-gh: not queued: {why}", file=sys.stderr)
        return 3
    if upstream_command() is not None:
        return broker_post(item)  # this host has no login: the broker writes, or says what does (broker_post)
    with contextlib.suppress(Exception):
        gh_cache_note_write(str(item.get("repo") or "").lower() or None, time.time(), gh_cache_post_scopes(item))
    write_json(outbox_dir() / f"{item['id']}.json", item)
    if not daemon_running(DOWN_GRACE):
        print(f"glaeda-gh: queued as {item['id']}; it is posted once the daemon runs. " + DOWN, file=sys.stderr)
        return 3
    return cmd_post_status(item["id"], args.wait, args.json, queued=True)


def cmd_post_status(post_id: str | None, wait: float, as_json: bool, queued: bool = False) -> int:
    """One write's state (waiting up to `wait` seconds for it to finish), or the queue and the recent writes.
    Exit 0 posted (or queued, without --wait), 1 failed, 2 still queued when --wait ran out."""
    if post_id is None:
        rows = [post_state(p.stem) for p in sorted(outbox_dir().glob("*.json"))
                if POST_ID.fullmatch(p.stem)] if outbox_dir().is_dir() else []
        recent = sorted(posted_dir().glob("*.json"))[-10:] if posted_dir().is_dir() else []
        rows = [r for r in rows + [read_json(p) for p in recent] if isinstance(r, dict) and r.get("id")]
        if as_json:
            print(json.dumps(rows, indent=2, sort_keys=True))
        else:
            for r in rows:
                print(f"{r['id']}  {r.get('kind', '?'):7} {r.get('repo')}  {post_line(r)}")
        return 0
    deadline = time.monotonic() + wait
    state = post_state(post_id)
    if state is None:
        raise WatchError(f"no queued or recent write {post_id}")
    while state["state"] == "queued" and time.monotonic() < deadline:
        time.sleep(WAIT_FILE_POLL)  # a local file read, no GitHub request
        state = post_state(post_id) or state
    if as_json:
        print(json.dumps(state, indent=2, sort_keys=True))
    elif state["state"] == "posted":
        # stdout is the URL alone (`url=$(glaeda-gh post comment ...)`, then `wait comment --since "$url"`); a note
        # (joined with other queued comments, an edit in place, an open PR found) goes to stderr
        print(state.get("url") or "posted")
        if state.get("note"):
            print(f"glaeda-gh: {state['note']}", file=sys.stderr)
    elif state["state"] == "superseded":
        print(f"glaeda-gh: {post_line(state)}", file=sys.stderr)  # stdout stays a URL or nothing
    else:
        print(post_line(state))
    if state["state"] == "queued" and queued and wait <= 0:
        print(f"glaeda-gh: the daemon posts it and keeps the result: glaeda-gh post status {post_id}", file=sys.stderr)
    return 0 if state["state"] in {"posted", "superseded"} else 1 if state["state"] == "failed" else 2 if wait > 0 else 0


# ---------------------------------------------------------------- log job: a finished job's log, read once per host
#
# cmux's CI classifiers (scripts/ci/glaeda_log.py, cmux#41273) ask `glaeda-gh log job OWNER/REPO ID` for a failed
# job's log first and read GET .../actions/jobs/ID/logs over REST only when it exits non-zero. The REST quota is one
# shared 5000/h, out most of every hour, and the same failed job's log is read again by every classifier, replay and
# property check that looks at it. A finished job's log never changes, so it is read once: from this cache (gzip,
# under BASE/logs, least recently read out first past JOB_LOG_MAX_BYTES, no other expiry), else from the build
# controller, which reads it with its own App token (cmuxterm-hq#7930, /v1/github/job-log: no user quota), else with
# one REST read. Only a finished job's log is kept: the controller serves only those, and a REST answer is kept only
# when it ends with the runner's last line (JOB_LOG_DONE). Anything this cannot answer exits non-zero with nothing on
# stdout, so the caller reads GitHub itself. Each step is bounded so the whole stays inside the caller's 30 s
# (LOG_CONTROLLER_TIMEOUT + LOG_REST_TIMEOUT).

JOB_LOG_DIR = "logs"
# 512 MiB of compressed logs: a failed cmux job's log is 0.1-5 MB of text and gzip keeps about a tenth of it, so this
# holds a few thousand failed jobs, more than a busy week of them.
JOB_LOG_MAX_BYTES = 512 * 1024 * 1024
JOB_LOG_RAW_MAX = 64 * 1024 * 1024  # a larger log is printed, not kept
JOB_LOG_TMP_KEEP = 3600.0  # a writer's temporary file this old was left by a crash: eviction removes it
# The runner's "Complete job" step ends every finished job's log with this line; a job still running has not written
# it, and neither has one whose runner died. Without it a REST answer is printed but not kept.
JOB_LOG_DONE = b"Cleaning up orphan processes"
LOG_CONTROLLER_TIMEOUT = 8  # the controller's job-log read (it may read GitHub itself first)
LOG_REST_TIMEOUT = 18  # one `gh api .../logs` read (a redirect to blob storage, which gh follows)


def job_log_path(repo: str, job: int) -> Path:
    owner, name = repo.lower().split("/", 1)
    return BASE / JOB_LOG_DIR / owner / name / f"{int(job)}.log.gz"


def job_log_get(repo: str, job: int) -> bytes | None:
    """JOB's kept log, or None. A hit is marked used (its mtime) so eviction drops the least recently read first."""
    path = job_log_path(repo, job)
    try:
        with open(path, "rb") as f:
            text = gzip.decompress(f.read())
    except (OSError, EOFError, ValueError, zlib.error):
        return None  # missing, or damaged: a miss, and the next read replaces it
    with contextlib.suppress(OSError):
        os.utime(path)
    return text


def job_log_put(repo: str, job: int, text: bytes) -> None:
    """Keep JOB's log, replaced whole (a reader sees the old file, none, or all of it), then evict past the cap."""
    if len(text) > JOB_LOG_RAW_MAX:
        return
    path = job_log_path(repo, job)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{time.monotonic_ns()}.tmp")
    try:
        with open(tmp, "wb") as f:
            f.write(gzip.compress(text, compresslevel=6, mtime=0))
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise
    job_logs_evict()


def job_logs_evict(max_bytes: int | None = None, now: float | None = None) -> dict:
    """Remove the least recently read logs until the rest fit in max_bytes, and temporary files a crash left.
    {"removed", "bytes"}. A reader that has a log open keeps reading it."""
    return kept_evict(BASE / JOB_LOG_DIR, ".log.gz", JOB_LOG_MAX_BYTES if max_bytes is None else max_bytes, now)


def kept_evict(root: Path, suffix: str, max_bytes: int, now: float | None = None) -> dict:
    """Under ROOT/OWNER/REPO: remove the least recently read SUFFIX files until the rest fit in max_bytes, and
    temporary files a crash left (older than JOB_LOG_TMP_KEEP). {"removed", "bytes"}. The job-log cache and the kept
    completed-attempt job lists (attempt_jobs_put) share it."""
    now = time.time() if now is None else now
    kept: list[tuple[float, int, Path]] = []
    removed = 0
    with contextlib.suppress(OSError):
        for owner in root.iterdir():
            for repo in (owner.iterdir() if owner.is_dir() else ()):
                for p in (repo.iterdir() if repo.is_dir() else ()):
                    try:
                        st = p.stat()
                    except OSError:
                        continue
                    if p.name.endswith(suffix) and not p.name.startswith("."):
                        kept.append((st.st_mtime, st.st_size, p))
                    elif p.name.endswith(".tmp") and now - st.st_mtime > JOB_LOG_TMP_KEEP:
                        with contextlib.suppress(OSError):
                            p.unlink()
    total = sum(size for _, size, _ in kept)
    for _, size, p in sorted(kept, key=lambda k: k[0]):
        if total <= max_bytes:
            break
        with contextlib.suppress(OSError):
            p.unlink()
            total -= size
            removed += 1
    return {"removed": removed, "bytes": total}


def controller_job_log(ctl: "Controller", repo: str, job: int) -> tuple[int, bytes]:
    """(HTTP status, body) of the controller's GET /v1/github/job-log: 200 is a finished job's log; 0 when it did not
    answer. 404 (unknown job, or an older controller), 409 (still running), 410 (GitHub expired it) and 429 (its log
    reads are spent) carry no log."""
    headers = {"Authorization": f"Bearer {ctl.token}"} if ctl.token else {}
    url = f"{ctl.base}/v1/github/job-log?repo={urllib.parse.quote(repo, safe='/')}&id={int(job)}"
    try:
        with hard_deadline(LOG_CONTROLLER_TIMEOUT + 1), \
                OPENER.open(urllib.request.Request(url, headers=headers), timeout=LOG_CONTROLLER_TIMEOUT) as response:
            return response.status, response.read(JOB_LOG_RAW_MAX + 1)
    except urllib.error.HTTPError as error:
        return error.code, b""
    except (OSError, HTTPException, ValueError):  # DeadlineTimeout is an OSError
        return 0, b""


def rest_job_log(repo: str, job: int) -> tuple[bool, bytes, str]:
    """One `gh api repos/REPO/actions/jobs/JOB/logs` through the PATH gh (so the quota guard and a lane's broker see
    it; gh follows the redirect to blob storage, which no quota counts): (ok, log bytes, why not)."""
    gh = find_gh()
    if gh is None:
        return False, b"", "gh not found"
    route = f"repos/{repo}/actions/jobs/{int(job)}/logs"
    for flags in (["--allow-escape-sequences"], []):  # newer gh strips a log's colour codes without it; older lacks it
        try:
            done = subprocess.run([gh, "api", *flags, route], stdin=subprocess.DEVNULL, capture_output=True,
                                  timeout=LOG_REST_TIMEOUT, check=False)
        except (OSError, subprocess.TimeoutExpired) as error:
            return False, b"", f"gh api: {type(error).__name__}"
        if done.returncode == 0:
            return True, done.stdout, ""
        err = done.stderr.decode(errors="replace").strip()
        if not (flags and "unknown flag" in err):
            break
    return False, b"", (err or f"gh api exited {done.returncode}")[-300:]


def job_log_finished(text: bytes) -> bool:
    return JOB_LOG_DONE in text[-4096:]


def job_log_read(repo: str, job: int, controller: Any = "env", rest: Callable | None = rest_job_log
                 ) -> tuple[bytes | None, str, str]:
    """(log, source, why not) for JOB: kept here, else from the build controller, else one REST read. rest=None
    reads no REST: the commands that scan many jobs (log search, log flaky) never spend the user quota."""
    repo = repo.lower()
    text = job_log_get(repo, job)
    if text is not None:
        return text, "cache", ""
    ctl = Controller.from_env() if controller == "env" else controller
    status = 0
    if ctl is not None:
        status, body = controller_job_log(ctl, repo, job)
        if status == 200 and len(body) <= JOB_LOG_RAW_MAX:
            with contextlib.suppress(OSError):
                job_log_put(repo, job, body)  # the controller serves only a finished job's log
            return body, "controller", ""
    if status == 410:
        return None, "", "expired"
    if rest is None and status == 200:
        return None, "", "too large"
    if rest is None:
        return None, "", {0: "controller down", 409: "still running", 429: "controller log reads spent"}.get(
            status, "not kept by the controller")
    ok, body, why = rest(repo, job)
    if not ok:
        return None, "", why
    if job_log_finished(body):
        with contextlib.suppress(OSError):
            job_log_put(repo, job, body)
    return body, "rest", ""


def cmd_log_job(repo: str, job: int, controller: Any = "env", rest: Callable = rest_job_log) -> int:
    """Print JOB's log: kept here, else from the build controller, else one REST read. Exit 0 only with the log on
    stdout; anything else prints nothing there, so a caller reads GitHub itself."""
    if not re.fullmatch(rf"{NAME}/{NAME}", repo) or job <= 0:
        raise WatchError("log job takes OWNER/REPO and a job id (the number after /job/ in the job's URL)")
    repo = repo.lower()
    text, source, why = job_log_read(repo, job, controller, rest)
    if text is None:
        # A run id typed here can only be named, never served: this command's contract is one log on stdout.
        try:
            hint = run_id_hint(repo, job, *run_jobs_typed_as_a_job(repo, job, controller, "log job"))
        except (WatchError, OSError) as error:
            hint = f"; whether {job} is a run id went unchecked: {error}"
        if why == "expired":
            print(f"glaeda-gh: GitHub has no log for {repo} job {job} any more (expired){hint}", file=sys.stderr)
        else:
            print(f"glaeda-gh: no log for {repo} job {job}: {why}{hint}", file=sys.stderr)
        return EXIT_FAIL
    out = sys.stdout.buffer
    out.write(text)
    out.flush()
    if source != "cache" and full_output():
        print(f"glaeda-gh: {repo} job {job} read from the {source}", file=sys.stderr)
    return EXIT_OK


# `log search`, `log flaky` and `log errors`: what an agent asks of CI logs without fetching one whole. The jobs come
# from the build controller's timing history (every finished job of the repository, 8 days, no GitHub read) and the
# logs from job_log_read without REST (this host's kept copy, else the controller's, kept 72 h): a scan across
# hundreds of jobs spends no user quota, and a log neither holds is reported unread, never fetched.
LOG_SCAN_PAGE = 2000  # timing records per controller read (a record's step list keeps a page well under MAX_BODY)
LOG_SCAN_PAGES = 200  # at most this many reads: 400,000 jobs, over a week of cmux
LOG_SCAN_KEEP = 60000  # the newest records a scan keeps: only the newest have logs (72 h), and this bounds memory
LOG_KEPT_S = 72 * 3600  # how long the controller keeps a read log (ghevents.JobLogRetention)
LOG_RECORD_FIELDS = ("at", "id", "job", "run", "attempt", "conclusion", "workflow", "seg")
LOG_SCAN_READS = 40  # default cap on logs read from the controller per command (kept copies are free)
# `log errors` given a run id, unlike the scans, reads through to REST on the person's own quota, so its cap is
# small: a run of a wide matrix has dozens of failed jobs and nobody asked for all of them. The rest are named.
LOG_ERRORS_RUN_READS = 5
RUN_HINT_JOBS = 5  # how many of a run's jobs a refusal or note offers as commands; the rest are counted


def reads_cap(word: str) -> int:
    """A `--reads` value: how many logs this command may read, 0 for none. A negative one is no cap at all --
    it silently became 1 here and read nothing in `log search` -- so it is refused rather than guessed."""
    try:
        count = int(word)
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid int value: {word!r}") from None
    if count < 0:
        raise argparse.ArgumentTypeError(f"{word}: a read cap is 0 (read none) or more, never negative")
    return count
LOG_LINE_MAX = 300  # a printed log line is cut here
LOG_FAILED = frozenset({"failure", "timed_out"})
LOG_STAMP = re.compile(r"^\ufeff?\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d+)?Z ?")
LOG_ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
# A failing test's name, by runner: cargo test, nextest, XCTest, swift-testing, pytest, unittest, go, jest/vitest.
LOG_TEST_FAILS = (
    re.compile(r"^test (\S+) \.\.\. FAILED$"),
    re.compile(r"^\s*(?:FAIL|TIMEOUT|SIGSEGV|SIGABRT) \[\s*[\d.]+s\]\s+(?:\(\d+/\d+\)\s+)?(\S+(?: \S+)?)\s*$"),
    re.compile(r"Test Case '(?:-\[(\S+ \S+)\]|([\w.]+))' failed"),  # macOS `-[Class test]`, Linux `Class.test`
    re.compile(r"✘ Test (\"[^\"]+\"|[\w.]+(?:\([^)]*\))?) (?:failed|recorded an issue)"),
    re.compile(r"^FAILED (\S+::\S+)"),
    re.compile(r"^(?:FAIL|ERROR): (\w+ \([\w.]+\))"),
    re.compile(r"^\s*--- FAIL: (\S+)"),
    # jest's ✕; vitest's × only with its duration, as diagnostics (miette, biome, turbo) print `× message` too
    re.compile(r"^\s*(?:✕ (.+?)(?: \(\d+(?:\.\d+)? ?m?s\))?|× (.+?) \d+(?:\.\d+)? ?m?s)$"),
)
LOG_ERROR = re.compile(r"##\[error\]|^error(?:\[E\d+\])?:|: (?:fatal )?error:|^fatal( error)?:|panicked at|"
                       r"^Traceback \(most recent call last\)|^\w*(?:Error|Exception): |^Error: |\bFAILED\b|"
                       r"^FAIL[: ]|--- FAIL|✘|✕|npm ERR!|\berror TS\d+:|^E {3}")
LOG_ERROR_FOLLOW = re.compile(r"^\s*--> \S+:\d+")  # rustc's location line under an error


def log_line(raw: bytes | str) -> str:
    text = raw.decode("utf-8", errors="replace") if isinstance(raw, bytes) else raw
    return LOG_ANSI.sub("", LOG_STAMP.sub("", text.rstrip("\r\n")))


def log_lines(text: bytes) -> list[str]:
    return [log_line(raw) for raw in text.splitlines()]


def log_failed_tests(text: bytes) -> list[str]:
    """The failing tests a log names, each once, in order."""
    seen: dict[str, None] = {}
    for line in log_lines(text):
        for pattern in LOG_TEST_FAILS:
            match = pattern.search(line)
            if match:
                name = next(g for g in match.groups() if g is not None).strip().strip('"')
                unit = re.fullmatch(r"(\w+) \(([\w.]+)\)", name)  # unittest: `test_x (__main__.Case.test_x)`
                if unit:
                    qual = unit.group(2).removeprefix("__main__.")
                    name = qual if qual.endswith("." + unit.group(1)) else f"{qual}.{unit.group(1)}"
                seen.setdefault(name, None)
                break
    return list(seen)


def log_errors(text: bytes, limit: int = 40) -> dict:
    """The error-level lines of one log, under the step (`##[group]`) that printed them, each once:
    {"steps": [{"step", "lines"}], "total", "shown"}. A step that failed with no recognised error line gets its
    last lines before the exit, so every red step says something."""
    steps: list[dict] = []
    step, tail, seen = "(setup)", [], set()
    current: dict | None = None
    total = shown = 0
    follow = False

    def add(line: str) -> None:
        nonlocal current, total, shown
        line = line[:LOG_LINE_MAX]
        if line in seen:
            return
        seen.add(line)
        total += 1
        if shown >= limit:
            return
        if current is None or current["step"] != step:
            current = {"step": step, "lines": []}
            steps.append(current)
        current["lines"].append(line)
        shown += 1

    for line in log_lines(text):
        if line.startswith("##[group]"):
            step, tail, follow = line[len("##[group]"):].strip()[:120] or "(step)", [], False
            continue
        if line.startswith("##[endgroup]"):
            continue
        if follow and LOG_ERROR_FOLLOW.match(line):
            add(line.rstrip())
            follow = False
            continue
        follow = False
        if LOG_ERROR.search(line):
            if "Process completed with exit code" in line and (current is None or current["step"] != step):
                for before in tail[-5:]:
                    add(before)
            add(line.replace("##[error]", "", 1).strip())
            follow = line.lstrip().startswith("error")
        elif line.strip():
            tail = (tail + [line.rstrip()])[-5:]
    return {"steps": steps, "total": total, "shown": shown}


def log_records(ctl: "Controller", repo: str, since: float, pages: int = LOG_SCAN_PAGES) -> tuple[list[dict], bool]:
    """(finished job records of REPO since SINCE, oldest first, each cut to LOG_RECORD_FIELDS; whether older ones were
    dropped). The controller answers oldest first, so the scan pages to the end and keeps the newest LOG_SCAN_KEEP:
    only the newest jobs still have logs. Past PAGES reads the history is cut at its newest end too, and said."""
    out: dict[int, dict] = {}
    cursor, cut = int(since), False
    for _ in range(pages):
        doc = ctl.get(f"/v1/github/timing/records?repo={urllib.parse.quote(repo, safe='/')}&since={cursor}"
                      f"&limit={LOG_SCAN_PAGE}", timeout=30)
        recs = [r for r in doc.get("records") or [] if isinstance(r, dict)]
        for r in recs:
            if r.get("job") and r.get("id"):
                out[int(r["id"])] = {k: r.get(k) for k in LOG_RECORD_FIELDS}
        if len(out) > 2 * LOG_SCAN_KEEP:  # drop the oldest as it goes, so memory stays bounded
            out = dict(sorted(out.items(), key=lambda kv: kv[1].get("at") or "")[-LOG_SCAN_KEEP:])
            cut = True
        last = max((iso_epoch(r.get("at")) or 0 for r in recs), default=0)
        if not doc.get("more") or not recs:
            break
        cursor = int(last) if int(last) > cursor else cursor + 1  # a page all in one second moves on a second
    else:
        cut = True
    kept = sorted(out.values(), key=lambda r: r.get("at") or "")
    return kept[-LOG_SCAN_KEEP:], cut or len(kept) > LOG_SCAN_KEEP


def log_regex(text: str | None, what: str, flags: int = 0) -> re.Pattern | None:
    if not text:
        return None
    try:
        return re.compile(text, flags)
    except re.error as error:
        raise WatchError(f"{what} is not a regular expression: {error}") from None


def log_since(text: str) -> float:
    match = re.fullmatch(r"(\d+)([mhd])", text.strip())
    if not match:
        raise WatchError(f"--since takes a duration such as 90m, 24h or 3d, not {text!r}")
    return time.time() - int(match.group(1)) * {"m": 60, "h": 3600, "d": 86400}[match.group(2)]


def log_job_url(repo: str, r: dict) -> str:
    return f"https://github.com/{repo}/actions/runs/{r.get('run') or 0}/job/{r['id']}"


def log_pick(recs: list[dict], job: str | None, workflow: str | None, seg: str | None,
             conclusion: str) -> list[dict]:
    """The records a scan reads, newest first."""
    job_re = log_regex(job, "--job", re.I)
    wf_re = log_regex(workflow, "--workflow", re.I)
    picked = []
    for r in reversed(recs):
        if job_re and not job_re.search(r.get("job") or ""):
            continue
        if wf_re and not wf_re.search(r.get("workflow") or ""):
            continue
        if seg and r.get("seg") != seg:
            continue
        if conclusion == "failed" and (r.get("conclusion") or "") not in LOG_FAILED:
            continue
        if conclusion not in ("failed", "any") and r.get("conclusion") != conclusion:
            continue
        picked.append(r)
    return picked


class LogScan:
    """Read logs for a scan: kept copies free, at most `reads` from the controller, none over REST; tally the rest."""

    def __init__(self, repo: str, reads: int, controller: Any):
        self.repo, self.reads, self.controller = repo, reads, controller
        self.read = self.down = 0
        self.stopped = "over --reads"  # why a log past the cap was not read
        self.unread: dict[str, int] = {}

    def text(self, job: int) -> bytes | None:
        kept = job_log_get(self.repo, job)
        if kept is not None:
            return kept
        if self.read >= self.reads:
            self.unread[self.stopped] = self.unread.get(self.stopped, 0) + 1
            return None
        self.read += 1
        text, _, why = job_log_read(self.repo, job, self.controller, rest=None)
        self.down = self.down + 1 if why == "controller down" else 0
        if text is None:
            self.unread[why] = self.unread.get(why, 0) + 1
            if why == "controller log reads spent" or self.down >= 3:
                self.reads = self.read  # no use asking again (one slow read is the controller reading GitHub)
                self.stopped = why
        return text

    def note(self) -> str:
        return ", ".join(f"{n} {why}" for why, n in sorted(self.unread.items(), key=lambda kv: -kv[1]))


def log_scan_setup(repo: str, since: str, controller: Any,
                   what: str = "log search") -> tuple[str, Any, list[dict], bool]:
    """The repo, controller, job history and whether that history was cut short. WHAT is the command the caller
    typed: a refusal names the failing operation, and this one named `log search` inside a `log errors` failure."""
    if not re.fullmatch(rf"{NAME}/{NAME}", repo):
        raise WatchError("a log scan (search, flaky, a run id given to errors) takes OWNER/REPO first")
    ctl = Controller.from_env() if controller == "env" else controller
    if ctl is None:
        raise WatchError(f"no build controller configured (CMUX_CI_CONTROLLER): {what} reads its job history")
    # Older jobs' logs are gone from the controller (72 h) and every history page re-reads a day file there: a scan
    # never asks for history it could not read the logs of.
    recs, more = log_records(ctl, repo.lower(), max(log_since(since), time.time() - LOG_KEPT_S))
    return repo.lower(), ctl, recs, more


def cmd_log_search(repo: str, pattern: str, since: str = "24h", job: str | None = None, workflow: str | None = None,
                   seg: str | None = None, conclusion: str = "failed", reads: int = LOG_SCAN_READS,
                   limit: int = 20, as_json: bool = False, controller: Any = "env") -> int:
    """Which recent jobs printed PATTERN: newest first, the first matching lines of each. Exit 0 with a match, 1
    with none (the scan note says how many logs it could not read)."""
    try:
        regex = re.compile(pattern)
    except re.error as error:
        raise WatchError(f"PATTERN is not a regular expression: {error}") from None
    repo, ctl, recs, more = log_scan_setup(repo, since, controller)
    picked = log_pick(recs, job, workflow, seg, conclusion)
    scan = LogScan(repo, reads, ctl)
    matches, scanned = [], 0
    for r in picked:
        if len(matches) >= limit:
            break
        text = scan.text(int(r["id"]))
        if text is None:
            continue
        scanned += 1
        hits = [line[:LOG_LINE_MAX] for line in log_lines(text) if regex.search(line)]
        if hits:
            matches.append({"at": r.get("at"), "workflow": r.get("workflow"), "job": r.get("job"),
                            "seg": r.get("seg"), "conclusion": r.get("conclusion"), "run": r.get("run"),
                            "id": r["id"], "attempt": r.get("attempt"), "url": log_job_url(repo, r),
                            "count": len(hits), "lines": hits[:3]})
    out = {"repo": repo, "pattern": pattern, "jobs": len(picked), "scanned": scanned, "unread": scan.unread,
           "history_cut": more, "matches": matches}
    if as_json:
        print(json.dumps(out, sort_keys=True))
    else:
        note = f"; unread: {scan.note()}" if scan.unread else ""
        note += "; history cut to the newest jobs" if more else ""
        print(f"{len(matches)} of {scanned} logs read printed /{pattern}/ ({len(picked)} {conclusion} jobs in "
              f"--since {since}{note})")
        for m in matches:
            print(f"{(m['at'] or '')[:16]}Z {m['seg']} {m['workflow']} / {m['job']} ({m['conclusion']}, "
                  f"{m['count']} lines) {m['url']}")
            for line in m["lines"]:
                print(f"    {line}")
    return EXIT_OK if matches else EXIT_FAIL


def cmd_log_flaky(repo: str, test: str | None = None, since: str = "72h", job: str | None = None,
                  reads: int = LOG_SCAN_READS * 2, limit: int = 20, as_json: bool = False,
                  controller: Any = "env") -> int:
    """Failing tests by name across recent failed jobs, and which of them are flaky: a test is flaky when the job
    that failed on it passed when re-run (a later attempt of the same run). With TEST (a regex), only those tests.
    Exit 0 when a flaky test is listed, 1 when none."""
    test_re = log_regex(test, "TEST", re.I)
    job_re = log_regex(job, "--job", re.I)
    repo, ctl, recs, more = log_scan_setup(repo, since, controller, "log flaky")
    # (run, job name) -> the latest attempt that passed. A re-run is a later attempt of the same run: a matrix sibling
    # with the same name passing in the same attempt is not one, and a record without a run is never matched.
    passed_attempt: dict[tuple, int] = {}
    for r in recs:
        if r.get("conclusion") == "success" and r.get("run"):
            key = (r.get("run"), r.get("job"))
            passed_attempt[key] = max(passed_attempt.get(key, 0), int(r.get("attempt") or 1))
    failed = [r for r in reversed(recs) if (r.get("conclusion") or "") in LOG_FAILED
              and (not job_re or job_re.search(r.get("job") or ""))]
    scan = LogScan(repo, reads, ctl)
    tests: dict[str, dict] = {}
    jobs_rerun_green: dict[str, int] = {}
    scanned = 0
    for r in failed:
        rerun_green = bool(r.get("run")) and \
            passed_attempt.get((r.get("run"), r.get("job")), 0) > int(r.get("attempt") or 1)
        if rerun_green:
            jobs_rerun_green[r.get("job") or ""] = jobs_rerun_green.get(r.get("job") or "", 0) + 1
        text = scan.text(int(r["id"]))
        if text is None:
            continue
        scanned += 1
        for name in log_failed_tests(text):
            if test_re and not test_re.search(name):
                continue
            t = tests.setdefault(name, {"test": name, "fails": 0, "runs": set(), "rerun_green": 0, "jobs": set(),
                                        "last": None, "url": None})
            t["fails"] += 1
            t["runs"].add(r.get("run"))
            t["jobs"].add(r.get("job"))
            t["rerun_green"] += int(rerun_green)
            if t["last"] is None:
                t["last"], t["url"] = r.get("at"), log_job_url(repo, r)
    rows = []
    for t in tests.values():
        verdict = "flaky" if t["rerun_green"] else ("repeats" if len(t["runs"]) >= 3 else "once")
        rows.append({"test": t["test"], "verdict": verdict, "fails": t["fails"], "runs": len(t["runs"]),
                     "rerun_green": t["rerun_green"], "jobs": sorted(j for j in t["jobs"] if j),
                     "last": t["last"], "url": t["url"]})
    order = {"flaky": 0, "repeats": 1, "once": 2}
    rows.sort(key=lambda x: (order[x["verdict"]], -x["rerun_green"], -x["fails"], x["test"]))
    out = {"repo": repo, "test": test, "failed_jobs": len(failed), "scanned": scanned, "unread": scan.unread,
           "history_cut": more, "tests": rows[:limit],
           "jobs_rerun_green": dict(sorted(jobs_rerun_green.items(), key=lambda kv: -kv[1])[:limit])}
    flaky = any(x["verdict"] == "flaky" for x in rows)
    if as_json:
        print(json.dumps(out, sort_keys=True))
        return EXIT_OK if flaky else EXIT_FAIL
    note = f"; unread: {scan.note()}" if scan.unread else ""
    note += "; history cut to the newest jobs" if more else ""
    print(f"{len(rows)} failing tests in {scanned} of {len(failed)} failed jobs, --since {since}{note}")
    for x in rows[:limit]:
        print(f"{x['verdict']:7} {x['test']}: failed {x['fails']}x in {x['runs']} runs, {x['rerun_green']} passed on "
              f"re-run; {', '.join(x['jobs'][:2])}; last {(x['last'] or '')[:16]}Z {x['url']}")
    if jobs_rerun_green and not test_re:
        top = ", ".join(f"{name} ({n})" for name, n in list(out["jobs_rerun_green"].items())[:5])
        print(f"jobs that went green on re-run: {top}")
    return EXIT_OK if flaky else EXIT_FAIL


def run_jobs_typed_as_a_job(repo: str, number: int, controller: Any,
                            what: str = "log errors") -> tuple[list[dict] | None, bool]:
    """REPO's finished jobs of run NUMBER, newest first, or None when no run of REPO by that number finished inside
    the window the controller keeps logs for -- and whether the history read was cut short, which decides whether
    that None means "no such run" or "not looked at".

    A run id and a job id are both bare integers, so neither the caller nor argparse can tell one from the other:
    `log errors manaflow-ai/cmuxterm-hq 44950653493` (a run id, copied from the run's own page) answered "no log
    for job 44950653493", which reads as a job whose log has expired. The reader's next step was `status run` to
    get the job id, then the same command again -- two calls for a number they already had. The controller's own
    timing history says which jobs a run has, so the reading is settled here, for no GitHub read."""
    _, _, recs, cut = log_scan_setup(repo, "72h", controller, what)
    of_run = [r for r in recs if r.get("run") and int(r["run"]) == number]
    if not of_run:
        return None, cut
    return sorted(of_run, key=lambda r: r.get("at") or "", reverse=True), cut


def run_id_hint(repo: str, number: int, jobs: list[dict] | None, cut: bool = False) -> str:
    """What to say about NUMBER when it is no job of REPO: which failed jobs its run has, that it is no run either,
    or that the look for one was cut short. Named so both `log job` and `log errors` refuse the same way."""
    if jobs is None and cut:
        # The history scan dropped records to stay bounded, so this number may well be a run of REPO that simply
        # fell outside the slice kept. A read that was cut short is unknown, not a value.
        return (f"; whether {number} is a run of {repo} went unchecked: the controller's job history came back cut "
                f"short of the whole window, so a run outside the newest {LOG_SCAN_KEEP} jobs kept reads the same "
                f"as no run at all (`glaeda-gh status run {repo}/{number}` says what it is)")
    if jobs is None:
        return (f"; no run {number} of {repo} finished in the last 72 h either (a run of another repository, or one "
                f"too old to have logs: `glaeda-gh status run {repo}/{number}` says which)")
    failed = [r for r in jobs if (r.get("conclusion") or "") in LOG_FAILED]
    if not failed:
        return (f"; {number} is run {number} of {repo}, not a job, and none of its {len(jobs)} finished jobs failed "
                f"(`glaeda-gh status run {repo}/{number} --jobs`)")
    steps = " ".join(f"`glaeda-gh log errors {repo} {r['id']}`" for r in failed[:RUN_HINT_JOBS])
    return (f"; {number} is run {number} of {repo}, not a job: its failed job(s) are "
            f"{', '.join(str(r['id']) for r in failed)} -- {steps}")


def cmd_log_errors(repo: str, job: int, limit: int = 40, as_json: bool = False, controller: Any = "env",
                   rest: Callable = rest_job_log, reads: int = LOG_ERRORS_RUN_READS) -> int:
    """One job's error-level lines by step, not its whole log. A run id here reads the newest READS failed jobs of
    that run, because the two kinds of id are indistinguishable (run_jobs_typed_as_a_job). Exit 0 with a log read
    (a log with no error line prints a count of 0), 1 with none."""
    if not re.fullmatch(rf"{NAME}/{NAME}", repo) or job <= 0:
        raise WatchError("log errors takes OWNER/REPO and a job id (the number after /job/ in the job's URL)")
    repo = repo.lower()
    text, source, why = job_log_read(repo, job, controller, rest)
    if text is not None:
        return log_errors_emit(repo, [(job, text, source)], limit, as_json, None)
    try:
        jobs, cut = run_jobs_typed_as_a_job(repo, job, controller, "log errors")
    except (WatchError, OSError) as error:
        print(f"glaeda-gh: no log for {repo} job {job}: {why}; whether {job} is a run id went unchecked: {error}",
              file=sys.stderr)
        return EXIT_FAIL
    failed = [r for r in (jobs or []) if (r.get("conclusion") or "") in LOG_FAILED]
    if not failed:
        print(f"glaeda-gh: no log for {repo} job {job}: {why}{run_id_hint(repo, job, jobs, cut)}", file=sys.stderr)
        return EXIT_FAIL
    # Bounded, newest first: unlike the sibling scans this path can fall through to REST on the person's own
    # quota, so a run of a wide matrix (60 failed jobs measured) must not read every one of them unasked. The
    # jobs past the cap are named as their own commands, which is a next step the reader can take.
    # The cap is the cap that ran: `--reads 0` reads nothing and lists the run's failed jobs, rather than
    # reading one while the note says "past --reads 0". A negative one is refused in the parser.
    take, over = (failed[:reads], failed[reads:]) if reads > 0 else ([], failed)
    say_waiting(f"glaeda-gh: {job} is run {job} of {repo}, not a job: reading "
                f"{'its' if not over else f'the newest {len(take)} of its'} {len(failed)} failed job(s)")
    read, unread = [], []
    for r in take:
        one, src, reason = job_log_read(repo, int(r["id"]), controller, rest)
        if one is None:
            unread.append({"job": int(r["id"]), "why": reason})
        else:
            read.append((int(r["id"]), one, src))
    if over:
        # Bounded like `run_id_hint`'s own offer: a next step has to be readable to be a next step (95
        # commands, 3001 characters measured on a 100-failed-job run).
        named = over[:RUN_HINT_JOBS]
        steps = " ".join(f"`glaeda-gh log errors {repo} {r['id']}`" for r in named)
        rest_of = f" ({len(over) - len(named)} more in `glaeda-gh status run {repo}/{job} --jobs`)" \
            if len(over) > len(named) else ""
        say_waiting(f"glaeda-gh: {len(over)} more failed job(s) past --reads {reads}, "
                    f"unread: {steps}{rest_of}")
    if unread:
        say_waiting("glaeda-gh: no log for "
                    + ", ".join(f"{u['job']} ({u['why']})" for u in unread))
    if not read:
        return EXIT_FAIL
    return log_errors_emit(repo, read, limit, as_json, job,
                           {"failed": len(failed), "past_reads": [int(r["id"]) for r in over or []],
                            "unread": unread})


def log_errors_emit(repo: str, logs: list[tuple[int, bytes, str]], limit: int, as_json: bool,
                    run: int | None, bounds: dict | None = None) -> int:
    """Print the error lines of each (job, log, source). One job keeps the shape it always printed; a run prints
    one block per job, and `--json` carries them under `run` and `jobs`, so a one-job reader never has to branch.

    BOUNDS is what the run's read left out: the true number of failed jobs, the ids the `--reads` cap did not
    reach, and the ones whose log was nowhere. They belong in the document and not only on stderr, or a
    `--json` reader takes a bounded read for the whole answer -- the mistake this command exists to stop."""
    found = [{"job": job, "source": source, **log_errors(text, limit)} for job, text, source in logs]
    if as_json:
        one = ({"repo": repo, **found[0]} if run is None
               else {"repo": repo, "run": run, "jobs": found, **(bounds or {})})
        print(json.dumps(one, sort_keys=True))
        return EXIT_OK
    for f in found:
        more = f", {f['total'] - f['shown']} more past --max" if f["total"] > f["shown"] else ""
        print(f"{repo} job {f['job']}: {f['total']} error lines in {len(f['steps'])} steps{more}")
        for s in f["steps"]:
            print(f"[{s['step']}]")
            for line in s["lines"]:
                print(f"  {line}")
    return EXIT_OK


class Parser(argparse.ArgumentParser):
    """`argparse`'s parser, with a bad argument exiting 64 instead of 2.

    2 is this tool's "timed out", and a caller that branches on exit codes -- which is the whole
    point of `wait` -- read a refused `--timeout -5` as a wait that had run its course. 64 is what
    every other bad argument here already exits with (`WatchError` in `main`).

    Both lines go through `say_waiting`, for its reason: with stderr closed, `print(file=None)`
    writes to **stdout**, so a usage error became the first lines of a `--json` document."""

    argv: list[str] = []  # main() sets the raw arguments, for `next:` and --json

    def error(self, message: str) -> None:  # type: ignore[override]
        hint, one_target = wait_extra_targets(message)
        elsewhere, without = flag_elsewhere(message)
        nxt = one_target or without or usage_next(Parser.argv, self.prog)
        say_waiting(self.format_usage().rstrip("\n"))
        spellings = kind_spellings(message) or hint or elsewhere
        say_waiting(f"{self.prog}: error: {message}" + (f" ({spellings})" if spellings else ""))
        say_waiting(f"next: {nxt}")
        if "--json" in Parser.argv:
            print_json_error("usage", message + (f" ({spellings})" if spellings else ""), nxt)
        raise SystemExit(64)

    def _get_value(self, action, arg_string):  # type: ignore[override]
        """Every choice argument here (`--until`, `--event`, `--state`, a kind) takes a synonym or a typo of
        one choice as that choice, and says on stderr which it ran. Leo, 2026-11-20: "Like we need a bunch of
        synonyms for code for you guys where it just goes \"eh close enough\" and works" -- `wait --until
        checks-done` ended two background merge jobs at once. A value as close to two choices is refused."""
        value = super()._get_value(action, arg_string)
        choices = action.choices
        if (not isinstance(value, str) or not isinstance(choices, (tuple, list))
                or not all(isinstance(c, str) for c in choices) or value in choices):
            return value
        meant, near = close_choice(value, choices)
        if meant:
            name = action.option_strings[0] if action.option_strings else (action.metavar or action.dest)
            say_waiting(f"glaeda-gh: {name} `{value}` ran as `{meant}` (choices: {', '.join(choices)})")
            return meant
        if len(near) > 1:
            shown = ", ".join(map(repr, choices))
            raise argparse.ArgumentError(action, f"invalid choice: {value!r} (choose from {shown}; "
                                                 f"as close to {' as to '.join(near)}: say which)")
        return value  # argparse's own refusal follows, with the choices


# What agents type for a choice, by the choice it means. One table for every choice argument: a word here is
# used only where its choice is one of the argument's choices (`merge` is `--until merged` and `--state merged`).
CHOICE_SYNONYMS = {
    "done": ("checks-done", "checks", "complete", "completed", "finished", "finish", "all-done", "settled",
             "terminal", "ended", "end", "over", "checks-finished", "checks-complete", "ci-done"),
    "green": ("pass", "passed", "passing", "passes", "success", "succeeded", "successful", "ok", "okay",
              "all-green", "checks-green", "checks-pass", "checks-passed", "ci-green", "good"),
    "required": ("req", "required-checks", "requires", "require", "must", "needed", "mandatory",
                 "required-green"),
    "merged": ("merge", "landed", "land", "merges"),
    "request-changes": ("request_changes", "changes", "changes-requested", "reject", "rejected", "block"),
    "approve": ("approved", "approval", "lgtm", "accept"),
    "all": ("any", "every", "both"),
    "closed": ("close", "shut"),
    "open": ("opened", "active"),
    "prs": ("pr", "pulls", "pull-requests", "pull"),
    "issues": ("issue",),
    # Not "issue-comment" or "pr-comment": `comment` is matched by the start of a word too, so an `issue` -- a
    # write post does not queue at all -- would silently run as a comment on an issue. Both spellings route
    # through POST_ELSEWHERE instead, which names the call and runs nothing.
    "comment": ("reply", "note"),
}
CHOICE_WORD = re.compile(r"[A-Za-z][\w-]*")


def typo_distance(a: str, b: str) -> int:
    """Edits between two words, a swap of two neighbours counting one (optimal string alignment)."""
    prev2: list[int] = []
    prev = list(range(len(b) + 1))
    for i in range(1, len(a) + 1):
        cur = [i] + [0] * len(b)
        for j in range(1, len(b) + 1):
            cost = a[i - 1] != b[j - 1]
            cur[j] = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                cur[j] = min(cur[j], prev2[j - 2] + 1)
        prev2, prev = prev, cur
    return prev[len(b)]


def close_choice(value: str, choices) -> tuple[str, list[str]]:
    """(the one choice VALUE means, "") or ("", the choices it is equally close to). In order: the choice in
    another case or with `_` for `-`; a synonym; the start of one word (3 letters at least); one typo (two in a
    word of 6 letters or more) away from a choice or a synonym. A value as near to two choices means neither."""
    word = value.strip().lower().replace("_", "-")
    if not CHOICE_WORD.fullmatch(word):
        return "", []  # a target (o/r#5, pr:o/r#5) in a choice's place is another mistake: argparse names it
    spellings = [(c.lower(), c) for c in choices]
    spellings += [(s, c) for c in choices for s in CHOICE_SYNONYMS.get(c, ())]
    for test in (lambda s: s == word,
                 lambda s: len(word) >= 3 and s.startswith(word)):
        hit = sorted({c for s, c in spellings if test(s)}, key=list(choices).index)
        if len(hit) == 1:
            return hit[0], []
        if hit:
            return "", hit
    allowed = 1 if len(word) <= 5 else 2
    best: dict[str, int] = {}
    for s, c in spellings:
        d = typo_distance(word, s)
        if d <= allowed:
            best[c] = min(d, best.get(c, d))
    if not best:
        return "", []
    least = min(best.values())
    near = [c for c in choices if best.get(c) == least]
    return (near[0], []) if len(near) == 1 else ("", near)


KIND_CHOICE = re.compile(r"argument kind: invalid choice: '([^']*)'")
EXTRA_ARGS = re.compile(r"unrecognized arguments: (.+)$")
TARGET_WORD = re.compile(r"[/#]")  # every repository target carries OWNER/REPO or #N


def wait_extra_targets(message: str) -> tuple[str, str]:
    """What a `wait` given more than one target is told, and the single-target form to run: (hint, next).

    `status` reads several targets in one gather and `wait` waits for one, and argparse's own line for the
    second target ("unrecognized arguments: o/r#2326") names neither fact, so a lane that wrote
    `wait pr A B` read a usage error with no form in it -- and a *background* wait that exits 64 at once
    looks like a wait that waited for nothing (glaeda#2323). ("", "") when this is some other usage error."""
    found = EXTRA_ARGS.search(message)
    if not found or Parser.argv[:1] != ["wait"]:
        return "", ""
    extra = [w for w in found.group(1).replace(",", " ").split() if TARGET_WORD.search(w)]
    if not extra or len(extra) != len(found.group(1).replace(",", " ").split()):
        return "", ""  # an unrecognized flag, or a word that is no target: the usual usage error
    kind = Parser.argv[1] if len(Parser.argv) > 1 and not Parser.argv[1].startswith("-") else "KIND"
    kept = [w for w in Parser.argv if w not in extra]  # the call the lane meant, minus the targets past the first
    form = ["glaeda-gh"] + kept + ([] if "--timeout" in kept else ["--timeout", "1800"])
    first = Parser.argv[2] if len(Parser.argv) > 2 and TARGET_WORD.search(Parser.argv[2]) else ""
    both = ([first] if first else []) + extra
    hint = (f"`wait` waits for one target, so {', '.join(extra)} "
            f"{'is' if len(extra) == 1 else 'are'} beyond it: wait for one target per call, or read them all "
            f"in one gather with `glaeda-gh status {kind} {typed_line(both)}`")
    return hint, typed_line(form)


def kind_spellings(message: str) -> str:
    """What a refused *kind* is told about the spellings of a target, so the reader is not left to work out
    that a separator was the problem. argparse's own line ("invalid choice: 'pr:o/r/7241'") lists the kinds
    and nothing else, which reads as "pr is not a kind" when the kind was there all along."""
    bad = KIND_CHOICE.search(message)
    if not bad or ": say which)" in message:  # a plain word as close to two kinds (close_choice): no target shape
        return ""
    if post_elsewhere(bad.group(1)):
        return ""  # a write made elsewhere: the `next:` line names its call, and no target shape is the problem
    split = split_kind_prefix(bad.group(1))
    if split:  # a kind this *command* does not take (`status file:/x`); the ones it takes already ran
        return f"a {split[0]} target is {KIND_FORMS.get(split[0], 'named by its own form')}"
    return ("the kind comes first and the whole target is one word: `pr OWNER/REPO#N`, `run OWNER/REPO/RUN_ID`, "
            "`pr:OWNER/REPO#N` as this tool prints it, or `OWNER/REPO#N` with no kind at all")


def print_json_error(code: str, reason: str, nxt: str) -> None:
    """The one --json object a refused call prints (agent output contract)."""
    with contextlib.suppress(OSError, ValueError):
        sys.stdout.write(json.dumps({"ok": False, "code": code, "reason": reason, "next": nxt}) + "\n")
        sys.stdout.flush()


# GitHub writes `post` does not queue, by the word an agent types for them. The daemon's outbox carries the three
# writes every session makes in bulk (comment, pr, review), and its pacing is what makes them safe to make in bulk;
# an issue or a label is made once, so it goes straight through the quota shim. argparse's own refusal lists the
# kinds and stops there, which reads as "this tool cannot do it" for a write it does do one call away. Measured
# 2026-11-22: `post issue` was refused with a hint about target *shapes*, and the gh call had to be worked out by
# hand. Leo, 2026-11-20: "we need a bunch of synonyms for code for you guys where it just goes \"eh close enough\"
# and works".
POST_ELSEWHERE = {
    ("issue", "issues", "new-issue", "newissue", "bug", "file-issue"):
        "glaeda-gh gh issue create --repo OWNER/REPO --title T --body-file F",
    ("issue-comment", "issuecomment", "pr-comment", "prcomment"):
        "glaeda-gh post comment OWNER/REPO#N --body-file F (one kind for both: a PR is an issue here)",
    ("label", "labels", "add-label", "tag"):
        "glaeda-gh gh issue edit N --repo OWNER/REPO --add-label L (a PR takes it too: a PR is an issue here)",
    ("close", "closed", "close-issue"):
        "glaeda-gh gh issue close N --repo OWNER/REPO",
    ("merge", "land"):
        "glaeda-gh land OWNER/REPO#N --match-head-commit SHA (the daemon merges it pinned, on green)",
}


def post_elsewhere(kind: str) -> str:
    """The call that makes a GitHub write `post` does not queue, for the word typed in the kind's place."""
    word = kind.strip().lower().replace("_", "-")
    for words, hand in POST_ELSEWHERE.items():
        if word in words:
            return f"post queues comment, pr and review; this one is made in one call: {hand}"
    return ""


def usage_next(argv: list[str], prog: str = "glaeda-gh") -> str:
    """The right form of a mistyped call: `wait pr OWNER/REPO N` is `wait pr OWNER/REPO#N`; else the --help."""
    words = list(argv)
    if len(words) >= 4 and words[0] in ("wait", "status") and words[1] in ("pr", "comment") \
            and re.fullmatch(rf"{NAME}/{NAME}", words[2]) and BARE_NUMBER.fullmatch(words[3]):
        fixed = [words[0], words[1], f"{words[2]}#{words[3].lstrip('#')}"] + words[4:]
        if words[0] == "wait" and "--timeout" not in fixed:
            fixed += ["--timeout", "1800"]
        return typed_line(["glaeda-gh"] + fixed)
    # `wait pr A B`: two targets in one call, which `status pr` takes and `wait` does not. A wait is one key
    # by construction (one request file, one FIFO, one exit code -- 0/1/2/4 is *the* target's verdict, which
    # every caller branches on), so this names the two calls that do the job rather than inventing an
    # all-green-or-any-red rule nobody asked for. Measured 2026-11-21: the refusal was argparse's bare
    # "unrecognized arguments: o/r#2", which names neither the limit nor the way round it.
    if len(words) >= 4 and words[0] == "wait" and words[1] in STATUS_KINDS:
        targets: list[str] = []
        for word in words[2:]:
            if word.startswith("-"):
                break
            targets.append(word)
        if len(targets) >= 2 and all(target_readable(words[1], w) for w in targets):
            rest = words[2 + len(targets):]
            one = typed_line(["glaeda-gh", "wait", words[1], targets[0], *rest])
            return (f"wait takes one target, because its exit code is that target's verdict: "
                    f"`glaeda-gh status {words[1]} {typed_line(targets)}` reads them all in one gather, "
                    f"or run one wait each (`{one}`)")
    # prog is "glaeda-gh post" when the post parser itself refuses the kind, and "glaeda-gh" when the top-level
    # one does: the word typed, not the prog, says which command was meant.
    if len(words) >= 2 and words[0] == "post" and prog in ("glaeda-gh", "glaeda-gh post"):
        hand = post_elsewhere(words[1])
        if hand:
            return hand
    if prog == "glaeda-gh" and words[:1] and words[0] in ("status", "wait", "checks", "post", "budget", "audit",
                                                          "runners", "restart", "serve", "log", "land"):
        return f"glaeda-gh {words[0]} --help"
    return f"{prog} --help"


ON_EVENT_SHOW = 50  # records `on-event` prints, newest first


def on_event_when(epoch: float) -> str:
    return dt.datetime.fromtimestamp(epoch, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_on_event_status(as_json: bool) -> int:
    hooks, problems = on_event_hooks()
    state = on_event_state()
    newest = sorted(state["runs"], key=lambda k: float(state["runs"][k].get("at") or 0), reverse=True)[:ON_EVENT_SHOW]
    doc = {"config": os.fspath(ON_EVENT_CONFIG), "hooks": hooks, "problems": problems,
           "runs": {k: state["runs"][k] for k in newest}, "pending": state["pending"]}
    if as_json:
        print(json.dumps(doc, sort_keys=True))
        return EXIT_OK
    print(f"config {doc['config']}: {len(hooks)} hook(s)" + (f", {len(problems)} refused" if problems else ""))
    for h in hooks:
        what = f"job {h['job']}" if h.get("job") else "the run"
        print(f"  {h['name']}: {h['repo']} {h['workflow']} on {h['branch']}, {what} {h['conclusion']}")
    for p in problems:
        print(f"  refused: {p}")
    for k, p in sorted(state["pending"].items()):
        print(f"pending {k} since {on_event_when(float(p.get('since') or 0))}")
    for k in newest:
        r = state["runs"][k]
        end = f" exit {r['exit']}" if "exit" in r else ""
        print(f"{on_event_when(float(r.get('at') or 0))} {k} {r.get('outcome')}{end} {r.get('sha') or ''}".rstrip())
    return EXIT_OK


def on_event_run_record(doc: dict) -> dict:
    """A run as the controller's feed shows it, from that shape or GitHub's REST one."""
    repo = doc.get("repo") or (doc.get("repository") or {}).get("full_name")
    url = doc.get("html_url") or doc.get("url")
    return {"id": doc.get("id"), "repo": repo, "name": doc.get("name"), "path": doc.get("path"),
            "head_sha": doc.get("head_sha"), "head_branch": doc.get("head_branch"),
            "attempt": doc.get("attempt") or doc.get("run_attempt") or 1, "status": doc.get("status"),
            "conclusion": doc.get("conclusion"), "url": url}


def cmd_on_event_replay(run_file: Path, jobs_file: Path | None, wait: float, as_json: bool) -> int:
    """Feed one finished run through the daemon's on-event path: matched, deduped and run as a feed delivery would
    be. A run already recorded prints its record and runs nothing."""
    doc = read_json(run_file)
    if not isinstance(doc, dict) or not isinstance(doc.get("id"), int):
        raise WatchError(f"{run_file}: not a run (a JSON object with an id)")
    run = on_event_run_record(doc)
    if run["status"] != "completed":
        raise WatchError(f"run {run['id']} is {run['status']}, not completed")
    hooks, problems = on_event_hooks()
    matched = [h for h in hooks if on_event_matches(h, run)]
    if not matched:
        raise WatchError("no on-event hook matches that run" + (f" ({'; '.join(problems)})" if problems else ""))
    keys = [on_event_key(h["name"], h["repo"], run["id"], run["attempt"]) for h in matched]
    given = None
    if jobs_file is not None:
        jd = read_json(jobs_file)
        jobs = jd.get("jobs") if isinstance(jd, dict) else jd
        if not isinstance(jobs, list):
            raise WatchError(f"{jobs_file}: not a job list")
        given = {k: jobs for k in keys}
    with contextlib.redirect_stdout(sys.stderr):  # the daemon's log lines; stdout is the answer
        daemon = Daemon()
        daemon.now = time.time()
        daemon.on_event_tick([{"runs": [run]}], given=given, rest_now=True)
        deadline = time.monotonic() + wait
        for proc in list(daemon.on_event_procs.values()):
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.wait(timeout=max(0.0, deadline - time.monotonic()))
        daemon.on_event_reap()
    state = on_event_state()
    out = [{"key": k, **(state["runs"].get(k) or ({"outcome": "pending"} if k in state["pending"] else {}))}
           for k in keys]
    if as_json:
        print(json.dumps(out[0] if len(out) == 1 else out, sort_keys=True))
    else:
        for o in out:
            end = f" exit {o['exit']}" if "exit" in o else ""
            print(f"{o['key']}: {o.get('outcome')}{end}" + (f" (log {o['log']})" if o.get("log") else ""))
    return EXIT_OK


REPO_ONLY_RE = re.compile(rf"({NAME})/({NAME})")


def join_repo_and_number(raw: list[str]) -> list[str] | None:
    """`wait run OWNER/REPO RUN_ID`, `wait pr OWNER/REPO N` (also status, `land OWNER/REPO N` and `post
    comment|review OWNER/REPO N`): the repository and the number as two words, joined into the one target the command
    takes (coordinator, 2026-11-21: `glaeda-gh wait run manaflow-ai/cmuxterm-hq 44884634507` failed "unrecognized
    arguments"; measured 2026-11-22, `glaeda-gh comment manaflow-ai/cmuxterm-hq 15832 --body-file -` was routed to
    `post comment` by nesting_synonym and then failed "unrecognized arguments: 15832", while `land` and `status pr`
    took that exact pair). None when the words are not that shape."""
    cmd, rest = raw[0], raw[1:]
    kind = ""
    if cmd != "land":
        # `post pr OWNER/REPO` names a repository with no number, and `post status` an id: neither joins.
        kinds = ("comment", "review") if cmd == "post" else ("pr", "run")
        if len(rest) < 3 or rest[0] not in kinds:
            return None
        kind, rest = rest[0], rest[1:]
    if len(rest) < 2 or not REPO_ONLY_RE.fullmatch(rest[0]) or not re.fullmatch(r"#?\d+", rest[1]):
        return None
    number = rest[1].lstrip("#")
    target = f"{rest[0]}/{number}" if kind == "run" else f"{rest[0]}#{number}"
    return [cmd] + ([kind] if kind else []) + [target] + rest[2:]


def infer_kind(raw: list[str]) -> tuple[list[str], str]:
    """`wait|status|land` called without the kind run as the call meant (fewer-tool-calls).

    Agents write `wait OWNER/REPO#N --until done` and argparse refused it (11 tool results in 24 h on 2026-11-21). A first word that is not a kind but is a pull-request target (OWNER/REPO#N,
    .../pull/N) means `pr`; OWNER/REPO/RUNID or .../actions/runs/ID means `run`. `land pr X` drops the `pr`. Returns the argv to parse and the note for stderr ("" when unchanged)."""
    if len(raw) < 2 or raw[0] not in ("wait", "status", "land", "post"):
        return raw, ""
    if raw[0] == "post":
        # A post call infers only its target's shape: `post comment o/r 5` is `o/r#5`, the pair `status pr` and
        # `land` already take. The kind stays argparse's own choice list (and nesting_synonym's), because which
        # kind a write is cannot be guessed from a target.
        joined = join_repo_and_number(raw)
        if joined:
            return joined, f"glaeda-gh: ran as `{typed_line(['glaeda-gh'] + joined)}`"
        return raw, ""
    wait_joined = False
    if raw[0] == "wait":
        # `wait [pr|comment] OWNER/REPO N` is `OWNER/REPO#N` (usage_next's form): one target, so a bare N can
        # mean nothing else. `status` is multi-target (a bare N there is a number in the repo before it), and
        # `wait run` keeps its own form.
        slot = 2 if raw[1] in ("pr", "comment") else 1
        if len(raw) > slot + 1 and re.fullmatch(rf"{NAME}/{NAME}", raw[slot]) and BARE_NUMBER.fullmatch(raw[slot + 1]):
            raw = raw[:slot] + [f"{raw[slot]}#{raw[slot + 1].lstrip('#')}"] + raw[slot + 2:]
            wait_joined = True
    cmd, first = raw[0], raw[1]
    joined = join_repo_and_number(raw)
    if joined:
        return joined, f"glaeda-gh: ran as `{typed_line(['glaeda-gh'] + joined)}`"
    if cmd == "land":
        if first in ("pr", "PR") and len(raw) >= 3 and PR_RE.fullmatch(raw[2].strip()):
            return [cmd] + raw[2:], f"glaeda-gh: ran as `{typed_line(['glaeda-gh', cmd] + raw[2:])}`"
        return raw, ""
    ran_as = f"glaeda-gh: ran as `{typed_line(['glaeda-gh'] + raw)}`" if wait_joined else ""
    if first.startswith("-") or first in WAIT_KINDS:
        return raw, ran_as
    # `wait pr:o/r#5` -- this tool's own notation for a target, copied out of a line it printed -- is
    # `wait pr o/r#5`: the prefix carries the kind, so the kind slot is where it goes.
    prefixed = split_kind_prefix(first)
    if prefixed and prefixed[0] in (WAIT_KINDS if cmd == "wait" else STATUS_KINDS):
        kind, rest = prefixed
        fixed = [cmd, kind, rest] + raw[2:]
        return fixed, f"glaeda-gh: ran as `{typed_line(['glaeda-gh'] + fixed)}`"
    kind = "pr" if PR_RE.fullmatch(first.strip()) else "run" if RUN_RE.fullmatch(first.strip()) else ""
    if not kind:
        return raw, ran_as
    fixed = [cmd, kind] + raw[1:]
    return fixed, f"glaeda-gh: ran as `{typed_line(['glaeda-gh'] + fixed)}`"


class ShorthandFlag(argparse.Action):
    """A flag agents type for a canonical form (`--merged` for `--until merged`, `--job ID` for the JOB_ID
    argument): run it as that form, and say the canonical form on stderr once, so the next call uses it."""

    def __init__(self, option_strings, dest, canonical: str = "", **kw):
        self.canonical = canonical
        super().__init__(option_strings, dest, **kw)

    def __call__(self, parser, namespace, values, option_string=None):
        value = self.const if self.nargs == 0 else values
        setattr(namespace, self.dest, value)
        say_waiting(f"glaeda-gh: {option_string} ran as {self.canonical.format(value, prog=parser.prog)}")


class OptionalJobId(argparse.Action):
    """JOB_ID when `--job ID` may stand for it: an absent JOB_ID leaves what `--job` set, whichever came first."""

    def __call__(self, parser, namespace, values, option_string=None):
        if values is not None:
            setattr(namespace, self.dest, values)


def parser() -> argparse.ArgumentParser:
    p = Parser(prog="glaeda-gh", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True, parser_class=Parser)
    sv = sub.add_parser("serve", help="run the daemon (the only process that polls GitHub); launchd or systemd runs it")
    sv.add_argument("--foreground-ok", action="store_true",
                    help="start even though the LaunchAgent or systemd unit is loaded (debugging only)")
    for name in ("status", "wait"):
        s = sub.add_parser(name)
        s.add_argument("kind", choices=WAIT_KINDS if name == "wait" else STATUS_KINDS)
        if name == "status":
            s.add_argument("target", nargs="+",
                           help="OWNER/REPO#N, OWNER/REPO/N, pr:OWNER/REPO#N as this tool prints it, or a GitHub URL; "
                                "several are read in one gather, "
                                "and a bare #N or N is that number in the repository of the target before it, "
                                "or of the directory you are in")
            s.add_argument("--field", metavar="F,G",
                           help="print just these values of the --json object, tab-separated, one line per target "
                                "(dotted paths; head and checks.state|failed|pending|passed|held for a PR); "
                                "lists print comma-joined")
        else:
            s.add_argument("target", help="OWNER/REPO#N, OWNER/REPO/RUN_ID, a GitHub URL, or the KIND:TARGET "
                                                 "form this tool prints (pr:OWNER/REPO#N, run:OWNER/REPO/RUN_ID), "
                                                 "with or without the kind before it")
        s.add_argument("--jobs", action="store_true", help="runs: also track the job list")
        s.add_argument("--json", action="store_true")
        s.add_argument("--verbose", action="store_true",
                       help="list up to 10 superseded attempts and up to 20 failed checks (as AGENT_VERBOSE=1); "
                            "by default the summary counts the superseded ones and lists 10 failures")
        if name == "wait":
            until = s.add_mutually_exclusive_group()
            until.add_argument("--until", choices=("green", "done", "required", "merged"), default="green",
                           help="PRs: green (every check passes; fail fast), done (every check finished), "
                                "required (only the checks GitHub requires decide; fail fast) or merged; "
                                "all but merged exit 4 once the PR conflicts with its base. A synonym or a typo "
                                "of one (checks-done, passed, merge) runs as it, said on stderr")
            for word in ("green", "done", "required", "merged"):
                until.add_argument(f"--{word}", dest="until", action=ShorthandFlag, nargs=0, const=word,
                                   canonical="`--until {}`", help=f"the same as --until {word}")
            s.add_argument("--timeout", type=seconds, default=3600,
                           help="seconds with no change in what it waits on (default 3600): every change it sees "
                                "(a check or job started or finished, a comment, a file growing, CPU used) moves "
                                "the deadline; exit 2 once nothing changed for this long, or at --max. `wait "
                                "until` alone counts it from the start")
            s.add_argument("--max", type=seconds, default=None, metavar="S",
                           help=f"the hard ceiling from the start, however much it changes (default "
                                f"{WAIT_MAX_TIMES}x --timeout); --json's ended_by says which ended it")
            s.add_argument("--sha", "--head", dest="sha", metavar="SHA",
                           help="the commit you pushed (git rev-parse HEAD): other heads count as pending; "
                                "--head is the same flag")
            s.add_argument("--rescue-grace", type=float, default=RESCUE_GRACE, metavar="S",
                           help=f"hold a failure caused only by a glaeda runner refusing a job at setup this long "
                                f"for a rescue re-run (default {RESCUE_GRACE}; 0 rules on each attempt)")
            s.add_argument("--settle", type=float, default=SETTLE_GRACE, metavar="S",
                           help=f"PRs: a head with no check or status is not started for this long after its "
                                f"push, then exits {EXIT_NOTHING} (nothing reported; default {SETTLE_GRACE})")
            s.add_argument("--author", help="comments: only this author (github-actions[bot] or github-actions)")
            s.add_argument("--match", help="comments: a regular expression the body must contain")
            s.add_argument("--since", help="comments: after this comment id or URL, ISO time, or duration "
                                           "(10m); default the moment the wait began")
            s.add_argument("--exists", action="store_true", help="file: ready once it exists, even when empty")
            s.add_argument("--gone", action="store_true", help="file: ready once it does not exist")
            s.add_argument("--contains", help="file: ready once its text matches this regular expression")
    c = sub.add_parser("checks", help="every check of one or more commits, read once by the daemon for all sessions "
                                      "within each consumer's budget")
    c.add_argument("repo", help="OWNER/REPO")
    c.add_argument("shas", nargs="+", metavar="SHA", help="full 40-hex commit ids")
    c.add_argument("--consumer", required=True, help="who is asking (autoland, a session's name): the unit of the "
                   "hourly head-read budget")
    c.add_argument("--max-age", type=float, default=HEAD_PENDING_TTL * 2, metavar="S",
                   help=f"checks still running are served from the cache if read this recently (default {HEAD_PENDING_TTL * 2}s); "
                        "finished heads are good for 12 minutes")
    c.add_argument("--wait", type=float, default=30, metavar="S",
                   help="seconds to wait for the daemon's read (default 30; 0 serves the cache as it is)")
    c.add_argument("--pr", type=int, metavar="N",
                   help="the PR whose head this is: a head with no entry is served from that PR's cached rollup "
                        "when it is of this head and all green (route pr-rollup)")
    c.add_argument("--json", action="store_true")
    po = sub.add_parser("post", help="queue a comment, PR or review; the daemon posts it, paced for every session")
    po.add_argument("kind", choices=("comment", "pr", "review", "status"))
    po.add_argument("target", nargs="?", help="comment, review: OWNER/REPO#N or a URL; pr: OWNER/REPO; status: an id")
    po.add_argument("--body", help="the text (prefer --body-file: backticks and dollar signs stay data)")
    po.add_argument("--body-file", metavar="PATH", help="the text from a file, - for stdin")
    po.add_argument("--title", help="pr: the title")
    po.add_argument("--head", help="pr: the branch (OWNER:BRANCH from a fork)")
    po.add_argument("--base", help="pr: the branch to merge into")
    po.add_argument("--reviewer", action="append", metavar="LOGIN", help="pr: request a review (repeatable)")
    po.add_argument("--event", choices=("comment", "approve", "request-changes"), default="comment",
                    help="review: the verdict (default comment)")
    po.add_argument("--wait", type=float, default=0, metavar="S",
                    help="seconds to wait for the URL (default 0: queue and return; the write survives the session)")
    po.add_argument("--status-key", metavar="KEY",
                    help="comment: this is your status KEY on the thread; your next comment with the same KEY edits "
                         "this one in place while it is still the thread's last comment and nobody waits on it")
    po.add_argument("--gate", action="store_true",
                    help="comment or review: a receipt a merge waits on (a verdict, a check, a land receipt); it goes "
                         "out ahead of every other queued write (review receipts are recognized without it)")
    po.add_argument("--json", action="store_true")
    lg = sub.add_parser("log", help="a finished job's log, read once per host (cache, build controller, then REST)")
    lgs = lg.add_subparsers(dest="kind", required=True, parser_class=Parser)
    lj = lgs.add_parser("job", help="print one job's log (exit 0 only with the log on stdout; a run id here is "
                                     "named, never served, with the command for each failed job of that run)")
    lj.add_argument("repo", metavar="OWNER/REPO")
    le = lgs.add_parser("errors", help="one job's error-level lines, grouped by step, not the whole log (a run id "
                                       "reads the newest --reads failed jobs of that run)")
    le.add_argument("repo", metavar="OWNER/REPO")
    for one in (lj, le):
        job = one.add_mutually_exclusive_group(required=True)
        job.add_argument("job", type=int, nargs="?", action=OptionalJobId, metavar="JOB_ID|RUN_ID")
        job.add_argument("--job", dest="job", type=int, action=ShorthandFlag, metavar="ID",
                         canonical="`{prog} OWNER/REPO {}`", help="the same as JOB_ID|RUN_ID")
    le.add_argument("--max", type=int, default=40, metavar="N", help="lines shown per job (default 40)")
    le.add_argument("--reads", type=reads_cap, default=LOG_ERRORS_RUN_READS, metavar="N",
                    help="given a run id, how many of its failed jobs to read, newest first (default "
                         "%(default)s; the rest are named with their own commands)")
    le.add_argument("--json", action="store_true")
    for kind, text in (("search", "which recent jobs printed PATTERN (controller job history; logs kept here or "
                                  "on the controller, never REST)"),
                       ("flaky", "failing tests by name across recent failed jobs; flaky = the job passed on "
                                 "re-run")):
        ls = lgs.add_parser(kind, help=text)
        ls.add_argument("repo", metavar="OWNER/REPO")
        if kind == "search":
            ls.add_argument("pattern", metavar="PATTERN", help="a Python regular expression")
        else:
            ls.add_argument("test", nargs="?", default=None, metavar="TEST", help="only tests matching this regex")
        ls.add_argument("--since", default="24h" if kind == "search" else "72h",
                        help="how far back: 90m, 24h, 72h (default %(default)s; at most 72 h, as long as the controller keeps logs)")
        ls.add_argument("--job", default=None, metavar="REGEX", help="only jobs whose name matches")
        if kind == "search":
            ls.add_argument("--workflow", default=None, metavar="REGEX", help="only workflows whose name matches")
            ls.add_argument("--seg", choices=("pr", "main", "queue", "other"), default=None,
                            help="only jobs of this trigger")
            ls.add_argument("--conclusion", default="failed",
                            help="failed (default: failure or timed_out), any, or one conclusion (success)")
        ls.add_argument("--reads", type=reads_cap, default=LOG_SCAN_READS if kind == "search" else LOG_SCAN_READS * 2,
                        metavar="N", help="logs read from the controller at most (kept ones are free; default "
                                          "%(default)s)")
        ls.add_argument("--limit", type=int, default=20, metavar="N", help="rows shown (default 20)")
        ls.add_argument("--json", action="store_true")
    sub.add_parser("read", help="an upstream's end: register the keys of one JSON request on stdin and print "
                                "the cached entries (see upstream.json)")
    b = sub.add_parser("budget", help="who spent the shared login's quota this hour, per host and caller, and "
                                      "REST and GraphQL quota as this host's daemon last saw it")
    b.add_argument("--json", action="store_true")
    b.add_argument("--local", action="store_true", help="this host's daemon only: no read of the other hosts")
    a = sub.add_parser("audit", help="what this host's gh traffic is, and how much of it a cache would answer")
    a.add_argument("--log", type=Path, default=None, help="the call log to read (default the PATH guard's)")
    a.add_argument("--last", type=int, default=200000, metavar="N",
                   help="only the last N lines (default 200000; 0 reads all of it)")
    a.add_argument("--json", action="store_true")
    a.add_argument("--by", choices=("caller",), default=None,
                   help="group the calls by caller (session:NAME or tool:NAME, as the gh-quota shim names them)")
    sr = sub.add_parser("search", help="find pull requests and issues by query, over GraphQL search through this "
                                       "host's one cached route (instead of gh search, which spends REST quota)")
    sr.add_argument("kind", choices=tuple(SEARCH_KINDS), help="issues, prs, or both (a bare query); the word "
                                                              "`issue`, `pr` or `pulls` is read as its kind")
    sr.add_argument("words", nargs="*", metavar="QUERY",
                    help="GitHub search terms as you would type them to `gh search`, qualifiers included "
                         "(repo:OWNER/REPO, label:x, is:merged); a qualifier here wins over the flag for it")
    sr.add_argument("--repo", action="append", default=[], metavar="OWNER/REPO",
                    help="only this repository (repeatable: any of them)")
    sr.add_argument("--state", choices=tuple(SEARCH_STATES), default="all",
                    help="open, closed, merged (pull requests) or all (default all)")
    sr.add_argument("--author", metavar="LOGIN", help="only this author")
    sr.add_argument("--limit", type=int, default=20, metavar="N",
                    help=f"rows at most (default 20, at most {SEARCH_LIMIT_MAX}: GraphQL search's page)")
    sr.add_argument("--field", metavar="F,G",
                    help="print just these values of each row, tab-separated, one line per row (the `status pr` "
                         "names: target,head,state,checks.state,merged,url,title,number)")
    sr.add_argument("--json", action="store_true")
    rn = sub.add_parser("runners", help="busy and idle self-hosted runners per label, from one shared read")
    rn.add_argument("scope", metavar="OWNER[/REPO]")
    rn.add_argument("--label", default=None, help="only runners carrying this label")
    rn.add_argument("--json", action="store_true")
    oe = sub.add_parser("on-event", help="the commands the daemon runs once per finished run or job (on-event.json): "
                                         "status, or replay one run record through the same path")
    oe.add_argument("action", nargs="?", choices=("status", "replay"), default="status")
    oe.add_argument("--run-file", type=Path, metavar="PATH",
                    help="replay: one finished run, as the controller's feed (/v1/github/events) or GitHub serves it")
    oe.add_argument("--jobs-file", type=Path, metavar="PATH",
                    help="replay: its attempt's jobs ({\"jobs\": [...]}, run-jobs' or GitHub's), instead of reading them")
    oe.add_argument("--wait", type=float, default=0, metavar="S",
                    help="replay: wait up to S seconds for the command to end, to print its exit code")
    oe.add_argument("--json", action="store_true")
    ld = sub.add_parser("land", help="land a PR: the daemon takes each step land_judge names until it merges or stops "
                                     "(land status, land cancel)")
    ld.add_argument("words", nargs="+",
                    metavar="OWNER/REPO#N | status [OWNER/REPO#N] | cancel OWNER/REPO#N | serve")
    ld.add_argument("--after", action="append", default=[], metavar="OWNER/REPO#M",
                    help="land only after this PR merged (repeatable); it closing unmerged or its own land stopping "
                         "stops this one")
    ld.add_argument("--notify", nargs="?", const="", metavar="HOST/SESSION",
                    help="who is told on a merge or a stop (with no value, and by default, this "
                         "host/$ACPMUX_SESSION_NAME)")
    ld.add_argument("--sha", "--match-head-commit", dest="sha", metavar="SHA",
                    help="land only this head (7 to 40 hex): refused now if the PR's head is another, and the land "
                         "stops (head_moved) if a later push moves it; --match-head-commit (gh pr merge's own flag) is "
                         "the same")
    ld.add_argument("--override-reason", dest="override_reason", metavar="TEXT",
                    help="every merge try runs with LAND_JUDGE_OVERRIDE=TEXT (a lane VM's: the broker land's override); one "
                         "line, at most 200 characters; needs --override-receipt. Neither flag: the caller's own "
                         "LAND_JUDGE_OVERRIDE (and LAND_JUDGE_OVERRIDE_RECEIPT) is taken")
    ld.add_argument("--override-receipt", dest="override_receipt", metavar="TEXT",
                    help="LAND_JUDGE_OVERRIDE_RECEIPT=TEXT with it: the base run and job ids; one line, at most 240")
    ld.add_argument("--wait", "--timeout", dest="wait", type=seconds, default=0, metavar="S",
                    help="wait for it to merge or stop until its queue entry has not changed for S seconds (exit 0 "
                         "merged, 1 stopped, 2 still going); --timeout is the same")
    ld.add_argument("--max", dest="max_wait", type=seconds, default=None, metavar="S",
                    help=f"with --wait: the hard ceiling from the start (default {WAIT_MAX_TIMES}x --wait)")
    ld.add_argument("--json", action="store_true")
    r = sub.add_parser("restart", help="restart a down or hung daemon once, however many sessions ask at the same time")
    r.add_argument("--force", action="store_true", help="restart even if it looks healthy or was just restarted")
    return p


LOG_JOB_ONE_WORD = re.compile(r"(?:https://github\.com/)?([\w.-]+/[\w.-]+)/(?:actions/runs/\d+/job/)?(\d+)/?")


def log_job_synonym(raw: list[str]) -> list[str]:
    """`log OWNER/REPO --job ID` is `log job OWNER/REPO ID` (agents type it): say so on stderr and run that. So is
    `log job|errors OWNER/REPO/ID` or a job's URL in one word (the shape `status run` and a failed check print;
    2026-11-21 it cost a usage error)."""
    given = [w for w in raw[3:4] if w.isdigit()] + [w for w in raw[3:] if w.startswith("--job")]  # an id already
    one = LOG_JOB_ONE_WORD.fullmatch(raw[2]) if len(raw) >= 3 and raw[:2] in (["log", "job"], ["log", "errors"]) \
        and not given else None
    if one:
        fixed = raw[:2] + [one.group(1), one.group(2)] + raw[3:]
        print(f"glaeda-gh: read as `{typed_line(fixed)}` (the job id goes in its own word)", file=sys.stderr)
        return fixed
    if len(raw) < 3 or raw[0] != "log" or not re.fullmatch(r"[\w.-]+/[\w.-]+", raw[1]):
        return raw
    rest = raw[2:]
    for i, word in enumerate(rest):
        job = None
        if word == "--job" and i + 1 < len(rest):
            job, rest = rest[i + 1], rest[:i] + rest[i + 2:]
        elif word.startswith("--job="):
            job, rest = word[6:], rest[:i] + rest[i + 1:]
        if job is not None:
            if not job.isdigit():
                return raw
            fixed = ["log", "job", raw[1], job] + rest
            print(f"glaeda-gh: read as `{typed_line(fixed)}` (log OWNER/REPO --job ID is `log job OWNER/REPO ID`)",
                  file=sys.stderr)
            return fixed
    return raw


def search_synonym(raw: list[str]) -> list[str]:
    """The shapes an agent types for `search`, as the canonical form:

    - a bare query (`search "cmux next"`) is `search both "cmux next"`: no kind word is both kinds;
    - `gh search`'s own words (`issue`, `pr`, `pulls`, `pull-requests`) are their kind;
    - `gh search`'s `--json FIELD,FIELD` is this tool's `--field FIELD,FIELD` (here `--json` is the whole object).

    Said on stderr, as the other synonyms are, so the next call is typed the canonical way. A form with no
    canonical shape here (`search code|commits|repos`) is refused by name in main, not rewritten."""
    if not raw or raw[0] != "search" or "-h" in raw or "--help" in raw:
        return raw  # help prints the canonical form itself; no line about the words asking for it
    fixed, said = list(raw), []
    for i, word in enumerate(fixed):
        if word != "--json" or i + 1 >= len(fixed) or fixed[i + 1].startswith("-"):
            continue
        if re.fullmatch(r"[\w.]+(?:,[\w.]+)*", fixed[i + 1]):
            fixed[i:i + 2] = ["--field", fixed[i + 1]]
            said.append("--json FIELDS is --field FIELDS (--json alone is the whole object)")
        break
    word = fixed[1] if len(fixed) > 1 else ""
    kind = SEARCH_KIND_WORDS.get(word.lower())
    if kind and kind != word:
        fixed[1] = kind
        said.append(f"`{word}` is the kind `{kind}`")
    elif not kind and word not in SEARCH_UNSERVED and not word.startswith("-"):
        fixed.insert(1, "both")
        said.append("a query with no kind word searches both issues and pull requests")
    elif not kind and word.startswith("-"):
        fixed.insert(1, "both")
        said.append("a search with no kind word searches both issues and pull requests")
    if said:
        print(f"glaeda-gh: read as `{typed_line(['glaeda-gh'] + fixed)}` ({'; '.join(said)})", file=sys.stderr)
    return fixed


def land_notify_synonym(raw: list[str]) -> list[str]:
    """`land --notify OWNER/REPO#N` is `land OWNER/REPO#N --notify` (agents type the flag first, and a bare
    `--notify` means this session): say so on stderr and run that. 2026-11-21: a bare `--notify` cost an argparse
    usage error, and with one allowed, the flag before the target would swallow it."""
    if len(raw) < 3 or raw[0] != "land":
        return raw
    for i, word in enumerate(raw):
        if word != "--notify" or i + 1 >= len(raw):
            continue
        after = raw[i + 1]
        if not re.fullmatch(r"[\w.-]+/[\w.-]+#\d+", after):
            return raw
        if any(re.fullmatch(r"[\w.-]+/[\w.-]+#\d+", w) for w in raw[1:i]):
            return raw  # the target is already there: --notify names something else, odd as it looks
        fixed = raw[:i] + [after] + ["--notify"] + raw[i + 2:]
        print(f"glaeda-gh: read as `{typed_line(fixed)}` (--notify takes HOST/SESSION, not the PR; with no "
              f"value it names this session)", file=sys.stderr)
        return fixed
    return raw


# The words every command takes in its first command slot, read off the parser itself so this table cannot
# drift from the commands that exist. Two spellings of the same thing in argparse: `log` nests real
# subparsers (`log job`), while `status`, `wait`, `post` and `search` spell their one dispatch word as the
# `choices` of a first positional (`post comment`). Both are a word the caller must put *after* a command,
# and getting that nesting wrong is the mistake this routes.
_NESTING: tuple[frozenset[str], dict[str, list[str]]] | None = None


def first_slot_words(p: argparse.ArgumentParser) -> list[str]:
    """Every word P takes in its first command slot: a nested subparser's names, or the choices of its first
    positional. The first such slot only -- a later positional (`log search PATTERN`) is data, not a word."""
    for action in p._actions:  # noqa: SLF001  argparse has no public reader for this
        if isinstance(action, argparse._SubParsersAction):  # noqa: SLF001
            return [name for name in action.choices if isinstance(name, str)]
        if not action.option_strings and action.choices:
            return [c for c in action.choices if isinstance(c, str)]
    return []


def child_parser(parent: argparse.ArgumentParser, word: str) -> argparse.ArgumentParser:
    """The parser that owns the options of `PARENT WORD`: the nested subparser when there is one, else PARENT
    itself (a `choices` word is parsed by its own parent)."""
    for action in parent._actions:  # noqa: SLF001
        if isinstance(action, argparse._SubParsersAction) and word in action.choices:  # noqa: SLF001
            return action.choices[word]
    return parent


def nesting_table() -> tuple[frozenset[str], dict[str, list[str]]]:
    """(the top-level commands, each deeper word -> the commands that take it), walked off `parser()` once.
    Built lazily and kept: only a call whose first word is no command pays for it."""
    global _NESTING
    if _NESTING is None:
        top: dict[str, argparse.ArgumentParser] = {}
        for action in parser()._actions:  # noqa: SLF001
            if isinstance(action, argparse._SubParsersAction):  # noqa: SLF001
                top = {name: sub for name, sub in action.choices.items() if isinstance(name, str)}
                break
        table: dict[str, list[str]] = {}
        for name, sub in top.items():
            for word in first_slot_words(sub):
                table.setdefault(word, []).append(name)
        _NESTING = (frozenset(top), table)
    return _NESTING


def normalized_flag(word: str) -> str:
    """WORD as a spelling-insensitive key: lowercased with every `-` and `_` dropped, so `--body-file`,
    `--body_file` and `--bodyFile` are one key and `--body` stays a different one."""
    return word.lower().replace("-", "").replace("_", "")


def parser_options(p: argparse.ArgumentParser) -> dict[str, bool]:
    """P's long options -> whether each takes a value, for reading a flag's spelling and skipping its value."""
    out: dict[str, bool] = {}
    for action in p._actions:  # noqa: SLF001
        for option in action.option_strings:
            if option.startswith("--"):
                out[option] = action.nargs != 0
    return out


def flag_options(raw: list[str]) -> dict[str, bool]:
    """The long options the command in RAW accepts, the top-level ones included."""
    tops, _ = nesting_table()
    top = parser()
    options = parser_options(top)
    if not raw or raw[0] not in tops:
        return options
    node = child_parser(top, raw[0])
    options.update(parser_options(node))
    deeper = [w for w in raw[1:] if not w.startswith("-")]
    if deeper:
        nested = child_parser(node, deeper[0])
        if nested is not node:
            options.update(parser_options(nested))
    return options


def flag_commands(flag: str) -> list[str]:
    """Every command of this tool whose own options include FLAG, as the words a caller types: `land`,
    `log search`. The whole path, because a reader told "it is an option of `log`" would type
    `glaeda-gh log --max-age`, which is the next usage error. Spelling-insensitive, like the rest of the
    flag reading here, so `--maxAge` finds the command that has `--max-age`."""
    key = normalized_flag(flag.split("=", 1)[0])
    top = parser()
    tops, _ = nesting_table()
    out: list[str] = []
    for name in sorted(tops):
        node = child_parser(top, name)
        if key in {normalized_flag(o) for o in parser_options(node)}:
            out.append(name)
            continue
        for word in first_slot_words(node):
            nested = child_parser(node, word)
            if nested is not node and key in {normalized_flag(o) for o in parser_options(nested)}:
                out.append(f"{name} {word}")
    return out


def typed_command(words: list[str]) -> str:
    """The command path WORDS typed, spelled as `flag_commands` spells one: `log search` where that is a command
    of its own, `wait` where the next word is a choice of `wait`'s own positional rather than a nested parser."""
    if not words:
        return ""
    tops, _ = nesting_table()
    if words[0] not in tops:
        return words[0]
    node = child_parser(parser(), words[0])
    if len(words) > 1 and child_parser(node, words[1]) is not node:
        return f"{words[0]} {words[1]}"
    return words[0]


def flag_elsewhere(message: str, argv: list[str] | None = None) -> tuple[str, str]:
    """What a flag borrowed from a sibling command is told: (hint, next). ("", "") for any other usage error.

    The siblings of this mistake are all named or routed already -- a command word at the wrong nesting
    level, a flag in another case convention, a kind with a separator -- and this one was left to argparse's
    bare "unrecognized arguments: --notify". Measured 2026-11-21: `wait run o/r/ID --timeout 1500 --notify`
    said that and nothing more, so the reader learned neither that `wait` has no such flag (a wait blocks
    until the verdict; there is nothing to notify about) nor that `land --notify` is the one that does.

    Nothing is rewritten: which command the caller meant is theirs to say, so this names where the flag
    lives and offers the call they typed minus the flag that is no part of it."""
    words = list(Parser.argv if argv is None else argv)
    found = EXTRA_ARGS.search(message)
    if not found or not words or words[0].startswith("-"):
        return "", ""
    extra = found.group(1).replace(",", " ").split()
    if not extra or not all(w.startswith("--") and w != "--" for w in extra):
        return "", ""  # a stray target or value among them is another mistake: argparse's own line names it
    # Everything at or after the first `--` is a word the caller quoted as a positional (`log search o/r --
    # --notify` searches for the text `--notify`), never a flag of theirs: the sibling rewriter
    # flag_spelling_synonym stops at `--` for the same reason. A flag only named there is argparse's to
    # explain, and the ones named here are dropped from the call by count, not by equality, so a copy the
    # caller quoted survives into the next step.
    cut = words.index("--") if "--" in words else len(words)
    typed_words, quoted = words[:cut], words[cut:]
    extra = [w for w in extra if w in typed_words]
    if not extra:
        return "", ""
    # The command that just refused the flag is never named as the place to go: that is a next step which
    # cannot end the refusal. The whole path, not its first word: `log job --reads` is answered by `log
    # search`, a different command that happens to share a top-level word.
    typed = typed_command(typed_words)
    def name_of(flag: str) -> str:
        return flag.split("=", 1)[0]  # `--notify=x` is the option `--notify`, which is what lives elsewhere

    owners = {w: [c for c in flag_commands(name_of(w)) if c != typed] for w in dict.fromkeys(extra)}
    named = [w for w in owners if owners[w]]
    if not named:
        return "", ""  # no other command of this tool has it: argparse's refusal stands as it is
    left: dict[str, int] = {}
    for w in extra:
        left[w] = left.get(w, 0) + 1
    kept = []
    for w in typed_words:
        if left.get(w):
            left[w] -= 1
            continue
        kept.append(w)
    kept += quoted

    def lives(flag: str) -> str:
        where = owners[flag]
        return f"{' and '.join(f'`{c}`' for c in where)}'s (`glaeda-gh {where[0]} --help`)"

    if len(named) == 1:
        hint = f"`{name_of(named[0])}` is no option of `{typed}`: it is {lives(named[0])}"
    else:
        hint = (f"{', '.join(f'`{name_of(w)}`' for w in named)} are no options of `{typed}`: "
                + "; ".join(f"`{name_of(w)}` is {lives(w)}" for w in named))
    return hint, " ".join(["glaeda-gh"] + kept)


def nesting_synonym(raw: list[str]) -> tuple[list[str], list[str]]:
    """A command word typed at the wrong nesting level, routed to where it lives: (argv, refusal lines).

    `glaeda-gh comment o/r#1` named the right concept and missed only that it lives under `post`; measured
    2026-11-21 it cost argparse's "invalid choice: 'comment'" and a round trip to --help. A word that exactly
    one command takes is rewritten to that command's spelling, said on stderr like the other synonyms.

    A word more than one command takes is *refused*, never guessed: `comment`, `pr` and `run` are each a word
    of `status` (a read), `wait` (a read that blocks) and/or `post` (a write), and picking for the caller
    would pick between reading and writing. The refusal names every command that takes the word, each as a
    line that runs. The one narrowing done is the caller's own evidence: when the flags typed fit exactly one
    of those commands (`comment o/r#1 --body hi` has `--body`, which only `post` has), that is the one."""
    if not raw or raw[0].startswith("-") or raw[0] in ("gh", "coord-alert", "wait-resume"):
        return raw, []
    tops, table = nesting_table()
    word = raw[0]
    if word in tops or word not in table:
        return raw, []  # a real command, or no command's word at all: argparse rules on it as it always has
    parents = sorted(table[word])
    typed = {normalized_flag(w.split("=", 1)[0]) for w in raw[1:] if w.startswith("--") and w != "--"}
    if len(parents) > 1 and typed:
        fits = [p for p in parents
                if typed <= {normalized_flag(o) for o in flag_options([p, word])}]
        if len(fits) == 1:
            parents = fits
    if len(parents) > 1:
        refusal = [f"glaeda-gh: `{word}` is a word of {len(parents)} commands "
                   f"({', '.join(f'{p} {word}' for p in parents)}), not a command of its own, and which one "
                   f"you meant decides whether this reads or writes: it is not guessed"]
        refusal += [f"next: {typed_line(['glaeda-gh', p, word] + raw[1:])}" for p in parents]
        return raw, refusal
    fixed = [parents[0], word] + raw[1:]
    print(f"glaeda-gh: read as `{typed_line(['glaeda-gh'] + fixed)}` "
          f"(`{word}` is a word of `{parents[0]}`, not a command of its own)", file=sys.stderr)
    return fixed, []


def positional_capacity(p: argparse.ArgumentParser) -> float:
    """How many positional words P can hold: 1 per plain or optional positional, unbounded for one that
    takes a list or nests a subparser (everything after it is that command's). A call with more positional
    words than this cannot parse, which is what tells an extra word from data that merely looks like one."""
    total = 0.0
    for action in p._actions:  # noqa: SLF001  argparse has no public reader for this
        if action.option_strings:
            continue
        if isinstance(action, argparse._SubParsersAction) or action.nargs in ("*", "+", argparse.REMAINDER):  # noqa: SLF001
            return math.inf
        total += 1
    return total


def spelled_long_flag(word: str, options: dict[str, bool]) -> str | None:
    """WORD as one of OPTIONS' long flags, however this tool would come to read it: canonical, in another of
    its case conventions (`--statusKey` is `--status-key`, what `flag_spelling_synonym` makes of it), or an
    abbreviation (argparse's `allow_abbrev` is on, so `--contain` is `--contains` and `--time` is
    `--timeout`). None when it is no long flag of this command, or a spelling several of them answer to,
    which this tool and argparse both refuse themselves.

    Every reader of a flag's name goes through here, so a flag's value is read as its value in each
    spelling the call would be accepted in: a spelling only one reader knows made a call that parses look
    like a call with one positional word too many (re-review of #2381)."""
    if not word.startswith("--") or word in ("--", "---"):
        return None
    if word in options:
        return word
    key = normalized_flag(word)
    spellings = [option for option in options if normalized_flag(option) == key]
    if spellings:
        return spellings[0] if len(spellings) == 1 else None
    hits = [option for option in options if option.startswith(word)]
    return hits[0] if len(hits) == 1 else None


def positional_words(raw: list[str]) -> list[tuple[int, str]]:
    """(index, word) for every word of RAW[1:] that is a positional: no flag, and no flag's value. Stops at a
    bare `--`, past which nothing is this tool's own.

    A flag's value counts for nothing even where the flag is abbreviated (`--contain x`), or the call this
    reads as one word too deep is one argparse accepts (review of #2381, F3)."""
    options = flag_options(raw)
    out: list[tuple[int, str]] = []
    i = 1
    while i < len(raw):
        word = raw[i]
        if word == "--":
            break
        if word.startswith("-") and word != "-":
            name = word.split("=", 1)[0]
            takes_value = options.get(spelled_long_flag(name, options) or name)
            i += 2 if takes_value and "=" not in word else 1
            continue
        out.append((i, word))
        i += 1
    return out


def kind_scoped_options(p: argparse.ArgumentParser, kinds: list[str]) -> dict[str, frozenset[str]]:
    """Each long option of P whose own help text scopes it to some of KINDS: `--title`'s `pr: the title`,
    `--status-key`'s `comment: ...`, `--gate`'s `comment or review: ...`.

    A command whose words are one positional's `choices` has a single parser, so every one of its words
    takes every one of its options as far as argparse is concerned; the scope that really holds is written
    in the help, next to the option, which is where this reads it so the two cannot drift. Only a help text
    that *begins* with words that are all KINDS counts, so `--body`'s `the text (prefer --body-file: ...)`
    scopes nothing and answers for every kind."""
    out: dict[str, frozenset[str]] = {}
    for action in p._actions:  # noqa: SLF001
        lead, found, _ = (action.help or "").partition(":")
        if not found:
            continue
        # A help text names a kind in whatever number and case reads well there -- `wait`'s own options say
        # `comments:`, `runs:` and `PRs:` -- and that is still the kind it scopes to (review of #2381, F5:
        # before this, only `--exists`, `--gone` and `--contains` ever narrowed a `wait` call).
        spelled = {kind.lower().rstrip("s"): kind for kind in kinds}
        named = [spelled.get(word.lower().rstrip("s")) for word in re.split(r",\s*|\s+or\s+|\s+", lead.strip())
                 if word]
        if named and all(named):
            for option in action.option_strings:
                if option.startswith("--"):
                    out[option] = frozenset(word for word in named if word is not None)
    return out


def doubled_kind_synonym(raw: list[str]) -> tuple[list[str], list[str]]:
    """Two of one command's own first-slot words in a row, as `glaeda-gh post pr comment o/r#1`: the extra
    word is named, not guessed away: (argv, refusal lines).

    Measured 2026-11-21, that call answered `unrecognized arguments: manaflow-ai/cmuxterm-hq#17050` -- it
    named the one part of the call that was right, so the next try edited the target instead of dropping
    `pr`, and the receipt it was posting waited another round trip. Both `pr` and `comment` are words
    `post` takes and either reading runs, so which was meant decides what gets posted and where: it is
    refused and both readings are printed as lines that run, the way an ambiguous word is in
    `nesting_synonym`. The one narrowing is the same evidence that one uses -- the caller's own flags --
    read here off the help text that scopes each option to a kind (`kind_scoped_options`), because a
    command whose words are one positional's `choices` has one parser and so one set of options. That
    narrowing answers the measured call: `--gate` is `comment or review`'s, and of `pr` and `comment` only
    `comment` is left.

    Only a call that cannot parse anyway is touched: with more positional words than the command has room
    for. So `glaeda-gh search prs both`, whose `both` is a word of `search` but also this caller's query,
    is left exactly as typed, because `search` holds it."""
    if len(raw) < 3 or raw[0].startswith("-") or raw[0] in ("gh", "coord-alert", "wait-resume"):
        return raw, []
    tops, _ = nesting_table()
    if raw[0] not in tops:
        return raw, []  # not a command: `nesting_synonym` above has already had its say
    node = child_parser(parser(), raw[0])
    words = first_slot_words(node)
    found = positional_words(raw)
    if len(found) < 2 or len(found) <= positional_capacity(node):
        return raw, []
    (first, one), (second, two) = found[0], found[1]
    if one not in words or two not in words:
        return raw, []
    without_second = [w for i, w in enumerate(raw) if i != second]
    if one == two:
        print(f"glaeda-gh: read as `{typed_line(['glaeda-gh'] + without_second)}` (`{one}` is one word of "
              f"`{raw[0]}`, typed twice)", file=sys.stderr)
        return without_second, []
    readings = {one: without_second, two: [w for i, w in enumerate(raw) if i != first]}
    by_option = kind_scoped_options(node, words)
    scoped = {normalized_flag(option): scope for option, scope in by_option.items()}
    options = flag_options(raw)
    narrowed: set[str] = set(readings)
    evidence: list[str] = []
    for word in raw[1:]:
        if word == "--":
            break
        if not word.startswith("--"):
            continue  # a flag's value, a target, a body: data, never evidence (review of #2381, F1)
        name = word.split("=", 1)[0]
        scope = scoped.get(normalized_flag(name)) or scoped.get(
            normalized_flag(spelled_long_flag(name, options) or name))
        if scope is not None and not narrowed <= scope:
            narrowed &= scope
            evidence.append(f"`{name}` is {' or '.join(sorted(scope))}'s")
    if len(narrowed) == 1:
        kept = next(iter(narrowed))
        print(f"glaeda-gh: read as `{typed_line(['glaeda-gh'] + readings[kept])}` (`{one} {two}` is two words "
              f"of `{raw[0]}`, and {'; '.join(evidence)})", file=sys.stderr)
        return readings[kept], []
    told = f", and the flags typed scope to neither: {'; '.join(evidence)}" if not narrowed else ""
    refusal = [f"glaeda-gh: `{one} {two}` is two words of `{raw[0]}`, which takes one: `{raw[0]} {one}` and "
               f"`{raw[0]} {two}` are both calls that run and they do not do the same thing, so neither "
               f"word is dropped for you{told}"]
    refusal += [f"next: {typed_line(['glaeda-gh'] + own_kinds_flags(reading, kind, by_option, options))}"
                for kind, reading in readings.items()]
    return raw, refusal


def own_kinds_flags(argv: list[str], kind: str, by_option: dict[str, frozenset[str]],
                    options: dict[str, bool]) -> list[str]:
    """ARGV without the flags whose own help scopes them away from KIND, each with its value.

    A `next:` line is printed to be run, so it carries only what its own reading takes: `post pr comment
    o/r#1 --title t --status-key k` offers `post pr o/r#1 --title t`, not a call `post_item` refuses for
    `--status-key` (review of #2381, F4)."""
    scoped = {normalized_flag(option): scope for option, scope in by_option.items()}
    out: list[str] = []
    i = 0
    while i < len(argv):
        word = argv[i]
        if word == "--":
            out.extend(argv[i:])
            break
        name = word.split("=", 1)[0]
        spelled = spelled_long_flag(name, options) or name
        scope = scoped.get(normalized_flag(name)) or scoped.get(normalized_flag(spelled))
        if word.startswith("--") and scope is not None and kind not in scope:
            i += 2 if options.get(spelled) and "=" not in word else 1
            continue
        out.append(word)
        i += 1
    return out


def flag_spelling_synonym(raw: list[str]) -> tuple[list[str], list[str]]:
    """A long flag typed in another of its own case conventions, as this tool spells it: (argv, refusal lines).

    snake_case, camelCase and kebab-case of one of this command's options all name that option
    (`--body_file`, `--bodyFile`, `--body-file`), said on stderr so the next call is typed the canonical way.
    Only an *exact* match after normalising decides: nothing is matched by prefix or by substring, so
    `--file` is left for argparse, never read as `--body-file`, and `--body` and `--body-file` stay the two
    separate options they are. A spelling two real options would both answer to is refused, naming both."""
    if not raw or raw[0] in ("gh", "coord-alert", "wait-resume"):
        return raw, []
    options = flag_options(raw)
    by_key: dict[str, list[str]] = {}
    for option in options:
        by_key.setdefault(normalized_flag(option), []).append(option)
    fixed: list[str] = list(raw)
    said: list[str] = []
    i = 0
    while i < len(fixed):
        word = fixed[i]
        if word == "--":
            break  # nothing past a bare -- is this tool's own flag
        if not word.startswith("--"):
            i += 1
            continue
        name, joined, value = word.partition("=")
        if name in options:
            # Canonical already. A flag that takes its value in the next word consumes it: that word is data
            # (a body, a regular expression, a path) and no spelling of this tool's flags.
            i += 2 if options[name] and not joined else 1
            continue
        matches = sorted(set(by_key.get(normalized_flag(name), [])))
        if len(matches) > 1:
            return raw, [
                f"glaeda-gh: `{name}` is how {len(matches)} different options of this command are spelled "
                f"({', '.join(matches)}), and they do not mean the same thing: it is not guessed",
                *(f"next: {typed_line(['glaeda-gh'] + fixed[:i] + [m + (joined + value)] + fixed[i + 1:])}"
                  for m in matches)]
        if len(matches) == 1:
            fixed[i] = matches[0] + joined + value
            said.append(f"`{name}` is `{matches[0]}`")
            i += 2 if options[matches[0]] and not joined else 1
            continue
        i += 1  # no option of this command spells that way: argparse refuses it, with its own abbreviations
    if said:
        print(f"glaeda-gh: read as `{typed_line(['glaeda-gh'] + fixed)}` ({'; '.join(said)})", file=sys.stderr)
    return fixed, []

def main(argv: list[str] | None = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    if raw[:1] == ["search"] and len(raw) > 1 and raw[1].lower() in SEARCH_UNSERVED:
        # A form this subcommand cannot serve names the one that works, rather than reaching gh's REST search.
        print(f"glaeda-gh: {SEARCH_UNSERVED[raw[1].lower()]}", file=sys.stderr)
        print("next: glaeda-gh search --help", file=sys.stderr)
        return 64
    raw = land_notify_synonym(log_job_synonym(search_synonym(raw)))
    if raw and raw[0] == "gh":
        # Everything after `gh` belongs to the real gh, flags and all: argparse must not see it.
        if raw[1:2] == ["--install-shim"] or raw[1:2] == ["--print-shim"]:
            return cmd_gh_install_shim(raw[1] == "--print-shim")
        if raw[1:2] == ["--probe"]:
            # Whether this glaeda-gh has the broker at all, for a wrapper deciding whether to hand
            # a call to it. An older one answers with an argparse error, which is the point: a
            # wrapper that exec'd it would break every gh call on the host. Nothing else happens
            # here, so it is cheap enough for a caller to run once per build of this file.
            print(f"broker {BROKER_CONTRACT}")
            return EXIT_OK
        return cmd_gh(raw[1:])
    if raw[:1] == ["coord-alert"] and len(raw) == 2:
        # Not a command anyone types: straggler_notice's alert, in its own process (coord_alert_spawn).
        return coord_alert_send(raw[1])
    if raw[:1] == ["wait-resume"] and len(raw) == 2:
        # Not a command anyone types: BLOCKER hands a `wait pr|run` back here (resume_wait).
        try:
            return resume_wait(raw[1])
        except WatchError as error:
            say_waiting(f"glaeda-gh: {error}")  # a wait path: see the handler below
            say_waiting("next: glaeda-gh wait --help")
            return 64
        except KeyboardInterrupt:
            return 130
    for rewriter in (nesting_synonym, doubled_kind_synonym, flag_spelling_synonym):
        # The nesting first, then the flags: which options a command has depends on which command it is.
        # `doubled_kind_synonym` sits between them: it only looks at a call that already leads with a real
        # command, which is what `nesting_synonym` has just made sure of, and it reads flags only by name.
        raw, refusal = rewriter(raw)
        if refusal:
            for line in refusal:
                print(line, file=sys.stderr)
            return 64
    raw, inferred = infer_kind(raw)
    if inferred:
        print(inferred, file=sys.stderr)
    Parser.argv = raw
    args = parser().parse_args(raw)
    if getattr(args, "verbose", False):
        os.environ["AGENT_VERBOSE"] = "1"  # summary() and wait_request() read it, here and in the daemon's request
    try:
        if args.command == "serve":
            if not args.foreground_ok and not under_service() and service_loaded():
                raise WatchError(serve_refusal())
            return serve(args.foreground_ok)
        if args.command == "budget":
            return cmd_budget(args.json, fleet=not args.local)
        if args.command == "read":
            return cmd_read(sys.stdin.readline())
        if args.command == "audit":
            if args.last < 0:
                raise WatchError("--last must be 0 (all of it) or more lines")
            if args.by == "caller":
                return cmd_audit_by_caller(audit_lines(args.log or guard_log(), args.last), args.json)
            return cmd_audit(args.log or guard_log(), args.last, args.json)
        if args.command == "log":
            if args.kind == "errors":
                return cmd_log_errors(args.repo, args.job, args.max, args.json, reads=args.reads)
            if args.kind == "search":
                return cmd_log_search(args.repo, args.pattern, args.since, args.job, args.workflow, args.seg,
                                      args.conclusion, args.reads, args.limit, args.json)
            if args.kind == "flaky":
                return cmd_log_flaky(args.repo, args.test, args.since, args.job, args.reads, args.limit, args.json)
            return cmd_log_job(args.repo, args.job)
        if args.command == "search":
            return cmd_search(args.kind, args.words, args.repo, args.state, args.author, args.limit, args.json,
                              fields=parse_fields(args.field))
        if args.command == "runners":
            return cmd_runners(args.scope, args.label, args.json)
        if args.command == "restart":
            return cmd_restart(args.force)
        if args.command == "land":
            words = args.words
            if words == ["serve"]:
                return cmd_land_serve(sys.stdin.readline())
            if words[0] == "status":
                if len(words) > 2:
                    raise WatchError("land status takes at most one OWNER/REPO#N")
                return cmd_land_status(words[1] if len(words) == 2 else None, args.json)
            if words[0] == "cancel":
                if len(words) != 2:
                    raise WatchError("land cancel takes one OWNER/REPO#N")
                return cmd_land_cancel(words[1], args.json)
            if len(words) != 1:
                raise WatchError("land takes one OWNER/REPO#N (more PRs: one land each, --after to order them)")
            if args.wait < 0:
                raise WatchError("--wait must be 0 or more seconds")
            override = land_override(*land_override_given(args.override_reason, args.override_receipt))
            return cmd_land(words[0], args.after, args.notify, args.wait, args.json, args.sha, override,
                            args.max_wait)
        if args.command == "on-event":
            if args.action == "replay":
                if args.run_file is None or args.wait < 0:
                    raise WatchError("on-event replay needs --run-file PATH (and --wait 0 or more seconds)")
                return cmd_on_event_replay(args.run_file, args.jobs_file, args.wait, args.json)
            return cmd_on_event_status(args.json)
        if args.command == "post":
            if args.wait < 0:
                raise WatchError("--wait must be 0 or more seconds")
            if args.kind == "status":
                return cmd_post_status(args.target, args.wait, args.json)
            if not args.target:
                raise WatchError(f"post {args.kind} needs a target")
            return cmd_post(args)
        if args.command == "checks":
            if args.wait < 0:
                raise WatchError("--wait must be 0 or more seconds")
            bad = [x for x in args.shas if not re.fullmatch(r"[0-9a-fA-F]{40}", x)]
            if bad or not re.fullmatch(rf"{NAME}/{NAME}", args.repo):
                raise WatchError("checks takes OWNER/REPO and full 40-hex commit ids (git rev-parse HEAD)")
            if args.pr is not None and (args.pr <= 0 or len(args.shas) != 1):
                raise WatchError("--pr takes the PR number (1 or more) of the one head asked for")
            return cmd_checks(args.repo, args.shas, args.consumer, args.max_age, args.wait, args.json, pr=args.pr)
        if args.command == "status":
            return cmd_status(args.kind, args.target, args.jobs, args.json, fields=parse_fields(args.field))
        if args.rescue_grace < 0:
            raise WatchError("--rescue-grace must be 0 or more seconds")
        if args.settle < 0:
            raise WatchError("--settle must be 0 or more seconds")
        if args.kind == "file":
            if args.exists and args.gone:
                raise WatchError("wait file takes one of --exists and --gone")
            return cmd_wait_file(args.target, args.timeout, args.json,
                                 "gone" if args.gone else "exists" if args.exists else "nonempty", args.contains,
                                 args.max)
        if args.kind == "until":
            return cmd_wait_until(args.target, args.timeout, args.json)
        if args.kind == "pid":
            return cmd_wait_pid(args.target, args.timeout, args.json, args.max)
        if args.exists or args.gone or args.contains:
            raise WatchError("--exists, --gone and --contains are for wait file")
        if args.kind == "comment":
            if args.sha or args.jobs or args.until != "green":
                raise WatchError("wait comment takes --author, --match and --since, not --sha, --jobs or --until")
            return cmd_wait_comment(args.target, args.timeout, args.json, args.author, args.match, args.since,
                                    args.max)
        if args.author or args.match or args.since:
            raise WatchError("--author, --match and --since are for wait comment")
        return subscribe_wait(args.kind, args.target, args.until, args.timeout, args.jobs, args.json, args.sha,
                              args.rescue_grace, args.settle, args.max)
    except WatchError as error:
        # Through say_waiting for its stdout reason: this handler covers `wait --json`, so with
        # stderr closed `print(file=None)` made a bad-argument message the first line of the
        # document. The other stderr prints in this file are outside the wait paths and keep
        # `print`; see the PR.
        nxt = f"glaeda-gh {args.command} --help"
        say_waiting(f"glaeda-gh: {error}")
        say_waiting(f"next: {nxt}")
        if getattr(args, "json", False):
            print_json_error("refused", str(error), nxt)
        return 64
    except KeyboardInterrupt:
        return 130


# A wait holds its process for minutes to an hour. Run as a script, this file is compiled from source on every call
# (Python never caches a __main__ script's bytecode), and the compile's heap stays with the process for as long as it
# lives: 54 MB private for each waiting glaeda-gh on a GCP lane VM, against 13 MB for the same file loaded from cached
# bytecode (leo-workspace lane-density, 2026-11-16: waiters were a sixth of every lane's memory there). So a wait
# re-runs this same file once, in the same pid, from bytecode cached under ~/.cache, with the loader the gh wrapper
# already uses (leo-workspace tools/lane-vm-bootstrap). -I keeps the cwd off sys.path; the -X flag still applies.
LONG_LIVED = ("wait", "wait-resume")
PYC_ENV = "GLAEDA_GH_FROM_PYC"
PYC_LOADER = ('import sys, types, importlib.machinery as m; p = sys.argv[1]; sys.argv = sys.argv[1:]; '
              'g = types.ModuleType("__main__"); g.__file__ = p; sys.modules["__main__"] = g; '
              'exec(m.SourceFileLoader("__main__", p).get_code("__main__"), g.__dict__)')


def bytecode_argv(argv: list[str], env, executable: str, script: str) -> list[str] | None:
    """The argv that re-runs SCRIPT ARGV from cached bytecode, or None to run on here: not a wait, already from
    bytecode (PYC_ENV), or no HOME to cache under (never /tmp)."""
    home = env.get("HOME")
    if not argv or argv[0] not in LONG_LIVED or env.get(PYC_ENV) or not home or not executable:
        return None
    return [executable, "-I", "-X", f"pycache_prefix={home}/.cache/gh-quota/pycache", "-c", PYC_LOADER,
            os.path.abspath(script), *argv]


def exec_from_bytecode() -> None:
    again = bytecode_argv(sys.argv[1:], os.environ, sys.executable, __file__)
    if again:
        try:
            os.execve(again[0], again, {**os.environ, PYC_ENV: "1"})
        except OSError:
            pass  # runs on from source, as before


if __name__ == "__main__":
    exec_from_bytecode()
    raise SystemExit(main())
