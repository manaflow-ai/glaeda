UPSTREAM_CONFIG = Path.home() / ".config/glaeda/upstream.json"  # {"command": [...]}: read through it, no token
UPSTREAM_EVERY = 20  # seconds between upstream reads of every watched key (the upstream polls each PR every 60)
UPSTREAM_LAND_EVERY = 5  # an open land entry's PR is asked this often: the broker host's stream has its last check in seconds
UPSTREAM_NEW = 3  # a key with no data yet is asked for again this soon: the upstream fills it within a tick or two
STATUS_UPSTREAM_WAIT = 8.0  # status on an upstream-fed host: a tick plus two UPSTREAM_NEW asks, then read directly
UPSTREAM_DEADLINE = 60  # one run of the upstream command
# All of a tick's upstream runs together (the non-head part and the head part, UPSTREAM_DEADLINE each before): gcp-agent-
