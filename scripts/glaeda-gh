POST_BODY_MAX = 65536  # GitHub's limit for a comment, review or PR body
POST_ID = re.compile(r"\d{13}-\d+-[0-9a-f]{6}")  # queued-at ms, client pid, random: sorts oldest first
THROTTLED = re.compile(r"submitted too quickly|secondary rate limit|abuse detection", re.I)
# Comments for one thread that are in the queue together, queued within POST_JOIN_WINDOW of the first, go out as one
# comment: each body whole, in queue order, under a rule. Only what is already queued is joined (no write waits for a
# partner): over 2026-11-10 01:00-02:00Z, 110 comments went to 53 threads, and holding each for 60 s would have
# joined 3 of them while delaying all 110. A body that starts with a machine-read marker (`<!--`: review-running,
# pr-owner, risk receipts), a slash command or an @mention, or carries a status key is never joined: its readers read
# it whole, from its first line. Only one writer's comments are joined, and a join a wait began watching since is undone
# before its retry (post_unjoin).
POST_JOIN_WINDOW = 60
POST_JOIN_RULE = "\n\n---\n\n"
JOIN_MENTION = re.compile(r"(?<![\w.`])@[A-Za-z0-9][\w-]*")  # an @mention: a bot or a person is called; never joined
# A comment queued with --status-key KEY is that writer's status on its thread: the next one from the same writer
# ("by") with the same key edits it in place, over GraphQL, while it is still the thread's last comment, no comment
# wait watches the thread, and it is under POST_STATUS_MAX old. router-review's review-running marker and its
# verdict (one run token) were 2 comments per review, back to back: 25 of the 63 the shared login posted on the 20
# busiest threads in that hour.
POST_STATUS_MAX = 6 * 3600
STATUS_KEY = re.compile(r"[\w.:=@/-]{1,120}")
# A review-running marker (leo-workspace tools/review_running.py) still queued once its own run has ended is retired as
# superseded, never sent: its run's verdict or done line (`<!-- review-run=<run> -->`, or a comment keyed
# `review-run=<run>`) is queued or was posted on the thread. Sent after that end, it would hold the head's merge for
# nothing (review_running._runs counts only an end that comes after the marker). Receipts go out first (outbox_gate), so
# on huge-blue 2026-11-21 15:4xZ about 206 markers sat behind them. Nothing else retires one: another run's receipt at
# the same head leaves that run's own hold standing (cmux#31529's second review), and an old marker whose run never
# ended still starts review_running.slow()'s SHIP clock once posted (review_model). A queued end counts even if its own
# post later fails: the run has ended either way. RUN_ENDS records, per thread, the runs the outbox posted an end for
# (kept RUN_ENDS_KEEP).
REVIEW_MARK = re.compile(r"^<!-- review-running sha=([0-9a-f]{40}) at=(\S+) run=(run-[0-9a-f]{16}) by=([\w -]*) -->", re.I)
RUN_END = re.compile(r"<!-- review-run=(run-[0-9a-f]{16}) -->")
RUN_ENDS = "run-ends.json"
RUN_ENDS_KEEP = 24 * 3600
POST_STATUSES = "statuses.json"  # thread -> the last status comment the outbox posted there
POST_SUBJECTS = "subjects.json"  # thread -> its GraphQL node id (an issue's or PR's id never changes)
POST_EDITS = "edited.json"  # the comments the outbox edited in place: only their edits count as said again
POST_EDITS_KEEP = 2000
GQL_TRANSIENT = re.compile(r"something went wrong|timed? ?out|timeout|internal (?:server )?error|try (?:again|later)|"
                           r"service unavailable|temporarily|loading", re.I)
GQL_TRANSIENT_TYPES = frozenset({"INTERNAL", "INTERNAL_ERROR", "SERVICE_UNAVAILABLE", "TIMEOUT"})
GQL_REFUSALS = frozenset({"NOT_FOUND", "FORBIDDEN", "UNPROCESSABLE", "ARGUMENT_ERROR", "INSUFFICIENT_SCOPES",
                          "SAML_ERROR", "UNAUTHENTICATED"})
SUBJECT_QUERY = """query($o: String!, $r: String!, $n: Int!) { repository(owner: $o, name: $r) {
issueOrPullRequest(number: $n) { ... on Issue { id comments(last: 1) { nodes { id } } }
... on PullRequest { id comments(last: 1) { nodes { id } } } } } }"""
ADD_COMMENT = """mutation($s: ID!, $b: String!) { addComment(input: {subjectId: $s, body: $b}) {
commentEdge { node { id databaseId url authorAssociation author { __typename login } } } } }"""
EDIT_COMMENT = """mutation($c: ID!, $b: String!) { updateIssueComment(input: {id: $c, body: $b}) {
issueComment { id databaseId url authorAssociation author { __typename login } } } }"""
# Match cmux's base-owned risk classifier. This only wakes that classifier; it never grants SHIP authority.
RISK_RECEIPT = re.compile(r"^\W*(?:independent\s+)?review\s*\(([^)\n]*)\)\s*:\W*(ship|block|fix|not ship|hold)(?![\w-])",
                          re.I)


def outbox_gate(item: Any) -> bool:
    """A write a merge waits on: queued with --gate, or a comment whose first
    line is a review receipt (router-review's `Review (...): SHIP at SHA`). These go out ahead of every other queued
    write, so a SHIP never waits behind a hundred awareness comments while the login's create pause spaces them."""
    if not isinstance(item, dict):
        return False
    if item.get("gate") is True:
        return True
    body = str(item.get("body") or "")
    first = next((line for line in body.splitlines() if line.strip()), "").strip()
    return item.get("kind") == "comment" and bool(RISK_RECEIPT.match(first))


def thread_of(item: Any) -> str:
    return f"{str(item.get('repo') or '').lower()}#{item.get('number')}" if isinstance(item, dict) else ""


def run_end_of(item: Any) -> str | None:
    """The review run this queued or posted comment ends (superseded_by): its done line, or its run's status key."""
    if not isinstance(item, dict) or item.get("kind") != "comment":
        return None
    body = str(item.get("body") or "")
    if REVIEW_MARK.match(body):
        return None  # a marker ends nothing, even with its run's status key
    ended = RUN_END.search(body) or RUN_END.search(f"<!-- {item.get('status') or ''} -->")
    return ended.group(1) if ended else None


def superseded_by(item: Any, queue: list[tuple[Path, Any]], ended: dict) -> str | None:
    """Why a queued review-running marker need not go out (REVIEW_MARK's notes), or None: it must."""
    if not isinstance(item, dict) or item.get("kind") != "comment":
        return None
    mark = REVIEW_MARK.match(str(item.get("body") or ""))
    if not mark:
        return None
    run, thread = mark.group(3), thread_of(item)
    record = ended.get(thread)
    runs = record.get("runs") if isinstance(record, dict) else None
    if isinstance(runs, dict) and run in runs:
        return f"its run {run} already posted its verdict or done line on {thread}"
    for _, other in queue:
        if other is not item and thread_of(other) == thread and run_end_of(other) == run:
            return f"its run {run} has its verdict or done line queued ({other.get('id')})"
    return None


def note_run_ends(item: Any, at: float) -> None:
    """Record the run a posted comment ends (run_end_of) for superseded_by, pruned past RUN_ENDS_KEEP."""
    run = run_end_of(item)
    if not run:
        return
    path = BASE / RUN_ENDS
    doc = read_json(path)
    doc = doc if isinstance(doc, dict) else {}
    record = doc.get(thread_of(item))
    runs = record.get("runs") if isinstance(record, dict) else None
    doc[thread_of(item)] = {"runs": {**(runs if isinstance(runs, dict) else {}), run: at}}
    cut = at - RUN_ENDS_KEEP
    for thread in list(doc):
        runs = doc[thread].get("runs") if isinstance(doc[thread], dict) else None
        runs = {r: t for r, t in (runs if isinstance(runs, dict) else {}).items()
                if isinstance(t, (int, float)) and t > cut}
        if runs:
            doc[thread] = {"runs": runs}
        else:
            doc.pop(thread)
    write_json(path, doc)


def outbox_queue() -> list[tuple[Path, Any]]:
    """The outbox in send order: land-gating writes (outbox_gate) first, then the rest, each in queue order
    (oldest first). An unreadable entry keeps its queue place among the rest."""
    if not outbox_dir().is_dir():
        return []
    rows = [(path, read_json(path)) for path in sorted(outbox_dir().glob("*.json"))]
    return sorted(rows, key=lambda row: not outbox_gate(row[1]))  # stable: queue order within each class


VERDICTS = {"success", "neutral", "failure", "timed_out", "action_required", "startup_failure"}

NAME = r"[A-Za-z0-9_.-]+"
PR_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/pull/)(\d+)(?:[/?#].*)?")
RUN_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})/(?:actions/runs/)?(\d+)(?:[/?#].*)?")
ISSUE_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/pull/|/issues/)(\d+)(?:[/?#].*)?")
HEAD_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:@|/commit/)([0-9a-fA-F]{{40}})")
# A *key's* target comes with its kind named, so the separator before the number can be whichever one the
# caller typed: `#`, the URL's own path, or a plain `/`. `o/r/5` was 153 of the 358 targets this host's
# transcripts had refused by 2026-11-21 (a bare number another 173; see cwd_repo), and with the kind given
# none of it is ambiguous. A pr target still refuses `o/r/issues/5`: an issue is not a pull request.
# infer_kind keeps the strict forms above, where the kind is *not* given and `o/r/12345678901` is a run.
PR_KEY_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/pull/|/)(\d+)(?:[/?#].*)?")
RUN_KEY_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/(?:actions/runs/)?)(\d+)(?:[/?#].*)?")
ISSUE_KEY_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/pull/|/issues/|/)(\d+)(?:[/?#].*)?")
# `origin` as GitHub writes it, for a bare number's repository (cwd_repo)
REMOTE_RE = re.compile(rf"(?:git@github\.com:|(?:https?://|ssh://git@)github\.com/)({NAME})/({NAME}?)(?:\.git)?/?")
KEY_RES = {"pr": PR_KEY_RE, "run": RUN_KEY_RE, "comment": ISSUE_KEY_RE, "head": HEAD_RE}
# `KIND:TARGET` -- the notation this tool *prints* for a target, and so the string an agent copies out of a
# line and back into the next call. parse_key's output (`pr:owner/repo#5`, `run:owner/repo/123`) names the
# target in every waiting, still-waiting and summary line, and until 2026-11-21 handing one back was an
# argparse refusal ("argument kind: invalid choice: 'pr:teamleaderleo/leo-workspace/7241'") that cost a
# whole background wait: the job printed a usage block and exited having waited on nothing. Accepted
# everywhere a target is: the prefix carries the kind, so nothing here is a guess across kinds -- a prefix
# naming a *different* kind than the command's refuses, and names the spellings (drop_kind_prefix).
PREFIX_KINDS = ("pr", "run", "comment", "head", "file", "pid", "until")
STATUS_KINDS = ("pr", "run", "comment")  # the kinds `status` takes; `head` is read for a PR, never asked for
WAIT_KINDS = STATUS_KINDS + ("file", "pid", "until")
KIND_PREFIX_RE = re.compile(rf"({'|'.join(PREFIX_KINDS)}):\s*(\S.*)", re.I | re.S)
# The spellings of one target, for a refusal to name. `wait until`'s own targets (`quota:rest`) hold a
# colon that is not a kind, and a URL's `https:` is not one either: both fall through unchanged.
KIND_FORMS = {"pr": "OWNER/REPO#N, OWNER/REPO/N, pr:OWNER/REPO#N, a bare N in this checkout, or a pull request URL",
              "run": "OWNER/REPO/RUN_ID, OWNER/REPO#RUN_ID, run:OWNER/REPO/RUN_ID, or a run URL",
              "comment": "OWNER/REPO#N, OWNER/REPO/N, comment:OWNER/REPO#N, a bare N in this checkout, "
                         "or an issue or pull request URL",
              "head": "OWNER/REPO@SHA, head:OWNER/REPO@SHA, or a commit URL",
              "file": "a path, or file:PATH", "pid": "a process id, or pid:PID",
              "until": "quota, quota:rest, quota:graphql, an ISO time, a UTC time (14:40Z) or a duration (45m)"}


def split_kind_prefix(text: str) -> tuple[str, str] | None:
    """`("pr", "o/r#5")` for `pr:o/r#5`, the notation this tool prints; None when there is no kind prefix."""
    match = KIND_PREFIX_RE.fullmatch(text.strip())
    return (match.group(1).lower(), match.group(2).strip()) if match else None


def drop_kind_prefix(text: str, kind: str, also: tuple[str, ...] = ()) -> str:
    """TEXT without the `KIND:` prefix this tool prints for it, for a caller that already knows the kind.

    A prefix naming another kind is never read as this one: `wait pr run:o/r/123` refuses, and says which
    spellings a pr target has, rather than reading the run id as a pull request number. ALSO names the
    other prefixes this caller accepts (`post comment pr:o/r#5` posts on that pull request's thread)."""
    split = split_kind_prefix(text)
    if split is None:
        return text.strip()
    named, rest = split
    if named == kind or named in also:
        return rest
    forms = KIND_FORMS.get(kind, "")
    raise WatchError(f"{text!r} names a {named} target, but this is a {kind} target: a {kind} is "
                     f"{forms or 'named by its own form'}"
                     + (f"; a {named} target goes to a {named} call" if named in PREFIX_KINDS else ""))
CYCLES = {"pr": CYCLE, "run": CYCLE, "comment": COMMENT_CYCLE, "head": CYCLE}
BUCKETS = {"pr": "graphql", "run": "rest", "comment": "graphql", "head": "graphql"}  # each kind's usual bucket
OTHER = {"rest": "graphql", "graphql": "rest"}
BALANCED = ("pr", "run")  # kinds either bucket can read, routed to the richer one every tick
# Kinds GraphQL reads more cheaply (a comment watch every 15 s, a head in one aliased query) that REST
# reads only while GraphQL is low (below its floor) or throttled and REST is not.
FALLBACK = ("comment", "head")
# GitHub's secondary limit is one per account across REST and GraphQL, so a secondary 403 holds both
# buckets (moving the reads to the other one is the burst it asks us not to send), for its Retry-After
# or SECONDARY_BACKOFF doubling with each hit in a row up to SECONDARY_BACKOFF_MAX, whichever is longer.
SECONDARY_BACKOFF = 60
SECONDARY_BACKOFF_MAX = 900
SECONDARY = re.compile(r"secondary rate limit|abuse detection|For more on scraping GitHub and how it may affect your rights",
                       re.I)  # the last: GitHub's restriction page for a login it reads as scraping (2026-11-17)
CONTENT_ONLY = re.compile(r"content creation", re.I)  # "...temporarily blocked from content creation"
# The host-wide pacer for the secondary limit (gh-quota's pace.json, in this directory), when one is installed:
# its hold stops this daemon's reads too, and a secondary 403 the daemon meets is reported to it. Read only;
# the pacer alone writes it.
PACE_FILE = "pace.json"
PACE_CLI = Path.home() / ".local/lib/gh-quota/bin/gh"  # a link into the pacer's checkout, next to gh_quota.py
PACE_DEADLINE = 5
PACE_HOLD_MAX = 3600
# The login's create pause (GitHub's secondary content-creation limit), one fact per login that the gh guard keeps:
# `<cmd> content-pause` prints {"blocked_until": epoch seconds, "level": n} (blocked_until alone says paused), and
# `<cmd> content-pause --hold UNTIL --what TEXT` extends it (never shortens). The outbox posts with the token, not
# through the guard, so it asks before each create and reports its own throttles: a writer that kept posting through
# the pause renewed it for every other writer on the login. CONTENT_PAUSE_ENV names the command (shell words; empty
# turns it off); else the guard's gh_quota.py next to PACE_CLI's link, else CONTENT_PAUSE_NAMES on PATH. With none,
# the outbox posts as before.
CONTENT_PAUSE_ENV = "GLAEDA_CONTENT_PAUSE_CMD"
CONTENT_PAUSE_NAMES = ("gh-quota",)
CONTENT_PAUSE_TTL = 15  # seconds an answer is reused
# The daemon's main thread waits this long for the ask, so it is what the reads and waits lose to a hung keeper. A
# healthy answer read from the host's own file took 0.09-0.10 s (median 0.09 s, ten runs); 2 s is twenty times that,
# room for a loaded host's interpreter start. A slower answer is not lost: see CONTENT_PAUSE_SLOW_DEADLINE.
CONTENT_PAUSE_DEADLINE = 2
CONTENT_PAUSE_RETRY = 60  # seconds after a failed or timed-out ask before the next; the last answer stands meanwhile
# The ask runs on its own thread, and the daemon waits CONTENT_PAUSE_DEADLINE for it; a slower one goes on, bounded by
# this, and its answer is taken on a later pass (a keeper slower than 2 s was otherwise never heard: every ask timed
# out). The --hold report runs off the post's path on the same kind of thread, bounded by the same: the keeper writes
# the pause under a file lock that another writer on the host can hold for seconds, and a report killed at 2 s
# mid-write never told the other writers of the pause it was sent to share.
CONTENT_PAUSE_SLOW_DEADLINE = 15
CONTENT_PAUSE_REPORT_DEADLINE = 15
# While no answer is newer than CONTENT_PAUSE_RETRY and the ask is failing or still running, the pause is unknown:
# creates wait rather than go out into a pause other writers may have reported. For CONTENT_PAUSE_BLIND_MAX at most
# past the last answer (or the first ask, with none): a keeper broken for good then stops no create, and the outbox
# posts as a host with no keeper does, logged once per outage and shown by `post status`.
CONTENT_PAUSE_BLIND_MAX = 600
# A keeper that answers the ask with a usage error (argparse's "usage: ..." or "invalid choice", exit 2) has no
# `content-pause`: an older gh-quota than this outbox. That is an answer, not a failed ask: the outbox posts as a host
# with no keeper does (logged once), and asks again every CONTENT_PAUSE_ABSENT_REPROBE, so the pause applies again as
# soon as the keeper gains the command. Counted as failures, it held every create for CONTENT_PAUSE_BLIND_MAX after
# each daemon start, on every host whose gh-quota lagged (cosmic-gray, 2026-11-18).
CONTENT_PAUSE_ABSENT_REPROBE = 600
CONTENT_PAUSE_USAGE = re.compile(r"(?im)^\s*usage:|invalid choice")
# A private repository on a plan without branch protection or rulesets answers 403 with this: there are
# no requirements to read, as for a deleted base branch.
NO_FEATURE = re.compile(r"Upgrade to GitHub Pro|make this repository public to enable this feature", re.I)
RICH_WINDOW_MIN = 60  # seconds: a bucket about to reset is rich, but not infinitely so
FULL_WINDOW = 3600  # a bucket not seen yet, or past its reset, counts as a full hour's quota
SWITCH_MARGIN = 1.25  # a kind moves to the other bucket only when that one is this much richer
# Richness is reads per second, not requests: a PR read over REST is its pull, check runs, statuses and workflow runs
# (each conditional), over GraphQL a share of one aliased query for up to 10 PRs plus its probes. cosmic-gray,
# 2026-11-16 14:45 to 15:45Z: 268 counted REST over 105 REST PR reads (2.55 each) against 200 GraphQL points over 198
# GraphQL PR reads (1.0). Comparing what is left as if a request and a point bought the same read moved PRs to REST
# whenever it had 25% more left (10:49, 11:16, 11:43, 12:44, 13:39, 13:41 and 14:39Z that day), at 2.5 times the
# cost. The daemon's own spend log measures the cost (read_cost); these stand until it has READ_COST_MIN_READS reads
# over a bucket. Runs keep the plain comparison: over REST an unchanged run is a free 304.
COST_WEIGHTED = ("pr",)
READ_COST_DEFAULT = {("pr", "rest"): 2.5, ("pr", "graphql"): 1.0}
READ_COST_MIN_READS = 20
READ_COST_FLOOR = 0.05  # a measured cost of nothing (every read a 304) still costs something to route on
# And reads per second of the daemon's own time: a bucket's quota is not its only bound. A REST PR read is a dozen
# requests sent one after another (the pull, check-run pages, statuses, workflow runs, job lists), nearly all of them
# 304s, which are free, so read_cost fell to READ_COST_FLOOR and PRs stayed on REST whatever GraphQL had left.
# huge-blue, 2026-11-21 20:30-20:45Z: GraphQL back with 2875 points, every PR still on REST, 599 REST requests in
# 600 s (572 free) at ~0.65 s each on the tick's one thread, 32-53 PR reads stored per 600 s, waited PR data 9119 s
# old behind 1498 deferred keys, while one GraphQL query reads up to a batch of PRs. route() weighs each bucket by
# the lesser of what its quota affords and what its measured seconds per read afford (read_seconds: the wall time
# of the reads over the last READ_SECONDS_WINDOW, a slot wait or a slow edge included).
READ_SECONDS_DEFAULT = {("pr", "rest"): 4.0, ("pr", "graphql"): 0.5}
READ_SECONDS_MIN_READS = 10
READ_SECONDS_WINDOW = 900.0
REST_CHECK_PAGES = 5  # check-run pages (100 each) one PR read over REST takes at most
REST_STATUS_PAGES = 2  # commit-status pages (100 each) likewise
REST_RUN_PAGES = 2  # a commit's workflow-run pages (100 each) likewise: without its run a check has no workflow
REST_STEPS_MAX = 10  # step reads (a run's job-list page or one job) one PR read over REST makes at most
REST_JOB_PAGES = 3  # pages (100 jobs each) of one run's job list a step lookup reads before it reads the job alone
# A job whose steps read GitHub refused for good (404 for a job of a deleted run, 410, 422) is not asked again for
# this long: each such read was retried on every read of its PR, a counted request each time. A 5xx or a transport
# error is asked again at the normal pace: the steps hold a runner refusal for the rescue, whose grace is 360 s.
STEPS_RETRY = 900.0
STEPS_GONE = re.compile(r"HTTP (?:404|410|422)\b")
# The most counted REST requests one read can make before its step lookups, which are admitted one
# at a time: a PR is its pull, REST_CHECK_PAGES of check runs, statuses, runs, workflows, rules and
# the branch; a run is the run and its job list. The share admits a read only when this much fits. The
# workflows, rules and branch reads are shared (REST_REPO_PART_TTL), but a cold or expired share still sends them.
# A comment watch is the issue and at most two pages of its comments; a head is REST_CHECK_PAGES of check
# runs, its statuses, its workflow runs and the workflow names.
# The repository- and base-level parts of a REST PR read (the workflow names, the base's rulesets and its
# classic protection) are the same answer for every PR on that repository and base. The daemon keeps one
# answer for all of them this long; past it, the next PR read refreshes it with one conditional read. The
# branch's ETag moves with every commit to the base, so without this each PR paid a counted 200 after
# every base move. A required check added or dropped on the base shows within this time.
REST_REPO_PART_TTL = 600
REST_REPO_PART_KEEP = 3600  # an answer past its TTL still lends its ETag to the refresh this long
# A commit's check runs, statuses and workflow runs, a pull and a run's job list are read the same way for every
# watch that needs them (a PR and a head watch on one commit, PRs whose failed jobs share a run): one answer serves
# them all for REST_HEAD_PART_TTL, and past it the newest ETag known makes the refresh conditional, so a commit
# nothing changed on answers 304 (free). Before, a GraphQL read dropped a PR's kept answers (restParts=None), so the
# next REST read of that PR sent every one of them cold: on 2026-11-11 huge-blue's daemon sent 19 check-run, 17
# status, 17 workflow-run and 22 pull reads in an hour and not one came back 304. Short, so a nudged PR (NUDGE_MIN)
# still reads its head anew. REST_SHARED_MAX bounds the store; the oldest answers go first.
REST_HEAD_PART_TTL = 15
# Land refreshes are launched by separate worker processes. Keep one successful answer hot for the same short
# window as commit/head parts, so two workers that noticed the same stale PR do not both spend the broker read.
LAND_DIRECT_REUSE = REST_HEAD_PART_TTL
LAND_DIRECT_LOCK_WAIT = DIRECT_READ_BUDGET + LAND_DIRECT_REUSE + 1
REST_SHARED_MAX = 600
# A pull's ETag moves without the pull changing: GET pulls/N embeds its base and head repositories whole (pushed_at,
# open_issues_count, ...), so on a busy repository every read is a counted 200. cosmic-gray, 2026-11-16 15:25 to
# 15:38Z, GraphQL under its reserve and every PR on REST: 89 of 103 pull reads were counted, the largest single route
# (248 counted in all). GET issues/N is the same record without the repositories: its ETag holds until the PR
# itself changes (a push, a comment, a review, a label, a close or merge all move its updated_at), and an unchanged
# one answers 304, which is free (live, manaflow-ai/cmux#44595: two reads 90 s apart, pulls 200 and 200, issues 200
# then 304). So a REST PR read asks the issue first and reuses the pull it holds when the issue is unchanged
# (rest_pull). What the issue does not show is mergeability, which moves when the base moves: the kept pull is reused
# at most PULL_REUSE_MAX, never once GitHub had not computed mergeability (mergeable null), and never on a head whose
# checks have all finished and changed since (then the merge state the waits rule on is final, and is read anew).
PULL_REUSE_MAX = 300
# A REST PR read whose head is still running pages nothing while the head's check suites say nothing changed
# (claude-sr2-coord, 2026-11-17 09:41Z and 10:36Z: with GraphQL stopped, waits on cmux PRs cost 9.31 counted REST a
# read, check-run pages, job lists and pulls, and the pool drained at 127-169/min). The gate is one conditional
# GET commits/SHA/check-suites (one page: a suite per workflow run and app) beside the head's first status page and
# the issue: while every suite's status, conclusion and run count are as the last full read left them, the statuses
# too, and the issue shows the PR still open, the cached checks stand, read again as of now. A suite finishing (a
# failure included), a new suite or rerun, a status, a close, `--jobs`, a head with no suites, or a full read older
# than PR_REST_FULL_EVERY reads the head in full. So a moving cmux head costs about two counted requests a minute
# instead of nine; the price is that a check's own progress inside a running suite (one job failing early, a
# required check passing before its workflow ends) shows within PR_REST_FULL_EVERY rather than the next cycle. Only
# the REST route: GraphQL's rollup is one read already.
PR_REST_FULL_EVERY = 300
# A failed head with every check finished (settled) passes the same gate for this long after its last full read: its
# check runs can change only through a suite (a rerun queues the suite again, a new push is a new head the pull and
# issue show), so the gate's three reads see every change a full read would. Under a backlog no read came within
# PR_REST_FULL_EVERY of the last, so every read was a full one: huge-blue 2026-11-22 00:05Z, 650 waited PRs (609 of
# them land's, the oldest five all failed heads), GraphQL stopped, 33-43 PR reads per 600 s at ~12 requests a read,
# and the oldest waited PR 13701 s unread. Only failed heads: a green one is about to merge, and its full read
# re-reads the pull whose merge state a land rules on.
PR_REST_SETTLED_FULL_EVERY = 1800
PR_REST_SUITE_PAGE = 100  # a head with more suites than one page is read in full
# The REST loop reads one PR at a time, and each read's requests went out one after another: ~650 waited PRs at ~2 s a
# read is a ~1300 s pass however few requests each costs (huge-blue 2026-11-22). So the conditional GETs the next
# REST_PREFETCH_AHEAD reads will send (the paths and ETags their last read kept: Daemon.prefetch_rest) go out early on
# REST_PREFETCH_WORKERS threads, and each read takes its answers as it asks for them. Only the transport runs on a
# worker: admission (the quota latch, the REST share, the secondary hold, the per-minute cap) is decided before a
# request is sent, and charging, the spend log and the limits are request()'s, on the loop's thread, as for any other
# request. Only conditional requests go early, so one a read does not ask for after all is most often a free 304; one
# that is not is charged when the tick settles it (settle_prefetch). REST_PREFETCH_HELD bounds what is in flight or
# held unasked.
REST_PREFETCH_WORKERS = 4
REST_PREFETCH_AHEAD = 6
REST_PREFETCH_HELD = 24
# A wait on a PR read over REST that has run LONG_WAIT_AFTER is read every LONG_WAIT_FACTOR cycles (a check event the
# controller delivers still reads it at once): a cmux wait runs 30-60 minutes, and its last minutes decide nothing the
# first ones did not.
LONG_WAIT_AFTER = 900
LONG_WAIT_FACTOR = 2
REST_READ_MAX = {"pr": REST_CHECK_PAGES + REST_STATUS_PAGES + REST_RUN_PAGES + 5, "run": 2, "comment": 3,
                 "head": REST_CHECK_PAGES + REST_STATUS_PAGES + REST_RUN_PAGES + 1}

# NUM is the alias's PR-number variable: isRequired needs it
PR_FIELDS = """number url title state isDraft merged mergedAt mergeCommit { oid } mergeable mergeStateStatus headRefOid
headRefName baseRefName reviewDecision updatedAt baseRef { branchProtectionRule { requiredStatusCheckContexts }
rules(first: 50) { nodes { type parameters { ... on RequiredStatusChecksParameters {
  requiredStatusChecks { context } } } } } } commits(last: 1) { nodes { commit { oid
parents(first: 1) { nodes { oid } } SUITE_ATTEMPTS statusCheckRollup { state
contexts(first: 100) { totalCount PR_COUNTS pageInfo { hasNextPage endCursor } nodes { __typename
... on CheckRun { id name status conclusion detailsUrl databaseId startedAt completedAt
  isRequired(pullRequestNumber: NUM) checkSuite { databaseId conclusion app { slug }
  workflowRun { databaseId event workflow { name databaseId } } } }
... on StatusContext { context state description targetUrl createdAt isRequired(pullRequestNumber: NUM) } } } } } } }"""
# A check reads as its last real attempt left it (2026-11-05). statusCheckRollup, like every latest-attempt view, lists
# only each check suite's newest attempt, and one that ended in startup_failure ran no jobs: after two such reruns of
# run 41931705470, cmux#35906's "publish tree-addressed cmux-tui" red was gone from it, and the PR merged as 633d5e38
# at e1d1894a with that red not excused. Such an attempt is no result, never green. So each read also counts every
# suite's check runs in its newest attempt; a suite whose newest attempt ran nothing has its check runs (every attempt)
# read by id (last_real_contexts), one query for the whole batch, and folded in, newest per name.
# The count of every attempt's runs is not asked here (2026-11-08): GitHub prices a connection nested under
# checkSuites(first: 100) at 100 requests per PR whatever its own first is, so the two counts were 200 of the 204
# requests in each PR of the batched read, 20 points for a batch of ten. The suites whose newest attempt ran nothing
# (on a cmux head about 15 of 55, mostly apps' suites that never run anything) are read by id instead, where each
# suite is one request: a suite that never ran anything comes back with no runs and adds nothing.
SUITE_ATTEMPTS = ("checkSuites(first: 100) { totalCount pageInfo { hasNextPage } nodes { id "
                  "latest: checkRuns(first: 1) { totalCount } } }")
SUITE_RUNS_BATCH = 100  # suite ids per SUITE_RUNS query: GitHub's nodes(ids:) takes at most 100
PR_FIELDS = PR_FIELDS.replace("SUITE_ATTEMPTS", SUITE_ATTEMPTS)
# A PR's fingerprint (pr_fingerprint): what a verdict or a wait reads from a PR, as counts. The full read above costs
# about 1.4 points a PR (contexts, suites and rules at up to 100 each) and the daemons re-read every watched PR every
# cycle: on 2026-11-11 11Z, PR reads were 1,550 of the two daemons' ~2,000 GraphQL points an hour (huge-blue 602,
# cosmic-gray 949), most of them answers identical to the last. PR_PROBE asks only the fingerprint, about 3 requests a
# PR, so ten PRs cost 1 point; a PR whose fingerprint matches its last full read is confirmed (dataAt moves) without
# the full read, its check pages, its last-real-attempt suites or its steps. Any change, a PR never fully read, a
# partial one, or one fully read longer than PR_FULL_EVERY ago, is read in full.
PR_COUNTS = ("checkRunCount checkRunCountsByState { state count } statusContextCount "
             "statusContextCountsByState { state count }")
PR_FIELDS = PR_FIELDS.replace("PR_COUNTS", PR_COUNTS)
# `updatedAt` rides along without being part of the fingerprint: a comment, a label or a body edit moves it and nothing
# a verdict reads, so a probe that matched would otherwise keep the full read's updatedAt for up to PR_FULL_EVERY, and
# the broker's vouched `pr view` answers (gh_cache_vouch) go by it. A scalar, so it costs the probe nothing.
PR_PROBE_FIELDS = (f"number state isDraft merged mergeable mergeStateStatus headRefOid reviewDecision updatedAt "
                   f"commits(last: 1) "
                   f"{{ nodes {{ commit {{ checkSuites(first: 1) {{ totalCount }} statusCheckRollup {{ state "
                   f"contexts(first: 1) {{ totalCount {PR_COUNTS} }} }} }} }} }}")
PR_FULL_EVERY = 600  # a probed PR is still read in full this often (a renamed check, a base's required contexts)
# ... unless PR reads are behind (pr_behind): then a probe stands in for a full read up to PR_FULL_BEHIND_EVERY. A full
# cmux PR costs GitHub about 3.5 s to answer and a probe about 0.5 s (one host, 2026-11-22: 13-16 s for a batch of 8,
# 4-6 s for a probe of 10, the same PRs). With PR_FULL_EVERY as short as the stale bound, every PR in a backlog was past
# it, so none could be probed: ~1,000 waited PRs needed ~3,500 s of full reads a pass, about 100 PRs were stored per
# 600 s, and waited PR data reached 16,000 s old. A backlog is now drained by probes, the changed PRs read in full.
PR_FULL_BEHIND_EVERY = 3600
PR_WHOLE_EVERY = 1800  # ... and a PR past one page of checks is read whole (pages and all) at least this often
SUITE_RUNS = """query($suites: [ID!]!) { rateLimit { limit remaining resetAt cost } suiteRuns: nodes(ids: $suites) {
... on CheckSuite { id conclusion app { slug } workflowRun { databaseId workflow { name databaseId } }
checkRuns(first: 100, filterBy: { checkType: ALL }) { pageInfo { hasNextPage } nodes { id name status conclusion
  detailsUrl databaseId startedAt completedAt } } } } }"""


def ran_nothing_suites(commit: dict | None) -> list[str] | str:
    """The ids of COMMIT's check suites whose newest attempt ran no check run (an older attempt may have run some:
    last_real_contexts reads them); an error message when COMMIT has more suites than one page shows (one past it
    could hide a red: never greener)."""
    if commit is None:
        return []  # no such commit here (a fork that lacks it): nothing to read
    suites = commit.get("checkSuites")
    if not isinstance(suites, dict):
        # GitHub answers a field it failed to read as null beside an error: an unread field is never "none ran nothing"
        return "graphql: last real attempt: the commit's check suites could not be read"
    if (suites.get("pageInfo") or {}).get("hasNextPage"):
        return "graphql: last real attempt: more than 100 check suites on one commit"
    nodes = suites.get("nodes")
    if not isinstance(nodes, list):
        return "graphql: last real attempt: malformed check suites (no node list)"
    out = []
    for suite in nodes:
        # A null node, or a null, missing or non-count total, is GitHub failing that field beside a nested error:
        # read as zero it made a partial read look complete and could hide an older red (glaeda#1844 F1).
        latest = count_field(suite, "latest")
        if latest is None:
            return "graphql: last real attempt: malformed check suite counts (a partial read)"
        if latest == 0:
            if not suite.get("id"):
                return "graphql: last real attempt: malformed check suite (no id)"
            out.append(suite["id"])
    return out


def count_field(suite: object, field: str) -> int | None:
    """SUITE's FIELD.totalCount when it is a whole number of zero or more, else None (unread or malformed)."""
    if not isinstance(suite, dict):
        return None
    holder = suite.get(field)
    total = holder.get("totalCount") if isinstance(holder, dict) else None
    return total if type(total) is int and total >= 0 else None


def suites_contexts(suites: list[str] | str, runs: dict[str, list[dict]],
                    runs_error: str | None) -> tuple[list[dict], str | None]:
    """The check-run context nodes of SUITES (ran_nothing_suites: a list, or its error) out of RUNS (suite_runs);
    ([], error) when SUITES or RUNS could not be read: a partial read would be a smaller, greener head."""
    if isinstance(suites, str):
        return [], suites
    if not suites:
        return [], None
    if runs_error:
        return [], runs_error
    for s in suites:
        if s not in runs:
            return [], "graphql: last real attempt: a suite could not be read"
        if isinstance(runs[s], str):
            return [], runs[s]
    return [node for s in suites for node in runs[s]], None


COMMENT_FIELDS = f"""comments(last: {COMMENTS_LAST}) {{ totalCount nodes {{ databaseId url createdAt lastEditedAt
author {{ login }} body }} }}"""
ISSUE_FIELDS = f"""__typename ... on Issue {{ url state {COMMENT_FIELDS} }}
... on PullRequest {{ url state {COMMENT_FIELDS} }}"""
RUN_FIELDS = """__typename ... on WorkflowRun { databaseId runAttempt event createdAt updatedAt url displayTitle
workflow { name } checkSuite { status conclusion commit { oid } branch { name } } }"""
STEPS_QUERY = """query($ids: [ID!]!) { rateLimit { limit remaining resetAt cost }
nodes(ids: $ids) { ... on CheckRun { id steps(first: 100) { nodes { name conclusion } } } } }"""
TOKEN_RE = re.compile(r"(gh[pousr]_[A-Za-z0-9._-]{20,2048}|github_pat_[A-Za-z0-9_]{20,251}|[0-9a-f]{40})")


class WatchError(RuntimeError):
    pass


# ---------------------------------------------------------------- keys and files


def cwd_repo(cwd: str | None = None) -> str | None:
    """`owner/repo` of the GitHub `origin` of the directory the caller ran in, or None if it has none.

    This is what a bare `N` names. A bare number was 173 of the 358 targets this host's transcripts had
    refused by 2026-11-21, more than any other form, and it is the one an agent reaches for while working in
    a worktree of the repository the number belongs to -- where the answer is sitting in `origin`."""
    try:
        done = subprocess.run(["git", "-C", cwd or ".", "remote", "get-url", "origin"],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    match = REMOTE_RE.fullmatch(done.stdout.strip()) if done.returncode == 0 else None
    return f"{match.group(1)}/{match.group(2)}" if match else None


def target_readable(kind: str, text: str) -> bool:
    """Whether KIND would read TEXT as a target at all, for a refusal deciding what to suggest. No side
    effects and no `cwd_repo` read: a bare number is a target's shape whether or not an origin answers."""
    text = text.strip()
    split = split_kind_prefix(text)
    if split is not None:
        if split[0] != kind:
            return False
        text = split[1]
    if kind in ("pr", "run", "comment") and BARE_NUMBER.fullmatch(text):
        return True
    return kind in KEY_RES and bool(KEY_RES[kind].fullmatch(text))


def local_branch(name: str, cwd: str | None = None) -> bool:
    """Whether NAME is a branch of the checkout the caller ran in (its own or a remote-tracking one). One local git
    call, on a refusal path only: it is what makes a slash-bearing branch name (`feat/x`, which reads exactly like
    OWNER/REPO) safe to answer as a branch."""
    # for-each-ref takes patterns: an empty name, or one holding a glob character, would match every branch there
    # is and read as a branch of any name (an empty target did, 2026-11-22).
    if not name or any(c in name for c in "*?[]~^: \t\\") or name.startswith("/") or name.endswith("/"):
        return False
    try:
        done = subprocess.run(["git", "-C", cwd or ".", "for-each-ref", "--count=1", "--format=%(refname:short)",
                               f"refs/heads/{name}", f"refs/remotes/origin/{name}"],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    return done.returncode == 0 and bool(done.stdout.strip())


def branch_target_step(kind: str, text: str, cwd: str | None = None) -> str:
    """The one command that turns a branch name into the target `status`, `wait` and `land` take, when TEXT names a
    branch rather than a PR, else "". `OWNER/REPO@BRANCH` says the repository itself; a bare word is a branch only
    when the checkout the caller stands in has one by that name, and then the repository is its origin.

    A PR is the thing an agent has in hand least often: what it has is the branch it just pushed. `glaeda-gh status
    pr --head BRANCH` and `status run --branch main` are both unrecognized arguments (two refused calls in this
    lane, 2026-11-21), and the refusal for a branch typed as a target said only what a target must look like, which
    does not say how to get from the branch to the number. `--field target` prints `owner/repo#5`, a target this
    tool takes as it stands, so the printed step's output is the next call's argument."""
    if kind not in ("pr", "comment") or not text or "#" in text or "://" in text or text.startswith("-"):
        return ""
    repo, branch = "", text
    if "@" in text:
        left, branch = text.rsplit("@", 1)
        # NAME, not `[^/\s]+`: git allows `@` in a branch name, so `o/r@feat@v2` would otherwise print a step whose
        # `--repo o/r@feat` the search refuses -- a printed command that does not run (Opus review of #2428).
        if not re.fullmatch(rf"{NAME}/{NAME}", left):
            return ""
        repo = left
    # `HEAD` and friends resolve as refs in any clone but name no branch GitHub could search for.
    if not branch or BARE_NUMBER.fullmatch(branch) or "@" in branch or SHA40.fullmatch(branch) \
            or branch in ("HEAD", "FETCH_HEAD", "ORIG_HEAD", "MERGE_HEAD"):
        return ""  # `o/r@<40 hex>` is a head, which `parse_key("head", ...)` takes as it stands
    if not repo:
        if not local_branch(branch, cwd):
            return ""
        repo = cwd_repo(cwd) or ""
    if not repo:
        return ""
    return f"glaeda-gh search prs --repo {repo} head:{branch} --state open --field target,state"


def parse_key(kind: str, text: str) -> str:
    """`pr:owner/repo#n`, `run:owner/repo/id` or `comment:owner/repo#n`, lowercased so every session
    shares one entry. A bare `N` or `#N` is that number in the repository the caller is standing in,
    and a target already spelled the way this function prints it (`pr:o/r#5`) is taken as it stands."""
    text = drop_kind_prefix(text, kind)
    bare = BARE_NUMBER.fullmatch(text) if kind in ("pr", "run", "comment") else None
    if bare:
        repo = cwd_repo()
        if not repo:
            raise WatchError(f"{text!r} is a number with no repository: name it as OWNER/REPO#{bare.group(1)}, "
                             f"or run this where the repository's origin is ({os.getcwd()} has none)")
        # said, not silent: a number resolved against the wrong checkout would read as the right PR
        text = f"{repo}{'/' if kind == 'run' else '#'}{int(bare.group(1))}"
        say_waiting(f"glaeda-gh: {bare.group(0)} is {text} (the origin of {os.getcwd()})")
    match = KEY_RES[kind].fullmatch(text) if kind in KEY_RES else None
    if not match:
        form = {"pr": "OWNER/REPO#N or a pull request URL", "run": "OWNER/REPO/RUN_ID or a run URL",
                "comment": "OWNER/REPO#N or an issue or pull request URL"}.get(kind, "pr, run or comment")
        step = branch_target_step(kind, text)
        if step:
            raise WatchError(f"{text!r} is a branch, and {kind} takes {form}: that number is one search away; "
                             f"next: {step}")
        raise WatchError(f"{kind} must be {form}, not {text!r}")
    owner, repo, number = match.groups()
    if kind == "head":
        return f"head:{owner.lower()}/{repo.lower()}@{number.lower()}"
    sep = "/" if kind == "run" else "#"
    return f"{kind}:{owner.lower()}/{repo.lower()}{sep}{int(number)}"


def split_key(key: str) -> tuple[str, str, str, Any]:
    """(kind, owner, repo, number); a head's last part is its 40-hex commit id."""
    kind, rest = key.split(":", 1)
    owner, rest = rest.split("/", 1)
    repo, number = re.split(r"[#/@]", rest, maxsplit=1)
    return kind, owner, repo, number.lower() if kind == "head" else int(number)


ROUTE_SHA = re.compile(r"[0-9a-fA-F]{40}")


def route_of(method: str, path: str) -> str:
    """A REST request's route template, for the spend log: METHOD /repos/{owner}/{repo}/pulls/{id}?per_page&state.
    Ids and commit SHAs are templated, a branch (which may hold slashes) or a label is one {branch} or {label}, and
    the query keeps its parameter names only, so one route counts every PR and page it read."""
    path, _, query = path.partition("?")
    parts = path.split("/")
    if len(parts) > 3 and parts[1] == "repos":
        parts[2:4] = ["{owner}", "{repo}"]
    out: list[str] = []
    for seg in parts:
        if out and out[-1] == "branches":
            out.append("{branch}")
            break
        if out and out[-1] == "labels":
            out.append("{label}")
            break
        out.append("{id}" if seg.isdigit() else "{sha}" if ROUTE_SHA.fullmatch(seg) else seg)
    names = sorted({p.split("=", 1)[0] for p in query.split("&") if p})
    return f"{method} {'/'.join(out)}" + ("?" + "&".join(names) if names else "")


def load_spend(doc: Any) -> dict[int, dict[str, list[int]]]:
    """SPEND_FILE's minutes, the well-formed rows only."""
    minutes = doc.get("minutes") if isinstance(doc, dict) else None
    out: dict[int, dict[str, list[int]]] = {}
    for minute, rows in (minutes if isinstance(minutes, dict) else {}).items():
        if not str(minute).isdigit() or not isinstance(rows, dict):
            continue
        for key, row in rows.items():
            if (isinstance(key, str) and isinstance(row, list) and len(row) == 3
                    and all(isinstance(n, int) and not isinstance(n, bool) and n >= 0 for n in row)):
                out.setdefault(int(minute), {})[key] = list(row)
    return out


SPEND_WAITERS_SHOWN = 3  # waiters named inside one restByCaller or graphqlByQuery row


def spend_summary(rows: list[dict], seconds: float = 3600.0, top: int = SPEND_TOP) -> dict:
    """The spend log's tables, most spent first: REST by route (with the caller that spent most on it), REST by
    route and caller, GraphQL by query and caller, and each bucket's totals."""
    rest = [r for r in rows if r["bucket"] == "rest"]
    gql = [r for r in rows if r["bucket"] == "graphql"]
    routes: dict[str, dict] = {}
    for r in rest:
        mine = routes.setdefault(r["name"], {"route": r["name"], "requests": 0, "counted": 0, "callers": {},
                                             "waiters": {}})
        mine["requests"] += r["requests"]
        mine["counted"] += r["counted"]
        who = f"{r['kind']} {r['repo']}".strip()
        mine["callers"][who] = mine["callers"].get(who, 0) + r["counted"]
        if r.get("waiter"):
            mine["waiters"][r["waiter"]] = mine["waiters"].get(r["waiter"], 0) + r["counted"]
    by_route = []
    for mine in routes.values():
        callers, waiters = mine.pop("callers"), mine.pop("waiters")
        lead = max(callers.items(), key=lambda kv: (kv[1], kv[0]), default=("", 0))
        held = max(waiters.items(), key=lambda kv: (kv[1], kv[0]), default=("", 0))
        by_route.append({**mine, "topCaller": lead[0], "topCallerCounted": lead[1], "callers": len(callers),
                         "topWaiter": held[0], "topWaiterCounted": held[1], "waiters": len(waiters)})
    def rank(r: dict, field: str) -> tuple:
        return (-r[field], -r["requests"], r.get("route") or r.get("name") or "", r.get("kind", ""), r.get("repo", ""))

    def by_caller(rows: list[dict], field: str) -> list[dict]:
        """ROWS merged per name, kind and repo before ranking, its waiters inside (most FIELD first): a key holds
        the waiter too, so twelve 1-point pr queries for twelve waiters were twelve rows, not one of 12 (#1931)."""
        merged: dict[tuple, dict] = {}
        for r in rows:
            row = merged.setdefault((r["name"], r["kind"], r["repo"]), {"name": r["name"], "kind": r["kind"],
                                                                         "repo": r["repo"], "requests": 0,
                                                                         field: 0, "waiters": {}})
            row["requests"] += r["requests"]
            row[field] += r[field]
            if r.get("waiter"):
                row["waiters"][r["waiter"]] = row["waiters"].get(r["waiter"], 0) + r[field]
        out = sorted(merged.values(), key=lambda r: rank(r, field))[:top]
        for row in out:
            row["waiters"] = [{"waiter": w, field: n} for w, n in
                              sorted(row["waiters"].items(), key=lambda kv: (-kv[1], kv[0]))[:SPEND_WAITERS_SHOWN]]
        return out
    return {"window": int(seconds),
            "rest": {"requests": sum(r["requests"] for r in rest), "counted": sum(r["counted"] for r in rest)},
            "graphql": {"queries": sum(r["requests"] for r in gql), "points": sum(r["points"] for r in gql)},
            "restByRoute": sorted(by_route, key=lambda r: rank(r, "counted"))[:top],
            "restByCaller": [{"route": r["name"], "kind": r["kind"], "repo": r["repo"], "requests": r["requests"],
                              "counted": r["counted"], "waiters": r["waiters"]} for r in by_caller(rest, "counted")],
            "graphqlByQuery": [{"query": r["name"], "kind": r["kind"], "repo": r["repo"], "queries": r["requests"],
                                "points": r["points"], "waiters": r["waiters"]} for r in by_caller(gql, "points")]}


def waiters_text(r: dict, field: str) -> str:
    """" for W1 5, W2 3" from a spend_summary row's top waiters."""
    shown = [f"{w.get('waiter')} {w.get(field, 0)}" for w in r.get("waiters") or [] if isinstance(w, dict)]
    return f" for {', '.join(shown)}" if shown else ""


def route_waiter(r: dict) -> str:
    """"; waiter W" for a restByRoute row whose reads were for a named waiter (spend_summary topWaiter)."""
    return f"; waiter {r['topWaiter']}" if r.get("topWaiter") else ""


def host_spenders(run: Callable[..., Any] = subprocess.run) -> tuple[list[dict], int | None]:
    """This host's top REST spenders on the shared login over the last hour (SPENDERS_CMD usage --json), with the REST
    all its callers spent: ([], None) when it cannot say. Each row is {caller, rest, graphql, source}."""
    try:
        # Every host signed in to the login first (gh-quota `usage --fleet --cache-only` answers from its
        # last sweep or starts one and exits nonzero), so the pool alarm's "unlogged" is what no host logged; on
        # 2026-11-16 another host's logs held 2892 REST an hour this alarm called unlogged. An older gh-quota, or no
        # fresh sweep yet: this host's own usage, as before.
        done = run([SPENDERS_CMD, "usage", "--json", "--fleet", "--cache-only"], capture_output=True, text=True,
                   timeout=SPENDERS_TIMEOUT)
        if done.returncode != 0 or not (done.stdout or "").strip():
            done = run([SPENDERS_CMD, "usage", "--json"], capture_output=True, text=True, timeout=SPENDERS_TIMEOUT)
        if done.returncode != 0 or not (done.stdout or "").strip():
            return [], None  # it could not say: an empty answer is not "spent nothing" (#1936 review)
        rows = json.loads(done.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return [], None
    if not isinstance(rows, list):
        return [], None
    rows = [r for r in rows if isinstance(r, dict) and any(
        isinstance(r.get(pool), int) and not isinstance(r.get(pool), bool) and r[pool] > 0
        for pool in ("rest", "graphql"))]
    rows.sort(key=lambda r: (-max(int(r.get("rest", 0)), int(r.get("graphql", 0))),
                           str(r.get("caller"))))
    return ([{k: r.get(k) for k in ("caller", "rest", "graphql", "source", "host") if k in r} for r in rows[:SPENDERS_TOP]],
            sum(r.get("rest", 0) for r in rows if isinstance(r.get("rest"), int)))


def consumer_share_alarm(rows: list[dict], policy: dict) -> tuple[str, str, dict] | None:
    """Page when one observed caller exceeds the configured share of either account pool."""
    fraction = float(policy.get("fraction", CONSUMER_SHARE_FRACTION))
    minimum = int(policy.get("minCalls", CONSUMER_SHARE_MIN_CALLS))
    alarms = []
    for pool, label in (("rest", "REST"), ("graphql", "GraphQL")):
        for row in rows:
            calls = row.get(pool)
            if isinstance(calls, int) and not isinstance(calls, bool) and calls >= minimum and calls > fraction * 5000:
                caller = f"{row.get('host')}:{row.get('caller')}" if row.get("host") else str(row.get("caller") or "?")
                alarms.append((calls, pool, label, caller))
    if not alarms:
        return None
    alarms.sort(reverse=True)
    calls, pool, label, caller = alarms[0]
    details = "; ".join(f"{name}={value}" for value, _pool, _label, name in alarms[:5])
    text = (f"WARN glaeda-gh on {policy_host()}: {caller} consumed {calls}/5000 {label} in the last hour, "
            f"over the {fraction:.0%} consumer-share threshold. Top flagged consumers: {details}.")
    return "warn", text, {"pool": pool, "caller": caller, "calls": calls, "limit": 5000,
                           "fraction": fraction, "minCalls": minimum, "alarms": [
                               {"pool": p, "caller": n, "calls": c, "limit": 5000, "fraction": fraction}
                               for c, p, _l, n in alarms]}


def share_slow(shed: dict | None, spenders: list[dict]) -> dict | None:
    """The one caller the share alarm names to slow: the login's top REST spender on this host (host_spenders), unless
    that is this daemon, or the daemon's top waiter (share_alarm's shed) spent more; then that waiter. None when
    neither is known."""
    other = next((r for r in spenders if not str(r.get("caller") or "").startswith("daemon:")), None)
    if shed and (other is None or shed["counted"] >= other["rest"]):
        return {"caller": shed["waiter"], "rest": shed["counted"], "via": "glaeda-gh waits"}
    if other is not None:
        return {"caller": other["caller"], "rest": other["rest"], "via": other.get("source") or "gh",
                **({"host": other["host"]} if other.get("host") else {})}
    return None


def share_slow_text(slow: dict | None) -> str:
    if slow is None:
        return "No caller to slow is known: the spend is the daemon's own; check restYield in its policy."
    if slow["via"] == "glaeda-gh waits":
        return f"Slow {slow['caller']} ({slow['rest']} counted REST, its glaeda-gh waits): end or slow its waits."
    where = f"on {slow['host']}" if slow.get("host") else "here"
    return f"Slow {slow['caller']} ({slow['rest']} REST this hour, {slow['via']}): the login's top REST caller {where}."


# The pool alarm names the REST no log on this host holds, once it is this share of what the pool spent and at least
# UNLOGGED_MIN. GitHub's limit is the login's, on every host signed in to it and every token of it: on 2026-11-10
# cosmic-gray's logs held about 64 of the pool's 180 a minute, and every alarm named only those.
UNLOGGED_SHARE = 0.25
UNLOGGED_MIN = 300
UNLOGGED_EARLY = 600  # a window younger than this is too early to measure (#1937 review)


def unlogged_text(limit: int | None, remaining: int | None, reset: float | None, now: float,
                  host_rest: int | None, fleet: bool = False) -> tuple[str, int | None]:
    """(" At least G of the U REST ... ", G) for the REST no log on this host holds, else ("", None). Both sides
    cover the same requests, so a burst is not taken for a rate (#1936 review): U is what GitHub says the pool spent
    since its window opened (LIMIT - REMAINING, at most an hour back from RESET), and HOST_REST is every logged call
    on this host in the last hour, which holds that window. G = U - HOST_REST can only understate what is unlogged.
    NOW is read after the usage read: a long tick can cross RESET first (#1937 review)."""
    if host_rest is None or not isinstance(limit, int) or not isinstance(remaining, int) or reset is None:
        return "", None
    if reset <= now:  # the counter expired while usage ran: the host's hour has dropped requests it still counts
        return "", None
    since = max(0.0, min(3600.0, 3600.0 - (reset - now)))
    if since < UNLOGGED_EARLY:  # a fresh window has spent too little to compare: say so, never "nothing unlogged"
        return (f" Too early in GitHub's window ({since / 60:.0f} min old) to say how much REST no log on "
                f"{policy_host()} holds.", None)
    used = limit - remaining
    gap = used - host_rest
    if gap < UNLOGGED_MIN or gap < UNLOGGED_SHARE * used:
        return "", None
    if fleet:  # HOST_REST summed every login host's logs (`gh-quota usage --fleet`)
        return (f" At least {gap} of the {used} REST the pool spent in the last {since / 60:.0f} min ({gap / used:.0%}) "
                f"is in no host's log (`{Path(SPENDERS_CMD).name} usage --fleet`): this login's token used outside gh.",
                gap)
    return (f" At least {gap} of the {used} REST the pool spent in the last {since / 60:.0f} min ({gap / used:.0%}) is "
            f"in no log on {policy_host()}: other hosts signed in to this login (their `{Path(SPENDERS_CMD).name} "
            f"usage`), or its token used outside gh.", gap)


def spenders_text(rows: list[dict]) -> str:
    rest_rows = [r for r in rows if isinstance(r.get("rest"), int) and r["rest"] > 0]
    if not rest_rows:
        return f"Top REST callers on {policy_host()}: unknown ({Path(SPENDERS_CMD).name} usage gave none); glaeda-gh budget."
    said = "; ".join(f"{r['caller']} {r['rest']}" + (f" ({r['source']})" if r.get("source") else "") for r in rest_rows)
    where = "on every login host" if any(r.get("host") for r in rest_rows) else f"on {policy_host()}"
    return f"Top REST callers {where}, last hour: {said}."


def waiter_of(e: dict) -> str:
    """The reader that read a watch entry last (the watch's `reader`), "" when none is named."""
    return e.get("reader") if isinstance(e.get("reader"), str) else ""


def waiters_of(entries: list[dict]) -> str:
    """The spend log's waiter of a batch: its one waiter, or how many there are."""
    names = sorted({waiter_of(e) for e in entries} - {""})
    return names[0] if len(names) == 1 else f"{len(names)} waiters" if names else ""


def caller_of(key: str) -> tuple[str, str]:
    """(watch kind, owner/repo) of a watch key, for the spend log."""
    try:
        kind, owner, repo, _ = split_key(key)
    except (ValueError, IndexError):
        return key.split(":", 1)[0] or "other", ""
    return kind, f"{owner}/{repo}"


def watch_dir() -> Path:
    return BASE / "watch"


def cache_dir() -> Path:
    return BASE / "cache"


def outbox_dir() -> Path:
    return BASE / "outbox"  # writes `post` queued, one file each, named by id (oldest first)


def posted_dir() -> Path:
    return BASE / "posted"  # finished writes: the URL, or why it failed (kept POST_KEEP)


def file_name(key: str) -> str:
    return hashlib.sha256(key.encode()).hexdigest()[:32] + ".json"


# A watch's mtime is its last read. A read within this long of the last touch leaves the file alone when nothing could
# tell the two apart: on cosmic-gray (2026-11-05) fseventsd held a 27 GB footprint while watch/ files were rewritten
# with the same bytes many times a minute. 5 s is noise against what reads the mtime: IDLE_BACKOFF_AFTER (300 s),
# TERMINAL_GRACE (120 s) and IDLE_EXPIRY (15 min). The one exact comparison, a reader newer than the cache's last
# fetch (Daemon.due), keeps its answer: the touch is skipped only while the mtime is already past every stamp the
# cache holds, so the comparison comes out the same with or without it (interest_fresh).
INTEREST_QUIET = 5.0


def interest_fresh(path: Path, key: str, now: float | None = None) -> bool:
    """Whether touching PATH (KEY's watch) now would change nothing a reader of its mtime decides: touched within
    INTEREST_QUIET and already newer than the cache's fetchedAt, dataAt and restAt."""
    try:
        mtime = path.stat().st_mtime
    except OSError:
        return False
    now = time.time() if now is None else now
    if not 0 <= now - mtime < INTEREST_QUIET:
        return False
    c = read_cache(key) or {}
    stamps = [c.get(k) for k in ("fetchedAt", "dataAt", "restAt")]
    return all(mtime > s for s in stamps if isinstance(s, (int, float)) and not isinstance(s, bool))


# Who keeps a watch read: each watch file names its readers ({"session:NAME" or "tool:NAME": last time}), so the
# spend log and the alarms can say which waiter a REST route is spent for. On 2026-11-10 the pool alarm named
# "pr manaflow-ai/cmux" behind pulls, check runs and job reads, and nothing said which of the dozens of sessions,
# lane VMs and reconcilers kept those PRs watched. A reader already named within READER_REFRESH is not written again,
# so a hot read stays a stat and a utime.
READER_REFRESH = 300.0
# ACPMUX_FROM and CMUX_AGENT_SESSION_ID are what `reach HOST CMD` exports on the far side of its ssh hop (the caller's
# session name, its harness session id, CMUX_AGENT_HOST its host): without them every wait an agent on another host
# ran through reach was tool:unknown (2026-11-11, huge-blue: claude-sr2-coord's waits from cosmic-gray, parent sshd).
READER_KEYS = ("ACPMUX_SESSION_NAME", "ACPMUX_FROM", "CMUX_AGENT_SESSION", "ACPMUX_SESSION_ID", "CMUX_AGENT_SESSION_ID",
               "CLAUDE_SESSION_ID", "CLAUDE_CODE_SESSION_ID", "CODEX_THREAD_ID", "CODEX_SESSION_ID")
# A helper names itself inside its session (session:NAME:agent:ID): GLAEDA_GH_AGENT, else CMUX_AGENT_NAME, else, for
# a subagent (Claude Code's AI_AGENT ends in _agent; it shares its parent's session variables) or a caller over
# reach, the checkout it works in (`wt new` gives each helper its own: .../checkouts/REPO/NAME). claude-sr2-coord's
# helpers all read as session:claude-sr2-coord, so a spend alarm could not tell which of a dozen helpers held a PR.
READER_AGENT_KEYS = ("GLAEDA_GH_AGENT", "CMUX_AGENT_NAME")
READER_ENV = READER_KEYS + READER_AGENT_KEYS + ("GLAEDA_GH_READER", "AI_AGENT", "CMUX_AGENT_HOST", "SSH_CLIENT")
READER_WRAPPERS = re.compile(r"(?i)(ba|z|da|)sh|python3?(\.\d+)?|env|xargs|timeout|nice|gh|glaeda-gh")
# A reader's name is written to watch files, spend logs, upstream requests and alarms, so it never carries command-line
# text: only a session's name or id, or an executable's or script's base name, each held to this shape. A parent
# `bash -c 'TOKEN=... python3 probe.py'` once gave the reader `tool:TOKEN=... python3 probe.py` (review, glaeda#1931).
READER_NAME = re.compile(r"[A-Za-z0-9._-]{1,64}")
# A reader handed in (GLAEDA_GH_READER, a downstream HOST/READER over the upstream): KIND:NAME parts of that shape.
READER_SAFE = re.compile(r"(?:[A-Za-z0-9._-]{1,64}/)?(?:session|tool):[A-Za-z0-9._-]{1,64}(?::agent:[A-Za-z0-9._-]{1,64})?")
_reader: str | None = None


def parent_command(pid: int) -> list[str]:
    """The words of process PID's command line ([] when it cannot be read): /proc on Linux, ps elsewhere."""
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        return [w for w in raw.decode(errors="replace").split("\0") if w]
    except OSError:
        pass
    try:  # one ps answers both this and parent_pid's question, so the reader walk forks one ps a level, not two
        done = subprocess.run(["ps", "-o", "ppid=,args=", "-p", str(pid)], capture_output=True, text=True, timeout=2)
        ppid, _, args = done.stdout.strip().partition(" ")
        if ppid.isdigit():
            _ppid_of[pid] = int(ppid)
        return args.split()
    except (OSError, subprocess.SubprocessError):
        return []


_ppid_of: dict[int, int] = {}


def parent_pid(pid: int) -> int:
    try:
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("PPid:"):
                return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    if pid in _ppid_of:
        return _ppid_of[pid]
    try:
        done = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, timeout=2)
        return int(done.stdout.strip() or 0)
    except (OSError, subprocess.SubprocessError, ValueError):
        return 0


def safe_reader(text: Any) -> str:
    """TEXT when it is a reader name of the safe shape (READER_SAFE), else ""."""
    return text if isinstance(text, str) and READER_SAFE.fullmatch(text) else ""


def command_tool(words: list[str]) -> str:
    """The tool a command line runs: its executable's base name, or, behind an interpreter or wrapper, the next word's
    (the script) when it is a path rather than a flag; "" when that is a wrapper too or not of the READER_NAME shape.
    Nothing else of the command line is looked at, so no argument (an inline TOKEN=..., a -c program) is ever kept."""
    for word in words[:2]:
        name = Path(word).name
        if word.startswith("-") or not READER_NAME.fullmatch(name):
            return ""
        if not READER_WRAPPERS.fullmatch(name):
            return name
    return ""


def checkout_name(cwd: str) -> str:
    """The checkout CWD is in: NAME of a .../checkouts/REPO/NAME path (`wt new`), "" when it is in none."""
    parts = Path(cwd).parts
    for i in range(len(parts) - 2):
        if parts[i] == "checkouts" and READER_NAME.fullmatch(parts[i + 2]):
            return parts[i + 2]
    return ""


def reader_agent(remote: bool) -> str:
    """The helper inside a session that reads: GLAEDA_GH_AGENT or CMUX_AGENT_NAME, else, for a subagent or a caller
    over reach (REMOTE), its checkout's name, else "helper" for a subagent; "" for the session itself."""
    named = next((os.environ[k].strip() for k in READER_AGENT_KEYS if os.environ.get(k, "").strip()), "")
    if READER_NAME.fullmatch(named):
        return named
    sub = os.environ.get("AI_AGENT", "").strip().endswith("_agent")
    if not (sub or remote):
        return ""
    try:
        where = checkout_name(os.getcwd())
    except OSError:
        where = ""
    return where or ("helper" if sub else "")


def reader_host() -> str:
    """The host a caller over reach runs on (CMUX_AGENT_HOST, when it is not this one), else ""."""
    host = os.environ.get("CMUX_AGENT_HOST", "").strip().lower()
    here = {socket.gethostname().split(".")[0].lower(), policy_host()}
    return host if READER_NAME.fullmatch(host) and host not in here else ""


def reader_name() -> str:
    """This process's reader: GLAEDA_GH_READER, else its agent session (session:NAME, HOST/session:NAME for a caller
    over reach), with the helper inside it (session:NAME:agent:ID, reader_agent), else the first tool up its process
    tree that is not a shell, interpreter or wrapper (tool:pr_owner.py), else, over ssh, tool:ssh-from-ADDRESS, else
    tool:unknown. Worked out once per process, and always of the READER_SAFE shape."""
    global _reader
    if _reader is None:
        named = safe_reader(os.environ.get("GLAEDA_GH_READER", "").strip())
        session = next((os.environ[k].strip() for k in READER_KEYS if os.environ.get(k, "").strip()), "")
        _reader = named
        if not _reader and READER_NAME.fullmatch(session):
            host = reader_host()
            agent = reader_agent(bool(host))
            _reader = safe_reader(f"{host + '/' if host else ''}session:{session}{':agent:' + agent if agent else ''}")
        pid = os.getppid()
        for _ in range(4 if not _reader else 0):
            tool = command_tool(parent_command(pid))
            if tool and tool not in ("sshd", "sshd-session"):
                _reader = f"tool:{tool}"
                break
            pid = parent_pid(pid)
            if pid <= 1:
                break
        if not _reader:
            client = os.environ.get("SSH_CLIENT", "").split()
            _reader = safe_reader(f"tool:ssh-from-{client[0]}") if client else ""
        _reader = _reader or "tool:unknown"
    return _reader


def readers_of(doc: dict, now: float) -> dict[str, float]:
    """A watch file's readers still within IDLE_EXPIRY."""
    got = doc.get("readers") if isinstance(doc.get("readers"), dict) else {}
    return {str(k): float(v) for k, v in got.items()
            if isinstance(v, (int, float)) and not isinstance(v, bool) and now - v < IDLE_EXPIRY}


def reader_fresh(doc: dict, reader: str, now: float) -> bool:
    """Whether READER is the watch's latest reader already, named within READER_REFRESH: writing it again would change
    nothing waiter_of decides. Another reader in between makes it stale at once, so a read is never charged to a
    reader that came and went (A, then B, then A again: A is the latest)."""
    at = doc.get("readerAt")
    return doc.get("reader") == reader and isinstance(at, (int, float)) and not isinstance(at, bool) \
        and 0 <= now - at < READER_REFRESH


def touch_interest(key: str) -> None:
    """A read the cache answered still counts as interest: the watch's mtime is its last read (the daemon's idle
    backoff and IDLE_EXPIRY go by it). Only an existing watch is touched, and a failure costs nothing. A touch
    that would change nothing (interest_fresh) is skipped. A reader the watch has not named lately is added
    (register), so the spend log can say who the watch is read for."""
    path = watch_dir() / file_name(key)
    try:
        doc = read_json(path)
        if isinstance(doc, dict) and doc.get("dormant"):
            return  # an answered one-off look: a cache answer does not make it a watch again (once_answered)
        if isinstance(doc, dict) and doc.get("key") == key and not reader_fresh(doc, reader_name(), time.time()):
            register(key)
            return
        if not interest_fresh(path, key):
            os.utime(path)
    except OSError:
        pass


def write_json(path: Path, doc: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{time.monotonic_ns()}.tmp")
    try:
        # Created 0600, then given the target's own mode: a replace with the umask's mode turned a 0600 file into
        # 0644 (leo-workspace#5398's BLOCK). A new file stays 0600.
        with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as handle:
            with contextlib.suppress(FileNotFoundError):
                os.fchmod(handle.fileno(), stat.S_IMODE(os.stat(path).st_mode))
            handle.write(json.dumps(doc, sort_keys=True) + "\n")
        os.replace(tmp, path)
    except BaseException:
        # A write cut off (a full disk, or a deadline's exception raised into it) left its empty temporary file behind
        # for good: huge-blue's cache held dozens of zero-byte .budget.json.*.tmp files, some days old (2026-11-11).
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def read_cache(key: str) -> dict | None:
    doc = read_json(cache_dir() / file_name(key))
    return doc if isinstance(doc, dict) and doc.get("key") == key else None


LOCK_WAIT = 2.0  # how long a read-modify-write waits for a sibling before giving up on the lock
LOCK_BUDGET = 2.0  # how long one gh call may spend waiting on all of these locks together
_lock_deadline: float | None = None


@contextlib.contextmanager
def lock_budget(seconds: float = LOCK_BUDGET):
    """Bound every bounded_lock inside this block to `seconds` *in total*.

    One brokered gh call takes three of these in sequence, so per-lock bounds multiplied: with all
    three held by a wedged sibling a call waited 6.16 s, measured. The waits are each individually
    reasonable and together are not, and what a caller cares about is when `gh` runs, which is one
    number. Nested blocks keep the tighter deadline; outside any block there is no budget, so the
    daemon's own use of these locks is unaffected."""
    global _lock_deadline
    previous = _lock_deadline
    _lock_deadline = time.monotonic() + seconds
    try:
        yield
    finally:
        _lock_deadline = previous


def extend_lock_budget(seconds: float) -> None:
    """Give the budget back time a deliberate wait spent. What it bounds is waiting on a sibling's
    lock; the repeat brake's 30 s is the broker working as intended, and spending the budget on it
    would leave the bookkeeping after it unlocked for no reason."""
    global _lock_deadline
    if _lock_deadline is not None:
        _lock_deadline += seconds


@contextlib.contextmanager
def bounded_lock(path: Path, seconds: float = LOCK_WAIT):
    """Hold `path` exclusively, or yield False after `seconds` rather than wait on it.

    These locks sit on the hot path of every `gh` call on the host, and what they protect is
    bookkeeping -- a repeat delay, a watch-promotion count, a registration. With LOCK_EX and no
    deadline, a single stuck holder was enough to stop `gh` running at all: with
    `.broker-seen.lock` held, `gh pr view 7 -R o/r --json state` was still blocked past a 20 s
    kill, never having reached the real gh. Everything else slow in this file is bounded
    (run_bounded, hard_deadline, DeadlineTimeout); these were the exception, in the one place
    whose contract is that it is never the reason a call fails."""
    try:
        handle = open(path, "a+")
    except OSError:
        yield False
        return
    held = False
    deadline = time.monotonic() + seconds
    if _lock_deadline is not None:
        deadline = min(deadline, _lock_deadline)
    try:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = True
                break
            except OSError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.02)
        yield held
    finally:
        with contextlib.suppress(OSError):
            if held:
                fcntl.flock(handle, fcntl.LOCK_UN)
            handle.close()


def register(key: str, jobs: bool = False, consumer: str | None = None, waited: bool = False,
             began: float | None = None, reader: str | None = None, at: dict | None = None, once: bool = False) -> None:
    """Record interest in `key`. Wanting jobs is sticky while any reader wants them. A head's readers
    are named consumers, each with the time it last asked. A wait marks the watch waitedAt: the daemon
    re-reads a waited run the controller may have lost the finish of (STALE_RUN_REREAD). A new wait passes its start
    (BEGAN, kept as waitBegan; a touch leaves it): the daemon makes one confirming read of a finished run for it.
    READER (default: this process's, reader_name) joins the watch's readers. AT (an upstream `read`, read_times) gives
    the downstream's own interest times, {"touched", "waitedAt", "asked"}: they stamp the watch, its wait and its
    consumer instead of now, so a downstream that polls the cache renews nothing past its own interest."""
    path = watch_dir() / file_name(key)
    watch_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    # read-modify-write: two sessions must not lose each other. Unheld, the write still happens --
    # losing a concurrent registration costs one watch, and waiting costs the gh call.
    with bounded_lock(watch_dir() / ".register.lock"):
        _register_locked(path, key, jobs, consumer, waited, began, reader, at or {}, once)


def stamp_at(now: float, given: Any, prior: Any = None) -> float:
    """A forwarded time (else now), never past now, and never older than PRIOR: interest only moves forward."""
    t = float(given) if isinstance(given, (int, float)) and not isinstance(given, bool) else now
    t = min(now, t)
    return max(t, float(prior)) if isinstance(prior, (int, float)) and not isinstance(prior, bool) else t


def _register_locked(path: Path, key: str, jobs: bool, consumer: str | None, waited: bool = False,
                     began: float | None = None, reader: str | None = None, at: dict | None = None,
                     once: bool = False) -> None:
    at = at or {}
    prior = read_json(path) or {}
    try:
        prior_mtime = path.stat().st_mtime if prior else None
    except OSError:
        prior_mtime = None
    doc: dict[str, Any] = {"key": key, "jobs": bool(jobs or prior.get("jobs"))}
    now = time.time()
    reader = safe_reader(reader) or reader_name()
    readers = readers_of(prior, now)
    if reader_fresh(prior, reader, now):
        doc["reader"], doc["readerAt"] = reader, prior["readerAt"]
    else:
        readers[reader] = now
        doc["reader"], doc["readerAt"] = reader, now
    doc["readers"] = readers
    if waited:
        doc["waitedAt"] = stamp_at(time.time(), at.get("waitedAt"), prior.get("waitedAt") if "waitedAt" in at else None)
    elif isinstance(prior.get("waitedAt"), (int, float)):
        doc["waitedAt"] = prior["waitedAt"]
    starts = [t for t in (began, prior.get("waitBegan")) if isinstance(t, (int, float)) and not isinstance(t, bool)]
    if starts:
        doc["waitBegan"] = max(starts)
    if consumer:
        asked = prior.get("consumers") if isinstance(prior.get("consumers"), dict) else {}
        now = time.time()
        stamp = stamp_at(now, at.get("asked"), asked.get(consumer) if "asked" in at else None)
        doc["consumers"] = {**{k: v for k, v in asked.items() if now - float(v or 0) < HEAD_INTEREST}, consumer: stamp}
    elif isinstance(prior.get("consumers"), dict):
        doc["consumers"] = prior["consumers"]
    # A one-off read's watch (ONCE: `status`) keeps when it was first asked for (since, Daemon.once_answered); asked
    # again ONCE_SPAN later it is a repeat reader's, and any other interest (a wait, the broker, a downstream, a
    # consumer) makes it an ordinary watch.
    if once and not prior:
        doc["since"] = time.time()
    elif once and isinstance(prior.get("since"), (int, float)) and not isinstance(prior.get("since"), bool):
        doc["since"] = prior["since"]
    if "touched" in at:
        # The downstream's own last interest, not this poll's: the watch (and IDLE_EXPIRY) ends when its does.
        touched = stamp_at(time.time(), at.get("touched"), prior_mtime)
        if doc != prior:
            write_json(path, doc)
        try:
            os.utime(path, (touched, touched))
        except OSError:
            pass
        return
    if doc == prior:
        # The same bytes again: the registration is only a read's interest, so refresh the mtime (or not even
        # that, interest_fresh) rather than replace the file through a temporary one.
        try:
            if not interest_fresh(path, key):
                os.utime(path)
            return
        except OSError:
            pass
    write_json(path, doc)


def terminal(kind: str, data: dict | None) -> bool:
    """Merged or closed PRs and completed runs; a comment watch never is (a reply can always come)."""
    if not data or kind == "comment":
        return False
    if kind == "head":
        return bool(data.get("settled"))
    return data.get("state") in {"MERGED", "CLOSED"} if kind == "pr" else data.get("status") == "completed"


def iso_epoch(text: str | None) -> float | None:
    try:
        return dt.datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def quick(started: str | None, completed: str | None) -> bool:
    """Finished within REFUSAL_SECONDS of starting: a job-start refusal, not a job that ran."""
    start, end = iso_epoch(started), iso_epoch(completed)
    return start is not None and end is not None and end - start <= REFUSAL_SECONDS


# ---------------------------------------------------------------- GitHub transport


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """urllib would copy the Authorization header to wherever a redirect points; refuse them all."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: ANN001
        return None


OPENER = urllib.request.build_opener(NoRedirect)


# api.github.com edges. On 2026-11-17 from 22:40Z one host resolved api.github.com only to one edge (from 8.8.8.8
# and the host's VPN resolver alike); from there it dropped most SYNs and answered the rest with a 403 that carried no
# rate-limit headers, while GitHub's other edges answered every call. With SOCKET_TIMEOUT's 20 s per connect every read
# failed (URLError) and a tick's reads queued behind each other. Now each connect and TLS handshake to api.github.com
# gets EDGE_CONNECT_TIMEOUT, and a dead edge (a timeout, a failed connect, or the bare 403 edge_refused names) gets one
# retry on another edge address, from a second resolver (DNS over HTTPS) since the system one named only the dead edge.
# No address is written here, and TLS still checks api.github.com's certificate, so a wrong address can only fail. The
# gh-quota shim gives every gh call the same (leo-workspace tools/gh_edge.py); this daemon talks to GitHub itself.
EDGE_HOSTS = {"api.github.com"}
EDGE_CONNECT_TIMEOUT = 3.0
EDGE_BAD_TTL = 600.0
EDGE_DOH_TTL = 300.0
EDGE_DOH_DEFAULT = "https://dns.google/resolve,https://cloudflare-dns.com/dns-query"


def edge_refused(status: int, headers: dict) -> bool:
    """A 403 the edge made, not GitHub's API: no X-RateLimit-* header and no Retry-After. GitHub's own 403s (a rate
    limit, a permission) carry the rate-limit headers and reach the caller as before."""
    if status != 403:
        return False
    return not any(k.lower().startswith("x-ratelimit-") or k.lower() == "retry-after" for k in headers)


class EdgeFailed(OSError):
    def __init__(self, why: str):
        super().__init__(why)
        self.why = why


class Edges:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.reset()

    def reset(self) -> None:
        self.bad: dict[str, float] = {}
        self.doh_cache: tuple[float, list[str]] = (float("-inf"), [])
        self.local = threading.local()

    def is_bad(self, ip: str) -> bool:
        return self.bad.get(ip, 0) > time.time()

    def mark_bad(self, ip: str) -> None:
        with self.lock:
            now = time.time()
            self.bad = {k: v for k, v in self.bad.items() if v > now}
            self.bad[ip] = now + EDGE_BAD_TTL

    def last_ip(self) -> str | None:
        return getattr(self.local, "ip", None)

    @staticmethod
    def resolve(host: str) -> list[str]:
        override = os.environ.get("GLAEDA_EDGE_TEST_RESOLVE", "")
        if override.startswith(host + "="):
            return [ip for ip in override.split("=", 1)[1].split(",") if ip]
        try:
            infos = socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
        except DeadlineTimeout:  # http()'s alarm is one-shot: swallowed here, the rest of the request has no deadline
            raise
        except OSError:
            return []
        return list(dict.fromkeys(info[4][0] for info in infos))

    def doh(self, host: str) -> list[str]:
        """A second resolver's addresses for HOST: DNS over HTTPS (JSON), each provider in GLAEDA_EDGE_DOH in turn."""
        at, ips = self.doh_cache
        if at + EDGE_DOH_TTL > time.time():
            return ips
        plain = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        out: list[str] = []
        for url in (os.environ.get("GLAEDA_EDGE_DOH") or EDGE_DOH_DEFAULT).split(","):
            url = url.strip()
            for rtype in ("A", "AAAA"):
                if not url:
                    break
                query = url + ("&" if "?" in url else "?") + urllib.parse.urlencode({"name": host, "type": rtype})
                try:
                    with plain.open(urllib.request.Request(query, headers={"Accept": "application/dns-json"}),
                                    timeout=2) as answer:
                        records = json.loads(answer.read(65536)).get("Answer") or []
                except DeadlineTimeout:
                    raise
                except (OSError, HTTPException, ValueError, AttributeError):
                    continue
                for record in records:
                    data = record.get("data") if isinstance(record, dict) else None
                    if isinstance(record, dict) and record.get("type") in (1, 28) and isinstance(data, str):
                        try:
                            ipaddress.ip_address(data)
                        except ValueError:
                            continue
                        if data not in out:
                            out.append(data)
            if out:
                break
        self.doh_cache = (time.time(), out)
        return out

    @staticmethod
    def attempt(ip: str, port: int, host: str, context: ssl.SSLContext, timeout: float):
        try:
            raw = socket.create_connection((ip, port), timeout=EDGE_CONNECT_TIMEOUT)
        except DeadlineTimeout:  # the request's hard deadline (a TimeoutError): not a dead edge, and not to be retried
            raise
        except TimeoutError:
            raise EdgeFailed("connect-timeout") from None
        except OSError:
            raise EdgeFailed("connect-failed") from None
        try:
            tls = context.wrap_socket(raw, server_hostname=host)
        except DeadlineTimeout:
            raw.close()
            raise
        except TimeoutError:
            raw.close()
            raise EdgeFailed("tls-timeout") from None
        except ssl.SSLCertVerificationError:
            raw.close()
            raise  # this host's trust store, not the edge: no verdict, the request fails as it did before
        except OSError:
            raw.close()
            raise EdgeFailed("tls-failed") from None
        tls.settimeout(timeout)
        return tls

    def candidates(self, host: str, tried: set[str]) -> list[str]:
        """Edges to retry on: the system resolver's other addresses, then the second resolver's, none marked bad."""
        out: list[str] = []
        for ip in self.resolve(host) + self.doh(host):
            if ip not in tried and ip not in out and not self.is_bad(ip):
                out.append(ip)
        return out

    def connect(self, host: str, context: ssl.SSLContext, timeout: float):
        """A TLS connection to an edge for HOST: the first try, then at most one retry on another edge."""
        port = int(os.environ.get("GLAEDA_EDGE_TEST_PORT") or 443)
        primary = self.resolve(host)
        first = next((ip for ip in primary if not self.is_bad(ip)), None)
        if first is None:
            alts = self.candidates(host, set(primary))
            if alts:  # every resolved edge failed lately: another one, the retry spent on it
                return self.second(host, port, context, timeout, None, "all-marked-bad", alts[0])
            # None known: the resolver's own first answer once more (a blip must not lock reads out for EDGE_BAD_TTL).
            first = primary[0] if primary else None
            if first is None:
                raise EdgeFailed(f"{host} resolves to nothing")
        try:
            sock = self.attempt(first, port, host, context, timeout)
            self.local.ip = first
            return sock
        except EdgeFailed as error:
            self.mark_bad(first)
            alts = self.candidates(host, {first})
            if not alts:
                log({"event": "edge-retry", "host": host, "from": first, "to": None, "why": error.why, "ok": False})
                raise
            return self.second(host, port, context, timeout, first, error.why, alts[0])

    def second(self, host: str, port: int, context: ssl.SSLContext, timeout: float, frm: str | None, why: str,
               to: str):
        try:
            sock = self.attempt(to, port, host, context, timeout)
        except EdgeFailed as error:
            self.mark_bad(to)
            log({"event": "edge-retry", "host": host, "from": frm, "to": to, "why": why, "ok": False, "why2": error.why})
            raise
        if frm is not None:  # a known-bad first edge skipped is no retry
            log({"event": "edge-retry", "host": host, "from": frm, "to": to, "why": why, "ok": True})
        self.local.ip = to
        return sock


EDGE = Edges()


class EdgeHTTPSConnection(http_client.HTTPSConnection):

    def connect(self) -> None:
        if self._tunnel_host or self.host not in EDGE_HOSTS:  # through a proxy, or another host: as before
            super().connect()
            return
        self.sock = EDGE.connect(self.host, self._context, self.timeout)


class EdgeHTTPSHandler(urllib.request.HTTPSHandler):
    def https_open(self, req):  # noqa: ANN001
        return self.do_open(EdgeHTTPSConnection, req)


GITHUB_OPENER = urllib.request.build_opener(NoRedirect, EdgeHTTPSHandler)


# The controller's own opener: urllib's one `timeout` is the socket timeout for the connect and for every read
# alike, which is what conflated "the controller is not there" with "the controller is slow right now"
# (CONTROLLER_CONNECT_TIMEOUT). Here the request carries the read deadline and the connect takes
# CONTROLLER_CONNECT_DEADLINE's value instead, so an unreachable controller still fails fast while an answer
# already coming in is waited for. The deadline travels in a thread-local because urllib has nowhere else to put
# it: it is per request (a tick's budget cuts it), and http.client is per thread anyway.
CONTROLLER_CONNECT_DEADLINE = threading.local()


class ControllerConnect:
    """A connect deadline of its own; the request's timeout then covers the reads."""

    def connect(self) -> None:
        read = self.timeout  # type: ignore[attr-defined]
        self.timeout = getattr(CONTROLLER_CONNECT_DEADLINE, "seconds", None) or CONTROLLER_CONNECT_TIMEOUT
        try:
            super().connect()  # type: ignore[misc]
        finally:
            self.timeout = read
        with contextlib.suppress(OSError, AttributeError):
            self.sock.settimeout(read)  # type: ignore[attr-defined]


class ControllerHTTPConnection(ControllerConnect, http_client.HTTPConnection):
    pass


class ControllerHTTPSConnection(ControllerConnect, http_client.HTTPSConnection):
    pass


class ControllerHTTPHandler(urllib.request.HTTPHandler):
    def http_open(self, req):  # noqa: ANN001
        return self.do_open(ControllerHTTPConnection, req)


class ControllerHTTPSHandler(urllib.request.HTTPSHandler):
    def https_open(self, req):  # noqa: ANN001
        return self.do_open(ControllerHTTPSConnection, req, context=self._context)


CONTROLLER_OPENER = urllib.request.build_opener(NoRedirect, ControllerHTTPHandler, ControllerHTTPSHandler)


def error_site(error: BaseException) -> str:
    """Where `error` was raised: file, line and function only, never values, so a recurring error
    can be found without reproducing it."""
    frames = traceback.extract_tb(error.__traceback__)
    return f"{Path(frames[-1].filename).name}:{frames[-1].lineno} {frames[-1].name}" if frames else ""


def describe(error: BaseException) -> str:
    """Our own messages are safe to show; anything else is reduced to its type name."""
    return str(error) if isinstance(error, WatchError) else type(error).__name__


def describe_at(error: BaseException) -> str:
    """describe(), and for anything not our own message where it was raised (error_site): values never, the site always."""
    site = "" if isinstance(error, WatchError) else error_site(error)
    return f"{describe(error)} at {site}" if site else describe(error)


class DeadlineTimeout(TimeoutError):
    """A hard deadline passed (hard_deadline). A TimeoutError, so callers treat it as a slow answer."""


class ScanDeadline(Exception):
    """A hard deadline passed in a block whose own frames catch OSError (broker_local_repos's scan).

    Deliberately not a TimeoutError, because TimeoutError *is* an OSError: raised from SIGALRM into
    the scan, DeadlineTimeout landed in `except OSError: continue` around the glob and in
    git_config_text's `except (OSError, ValueError): return None`, which read it as "no config
    here" -- and setitimer is one-shot, so the rest of the scan then ran with no deadline at all.
    Measured with `.git/config` a FIFO nobody writes to, which is the hung-mount case the deadline
    was added for: git_config_text returned None 0.30s after the alarm, and a 20 000-checkout scan
    under a 0.05s deadline took 0.76s, silently dropped the one checkout whose read the alarm
    interrupted, and cached that incomplete map as complete for the whole TTL."""


@contextlib.contextmanager
def hard_deadline(seconds: float, error: type[BaseException] = DeadlineTimeout):
    """Raise `error` in the block once `seconds` of wall-clock time pass, even in the middle of a
    blocking read: a socket timeout only bounds each read, so a server that trickles bytes never
    trips it. Uses SIGALRM, so only on the main thread (the daemon's loop); elsewhere it does
    nothing and the watchdog still applies.

    `error` is a parameter because the exception has to be one the block's own handlers do not
    catch; see ScanDeadline."""
    if threading.current_thread() is not threading.main_thread() or not hasattr(signal, "setitimer"):
        yield
        return

    def expire(signum: int, frame: Any) -> None:
        raise error(f"no complete answer within {seconds:g}s")

    previous = signal.signal(signal.SIGALRM, expire)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


# Kept-alive connections. Every request used to open its own TCP and TLS connection (urllib's opener closes it after
# one answer). huge-blue, 2026-11-20 20:0xZ: from there about two connects in five to api.github.com lost their SYN
# (a 7 s connect, or EDGE_CONNECT_TIMEOUT and a retry on another edge; 498 edge-retry lines in the log's tail, 287 with
# no edge left), so the daemon's REST reads averaged 4.3 s each (626 s of GitHub time for 146 requests in ten minutes)
# while a request on an open connection took 0.2-0.5 s, and its ticks spent ~600 s per 600 s in "read rest". Now each
# thread keeps one connection to api.github.com open for the next read (KEPT). Only reads ride it: a GET, or a
# GraphQL query that is not a mutation, and only those are sent again, once, on a new connection when a kept one
# turns out closed (GitHub closes idle ones; nothing was answered). A write (the outbox's POSTs, DELETEs, mutations)
# opens its own connection as before, so a write is never sent twice. A connection idle past KEEPALIVE_IDLE is closed
# rather than reused: a NAT or firewall may have dropped it, and a read on a dead one waits SOCKET_TIMEOUT.
KEEPALIVE_IDLE = 20.0
KEEPALIVE_RETRY = (http_client.RemoteDisconnected, http_client.BadStatusLine, http_client.CannotSendRequest,
                   ConnectionResetError, ConnectionAbortedError, BrokenPipeError,
                   ssl.SSLEOFError, ssl.SSLZeroReturnError)
GRAPHQL_MUTATION = re.compile(rb'"query"\s*:\s*"\s*mutation\b')


class KeptConnections:
    """One kept-alive connection to api.github.com per thread (http.client is not thread-safe)."""

    def __init__(self) -> None:
        self.local = threading.local()
        self.opened = 0  # connections opened, for tests and benchmarks

    def drop(self) -> None:
        held = getattr(self.local, "conn", None)
        self.local.conn = None
        if held is not None:
            with contextlib.suppress(Exception):
                held[0].close()

    def take(self, host: str) -> tuple[http_client.HTTPSConnection, bool]:
        """(a connection, whether it was kept from an earlier request)."""
        held = getattr(self.local, "conn", None)
        if held is not None and held[1] == host and time.monotonic() - held[2] < KEEPALIVE_IDLE:
            return held[0], True
        self.drop()
        self.opened += 1
        return EdgeHTTPSConnection(host, timeout=SOCKET_TIMEOUT), False

    def request(self, method: str, url: str, headers: dict[str, str], body: bytes | None) -> tuple[int, dict, bytes]:
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname or ""
        target = parts.path + (f"?{parts.query}" if parts.query else "")
        while True:
            conn, kept = self.take(host)
            self.local.conn = None  # held by this request only; given back below once its answer is whole
            try:
                if kept:
                    EDGE.local.ip = getattr(conn, "edge_ip", None)
                conn.request(method, target, body=body, headers=headers)
                response = conn.getresponse()
                data = response.read(MAX_BODY)
                whole = response.isclosed() or not response.read(1)
            except KEEPALIVE_RETRY:
                with contextlib.suppress(Exception):
                    conn.close()
                if kept:
                    continue  # the kept connection was closed under it: nothing was answered, a new one reads it
                raise
            except BaseException:
                with contextlib.suppress(Exception):
                    conn.close()
                raise
            if not kept:
                conn.edge_ip = EDGE.last_ip()
            if whole and not response.will_close:
                self.local.conn = (conn, host, time.monotonic())
            else:
                conn.close()
            return response.status, {k.lower(): v for k, v in response.headers.items()}, data


KEPT = KeptConnections()


def keepalive_ok(method: str, url: str, body: bytes | None) -> bool:
    """Whether this request may ride a kept connection, and be sent again on a new one (KEPT): a read to api.github.com
    with no proxy in the way."""
    host = urllib.parse.urlsplit(url).hostname or ""
    if host not in EDGE_HOSTS:
        return False
    proxies = urllib.request.getproxies()
    if (proxies.get("https") or proxies.get("all")) and not urllib.request.proxy_bypass(host):
        return False  # through a proxy: urllib's opener, as before
    if method == "GET":
        return True
    return method == "POST" and url == API + "/graphql" and not GRAPHQL_MUTATION.search(body or b"")


def http(method: str, url: str, headers: dict[str, str], body: bytes | None = None) -> tuple[int, dict, bytes]:
    if not url.startswith(API + "/"):
        raise WatchError("refusing a request outside api.github.com")
    request = urllib.request.Request(url, data=body, method=method, headers=headers)
    kept = keepalive_ok(method, url, body)

    def once() -> tuple[int, dict, bytes]:
        if kept:
            return KEPT.request(method, url, headers, body)
        try:
            with GITHUB_OPENER.open(request, timeout=SOCKET_TIMEOUT) as response:
                return response.status, {k.lower(): v for k, v in response.headers.items()}, response.read(MAX_BODY)
        except urllib.error.HTTPError as error:  # 304, refused redirects and every 4xx/5xx land here
            return error.code, {k.lower(): v for k, v in (error.headers or {}).items()}, error.read(MAX_BODY)

    try:
        with hard_deadline(HTTP_DEADLINE):
            EDGE.local.ip = None
            answer = once()
            edge = EDGE.last_ip()
            if edge is not None and edge_refused(answer[0], answer[1]):
                # The edge's own 403 (no rate-limit headers): GitHub never saw the request. Once more, elsewhere.
                # With no other edge known, the edge's 403 is the answer, as before.
                EDGE.mark_bad(edge)
                KEPT.drop()  # kept to the refusing edge: the retry dials another
                if EDGE.candidates(urllib.parse.urlsplit(url).hostname or "", {edge}):
                    EDGE.local.ip = None
                    try:
                        answer = once()
                    finally:
                        log({"event": "edge-retry", "host": urllib.parse.urlsplit(url).hostname, "from": edge,
                             "to": EDGE.last_ip(), "why": "edge-403", "ok": EDGE.last_ip() is not None})
            return answer
    except (OSError, HTTPException, ValueError) as error:  # DeadlineTimeout is a TimeoutError, an OSError
        raise WatchError(f"request failed: {type(error).__name__}") from None


# ---------------------------------------------------------------- GraphQL slots (one host, one login)
#
# At most graphql_slots() GraphQL requests in flight per login on this host, whoever sends them: the daemon's refreshes
# and a wait's direct read (Daemon.request) and every `glaeda-gh gh` read that reaches GitHub over GraphQL (the broker,
# around the real gh). One flock'd file per slot under BASE/graphql-slots, so the bound holds across processes and a
# holder that dies frees its slot with its last descriptor. hq#13031 (2026-11-17): the login's GraphQL hour drained at
# ~7800 points/h against 5000; on one host a 7-way parallel fan-out of `glaeda-gh gh api graphql` open-PR reads spent
# ~45 calls in 3 min, every process its own GitHub request at once.
GRAPHQL_SLOTS_DEFAULT = 2  # gh-quota.json login_concurrency, else this; GLAEDA_GH_GRAPHQL_SLOTS overrides both
GRAPHQL_SLOT_WAIT = 120.0  # the longest a `glaeda-gh gh` read waits for a slot; past it, it runs (logged: overflow.log)
GRAPHQL_SLOT_POLL = 0.02
GRAPHQL_SLOT_ENV = "GLAEDA_GH_GRAPHQL_SLOT"  # set for gh run under a held slot: a gh call nested in it uses its parent's
GRAPHQL_SLOT_DIR = "graphql-slots"
# gh subcommands that read over GraphQL (gh's own client); `api graphql` is the rest. --watch and --web stay out: one
# holds for as long as the watch lasts, the other sends nothing worth a slot.
GH_GRAPHQL_READS = {("pr", "view"), ("pr", "list"), ("pr", "status"), ("pr", "checks"), ("issue", "view"),
                    ("issue", "list"), ("issue", "status"), ("repo", "view"), ("repo", "list")}


def graphql_slots() -> int:
    """How many GraphQL requests one login may have in flight on this host (at least 1)."""
    raw: Any = os.environ.get("GLAEDA_GH_GRAPHQL_SLOTS")
    if raw is None:
        doc = read_json(Path(os.environ.get("GLAEDA_GH_QUOTA_POLICY")
                             or Path(SPENDERS_CMD).resolve().parent.parent / "machines/gh-quota.json"))
        raw = doc.get("login_concurrency") if isinstance(doc, dict) else None
    try:
        value = int(float(raw)) if raw is not None and not isinstance(raw, bool) else GRAPHQL_SLOTS_DEFAULT
    except (TypeError, ValueError):
        value = GRAPHQL_SLOTS_DEFAULT
    return max(1, min(value, 64)) if value > 0 else GRAPHQL_SLOTS_DEFAULT


def graphql_login() -> str:
    """The github.com login gh's hosts.yml names (the slots are per login), else "default". Never raises."""
    try:
        path = gh_hosts_file()
        text = path.read_text() if path is not None else ""
    except (OSError, UnicodeDecodeError):
        text = ""
    found = re.search(r"^github\.com:[ \t]*\n(?:[ \t]+.*\n|[ \t]*\n)*?[ \t]+user:[ \t]*['\"]?([A-Za-z0-9-]{1,39})",
                      text, re.M)
    return found.group(1) if found else "default"


def graphql_slot_wanted(want: Path) -> bool:
    """Whether a priority taker (the daemon) waits for a slot now: its want mark is GRAPHQL_SLOT_WANT_FRESH fresh."""
    try:
        return 0 <= time.time() - want.stat().st_mtime < GRAPHQL_SLOT_WANT_FRESH
    except OSError:
        return False


# id(handle) -> {"handle": a weak reference (a holder that drops its handle unreleased frees the slot as before, when
# the file is collected), "slot", "thread", "what", "since"}
_SLOT_HOLDERS: dict[int, dict[str, Any]] = {}
_SLOT_HOLDERS_LOCK = threading.Lock()


def _slot_gone(h: dict[str, Any]) -> bool:
    handle = h["handle"]()
    return handle is None or handle.closed


def graphql_slot_flight(handle: Any, on: bool) -> None:
    """Mark the slot HANDLE holds as carrying a request on the wire (ON) or not: graphql_slot_reap never frees one in
    flight. Review of glaeda#2189 (F3): a land worker's thread has no SIGALRM deadline, so its request can outlive
    GRAPHQL_SLOT_HOLD_MAX, and the reap closed its slot under it while a second request took the slot."""
    with _SLOT_HOLDERS_LOCK:
        h = _SLOT_HOLDERS.get(id(handle))
        if h is not None:
            h["flight"] = on


def graphql_slot_release(handle: Any) -> None:
    """Give back a slot graphql_slot_take handed out (closing its file frees the lock). Never raises."""
    with _SLOT_HOLDERS_LOCK:
        _SLOT_HOLDERS.pop(id(handle), None)
    with contextlib.suppress(OSError, ValueError):
        handle.close()


def graphql_slot_holders(now: float | None = None) -> list[dict[str, Any]]:
    """The slots this process holds: {"slot", "thread", "what", "heldS"}, longest first."""
    now = time.monotonic() if now is None else now
    with _SLOT_HOLDERS_LOCK:
        for k in [k for k, h in _SLOT_HOLDERS.items() if _slot_gone(h)]:  # closed or dropped without release
            _SLOT_HOLDERS.pop(k, None)
        rows = [{"slot": h["slot"], "thread": h["thread"], "what": h["what"], "heldS": round(now - h["since"], 1)}
                for h in _SLOT_HOLDERS.values()]
    return sorted(rows, key=lambda r: -r["heldS"])


def graphql_slot_reap(bound: float = GRAPHQL_SLOT_HOLD_MAX, now: float | None = None,
                      flight_bound: float = GRAPHQL_SLOT_FLIGHT_MAX) -> list[dict[str, Any]]:
    """Free every slot this process has held past BOUND (GRAPHQL_SLOT_HOLD_MAX) with no request on the wire
    (graphql_slot_flight), or past FLIGHT_BOUND with one: its file is closed, so the lock goes and the next taker (the
    daemon's pr batch) gets it. The holder's own release later is a no-op. Returns who held each: {"slot", "thread",
    "what", "heldS", "inFlight"}."""
    now = time.monotonic() if now is None else now
    with _SLOT_HOLDERS_LOCK:
        for k in [k for k, h in _SLOT_HOLDERS.items() if _slot_gone(h)]:  # closed or dropped without release
            _SLOT_HOLDERS.pop(k, None)
        stale = [(k, h) for k, h in _SLOT_HOLDERS.items()
                 if now - h["since"] > (flight_bound if h.get("flight") else bound)]
        for k, _ in stale:
            _SLOT_HOLDERS.pop(k, None)
    out = []
    for _, h in stale:
        handle = h["handle"]()
        if handle is None:
            continue
        with contextlib.suppress(OSError, ValueError):
            handle.close()
        out.append({"slot": h["slot"], "thread": h["thread"], "what": h["what"], "heldS": round(now - h["since"], 1),
                    "inFlight": bool(h.get("flight"))})
    return out


def graphql_slot_take(deadline: float | None, priority: bool = False, what: str = "") -> tuple[Any, int] | None:
    """A held GraphQL slot (its open file, its index) for this login on this host, waiting until DEADLINE
    (time.monotonic()); None once it passes with every slot held. None deadline: try once. WHAT names the holder
    (graphql_slot_holders, graphql_slot_reap). PRIORITY (the daemon's
    reads) marks the wait (GRAPHQL_SLOT_WANT_FRESH): while the mark is fresh no other taker takes a free slot, so the
    daemon is never starved by the broker's `gh` reads polling the same locks."""
    d = BASE / GRAPHQL_SLOT_DIR
    try:
        d.mkdir(parents=True, exist_ok=True, mode=0o700)
    except OSError:
        return None
    login, k = graphql_login(), graphql_slots()
    want = d / f"{login}.want"
    touched = float("-inf")
    try:
        while True:
            if priority or not graphql_slot_wanted(want):
                for i in range(k):
                    try:
                        handle = open(d / f"{login}.{i}.lock", "a+")
                    except OSError:
                        continue
                    try:
                        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except OSError:
                        handle.close()
                        continue
                    with _SLOT_HOLDERS_LOCK:
                        _SLOT_HOLDERS[id(handle)] = {"handle": weakref.ref(handle), "slot": i, "what": what or "?",
                                                     "thread": threading.current_thread().name,
                                                     "since": time.monotonic()}
                    return handle, i
            if deadline is None or time.monotonic() >= deadline:
                return None
            if priority and time.monotonic() - touched >= GRAPHQL_SLOT_WANT_TOUCH:
                touched = time.monotonic()
                with contextlib.suppress(OSError):
                    want.touch()
            time.sleep(GRAPHQL_SLOT_POLL)
    finally:
        if priority and touched > float("-inf"):
            with contextlib.suppress(OSError):
                want.unlink()


def graphql_slot_overflow(what: str, waited: float) -> None:
    """A CLI read that ran without a slot after GRAPHQL_SLOT_WAIT: one line in BASE/graphql-slots/overflow.log."""
    with contextlib.suppress(OSError):
        with open(BASE / GRAPHQL_SLOT_DIR / "overflow.log", "a") as out:
            out.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} pid={os.getpid()} "
                      f"waited={waited:.0f}s {what[:120]}\n")


def gh_graphql_read(args: list[str]) -> bool:
    """Whether `gh ARGS` is a read gh sends over GraphQL (a slot's worth). Never raises."""
    try:
        words, method, seen, _values = broker_words(args)
        if words[:2] == ["api", "graphql"]:
            return not gh_cache_is_write(args, words, method)
        return tuple(words[:2]) in GH_GRAPHQL_READS and not seen & {"--watch", "--web"}
    except Exception:  # noqa: BLE001  a lookup in front of a gh call
        return False


def gh_graphql_slot_for(args: list[str]) -> Any:
    """For the broker: a held slot's open file when `gh ARGS` is a GraphQL read that needs one, else None (not a
    GraphQL read, a gh call nested under a slot its parent holds, or GRAPHQL_SLOT_WAIT passed: logged)."""
    if not gh_graphql_read(args):
        return None
    holder = os.environ.get(GRAPHQL_SLOT_ENV, "")
    if holder.isdigit() and int(holder) > 1:
        with contextlib.suppress(OSError):
            os.kill(int(holder), 0)  # the holder still runs: this call is nested inside its slot
            return None
    start = time.monotonic()
    got = graphql_slot_take(start + GRAPHQL_SLOT_WAIT, what="gh " + " ".join(args[:2]))
    if got is None:
        graphql_slot_overflow(" ".join(args[:3]), time.monotonic() - start)
        return None
    return got[0]


def run_bounded(argv: list[str], timeout: float | None = None, input_text: str | None = None,
                env: dict | None = None) -> subprocess.CompletedProcess:
    """subprocess.run(capture_output=True, text=True) with a deadline that holds. On a timeout run()
    kills only the child and then waits for its pipes, which a grandchild that inherited them keeps
    open for as long as it lives. Here the child leads its own process group and the whole group is
    killed. Raises subprocess.TimeoutExpired or OSError."""
    timeout = SUBPROCESS_DEADLINE if timeout is None else timeout
    with subprocess.Popen(argv, stdin=subprocess.DEVNULL if input_text is None else subprocess.PIPE, env=env,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True) as proc:
        try:
            out, err = proc.communicate(input=input_text, timeout=timeout)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, signal.SIGKILL)
            with contextlib.suppress(OSError):  # a child that left its group; Popen.__exit__ waits for it
                proc.kill()
            with contextlib.suppress(subprocess.TimeoutExpired, OSError, ValueError):
                proc.communicate(timeout=2)
            for stream in (proc.stdout, proc.stderr):  # a grandchild that left the group still holds them
                with contextlib.suppress(OSError):
                    stream.close()
            raise subprocess.TimeoutExpired(argv, timeout) from None
    return subprocess.CompletedProcess(argv, proc.returncode, out, err)


def internal_env() -> dict:
    """This process's environment plus GLAEDA_GH_INTERNAL: for this daemon's own `glaeda-gh gh api` reads, which
    are piped through the broker on purpose (the answer cache shares them) and keep the route they have today
    rather than being handed to the host's quota guard as a person's call is (see broker_guard_comes_back)."""
    return {**os.environ, GLAEDA_INTERNAL: "1"}


def retry_after_seconds(value: Any) -> float | None:
    """A Retry-After header as seconds, at most PACE_HOLD_MAX, or None when it says no usable number. float() takes
    "inf", "nan" and "1e12": an infinite hold overflowed every int() after it (the queued write was dropped as a bad
    entry), and a huge finite one held the outbox, and was reported to every writer on the login, for years."""
    try:
        seconds = float(value) if value else None
    except (TypeError, ValueError):
        return None
    if seconds is None or math.isnan(seconds) or seconds == -math.inf:
        return None
    return max(0.0, min(seconds, float(PACE_HOLD_MAX)))


def saved_hold(value: Any, now: float) -> float:
    """A hold read back from disk (daemon.json's outbox.holdUntil) as epoch seconds, at most PACE_HOLD_MAX past `now`
    as every other hold, or 0.0 (none) for anything that is not a finite number: a corrupt far future held the outbox
    for good, and a string, a list or an int too large for a float raised in Daemon() and stopped the daemon starting."""
    if isinstance(value, bool) or not isinstance(value, (int, float, str)):
        return 0.0
    try:
        until = float(value)
    except (ValueError, OverflowError):
        if isinstance(value, str) or value < 0:
            return 0.0  # an int past a float's range below zero: the far past, no hold
        return now + PACE_HOLD_MAX  # and above: the far future
    if not math.isfinite(until):
        return 0.0
    return max(0.0, min(until, now + PACE_HOLD_MAX))


# What the keeper says when it fails reaches daemon.json (outbox.pause.lastError) and the log: anything shaped like a
# credential is dropped first, then the text is cut to KEEPER_TEXT_MAX.
KEEPER_TEXT_MAX = 200
KEEPER_SECRET_RE = re.compile(
    r"gh[posur]_[A-Za-z0-9_]{8,}|github_pat_[A-Za-z0-9_]{8,}"  # GitHub's token shapes, even cut short
    r"|\b(?:bearer|token|basic)\s+\S+"  # an Authorization header's value
    r"|\b[0-9a-f]{32,}\b"  # a long hex run
    r"|[A-Za-z0-9+/_-]{32,}={0,2}",  # a long base64 run
    re.IGNORECASE)


def keeper_text(text: str) -> str:
    """The keeper's own words, safe to store and log: credential-shaped runs redacted, at most KEEPER_TEXT_MAX
    characters. Redacted before the cut, so a token the cut would split is never half kept."""
    return KEEPER_SECRET_RE.sub("[redacted]", text)[:KEEPER_TEXT_MAX]


_CONTENT_PAUSE_UNREAD: set[str] = set()  # CONTENT_PAUSE_ENV values already logged as unreadable


def content_pause_cmd() -> list[str] | None:
    """The command that reads and extends the login's create pause (CONTENT_PAUSE_ENV), or None: none on this host.
    A setting shlex cannot read (an unclosed quote) is no command, logged once: raising here stopped every outbox
    pass."""
    named = os.environ.get(CONTENT_PAUSE_ENV)
    if named is not None:
        try:
            return shlex.split(named) or None
        except ValueError as error:
            if named not in _CONTENT_PAUSE_UNREAD:
                _CONTENT_PAUSE_UNREAD.add(named)
                log({"event": "content-pause-cmd",
                     "error": f"{CONTENT_PAUSE_ENV} unreadable ({error}): no pause asked"})
            return None
    with contextlib.suppress(OSError):
        cli = PACE_CLI.resolve().parent / "gh_quota.py"
        if cli.is_file():
            return [sys.executable, "-I", os.fspath(cli)]
    for name in CONTENT_PAUSE_NAMES:
        found = shutil.which(name)
        if found:
            return [found]
    return None


def find_gh() -> str | None:
    """gh on PATH, else where Homebrew and distributions put it: a LaunchAgent's PATH is minimal."""
    for candidate in (shutil.which("gh"), os.fspath(Path.home() / ".local/bin/gh"), "/opt/homebrew/bin/gh",
                      "/usr/local/bin/gh", "/usr/bin/gh"):
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


def gh_token() -> str:
    gh = find_gh()
    if gh is None:
        raise WatchError("gh not found")
    try:
        # gh-auth-token-lint: allow authored-write: direct writes need the host login identity.
        result = run_bounded([gh, "auth", "token", "--hostname", "github.com"])
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WatchError(f"gh auth token: {type(error).__name__}") from None
    token = result.stdout.strip()
    if result.returncode != 0 or not token:  # neither stream is repeated: stdout may be a token
        raise WatchError(f"gh auth token exited {result.returncode}; is gh signed in?")
    if not TOKEN_RE.fullmatch(token):
        raise WatchError("gh auth token printed something that is not a GitHub token")
    return token


# ---------------------------------------------------------------- the ci-watch App pool (reads off the login)

# Leo, 2026-11-18: "you use the apps where they're useful, and it just does it automatically, so no agents necessarily
# even have to think about it." leo-workspace machines/gh-app-roles.json gives glaeda-gh to the ci-watch role, but that
# routing lives in the gh-quota shim (tools/gh_app_token.py route), and this daemon talks to GitHub itself with
# `gh auth token`, so all its reads (about 295 REST an hour on one host that day) stayed on the account's login.
# Now a REST GET of a repo the role's Apps are installed on goes out on the ci-watch installation token when this host
# holds that App (~/.config/gh-app-tokens/ci-watch.json and .pem, written by gh_app_token.py when the App was made):
# the token is `gh_app_token.py token ci-watch --owner OWNER` (the copy next to the gh-quota shim gh_quota.py, which
# caches it an hour), kept in memory, never written or logged. A host with no key (huge-blue: the role keys live only
# on the key home) holds the App too while the key home's pushed one-hour read-only token,
# ~/.config/gh-app-tokens/ci-watch-token.json, is unexpired: `token ci-watch` answers with it there. Only reads (a REST
# GET, a GraphQL query, never a mutation, never the outbox) are offered to the pool, so a read-only token is enough. Writes, GraphQL, /rate_limit and every other repo stay
# on the login, so authorship (CLA, receipts) and the login's budget readings are as before. A host without the App,
# a mint that fails, or an App answer that is refused (401, 403, 429) or under APP_POOL_FLOOR left sends the read on
# the login at once, exactly as before, and rests the pool (APP_POOL_REST, or until the App's reset). App reads are
# not charged to restShare and their rate headers are not the login's budget: daemon.json appPool says what they spent.
APP_POOL_ROLE = "ci-watch"
# Spare App pools (Leo, 2026-11-20: the login's GraphQL was spent, "0 left", while one App pool served every read): a
# read goes to the first pool of the chain that holds a token, covers the route and is not resting, so a second App
# (its role in machines/gh-app-roles.json, its token pushed by the key home) is another 12,500 an hour. Comma list of
# roles after the primary; GLAEDA_GH_APP_SPARES="" turns the spares off.
APP_POOL_SPARES = tuple(r for r in (os.environ.get("GLAEDA_GH_APP_SPARES", "quota-goblin") or "").replace(" ", "").split(",") if r)
APP_POOL_DIR = Path(os.environ.get("GH_APP_TOKEN_DIR") or Path.home() / ".config/gh-app-tokens")
APP_POOL_TTL = 300.0  # a token from gh_app_token.py is used this long (it hands out one with 10+ minutes left)
APP_POOL_REST = 300.0  # a failed mint or a refused answer: the pool is not asked again for this long
APP_POOL_ROUTE_REST = 3600.0  # a route the App answered 403 or 404 stays on the login this long
APP_POOL_PUSHED_MIN_LEFT = 120.0  # a pushed token this close to its end is not asked for (gh_app_token.py's own floor)
APP_POOL_FLOOR = 500  # an App answer with fewer left: the pool's other users (base_red_watch, cmux-ci) keep the rest
APP_POOL_REPO = re.compile(r"/repos/([A-Za-z0-9][A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]+(?:/|\?|$)")
APP_POOL_GRAPHQL_OWNER = re.compile(r"^o\d+$")
APP_POOL_GRAPHQL_URL = re.compile(r"^https://github\.com/([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]+)(?:/|$)", re.I)
# The follow-up queries of a read name their repository another way: a head and its check pages in the query text
# (head_query's repository(owner:"X",name:"Y")), and a suite's or a check run's nodes(ids:) not at all, so the daemon
# names the repositories it asked about in the body's APP_POOL_ROUTE_FIELD ("OWNER/REPO", ...), which request() strips
# before sending. Without either, every one of them went on the login: one day's hour on two hosts, the login's
# GraphQL points were all heads (head, head-pages), PR check pages (pr-pages), suite attempts (last-real-attempt) and
# steps, about 670 and 825 an hour, while the PR and run reads beside them went on the App and the login sat at its
# reserve with both role Apps over 90% unspent.
APP_POOL_GRAPHQL_LITERAL = re.compile(r'repository\(owner:"([A-Za-z0-9][A-Za-z0-9-]{0,38})",name:"([A-Za-z0-9._-]+)"\)')
APP_POOL_ROUTE_FIELD = "route"
APP_POOL_ROUTE_REPO = re.compile(r"^([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]+)$")


def graphql_named_repos(body: dict | None) -> list[tuple[str, str]]:
    """The (owner, repo) pairs a GraphQL body names outside its variables: head_query's literal repositories, and the
    daemon's APP_POOL_ROUTE_FIELD for a query by node id. Lowercase."""
    if not isinstance(body, dict):
        return []
    pairs = [(o.lower(), r.lower()) for o, r in APP_POOL_GRAPHQL_LITERAL.findall(str(body.get("query") or ""))]
    route = body.get(APP_POOL_ROUTE_FIELD)
    for item in route if isinstance(route, list) else []:
        m = APP_POOL_ROUTE_REPO.match(item) if isinstance(item, str) else None
        if m:
            pairs.append((m.group(1).lower(), m.group(2).lower()))
    return pairs


# A GraphQL NOT_FOUND for a pull request or issue number that does not exist is GitHub's answer for that alias, the same
# on the login: not the App lacking a permission or repository. Counted as a refusal, one closed-and-deleted PR number
# in a batch put every batch of that repository set on the login for APP_POOL_ROUTE_REST (an hour), where the login's
# pace and reserve hold it (the broker host, 2026-11-22: "app-pool-refused ... status 200" at 23:xx, 01:xx and 02:50Z).
APP_POOL_ANSWERED_NOT_FOUND = re.compile(
    r"NOT_FOUND Could not resolve to (?:a PullRequest|an Issue|an issue or pull request) with the number of \d+\.?", re.I)


# A PR's base branch with classic protection: its rule needs administration, which no read App holds, so the App's
# answer carries FORBIDDEN at pN.pullRequest.baseRef.branchProtectionRule and every other field of the PR. Counted as a
# refusal it put cmux and cmuxterm-hq on the login for APP_POOL_ROUTE_REST, under the login's pace and reserve: the
# broker host, 2026-11-22 05:0xZ, both read Apps "refused graphql:manaflow-ai:cmuxterm-hq,cmux" with 12,234 of 12,500
# points left, every path on REST, waited PR data 8,629 s old. That one field is not the App's refusal: fetch_aliased
# keeps the checks it last called required instead, as a REST read without reads_protection does.
APP_FORBIDDEN_PROTECTION = ("baseRef", "branchProtectionRule")


def protection_forbidden(error: Any) -> bool:
    """Whether one GraphQL error is the App's FORBIDDEN on a base branch's classic protection rule only."""
    path = error.get("path") if isinstance(error, dict) else None
    return (isinstance(path, list) and tuple(path[-2:]) == APP_FORBIDDEN_PROTECTION
            and str(error.get("type") or "") == "FORBIDDEN")


def app_graphql_refused(message: str) -> bool:
    """Whether a 200 GraphQL answer's errors (request's "TYPE message ..." text) say the App may not read it: FORBIDDEN,
    or a NOT_FOUND other than a missing PR or issue number (a repository the installation does not cover)."""
    if re.search(r"FORBIDDEN", message):
        return True
    return "NOT_FOUND" in APP_POOL_ANSWERED_NOT_FOUND.sub("", message)


# A branch's rule or protection read is one route family of its repository: the App lacks administration for every
# branch alike, and a lane branch has a path of its own (the broker host, 2026-11-22: a 403 for each of
# rules/branches/main, .../lane/a, .../lane/b, each an App request and a login retry).
APP_POOL_BRANCH_ROUTES = (
    (re.compile(r"^(/repos/[^/]+/[^/]+)/rules/branches/.+$"), "/rules/branches/*"),
    (re.compile(r"^(/repos/[^/]+/[^/]+)/branches/.+/protection(?:/.*)?$"), "/branches/*/protection"),
)


def app_pool_tool() -> Path | None:
    """gh_app_token.py beside the gh-quota shim's gh_quota.py (leo-workspace tools/), or None."""
    with contextlib.suppress(OSError, RuntimeError):
        cli = PACE_CLI.resolve().parent / "gh_app_token.py"
        if cli.is_file():
            return cli
    return None


def app_pool_pushed_path(role: str, owner: str) -> Path:
    """The key home's pushed token filename for ROLE and OWNER."""
    owner = owner.lower()
    name = f"{role}-token.json" if owner == "manaflow-ai" else f"{role}@{owner}-token.json"
    return APP_POOL_DIR / name


def app_pool_pushed_token(role: str, owner: str, now: float | None = None) -> str | None:
    """Read a valid pushed installation token without requiring the workspace helper or an API request."""
    now = time.time() if now is None else now
    path = app_pool_pushed_path(role, owner)
    try:
        if path.stat().st_mode & 0o077:  # pushed credentials are private to this user
            return None
    except OSError:
        return None
    doc = read_json(path)
    if not isinstance(doc, dict) or not isinstance(doc.get("app_id"), int):
        return None
    token = str(doc.get("token") or "")
    if not TOKEN_RE.fullmatch(token):
        return None
    recorded_owner = doc.get("owner")
    if recorded_owner is not None and str(recorded_owner).lower() != owner.lower():
        return None
    expires = iso_epoch(str(doc.get("expires_at") or ""))
    if expires is None or expires - now <= APP_POOL_PUSHED_MIN_LEFT:
        return None
    return token


def app_pool_pushed_owners(role: str, now: float | None = None) -> list[str]:
    """Owners represented by usable pushed token filenames (no network or helper needed)."""
    owners: set[str] = set()
    try:
        paths = list(APP_POOL_DIR.iterdir())
    except OSError:
        return []
    legacy = f"{role}-token.json"
    for path in paths:
        if path.name == legacy:
            owners.add("manaflow-ai")
        elif path.name.startswith(f"{role}@") and path.name.endswith("-token.json"):
            owners.add(path.name[len(role) + 1:-len("-token.json")].lower())
    return sorted(owner for owner in owners if app_pool_pushed_token(role, owner, now))


class AppPool:
    """The ci-watch role's installation tokens on this host, per owner, for the daemon's repo reads (see above)."""

    def __init__(self, role: str = APP_POOL_ROLE, mint: Callable[[str], str | None] | None = None,
                 owners: Callable[[], list[str]] | None = None, ready: Callable[[], bool] | None = None,
                 clock: Callable[[], float] = time.time) -> None:
        self.role, self.clock = role, clock
        self.mint_fn = mint or self.mint_with_tool
        self.owners_fn = owners or self.owners_from_config
        self.ready_fn = ready or self.held_here
        self.owners_at: tuple[frozenset[str], float] = (frozenset(), float("-inf"))  # (owners, read again after)
        self.tokens: dict[str, tuple[str, float]] = {}  # owner (lowercase) -> (token, use until)
        self.unreadable: dict[str, float] = {}  # installation/repository/resource scope -> on the login until then
        self.rest_until: dict[str, float] = {}  # owner (lowercase) -> not asked again before this
        self.why = ""  # the last reason the pool was passed over, for daemon.json (never a token)
        self.served = self.fell_back = 0
        self.seen: dict | None = None  # the App's last rate headers: {"limit", "remaining", "reset"}
        self.graphql_served = 0
        self.graphql_points = 0
        self.graphql_seen: dict | None = None
        self.source = ""  # "key" (the App's key is here) or "pushed" (a read-only token the key home pushed)
        self.spares: list[AppPool] = []  # pools tried after this one's (never nested: a spare has none)

    def with_spares(self, roles: "tuple[str, ...] | list[str]") -> "AppPool":
        self.spares = [AppPool(role=r, clock=self.clock) for r in roles if r != self.role]
        return self

    def pick(self, owner: str, scope: str) -> "AppPool | None":
        """The first pool of the chain (this, then its spares) with a token for OWNER that has not refused SCOPE."""
        for pool in [self, *self.spares]:
            if pool.covers(scope) and pool.token(owner):
                return pool
        return None

    def held_here(self) -> bool:
        """Whether this host can get the role's token: its App metadata and key files, or a pushed read-only token
        (ROLE-token.json, from the key home) with more than APP_POOL_PUSHED_MIN_LEFT to go (file reads, no request)."""
        tool = app_pool_tool()
        if tool is not None and (APP_POOL_DIR / f"{self.role}.json").is_file() and (APP_POOL_DIR / f"{self.role}.pem").is_file():
            self.source = "key"
            return True
        if app_pool_pushed_owners(self.role, self.clock()):
            self.source = "pushed"
            return True
        return False

    def owners_from_config(self) -> list[str]:
        """machines/gh-app-roles.json `owners`, the accounts the role Apps are installed on, beside the tool."""
        cli = app_pool_tool()
        doc = read_json(cli.parent.parent / "machines" / "gh-app-roles.json") if cli else None
        owners = doc.get("owners") if isinstance(doc, dict) else None
        if isinstance(owners, list):
            configured = [o.lower() for o in owners if isinstance(o, str)]
            if configured:
                return configured
        return app_pool_pushed_owners(self.role, self.clock())

    def mint_with_tool(self, owner: str) -> str | None:
        cli = app_pool_tool()
        if cli is not None:
            try:
                result = run_bounded([sys.executable, "-I", os.fspath(cli), "token", self.role, "--owner", owner])
            except (OSError, subprocess.TimeoutExpired):
                result = None
            if result is not None:
                token = result.stdout.strip()
                if result.returncode == 0 and TOKEN_RE.fullmatch(token):
                    return token
        return app_pool_pushed_token(self.role, owner, self.clock())

    def owner_of(self, method: str, path: str, body: dict | None = None) -> str | None:
        """The sole repository owner a read may go to the pool for, else None.

        GraphQL is routed only when it names one owner: in its variables (the daemon's aliased PR/run queries), in
        head_query's literal repositories, or in the daemon's route field (graphql_named_repos). An opaque query or
        one spanning owners stays on the login, so an App token can never change viewer or cross-owner semantics.
        """
        owners: set[str] = set()
        if method == "GET":
            m = APP_POOL_REPO.match(path)
            if m:
                owners.add(m.group(1).lower())
        elif (method == "POST" and path == "/graphql" and isinstance(body, dict)
              and not re.match(r"\s*mutation\b", str(body.get("query") or ""))):
            variables = body.get("variables")
            if isinstance(variables, dict):
                for key, value in variables.items():
                    if APP_POOL_GRAPHQL_OWNER.fullmatch(str(key)) and isinstance(value, str):
                        if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,38}", value):
                            owners.add(value.lower())
                    elif re.fullmatch(r"u\d+", str(key)) and isinstance(value, str):
                        match = APP_POOL_GRAPHQL_URL.match(value)
                        if match:
                            owners.add(match.group(1).lower())
            owners.update(o for o, _ in graphql_named_repos(body))
        if len(owners) != 1:
            return None
        now = self.clock()
        if self.owners_at[1] <= now:  # the config is read once per APP_POOL_TTL, not per request
            self.owners_at = (frozenset(self.owners_fn()), now + APP_POOL_TTL)
        owner = next(iter(owners))
        return owner if owner in self.owners_at[0] else None

    def token(self, owner: str) -> str | None:
        """OWNER's installation token, or None: the read then goes on the login, as it always did."""
        now = self.clock()
        if self.rest_until.get(owner, 0.0) > now:
            return None
        held = self.tokens.get(owner)
        if held and held[1] > now:
            return held[0]
        self.tokens.pop(owner, None)
        if not self.ready_fn():
            self.why = f"no {self.role} App on this host"
            self.rest_until[owner] = now + APP_POOL_REST
            return None
        token = self.mint_fn(owner)
        if not token:
            self.why = f"gh_app_token.py token {self.role} --owner {owner} gave no token"
            self.rest_until[owner] = now + APP_POOL_REST
            return None
        self.tokens[owner] = (token, now + APP_POOL_TTL)
        return token

    @staticmethod
    def scope(owner: str, method: str, path: str, body: dict | None = None) -> str:
        """Key a refusal to the installation and resource that produced it, never the whole owner pool. A GraphQL
        scope names its repositories sorted ("graphql:OWNER:a,b"), so the same set is one key in any order, and
        covers()/answered() weigh each repository alone. A REST branch rule or protection read is keyed to its
        repository and route family, not each branch's own path (APP_POOL_BRANCH_ROUTE)."""
        if path == "/graphql":
            repos = set()
            for key, value in (body or {}).get("variables", {}).items():
                if re.fullmatch(r"r\d+", str(key)) and isinstance(value, str):
                    repos.add(str(value).lower())
                elif re.fullmatch(r"u\d+", str(key)) and isinstance(value, str):
                    match = APP_POOL_GRAPHQL_URL.match(value)
                    if match:
                        repos.add(match.group(2).lower())
            repos.update(r for _, r in graphql_named_repos(body))
            return "graphql:" + owner + (":" + ",".join(sorted(repos)) if repos else "")
        bare = path.split("?", 1)[0]
        for pattern, family in APP_POOL_BRANCH_ROUTES:
            match = pattern.match(bare)
            if match:
                return f"{method} {match.group(1)}{family}"
        return f"{method} {bare}"

    @staticmethod
    def graphql_repos(scope: str) -> tuple[str, list[str]]:
        """("OWNER", [repo, ...]) of a GraphQL scope; ("", []) for any other."""
        if not scope.startswith("graphql:"):
            return "", []
        owner, _, repos = scope[len("graphql:"):].partition(":")
        return owner, [r for r in repos.split(",") if r]

    def covers(self, scope: str) -> bool:
        """Whether SCOPE is one the App has not refused lately (a permission or resource it lacks). A GraphQL chunk is
        covered unless one of its own repositories is benched (a set is never benched as a set)."""
        now = self.clock()
        if self.unreadable.get(scope, 0.0) > now:
            return False
        owner, repos = self.graphql_repos(scope)
        return not any(self.unreadable.get(f"graphql:{owner}:{r}", 0.0) > now for r in repos)

    def named_repos(self, scope: str, message: str) -> list[str]:
        """The repositories of GraphQL SCOPE that MESSAGE (an answer's error text) names, as a whole word."""
        _, repos = self.graphql_repos(scope)
        return [r for r in repos if re.search(rf"(?<![\w.-]){re.escape(r)}(?![\w.-])", message, re.I)]

    def answered(self, owner: str, scope: str, status: int, headers: dict, message: str = "") -> bool:
        """Note the App's answer; False when the read must go again on the login. A rate limit or a dead token rests
        the pool; a 403 or 404 of one route (a permission or repository the App lacks: branch protection needs
        administration, which ci-watch does not hold) keeps that route on the login for APP_POOL_ROUTE_REST."""
        now = self.clock()
        try:
            remaining, reset = int(headers.get("x-ratelimit-remaining", "")), float(headers.get("x-ratelimit-reset", ""))
            self.seen = {"limit": int(headers.get("x-ratelimit-limit") or 0), "remaining": remaining, "reset": reset}
        except ValueError:
            remaining, reset = None, None
        limited = status == 429 or (status == 403 and (remaining == 0 or bool(headers.get("retry-after"))
                                                       or bool(SECONDARY.search(message)))
                     or (status == 200 and bool(re.search(r"RATE_LIMITED|rate limit", message, re.I))))
        if status == 401 or limited:
            self.tokens.pop(owner, None)
            spent = remaining == 0 and reset is not None and reset > now
            self.rest_until[owner] = min(reset, now + PACE_HOLD_MAX) if spent else now + APP_POOL_REST
            self.why = f"the {self.role} App answered HTTP {status}"
            self.fell_back += 1
            return False
        if status in {403, 404} or (status == 200 and app_graphql_refused(message)):
            owner_, repos = self.graphql_repos(scope)
            if len(repos) > 1:
                # A refused multi-repository chunk benches only the repositories its errors name; one that names none
                # benches nothing (the caller reads per repository, batched() chunks by repository, so the next
                # asks the App again). The broker host, 2026-11-22: sets "cmux,cmuxterm-hq" and "cmuxterm-hq,cmux"
                # were each benched an hour as sets while the App held 12,234 of 12,500 points.
                for repo in self.named_repos(scope, message):
                    self.unreadable[f"graphql:{owner_}:{repo}"] = now + APP_POOL_ROUTE_REST
            else:
                self.unreadable[scope] = now + APP_POOL_ROUTE_REST
            self.fell_back += 1
            return False
        if remaining is not None and remaining < APP_POOL_FLOOR and reset is not None:
            self.rest_until[owner] = max(self.rest_until.get(owner, 0.0), reset)  # this answer still counts
            self.why = f"the {self.role} App is under its floor ({remaining} left)"
        self.served += 1
        return True

    def status(self) -> dict:
        now = self.clock()
        resting = {o: round(t) for o, t in self.rest_until.items() if t > now}
        return {"role": self.role, "source": self.source or None, "served": self.served, "fellBack": self.fell_back, "seen": self.seen,
                "resting": resting or None, "why": self.why or None,
                "graphqlServed": self.graphql_served, "graphqlPoints": self.graphql_points,
                "graphqlSeen": self.graphql_seen,
                **({"spares": [p.status() for p in self.spares]} if self.spares else {})}

    def graphql_answered(self, rate: dict, points: int) -> None:
        """Keep an App GraphQL answer in the App pool; it must never become the login's budget or pacing data."""
        self.graphql_served += 1
        self.graphql_points += points
        if isinstance(rate, dict):
            try:
                self.graphql_seen = {"limit": int(rate["limit"]), "remaining": int(rate["remaining"]),
                                     "reset": iso_epoch(rate.get("resetAt"))}
            except (KeyError, TypeError, ValueError):
                pass


# ---------------------------------------------------------------- a lane VM's own read token
# A lane VM reads through an upstream (huge-blue's daemon, `lane-gh glaeda-read`) because it holds no login. The
# lane-gh broker now mints a read-only, single-repository, short-lived App token for a lane VM (cmuxterm-hq#17426's
# read_token tool; leo-workspace#7651 is lane-gh's own direct GET). With it this daemon reads a PR or a run from GitHub
# itself, in process: gcp-agent-lane-1 measured direct reads at p50 0.46 s against 2.44 s through the broker, and
# a tick that spent 643 s of a 600 s window waiting on the upstream. Leo: "why the f*** are you centralizing on
# f***ing huge blue anyway". Everything the token cannot read (heads, comments, a refused route, a repo the broker
# mints nothing for) still goes upstream, and every write still goes through the broker. lane-gh has no command that
# hands the token out: its `get` mints it (when lane-gh sends this VM's reads direct: its direct-reads.json or
# LANE_GH_DIRECT_READS, the switch glaeda follows as is) and keeps it, so glaeda primes it with one small `get` of the
# repo and reads the kept file. upstream.json "readToken": [...] names another program instead (`ARGV OWNER/REPO {}`
# answering {token, expires_at}); false turns it off.
# Kept where lane-gh's own direct reads keep it (leo-workspace#7651: TOKEN_DIR/OWNER__REPO.json, 0600, {token,
# expires_at, refresh_before_s}), never in BASE (the cache holds no token): one broker mint per repo, shared by this
# host's processes (the daemon, a wait's or a land's direct read, and lane-gh's own GETs). A file others can read is
# never used.
READ_TOKEN_DIR = Path(os.environ.get("LANE_GH_DIRECT_TOKEN_DIR") or Path.home() / ".cache/lane-gh/read-tokens")
READ_TOKEN_MIN_LEFT = 600.0  # a token closer than this to expires_at is minted again (the broker's own margin)
READ_TOKEN_REST = 900.0  # a repo the broker minted nothing for is not asked again for this long
READ_TOKEN_DEADLINE = 30.0  # one mint through the broker
READ_DIRECT_BUDGET = 60.0  # a tick's direct reads together; what is left goes upstream
READ_DIRECT_KINDS = ("pr", "run")
READ_TOKEN_PRIME = '{"path": "pulls", "query": {"per_page": 1}}'  # the smallest read lane-gh sends direct
READ_TOKEN_REPO = re.compile(r"^/repos/([A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]+)(?:/|\?|$)")


def read_token_command() -> list[str] | None:
    """The program that mints this host's read token, or None: upstream.json "readToken" (a list, or false for
    none), else `lane-gh call get` (the prime) of the lane-gh whose `glaeda-read` is the upstream."""
    doc = read_json(UPSTREAM_CONFIG)
    if not isinstance(doc, dict):
        return None
    given = doc.get("readToken")
    if given is False:
        return None
    if isinstance(given, list) and given and all(isinstance(a, str) and a for a in given):
        return given
    command = upstream_command()
    if command is not None and len(command) == 2 and Path(command[0]).name == "lane-gh" and command[1] == "glaeda-read":
        return [command[0], "call", "get"]
    return None


def read_token_kept(repo: str) -> tuple[str, float] | None:
    """REPO's token as lane-gh (or this file) kept it, and the time to mint again (expires_at less its
    refresh_before_s), or None. A file others can read is never used."""
    path = READ_TOKEN_DIR / (repo.lower().replace("/", "__") + ".json")
    try:
        if path.stat().st_mode & 0o077:
            return None
    except OSError:
        return None
    doc = read_json(path)
    if not isinstance(doc, dict) or not TOKEN_RE.fullmatch(str(doc.get("token") or "")):
        return None
    expires = iso_epoch(str(doc.get("expires_at") or ""))
    margin = doc.get("refresh_before_s")
    margin = float(margin) if isinstance(margin, (int, float)) and margin >= 0 else READ_TOKEN_MIN_LEFT
    return (str(doc["token"]), expires - margin) if expires is not None else None


def read_token_mint(command: list[str], repo: str) -> tuple[str, float] | None:
    """(token, the time to mint again) from one run of COMMAND for REPO, or None. `lane-gh call get` is the prime: its
    answer (the repo's newest PR) is dropped and the token is the one lane-gh kept. The token is never logged."""
    prime = len(command) >= 3 and Path(command[0]).name == "lane-gh" and command[1:3] == ["call", "get"]
    try:
        result = run_bounded([program_path(command[0]), *command[1:], repo, READ_TOKEN_PRIME if prime else "{}"],
                             READ_TOKEN_DEADLINE)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if prime:
        return read_token_kept(repo) if result.returncode == 0 else None
    try:
        doc = json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else None
    except ValueError:
        return None
    if isinstance(doc, dict) and isinstance(doc.get("data"), dict) and "token" not in doc:
        doc = doc["data"]
    if not isinstance(doc, dict):
        return None
    token, expires = str(doc.get("token") or ""), iso_epoch(str(doc.get("expires_at") or ""))
    if not TOKEN_RE.fullmatch(token) or expires is None:
        return None
    return token, expires - READ_TOKEN_MIN_LEFT


class ReadTokenPool(AppPool):
    """The broker's read tokens as an AppPool keyed by repository ("owner/repo", lowercase), for GETs of that
    repository only: Daemon.request sends a read with it and, on a refusal, asks the login, which a lane VM has
    none of (read_direct then leaves the key to the upstream). Kept in READ_TOKEN_DIR so a wait's direct read
    (its own process) reuses the daemon's token instead of asking the broker again."""

    def __init__(self, command: list[str], clock: Callable[[], float] = time.time,
                 mint: Callable[[str], tuple[str, float] | None] | None = None) -> None:
        super().__init__(role="lane-read-token", owners=lambda: [], ready=lambda: True, clock=clock)
        self.command = command
        self.mint_pair = mint or (lambda repo: read_token_mint(self.command, repo))
        self.source = "broker"

    def owner_of(self, method: str, path: str, body: dict | None = None) -> str | None:
        m = READ_TOKEN_REPO.match(path) if method == "GET" else None
        return m.group(1).lower() if m else None

    @staticmethod
    def kept_path(repo: str) -> Path:
        return READ_TOKEN_DIR / (repo.lower().replace("/", "__") + ".json")

    def keep(self, repo: str, pair: tuple[str, float] | None) -> None:
        path = self.kept_path(repo)
        with contextlib.suppress(OSError):
            if pair is None:
                path.unlink(missing_ok=True)
            else:
                write_json(path, {"token": pair[0], "refresh_before_s": int(READ_TOKEN_MIN_LEFT), "expires_at":
                                  time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(pair[1] + READ_TOKEN_MIN_LEFT))})

    def token(self, owner: str) -> str | None:
        now = self.clock()
        if self.rest_until.get(owner, 0.0) > now:
            return None
        held = self.tokens.get(owner)
        if held and held[1] > now:
            return held[0]
        kept = read_token_kept(owner)
        if kept is not None and kept[1] > now:
            self.tokens[owner] = kept
            return kept[0]
        pair = self.mint_pair(owner)
        if pair is None or pair[1] <= now:
            self.why = f"the broker minted no read token for {owner}"
            self.rest_until[owner] = now + READ_TOKEN_REST
            return None
        self.tokens[owner] = pair
        if (read_token_kept(owner) or ("",))[0] != pair[0]:  # lane-gh's prime kept it already
            self.keep(owner, pair)
        return pair[0]

    def answered(self, owner: str, scope: str, status: int, headers: dict, message: str = "") -> bool:
        ok = super().answered(owner, scope, status, headers, message)
        if status == 401:  # dead: the next read mints again, after the rest
            self.keep(owner, None)
        return ok


def read_token_reader(key: str) -> "Daemon | None":
    """A wait's or a land's direct read of KEY's repository with this host's read token (read_token_daemon), or None
    when there is none: the read then goes through the broker's GET as before. A token the broker minted for the
    daemon is reused (READ_TOKEN_DIR), so this asks the broker nothing then."""
    command = read_token_command()
    if command is None:
        return None
    _, owner, repo, _ = split_key(key)
    pool = ReadTokenPool(command)
    return read_token_daemon(pool) if pool.token(f"{owner}/{repo}".lower()) else None


def no_login() -> str:
    raise WatchError("this host has no GitHub login: it reads with the broker's read token or through its upstream")


def read_token_daemon(pool: "ReadTokenPool") -> "Daemon":
    """A Daemon that reads GitHub with POOL's tokens over plain HTTPS and has no login: a read the token cannot
    make fails (no_login). Charged to no REST share (a token's reads are the App's, not the login's)."""
    daemon = Daemon(transport=http, token=no_login, controller=None, upstream=None, app_pool=pool)
    daemon.reads_protection = False  # a branch's classic protection needs administration, which the token lacks
    daemon.charge_rest = lambda minute, n: None  # type: ignore[method-assign]
    daemon.post_due = lambda: None  # type: ignore[method-assign]  # writes go through the broker, never from here
    return daemon


# ---------------------------------------------------------------- upstream (a host with no login)


def upstream_command() -> list[str] | None:
    """The upstream program from UPSTREAM_CONFIG, or None (read GitHub with this host's own login)."""
    doc = read_json(UPSTREAM_CONFIG)
    command = doc.get("command") if isinstance(doc, dict) else None
    if isinstance(command, list) and command and all(isinstance(a, str) and a for a in command):
        return command
    return None


def program_path(name: str) -> str:
    """An upstream.json program as run: a path as given, else found on PATH or in ~/.local/bin."""
    return name if "/" in name else shutil.which(name) or os.fspath(Path.home() / ".local/bin" / name)


def direct_command() -> list[str] | None:
    """An upstream host's way to read one target fresh (direct_read), or None: UPSTREAM_CONFIG's "direct", a program
    that answers `ARGV OWNER/REPO -` with one GET of a repository path, given {"path", "query"} on stdin, as one
    `lane-gh call get` answer ({"ok", "status", "data"}). Without "direct", the `call get` of the lane-gh whose
    `glaeda-read` is the upstream: the lane-gh broker's GET reads GitHub with a token minted for the call, so the VM
    still holds none. Not for any other upstream: its program reads no single target."""
    doc = read_json(UPSTREAM_CONFIG)
    if not isinstance(doc, dict):
        return None
    direct = doc.get("direct")
    if isinstance(direct, list) and direct and all(isinstance(a, str) and a for a in direct):
        return direct
    command = upstream_command()
    if command is not None and len(command) == 2 and Path(command[0]).name == "lane-gh" and command[1] == "glaeda-read":
        return [command[0], "call", "get"]
    return None


def prior_required(entry: dict) -> set:
    """The checks a cached PR entry's data calls required: flagged on a check, or named as missing or unread."""
    before = entry.get("data") or {}
    required = {c.get("name") for c in before.get("checks") or [] if c.get("required")}
    return required | set(before.get("requiredMissing") or []) | set(before.get("requiredUnread") or [])


# The lane-gh broker's lane for this daemon's direct reads (cmuxterm-hq lane-gh-broker parts/24-lane-share.py
# UPSTREAM_LANES): they draw on the VM's own upstream_reserve slice, which its sessions cannot spend. 2026-11-17
# 08:15-08:40Z (hq#12687): gcp-agent-lane-3's sessions spent its lane share and every refresh here was refused, so its
# watched PRs went 13-23 minutes stale. lane-gh names a call's lane from LANE_GH_LANE first.
UPSTREAM_LANE = "glaeda-upstream"


def direct_env() -> dict:
    """The environment of a direct read's lane-gh: this daemon's, with its lane (UPSTREAM_LANE)."""
    return {**os.environ, "LANE_GH_LANE": UPSTREAM_LANE}


def broker_transport(command: list[str], deadline: Callable[[], float]) -> Callable:
    """A Daemon transport for an upstream host's direct read: each GET of /repos/OWNER/REPO/PATH goes to COMMAND
    (direct_command) as `OWNER/REPO -` with {"path", "query"} on stdin, within what is left of DEADLINE (a
    time.monotonic() bound) and at most UPSTREAM_DEADLINE. Answers GitHub's status and JSON as http() does; a
    refusal with no GitHub status is a 502 whose message is the refusal. GraphQL and writes are never sent."""
    exe = program_path(command[0])

    def send(method: str, url: str, headers: dict, body: bytes | None) -> tuple[int, dict, bytes]:
        parts = urllib.parse.urlsplit(url)
        m = re.match(r"^/repos/([^/]+/[^/]+)/(.+)$", parts.path)
        if method != "GET" or m is None:
            return 405, {}, json.dumps({"message": f"an upstream host's direct read sends only a repository GET, "
                                                   f"not {method} {parts.path}"}).encode()
        args = {"path": urllib.parse.unquote(m.group(2)),
                "query": dict(urllib.parse.parse_qsl(parts.query, keep_blank_values=True))}
        left = min(UPSTREAM_DEADLINE, deadline() - time.monotonic())
        if left <= 0:
            raise OutOfTime
        try:
            result = run_bounded([exe, *command[1:], m.group(1), "-"], left, input_text=json.dumps(args),
                                 env=direct_env())
        except subprocess.TimeoutExpired:
            raise OutOfTime from None
        except OSError as error:
            raise WatchError(f"direct: {type(error).__name__} running {command[0]}") from None
        try:
            answer = json.loads(result.stdout) if result.stdout.strip() else None
        except ValueError:
            answer = None
        if not isinstance(answer, dict):
            tail = (result.stderr or "").strip().splitlines()[-1:] or [f"exit {result.returncode}"]
            raise WatchError(f"direct: {command[0]}: {tail[0]}"[:UPSTREAM_ERROR_MAX])
        status = answer.get("status")
        if not isinstance(status, int) or isinstance(status, bool):
            why = answer.get("error") if isinstance(answer.get("error"), str) else "no GitHub status"
            return 502, {}, json.dumps({"message": f"direct: {why}"[:UPSTREAM_ERROR_MAX]}).encode()
        return status, {}, json.dumps(answer.get("data")).encode()
    return send


def run_upstream(command: list[str], request: dict, timeout: float = UPSTREAM_DEADLINE) -> dict:
    """One run of the upstream command, within TIMEOUT (what is left of the tick's UPSTREAM_TICK_BUDGET), at most
    UPSTREAM_DEADLINE."""
    exe = program_path(command[0])
    timeout = max(1.0, min(UPSTREAM_DEADLINE, timeout))
    try:
        result = run_bounded([exe, *command[1:]], timeout, input_text=json.dumps(request) + "\n")
    except subprocess.TimeoutExpired:
        raise WatchError(f"upstream: no answer within {timeout:.0f}s") from None
    except OSError as error:
        raise WatchError(f"upstream: {type(error).__name__} running {command[0]}") from None
    try:
        answer = json.loads(result.stdout.strip().splitlines()[-1]) if result.stdout.strip() else None
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        tail = (result.stderr or "").strip().splitlines()[-1:] or [f"exit {result.returncode}"]
        raise WatchError(f"upstream: {command[0]}: {tail[0]}"[:UPSTREAM_ERROR_MAX])
    return answer


def upstream_read_at(cached: dict | None) -> float | None:
    """When a key's cache entry was last really read (its fetchedAt), looking through an outage stored on it since
    (readAt); None for a key never read. Kept on the outage so its end restores it (Daemon.upstream_outage_over)."""
    if not isinstance(cached, dict):
        return None
    at = cached.get("readAt") if cached.get("errorFrom") == UPSTREAM_OUTAGE else cached.get("fetchedAt")
    return float(at) if isinstance(at, (int, float)) and not isinstance(at, bool) else None


def read_request(text: str) -> list[tuple[str, bool, bool, str | None]]:
    """The (key, jobs, wait, consumer) of each key in one upstream request line; WatchError on anything else. `wait`
    (optional) says a wait downstream is blocked on the key, so this host's daemon treats it as waited
    (STALE_RUN_REREAD). A head key must name the `consumer` its read is charged to (as `checks --consumer`): this
    host's daemon reads it within that consumer's head budget, never on an unnamed one. `reader` (optional,
    HOST/READER) names the downstream waiter; read_readers gives it."""
    try:
        doc = json.loads(text)
    except ValueError:
        raise WatchError("read takes one JSON line on stdin: {\"keys\": [{\"key\": ..., \"jobs\": ...}]}") from None
    keys = doc.get("keys") if isinstance(doc, dict) else None
    if not isinstance(keys, list) or len(keys) > UPSTREAM_MAX_KEYS:
        raise WatchError(f"read takes a list of at most {UPSTREAM_MAX_KEYS} keys")
    out = []
    for item in keys:
        key = item.get("key") if isinstance(item, dict) else None
        jobs = item.get("jobs", False) if isinstance(item, dict) else None
        wait = item.get("wait", False) if isinstance(item, dict) else None
        consumer = item.get("consumer") if isinstance(item, dict) else None
        kind = key.split(":", 1)[0] if isinstance(key, str) else None
        if kind not in UPSTREAM_KINDS or not isinstance(jobs, bool) or not isinstance(wait, bool):
            raise WatchError(f"read serves {', '.join(UPSTREAM_KINDS)} keys, not {str(key)[:80]!r}")
        target = key.split(":", 1)[1]
        form = rf"{NAME}/{NAME}@[0-9a-f]{{40}}" if kind == "head" else rf"{NAME}/{NAME}[#/]\d+"
        if not re.fullmatch(form, target) or parse_key(kind, target) != key:
            raise WatchError(f"not a key: {key[:80]!r}")
        if kind != "head":
            consumer = None
        elif not isinstance(consumer, str) or not CONSUMER_RE.fullmatch(consumer):
            raise WatchError(f"a head key needs a consumer (a short name: letters, digits, . _ -): {key[:80]!r}")
        out.append((key, jobs, wait, consumer))
    return out


def read_readers(text: str) -> dict[str, str]:
    """{key: reader} of an upstream request line that read_request accepted: each item's `reader`, when it names one."""
    out = {}
    for item in json.loads(text).get("keys") or []:
        reader = safe_reader(item.get("reader") if isinstance(item, dict) else None)
        if reader and isinstance(item.get("key"), str):
            out[item["key"]] = reader
    return out


def read_times(text: str) -> dict[tuple[str, str | None], dict[str, float]]:
    """{(key, consumer): {"touched", "waitedAt", "asked"}} of an upstream request line that read_request accepted:
    the downstream's own interest times for each line, the numbers it gave (register's AT)."""
    out = {}
    for item in json.loads(text).get("keys") or []:
        if not isinstance(item, dict) or not isinstance(item.get("key"), str):
            continue
        times = {k: float(item[k]) for k in ("touched", "waitedAt", "asked")
                 if isinstance(item.get(k), (int, float)) and not isinstance(item.get(k), bool) and math.isfinite(item[k])}
        consumer = item.get("consumer") if isinstance(item.get("consumer"), str) else None
        out[(item["key"], consumer)] = times
    return out


def _finite(v: Any) -> bool:
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)


# UPSTREAM_FEED_FILE as last loaded, by its stat: `read` runs inside the lane-gh broker for every lane VM's upstream
# tick (several a second), so the file is parsed once per write, not once per call.
_FEED_VIEW_LOADED: dict[str, Any] = {"stamp": None, "doc": None}


def load_feed_view() -> dict | None:
    """This host's daemon's feed view (Daemon.save_feed_view), or None."""
    path = BASE / UPSTREAM_FEED_FILE
    try:
        st = path.stat()
    except OSError:
        return None
    stamp = (os.fspath(path), st.st_ino, st.st_mtime_ns, st.st_size)
    if _FEED_VIEW_LOADED["stamp"] != stamp:
        doc = read_json(path)
        _FEED_VIEW_LOADED.update(stamp=stamp, doc=doc if isinstance(doc, dict) else None)
    return _FEED_VIEW_LOADED["doc"]


def feed_view(key: str, data: dict | None, doc: dict | None, now: float) -> dict | None:
    """What this host's feed says about PR KEY, for a downstream's land_feed_quiet (upstream_feed_quiet): since when
    the feed has answered without a gap (liveSince), when it last answered (at), and the newest event it delivered for
    the PR, the head this host's copy names, or its branch (eventAt, None for none). None, so the downstream holds
    nothing quiet, unless the feed answers now (CONTROLLER_FRESH) and covers the repository (FED_REPO_KEEP), as
    Daemon.fed asks."""
    if not key.startswith("pr:") or not isinstance(doc, dict):
        return None
    live, ok = doc.get("liveSince"), doc.get("okAt")
    if not _finite(live) or not _finite(ok) or not 0 <= now - ok <= CONTROLLER_FRESH:
        return None
    try:
        _, owner, repo, number = split_key(key)
    except ValueError:
        return None
    repo = f"{owner}/{repo}".lower()
    fed_at = (doc.get("fedRepos") or {}).get(repo) if isinstance(doc.get("fedRepos"), dict) else None
    if not _finite(fed_at) or ok - fed_at > FED_REPO_KEEP:
        return None
    marks = doc.get("marks") if isinstance(doc.get("marks"), dict) else {}
    data = data if isinstance(data, dict) else {}
    head = str(data.get("headRefOid") or "").lower()
    names = [f"pr:{repo}#{number}"] + ([f"sha:{repo}@{head}"] if head else []) \
        + ([f"branch:{repo}@{data['headRefName']}"] if data.get("headRefName") else [])
    events = [marks[m] for m in names if _finite(marks.get(m))]
    return {"liveSince": live, "at": ok, "eventAt": max(events) if events else None, "head": head or None}


def upstream_feed_quiet(view: dict, sha: str, since: float, now: float) -> bool:
    """land_feed_quiet on a host that follows no feed, from the upstream's VIEW of the PR (feed_view, given at
    answeredAt): the view is fresh (UPSTREAM_FEED_FRESH), the feed answered without a gap since before SINCE and has
    answered after it, and its newest event for the PR, its head or its branch is older than SINCE, with
    UPSTREAM_FEED_SKEW for the two hosts' clocks. A SHA other than the head the upstream's view was taken for is not
    covered by it: False."""
    live, at, event, answered = view.get("liveSince"), view.get("at"), view.get("eventAt"), view.get("answeredAt")
    if not (_finite(live) and _finite(at) and _finite(answered) and _finite(since)):
        return False
    if not 0 <= now - answered <= UPSTREAM_FEED_FRESH:
        return False
    if sha and str(sha).lower() != str(view.get("head") or "").lower():
        return False
    if live > since - UPSTREAM_FEED_SKEW or at < since:
        return False
    return event is None or (_finite(event) and event < since - UPSTREAM_FEED_SKEW)


def cmd_read(text: str) -> int:
    """`read`: register each key (sessions' interest, as `status` does) and print what the cache holds
    now, never waiting and never reading GitHub. The other end of an upstream (UPSTREAM_CONFIG). A PR's entry also
    carries this host's feed view of it (feed_view), which a downstream host rules land_feed_quiet with."""
    items = read_request(text)
    readers = read_readers(text)
    times = read_times(text)
    if not daemon_running(grace=UPSTREAM_DOWN_GRACE):
        print(json.dumps({"error": "glaeda-gh is not running on the upstream host"}))
        return EXIT_DOWN
    broken = daemon_failing()
    if broken is not None:
        print(json.dumps({"error": failing_message(broken)[:UPSTREAM_ERROR_MAX]}))
        return EXIT_DOWN
    entries: dict[str, Any] = {}
    ledger = None
    for key, jobs, wait, consumer in items:
        # A head is registered under its consumer, as `checks` does: the daemon reads it charged to that consumer's
        # head budget (due_heads, head_allowed), or leaves it to the cache and marks the consumer denied.
        register(key, jobs, consumer=consumer, waited=wait, reader=readers.get(key), at=times.get((key, consumer)))
        cached = read_cache(key)
        budgets = (entries.get(key) or {}).get("budgets") or {}  # an earlier line's consumers, for this same key
        entries[key] = None if cached is None else {
            # errorFrom, readAt: an outage of this host's own upstream, which a downstream clears once this host answers
            k: cached.get(k) for k in ("data", "dataAt", "error", "errorFrom", "readAt", "fetchedAt", "jobs", "jobsAt",
                                       "missing", "restRun", "restRunAt")
            if k in cached}
        if cached is not None and cached.get("source"):  # where the data came from, so a downstream wait can
            entries[key]["origin"] = cached.get("origin") if cached.get("source") == "upstream" else cached["source"]
        if cached is not None and key.startswith("pr:"):
            view = feed_view(key, cached.get("data"), load_feed_view(), time.time())
            if view is not None:
                entries[key]["feed"] = view
        if consumer:
            if ledger is None:
                doc = read_json(BASE / CONSUMERS_FILE)
                ledger = doc.get("consumers") if isinstance(doc, dict) and isinstance(doc.get("consumers"), dict) else {}
            mine = ledger.get(consumer) if isinstance(ledger.get(consumer), dict) else {}
            # each asking consumer's head budget here, so a downstream `checks` can say "budget spent" for every
            # consumer refused, not only the last one asked (upstream_denials)
            budgets[consumer] = {k: mine.get(k) for k in ("spent", "limit", "deniedAt")}
            entries[key] = {**(entries[key] or {}), "budgets": budgets}
    print(json.dumps({"entries": entries}, sort_keys=True))
    return EXIT_OK


# ---------------------------------------------------------------- cmux build controller


class OutOfTime(Exception):
    """This tick spent TICK_BUDGET: the entries it did not reach go first on the next tick. Not a
    WatchError, so no reader stores it as an entry's error."""


class NoReceiver(WatchError):
    """The controller answers but serves no run events (not deployed there, or not configured)."""


class ControllerTimeout(WatchError):
    """The controller missed a deadline (connect, read or the whole request). A WatchError, so every caller
    treats it as before; named so the fallback it causes can be counted as REST spend (`glaeda-gh budget`)."""


def timed_out(error: BaseException) -> bool:
    """Whether `error` is a deadline, however urllib wrapped it: a socket timeout reaches us bare on a read and
    inside URLError.reason on a connect, and hard_deadline's DeadlineTimeout is a TimeoutError too."""
    return isinstance(error, TimeoutError) or isinstance(getattr(error, "reason", None), TimeoutError)


def transport_reason(error: BaseException) -> str:
    """A transport failure's type and the OS's own words for it, never the URL or a value: "URLError
    (ConnectionRefusedError: [Errno 111] Connection refused)". The type alone ("controller: URLError", huge-blue 04:26-06:00Z
    2026-11-22, nine state events) could not tell a refused connection from a DNS miss or a reset (failure-drops-its-reason)."""
    name = type(error).__name__
    inner = getattr(error, "reason", None) if isinstance(error, urllib.error.URLError) else error
    if isinstance(inner, BaseException):
        words = getattr(inner, "strerror", None)
        errno_ = getattr(inner, "errno", None)
        said = (f"[Errno {errno_}] {words}" if isinstance(errno_, int) else str(words)) if isinstance(words, str) else ""
        if inner is error:
            return f"{name} ({said})" if said else name
        return f"{name} ({type(inner).__name__}: {said})" if said else f"{name} ({type(inner).__name__})"
    return name


class Controller:
    """The build controller's GitHub events (cmuxterm-hq#675) over the tailnet: no GitHub quota.
    Without a token it answers for public repositories only."""

    def __init__(self, base: str, token: str | None) -> None:
        self.base, self.token = base.rstrip("/"), token

    @classmethod
    def from_env(cls) -> "Controller | None":
        base = os.environ.get("CMUX_CI_CONTROLLER", "").strip()
        if not base:
            doc = read_json(CONTROLLER_CONFIG)
            base = (doc.get("controller") if isinstance(doc, dict) else None) or CONTROLLER_DEFAULT
        if not isinstance(base, str) or not base.startswith(("http://", "https://")):
            return None
        path = os.environ.get("CMUX_CI_TOKEN_FILE") or os.fspath(CONTROLLER_TOKEN)
        try:
            token = Path(path).read_text().strip() or None
        except (OSError, ValueError):  # ValueError: a token file that is not UTF-8
            token = None
        return cls(base, token)

    def get(self, path: str, timeout: float | None = None) -> dict:
        """One JSON answer. Raises NoReceiver (404, 503) or WatchError."""
        headers = {"Authorization": f"Bearer {self.token}"} if self.token else {}
        request = urllib.request.Request(self.base + path, headers=headers)
        try:
            read = CONTROLLER_READ_TIMEOUT if timeout is None else timeout
            deadline = CONTROLLER_DEADLINE if timeout is None else timeout + CONTROLLER_DEADLINE
            # The daemon's tick gives its controller requests one budget together (CONTROLLER_TICK_BUDGET), and
            # cuts each at what is left of it. controller_room starts none that the budget would cut short, so in
            # the daemon this only ever shortens a request a caller made outside a tick (#2201 review).
            left = getattr(self, "budget_end", float("inf")) - time.monotonic()
            read, deadline = min(read, max(0.1, left)), min(deadline, max(0.2, left) + deadline - read)
            CONTROLLER_CONNECT_DEADLINE.seconds = min(CONTROLLER_CONNECT_TIMEOUT, max(0.1, left))
            try:
                with hard_deadline(deadline), CONTROLLER_OPENER.open(request, timeout=read) as response:
                    doc = json.loads(response.read(MAX_BODY))
            finally:
                CONTROLLER_CONNECT_DEADLINE.seconds = None
        except urllib.error.HTTPError as error:
            if error.code in {404, 503}:
                raise NoReceiver(f"controller HTTP {error.code}") from None
            raise WatchError(f"controller HTTP {error.code}") from None
        except (OSError, HTTPException, ValueError) as error:
            if timed_out(error):
                raise ControllerTimeout(f"controller: {transport_reason(error)}") from None
            raise WatchError(f"controller: {transport_reason(error)}") from None
        if not isinstance(doc, dict):
            raise WatchError("controller: not a JSON object")
        return doc

    def run(self, run_id: int, wait: int = 0) -> dict | None:
        """The controller's view of a run, optionally long-polling until it changes state."""
        if not isinstance(wait, int) or not 0 <= wait <= CONTROLLER_RUN_MAX_WAIT:
            raise WatchError(f"controller run wait must be 0..{CONTROLLER_RUN_MAX_WAIT} seconds")
        timeout = CONTROLLER_READ_TIMEOUT if wait == 0 else wait + CONTROLLER_READ_TIMEOUT
        doc = self.get(f"/v1/github/runs/{int(run_id)}?wait={wait}", timeout=timeout)
        run = doc.get("run")
        return run if doc.get("known") and isinstance(run, dict) else None

    def events(self, since: int | None) -> dict:
        """The change feed after cursor `since`, or only the current cursor when since is None."""
        doc = self.get("/v1/github/events?since=" + ("latest" if since is None else str(int(since))))
        if not isinstance(doc.get("cursor"), int) or doc["cursor"] < 0:
            raise WatchError("controller: feed without a cursor")
        return doc

    def run_jobs(self, repo: str, run_id: int, attempt: int) -> dict:
        """The jobs of one run attempt the controller holds (workflow_job deliveries): known false when none."""
        return self.get(f"/v1/github/run-jobs?repo={urllib.parse.quote(repo, safe='/')}"
                        f"&run={int(run_id)}&attempt={int(attempt)}")


def controller_run(run: dict) -> dict:
    """The controller's run record in slim_run's shape."""
    return {"id": run.get("id"), "name": run.get("name"), "display_title": None, "status": run.get("status"),
            "conclusion": run.get("conclusion") or None, "html_url": run.get("url"), "head_sha": run.get("head_sha"),
            "head_branch": run.get("head_branch") or "", "event": run.get("event"), "run_attempt": run.get("attempt"),
            "created_at": None, "updated_at": run.get("updated_at")}


# ---------------------------------------------------------------- on-event: a command per finished run or job
#
# ~/.config/glaeda/on-event.json (GLAEDA_GH_ON_EVENT_CONFIG):
#   {"hooks": [{"name": "cloud-probe-promote", "repo": "manaflow-ai/cmux", "workflow": "backend.yml",
#               "branch": "feat-cmux-next", "job": "promote-production", "conclusion": "success",
#               "command": ["/usr/bin/python3", "/abs/probe.py", "run", "--sha", "{head_sha}"], "cwd": "/abs"}]}
# The daemon matches each finished run its controller feed delivers (no GitHub read): repo, branch, and workflow by
# file name or display name. With `job`, that job of the run's attempt must have `conclusion` (read from the
# controller's run-jobs); without it, the run's own conclusion. Each (hook, repo, run, attempt) runs at most once:
# the claim is written to BASE/on-event.json before the command starts, so neither a restart nor a crash runs it
# twice. The command starts detached, with an absolute executable, an environment of ON_EVENT_ENV, the hook's `env` and
# GLAEDA_EVENT_* (never a token), its output in BASE/on-event/; the daemon records its exit code. Events that happen
# while the daemon is down, or reads through an upstream (a lane VM), are not seen.


def on_event_problem(h: Any) -> str | None:
    """Why a configured hook cannot run, or None."""
    if not isinstance(h, dict):
        return "a hook is not an object"
    name = h.get("name")
    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", name):
        return "a hook needs a name of letters, digits, dot, dash or underscore"
    if not isinstance(h.get("repo"), str) or not re.fullmatch(rf"{NAME}/{NAME}", h["repo"]):
        return f"{name}: repo must be OWNER/REPO"
    for field in ("workflow", "branch"):
        if not isinstance(h.get(field), str) or not h[field]:
            return f"{name}: {field} is required"
    for field in ("job", "conclusion", "cwd"):
        if field in h and (not isinstance(h[field], str) or not h[field]):
            return f"{name}: {field} must be a non-empty string"
    if "cwd" in h and not os.path.isabs(h["cwd"]):
        return f"{name}: cwd must be an absolute path"
    env = h.get("env", {})
    if not isinstance(env, dict) or not all(
            isinstance(k, str) and re.fullmatch(r"[A-Z_][A-Z0-9_]*", k) and not k.startswith("GLAEDA_EVENT_")
            and isinstance(v, str) for k, v in env.items()):
        return f"{name}: env must map NAME to a string value (GLAEDA_EVENT_* are the daemon's)"
    command = h.get("command")
    if not isinstance(command, list) or not command or not all(isinstance(a, str) for a in command):
        return f"{name}: command must be a list of strings"
    if not os.path.isabs(command[0]):
        return f"{name}: command[0] must be an absolute path"
    # {word} is a placeholder (other braces are literal text, like a dict in a `python3 -c` script)
    unknown = {f for a in command for f in re.findall(ON_EVENT_PLACEHOLDER, a)} - set(ON_EVENT_FIELDS)
    if unknown:
        return f"{name}: unknown placeholder {{{sorted(unknown)[0]}}} (known: {', '.join(ON_EVENT_FIELDS)})"
    return None


def on_event_hooks() -> tuple[list[dict], list[str]]:
    """The configured hooks that can run, and why each other one cannot."""
    if not ON_EVENT_CONFIG.exists():
        return [], []
    doc = read_json(ON_EVENT_CONFIG)
    if not isinstance(doc, dict) or not isinstance(doc.get("hooks"), list):
        return [], [f"{ON_EVENT_CONFIG}: not a JSON object with a hooks list"]
    hooks, problems, names = [], [], set()
    for h in doc["hooks"]:
        problem = on_event_problem(h)
        if problem is None and h["name"] in names:
            problem = f"{h['name']}: a second hook of that name"
        if problem:
            problems.append(problem)
            continue
        names.add(h["name"])
        hooks.append({**h, "conclusion": h.get("conclusion", "success")})
    return hooks, problems


def on_event_state() -> dict:
    doc = read_json(BASE / ON_EVENT_STATE)
    doc = doc if isinstance(doc, dict) else {}
    runs, pending = doc.get("runs"), doc.get("pending")
    return {"runs": runs if isinstance(runs, dict) else {}, "pending": pending if isinstance(pending, dict) else {}}


def on_event_stat() -> tuple | None:
    """on-event.json's identity and change stamp; None when it does not exist."""
    try:
        st = (BASE / ON_EVENT_STATE).stat()
    except OSError:
        return None
    return (st.st_ino, st.st_size, st.st_mtime_ns)


def on_event_key(hook: str, repo: str, run_id: Any, attempt: Any) -> str:
    return f"{hook} {repo.lower()}/{run_id}/{attempt}"


def on_event_matches(hook: dict, run: dict) -> bool:
    """Whether a finished feed run is the hook's repo, branch and workflow (file name or display name)."""
    if run.get("status") != "completed" or str(run.get("repo") or "").lower() != hook["repo"].lower():
        return False
    if run.get("head_branch") != hook["branch"]:
        return False
    return hook["workflow"] in {run.get("name"), os.path.basename(str(run.get("path") or ""))}


def on_event_job(jobs: Any, name: str) -> dict | None:
    """The finished job of that name (the last one, when a name repeats), or None."""
    found = [j for j in jobs or [] if isinstance(j, dict) and j.get("name") == name and j.get("status") == "completed"]
    return max(found, key=lambda j: j.get("id") or 0) if found else None


def on_event_prune(state: dict, now: float) -> None:
    runs = {k: v for k, v in state["runs"].items() if now - float(v.get("at") or 0) < ON_EVENT_KEEP}
    keep = sorted(runs, key=lambda k: float(runs[k].get("at") or 0))[-ON_EVENT_RUNS_MAX:]
    state["runs"] = {k: runs[k] for k in keep}


# ---------------------------------------------------------------- GraphQL for PRs


def pr_query(keys: list[str], kind: str = "pr") -> tuple[str, dict]:
    """One aliased query for every PR (or issue's comments) in `keys`, plus the rate limit. Names
    travel as variables. PRs are aliased p0, p1, ...; comment watches c0, c1, ..."""
    decls, parts, variables = [], [], {}
    for i, key in enumerate(keys):
        _, owner, repo, number = split_key(key)
        decls.append(f"$o{i}: String!, $r{i}: String!, $n{i}: Int!")
        if kind in ("pr", "probe"):
            fields = PR_FIELDS.replace("NUM", f"$n{i}") if kind == "pr" else PR_PROBE_FIELDS
            parts.append(f"p{i}: repository(owner: $o{i}, name: $r{i}) {{ pullRequest(number: $n{i}) {{ {fields} }} }}")
        else:
            parts.append(f"c{i}: repository(owner: $o{i}, name: $r{i}) {{ issueOrPullRequest(number: $n{i}) "
                         f"{{ {ISSUE_FIELDS} }} }}")
        variables.update({f"o{i}": owner, f"r{i}": repo, f"n{i}": number})
    query = f"query({', '.join(decls)}) {{ rateLimit {{ limit remaining resetAt cost }} {' '.join(parts)} }}"
    return query, variables


def run_query(keys: list[str]) -> tuple[str, dict]:
    """One aliased query for every run in `keys` (w0, w1, ...), by URL, plus the rate limit."""
    decls, parts, variables = [], [], {}
    for i, key in enumerate(keys):
        _, owner, repo, run_id = split_key(key)
        decls.append(f"$u{i}: URI!")
        parts.append(f"w{i}: resource(url: $u{i}) {{ {RUN_FIELDS} }}")
        variables[f"u{i}"] = f"https://github.com/{owner}/{repo}/actions/runs/{run_id}"
    query = f"query({', '.join(decls)}) {{ rateLimit {{ limit remaining resetAt cost }} {' '.join(parts)} }}"
    return query, variables


def graphql_run(node: dict) -> dict:
    """A WorkflowRun node in slim_run's shape (REST's lowercase status and conclusion)."""
    suite = node.get("checkSuite") or {}
    return {"id": node.get("databaseId"), "name": (node.get("workflow") or {}).get("name"),
            "display_title": node.get("displayTitle"), "status": str(suite.get("status") or "").lower() or None,
            "conclusion": str(suite.get("conclusion") or "").lower() or None, "html_url": node.get("url"),
            "head_sha": (suite.get("commit") or {}).get("oid"), "head_branch": (suite.get("branch") or {}).get("name") or "",
            "event": node.get("event"), "run_attempt": node.get("runAttempt"), "created_at": node.get("createdAt"),
            "updated_at": node.get("updatedAt")}


def upper(value: Any) -> str | None:
    return str(value).upper() if value else None


def slim_pull(doc: dict) -> dict:
    keep = ("number", "html_url", "title", "state", "draft", "merged", "merged_at", "mergeable", "mergeable_state",
            "updated_at")
    head, base = doc.get("head") or {}, doc.get("base") or {}
    return {**{k: doc.get(k) for k in keep}, "head": {"sha": head.get("sha"), "ref": head.get("ref")},
            "base": {"ref": base.get("ref")}}


def slim_check_runs(doc: dict) -> dict:
    keep = ("id", "node_id", "name", "status", "conclusion", "details_url", "started_at", "completed_at")
    return {"total_count": doc.get("total_count"),
            "check_runs": [{**{k: c.get(k) for k in keep}, "suite": (c.get("check_suite") or {}).get("id"),
                            "app": (c.get("app") or {}).get("slug")}
                           for c in doc.get("check_runs") or [] if isinstance(c, dict)]}


def slim_statuses(doc: dict) -> list[dict]:
    return [{k: c.get(k) for k in ("context", "state", "target_url", "created_at", "description")}
            for c in doc.get("statuses") or [] if isinstance(c, dict)]


def slim_issue_gate(doc: dict) -> dict:
    """GET issues/N as rest_pull's change detector: only what says the PR changed."""
    return {k: doc.get(k) for k in ("number", "state", "updated_at")}


def slim_check_suites(doc: dict) -> dict:
    """GET commits/SHA/check-suites as the REST PR read's gate (PR_REST_FULL_EVERY): each suite's id, status,
    conclusion and run count, which move when a suite finishes, fails, is added or rerun, and not while its runs only
    progress."""
    suites = [[s.get("id"), s.get("status"), s.get("conclusion"), s.get("latest_check_runs_count")]
              for s in doc.get("check_suites") or [] if isinstance(s, dict)]
    return {"total": doc.get("total_count"), "suites": sorted(suites, key=lambda s: str(s[0]))}


def suites_path(root: str, sha: str) -> str:
    return f"{root}/commits/{sha}/check-suites?per_page={PR_REST_SUITE_PAGE}"


def head_pending(checks: dict, statuses: list[dict]) -> bool:
    """A head with a check run not completed, or a status pending, by its REST reads (rest_head)."""
    return (any(str(c.get("status") or "").lower() != "completed" for c in checks.get("check_runs") or [])
            or any(str(s.get("state") or "").lower() in {"pending", "expected"} for s in statuses))


def head_moved(old: dict, parts: dict, prefix: str) -> bool:
    """Whether a head read (the parts under PREFIX, a commit's) answered anything but its kept answer."""
    return any(path.startswith(prefix) and (part.get("etag") != (old.get(path) or {}).get("etag") or path not in old)
               for path, part in parts.items())


def slim_status_page(doc: dict) -> dict:
    """One page of a commit's combined status, with the total it says there is."""
    return {"total": doc.get("total_count"), "statuses": slim_statuses(doc)}


def slim_head_runs_page(doc: dict) -> dict:
    """One page of a commit's workflow runs, with the total it says there is."""
    return {"total": doc.get("total_count"), "runs": slim_head_runs(doc)}


def slim_head_runs(doc: dict) -> list[dict]:
    return [{k: r.get(k) for k in ("id", "name", "workflow_id", "check_suite_id", "conclusion", "event")}
            for r in doc.get("workflow_runs") or [] if isinstance(r, dict)]


# A dispatched run names the commit it tests in its run-name as OWNER/REPO@<40 hex>: its own head_sha is the
# dispatch ref's tip (main), never that commit (manaflow-ai/cmux fast-checks.yml). Full ids only, with the repo.
NAMED_COMMIT = re.compile(r"(?<![\w./-])([\w.-]+/[\w.-]+)@([0-9a-fA-F]{40})(?![0-9a-zA-Z])")


def names_commit(title: Any, repo: str, sha: str | None) -> bool:
    """Whether a run-name names `sha` of `repo` (OWNER/REPO) as the commit the run tests. A full 40-hex id only:
    a prefix never matches, and neither does another repo's commit or a bare sha (fast-checks' snapshot id)."""
    if not sha or not re.fullmatch(r"[0-9a-f]{40}", sha.lower()):
        return False
    return (repo.lower(), sha.lower()) in {(r.lower(), c.lower()) for r, c in NAMED_COMMIT.findall(str(title or ""))}


def run_tests_commit(data: dict, repo: str, sha: str | None) -> bool:
    """A workflow_dispatch run whose run-name names `sha` of `repo` (names_commit): the commit it tested."""
    return data.get("event") == "workflow_dispatch" and names_commit(data.get("display_title"), repo, sha)


def slim_workflows(doc: dict) -> dict[str, str]:
    """Workflow id -> name. A run's own REST name is its run-name when the workflow sets one."""
    return {str(w.get("id")): str(w.get("name")) for w in doc.get("workflows") or [] if isinstance(w, dict)}


def slim_rules(doc: Any) -> list[str]:
    """The required checks a branch's rulesets name (GET .../rules/branches/B answers a list)."""
    names = set()
    for rule in doc if isinstance(doc, list) else []:
        if isinstance(rule, dict) and rule.get("type") == "required_status_checks":
            for item in (rule.get("parameters") or {}).get("required_status_checks") or []:
                if isinstance(item, dict) and item.get("context"):
                    names.add(str(item["context"]))
    return sorted(names)


def slim_branch(doc: dict) -> list[str]:
    """The required checks a branch's classic protection names."""
    checks = (doc.get("protection") or {}).get("required_status_checks") or {}
    names = {str(c) for c in checks.get("contexts") or []}
    names |= {str(c["context"]) for c in checks.get("checks") or [] if isinstance(c, dict) and c.get("context")}
    return sorted(names)


def slim_issue(doc: dict) -> dict:
    pull = doc.get("pull_request")
    return {"html_url": doc.get("html_url"), "state": doc.get("state"), "comments": doc.get("comments") or 0,
            "pull": isinstance(pull, dict), "merged": bool((pull or {}).get("merged_at"))}


def slim_comments(doc: Any) -> list[dict]:
    """An issue's REST comments in the GraphQL comment shape parse_comments reads (REST names an App's
    account `NAME[bot]`, GraphQL `NAME`)."""
    return [{"databaseId": c.get("id"), "url": c.get("html_url"), "createdAt": c.get("created_at"),
             # REST has no lastEditedAt; updated_at past created_at is an edit (the outbox's status edits)
             **({"lastEditedAt": c["updated_at"]} if c.get("updated_at") and c.get("updated_at") != c.get("created_at")
                else {}),
             "author": {"login": re.sub(r"\[bot\]$", "", str((c.get("user") or {}).get("login") or ""))},
             "body": str(c.get("body") or "")[:COMMENT_BODY_MAX]}
            for c in doc if isinstance(c, dict)] if isinstance(doc, list) else []


def rest_issue_node(issue: dict, comments: list[dict]) -> dict:
    """The REST answers in the GraphQL issueOrPullRequest shape."""
    state = "MERGED" if issue.get("merged") else str(issue.get("state") or "").upper() or None
    return {"__typename": "PullRequest" if issue.get("pull") else "Issue", "url": issue.get("html_url"),
            "state": state, "comments": {"totalCount": issue.get("comments"), "nodes": comments[-COMMENTS_LAST:]}}


def rest_contexts(checks: dict, statuses: list[dict], runs: list[dict], required: set[str],
                  workflows: dict[str, str] | None = None) -> list[dict]:
    """A commit's REST check runs and statuses as GraphQL statusCheckRollup context nodes."""
    suites = {r.get("check_suite_id"): r for r in runs}
    workflows = workflows or {}
    nodes: list[dict] = []
    for c in checks.get("check_runs") or []:
        run = suites.get(c.get("suite"))
        nodes.append({"__typename": "CheckRun", "id": c.get("node_id"), "name": c.get("name"),
                      "status": upper(c.get("status")), "conclusion": upper(c.get("conclusion")),
                      "detailsUrl": c.get("details_url"), "databaseId": c.get("id"), "startedAt": c.get("started_at"),
                      "completedAt": c.get("completed_at"), "isRequired": c.get("name") in required,
                      "checkSuite": {"conclusion": upper(run.get("conclusion")), "app": {"slug": c.get("app")},
                                     "databaseId": c.get("suite"),
                                     "workflowRun": {
                          "databaseId": run.get("id"), "event": run.get("event"), "workflow": {
                              "name": workflows.get(str(run.get("workflow_id"))) or run.get("name"),
                                                                    "databaseId": run.get("workflow_id")}}}
                      if run else {"conclusion": None, "app": {"slug": c.get("app")}, "databaseId": c.get("suite"),
                                   "workflowRun": None}})
    for c in statuses:
        nodes.append({"__typename": "StatusContext", "context": c.get("context"), "state": upper(c.get("state")),
                      "targetUrl": c.get("target_url"), "createdAt": c.get("created_at"),
                      **({"description": c["description"]} if isinstance(c.get("description"), str) else {}),
                      "isRequired": c.get("context") in required})
    return nodes


def rest_pr_node(pull: dict, checks: dict, statuses: list[dict], runs: list[dict], required: set[str],
                 review: str | None = None, workflows: dict[str, str] | None = None) -> dict:
    """The REST answers in the GraphQL pullRequest shape, so parse_pr reads both alike."""
    nodes = rest_contexts(checks, statuses, runs, required, workflows)
    rollup = None
    if nodes:
        results = [n.get("conclusion") if n["__typename"] == "CheckRun" else n.get("state") for n in nodes]
        pending = any(n["__typename"] == "CheckRun" and n.get("status") != "COMPLETED" or
                      n["__typename"] == "StatusContext" and n.get("state") in {"PENDING", "EXPECTED"} for n in nodes)
        truncated = (checks.get("total_count") or 0) > len(checks.get("check_runs") or [])
        # GraphQL's rollup state covers every check; ours covers only what was read, so a truncated
        # list is never called green
        state = ("FAILURE" if any(r in FAILED for r in results) else "PENDING" if pending or truncated
                 else "SUCCESS")
        total = (checks.get("total_count") or 0) + len(statuses)
        rollup = {"state": state, "contexts": {"totalCount": max(total, len(nodes)),
                                               "pageInfo": {"hasNextPage": truncated}, "nodes": nodes}}
    head = pull.get("head") or {}
    state = "OPEN" if pull.get("state") == "open" else "MERGED" if pull.get("merged") else "CLOSED"
    mergeable = {True: "MERGEABLE", False: "CONFLICTING"}.get(pull.get("mergeable"), "UNKNOWN")
    return {"number": pull.get("number"), "url": pull.get("html_url"), "title": pull.get("title"), "state": state,
            "isDraft": bool(pull.get("draft")), "merged": bool(pull.get("merged")), "mergedAt": pull.get("merged_at"),
            "mergeCommit": {"oid": pull.get("merge_commit_sha")} if pull.get("merged") else None,
            "mergeable": mergeable, "mergeStateStatus": upper(pull.get("mergeable_state")) or "UNKNOWN",
            "headRefOid": head.get("sha"), "headRefName": head.get("ref"),
            "baseRefName": (pull.get("base") or {}).get("ref"), "reviewDecision": review,
            "updatedAt": pull.get("updated_at"),
            "baseRef": {"branchProtectionRule": {"requiredStatusCheckContexts": sorted(required)}, "rules": {"nodes": []}},
            "commits": {"nodes": [{"commit": {"statusCheckRollup": rollup}}]}}


def parse_comments(node: dict) -> dict:
    comments = node.get("comments") or {}
    return {"url": node.get("url"), "state": node.get("state"), "type": node.get("__typename"),
            "total": comments.get("totalCount"),
            "comments": [{"id": c.get("databaseId"), "url": c.get("url"), "createdAt": c.get("createdAt"),
                          **({"editedAt": c["lastEditedAt"]} if c.get("lastEditedAt") else {}),
                          "author": (c.get("author") or {}).get("login"),
                          "body": str(c.get("body") or "")[:COMMENT_BODY_MAX]}
                         for c in comments.get("nodes") or [] if c]}


def brief(check: dict) -> dict:
    return {k: check.get(k) for k in ("name", "workflow", "conclusion", "required", "url")}


def outranks(new: dict, new_order: tuple, old: dict, old_order: tuple) -> bool:
    """Whether `new` replaces `old`, a check of the same workflow and name. Mostly the newer attempt, but a
    job can have a same-named twin in its own run (the compile routed to one runner, its skipped twin on
    another): a job that ran beats a skipped one, and a queued or running job is never replaced by a
    cancelled one, since a newer attempt only starts once the older one has finished."""
    skipped = [(c.get("conclusion") or "").upper() == "SKIPPED" for c in (new, old)]
    if skipped[0] != skipped[1]:
        return skipped[1]
    live = [c.get("status") not in {"COMPLETED", None} for c in (new, old)]
    cancelled = [(c.get("conclusion") or "").upper() == "CANCELLED" for c in (new, old)]
    if live[1] and cancelled[0]:
        return False
    if live[0] and cancelled[1]:
        return True
    return new_order >= old_order


def confirmed_updated(cache: dict | None, node: dict | None, now: float) -> dict:
    """Store fields for a PR whose cached answer a probe (or a full read's first page) just confirmed: the node's
    updatedAt, which the fingerprint leaves out, and updatedAtAt, the time head and updatedAt were read together. {}
    when the node carries no updatedAt or another head (then the read is not a confirmation of this data)."""
    data = (cache or {}).get("data")
    upd = node.get("updatedAt") if isinstance(node, dict) else None
    if not isinstance(data, dict) or not isinstance(upd, str) or node.get("headRefOid") != data.get("headRefOid"):
        return {}
    fields: dict[str, Any] = {"updatedAtAt": now}
    if data.get("updatedAt") != upd:
        fields["data"] = {**data, "updatedAt": upd}
    return fields


def pr_fingerprint(node: dict | None) -> str | None:
    """What a PR node says that a verdict or a wait reads, as one string: its state, mergeability, head and review, its
    rollup's state, and its check runs and statuses counted by state, and its suite count. The same from the full read
    and from PR_PROBE. None when the counts are missing (a node from REST, or an answer without them): never probed."""
    if not isinstance(node, dict):
        return None
    commits = (node.get("commits") or {}).get("nodes") if isinstance(node.get("commits"), dict) else None
    commit = ((commits or [{}])[0] or {}).get("commit") if isinstance(commits, list) else None
    if not isinstance(commit, dict):
        return None
    rollup = commit.get("statusCheckRollup")
    contexts = rollup.get("contexts") if isinstance(rollup, dict) else None
    suites = commit.get("checkSuites")
    if rollup is not None and not (isinstance(contexts, dict) and isinstance(contexts.get("checkRunCountsByState"), list)
                                   and isinstance(contexts.get("statusContextCountsByState"), list)):
        return None
    if not isinstance(suites, dict) or not isinstance(suites.get("totalCount"), int):
        return None

    def counts(rows: Any) -> list:
        return sorted((str(r.get("state")), r.get("count")) for r in rows or [] if isinstance(r, dict) and r.get("count"))

    return json.dumps([node.get(k) for k in ("state", "isDraft", "merged", "mergeable", "mergeStateStatus",
                                             "headRefOid", "reviewDecision")]
                      + [None if rollup is None else rollup.get("state"),
                         None if contexts is None else contexts.get("totalCount"),
                         None if contexts is None else counts(contexts.get("checkRunCountsByState")),
                         None if contexts is None else counts(contexts.get("statusContextCountsByState")),
                         suites.get("totalCount")], sort_keys=True)


def drop_null_contexts(node: dict) -> int:
    """Remove the null (or non-object) context nodes from a PR node's rollup, in place; how many there were. A null
    node is a context GitHub failed to read: the rollup is partial, so the caller marks it (checksPageError)."""
    commits = (node.get("commits") or {}).get("nodes") if isinstance(node.get("commits"), dict) else None
    commit = ((commits or [{}])[0] or {}).get("commit") if isinstance(commits, list) else None
    rollup = commit.get("statusCheckRollup") if isinstance(commit, dict) else None
    contexts = rollup.get("contexts") if isinstance(rollup, dict) else None
    nodes = contexts.get("nodes") if isinstance(contexts, dict) else None
    if not isinstance(nodes, list):
        return 0
    kept = [c for c in nodes if isinstance(c, dict)]
    contexts["nodes"] = kept
    return len(nodes) - len(kept)


def null_contexts_error(count: int) -> str:
    return f"graphql: {count} check context{'s' if count != 1 else ''} came back null (a partial rollup)"


def head_parents(node: dict) -> list[str] | None:
    """The PR head commit's parent oids, lowercased, or None when the read did not carry them (a probe, REST, an older
    query) or its commit is not the head. The land queue reads them to tell its own update_branch's base merge (the
    pinned head plus the base) from someone's push (LandQueue.follow_own_update)."""
    commits = (node.get("commits") or {}).get("nodes") if isinstance(node.get("commits"), dict) else None
    commit = ((commits or [{}])[0] or {}).get("commit") if isinstance(commits, list) else None
    parents = commit.get("parents") if isinstance(commit, dict) else None
    nodes = parents.get("nodes") if isinstance(parents, dict) else None
    head = str(node.get("headRefOid") or "").lower()
    if not isinstance(nodes, list) or not head or str(commit.get("oid") or "").lower() != head:
        return None
    return [str(p.get("oid") or "").lower() for p in nodes if isinstance(p, dict) and p.get("oid")]


def pr_head_parent(node: dict, commits: list) -> str:
    """The first parent of the PR's head commit as the read gave it (40 hex, lowercase), or "" when this read does not
    say. Only the head commit's own parent is taken: commits(last: 1) is the head commit, and its oid is checked
    against headRefOid, so a read whose commit list lags the head (or a REST read, which carries no parents) says
    nothing rather than naming another commit's parent. A first parent is what proves a merge commit was made on top
    of a known head: land's pin follows the merge its own update-branch made (LandQueue.pin_follow)."""
    commit = ((commits[0] if commits else {}) or {}).get("commit") or {}
    oid = str(commit.get("oid") or "").lower()
    head = str(node.get("headRefOid") or "").lower()
    if not oid or not head or oid != head:
        return ""
    parents = ((commit.get("parents") or {}).get("nodes") or [])
    first = str(((parents[0] if parents else {}) or {}).get("oid") or "").lower()
    return first if SHA40.fullmatch(first) else ""


def parse_pr(node: dict) -> dict:
    commits = ((node.get("commits") or {}).get("nodes") or [{}])
    rollup = ((commits[0] or {}).get("commit") or {}).get("statusCheckRollup") or {}
    head_parent = pr_head_parent(node, commits)
    contexts = rollup.get("contexts") or {}
    latest: dict[str, tuple[tuple, dict]] = {}
    superseded: list[dict] = []  # replaced by a newer attempt or run; GitHub's rollup still counts them
    # GitHub answers a context it failed to resolve as null beside an error. One such node raised AttributeError here,
    # which batched() swallowed for the whole batch: up to GQL_BATCH PRs kept their old data, with no error stored,
    # for as long as GitHub kept answering it (huge-blue 2026-11-11: a merged PR read OPEN for 50 minutes).
    # fetch_aliased marks such a PR partial (drop_null_contexts); this only keeps the parse total.
    nodes = [c for c in contexts.get("nodes") or [] if isinstance(c, dict)]
    # A run the concurrency group cancelled for a newer run of the same workflow on this commit
    # leaves failed checks (ci-status: cancelled) that the newer run replaces when it gets there.
    def workflow_run(c: dict) -> tuple[object, int]:
        run = (c.get("checkSuite") or {}).get("workflowRun") or {}
        workflow = run.get("workflow") or {}
        return workflow.get("databaseId") or workflow.get("name"), run.get("databaseId") or 0

    newest: dict[object, int] = {}
    for c in nodes:
        workflow, run_id = workflow_run(c)
        if workflow and run_id:
            newest[workflow] = max(newest.get(workflow, 0), run_id)
    for c in nodes:
        workflow_key, run_id = workflow_run(c)
        if c.get("__typename") == "StatusContext":
            state = c.get("state")
            done = state in {"SUCCESS", "FAILURE", "ERROR"}
            check = {"name": c.get("context"), "workflow": None, "status": "COMPLETED" if done else "PENDING",
                     "conclusion": state if done else None, "url": c.get("targetUrl")}
            order = (0, c.get("createdAt") or "")
        else:
            workflow = (((c.get("checkSuite") or {}).get("workflowRun") or {}).get("workflow") or {}).get("name")
            check = {"name": c.get("name"), "workflow": workflow, "status": c.get("status"),
                     "conclusion": c.get("conclusion"), "url": c.get("detailsUrl"), "id": c.get("id"),
                     "runId": run_id or None, "startedAt": c.get("startedAt"), "completedAt": c.get("completedAt")}
            if c.get("status") != "COMPLETED" and c.get("databaseId"):
                check["jobId"] = c["databaseId"]  # an unfinished run's Actions job, for straggler_cut's jobs read
            # databaseId first: a queued rerun has no startedAt yet but is still the newer attempt
            order = (c.get("databaseId") or 0, c.get("startedAt") or "")
        check["required"] = bool(c.get("isRequired"))
        if c.get("lastRealAttempt"):
            check["lastRealAttempt"] = True  # its suite's newest attempt ran nothing: GitHub's rollup state omits it
        if ((c.get("checkSuite") or {}).get("conclusion") == "CANCELLED" and workflow_key and run_id
                and run_id < newest[workflow_key]):
            superseded.append(check)
            continue
        # a rerun leaves the old attempt in the list (cancelled, then passed): keep the newest per
        # (workflow, name), so same-named jobs in different workflows stay separate
        ident = f"{check['workflow'] or ''}\0{check['name']}"
        if ident not in latest or outranks(check, order, *reversed(latest[ident])):
            if ident in latest:
                superseded.append(latest[ident][1])
            latest[ident] = (order, check)
        else:
            superseded.append(check)
    checks = [check for _, check in latest.values()]
    # only the ones that would have counted against the PR are worth keeping. One that ran nothing (GitHub
    # stamps it started and completed at once), such as a twin cancelled before it began, stays as evidence
    # for check_verdict (the rollup still counts it) but is marked so status never names it: it has no
    # error to chase, whichever of the pair has the higher id
    superseded = [{**brief(c), "ranNothing": bool(c.get("completedAt") and c.get("startedAt") == c.get("completedAt")),
                   # read by suite id, not from the rollup: not in its counts (rollup_red_is_superseded)
                   **({"lastRealAttempt": True} if c.get("lastRealAttempt") else {})}
                  for c in superseded if (c.get("conclusion") or "").upper() not in PASSED]
    # the cache keeps 20; the ones dropped past that that status would count still reach its count line
    superseded_omitted = sum(1 for c in superseded[20:] if not c["ranNothing"])
    superseded = superseded[:20]
    base = node.get("baseRef") or {}
    required = set((base.get("branchProtectionRule") or {}).get("requiredStatusCheckContexts") or [])
    for rule in ((base.get("rules") or {}).get("nodes") or []):
        for item in ((rule.get("parameters") or {}).get("requiredStatusChecks") or []):
            required.add(item.get("context"))
    # A required check that has not reported yet (ci-status appears only when its run reaches it)
    # is pending, not absent: judging only the required checks present would call a run green early.
    for check in checks:
        if check.get("lastRealAttempt") and check.get("name") in required:
            check["required"] = True  # no isRequired on a run read by suite id: the base's rules decide
    reported = {c.get("name") for c in checks}
    return {
        "requiredMissing": sorted(name for name in required if name and name not in reported),
        "requiredNames": sorted(name for name in required if name),  # what the base requires (check_verdict)
        "number": node.get("number"), "url": node.get("url"), "title": node.get("title"),
        "state": node.get("state"), "isDraft": node.get("isDraft"), "merged": node.get("merged"),
        "mergedAt": node.get("mergedAt"), "mergeCommit": node.get("mergeCommit"), "mergeable": node.get("mergeable"),
        "mergeStateStatus": node.get("mergeStateStatus"), "headRefOid": node.get("headRefOid"),
        **({"headParent": head_parent} if head_parent else {}),
        "headRefName": node.get("headRefName"), "baseRefName": node.get("baseRefName"),
        "reviewDecision": node.get("reviewDecision"), "updatedAt": node.get("updatedAt"),
        **({"headParents": parents} if (parents := head_parents(node)) is not None else {}),
        "checkState": rollup.get("state"), "checks": checks, "superseded": superseded,
        "supersededOmitted": superseded_omitted,
        "checksTotal": contexts.get("totalCount", len(checks)),
        "checkCounts": check_counts(contexts),
        "checksTruncated": bool((contexts.get("pageInfo") or {}).get("hasNextPage")),
        # a read whose head commit came back null or absent (a latched or cut-short answer) read no rollup at all:
        # partial, so no wait calls it "nothing reported" or green (check_verdict, wait_step's deadline)
        **({"checksPageError": "graphql: no head commit in the read (rollup unread)"}
           if "commits" in node and not isinstance(((commits or [None])[0] or {}).get("commit"), dict) else {}),
    }


def split_unread(data: dict) -> dict:
    """DATA (parse_pr's answer) with its required names kept apart by how sure the read is: on a partial rollup
    (checksPageError) a required name not in `checks` may sit past the pages read, so it is `requiredUnread`, and
    `requiredMissing` (not reported, read in full) is empty. manaflow-ai/cmux#43194, 2026-11-15: a held page left
    "clippy (changed cmux-tui packages)" past page one, and status sent agents at that passed check as missing."""
    if not data.get("checksPageError"):
        return data
    unread = sorted(set(data.get("requiredUnread") or []) | set(data.get("requiredMissing") or []))
    data["requiredUnread"], data["requiredMissing"] = unread, []
    return data


def required_names(base: dict) -> set[str]:
    """The contexts a PR's base requires, from its classic protection and its rulesets (GraphQL baseRef)."""
    required = set((base.get("branchProtectionRule") or {}).get("requiredStatusCheckContexts") or [])
    for rule in ((base.get("rules") or {}).get("nodes") or []):
        for item in ((rule.get("parameters") or {}).get("requiredStatusChecks") or []):
            if item.get("context"):
                required.add(item["context"])
    return {name for name in required if name}


def known_steps(pairs: list[tuple[dict, dict]]) -> dict[str, list]:
    """Check node id -> [failedSteps, stepCount] from the cached data: a completed check keeps them."""
    known: dict[str, list] = {}
    for e, _ in pairs:
        for c in (((e["cache"] or {}).get("data") or {}).get("checks") or []):
            if c.get("id") and isinstance(c.get("failedSteps"), list):
                known[c["id"]] = [c["failedSteps"], c.get("stepCount")]
    return known


def slim_run(doc: dict) -> dict:
    keep = ("id", "name", "display_title", "status", "conclusion", "html_url", "head_sha", "head_branch",
            "event", "run_attempt", "created_at", "updated_at")
    return {k: doc.get(k) for k in keep}


def settled_pr(data: dict) -> bool:
    """A merged or closed PR: its failed steps are not read from GitHub (on 2026-11-10 cosmic-gray's daemon read 54
    jobs/{id} in ten minutes, most for merged cmux PRs). Steps already cached are still carried forward: `wait pr
    --until green|done` rules on a merged PR too, and a runner refusal inside the rescue grace is held by them."""
    return str(data.get("state") or "").upper() in {"MERGED", "CLOSED"}


def wants_steps(c: dict) -> bool:
    """A check whose steps the daemon reads once: a failure (which steps failed) or a cancellation
    (did any step run: the owned-pool rescue cancels a job still queued for a runner, then re-runs it)."""
    return bool(c.get("id")) and (c.get("conclusion") or "").upper() in STEP_FAILED | {"CANCELLED"}


def failed_steps(steps: list | None) -> list[str]:
    return [str(s.get("name")) for s in steps or [] if isinstance(s, dict)
            and str(s.get("conclusion") or "").upper() in STEP_FAILED]


def slim_jobs(doc: dict) -> list[dict]:
    keep = ("id", "name", "status", "conclusion", "html_url", "run_attempt", "runner_name", "labels",
            "started_at", "completed_at")
    return [{**{k: j.get(k) for k in keep}, "failedSteps": failed_steps(j.get("steps")),
             "stepCount": len(j["steps"]) if isinstance(j.get("steps"), list) else None}
            for j in doc.get("jobs") or []]


def slim_run_jobs(doc: Any) -> dict:
    """A run's job list as fill_steps_rest keeps it: each job's id, status, failed steps and step count."""
    doc = doc if isinstance(doc, dict) else {}
    return {"total": doc.get("total_count") or 0, "jobs": [
        {"id": j.get("id"), "status": j.get("status"), "failedSteps": failed_steps(j.get("steps")),
         "stepCount": len(j["steps"]) if isinstance(j.get("steps"), list) else None}
        for j in doc.get("jobs") or [] if isinstance(j, dict)]}


def settled_job(j: Any) -> bool:
    """A job a list showed completed with its steps: its failed steps and step count are final."""
    return isinstance(j, dict) and j.get("status") == "completed" and isinstance(j.get("failedSteps"), list) \
        and isinstance(j.get("stepCount"), int)


def jobs_attempt(jobs: list[dict] | None) -> int:
    """The newest attempt the job list covers (with filter=latest a re-run of failed jobs keeps the
    jobs that passed at their old attempt)."""
    return max((j.get("run_attempt") or 0 for j in jobs or []), default=0)


# A completed run attempt's job list, kept on disk with no expiry (2026-11-17, Leo: "so claude desktop shows rate limit
# on hover of the github links sometimes"; the shared REST pool at 0/5000, its top route GET .../actions/runs/{id}/jobs
# at 56 an hour, read by this daemon for a lane VM's `--jobs` watches relayed by the broker). A watched `--jobs` run was
# read again each cycle a reader touched it, and its job list with it, long after the attempt had finished: a completed
# attempt's jobs never change (a re-run is a new attempt, with a new run_attempt), so once a list is read with the run
# completed at that attempt and every job listed completed, read_jobs answers it from here with no request. A run still
# moving reads its list as before, with If-None-Match. Keyed by (repo, run id, attempt) like the lane-gh broker's kept
# actions/runs/N/attempts/A/jobs (cmuxterm-hq tools/lane-gh-broker/parts/36-immutable-cache.py), under BASE beside the
# job-log cache (BASE/logs) and evicted the same way: least recently read first past ATTEMPT_JOBS_MAX_BYTES. It holds
# the default (filter=latest) list read_jobs reads, slimmed (slim_jobs), so it outlives the run's cache entry
# (CACHE_KEEP) and a watch dropped and registered again later.
ATTEMPT_JOBS_DIR = "run-jobs"
ATTEMPT_JOBS_MAX_BYTES = 64 * 1024 * 1024  # a slimmed 50-job list is ~8 KB gzip'd: several thousand attempts


def attempt_jobs_done(run: dict | None, jobs: Any) -> int | None:
    """The attempt a job list is final for, else None: the run (as read with or before the list) completed at that
    attempt, the list is not empty, every job in it completed, and its newest job is of that attempt. A job a
    `needs:` held back is listed by then: the run completes only after every job it will run has."""
    if not isinstance(run, dict) or run.get("status") != "completed" or not isinstance(jobs, list) or not jobs:
        return None
    attempt = run.get("run_attempt") or 1
    if not isinstance(attempt, int) or isinstance(attempt, bool):
        return None
    if not all(isinstance(j, dict) and j.get("status") == "completed" for j in jobs) or jobs_attempt(jobs) != attempt:
        return None
    # A run that did not pass lists a job that did not either; a list that does not (caught between a "re-run failed
    # jobs" dropping the failed ones and listing their new attempt, say) is not kept: the next read asks again.
    if run.get("conclusion") not in RUN_OK and all(j.get("conclusion") in RUN_OK for j in jobs):
        return None
    return attempt


def attempt_jobs_path(repo: str, run_id: int, attempt: int) -> Path:
    owner, name = repo.lower().split("/", 1)
    return BASE / ATTEMPT_JOBS_DIR / owner / name / f"{int(run_id)}.{int(attempt)}.json.gz"


def attempt_jobs_get(repo: str, run_id: int, attempt: int) -> list[dict] | None:
    """The kept job list of that completed attempt, or None. A hit is marked used (its mtime) for eviction."""
    path = attempt_jobs_path(repo, run_id, attempt)
    try:
        with open(path, "rb") as f:
            doc = json.loads(gzip.decompress(f.read()))
    except (OSError, EOFError, ValueError, zlib.error):
        return None  # missing or damaged: a miss, and the next read replaces it
    jobs = doc.get("jobs") if isinstance(doc, dict) else None
    if not isinstance(jobs, list) or not jobs or not all(isinstance(j, dict) for j in jobs):
        return None
    with contextlib.suppress(OSError):
        os.utime(path)
    return jobs


def attempt_jobs_put(repo: str, run_id: int, attempt: int, jobs: list[dict]) -> None:
    """Keep that completed attempt's job list, replaced whole, then evict past the cap. Never raises: a full disk
    only means the next read asks GitHub."""
    path = attempt_jobs_path(repo, run_id, attempt)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{time.monotonic_ns()}.tmp")
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with open(tmp, "wb") as f:
            f.write(gzip.compress(json.dumps({"repo": repo.lower(), "run": int(run_id), "attempt": int(attempt),
                                              "jobs": jobs}, separators=(",", ":")).encode(), mtime=0))
        os.replace(tmp, path)
    except OSError:
        with contextlib.suppress(OSError):
            tmp.unlink()
        return
    kept_evict(BASE / ATTEMPT_JOBS_DIR, ".json.gz", ATTEMPT_JOBS_MAX_BYTES)


# ---------------------------------------------------------------- daemon


def newest_verdict(found: list[tuple[int, str, str]]) -> tuple[str, str]:
    """(status, conclusion) of a check from its runs (id, status, conclusion): the newest run with a verdict,
    so a later skipped, cancelled or still-running run never hides an earlier failure; the newest run when
    none has a verdict yet, but not a skipped twin while a run of that name is still going."""
    found = sorted(found)
    verdicts = [r for r in found if r[1] == "completed" and r[2] in VERDICTS]
    ran = [r for r in found if r[2] != "skipped"] or found
    _, status, conclusion = verdicts[-1] if verdicts else ran[-1]
    return status, conclusion


HEAD_CONTEXTS = """statusCheckRollup{contexts(first:100%s){pageInfo{hasNextPage endCursor} nodes{__typename
... on CheckRun{id databaseId name status conclusion startedAt completedAt checkSuite{databaseId app{slug}
workflowRun{databaseId event workflow{name databaseId}}}}
... on StatusContext{context state description}}}}"""

PR_CONTEXT_MAX_PAGES = 20  # 2,000 contexts per PR; beyond that the cache stays explicitly partial
# The follow-up pages' own share of the shared login's GraphQL hour, in points over the last hour. Past it a PR that
# still needs a page reads pending (checksPageError) until the hour frees room: paging every
# watched PR every cycle once spent 1678 of one daemon's 1958 points an hour (#1830), and the landers that need the
# same hour to read their gates must never be starved by a completeness read.
PR_PAGES_POINTS_PER_HOUR = 300
NAMED_READS_KEPT = 2000  # required_by_name's conditional answers kept; past it the oldest go first
# required_by_name's ETags and answers, kept across restarts and re-execs: an in-memory store lost them on every one,
# so the first read of each required name after it was a counted 200 instead of a free 304. On huge-blue
# (2026-11-15, a restart about every hour at :37) that burst was most of its REST share: 90 of its 148 counted
# REST an hour were these reads, and its share alarm fired about ten minutes after each restart.
NAMED_READS_FILE = "named-reads.json"


def slim_named(doc: Any) -> Any:
    """A by-name answer cut to what required_by_name reads (named_check_node's fields, a status's), so the kept store
    stays small on disk; anything else is kept as it came."""
    if isinstance(doc, dict) and isinstance(doc.get("check_runs"), list):
        keep = ("node_id", "name", "status", "conclusion", "details_url", "html_url", "id", "started_at", "completed_at")
        return {"check_runs": [{**{k: r.get(k) for k in keep}, "app": {"slug": (r.get("app") or {}).get("slug")}}
                               for r in doc["check_runs"] if isinstance(r, dict)]}
    if isinstance(doc, dict) and isinstance(doc.get("statuses"), list):
        keep = ("context", "state", "target_url", "created_at")
        return {"total_count": doc.get("total_count"),
                "statuses": [{k: s.get(k) for k in keep} for s in doc["statuses"] if isinstance(s, dict)]}
    return doc


def load_named_reads(doc: Any) -> dict[str, tuple[str | None, Any]]:
    """NAMED_READS_FILE's well-formed entries (path -> [ETag, answer]), oldest first."""
    reads = doc.get("reads") if isinstance(doc, dict) else None
    out: dict[str, tuple[str | None, Any]] = {}
    for path, pair in (reads if isinstance(reads, dict) else {}).items():
        if (isinstance(path, str) and isinstance(pair, list) and len(pair) == 2 and isinstance(pair[0], str)
                and isinstance(pair[1], dict)):
            out[path] = (pair[0], pair[1])
    return dict(list(out.items())[-NAMED_READS_KEPT:])


def named_check_node(run: dict) -> dict:
    """A REST check run read by name (required_by_name) as a statusCheckRollup context node. It is required (its
    name is), and its workflow is unknown: REST names only its suite, and parse_pr keys a check by workflow and name,
    so it never stands beside the same run read from the rollup (only names the rollup did not show are read)."""
    return {"__typename": "CheckRun", "id": run.get("node_id"), "name": run.get("name"),
            "status": upper(run.get("status")), "conclusion": upper(run.get("conclusion")),
            "detailsUrl": run.get("details_url") or run.get("html_url"), "databaseId": run.get("id"),
            "startedAt": run.get("started_at"), "completedAt": run.get("completed_at"), "isRequired": True,
            "checkSuite": {"conclusion": None, "app": {"slug": (run.get("app") or {}).get("slug")},
                           "workflowRun": None}}


def head_query(owner: str, repo: str, sha: str, cursor: str | None = None,
               pull_number: int | None = None) -> str:
    after = f', after:"{cursor}"' if cursor else ""
    required = f" isRequired(pullRequestNumber:{pull_number})" if pull_number is not None else ""
    contexts = (HEAD_CONTEXTS % after).replace("databaseId name status conclusion",
                                                f"databaseId name status conclusion{required}")
    if required:
        contexts = contexts.replace("... on StatusContext{context state description}",
                                    f"... on StatusContext{{context state description{required}}}")
    suites = "" if cursor else " " + SUITE_ATTEMPTS
    return (f'repository(owner:"{owner}",name:"{repo}"){{object(oid:"{sha}"){{... on Commit{{'
            + contexts + suites + "}}}")


def heads_query(keys: list[str]) -> str:
    """One aliased query for every head in KEYS (h0, h1, ...), with each one's CHECKS_OF_RECORD commit (m0, ...), plus
    the rate limit. Its repositories are literal (head_query), which is how AppPool.owner_of finds their owner."""
    parts = []
    for i, key in enumerate(keys):
        _, owner, repo, sha = split_key(key)
        parts.append(f"h{i}: " + head_query(owner, repo, sha))
        if (owner, repo) in CHECKS_OF_RECORD:
            parts.append(f"m{i}: " + head_query(*CHECKS_OF_RECORD[(owner, repo)], sha))
    return "query{rateLimit{limit remaining resetAt cost}\n" + "\n".join(parts) + "}"


def heads_repos(keys: list[str]) -> list[str]:
    """The repositories ("OWNER/REPO") heads_query(KEYS) reads: each head's, and its CHECKS_OF_RECORD one."""
    out = []
    for key in keys:
        _, owner, repo, _ = split_key(key)
        out.append(f"{owner}/{repo}")
        if (owner, repo) in CHECKS_OF_RECORD:
            out.append("/".join(CHECKS_OF_RECORD[(owner, repo)]))
    return out


def fold_contexts(nodes: list, runs: dict, statuses: dict, ids: dict, prefix: str = "",
                  order: dict | None = None, failed: dict | None = None) -> None:
    """Add one page of a head's contexts to runs (`workflow / job` -> [(id, status, conclusion)]), statuses
    (`status / context` -> (status, conclusion, state)) and ids (failed Actions jobs). prefix (`OWNER/REPO: `) keys
    another repository's checks apart, so a same-named check there never stands in for one here (CHECKS_OF_RECORD).
    A status's `error` is folded into the conclusion `failure` (every reader of `found` counts it red), and its own
    state is kept beside it (head_data's statusStates): an `error` is a poster that gave no verdict, which a reader
    such as a fallback dispatcher must tell apart from a red. `failed` (optional) gets each failure's databaseId ->
    node id, for the step counts head_steps reads."""
    for item in nodes or []:
        if not item:
            continue
        if item.get("__typename") == "StatusContext":
            state = (item.get("state") or "").lower()
            statuses[f"{prefix}status / {item['context']}"] = (
                "in_progress" if state in ("pending", "expected") else "completed",
                "failure" if state == "error" else state, state,
                item.get("description") if isinstance(item.get("description"), str) else None)
            continue
        suite = item.get("checkSuite") or {}
        slug = (suite.get("app") or {}).get("slug")
        owner = (((suite.get("workflowRun") or {}).get("workflow") or {}).get("name") or slug or "check")
        key = f"{prefix}{owner} / {item['name']}"
        conclusion = (item.get("conclusion") or "").lower()
        runs.setdefault(key, []).append((item.get("databaseId") or 0, (item.get("status") or "").lower(), conclusion))
        if order is not None:  # head_data's `runs`: each run's own id and times, and its identity (run_identity)
            order.setdefault(key, []).append([item.get("databaseId") or 0, (item.get("status") or "").lower(),
                                              conclusion, item.get("startedAt") or "", item.get("completedAt") or "",
                                              run_identity(item, suite)])
        if slug == "github-actions" and conclusion == "failure" and item.get("databaseId"):
            ids.setdefault(key, []).append(item["databaseId"])
        if failed is not None and conclusion == "failure" and item.get("databaseId") and item.get("id"):
            failed[item["databaseId"]] = item["id"]  # head_steps reads each one's step count


def run_identity(item: dict, suite: dict) -> dict:
    """What tells one check run's run apart from another's (head_data's `runs`, a row's sixth field): its Actions run's
    databaseId, event and workflow databaseId and name (the key's prefix, so a reader can split the job's own name off), its app's slug and its check suite's databaseId, each only when read,
    and lastRealAttempt for a run of an older suite attempt
    (last_real_contexts) that GitHub's rollup no longer lists."""
    run = suite.get("workflowRun") or {}
    workflow = run.get("workflow") or {}
    app = suite.get("app")
    out = {"run": run.get("databaseId"), "workflow": workflow.get("databaseId"), "workflowName": workflow.get("name"),
           "event": run.get("event"),
           "app": app.get("slug") if isinstance(app, dict) else None, "suite": suite.get("databaseId"),
           "lastRealAttempt": True if item.get("lastRealAttempt") else None}
    if app is None and "app" in suite:
        out["appNull"] = True  # GitHub's documented null app, not an unread one
    return {k: v for k, v in out.items() if v is not None}


def attach_steps(data: dict, counts: dict) -> None:
    """Add `steps` (the job's step count) to the identity of each failed row of data's `runs` that COUNTS (check run
    databaseId -> count) knows. A failed job with 0 steps never ran: land-judge's runner_refused reads a stored red
    as it reads a live one. A row without it is unknown, never zero; the key is an addition, older readers skip it."""
    for rows in (data.get("runs") or {}).values():
        for row in rows:
            if len(row) > 5 and isinstance(row[5], dict) and row[2] == "failure" and row[0] in counts:
                row[5]["steps"] = counts[row[0]]


# A head's `runs` (head_data's ORDER): every check run fold_contexts read at the head, by key, as [databaseId, status,
# conclusion, startedAt, completedAt, identity] (run_identity: its Actions run, workflow, event, app and suite, so a
# reader can collapse a rerun's attempts and drop a superseded cancel as a live rollup read does; leo-workspace
# land-judge's head checks read it before going live). `found` keeps one verdict per name and no order, so a reader could not tell a
# replay that ran after its shard's newest rerun from an older one: leo-workspace merge_hold's webview verdict could
# only hold on the cache (Codex F1 on lw#4070), and while the shared login's GraphQL hour was spent its live read and
# the head's own check reads all failed, so cmux#46128, #46236 and #46782 sat at glaeda land's 6 h retry deadline on
# green heads (2026-11-20). With each run's id and times the cache orders a head as its live check runs do. A reader
# that finds no `runs` (an entry written before this) has no ordering evidence, as before.
def head_data(sha: str, runs: dict, statuses: dict, ids: dict, order: dict | None = None) -> dict:
    found = {key: list(newest_verdict(rs)) for key, rs in runs.items()}
    found.update({key: list(value[:2]) for key, value in statuses.items()})
    # no check yet is not "all finished": a push's checks appear a few seconds later
    running = any(st != "completed" for rs in runs.values() for _, st, _ in rs)
    settled = bool(found) and not running and all(status == "completed" for status, _ in found.values())
    states = {key: value[2] for key, value in statuses.items() if len(value) > 2}
    data = {"sha": sha, "found": found, "ids": ids, "settled": settled, "statusStates": states}
    # each status's description where the read gave one (GraphQL's always; REST's combined status too): a reader
    # judging from the cache (land-judge's fast-gates base, a ws-check standby post) reads what a live read would
    said = {key: value[3] for key, value in statuses.items() if len(value) > 3 and value[3] is not None}
    if said:
        data["statusDescriptions"] = said
    if order is not None:
        data["runs"] = {key: sorted(rs, key=lambda r: int(r[0] or 0)) for key, rs in order.items()}
    return data


def _bounded(value: Any, default: float, low: float, high: float) -> float:
    """value when it is a plain number within [low, high], else default."""
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value != value:
        return default
    return value if low <= value <= high else default


def policy_host() -> str:
    """This host's name in the fleet policy: update.json's host, else the short hostname."""
    doc = read_json(UPDATE_CONFIG)
    host = doc.get("host") if isinstance(doc, dict) else None
    return host if isinstance(host, str) and host else socket.gethostname().split(".")[0].lower()


def policy_doc() -> dict:
    """The fleet policy's default, then its hosts[this host], then ~/.config/glaeda/gh-daemon.json."""
    doc: dict = {}
    fleet = read_json(FLEET_POLICY)
    if isinstance(fleet, dict):
        hosts = fleet.get("hosts") if isinstance(fleet.get("hosts"), dict) else {}
        for layer in (fleet.get("default"), hosts.get(policy_host())):
            doc.update(layer if isinstance(layer, dict) else {})
    local = read_json(DAEMON_CONFIG)
    doc.update(local if isinstance(local, dict) else {})
    return doc


def daemon_policy() -> dict:
    """The daemon's pacing: ~/.config/glaeda/gh-daemon.json over the fleet policy over the module defaults.

    {"cycle": 60, "commentCycle": 15, "restShare": 0.4,
     "floors": {"rest": {"floor": 1500, "reserve": 300}, "graphql": {"floor": 500, "reserve": 100}},
     "forceLow": ["graphql"]}

    A bucket's floor is where it counts as low: below it the daemon polls it LEAN_FACTOR times less
    often and serves what it can from the other bucket. forceLow treats the buckets it names as below
    their floors whatever GitHub says, to show the fallback live without draining a real quota.

    Every key is optional, and a value that is not a number in range keeps its default, so a typo
    can neither stop the daemon nor turn it into a busy loop. A reserve above its floor keeps both
    defaults: "stop" must come after "lean". restShare 0 sends every PR and run read to GraphQL
    (a failed attempt's job list is still read once: the cap never holds that back).
    Read every tick, so an edit applies without a restart."""
    doc = policy_doc()
    cycle = int(_bounded(doc.get("cycle"), CYCLE, 15, 900))
    comment = int(_bounded(doc.get("commentCycle"), COMMENT_CYCLE, 5, 300))
    floors = dict(FLOORS)
    write_floors = dict(FLOORS)  # the configured (floor, reserve), before the hard reserve: the outbox's writes
    hard = hard_reserve_floor()
    given = doc.get("floors") if isinstance(doc.get("floors"), dict) else {}
    for bucket, (floor, reserve) in FLOORS.items():
        one = given.get(bucket) if isinstance(given.get(bucket), dict) else {}
        f = int(_bounded(one.get("floor"), floor, 0, 100000))
        r = int(_bounded(one.get("reserve"), reserve, 0, 100000))
        f, r = (f, r) if r <= f else (floor, reserve)
        write_floors[bucket] = (f, r)
        # Never under the hard reserve (hard_reserve_floor): a config's lower reserve is raised to it. A floor the
        # raised reserve reaches is raised above it by the band it had, so "lean" still comes before "stop" (GraphQL's
        # module default 500/100 becomes 900/500, not 500/500 with no lean band at all).
        raised = max(r, hard[bucket])
        floors[bucket] = (f if f > raised else raised + (f - r), raised)
    per_minute = int(_bounded(doc.get("graphqlPerMinute"), GRAPHQL_PER_MINUTE, 1, 5000))
    alarms = doc.get("alarms") if isinstance(doc.get("alarms"), dict) else {}
    consumer_setting = alarms.get("consumerShare")
    consumer = consumer_setting if isinstance(consumer_setting, dict) else {}
    return {"cycle": cycle, "commentCycle": comment, "graphqlPerMinute": per_minute,
            "alarms": {"pool": alarms.get("pool") is True, "share": alarms.get("share") is not False,
                       "consumerShare": False if consumer_setting is False else {
                           "fraction": float(_bounded(consumer.get("fraction"), CONSUMER_SHARE_FRACTION, 0.01, 1.0)),
                           "minCalls": int(_bounded(consumer.get("minCalls"), CONSUMER_SHARE_MIN_CALLS, 1, 5000))},
                       "stale": alarms.get("stale") is not False, "staleRestart": alarms.get("staleRestart") is not False,
                       "restLeft": int(_bounded(alarms.get("restLeft"), ALARM_REST_LEFT, 0, 100000)),
                       "paceShare": float(_bounded(alarms.get("paceShare"), ALARM_PACE_SHARE, 0.0, 1.0))},
            "cycles": {"pr": cycle, "run": cycle, "comment": comment, "head": cycle},
            "floors": floors, "writeFloors": write_floors, "hardReserve": hard, "restShare": float(_bounded(doc.get("restShare"), REST_SHARE, 0.0, 1.0)),
            # restYield out of range (or not a number) is left out, so the default (no yield) holds
            **({"restYield": int(doc["restYield"])} if isinstance(doc.get("restYield"), (int, float))
               and not isinstance(doc.get("restYield"), bool) and 0 <= doc["restYield"] <= 100000 else {}),
            "forceLow": tuple(b for b in ("rest", "graphql")
                              if isinstance(doc.get("forceLow"), list) and b in doc["forceLow"])}


def consumer_policy() -> dict:
    """CONSUMER_DEFAULTS with the keys of ~/.config/glaeda/gh-consumers.json laid over them."""
    policy = {**CONSUMER_DEFAULTS, "reserved": dict(CONSUMER_DEFAULTS["reserved"])}
    doc = read_json(CONSUMERS_CONFIG)
    if isinstance(doc, dict):
        if isinstance(doc.get("reserved"), dict):
            policy["reserved"] = {str(k): int(v) for k, v in doc["reserved"].items() if isinstance(v, (int, float))}
        for k in ("limit", "pool"):
            if isinstance(doc.get(k), (int, float)):
                policy[k] = int(doc[k])
    return policy


def merge_counter(counters: list[dict], seen: dict) -> list[dict]:
    """counters with one reading folded in. A reading whose reset is within RESET_JITTER of a known counter's is
    that counter (GitHub's reset for one window can differ by a second between answers), and within one window a
    counter only goes down, so the lower remaining wins whichever arrived last; the freshest seenAt and the
    later reset are kept."""
    out, merged = [], False
    for c in counters:
        if not merged and abs(c["reset"] - seen["reset"]) <= RESET_JITTER:
            c = {**c, "limit": seen.get("limit", c.get("limit")), "remaining": min(c["remaining"], seen["remaining"]),
                 "reset": max(c["reset"], seen["reset"]), "seenAt": max(c["seenAt"], seen["seenAt"])}
            tags = sorted(set(c.get("counters") or []) | set(seen.get("counters") or []))
            if tags:
                c["counters"] = tags  # a counter keeps the tag any of its readings gave it (ACTIONS_COUNTER_PATH)
            merged = True
        out.append(c)
    if not merged:
        out.append(dict(seen))
    return sorted(out, key=lambda c: c["reset"])


def rest_counters(budget: dict, key: str = "restCounters") -> list[dict]:
    """The well-formed entries of budget["restCounters"] (Daemon.settle_rest), or of budget["graphqlCounters"]."""
    out = []
    for c in budget.get(key) or []:
        if (isinstance(c, dict) and isinstance(c.get("reset"), (int, float)) and isinstance(c.get("remaining"), int)
                and isinstance(c.get("seenAt"), (int, float))):
            out.append(c)
    return out


# -- the land queue's check snapshot (glaeda-gh land -> land_judge explain)
#
# cosmic-gray, 2026-11-17: the shared login ran dry before every reset, and the land queue (session glaeda-land) was
# its top caller, 606 REST in an hour, mostly `GET commits/SHA/check-runs` reads land_judge made for each queued PR at
# each judgment: every `land-judge explain` read the head's whole status rollup (and its path-routing check runs by
# name) again, though this daemon had just read the same head for every `glaeda-gh status pr` / `wait pr` caller.
# Now, for each PR the land queue holds, a full read here also keeps the head's raw rollup context nodes (the fields
# land_judge's HEAD_REDS_QUERY asks, every page) in ROLLUP_DIR, and the queue hands land_judge a copy at the judged
# head (LAND_SNAPSHOT_ENV, explain only). land_judge judges those nodes with the parser its own GraphQL read uses, so
# its verdict is the same; the final pinned merge (the shim's own judgment) and its evidence are still read live. A
# head the snapshot does not hold yet is read by the daemon on its next tick (rollup_stale makes that tick a full
# read), never by each waiter. Nodes the daemon folds in from other sources are left out: a REST read by name
# (required_by_name) and a suite's last real attempt (add_last_real_contexts) are not in land_judge's own read.
ROLLUP_DIR = "rollups"
ROLLUP_SCHEMA = "glaeda-gh-rollup/v1"
ROLLUP_SWEEP_EVERY = 3600.0  # snapshots of PRs the land queue no longer holds are removed this often
ROLLUP_ALL = "\0every page"  # page_pr_contexts' REQUIRED for a read of every page: no context has this name


def rollup_path(key: str) -> Path:
    return BASE / ROLLUP_DIR / file_name(key)


def read_rollup(key: str) -> dict | None:
    doc = read_json(rollup_path(key))
    return doc if isinstance(doc, dict) and doc.get("schema") == ROLLUP_SCHEMA and doc.get("key") == key else None


def broker_repo_slugs() -> dict[str, str]:
    """The OWNER/REPO slugs this host has a checkout of, as the broker recorded them. A local file read: it costs no
    quota and is never required, so a missing or damaged store is simply no hint."""
    with contextlib.suppress(Exception):
        doc = read_json(broker_repos_path())
        repos = doc.get("repos") if isinstance(doc, dict) else None
        if isinstance(repos, dict):
            return {str(k): str(v) for k, v in repos.items() if isinstance(k, str)}
    return {}


def write_failure(item: dict, status: int, doc: dict, known: dict[str, str] | None = None) -> str:
    """One line for a write GitHub refused, which is all its caller ever sees (`post status ID` prints it).

    It names the target, because the target is a word the caller typed and GitHub's own message never repeats it:
    on 2026-11-21 `post pr manaflow-ai/glaeda` recorded `HTTP 422: Validation Failed (invalid)` and
    `post comment manaflow-ai/glaeda#2395` recorded `HTTP 404: Not Found`, while the wrong word in both was the
    owner (glaeda is teamleaderleo/glaeda). It also keeps GitHub's `resource` and `field` next to its `code`, which
    is what turns `(invalid)` into `(PullRequest.head: invalid)`. One line, no newline: readers take the last line.
    """
    repo = str(item.get("repo") or "")
    parts = []
    for e in doc.get("errors") or []:
        if not isinstance(e, dict):
            continue
        if e.get("message"):  # GitHub wrote the sentence; its code adds nothing to it
            parts.append(str(e["message"]))
            continue
        where = ".".join(str(e[k]) for k in ("resource", "field") if e.get(k))
        code = str(e.get("code") or "")
        part = f"{where}: {code}" if where and code else where or code
        if part:  # an error dict with none of the three says nothing; empty parens say less than no parens
            parts.append(part)
    line = f"HTTP {status}: {doc.get('message') or ''}".rstrip().rstrip(":")  # a body with no message: no bare colon
    if parts:
        line += f" ({'; '.join(parts)})"
    if repo:
        number = item.get("number")
        reached = f"{repo}#{number}" if number else repo
        # Every status, not only 404: the 422 that started this (`post pr manaflow-ai/glaeda`) read as a bad head
        # branch precisely because the line never said which repository the head was being pushed into.
        line += f": writing {reached}"
        if status in (403, 404):
            line += (" -- no such target this login can write to: the repository (wrong owner, renamed, or no"
                     " access)" + (f" or the number {number}" if number else ""))
        name = repo.split("/")[-1]
        elsewhere = sorted(s for s in (known or {}) if s != repo and s.split("/")[-1] == name)
        if elsewhere:
            line += f"; a repository named {name} is known here as {', '.join(elsewhere)}"
    return " ".join(line.split())


class Daemon:
    def __init__(self, transport: Callable = http, token: Callable[[], str] = gh_token,
                 controller: Any = "env", upstream: Any = "config", app_pool: Any = "auto") -> None:
        self.transport = transport
        self.last_request_source = "login"  # credential used by the most recent request (App or login)
        # The ci-watch App's tokens for repo reads (AppPool); "auto" finds them on this host, None keeps every read on
        # the login.
        self.app_pool: AppPool | None = (
            AppPool(clock=lambda: self.clock()).with_spares(APP_POOL_SPARES) if app_pool == "auto" else app_pool)
        self.last_app_pool: AppPool | None = None  # the pool of the last App request (a spare's answer is its own)
        # False for an upstream host's direct read: the lane-gh broker answers GET branches/B from git (the tip, no
        # protection, and on 2026-11-16 no answer within 60 s), so fetch_pr_rest takes GraphQL's last word instead.
        self.reads_protection = True
        # False for that read too: the broker answers no ETag (broker_transport), so an issues/N read can never vouch
        # for a kept pull (rest_pull's 304 probe) and is not sent (DIRECT_PARTS says what that read cost).
        self.etags = True
        # "config" re-reads UPSTREAM_CONFIG every tick, so writing or removing it switches the mode
        # without a restart; a test passes a callable (request -> answer) or None.
        self.upstream_source = upstream
        self.upstream_at = float("-inf")  # the last full upstream read
        self.upstream_end = float("inf")  # time.monotonic() past which this tick sends the upstream nothing more
        self.upstream_cut: str | None = None  # the part ("keys" or "heads") the last tick's budget left unsent
        # A lane VM's own read token (ReadTokenPool): "config" reads upstream.json; a test sets read_token_source to a
        # pool and read_transport to its fake GitHub.
        self.read_token_source: Any = None
        self.read_transport: Callable | None = None
        self.read_pool: ReadTokenPool | None = None
        self.read_reader: Daemon | None = None
        self.read_served = 0
        self.upstream_status: dict[str, Any] | None = None
        # "env" (or any callable) is re-read every tick, so a daemon follows a controller move
        # (cmux-fleet-client's client.json repointed) without a restart; an instance stays fixed.
        self.controller_source: Callable[[], Any] | None = (
            Controller.from_env if controller == "env" else controller if callable(controller) else None)
        self.controller = self.controller_source() if self.controller_source else controller
        self.controller_down_until = 0.0
        self.controller_feed_at = float("-inf")
        self.feed_held: list[dict] = []  # feed pages read between a tick's reads, for the next read_controller
        self.feed_between = False  # feed_between_reads is reading (a request it makes must not read again)
        self.feed_after_controller = False  # this tick is past its controller phase: its reads may read the feed
        self.tick_thread: int | None = None  # the thread running tick (feed_due reads the feed on it alone)
        self.controller_failures = 0
        self.controller_budget_end = float("inf")  # time.monotonic() past which this tick asks the controller nothing
        self.controller_filled: set[str] = set()  # watched runs the controller tracks, while its feed answers
        self.controller_cursor: int | None = None
        self.controller_seen: dict[str, bool] = {}  # watched run key -> the controller knows the run
        self.controller_status: dict[str, Any] = {"state": "off" if self.controller is None else "starting"}
        self.nudged: set[str] = set()  # PRs (and heads) a check event touched since their last fetch
        self.land_dirty: set[str] = set()  # event/cache keys retained for LandQueue after due() consumes nudged
        self.controller_ok_at = float("-inf")  # the last time the change feed answered
        self.fed_repos: dict[str, float] = {}  # owner/repo (lowercase) -> the last event the feed delivered for it
        # "pr:owner/repo#N", "sha:owner/repo@SHA", "branch:owner/repo@B" -> when the feed last delivered an event
        # for it (LAND_FEED_QUIET_MAX's comment), and since when the feed has answered without a gap (None: down)
        self.feed_marks: dict[str, float] = {}
        self.feed_live_since: float | None = None
        self.feed_unstarved = 0  # PR waits not handed back as starved: the feed showed their copy current
        # On an upstream host: PR key -> the upstream's feed view of it (feed_view) and when it was given (answeredAt)
        self.upstream_feed: dict[str, dict] = {}
        self.feed_view_saved: tuple | None = None  # what save_feed_view last wrote (it writes only on a change)
        self.reexec_waiting: float | bool = False  # since when an update has waited on a running land step (serve)
        self.land_queue: LandQueue | None = None  # `glaeda-gh land` (made when BASE/land first exists)
        self.rollups: dict[str, tuple[Any, Any]] = {}  # key -> (head, fp) of its ROLLUP_DIR snapshot, as last written
        self.rollup_keys: tuple[float, frozenset[str]] = (float("nan"), frozenset())  # (self.now, rollup_wanted)
        self.rollup_swept = float("-inf")
        self.on_event_procs: dict[str, subprocess.Popen] = {}  # on-event commands started and not reaped yet, by key
        self.on_event_pending: bool | None = None  # whether on-event.json holds runs to resolve (None: not read yet)
        self.on_event_seen: tuple | None = None  # on-event.json's stat when on_event_pending was learned
        self.on_event_kept: list[dict] = []  # matching runs a busy state lock held back: the cursor is past them
        self.on_event_next: str | None = None  # the pending key a tick's deadline cut off: the next tick starts there
        self.on_event_problems: set[str] = set()  # config problems already logged
        self.gql_reason = "other"  # what the GraphQL query being sent reads, for daemon.json graphqlBy
        self.gql_log: list[tuple[float, str, int]] = []  # (time, reason, points) per GraphQL query, last hour
        # REST path -> (ETag, answer) of required_by_name's reads, so an unchanged one is a free 304, kept on disk
        # (NAMED_READS_FILE) so a restart or re-exec still asks with the ETag
        self.named_reads: dict[str, tuple[str | None, Any]] = load_named_reads(read_json(BASE / NAMED_READS_FILE))
        self.named_dirty = False
        self.share_pace_at = float("-inf")  # the last share-pace log line (share_alarm)
        self.share_over_at = float("-inf")  # the last share-over log line (share_alarm: past the cap, the pool fine)
        self.consumer_share_at = float("-inf")  # last fleet consumer-share read, bounded to one alarm window
        self.consumer_share_verdict: tuple[str, str, dict] | None = None
        self.token_source = token
        self.token: str | None = None
        doc = read_json(BASE / "budget.json")
        self.budget: dict[str, dict] = doc if isinstance(doc, dict) else {}
        self.saved_budget = json.loads(json.dumps(self.budget))
        fell_back = read_json(BASE / CONTROLLER_FALLBACK_FILE)
        self.controller_fallback: dict = fell_back if isinstance(fell_back, dict) else {}
        self.saved_controller_fallback = json.loads(json.dumps(self.controller_fallback))
        self.controller_missed_deadline = False  # the controller is out for a missed deadline, not another error
        self.backoff: dict[str, float] = {"rest": 0.0, "graphql": 0.0}
        self.secondary_until = 0.0  # a secondary 403 holds both buckets until then
        self.secondary_strikes = 0  # secondary 403s since the last clean answer: each doubles the hold
        self.minute_sent: dict[str, list[float]] = {"rest": [], "graphql": []}  # send times, the per-minute cap
        self.budget_retry = 0.0  # /rate_limit is left alone until this time after a refusal
        self.rate_limit_at = float("-inf")  # when /rate_limit last answered (refresh_budget)
        self.last_cycle: dict[str, float] = {kind: 0.0 for kind in CYCLES}
        self.now = time.time()
        self.errors: list[str] = []
        self.attempted: dict[str, float] = {}  # when each key was last fetched: a new one at most once per cycle
        self.consumer_sent: dict[tuple[str, str], float] = {}  # (head, consumer): last sent upstream (upstream_read)
        self.rest_tried: dict[str, float] = {}  # when a REST read of each key last ended, answered or failed
        # when a confirming read (wait_confirms) of each run was last made ahead of the rest, and the finish it was
        # for (rest_run): one such read per finish
        self.confirm_tried: dict[str, tuple[float, dict]] = {}
        # the runs this tick's due() put first as confirming reads: their finish, and their cache's fetchedAt then
        self.confirming: dict[str, tuple[dict, Any]] = {}
        self.repo_parts: dict[str, dict] = {}  # REST path -> {"at", "part"}: answers every watch on them shares
        # REST_PREFETCH_*: (method, path, ETag) -> a request sent early, until its read takes it or the tick settles it
        self.prefetched: dict[tuple[str, str, str], dict] = {}
        self.prefetch_workers = REST_PREFETCH_WORKERS  # 0 sends every request on the loop's thread, as before
        self.prefetch_pool: Any = None
        self.prefetch_stats = {"sent": 0, "taken": 0, "unasked": 0}
        self.cut_reads: dict[str, float] = {}  # key -> the tick its REST read was first cut off partway (RESUME_MAX)
        self.resume_key, self.resume_from = "", float("inf")  # the read resuming now, and since when its parts stand
        self.job_lists_asked: dict[str, float] = {}  # a run's job-list page -> the tick that last asked it
        self.deferred_before: dict[str, float] = {}  # deferred by the last tick: when each was first deferred
        self.deferred_since: dict[str, float] = {}  # when each key still deferred was first deferred
        self.sent: list[tuple[float, str]] = []  # (time, rest|rest304|graphql) for the last hour's counts
        self.paths: dict[str, str] = dict(BUCKETS)  # the bucket each kind reads over now
        self.reads: list[tuple[float, str, str]] = []  # (time, kind, bucket) per entry read, for the last hour
        self.read_secs: list[tuple[float, str, str, float, int]] = []  # (time, kind, bucket, seconds, entries) read_seconds
        self.batch: dict[str, int] = {kind: GQL_BATCH_START for kind in CYCLES}  # entries per GraphQL query
        self.clean: dict[str, int] = {kind: 0 for kind in CYCLES}  # clean GraphQL queries in a row
        # key -> {"at": last lone read, "fails": lone timeouts in a row, "oks": lone answers in a row}
        self.heavy: dict[str, dict] = {}
        self.gql_down_streak = 0  # GraphQL answers in a row that were a 5xx or no answer (GQL_DOWN)
        self.gql_down_since = 0.0  # when the first of them came
        self.gql_down_strikes = 0  # times GraphQL was taken out since its last clean answer: each doubles the next
        self.gql_down_until = 0.0  # GraphQL reads go to REST until then (gql_down)
        self.refresh_notes: dict[tuple[str, str], dict] = {}  # (source, error) -> rate-limit state (refresh_note)
        self.newest_data: dict[str, float | None] = {}  # oldest_data's: per kind, the freshest live watch's data age
        self.since: dict[str, float] = {}  # key -> when the daemon first saw it watched, for oldestData
        self.stale_waited: dict[str, float | None] = {}  # oldest_data's, for the watches a wait is blocked on
        self.explained_at: dict[str, float] = {}  # kind -> the last tick stale_explained(kind) explained its old data
        self.stale_streak = 0  # ticks in a row the stale alarm found starvation nothing explains (the valve)
        self.valve_due: dict | None = None  # set by stale_valve: serve() restarts the daemon after this tick
        self.started_tick: float | None = None  # the first tick's clock, for the valve's own-uptime bound
        self.recent_errors: dict[str, float] = {}  # error -> when last seen (daemon.json recentErrors)
        self.beat = float("-inf")
        self.status: dict[str, Any] = {}  # the last good tick's daemon.json
        # Read progress (READ_PROGRESS_WINDOW): when this daemon stored a read, per kind; (at, phase, seconds) its ticks
        # spent; the GitHub request in flight ({"what", "since"} on time.monotonic()) and the last one that ended.
        self.read_done: dict[str, list[float]] = {kind: [] for kind in CYCLES}
        self.spent: list[tuple[float, str, float]] = []
        self.in_call: dict[str, Any] | None = None
        self.last_call: dict[str, Any] | None = None
        self.stall_said: dict[str, str] = {}  # kind -> the cause stall_cause last logged (said once per cause)
        self.stale_now: tuple[str, str, dict] | str | None = None  # this tick's stale verdict (stale_verdict)
        self.stale_reason = ""  # the reason the alarm that verdict came from gave (stall_cause's sentence)
        self.stale_last: dict[str, Any] | None = None  # the last verdict that was not fresh (stale_record)
        self.defer_why: dict[str, tuple[float, str]] = {}  # kind -> (when, why) its reads were last deferred
        self.blocked: dict[str, int] = {}  # kind -> open watches a wait or a due land is blocked on (oldest_data)
        self.paced_at: dict[str, float] = {}  # kind -> when graphqlPerMinute last held its reads (batched)
        self.plain_at: dict[str, float] = {}  # kind, or "rest" -> last read of a watch nothing is blocked on
        self.failing: dict[str, Any] | None = None  # set while ticks raise: the latest error and since when
        self.tick_deadline = float("inf")  # time.monotonic() after which this tick starts no request
        self.deferred: set[str] = set()  # keys a tick ran out of time for: read first on the next tick
        self.post_at = float("-inf")  # the last content write (post_tick)
        self.post_tried = float("-inf")  # the outbox's own clock when post_tick last ran (post_due)
        self.clock_real = True  # tick(now=...) in tests pins the clock
        held = (read_json(BASE / "daemon.json") or {}).get("outbox") or {}
        # GitHub's secondary limit holds the outbox until then
        self.post_hold = saved_hold(held.get("holdUntil"), time.time())
        self.post_backoff = POST_BACKOFF  # the next hold without a Retry-After
        self.pause_until = 0.0  # the login's create pause (content_pause_until), as last read
        self.pause_next = float("-inf")  # when it may next be asked
        self.pause_ask: threading.Thread | None = None  # the ask in flight (content_pause_until)
        self.pause_result: tuple[str, Any] | None = None  # its outcome, set by the thread before it ends
        self.pause_first_ask: float | None = None  # clock of this daemon's first ask
        self.pause_answered_at: float | None = None  # clock of the last answer
        self.pause_failures = 0  # asks in a row that failed or timed out
        self.pause_timeouts = 0  # of those, the ones that timed out
        self.pause_error: str | None = None  # the last failed ask's error
        self.pause_blind_logged = False  # past CONTENT_PAUSE_BLIND_MAX this outage, logged once
        self.pause_absent = False  # the keeper answered a usage error: it has no content-pause (CONTENT_PAUSE_USAGE)
        self.pause_report: threading.Thread | None = None  # the --hold report in flight (report_content_pause)
        self.pause_report_want: tuple[float, str] | None = None  # the hold it is to report next
        self.pause_report_lock = threading.Lock()
        self.pause_reported: tuple[float, float] | None = None  # (clock, until) of the latest report, the max until
        saved = read_json(BASE / CONSUMERS_FILE)
        spends = saved.get("spends") if isinstance(saved, dict) else None
        # consumer -> times of the head reads charged to it in the last hour
        self.head_spend: dict[str, list[float]] = {
            str(k): [float(t) for t in v if isinstance(t, (int, float))]
            for k, v in (spends or {}).items() if isinstance(v, list)}
        self.payer: dict[str, tuple[str, float]] = {}  # head key -> (consumer, time) charged for a read in flight
        self.spill: list[dict] = []  # entries a fetch could not finish because GraphQL stopped partway
        self.limited: list[dict] = []  # entries the last fetch got only partly: GitHub's per-query resource limit
        self.gql_first = 0  # index of the kind read first next tick (rotates after the per-minute ceiling held one)
        self.gql_paced: str | None = None  # the kind the ceiling held this tick
        self.gql_limited = False  # a GraphQL answer since the last fetch began said the primary limit is reached
        self.refunded: dict[str, str] = {}  # head key -> the consumer a failed read refunded, this tick
        self.denied: dict[str, float] = {}  # consumer -> when a head read it needed was refused for budget
        self.saved_consumers: str = ""
        self.policy = daemon_policy()  # re-read at the start of every tick
        # minute (epoch // 60) -> counted REST requests sent in it. Per minute, so the cap's check is
        # at most 61 additions however busy the hour was, and on disk, so a restart does not hand the
        # daemon a fresh share of an hour it already spent.
        spend = read_json(BASE / REST_SPEND_FILE)
        self.rest_minutes: dict[int, int] = {
            int(k): int(v) for k, v in (spend if isinstance(spend, dict) else {}).items()
            if str(k).isdigit() and isinstance(v, int) and not isinstance(v, bool) and v > 0}
        self.saved_rest_minutes = dict(self.rest_minutes)
        hours = read_json(BASE / REST_HOURS_FILE)
        self.rest_hours: dict[int, int] = {
            int(k): int(v) for k, v in (hours if isinstance(hours, dict) else {}).items()
            if str(k).isdigit() and isinstance(v, int) and not isinstance(v, bool) and v > 0}
        # the spend log (SPEND_FILE): minute -> "bucket\troute\tkind\trepo" -> [requests, counted, points]
        self.spend: dict[int, dict[str, list[int]]] = load_spend(read_json(BASE / SPEND_FILE))
        self.spend_saved_at = float("-inf")
        self.spend_dirty = False
        self.caller: tuple[str, ...] = ("other", "", "")  # what the request being sent is for (calling)
        alarms = read_json(BASE / ALARMS_FILE)
        self.alarms: dict[str, dict] = {  # alarm -> {"at", "level", ...}; a malformed entry is dropped, never fatal
            str(k): v for k, v in (alarms if isinstance(alarms, dict) else {}).items()
            if isinstance(v, dict) and isinstance(v.get("at"), (int, float)) and not isinstance(v.get("at"), bool)}
        self.pool_seen: list[tuple[float, int, float]] = []  # (seenAt, remaining, reset) of the poorest REST counter
        self.alarm_procs: list[subprocess.Popen] = []  # tell-coordinator runs not yet reaped
        self.writing = False  # inside the outbox: its requests are sessions' writes, not the daemon's polling
        self.jobs_only: list[dict] = []  # failed runs whose job list is read though runs cannot be (due)
        self.heads_direct: list[dict] = []  # asked heads with no answer read over REST past the share (due_heads_direct)
        self.head_direct_at: list[float] = []  # when each such read was admitted, the last hour (HEAD_DIRECT_MAX)
        self.job_steps: dict[int, int] = {}  # failed check run databaseId -> its step count (final once completed)
        self.steps_failed: dict[Any, float] = {}  # job id -> when GitHub refused its steps for good (STEPS_RETRY)
        self.waived = False  # inside read_waited: the reserve's stop yields down to WAITED_RESERVE_SHARE of it
        self.waited_log: list[tuple[float, int]] = []  # (time, GraphQL points) read_waited spent, last minute
        self.waited_tried: dict[str, float] = {}  # key -> when read_waited last sent it, within WAITED_FRESH

    # -- budget

    def mode(self, bucket: str) -> str:
        """normal, lean (below the floor, or REST past the daemon's own share) or stop (below the reserve, or told
        to back off). Past its share REST is lean even while the share yields (share_yields): the yield lets reads go
        on over REST while GraphQL is out, at a quarter of the pace (LEAN_FACTOR) and without job lists, never at the
        full cycle. On 2026-11-08/09 the share yielded from each REST reset (:18) to GraphQL's (~:33) and
        cosmic-gray's daemon sent 1,271 counted REST requests in those 15 minutes (85 a minute; its share is 300 an
        hour), and the account's REST ran out by :50 every hour while GraphQL was out from :05 (both out :05-:18)."""
        if self.backoff[bucket] > self.now:
            return "stop"
        capped = bucket == "rest" and self.past_share()
        seen = self.budget.get(bucket) or {}
        if not seen or (seen.get("reset") or 0) <= self.now:
            return "lean" if capped or bucket in self.policy.get("forceLow", ()) else "normal"
        floor, reserve = self.policy["floors"][bucket]
        remaining = seen.get("remaining", floor)
        forced = bucket in self.policy.get("forceLow", ())
        # Waited reads may go into the fleet's reserve down to WAITED_RESERVE_SHARE of it, never into the hard reserve.
        hard = (self.policy.get("hardReserve") or HARD_RESERVE_DEFAULT).get(bucket, HARD_RESERVE_DEFAULT[bucket])
        if remaining < reserve and not (self.waived and bucket == "graphql"
                                        and remaining >= max(reserve * WAITED_RESERVE_SHARE, hard)):
            return "stop"
        return "lean" if remaining < floor or capped or forced or remaining < reserve else "normal"

    def charge_rest(self, minute: int, n: int) -> None:
        """Count n REST requests in that minute, on disk at once, so a daemon that dies mid-tick
        hands its successor the spend it really made. One small file write per counted request
        (about 2000 an hour at the cap) is nothing next to the request itself."""
        left = self.rest_minutes.get(minute, 0) + n
        if left > 0:
            self.rest_minutes[minute] = left
        else:
            self.rest_minutes.pop(minute, None)
        write_json(BASE / REST_SPEND_FILE, {str(m): c for m, c in self.rest_minutes.items()})
        self.saved_rest_minutes = dict(self.rest_minutes)

    @contextlib.contextmanager
    def calling(self, kind: str, repo: str = "", waiter: str = ""):
        """The requests sent inside are charged to (KIND, REPO) in the spend log, read for WAITER (waiter_of)."""
        prior, self.caller = self.caller, (kind, repo, waiter)
        try:
            yield
        finally:
            self.caller = prior

    @contextlib.contextmanager
    def phase(self, name: str):
        """The wall time inside is one tick phase's (READ_PROGRESS_WINDOW): where the ticks went, for stall_cause."""
        start = time.monotonic()
        try:
            yield
        finally:
            self.note_spent(name, time.monotonic() - start)

    def note_spent(self, name: str, seconds: float) -> None:
        self.spent.append((self.now, name, max(0.0, seconds)))

    def note_read(self, key: str) -> None:
        """A read of KEY stored data (dataAt): the daemon made progress on its kind."""
        kind = split_key(key)[0] if ":" in key else ""
        if kind in self.read_done:
            self.read_done[kind].append(self.now)

    def progress(self) -> dict[str, Any]:
        """daemon.json "progress": per kind the reads stored over READ_PROGRESS_WINDOW and the last one's time; the
        seconds the ticks spent per phase there (slot: waiting for a GraphQL slot; github: requests in flight, both
        inside the read phases); the request in flight now and its age; the last one that ended."""
        cut = self.now - READ_PROGRESS_WINDOW
        self.read_done = {k: [t for t in v if t > cut] for k, v in self.read_done.items()}
        self.spent = [s for s in self.spent if s[0] > cut]
        phases: dict[str, float] = {}
        for _, name, seconds in self.spent:
            phases[name] = phases.get(name, 0.0) + seconds
        return {"window": READ_PROGRESS_WINDOW,
                "reads": {k: len(v) for k, v in self.read_done.items()},
                "lastReadAt": {k: (round(v[-1], 3) if v else None) for k, v in self.read_done.items()},
                "spentS": {k: round(v, 1) for k, v in sorted(phases.items(), key=lambda x: -x[1])},
                "inCall": self.progress_call(), "lastCall": self.last_call, "slots": graphql_slot_holders(),
                # REST_PREFETCH_*, since the daemon started: sent early, taken by their read, settled unasked
                "prefetch": dict(self.prefetch_stats)}

    def free_slots(self) -> list[dict[str, Any]]:
        """Free the GraphQL slots this process has held past GRAPHQL_SLOT_HOLD_MAX (graphql_slot_reap), each logged
        once with its holder: the next pr batch gets the slot instead of waiting out every tick's budget for it."""
        freed = graphql_slot_reap()
        for r in freed:
            bound = GRAPHQL_SLOT_FLIGHT_MAX if r["inFlight"] else GRAPHQL_SLOT_HOLD_MAX
            log({"event": "slot-freed", **r, "bound": bound,
                 "why": (f"its request ({r['what']}) still on the wire past {bound:.0f} s" if r["inFlight"]
                         else f"held past {bound:.0f} s; a slot is held per request")})
        return freed

    def progress_call(self) -> dict[str, Any] | None:
        """The GitHub request in flight and its age (another thread may ask: the watchdog), or None."""
        call = self.in_call
        return None if call is None else {"what": call["what"], "ageS": round(time.monotonic() - call["since"], 1)}

    def rest_hold(self) -> str:
        """Why REST takes no more reads now, with its numbers (for deferral's sentence)."""
        if self.mode("rest") == "stop":
            left = (self.budget.get("rest") or {}).get("remaining", "?")
            return f"is under its reserve ({left} left)"
        return f"share is spent ({self.rest_spent()} of {self.rest_cap()} this hour)"

    def deferral(self, kind: str) -> dict[str, Any] | None:
        """Why KIND's reads are held back by a budget, not stuck: its keys this daemon deferred (DEFERRED), the
        last reason it deferred them within READ_PROGRESS_WINDOW, the batch size, the REST share and the login's
        latch. None when none of its keys is deferred, or none was for a reason this long. huge-blue, 2026-11-18
        19:56Z: 740 keys deferred (REST share 134 of 150, a pr batch halved to 5 after RESOURCE_LIMITS_EXCEEDED,
        the login latched) while the alarm said "Recent errors: none recorded" and offered a restart."""
        n = sum(1 for k in self.deferred if k.startswith(kind + ":"))
        why = self.defer_why.get(kind)
        if not n or why is None or self.now - why[0] > READ_PROGRESS_WINDOW:
            return None
        latch = land_latch(self.now, lands=False)
        parts = [f"{n} {kind} reads deferred, last by {why[1]}", f"batch {self.batch.get(kind)}",
                 f"REST share {self.rest_spent()} of {self.rest_cap()}"]
        if latch is not None:
            parts.append(f"the login's {'REST' if latch[0] == 'rest' else 'GraphQL'} latch holds until "
                         f"{utc_clock(latch[1])}")
        return {"deferred": n, "why": why[1], "batch": self.batch.get(kind), "restSpent": self.rest_spent(),
                "restCap": self.rest_cap(), "latch": None if latch is None else utc_clock(latch[1]),
                "text": "; ".join(parts)}

    def stall_cause(self, kind: str) -> dict[str, Any]:
        """Why KIND's waited data is old though the heartbeat is fresh (READ_PROGRESS_WINDOW's comment): "stalled"
        when this daemon stored no read of KIND over the window (the valve restarts it), else "backlog"; with the
        phase the ticks spent most in, the share of read time spent waiting for a GraphQL slot, and the request in
        flight. A sentence for the alarm, the log and `restart`."""
        p = self.progress()
        reads = p["reads"].get(kind, 0)
        spent = p["spentS"]
        tick = sum(v for k, v in spent.items() if k not in ("slot", "github")) or 0.0
        top = next((k for k in spent if k not in ("slot", "github")), None)
        slot, github = spent.get("slot", 0.0), spent.get("github", 0.0)
        held = self.deferral(kind)
        short = self.pace_short(kind)
        # Stalled only with no read stored and no budget holding the reads back: that alone is a restart's to fix. A
        # pace too slow for the blocked set is said first: nothing but a faster pace reads them in time.
        verdict = "paced" if short else "backlog" if reads else "deferred" if held is not None else "stalled"
        window = int(READ_PROGRESS_WINDOW)
        parts = [f"{reads} {kind} reads stored in the last {window}s" if reads
                 else f"no {kind} read stored in the last {window}s"]
        if short is not None:
            parts.append(short["text"])
        if held is not None:
            parts.append(held["text"])
        if tick:
            parts.append(f"ticks spent {tick:.1f}s, most in {top} ({spent[top]:.1f}s)")
        if slot > 0 and (slot >= 1 or slot >= tick / 4):
            holders = ", ".join(f"slot {r['slot']} by thread {r['thread']} ({r['what']}) for {r['heldS']:.0f}s"
                                for r in p["slots"]) or "held outside this process"
            parts.append(f"{slot:.1f}s waiting for one of the login's {graphql_slots()} GraphQL slots ({holders}; "
                         f"GitHub answered in {github:.1f}s)")
        if p["inCall"] is not None:
            parts.append(f"in flight: {p['inCall']['what']} for {p['inCall']['ageS']:.0f}s")
        elif p["lastCall"]:
            parts.append(f"last request: {p['lastCall'].get('what')}, {p['lastCall'].get('tookS')}s")
        return {"verdict": verdict, "reads": reads, "top": top, "slotS": round(slot, 1), "githubS": round(github, 1),
                "inCall": p["inCall"], "lastCall": p["lastCall"], "deferral": held, "pace": short,
                "text": f"{verdict}: " + "; ".join(parts)}

    def pace_short(self, kind: str) -> dict[str, Any] | None:
        """When graphqlPerMinute cannot read every watch of KIND a wait or a due land is blocked on (blocked, from the
        last tick) once per STALE_DATA_AFTER, the numbers: {"blocked", "needed", "pace", "text"}, NEEDED being the
        points a minute that takes (a query per batch, at the points KIND's queries cost over READ_PROGRESS_WINDOW).
        None while the pace covers them. huge-blue 2026-11-18 21:5xZ: waited pr data 3403 s old at 40 points a
        minute, and the alarm offered a restart, which reads no faster. Only with evidence the pace held them: KIND
        reads over GraphQL, the pace refused a query of it (paced_at) and its queries answered and stored reads in the
        window; arithmetic alone would cover a stall (review of glaeda#2199: nothing answered, batch 1, read "paced")."""
        n = (getattr(self, "blocked", None) or {}).get(kind) or 0
        if not n or self.paths.get(kind) != "graphql":
            return None
        if self.now - self.paced_at.get(kind, float("-inf")) > READ_PROGRESS_WINDOW:
            return None
        if not [t for t in self.read_done.get(kind, []) if self.now - t < READ_PROGRESS_WINDOW]:
            return None
        now = self.clock()
        costs = [points for at, why, points in self.gql_log if why == kind and now - at < READ_PROGRESS_WINDOW]
        if not costs:
            return None
        per_query = sum(costs) / len(costs)
        needed = math.ceil(math.ceil(n / max(1, self.batch.get(kind) or 1)) * per_query * 60 / STALE_DATA_AFTER)
        pace = self.policy.get("graphqlPerMinute", GRAPHQL_PER_MINUTE)
        if needed <= pace:
            return None
        return {"blocked": n, "needed": needed, "pace": pace,
                "text": f"blocked {n} {kind} reads need {needed} GraphQL points per minute to stay under "
                        f"{STALE_DATA_AFTER}s; the pace allows {pace} (graphqlPerMinute)"}

    def say_stall(self, kind: str, cause: dict[str, Any], age: Any, key: Any) -> None:
        """Log the stale cause once per (kind, verdict, top phase): what a session reads instead of restarting."""
        mark = f"{cause['verdict']}|{cause['top']}"
        if self.stall_said.get(kind) == mark:
            return
        self.stall_said[kind] = mark
        log({"event": "stale-cause", "kind": kind, "age": age, "key": key,
             **{k: cause[k] for k in ("verdict", "reads", "top", "slotS", "githubS", "inCall", "lastCall", "deferral",
                                      "text")}})

    def note_spend(self, bucket: str, name: str, counted: int, points: int = 0) -> None:
        """One request in the spend log: NAME is a REST route template or a GraphQL query name; COUNTED is 1 when
        it cost the shared pool (not a 304, not /rate_limit), whether or not the daemon's share was charged."""
        kind, repo, waiter = (tuple(self.caller) + ("", "", ""))[:3]
        key = "\t".join((bucket, name, kind, repo) + ((waiter.replace("\t", " "),) if waiter else ()))
        row = self.spend.setdefault(int(self.clock() // 60), {}).setdefault(key, [0, 0, 0])
        row[0] += 1
        row[1] += counted
        row[2] += points
        self.spend_dirty = True

    def spend_rows(self, seconds: float = 3600.0) -> list[dict]:
        """The spend log's rows over the last SECONDS (by the minute, as rest_spent counts), summed per key."""
        first = int((self.clock() - seconds) // 60) + 1  # whole minutes after the window's start, and this one
        total: dict[str, list[int]] = {}
        for minute, rows in self.spend.items():
            if minute >= first:
                for key, (requests, counted, points) in rows.items():
                    mine = total.setdefault(key, [0, 0, 0])
                    mine[0] += requests
                    mine[1] += counted
                    mine[2] += points
        out = []
        for key, (requests, counted, points) in total.items():
            bucket, name, kind, repo, waiter = (key.split("\t") + ["", "", "", "", ""])[:5]
            out.append({"bucket": bucket, "name": name, "kind": kind, "repo": repo, "waiter": waiter, "requests": requests,
                        "counted": counted, "points": points})
        return out

    def spend_by(self, seconds: float = 3600.0) -> dict:
        """daemon.json spendBy: the top SPEND_TOP rows each of REST by route, REST by route and caller, and GraphQL
        by query and caller, over the last SECONDS."""
        return spend_summary(self.spend_rows(seconds), seconds)

    def save_spend(self, force: bool = False) -> None:
        first = int(self.clock() // 60) - 60
        self.spend = {m: rows for m, rows in self.spend.items() if m >= first}
        if not self.spend_dirty or (not force and self.now - self.spend_saved_at < SPEND_SAVE_EVERY):
            return
        write_json(BASE / SPEND_FILE, {"schema": "glaeda-gh-spend/v1", "at": self.now,
                                       "fields": ["requests", "counted", "points"],
                                       "minutes": {str(m): rows for m, rows in sorted(self.spend.items())}})
        self.spend_saved_at, self.spend_dirty = self.now, False

    # -- alarms: before the pool runs dry (ALARM_CMD, NOTICES_DIR)

    def pool_projection(self) -> dict | None:
        """The shared REST pool as this host sees it: the poorest core counter's remaining, its reset, and, once
        ALARM_TREND_MIN of readings in its window are in, the drain per minute and when it runs dry at that pace."""
        seen = self.budget.get("rest") or {}
        remaining, reset, at = seen.get("remaining"), seen.get("reset"), seen.get("seenAt")
        if not all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in (remaining, reset, at)) \
                or reset <= self.now:
            self.pool_seen = []
            return None
        if not self.pool_seen or self.pool_seen[-1][0] != at:
            self.pool_seen.append((float(at), int(remaining), float(reset)))
        # one window only: a counter that reset, or a poorer one taking over, starts the trend again
        self.pool_seen = [p for p in self.pool_seen if abs(p[2] - reset) <= RESET_JITTER
                          and self.now - p[0] <= ALARM_TREND_KEEP]
        out: dict[str, Any] = {"remaining": int(remaining), "reset": float(reset), "perMinute": None, "dryAt": None}
        first = self.pool_seen[0] if self.pool_seen else None
        if first is not None and at - first[0] >= ALARM_TREND_MIN and first[1] > remaining:
            rate = (first[1] - remaining) / (at - first[0])  # per second
            out["perMinute"] = round(rate * 60, 1)
            dry = at + remaining / rate
            if dry < reset:
                out["dryAt"] = dry
        return out

    def quota_starved(self) -> bool:
        """Whether GitHub's own limits stop every read now: GraphQL stopped and REST stopped or at the daemon's share.
        Old data then is the quota's doing, which neither a restart nor a wait's own read can fix (daemon_starved)."""
        return self.mode("graphql") == "stop" and (self.mode("rest") == "stop" or self.rest_capped())

    def quota_hold(self, kind: str) -> tuple[str, bool] | None:
        """Why the quota holds this kind's reads back now, and whether it stops them (True: nothing is read for it
        until a reset, which neither a restart nor a wait's own read can change) or only slows them (lean, paced).
        None when the quota is not in the way. huge-blue, 2026-11-11: with the shared GraphQL quota sitting at the
        fleet's 1000 reserve, PR data a wait was blocked on reached 2509 s old with no error recorded: due() returned
        nothing for "pr" and said nothing, so staleWaited passed staleAfter with no cause attached, and a session
        restarted the daemon three times for what was the quota."""
        path = self.paths.get(kind) or BUCKETS[kind]
        seen = self.budget.get(path) or {}
        floor, reserve = self.policy["floors"][path]
        left = seen.get("remaining", "?")
        clock = lambda t: dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%H:%MZ")  # noqa: E731
        resets = f", resets {clock(seen['reset'])}" if isinstance(seen.get("reset"), (int, float)) else ""
        name = "GraphQL" if path == "graphql" else "REST"
        if self.backoff[path] > self.now:
            return f"GitHub told this daemon to back off {name} until {clock(self.backoff[path])}", True
        mode = self.mode(path)
        if mode == "stop":
            return (f"the shared {name} quota is under the daemon's reserve: {left} left, no {name} reads below "
                    f"{reserve} (kept for lands){resets}"), True
        if path == "rest" and kind in BALANCED + FALLBACK and self.rest_capped() and self.mode("graphql") != "normal":
            return f"this daemon's REST share is spent and GraphQL is {self.mode('graphql')}", self.mode("graphql") == "stop"
        if mode == "lean":
            if isinstance(left, int) and left < floor:
                waited = "waited reads keep their cycle and " if path == "graphql" else ""
                return (f"the shared {name} quota is under the daemon's floor: {left} left (below {floor}, {waited}"
                        f"the rest are read {LEAN_FACTOR} times less often){resets}"), False
            why = "is forced low by policy" if path in self.policy.get("forceLow", ()) else "is past this daemon's share"
            return f"{name} {why} (read {LEAN_FACTOR} times less often)", False
        if self.gql_paced == kind:
            return (f"the daemon's GraphQL pace ({self.policy.get('graphqlPerMinute', GRAPHQL_PER_MINUTE)} points a "
                    "minute) held this tick's reads"), False
        return None

    def stale_explained(self, kind: str | None = None) -> str | None:
        """Why old waited data is not this daemon's fault, which neither a restart nor a wait's own read can fix:
        "quota" (quota_starved), or "upstream" (this host reads through another host's daemon, whose own alarm
        covers it). None when it is this daemon's to fix."""
        # Only a working upstream: one this host cannot reach never gets its waited keys, so nothing there alarms on
        # them, and this host's alarm must (review of glaeda#1947).
        if (getattr(self, "upstream_status", None) or {}).get("state") == "ok":
            return "upstream"
        if self.quota_starved():
            return "quota"
        # the quota stopping the reads of KIND (a wait's own), or of the kind with the oldest waited data
        if kind is None:
            stale = {k: v for k, v in (getattr(self, "stale_waited", None) or {}).items() if isinstance(v, (int, float))}
            kind = max(stale, key=stale.get, default=None)
        hold = self.quota_hold(kind) if kind in CYCLES else None
        return "quota" if hold is not None and hold[1] else None

    def stale_causes(self) -> dict[str, str]:
        """daemon.json staleCause: for each kind whose waited data is past STALE_DATA_AFTER, stall_cause's sentence
        (what the daemon's reads did meanwhile), which `restart` and daemon_starved print."""
        stale = getattr(self, "stale_waited", None) or {}
        return {kind: self.stall_cause(kind)["text"] for kind, age_s in stale.items()
                if isinstance(age_s, (int, float)) and age_s > STALE_DATA_AFTER}

    def stale_why(self) -> dict[str, dict]:
        """daemon.json staleWhy: for each kind whose waited data is past STALE_DATA_AFTER and that the quota holds
        back (quota_hold), {"why": the reason, "quota": True when it stops the reads}. daemon_starved, the stale
        alarm and `restart` say it instead of calling old data a fault."""
        out = {}
        ages = {k: v for k, v in (getattr(self, "stale_waited", None) or {}).items() if isinstance(v, (int, float))}
        for kind, age_s in (getattr(self, "newest_data", None) or {}).items():  # a stalled loop too (stall_alarm)
            if isinstance(age_s, (int, float)):
                ages[kind] = max(ages.get(kind, 0.0), age_s)
        for kind, age_s in ages.items():
            if age_s > STALE_DATA_AFTER and self.quota_hold(kind) is None:
                short = self.pace_short(kind)
                if short is not None:  # the pace is too slow for the blocked set: a restart reads no sooner
                    out[kind] = {"why": short["text"], "quota": True, "blocked": short["blocked"]}
                    continue
                held = self.deferral(kind)
                if held is not None:  # a budget defers the reads: a restart cannot read sooner (daemon_starved)
                    out[kind] = {"why": held["text"], "quota": True, "deferred": held["deferred"]}
                    continue
            if age_s > STALE_DATA_AFTER:
                hold = self.quota_hold(kind)
                if hold is not None:
                    out[kind] = {"why": hold[0], "quota": hold[1]}
        return out

    def stale_alarm(self) -> tuple[str, str, dict] | str | None:
        """The stale alarm (alarms.stale, on by default): data a wait is blocked on older than STALE_DATA_AFTER while
        nothing outside this daemon explains it (staleWaited). The heartbeat stays fresh through this, so nothing else
        says it (huge-blue 2026-11-11: a merged PR read OPEN for 50 minutes). FIRE at three times the bound. "held"
        while the data is still old but explained (stale_explained): the alarm is neither sent nor cleared, so a brief
        quota stop never tells anyone it is fixed (review of glaeda#1946)."""
        stale = {k: v for k, v in (getattr(self, "stale_waited", None) or {}).items() if isinstance(v, (int, float))}
        kind = max(stale, key=stale.get, default=None)
        if kind is None or stale[kind] <= STALE_DATA_AFTER:
            return None
        # explained by the quota or an upstream, or the quota explained it until moments ago and the backlog is being
        # read (STALE_CATCH_UP): held, but only up to STALE_HELD_MAX (its comment)
        held = self.stale_explained() is not None or self.catching_up(kind) is not None
        if held and stale[kind] <= STALE_HELD_MAX:
            return "held"
        age_s = int(stale[kind])
        level = "fire" if age_s >= 3 * STALE_DATA_AFTER else "warn"
        where = getattr(self, "stale_waited_key", {}).get(kind) or "?"
        errors = "; ".join(list(getattr(self, "recent_errors", {}))[:3]) or "none recorded"
        hold = self.quota_hold(kind)
        quota = f" Quota: {hold[0]}." if hold else ""
        cause = self.stall_cause(kind)
        if held:
            cause = {**cause, "verdict": "held",
                     "text": f"held past {STALE_HELD_MAX}s ({self.held_why(kind)}); {cause['text']}"}
        self.stale_reason = cause["text"]
        self.say_stall(kind, cause, age_s, where)
        advice = STALE_ADVICE.get(cause["verdict"], STALE_RESTART_ADVICE)
        said = "" if cause["verdict"] in STALE_ADVICE and errors == "none recorded" else f" Recent errors: {errors}."
        text = (f"{level.upper()} glaeda-gh on {policy_host()}: {kind} data that waits are blocked on is {age_s}s old "
                f"(over {STALE_DATA_AFTER}s; oldest {key_name(where) if where != '?' else '?'}) while its heartbeat is "
                f"fresh.{quota} Reads: {cause['text']}.{said} {advice} {STALE_DUMP_ADVICE}.")
        return level, text, {"kind": kind, "age": age_s, "key": where, "cause": cause["verdict"],
                             **({"quota": hold[0]} if hold else {})}

    def stale_verdict(self) -> tuple[str, str, dict] | str | None:
        """THE stale predicate, once a tick (check_alarms): waited data past STALE_DATA_AFTER (stale_alarm), else no PR
        refreshed that long (stall_alarm). The alarm sends it, the valve acts on it, and daemon.json "stale"
        (stale_record) carries it with its one reason, which `restart` (daemon_starved) reads instead of judging
        again from other numbers. air-blue 2026-11-18 22:4xZ: the alarm said "no PR refreshed for 2196s ... `glaeda-gh
        restart` restarts a daemon in this state" and `restart` answered "under 600s old; nothing to restart"."""
        self.stale_reason = ""
        verdict = self.stale_alarm()
        if not isinstance(verdict, tuple):  # no wait starved: the refresh loop itself may still be (stall_alarm)
            stall = self.stall_alarm()
            verdict = stall if stall is not None else verdict
        return verdict

    def stale_record(self) -> dict[str, Any]:
        """daemon.json "stale": this tick's stale_verdict as {"state": fresh | held | stale, "kind", "age", "key",
        "restart" (whether a restart can help: what the alarm advises and `restart` does), "reason", "at"}, and the
        last verdict that was not fresh, within ALARM_EVERY, under "last" (`restart` says it cleared since)."""
        v = self.stale_now
        rec: dict[str, Any] = {"at": round(self.now, 3)}
        if isinstance(v, tuple):
            data = v[2]
            rec.update(state="stale", level=v[0], kind=data.get("kind"), age=data.get("age"), key=data.get("key"),
                       restart=data.get("cause") not in STALE_NO_RESTART and data.get("valve") != "spent",
                       reason=self.stale_reason)
        elif v == "held":
            stale = {k: a for k, a in (getattr(self, "stale_waited", None) or {}).items()
                     if isinstance(a, (int, float)) and a > STALE_DATA_AFTER}
            kind = max(stale, key=stale.get, default="pr")
            age = stale.get(kind, (getattr(self, "newest_data", None) or {}).get("pr"))
            rec.update(state="held", kind=kind, age=int(age) if isinstance(age, (int, float)) else None,
                       restart=False, reason=self.held_why(kind))
        else:
            rec.update(state="fresh", restart=False, reason="")
            last = self.stale_last
            if last is not None and self.now - last["at"] < ALARM_EVERY:
                rec["last"] = last
        return rec

    def held_why(self, kind: str) -> str:
        """Why old data of KIND is explained (stale_explained, catching_up): the reason a held verdict gives."""
        if (getattr(self, "upstream_status", None) or {}).get("state") == "ok":
            return "this host reads GitHub through an upstream, whose daemon reads it"
        hold = self.quota_hold(kind) if kind in CYCLES else None
        if hold is not None:
            return hold[0]
        if self.quota_starved():
            return "GitHub's quota is spent (GraphQL stopped, REST at its share)"
        since = self.catching_up(kind)
        if since is not None:
            return (f"the quota held these reads until {int(since)}s ago and the daemon is reading the backlog it "
                    "left, waited data first")
        return "the quota holds these reads back"

    def stall_alarm(self) -> tuple[str, str, dict] | str | None:
        """The refresh loop's own pulse, beside stale_alarm (which needs a wait blocked on old data): when even the
        freshest PR data of a live watch (newest_data: one a wait is on or someone read lately, each due every cycle)
        is older than STALE_DATA_AFTER, no PR has been refreshed in that long, whatever the heartbeat says. The same
        verdicts as stale_alarm ("held" while the quota or an upstream explains it), so the valve restarts the daemon
        on it. huge-blue 2026-11-17: PR data 3585 s and 1392 s old, heartbeat fresh, restarted by hand both times."""
        age_s = (getattr(self, "newest_data", None) or {}).get("pr")
        if not isinstance(age_s, (int, float)) or age_s <= STALE_DATA_AFTER:
            return None
        if self.stale_explained("pr") is not None or self.catching_up("pr") is not None:
            return "held"
        age_s = int(age_s)
        level = "fire" if age_s >= 3 * STALE_DATA_AFTER else "warn"
        errors = "; ".join(list(getattr(self, "recent_errors", {}))[:3]) or "none recorded"
        hold = self.quota_hold("pr")
        quota = f" Quota: {hold[0]}." if hold else ""
        down = (f" GraphQL is out until {dt.datetime.fromtimestamp(self.gql_down_until, dt.timezone.utc):%H:%MZ} "
                "(5xx answers), so PRs read over REST." if self.gql_down() else "")
        # Why the reads did not happen (stall_cause), as stale_alarm says it: a budget that defers them is no fault a
        # restart fixes, and the valve does not restart for it (stale_valve, "deferred")
        cause = self.stall_cause("pr")
        self.stale_reason = cause["text"]
        advice = STALE_ADVICE.get(cause["verdict"], STALE_RESTART_ADVICE)
        said = "" if cause["verdict"] in STALE_ADVICE and errors == "none recorded" else f" Recent errors: {errors}."
        text = (f"{level.upper()} glaeda-gh on {policy_host()}: no PR has been refreshed for {age_s}s (over "
                f"{STALE_DATA_AFTER}s; the freshest live PR watch's data is that old) while its heartbeat is fresh."
                f"{quota}{down} Reads: {cause['text']}.{said} {advice} {STALE_DUMP_ADVICE}.")
        return level, text, {"kind": "pr", "age": age_s, "key": "newest", "stall": True, "cause": cause["verdict"],
                             **({"quota": hold[0]} if hold else {})}

    def note_explained(self) -> None:
        """Remember, per kind, the last tick whose old waited data stale_explained accounted for (the quota, an
        upstream), for catching_up. Every tick, after oldest_data."""
        for kind in CYCLES:
            if self.stale_explained(kind) is not None:
                self.explained_at[kind] = self.now

    def catching_up(self, kind: str) -> float | None:
        """Seconds since the quota (or an upstream) stopped explaining KIND's old waited data, while that is under
        STALE_CATCH_UP: the daemon is reading the backlog the stop left, oldest waited first, and old data then is
        not starvation. None otherwise."""
        at = self.explained_at.get(kind)
        if not isinstance(at, (int, float)):
            return None
        since = self.now - at
        return since if since < STALE_CATCH_UP else None

    def stale_valve(self, stale: tuple[str, str, dict] | str | None, policy: dict) -> tuple[str, str, dict] | str | None:
        """The release valve over the stale alarm's verdict: starvation nothing explains on STALE_VALVE_TICKS ticks in a
        row sets valve_due, and serve() restarts the daemon (restart_self) once the tick has sent the alarm, whose
        text then says so (sent again for that, ALARM_EVERY notwithstanding: the first tick's WARN went out as before).
        Past the valve's bounds (policy alarms.staleRestart off, a daemon younger than STALE_DATA_AFTER, a valve
        restart within STALE_VALVE_COOLDOWN) the alarm stands as it was, saying why the valve did not act."""
        if not isinstance(stale, tuple):
            self.stale_streak = 0
            return stale
        self.stale_streak += 1
        if self.stale_streak < STALE_VALVE_TICKS:
            return stale
        level, text, data = stale
        if not policy.get("staleRestart", True):
            return stale
        fresh = (getattr(self, "fresh_waited", None) or {}).get(data.get("kind"))
        # Only this daemon's own reads (stall_cause "backlog") make it one key: a cache another process wrote (a wait's
        # direct read) is fresh data, not a reader that works.
        reading = data.get("cause", "backlog") == "backlog"
        if data.get("cause") in STALE_ADVICE:
            # The reads are held back by a budget (deferral), or the pace is too slow for the blocked set (pace_short):
            # a fresh daemon would read them no sooner, and drop every land judgment in flight besides. The alarm says
            # what holds them.
            return level, text, {**data, "valve": data["cause"]}
        age = data.get("age")
        stuck = isinstance(age, (int, float)) and age > STALE_ONE_KEY_MAX  # STALE_ONE_KEY_MAX's comment
        if reading and isinstance(fresh, (int, float)) and fresh < STALE_DATA_AFTER and not stuck:
            # The daemon reads its other waited keys (one of them is FRESH s old): this one key is stale, and a restart
            # would only drop every land judgment in flight. huge-blue, 2026-11-18: six valve restarts in six hours,
            # each for one PR (pr:manaflow-ai/cmux#46087 at 3963 s), each starting the 596-land queue over. Its read
            # goes first instead (nudged), and the alarm stands.
            if data.get("key"):
                self.land_nudge(str(data["key"]))
            return level, text, {**data, "valve": "one_key", "freshest": int(fresh)}
        up = self.now - (self.started_tick if self.started_tick is not None else self.now)
        if up < STALE_DATA_AFTER:
            return level, text, {**data, "valve": "young", "up": int(up)}
        record = restart_record() or {}
        ago = self.clock() - record["at"] if record.get("valve") else None
        if ago is not None and 0 <= ago < STALE_VALVE_COOLDOWN:
            said = (f"The daemon already restarted itself for this {int(ago)}s ago (stale valve) and that did not "
                    "help, so another restart will not either: tell the owner.")
            return level, text.replace(STALE_RESTART_ADVICE, said), {**data, "valve": "spent", "valveAgo": int(ago)}
        self.valve_due = {"kind": data.get("kind"), "age": data.get("age"), "key": data.get("key"),
                          "ticks": self.stale_streak}
        if data.get("kind") in CYCLES:
            self.valve_due["cause"] = self.stall_cause(str(data["kind"]))["text"]
        said = (f"The daemon is restarting itself now (stale valve: {self.stale_streak} ticks in a row); nobody needs "
                "to run `glaeda-gh restart`.")
        return level, text.replace(STALE_RESTART_ADVICE, said), {**data, "valve": "restarting"}

    def restart_self(self) -> dict:
        """The valve's restart, recorded the way `glaeda-gh restart` records one (restart.json, so its cooldown and
        this valve's see it) and logged. serve() then re-executes the daemon, as it does for an update: a fresh process
        with none of this one's in-memory state, and the alarm already sent (a service restart would kill its
        tell-coordinator child with the unit)."""
        due, self.valve_due = self.valve_due or {}, None
        record = {"at": self.clock(), "by": os.getpid(), "how": "self: stale valve (re-exec)", "ok": True,
                  "ran": True, "valve": True, **{k: due.get(k) for k in ("kind", "age", "key")},
                  **({"cause": due["cause"]} if "cause" in due else {})}
        write_json(BASE / "restart.json", record)
        why = "stale valve: no PR refreshed (stall_alarm)" if due.get("key") == "newest" else "stale valve"
        refresh_log_write(f"{utc_stamp(self.clock())} glaeda-gh refresh: {due.get('kind')} data {due.get('age')}s old "
                          f"({why}, {due.get('ticks')} ticks); next: the daemon re-executes itself now")
        log({"event": "restart", "why": why, **{k: due.get(k) for k in ("kind", "age", "key", "ticks")},
             **({"cause": due["cause"]} if "cause" in due else {})})
        return record

    def check_alarms(self) -> None:
        """The pool alarm (policy alarms.pool): REST left under alarms.restLeft, or the drain over the last minutes
        running it dry before its reset. The share alarm (alarms.share, share_alarm): this daemon's own counted REST
        over the measured last hour past its cap, naming the waiter to shed. Each names
        the routes that spent most lately, so whoever hears it knows what to fix."""
        self.alarm_procs = [p for p in self.alarm_procs if p.poll() is None]  # reap what finished
        policy = self.policy.get("alarms") or {}
        firing: dict[str, tuple[str, str, dict]] = {}
        rows = self.spend_rows(SPEND_RECENT)
        recent = spend_summary(rows, SPEND_RECENT, top=3)
        top = "; ".join(f"{r['route']} {r['counted']} ({r['topCaller'] or '?'}{route_waiter(r)})"
                        for r in recent["restByRoute"] if r["counted"]) or "no counted REST from this daemon"
        clock = lambda t: dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%H:%MZ")  # noqa: E731
        pool = self.pool_projection()
        held: set[str] = set()  # alarms neither sent nor cleared this tick
        if policy.get("pool") and pool is not None and pool["reset"] - self.now <= 60:
            held.add("pool")  # its window is about to reset: no news either way
        if policy.get("pool") and pool is not None and pool["reset"] - self.now > 60:
            left, reset = pool["remaining"], pool["reset"]
            low = left < policy.get("restLeft", ALARM_REST_LEFT)
            limit = (self.budget.get("rest") or {}).get("limit") or 5000
            share = policy.get("paceShare", ALARM_PACE_SHARE)
            fast = isinstance(share, (int, float)) and share > 0 and pool["perMinute"] is not None \
                and pool["perMinute"] * 60 >= share * limit
            if low or fast or pool["dryAt"] is not None:
                fire = left < self.policy["floors"]["rest"][1] or (
                    pool["dryAt"] is not None and pool["dryAt"] - self.now < ALARM_FIRE_WITHIN)
                pace = f", draining {pool['perMinute']}/min" if pool["perMinute"] else ""
                if fast:
                    pace += f" (past {share:.0%} of its {limit} an hour, {share * limit / 60:.0f}/min)"
                dry = f", dry at {clock(pool['dryAt'])}" if pool["dryAt"] is not None else ""
                # The daemon's own part of the drain first: on 2026-11-17 the alarm named only the daemon's routes, and
                # its readers took the daemon (about 20/min) for the 127/min drain the gh shim's callers and other
                # hosts made.
                mine = recent["rest"]["counted"] / max(1.0, SPEND_RECENT / 60)
                part = (f" ({mine / pool['perMinute']:.0%} of the drain)" if pool["perMinute"] else "")
                text = (f"{'FIRE' if fire else 'WARN'} shared GitHub REST pool on {policy_host()}: {left} left{pace}"
                        f"{dry}, resets {clock(reset)}. This daemon: {mine:.1f}/min counted REST, last "
                        f"{SPEND_RECENT // 60} min{part}; its top routes: {top}.")
                firing["pool"] = ("fire" if fire else "warn", text, {**pool, "top": recent["restByRoute"]})
        if policy.get("share", True):
            share = self.share_alarm(self.rest_cap(), rows)
            if share is not None:
                firing["share"] = share
        consumer_policy = policy.get("consumerShare")
        if isinstance(consumer_policy, dict):
            if self.now - self.consumer_share_at >= ALARM_EVERY:
                self.consumer_share_at = self.now
                spenders, _ = host_spenders()
                self.consumer_share_verdict = consumer_share_alarm(spenders, consumer_policy)
            if self.consumer_share_verdict is not None:
                firing["consumer-share"] = self.consumer_share_verdict
        else:
            self.consumer_share_verdict = None
        self.stale_now = self.stale_verdict()
        if policy.get("stale", True):
            stale = self.stale_valve(self.stale_now, policy)
            if isinstance(stale, tuple):
                self.stale_now = stale  # the valve's word on it ("spent": a restart will not help) is the verdict
            if stale == "held":
                held.add("stale")
            elif stale is not None:
                firing["stale"] = stale
        if self.stale_now is not None:
            self.stale_last = self.stale_record()
        changed = False
        # the stale alarm goes by its incident (incident_update), not by the hour: one send per incident and its news
        incident_key = f"stale:{policy_host()}"
        stale_steps = incident_update(
            self.now, "stale", {incident_key} if "stale" in firing or "stale" in held else set(),
            {incident_key: (firing["stale"][0], firing["stale"][2].get("valve") == "restarting")}
            if "stale" in firing else {})
        stale_step = (stale_steps or {}).get(incident_key)
        if stale_step is not None and stale_step["event"] == "recover":
            self.send_alarm("stale", "info", incident_recovered(stale_step, "waited PR data is fresh again"),
                            {"incident": stale_step["incident"]["id"], "event": "recover"},
                            source_key=f"{stale_step['incident']['id']}:recover")
        for name, (level, text, data) in firing.items():
            last = self.alarms.get(name) or {}
            if name == "stale":
                if stale_step is None or not stale_step["send"]:  # held by its incident (or the ledger busy: next tick)
                    if last.get("cleared") or not last:  # back after a clear: still the incident already sent
                        self.alarms[name] = {**{k: v for k, v in last.items() if k != "cleared"},
                                             "at": last.get("at", self.now), "level": last.get("level", level)}
                        changed = True
                    continue
                inc = stale_step["incident"]
                self.send_alarm(name, level, text + incident_said(stale_step),
                                {**data, "incident": inc["id"], "event": stale_step["event"]},
                                source_key=f"{inc['id']}:{stale_step['event']}:{inc['sends']}")
                self.alarms[name] = {"at": self.now, "level": level, "text": text, "incident": inc["id"]}
                changed = True
                continue
            # worse: it became a FIRE, or another REST window (GitHub keeps two core counters) is the one running dry
            worse = level == "fire" and last.get("level") != "fire" or (
                isinstance(last.get("reset"), (int, float)) and abs(last["reset"] - data.get("reset", last["reset"]))
                > RESET_JITTER) or data.get("valve") == "restarting"  # (the valve acting is always news)
            if last.get("at") and self.now - float(last["at"]) < ALARM_EVERY and not worse:
                if last.get("cleared"):  # back within the hour: still the alarm already sent
                    self.alarms[name] = {k: v for k, v in last.items() if k != "cleared"}
                    changed = True
                continue
            if name == "pool":  # read only when it is sent: at most a few times an hour
                spenders, host_rest = host_spenders()
                gap_text, gap = unlogged_text((self.budget.get("rest") or {}).get("limit") or 5000,
                                              data.get("remaining"), data.get("reset"), self.clock(), host_rest,
                                              fleet=any(r.get("host") for r in spenders))
                data = {**data, "spenders": spenders, "hostRest": host_rest, "unlogged": gap}
                text += " " + spenders_text(spenders) + gap_text
            if name == "share":  # read only when it is sent, like the pool's
                spenders, _ = host_spenders()
                slow = share_slow(data.get("shed"), spenders)
                data = {**data, "spenders": spenders, "slow": slow}
                text = text.replace(" Top routes, last hour:", f" {share_slow_text(slow)} Top routes, last hour:", 1)
            self.send_alarm(name, level, text, data)
            self.alarms[name] = {"at": self.now, "level": level, "text": text,
                                 **({"reset": data["reset"]} if "reset" in data else {})}
            changed = True
        for name in [n for n in self.alarms if n not in firing and n not in held and not self.alarms[n].get("cleared")]:
            if not self.alarms[name].get("clearSaid"):  # one "cleared" per alarm sent, however often it flaps
                self.write_notice(name, "info", f"glaeda-gh on {policy_host()}: the {name} alarm cleared", {})
            self.alarms[name] = {**self.alarms[name], "cleared": self.now, "clearSaid": True}
            changed = True
        for name in [n for n, a in self.alarms.items() if a.get("cleared") and self.now - a["cleared"] > ALARM_EVERY]:
            del self.alarms[name]  # cleared an hour ago: a new one is news again
            changed = True
        if changed:
            write_json(BASE / ALARMS_FILE, self.alarms)

    def share_alarm(self, cap: int, recent_rows: list[dict]) -> tuple[str, str, dict] | None:
        """The share alarm: this daemon's counted REST over the measured trailing hour past its cap, naming the waiter
        to shed. The share is a hard cap (rest_room), so that hour passes it only by what the cap exempts (a failed
        attempt's job list) or an operator's restYield. A fast ten minutes inside the hour is the cap at work (the
        daemon reads up to it, and a restart's re-reads come in a burst), not news: one log line an hour
        (share-pace, "nothing to do, projection only"), never an alarm. The old alarm projected the last
        SPEND_RECENT seconds over an hour and warned about hourly on huge-blue and cosmic-gray with nothing for
        anyone to do (2026-11-15: "306/h against its cap of 150 (142 in the last hour)").
        A restShare of 0 (every host the config does not name: PR and run reads over GraphQL only) is a cap of 0, and
        its few exempt reads (a failed attempt's job list) warned on every one: the alarm needs spend past
        max(cap, SHARE_ALARM_FLOOR), though the cap itself still holds reads to 0.
        Past the cap it is an alarm only while the login's shared REST pool is under its floor (floors.rest): a host
        over its share takes from no one while the pool has room. On 2026-11-18 it warned a host with no share (60 past a cap of
        0), huge-blue (151 past 150) and cosmic-gray (301 past 300) while the pool had about 2000 an hour to spare;
        that is one share-over log line an hour now. The alarm names the one caller to slow (share_slow), read when
        it is sent."""
        spent = self.rest_spent()
        # the share's own measure: the outbox (sessions' writes) is never held to it (request)
        recent = [r for r in recent_rows if r["bucket"] == "rest" and r["kind"] != "outbox"]
        pace = sum(r["counted"] for r in recent) * 3600 // SPEND_RECENT
        if spent <= max(cap, SHARE_ALARM_FLOOR):
            if spent <= cap and pace > max(cap * 3 // 2, cap + 150) and self.now - self.share_pace_at >= ALARM_EVERY:
                self.share_pace_at = self.now
                log({"event": "share-pace", "pace": pace, "spent": spent, "cap": cap,
                     "note": "nothing to do, projection only: the measured hour is within the cap, which holds it"})
            return None
        floor = self.policy["floors"]["rest"][0]
        seen = self.budget.get("rest") or {}
        left = seen.get("remaining") if seen and (seen.get("reset") or 0) > self.now else None
        if not isinstance(left, int) or left >= floor:
            if self.now - self.share_over_at >= ALARM_EVERY:
                self.share_over_at = self.now
                log({"event": "share-over", "spent": spent, "cap": cap, "left": left, "floor": floor,
                     "note": "nothing to do: the login's REST pool is at or above its floor" if left is not None
                     else "nothing to do: the login's REST pool is not seen this window, so nothing is known short"})
            return None
        polling = [r for r in self.spend_rows(3600) if r["bucket"] == "rest" and r["kind"] != "outbox"]
        mine = spend_summary(polling, 3600, top=3)["restByRoute"]
        waiters: dict[str, int] = {}
        for r in polling:
            # a read shared by several waiters is logged as "N waiters": no one of them to shed
            if r.get("waiter") and r["counted"] and not re.fullmatch(r"\d+ waiters", r["waiter"]):
                waiters[r["waiter"]] = waiters.get(r["waiter"], 0) + r["counted"]
        shed = max(waiters.items(), key=lambda kv: (kv[1], kv[0]), default=None)
        routes = "; ".join(f"{r['route']} {r['counted']} ({r['topCaller'] or '?'}{route_waiter(r)})"
                           for r in mine if r["counted"])
        text = (f"WARN glaeda-gh on {policy_host()} spent {spent} counted REST in the last hour, past its cap of {cap}, "
                f"with the login's REST pool at {left} (under its floor of {floor}). "
                f"Top routes, last hour: {routes or 'none logged'}.")
        return ("warn", text, {"pace": pace, "cap": cap, "spent": spent, "top": mine, "remaining": left, "floor": floor,
                               "shed": {"waiter": shed[0], "counted": shed[1]} if shed else None})

    def write_notice(self, kind: str, level: str, text: str, data: dict) -> None:
        """One notice line (notice_line) at the daemon's time."""
        notice_line(self.now, kind, level, text, data)

    def send_alarm(self, name: str, level: str, text: str, data: dict, source_key: str = "") -> None:
        """The notice line, then tell-coordinator in the background: a slow or missing inbox never holds a tick.
        SOURCE_KEY (an incident event's id) goes as --source-key, so coord_inbox sends that key once."""
        log({"event": "alarm", "alarm": name, "level": level, "text": text})
        self.write_notice(name, level, text, data)
        if not (ALARM_CMD.is_file() and os.access(ALARM_CMD, os.X_OK)):
            log({"event": "alarm-unsent", "alarm": name, "why": f"no {ALARM_CMD}"})
            return
        try:
            self.alarm_procs.append(subprocess.Popen(
                [os.fspath(ALARM_CMD), "--from", "glaeda-gh", "--severity", level,
                 *(["--source-key", source_key] if source_key else []), text],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True))
        except OSError as error:
            log({"event": "alarm-unsent", "alarm": name, "why": describe(error)})

    def clock(self) -> float:
        """Now, for the REST share: the wall clock, or the pinned one a test drives tick(now=...) with."""
        return time.time() if self.clock_real else self.now

    def rest_spent(self) -> int:
        """REST requests this daemon sent in the last hour that GitHub counted (304s are free), by the
        minute: the minute an hour back counts whole, so this errs toward the cap, not past it."""
        oldest = int(self.clock() // 60) - 60
        return sum(n for minute, n in self.rest_minutes.items() if minute >= oldest)

    def fold_rest_hours(self, gone: dict[int, int]) -> None:
        """Add the minutes leaving the trailing hour to their hours (REST_HOURS_FILE), dropping hours past
        REST_HOURS_KEEP. An hour's total is whole once its last minute has left, an hour after it ended."""
        oldest = int(self.clock() // 3600) - REST_HOURS_KEEP
        hours = dict(self.rest_hours)
        for minute, n in gone.items():
            hours[minute // 60] = hours.get(minute // 60, 0) + n
        hours = {h: n for h, n in hours.items() if h >= oldest}
        if hours != self.rest_hours:
            self.rest_hours = hours
            write_json(BASE / REST_HOURS_FILE, {str(h): n for h, n in sorted(hours.items())})

    def rest_hours_view(self) -> dict:
        """The last day's whole hours (an hour ended at least an hour ago, so no minute of it is still in
        rest_minutes) for daemon.json: each hour's counted REST by its start, and the peak. A missing hour is
        none counted (the daemon down, or nothing read)."""
        last = int(self.clock() // 3600) - 2
        hours = {h: n for h, n in self.rest_hours.items() if last - 23 <= h <= last}
        stamp = lambda h: dt.datetime.fromtimestamp(h * 3600, dt.timezone.utc).strftime("%Y-%m-%dT%H:00Z")  # noqa: E731
        return {"peak": max(hours.values(), default=0), "hours": {stamp(h): n for h, n in sorted(hours.items())}}

    def rest_cap(self) -> int:
        limit = (self.budget.get("rest") or {}).get("limit") or 5000
        return int(self.policy["restShare"] * limit)

    def past_share(self) -> bool:
        """The largest read no longer fits in the daemon's own REST share, whether or not the share yields."""
        return self.rest_spent() + max(REST_READ_MAX.values()) > self.rest_cap()

    def rest_above_floor(self) -> bool:
        """REST is neither told to look low (forceLow) nor seen below its floor: what a fallback read over REST
        needs. Unlike mode("rest") == "normal", true while REST is lean only for being past the daemon's share."""
        if "rest" in self.policy.get("forceLow", ()):
            return False
        seen = self.budget.get("rest") or {}
        if not seen or (seen.get("reset") or 0) <= self.now:
            return True
        return int(seen.get("remaining") or 0) >= self.policy["floors"]["rest"][0]

    def rest_capped(self) -> bool:
        """The daemon spent its share of the hourly REST limit, as near as the largest read can tell:
        once that read no longer fits, routing reads to REST would only defer them tick after tick
        while GraphQL could answer them."""
        return not self.rest_room(max(REST_READ_MAX.values()))

    def failed_without_jobs(self, e: dict) -> bool:
        """A cached run whose latest attempt failed and whose job list is an older attempt's."""
        c = e["cache"] or {}
        run = c.get("data") or {}
        return (run.get("status") == "completed" and run.get("conclusion") not in RUN_OK
                and jobs_attempt(c.get("jobs")) < (run.get("run_attempt") or 1))

    def rest_room(self, cost: int) -> bool:
        """Whether `cost` more counted REST requests fit in the share, or the share yields to them."""
        return self.rest_spent() + cost <= self.rest_cap() or self.share_yields(cost)

    def rest_yield(self) -> int:
        """Counted REST the share may yield past its cap in an hour: policy restYield (a host's local override), else
        none. The share is a hard cap, so a GraphQL shortage never spends the shared REST pool (hq#8948)."""
        given = self.policy.get("restYield")
        return int(given) if isinstance(given, int) else REST_YIELD_DEFAULT

    def share_yields(self, cost: int) -> bool:
        """GraphQL is below its floor or throttled, so REST is the only bucket with room: the daemon's reads
        go past its REST share while the account's REST stays above its floor, which is what sessions' own
        gh calls keep. Only with a restYield set: by default nothing yields."""
        if self.mode("graphql") == "normal":
            return False
        if self.rest_spent() + cost > self.rest_cap() + self.rest_yield():
            return False  # the yield is spent too: the rest wait for GraphQL, or the next hour
        seen = self.budget.get("rest") or {}
        if not seen or (seen.get("reset") or 0) <= self.now:
            return True  # not seen yet, or reset since: a full hour's quota
        return int(seen.get("remaining") or 0) - cost >= self.policy["floors"]["rest"][0]

    def stopped_why(self, bucket: str) -> str:
        """Why richness() says BUCKET is stopped (-1): its reserve, or the daemon's REST share."""
        if self.mode(bucket) == "stop":
            return "under its reserve"
        return f"share spent ({self.rest_spent()} of {self.rest_cap()})" if bucket == "rest" else "stopped"

    def richness(self, bucket: str) -> float:
        """What this bucket can still spend per second until its own reset, above its reserve; -1
        while it is stopped. A bucket not seen yet, or past its reset, counts as a full hour's quota."""
        if self.mode(bucket) == "stop":
            return -1.0
        if bucket == "rest" and self.rest_capped():
            return -1.0  # the daemon's own REST share is spent: balanced kinds read over GraphQL
        if bucket in self.policy.get("forceLow", ()):
            return 0.0  # told to treat it as nearly spent: reads go elsewhere while anything else can take them
        seen = self.budget.get(bucket) or {}
        limit = seen.get("limit") or 5000
        reserve = self.policy["floors"][bucket][1]
        if not seen or (seen.get("reset") or 0) <= self.now:
            return max(0, limit - reserve) / FULL_WINDOW
        return max(0, seen.get("remaining", limit) - reserve) / max(seen["reset"] - self.now, RICH_WINDOW_MIN)

    def read_cost(self, kind: str, bucket: str) -> float:
        """What one KIND entry read over BUCKET cost the shared pool lately: counted REST requests (a 304 is free) or
        GraphQL points, per entry read, from the spend log and this process's reads over the same window (since it
        began, an hour at most). READ_COST_DEFAULT until READ_COST_MIN_READS reads were made over that bucket."""
        began = self.started_tick if self.started_tick is not None else self.now
        window = min(3600.0, self.now - began)
        reads = sum(1 for t, k, b in self.reads if k == kind and b == bucket and self.now - t <= window)
        if reads < READ_COST_MIN_READS:
            return READ_COST_DEFAULT[(kind, bucket)]
        spent = sum(r["counted"] if bucket == "rest" else r["points"] for r in self.spend_rows(window + 60)
                    if r["bucket"] == bucket and r["kind"] == kind)
        return max(READ_COST_FLOOR, spent / reads)

    def read_seconds(self, kind: str, bucket: str) -> float:
        """The daemon's own seconds per KIND entry read over BUCKET, over the last READ_SECONDS_WINDOW (a GraphQL
        query's time shared by the entries it read); READ_SECONDS_DEFAULT until READ_SECONDS_MIN_READS entries."""
        rows = [r for r in self.read_secs if r[1] == kind and r[2] == bucket and self.now - r[0] < READ_SECONDS_WINDOW]
        n = sum(r[4] for r in rows)
        if n < READ_SECONDS_MIN_READS:
            return READ_SECONDS_DEFAULT[(kind, bucket)]
        return max(0.01, sum(r[3] for r in rows) / n)

    def note_read_seconds(self, kind: str, bucket: str, seconds: float, entries: int) -> None:
        if kind in COST_WEIGHTED and entries > 0:
            self.read_secs.append((self.now, kind, bucket, max(0.0, seconds), entries))

    def route(self, kind: str) -> str:
        """The bucket this kind reads over this tick: the richer one. A kind leaves its current bucket
        only when the other is SWITCH_MARGIN richer (or the current one stopped), so the reads move in
        steps instead of flapping, and the two buckets drain about evenly."""
        current = self.paths[kind]
        if kind in FALLBACK:
            # GraphQL unless it is low or throttled and REST is neither (nor is the daemon's REST share spent, unless it
            # yields): REST lean only for being past the share still takes them, at the lean pace (mode)
            want = ("rest" if self.mode("graphql") != "normal" and self.mode("rest") != "stop"
                    and self.rest_above_floor() and not self.rest_capped() else "graphql")
            if want != current:
                log({"event": "route", "kind": kind, "from": current, "to": want,
                     "modes": {b: self.mode(b) for b in ("rest", "graphql")}})
                self.paths[kind] = current = want
        if kind in BALANCED:
            here, there = self.richness(current), self.richness(OTHER[current])
            # Reads per second each bucket affords, not requests: a PR over REST is several requests, over GraphQL
            # about one point (read_cost). A stopped bucket (-1) stays stopped.
            cost = {b: self.read_cost(kind, b) for b in (current, OTHER[current])} if kind in COST_WEIGHTED else None
            if cost:
                here = here if here < 0 else here / cost[current]
                there = there if there < 0 else there / cost[OTHER[current]]
                # and no faster than the daemon's own time reads them (READ_SECONDS_DEFAULT)
                secs = {b: self.read_seconds(kind, b) for b in (current, OTHER[current])}
                here = here if here < 0 else min(here, 1.0 / secs[current])
                there = there if there < 0 else min(there, 1.0 / secs[OTHER[current]])
            # Below its floor while the other bucket is not: move, whatever the margin says. The reverse never
            # moves by the margin (a low bucket about to reset can look richer), so the two cannot flap.
            low = self.mode(current) != "normal" and self.mode(OTHER[current]) == "normal"
            into_low = self.mode(OTHER[current]) != "normal" and self.mode(current) == "normal"
            if there >= 0 and (here < 0 or low or (not into_low and there > here * SWITCH_MARGIN)):
                # richness's -1 is "stopped", not a rate: the line said "perMinute rest -60.0" (huge-blue 2026-11-18)
                log({"event": "route", "kind": kind, "from": current, "to": OTHER[current],
                     "perMinute": {b: round(r * 60, 1) for b, r in ((current, here), (OTHER[current], there))
                                   if r >= 0},
                     **({"stopped": {current: self.stopped_why(current)}} if here < 0 else {}),
                     **({"readCost": {b: round(c, 2) for b, c in cost.items()},
                         "readSeconds": {b: round(self.read_seconds(kind, b), 2) for b in cost}} if cost else {})})
                self.paths[kind] = current = OTHER[current]
        return current

    def note_budget(self, bucket: str, limit: Any, remaining: Any, reset: float | None, path: str = "") -> None:
        try:
            seen = {"limit": int(limit), "remaining": int(remaining), "reset": reset, "seenAt": self.now}
        except (TypeError, ValueError):
            return
        if bucket == "graphql":
            # GraphQL too answers one token from two counters with their own hourly windows: on 2026-11-04 the one
            # /graphql requests spend reset at :26:29 while /rate_limit and some answers reported one resetting at
            # :21 (cosmic-gray's reading jumped from 3850 left to 3938 between them at 06:02Z while the spending one
            # had 1664). The last answer alone let the daemon, and the gh guard reading budget.json, spend from a
            # counter that was nearly gone; every live one is kept and the poorest is the reading, as for REST.
            if not isinstance(reset, (int, float)):
                if not rest_counters(self.budget, "graphqlCounters"):
                    self.budget[bucket] = seen
                return
            self.budget["graphqlCounters"] = merge_counter(rest_counters(self.budget, "graphqlCounters"), seen)
            self.settle_counters("graphql")
            return
        if bucket == "rest" and isinstance(reset, (int, float)) and ACTIONS_COUNTER_PATH.fullmatch(path):
            seen["counters"] = ["actions"]
        if bucket != "rest":
            self.budget[bucket] = seen
            return
        if not isinstance(reset, (int, float)):
            # A reading that names no window cannot say which counter it is; with counters known it would only
            # replace the poorest one with a figure mode() treats as no reading at all.
            if not rest_counters(self.budget):
                self.budget[bucket] = seen
            else:
                self.settle_rest()  # still drop a counter whose window ended, so the poorest live one shows
            return
        self.budget["restCounters"] = merge_counter(rest_counters(self.budget), seen)
        self.settle_rest()

    def settle_rest(self) -> None:
        """budget["rest"] is the core counter with the least left. GitHub answers one token's REST calls from
        two "core" counters with their own hourly windows (measured 2026-10-30: /actions/runs/N and
        /actions/workflows/N report one, resetting at :44; /rate_limit, pulls, jobs and check runs report the
        other, resetting at :10), and the headers and /rate_limit name both "core". Keeping only the last
        answer made the shared reading jump between them (3126 left at 05:28Z, 0 at 05:33Z), which read as a
        3000-call burst nobody logged, and let the gh guard and this daemon spend freely from a counter that
        was already spent. Every live counter is kept (restCounters, at most REST_COUNTERS) and the poorest
        one is what everything else reads; a counter past its reset is dropped. With no live counter the last
        reading stays as it was before restCounters existed (mode() treats a passed reset as a fresh hour)."""
        self.settle_counters("rest")

    def settle_counters(self, bucket: str) -> None:
        """settle_rest for BUCKET ("rest": restCounters, "graphql": graphqlCounters)."""
        key = "restCounters" if bucket == "rest" else "graphqlCounters"
        counters = rest_counters(self.budget, key)
        cur = self.budget.get(bucket)
        if isinstance(cur, dict) and isinstance(cur.get("reset"), (int, float)) and isinstance(cur.get("remaining"), int):
            # the reading itself counts too: a budget.json from before restCounters, or one lowered in place
            seen_at = cur.get("seenAt")
            counters = merge_counter(counters, {**cur, "seenAt": seen_at if isinstance(seen_at, (int, float)) else self.now})
        live = [c for c in counters if c["reset"] > self.now]
        live = sorted(live, key=lambda c: c["seenAt"], reverse=True)[:REST_COUNTERS]
        if not live:
            self.budget.pop(key, None)
            return
        self.budget[key] = sorted(live, key=lambda c: c["reset"])
        self.budget[bucket] = dict(min(live, key=lambda c: (c["remaining"], -c["seenAt"])))

    def refresh_budget(self) -> None:
        """Read the quota from GitHub when this host's view has gone stale.

        The quota is one pool per account, not per machine, so the glaeda daemons on cosmic-gray,
        huge-blue, cmux16, air-blue and big-red are spending the same 5000/h. They need no ledger
        between them: they need a view that is not old. Until now the budget was learned only as a
        side effect of the daemon's own requests, so a host that was not polling worked from
        whatever it last happened to see -- big-red believed a REST figure 124 hours old while the
        account was in fact nearly spent (2026-10-21).

        GET /rate_limit reports every resource family at once and does not count against either
        primary limit (only against the secondary limit, which one call per BUDGET_REFRESH is
        nowhere near), so this costs nothing and every host is at most that far behind the truth.
        It is not gated on mode() or backoff for that reason -- it is also how the daemon learns
        the quota came back. A refusal (a dead token, a secondary limit) backs off instead of
        being retried and re-reported every tick.
        """
        if BUDGET_REFRESH <= 0 or self.now < self.budget_retry or self.clock() < self.secondary_until:
            return
        # REST is fresh when every core counter was seen lately, or /rate_limit answered lately: it reports only
        # one of the counters (settle_rest), so a counter it cannot see must not force a read every tick, and a
        # fresh hidden counter must not keep the one it can see from being refreshed.
        counters = rest_counters(self.budget)
        if counters:
            oldest = min(c["seenAt"] for c in counters)
            rest_seen = max(oldest, self.rate_limit_at) if self.rate_limit_at > float("-inf") else oldest
        else:
            rest_seen = (self.budget.get("rest") or {}).get("seenAt")
        # GraphQL the same way (graphqlCounters): /rate_limit reports one of its two counters, so a poorer one it cannot
        # see is fresh enough once /rate_limit answered lately, or that counter would force a read every tick.
        gql = rest_counters(self.budget, "graphqlCounters")
        if gql:
            oldest = min(c["seenAt"] for c in gql)
            gql_seen = max(oldest, self.rate_limit_at) if self.rate_limit_at > float("-inf") else oldest
        else:
            gql_seen = (self.budget.get("graphql") or {}).get("seenAt")
        seen = [rest_seen, gql_seen]
        ages = [self.now - t for t in seen if isinstance(t, (int, float))]
        if len(ages) == 2 and max(ages) < BUDGET_REFRESH:
            return  # every bucket's view is recent enough; a bucket never seen always refreshes
        self.read_rate_limit()

    def read_rate_limit(self) -> None:
        """One GET /rate_limit (free: no primary limit counts it) into the budget: refresh_budget's read, and the land
        queue's check of a latch mark against GitHub's own count (land_reading)."""
        try:
            with self.calling("budget"):
                status, _, doc = self.request("GET", "/rate_limit", free=True)
        except OutOfTime:
            return  # the tick ran long; the next one refreshes
        except (WatchError, OSError) as error:
            return self.budget_failed(describe(error))
        if status != 200 or not isinstance(doc, dict):
            return self.budget_failed(f"HTTP {status}")
        resources = doc.get("resources")
        if not isinstance(resources, dict):
            return self.budget_failed("no resources in the answer")
        self.budget_retry = 0.0
        self.rate_limit_at = self.now
        for bucket, family in (("rest", "core"), ("graphql", "graphql")):
            seen = resources.get(family)
            if isinstance(seen, dict):
                self.note_budget(bucket, seen.get("limit"), seen.get("remaining"), seen.get("reset"))

    def budget_failed(self, why: str) -> None:
        """Report it once and leave /rate_limit alone for BUDGET_RETRY. Reporting it every tick
        rewrote daemon.json every tick (an error is a reason to write a heartbeat early), which
        turned a broken token into a busy loop on the disk."""
        self.errors.append(f"rate_limit: {why}")
        self.budget_retry = self.now + BUDGET_RETRY

    def land_reading(self, pool: str) -> dict | None:
        """The land queue's reading of the login's POOL ("rest" or "graphql") while a latch mark would hold its lands
        (land_latch): GET /rate_limit (free) when the last answer is LAND_READING_REFRESH old, then the budget's poorest
        live counter. None with no login here (an upstream reader or a lane-gh broker client: no /rate_limit of the
        login it can send; the mark holds as written there) or while GitHub's secondary limit or a refused /rate_limit
        holds the read. 2026-11-19 09:2x-09:50Z: a "retry-after" mark by lane-gh (a broker read-App wait, not GitHub's
        limit) held ~40 lands 30-50 min while /rate_limit said REST 1947/5000 and GraphQL 4323/5000 left."""
        if self.upstream() is not None or land_broker_client():
            return None
        if self.now - self.rate_limit_at >= LAND_READING_REFRESH and self.now >= self.budget_retry \
                and self.clock() >= self.secondary_until:
            deadline, self.tick_deadline = self.tick_deadline, max(self.tick_deadline, time.monotonic() + 30.0)
            try:
                self.read_rate_limit()
            finally:
                self.tick_deadline = deadline
        seen = self.budget.get(pool)
        return dict(seen) if isinstance(seen, dict) else None

    # -- requests

    def request(self, method: str, path: str, body: dict | None = None, etag: str | None = None,
                free: bool = False, content: bool = False) -> tuple[int, dict, Any]:
        """One GitHub request.

        content: a write from the outbox, whose throttling (GitHub's secondary limit on content
        creation) holds the outbox, not the read buckets.
        free: /rate_limit, which counts against no primary limit. Counting it as a REST request
        would overstate the spend of the very call that reads the spend."""
        self.last_request_source = "login"
        if time.monotonic() >= self.tick_deadline:
            raise OutOfTime
        bucket = "graphql" if path == "/graphql" else "rest"
        if self.upstream() is not None:
            raise WatchError("this host reads GitHub through its upstream (upstream.json) and has no login")
        if not content and not free:
            self.post_due()  # a read phase never holds a queued write past its spacing
            self.feed_due()  # nor lets the feed view it keeps for downstream hosts age out (feed_between_reads)
        # the route field names the repositories for the App pool only (graphql_named_repos); GitHub never sees it
        sent = {k: v for k, v in body.items() if k != APP_POOL_ROUTE_FIELD} if isinstance(body, dict) else body
        raw_body = json.dumps(sent).encode() if sent is not None else None
        pool = self.app_pool
        owner = (pool.owner_of(method, path, body) if pool is not None and not free and not content
                 and not self.writing else None)
        route = route_of(method, path)
        scope = pool.scope(owner, method, path, body) if owner else ""
        chosen = pool.pick(owner, scope) if owner else None
        app_token = chosen.token(owner) if chosen else None
        if app_token:
            pool = chosen
            self.last_app_pool = chosen
            self.last_request_source = "app"
            headers = self.read_headers(app_token, etag, raw_body is not None)
            # Timed as "github" like a login request: huge-blue, 2026-11-20 12:0xZ, "read rest 596.0, github 40.0" in
            # a window where most reads went out on the App, so nobody could tell GitHub's answers from local work.
            # One request's own record: another thread's request on this client clears self.in_call when it ends,
            # so reading it back here raised TypeError mid-post (huge-blue, 2026-11-22: "bad queue entry: TypeError
            # at glaeda-gh:6200 request" after the PR was already created).
            call = {"what": f"{method} {route} (app)", "since": time.monotonic()}
            self.in_call = call
            try:
                status, h, raw = self.send(method, path, headers, raw_body)
            except BaseException:
                self.note_spend("rest", route, 0)  # the App's pool, never the login's share
                raise
            finally:
                took = time.monotonic() - call["since"]
                self.note_spent("github", took)
                self.last_call = {"what": call["what"], "tookS": round(took, 1), "at": round(self.now, 3)}
                if self.in_call is call:
                    self.in_call = None
            try:
                doc = json.loads(raw) if raw else None
            except ValueError:
                doc = None
            if isinstance(doc, dict):
                errors = doc.get("errors")
                error_text = " ".join(str(e.get("type") or "") + " " + str(e.get("message") or "")
                                      for e in errors if isinstance(e, dict) and not protection_forbidden(e)
                                      ) if isinstance(errors, list) else ""
                message = " ".join(filter(None, (str(doc.get("message") or ""), error_text)))
            else:
                message = ""
            if pool.answered(owner, scope, status, h, message):
                self.note_spend("rest", route, 0)
                self.sent.append((self.now, "app"))
                return status, h, doc
            log({"event": "app-pool-refused", "role": pool.role, "owner": owner, "status": status, "route": route,
                 "scope": scope, "error": message[:200]})
            if self.app_pool is not None and self.app_pool.pick(owner, scope) is not None:
                # the refused pool now rests (or has marked the route), so this asks the next pool of the chain
                return self.request(method, path, body, etag, free, content)
            # refused: the same read goes on the login at once, as it would have without the App
            self.last_request_source = "login"
            if self.mode(bucket) == "stop" and self.clock() >= self.secondary_until:
                raise WatchError(f"{pool.role} App refused {scope}; login {bucket} is under its reserve")
        # The login's secondary hold (this daemon's, the pacer's, or a latch mark another caller wrote) holds the login
        # only: an App installation token has its own limits, so an App read above goes on while it lasts.
        if not self.secondary_admit(bucket, 1):
            # never sent: any request during a secondary hold (a write, a free /rate_limit) would only extend it
            raise WatchError(f"held: GitHub's secondary rate limit, {max(0, int(self.secondary_until - self.clock()))}s left")
        if self.token is None:
            self.token = self.token_source()
        headers = self.read_headers(self.token, etag, raw_body is not None)
        # The outbox -- a write and the lookups that keep it from landing twice -- is what sessions
        # asked for, at most one write per POST_SPACING, and would cost the same through gh. The share
        # caps the daemon's polling, so the outbox is neither counted against it nor held by it:
        # holding a lander's write until the hour turns would be an outage, not a saving.
        write = self.writing
        if not free and not write and not content:
            self.minute_admit(bucket)
        charged = bucket == "rest" and not free and not write
        if charged:
            # Charged before it is sent, and refunded only when GitHub says it was free (a 304): a
            # request whose answer never arrives (a body timeout) may still have been counted by
            # GitHub. The request's own minute, not the tick's: a tick can run TICK_BUDGET past its
            # start, and dating its requests early would let them leave the hour's window early.
            minute = int(self.clock() // 60)
            self.charge_rest(minute, 1)
        # One of the login's GraphQL slots on this host (graphql_slot_take), shared with every `glaeda-gh gh` read and every
        # other process's daemon or direct read, waited for within the tick's budget and held only while in flight.
        # The daemon's take wants the slot (priority): the next one that frees is its, ahead of the CLI's polling.
        what = (f"{method} {route_of(method, path)}" if bucket == "rest"
                else f"graphql {self.gql_reason or ''}").strip()
        waited_at = time.monotonic()
        slot = graphql_slot_take(min(self.tick_deadline, time.monotonic() + GRAPHQL_SLOT_WAIT), priority=True,
                                 what=f"daemon {what}") if bucket == "graphql" else None
        if bucket == "graphql":
            self.note_spent("slot", time.monotonic() - waited_at)
        if bucket == "graphql" and slot is None:
            held = "; ".join(f"slot {r['slot']} by thread {r['thread']} ({r['what']}) for {r['heldS']:.0f}s"
                             for r in graphql_slot_holders()) or "by other processes"
            raise WatchError(f"held: all {graphql_slots()} GraphQL slots of this login on this host are in flight "
                             f"({GRAPHQL_SLOT_DIR}/: {held}); not sent")
        call = {"what": what, "since": time.monotonic()}  # this request's own record (see the App path above)
        self.in_call = call
        if slot is not None:
            graphql_slot_flight(slot[0], True)
        try:
            status, h, raw = self.send(method, path, headers, raw_body)
        except BaseException:
            if bucket == "rest":  # never answered, but GitHub may have counted it (as charge_rest above assumes)
                self.note_spend("rest", route_of(method, path), 0 if free else 1)
            raise
        finally:
            took = time.monotonic() - call["since"]
            self.note_spent("github", took)
            self.last_call = {"what": what, "tookS": round(took, 1), "at": round(self.now, 3)}
            if self.in_call is call:
                self.in_call = None
            if slot is not None:
                graphql_slot_release(slot[0])
        if charged and status == 304:
            self.charge_rest(minute, -1)
        if bucket == "rest":  # GraphQL's points are known from its answer (graphql)
            self.note_spend("rest", route_of(method, path), 0 if free or status == 304 else 1)
        # `free` is /rate_limit, which costs no quota: counting it as a REST request would overstate
        # what the daemon spends.
        self.sent.append((self.now, "free" if free else "rest304" if bucket == "rest" and status == 304
                          else "write" if bucket == "rest" and write else bucket))
        if status == 401:
            self.token = None  # re-read from gh next time
        if "x-ratelimit-remaining" in h and h.get("x-ratelimit-resource", "core") in {"core", "graphql"}:
            try:
                reset = float(h.get("x-ratelimit-reset", ""))
            except ValueError:
                reset = None
            self.note_budget(bucket, h.get("x-ratelimit-limit"), h.get("x-ratelimit-remaining"), reset, path)
        try:
            doc = json.loads(raw) if raw else None
        except ValueError:
            doc = None
        message = str(doc.get("message") or "") if isinstance(doc, dict) else ""
        limited = bucket == "graphql" and isinstance(doc, dict) and any(
            isinstance(e, dict) and e.get("type") == "RATE_LIMITED" for e in doc.get("errors") or [])
        if status in {403, 429} and ((SECONDARY.search(message) and not (content and CONTENT_ONLY.search(message))) or (
                not content and h.get("retry-after") and h.get("x-ratelimit-remaining") != "0")):
            # A write's refusal too, unless GitHub says it blocks only content creation: then the outbox holds
            # itself (post_hold_for) and the reads go on, as they may.
            self.secondary_hit(bucket, h.get("retry-after"))
        elif (status in {403, 429} and not content and (h.get("retry-after") or h.get("x-ratelimit-remaining") == "0")) \
                or limited:
            # the primary limit: this bucket only; its reads move to the other one (route, tick)
            self.gql_limited = self.gql_limited or bucket == "graphql"
            try:
                wait = (retry_after_seconds(h["retry-after"]) if h.get("retry-after")
                        else float(h.get("x-ratelimit-reset", 0)) - self.now)
            except ValueError:
                wait = None
            wait = CYCLE if wait is None or math.isnan(wait) else min(wait, PACE_HOLD_MAX)
            # resumed at the reset plus this daemon's own place in the spread, not at the reset's first second
            until = self.now + max(CYCLE, wait)
            self.backoff[bucket] = until + pace_spread(f"{policy_host()}|glaeda-gh|{bucket}", until)
        elif status < 400 and not free:
            self.secondary_strikes = 0  # a clean answer: the next secondary hold starts short again
        return status, h, doc

    def minute_admit(self, bucket: str) -> None:
        """The per-minute cap (minute_cap_calls) on this daemon's own read requests per bucket: past it the request
        is not sent and the bucket stops until the window has room (backoff), so no read retries in a loop."""
        at = self.clock()
        sent = [t for t in self.minute_sent[bucket] if at - t < PACE_WINDOW]
        cap = int(pace_settings()["minute_cap_calls"])
        if len(sent) >= cap:
            free_at = sent[len(sent) - cap] + PACE_WINDOW
            self.minute_sent[bucket] = sent
            self.backoff[bucket] = max(self.backoff[bucket], free_at)
            raise WatchError(f"held: {len(sent)} {bucket} requests in the last 60 s, the per-minute cap "
                             f"minute_cap_calls={cap} (gh-quota.json); next at {utc_clock(free_at)}")
        sent.append(at)
        self.minute_sent[bucket] = sent

    def secondary_admit(self, bucket: str, n: int) -> bool:
        """Whether n more read requests may go to GitHub now: not while this daemon's own secondary hold
        lasts, nor while the host's pacer (PACE_FILE) holds every caller on the account."""
        self.adopt_pace_hold()
        return self.clock() >= self.secondary_until

    def adopt_pace_hold(self) -> None:
        """Take on the pacer's hold (another caller met the secondary limit), so both buckets stop for it; and a
        login latch mark another caller wrote for the secondary limit (source "secondary"), resumed past its end at
        this daemon's own place in the reset spread."""
        doc = read_json(BASE / PACE_FILE)
        hold = doc.get("hold") if isinstance(doc, dict) else None
        until = hold.get("until") if isinstance(hold, dict) else None
        marked = latch_secondary_until(self.clock())
        if marked is not None and marked > self.secondary_until:
            marked += pace_spread(f"{policy_host()}|glaeda-gh", marked)
            if not isinstance(until, (int, float)) or isinstance(until, bool) or marked > until:
                until = marked
        if isinstance(until, (int, float)) and not isinstance(until, bool) and until > max(self.clock(), self.secondary_until):
            until = min(until, self.clock() + PACE_HOLD_MAX)  # a corrupt far future holds an hour at most
            if until > self.secondary_until:
                self.secondary_until = until
                for b in self.backoff:
                    self.backoff[b] = max(self.backoff[b], until)
                log({"event": "secondary", "source": "pace", "hold": round(until - self.clock())})

    def report_secondary(self, hold: float) -> None:
        """Tell the host's pacer, when one is installed, so every other caller holds too. Best effort."""
        try:
            cli = PACE_CLI.resolve().parent / "gh_quota.py"
            if cli.is_file():
                run_bounded([sys.executable, "-I", os.fspath(cli), "secondary", "--retry-after",
                             str(int(math.ceil(min(hold, PACE_HOLD_MAX)))), "--source", "glaeda-gh"], PACE_DEADLINE)
        except (OSError, subprocess.SubprocessError, ValueError, OverflowError) as error:
            self.errors.append(f"pace: {describe(error)}")

    def secondary_hit(self, bucket: str, retry_after: Any) -> None:
        """A secondary 403 or 429: hold both buckets (the limit is one for REST and GraphQL), for its
        Retry-After or the doubling back-off, whichever is longer. Never a retry within the same hold."""
        self.secondary_strikes += 1
        told = retry_after_seconds(retry_after) or 0.0
        hold = max(told, min(SECONDARY_BACKOFF_MAX, SECONDARY_BACKOFF * 2 ** (self.secondary_strikes - 1)))
        # from when the refusal arrived: a tick can run TICK_BUDGET past self.now, its start
        self.secondary_until = max(self.secondary_until, self.clock() + hold)
        for b in self.backoff:
            self.backoff[b] = max(self.backoff[b], self.secondary_until)
        log({"event": "secondary", "bucket": bucket, "hold": round(hold), "strikes": self.secondary_strikes})
        latch_write_secondary(self.clock(), self.secondary_until)  # every caller on the host holds too
        self.report_secondary(self.secondary_until - self.clock())

    # -- the outbox: content writes (comments, PRs, reviews) queued by `glaeda-gh post`

    def outbox_actor(self, item: dict) -> dict | None:
        """Pick the installed writer on the same host as the login. No token goes in the outbox."""
        op = {"pr": "create", "comment": "comment"}.get(item.get("kind"))
        if (not op or self.upstream() is not None or item.get("status") or item.get("delivered") or item.get("reviewers") or
                os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")):
            return None
        if op == "comment" and (RISK_RECEIPT.search(item["body"]) or
                re.search(r"<!--|^\s*(?:/|owner:)", item["body"], re.M | re.I)):
            return None
        role = "lander" if op == "create" else "review"
        saved = item.get("appWriter")
        if saved is None and (item.get("uncertain") or item.get("attempts")):
            return None  # the first send was already attempted by the login
        if saved not in (None, role):
            return None
        state = latch_state_dir()
        def held(identity):
            doc = read_json(state / ("rest-exhausted" + identity + ".json")) or {}
            until = doc.get("until") if isinstance(doc, dict) else None
            return doc if isinstance(until, (int, float)) and until > self.clock() and not doc.get("share") and \
                doc.get("counter") in (None, "core") else {}
        if not saved and held("").get("source") not in ("x-ratelimit-reset", "said"):
            return None
        if held("@app-" + role):
            return None
        tool = app_pool_tool()
        if not tool:
            return None
        try:
            result = run_bounded([sys.executable, "-I", str(tool), "broker-actor", op, item["repo"]], timeout=12)
            actor = json.loads(result.stdout) if not result.returncode else None
            if isinstance(actor, dict) and actor.get("role") == role and isinstance(actor.get("note"), str) and \
                    re.fullmatch(r"ghs_[A-Za-z0-9._-]{20,2048}", str(actor.get("token", ""))):
                return actor
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
        return None

    def post_tick(self) -> None:
        """Send at most one queued write per tick, POST_SPACING after the last one and never while GitHub's
        secondary limit holds the outbox. Land-gating writes first (outbox_gate), then oldest first; a write waiting
        out its own retry is skipped."""
        self.post_tried = self.now
        self.adopt_pace_hold()
        if self.clock() < self.secondary_until:
            return  # a read met the secondary limit: writes wait it out too, as one account's
        if self.now < max(self.post_hold, self.post_at + POST_SPACING):
            return
        for path, item in self.retire_superseded(outbox_queue()):
            if not isinstance(item, dict) or item.get("id") != path.stem:
                with contextlib.suppress(OSError):
                    if self.now - path.stat().st_mtime > POST_UNREADABLE:
                        self.post_finish(path, {"id": path.stem}, error="unreadable queue entry")
                continue
            if (item.get("notBefore") or 0) > self.now:
                continue
            if item.get("joinedInto") and self.post_member(path, item):
                continue  # it goes out in (or went out with) its leader's comment: no request of its own
            if self.now < self.content_pause_until() or self.content_pause_unknown():
                return  # shared content/secondary cooldown also holds an App-authored write
            actor = self.outbox_actor(item)
            if item.get("appWriter") and not actor and not item.get("delivered"):
                continue  # never replay an App-authored POST with the login
            if not actor and self.backoff["rest"] > self.now and not (item.get("kind") == "comment" and self.post_over_graphql(item)):
                continue
            self.writing = True
            try:
                with self.calling("outbox", str(item.get("repo") or "")):
                    self.post_one(path, item, actor)
            except OutOfTime:
                pass
            except Exception as error:  # noqa: BLE001  a malformed entry (a key missing, an unknown kind) fails alone
                self.post_finish(path, item, error=f"bad queue entry: {describe(error)} at {error_site(error)}")
            finally:
                self.writing = False
            return

    def post_due(self) -> None:
        """post_between on the outbox's own clock, asked before every read request: once POST_SPACING has passed since
        post_tick last ran, the outbox gets its turn, under every hold post_tick keeps (the pacer, the secondary limit,
        the content pause). Between batches alone was not enough: on huge-blue 2026-11-21 15:4xZ a pass took ~95 s,
        most of it the REST loop, which had no post_between, so posts went out ~95 s apart (0.6-0.7 a minute) while
        writes came in at 1.15 a minute and review receipts waited up to 173 min."""
        clock = time.time() if self.clock_real else self.now
        if self.writing or clock - self.post_tried < POST_SPACING:
            return
        self.post_between()

    def retire_superseded(self, queue: list[tuple[Path, Any]]) -> list[tuple[Path, Any]]:
        """The queue less every review-running marker superseded_by retires, over the whole queue: receipts sort
        first, so a send loop that stops at its one write would never reach the markers behind them. A retirement
        is no request: it costs no turn."""
        marks = [(p, i) for p, i in queue if isinstance(i, dict) and i.get("id") == p.stem
                 and REVIEW_MARK.match(str(i.get("body") or ""))]
        if not marks:
            return queue
        ended = read_json(BASE / RUN_ENDS)
        ended = ended if isinstance(ended, dict) else {}
        gone: set[Path] = set()
        for path, item in marks:
            why = superseded_by(item, queue, ended)
            if why:
                self.post_finish(path, item, superseded=why)
                gone.add(path)
        return [(p, i) for p, i in queue if p not in gone]

    def post_between(self) -> None:
        """post_tick between read batches: a read phase can take TICK_BUDGET, far longer than POST_SPACING."""
        tick_now = self.now
        self.now = time.time() if self.clock_real else self.now  # the outbox's own clock; the reads keep theirs
        try:
            self.post_tick()
        except Exception as error:  # noqa: BLE001
            self.errors.append(f"outbox: {describe(error)} at {error_site(error)}")
        finally:
            self.now = tick_now

    def content_pause_until(self) -> float:
        """When the login's create pause ends (0: none), asked at most every CONTENT_PAUSE_TTL. The ask runs on its
        own thread: the daemon waits CONTENT_PAUSE_DEADLINE for it on its main thread (the reads and waits lose that
        to a hung keeper), and a slower answer, up to CONTENT_PAUSE_SLOW_DEADLINE, is taken on a later pass. A failed
        or timed-out ask keeps the last answer and is not repeated for CONTENT_PAUSE_RETRY; content_pause_unknown says
        whether that answer is too old to post on. The pacer's own hold (adopt_pace_hold) applies either way."""
        cmd = content_pause_cmd()
        if cmd is None:
            return 0.0
        clock = self.clock()
        wait = 0.0
        if self.pause_ask is None and clock >= self.pause_next:
            self.pause_next = clock + CONTENT_PAUSE_RETRY  # until it answers
            self.pause_first_ask = clock if self.pause_first_ask is None else self.pause_first_ask
            self.pause_result = None
            self.pause_ask = threading.Thread(target=self.content_pause_ask, args=(cmd, clock), daemon=True,
                                              name="content-pause-ask")
            self.pause_ask.start()
            wait = CONTENT_PAUSE_DEADLINE
        if self.pause_ask is not None:
            self.pause_ask.join(wait)
            if not self.pause_ask.is_alive():
                self.content_pause_adopt()
        return self.pause_until

    def content_pause_ask(self, cmd: list[str], asked: float) -> None:
        """The ask, on its own thread: sets pause_result to ("ok", (asked, blocked_until)), ("absent", (asked, why)):
        the keeper has no content-pause, ("timeout", why) or ("error", why), and nothing else."""
        try:
            done = run_bounded([*cmd, "content-pause"], CONTENT_PAUSE_SLOW_DEADLINE)
            said = (done.stderr or done.stdout or "").strip()
            if done.returncode != 0 and CONTENT_PAUSE_USAGE.search(said):
                # argparse's last line says what it refused; the usage before it can run past keeper_text's bound
                why = next((line for line in reversed(said.splitlines()) if CONTENT_PAUSE_USAGE.search(line)), said)
                self.pause_result = ("absent", (asked, f"exit {done.returncode}: {keeper_text(why.strip())}"))
                return
            doc = json.loads(done.stdout) if done.returncode == 0 else None
            if not isinstance(doc, dict):
                raise WatchError(f"exit {done.returncode}: {keeper_text(said)}")
            # The keeper prints a number, 0 for no pause. Anything else ("", [], {}, a bool, null, no key, NaN or
            # Infinity) is a failed ask and the last answer stands: `or 0` read "", [] and {} as "no pause".
            until = doc.get("blocked_until")
            if isinstance(until, bool) or not isinstance(until, (int, float)) or not math.isfinite(until):
                raise WatchError(keeper_text(f"blocked_until {until!r}" if "blocked_until" in doc
                                             else "no blocked_until"))
            # blocked_until alone decides; level is the pacer's backoff state, never whether it is paused.
            # float() of an int past a float's range (json reads 1e400 written out as digits) raises OverflowError.
            self.pause_result = ("ok", (asked, float(until)))
        except subprocess.TimeoutExpired:
            self.pause_result = ("timeout", f"no answer within {CONTENT_PAUSE_SLOW_DEADLINE:g}s")
        except Exception as error:  # noqa: BLE001  OSError, ValueError, OverflowError: a failed ask, as any other
            self.pause_result = ("error", describe(error))

    def content_pause_adopt(self) -> None:
        """Take the finished ask's outcome, on the main thread."""
        self.pause_ask = None
        outcome, self.pause_result = self.pause_result, None
        if outcome is None:
            return
        kind, value = outcome
        clock = self.clock()
        if kind == "absent":
            asked, why = value
            if not self.pause_absent:
                log({"event": "content-pause-absent", "error": why,
                     "next": f"posting as with no keeper; asked again every {CONTENT_PAUSE_ABSENT_REPROBE}s"})
            self.pause_absent = True
            self.pause_next = asked + CONTENT_PAUSE_ABSENT_REPROBE
            self.pause_answered_at = clock  # an answer: a later failure holds from here, for CONTENT_PAUSE_BLIND_MAX
            self.pause_failures = self.pause_timeouts = 0
            self.pause_error, self.pause_blind_logged = None, False
            return
        if self.pause_absent:
            log({"event": "content-pause-absent", "error": None, "next": "the keeper answers content-pause again"})
            self.pause_absent = False
        if kind == "ok":
            asked, until = value
            until = min(until, clock + PACE_HOLD_MAX)  # a corrupt far future holds an hour at most
            if self.pause_reported is not None and self.pause_reported[0] >= asked:
                # a 403 reported after this ask began: the answer may predate it, so it never lowers the pause
                until = max(until, self.pause_reported[1])
            if until > max(self.now, self.pause_until):
                log({"event": "post-paused", "source": "login", "hold": round(until - self.now)})
            self.pause_until = until
            self.pause_next = asked + CONTENT_PAUSE_TTL
            self.pause_answered_at = clock
            self.pause_failures = self.pause_timeouts = 0
            self.pause_error, self.pause_blind_logged = None, False
            return
        self.pause_failures += 1
        self.pause_timeouts += kind == "timeout"
        self.pause_error = str(value)
        self.errors.append(f"content pause: {value}")

    def content_pause_unknown(self) -> bool:
        """Whether creates wait because the pause is not known: no answer within CONTENT_PAUSE_RETRY, and the ask is
        still running or failing. For CONTENT_PAUSE_BLIND_MAX past the last answer (or the first ask) at most: past
        it a keeper that never answers stops nothing, and the outbox posts as a host with no keeper (logged once)."""
        if self.pause_ask is None and self.pause_failures == 0 or self.pause_absent:
            return False  # a recent answer, or a keeper without content-pause: no keeper, as on a host with none
        clock = self.clock()
        known = self.pause_answered_at if self.pause_answered_at is not None else self.pause_first_ask
        if known is None or clock - known < CONTENT_PAUSE_RETRY and self.pause_answered_at is not None:
            return False  # a recent answer stands
        if clock - known < CONTENT_PAUSE_BLIND_MAX:
            return True
        if not self.pause_blind_logged:
            self.pause_blind_logged = True
            log({"event": "post-pause-unknown", "failures": self.pause_failures, "error": self.pause_error,
                 "since": round(clock - known)})
        return False

    def content_pause_status(self) -> dict | None:
        """daemon.json outbox.pause: the ask's state for `post status`, or None when no ask was made."""
        if self.pause_first_ask is None:
            return None
        clock = self.clock()
        return {"until": self.pause_until if self.pause_until > clock else None,
                "answeredAgo": None if self.pause_answered_at is None else round(clock - self.pause_answered_at),
                "failures": self.pause_failures, "timeouts": self.pause_timeouts, "lastError": self.pause_error,
                "asking": self.pause_ask is not None, "holding": self.content_pause_unknown(),
                "absent": self.pause_absent}

    def content_pause_settle(self, timeout: float) -> None:
        """Wait up to `timeout` for the ask and the report in flight, and take the ask's answer (tests). Nothing
        calls it at shutdown or re-exec: the daemon has no exit path (serve loops until killed or re-execs itself),
        a report's keeper process outlives the exec, and the new daemon asks the pause afresh."""
        deadline = time.monotonic() + timeout
        for thread in (self.pause_ask, self.pause_report):
            if thread is not None:
                thread.join(max(0.0, deadline - time.monotonic()))
        if self.pause_ask is not None and not self.pause_ask.is_alive():
            self.content_pause_adopt()

    def report_content_pause(self, until: float, kind: str) -> None:
        """Extend the login's create pause to `until` for this throttled write, so every writer waits it out. An hour
        at most (PACE_HOLD_MAX), as the hold it came from. The report runs on its own thread, off the post's path,
        bounded by CONTENT_PAUSE_REPORT_DEADLINE (the keeper's file lock can be held by another writer); a hold asked
        while one is in flight is sent after it, the later of the two."""
        until = min(until, self.clock() + PACE_HOLD_MAX)
        if math.isnan(until):
            return
        self.pause_until = max(self.pause_until, until)
        self.pause_reported = (self.clock(), max(until, self.pause_reported[1] if self.pause_reported else until))
        cmd = content_pause_cmd()
        if cmd is None or self.pause_absent:
            return  # no keeper, or one without content-pause: the hold stays this daemon's own
        with self.pause_report_lock:
            want = self.pause_report_want
            self.pause_report_want = (until, kind) if want is None or until > want[0] else want
            if self.pause_report is None:
                self.pause_report = threading.Thread(target=self.content_pause_reporter, args=(cmd,), daemon=True,
                                                     name="content-pause-report")
                self.pause_report.start()

    def content_pause_reporter(self, cmd: list[str]) -> None:
        """The report's thread: sends the wanted hold until none is left. Errors go to self.errors (a list append)."""
        while True:
            with self.pause_report_lock:
                want, self.pause_report_want = self.pause_report_want, None
                if want is None:
                    self.pause_report = None
                    return
            until, kind = want
            try:
                done = run_bounded([*cmd, "content-pause", "--hold", str(int(math.ceil(until))),
                                    "--what", f"glaeda outbox {kind}"], CONTENT_PAUSE_REPORT_DEADLINE)
                if done.returncode != 0:
                    self.errors.append(f"content pause hold: exit {done.returncode}")
            except subprocess.TimeoutExpired:
                self.errors.append(f"content pause hold: no answer within {CONTENT_PAUSE_REPORT_DEADLINE:g}s")
            except Exception as error:  # noqa: BLE001  OSError, ValueError, OverflowError
                self.errors.append(f"content pause hold: {describe(error)}")

    def post_hold_for(self, h: dict, path: Path, item: dict) -> None:
        try:
            wait = (retry_after_seconds(h["retry-after"]) or 0.0) if h.get("retry-after") else (
                float(h.get("x-ratelimit-reset", 0)) - self.now if h.get("x-ratelimit-remaining") == "0" else 0.0)
        except ValueError:
            wait = 0.0
        wait = 0.0 if math.isnan(wait) else min(wait, PACE_HOLD_MAX)  # an hour at most, as every other hold
        wait = max(wait, self.post_backoff) if wait <= 0 else wait
        self.post_backoff = min(POST_BACKOFF_MAX, self.post_backoff * 2)
        self.post_hold = self.now + max(POST_SPACING, wait)
        item["throttled"] = int(item.get("throttled") or 0) + 1
        item["holdUntil"] = self.post_hold
        write_json(path, item)
        log({"event": "post-throttled", "id": item["id"], "wait": round(wait)})
        if h.get("retry-after") or h.get("x-ratelimit-remaining") != "0":
            # the secondary limit, not the hourly one: the pause is the login's, so report it where every writer reads
            self.report_content_pause(self.post_hold, str(item.get("kind") or "write"))

    def post_one(self, path: Path, item: dict, actor: dict | None = None) -> None:
        if item.get("delivered"):
            self.post_delivered(path, item)
            return
        if item.get("uncertain"):
            # The last attempt's answer was lost: it may have landed. Look before writing twice, and send only
            # when the look answered "not there"; a look that failed leaves it uncertain for the next try.
            found, looked = self.post_find(item, actor)
            if found:
                self.post_delivered(path, item, found, note="found after a lost answer")
                return
            if not looked:
                self.post_at = self.now
                self.post_retry(path, item, "could not look for an earlier attempt", uncertain=True)
                return
        # a look that answered "not there": nothing landed, so a join may still be undone; it is resent over REST
        resend = bool(item.pop("uncertain", False))
        if not actor and item["kind"] == "comment" and not item.get("group"):
            self.post_join(path, item)
        elif item.get("group") and not item.get("delivered") \
                and self.thread_watched(str(item["repo"]), item["number"]):
            self.post_unjoin(path, item)  # a wait began watching the thread since the join: each goes out alone
        if not actor and item["kind"] == "comment" and not resend and self.post_over_graphql(item):
            return self.post_comment_graphql(path, item)
        method, api, body = post_request(item)
        if actor:
            item["appWriter"] = actor["role"]  # persist the author before the POST; never its credential
            if item["kind"] == "pr":
                body["body"] = actor["note"] + "\n\n" + body["body"]
        write_json(path, {**item, "uncertain": True})  # a daemon that dies mid-request looks it up first
        try:
            status, h, doc = self.outbox_request(method, api, body, actor)
        except WatchError as error:
            self.post_at = self.now
            self.post_retry(path, item, describe(error), uncertain=True)
            return
        except OutOfTime:
            write_json(path, item)  # raised before anything was sent
            raise
        self.post_at = self.now
        item["uncertain"] = False  # GitHub answered; a 5xx below sets it again
        doc = doc if isinstance(doc, dict) else {}
        text = json.dumps(doc)[:2000]
        if 200 <= status < 300:
            self.post_backoff = POST_BACKOFF
            note = self.post_after(item, doc)
            if item["kind"] == "comment":
                self.note_status(item, doc.get("node_id"), doc.get("id"), doc.get("html_url"))
            self.post_delivered(path, item, doc, note=note)
        elif actor and status in (403, 429) and h.get("x-ratelimit-remaining") == "0" and not h.get("retry-after") and not THROTTLED.search(text):
            reset = str(h.get("x-ratelimit-reset", ""))
            item["notBefore"] = max(self.now + POST_SPACING, min(self.now + PACE_HOLD_MAX, int(reset)) if reset.isdigit() else 0)
            write_json(path, item)  # only the App is out; other outbox items keep their turn
        elif not actor and self.rest_out(status, h, text):
            write_json(path, item)  # nothing was written: GraphQL posts it if it can, else it waits for REST's reset
        elif status in {403, 422, 429} and (THROTTLED.search(text) or status == 429 or h.get("retry-after")
                                            or h.get("x-ratelimit-remaining") == "0"):
            self.post_hold_for(h, path, item)
        elif status >= 500:
            self.post_retry(path, item, f"HTTP {status}", uncertain=True)  # a POST that 502s often landed
        elif status == 401:
            self.post_retry(path, item, f"HTTP {status}")
        elif item["kind"] == "pr" and status == 422 and "already exists" in text:
            found, _ = self.post_find(item, actor)
            self.post_finish(path, item, url=found.get("html_url") if found else None,
                             note="a pull request for this head is already open",
                             error=None if found else f"HTTP 422: {doc.get('message') or 'already exists'}")
        else:
            self.post_finish(path, item, error=write_failure(item, status, doc, known=broker_repo_slugs()))

    def post_after(self, item: dict, doc: dict) -> str | None:
        """A new PR's requested reviewers (not content creation, so no spacing); a failure is a note."""
        if item["kind"] != "pr" or not item.get("reviewers") or not doc.get("number"):
            return None
        try:
            status, _, answer = self.request("POST", f"/repos/{item['repo']}/pulls/{doc['number']}/requested_reviewers",
                                             {"reviewers": item["reviewers"]}, content=True)
        except (WatchError, OutOfTime) as error:
            return f"reviewers not requested: {describe(error) if isinstance(error, WatchError) else 'out of time'}"
        if 200 <= status < 300:
            return None
        return f"reviewers not requested: HTTP {status} {(answer or {}).get('message', '') if isinstance(answer, dict) else ''}".strip()

    def post_delivered(self, path: Path, item: dict, doc: dict | None = None, note: str | None = None) -> None:
        """Checkpoint delivery before follow-up effects: a failed/interrupted regrade never replays content."""
        if doc is not None:
            item["delivered"] = {"url": doc.get("html_url"), "number": doc.get("number"), "note": note}
            first = next((line for line in str(item.get("body") or "").splitlines() if line.strip()), "")
            receipt = RISK_RECEIPT.match(first)
            heads = re.findall(r"(?<![\w])[0-9a-f]{40}(?![\w])", first)
            user = doc.get("user") or {}
            if (item.get("kind") in {"comment", "review"} and item.get("repo") == "manaflow-ai/cmux"
                    and receipt and "self" not in receipt.group(1).lower() and len(heads) == 1
                    and isinstance(user, dict) and user.get("type") == "User"
                    and doc.get("author_association") in {"OWNER", "MEMBER", "COLLABORATOR"}):
                item["riskRegrade"] = {"state": "pending", "head": heads[0]}
            write_json(path, item)
        regrade = item.get("riskRegrade")
        if regrade and regrade["state"] == "pending":
            try:
                self.post_risk_regrade(path, item)
            except OutOfTime:
                raise  # the next outbox turn resumes follow-up work, never the delivered POST
            except Exception as error:  # noqa: BLE001 preserve successful delivery even if follow-up fails
                regrade.update(state="failed", error=describe(error))
            write_json(path, item)
        delivery = item["delivered"]
        note = delivery.get("note")
        if regrade and regrade["state"] in {"failed", "uncertain"}:
            note = "; ".join(filter(None, [note, f"risk regrade {regrade['state']}: {regrade.get('error', '')}"]))
        self.post_finish(path, item, url=delivery.get("url"), number=delivery.get("number"), note=note)

    def post_risk_regrade(self, path: Path, item: dict) -> None:
        """One fresh PR read and at most one label removal, using the existing unlabeled event.

        The trusted base classifier restores its tier and decides evidence. No code is fetched or run.
        Record uncertainty before DELETE; after a crash we report it rather than repeat an unknown effect.
        """
        regrade = item["riskRegrade"]
        if self.mode("rest") == "stop":
            regrade.update(state="failed", error="REST budget stopped")
            return
        status, _, pull = self.request("GET", f"/repos/{item['repo']}/pulls/{item['number']}")
        if status != 200 or not isinstance(pull, dict):
            regrade.update(state="failed", error=f"PR metadata HTTP {status}")
            return
        if (pull.get("state") != "open" or (pull.get("base") or {}).get("ref") != "feat-cmux-next"
                or (pull.get("head") or {}).get("sha") != regrade["head"]):
            regrade.update(state="skipped", reason="PR is not open on the receipt's head and feat-cmux-next base")
            return
        labels = [label.get("name") for label in pull.get("labels") or [] if isinstance(label, dict)
                  and label.get("name") in {"risk:low", "risk:medium", "risk:normal", "risk:high"}]
        if len(labels) != 1:
            regrade.update(state="skipped", reason="no single current risk tier")
            return
        if labels[0] != "risk:high":
            # Only risk:high reads a receipt (cmux scripts/ci/risk_tier.py: "Only looked up for high"). A low or
            # normal label removal changed no verdict, but its unlabeled and the grader's relabel each started
            # every labeled-triggered workflow again: a whole CI run, webview suite included, that merge-guard
            # then waited on (cmux#29666, 2026-10-31).
            regrade.update(state="skipped", reason=f"{labels[0]} reads no receipt")
            return
        if self.mode("rest") == "stop":
            regrade.update(state="failed", error="REST budget stopped")
            return
        regrade.update(state="uncertain", label=labels[0], error="label write interrupted; inspect the risk run")
        write_json(path, item)
        try:
            status, h, answer = self.request("DELETE", f"/repos/{item['repo']}/issues/{item['number']}/labels/"
                                            + urllib.parse.quote(labels[0], safe=""), content=True)
        except OutOfTime:
            regrade.update(state="pending")  # request refused before sending
            write_json(path, item)
            raise
        if 200 <= status < 300:
            regrade.update(state="triggered")
            regrade.pop("error", None)
        else:
            regrade.update(state="failed", error=f"label removal HTTP {status}")
            text = json.dumps(answer)[:2000]
            if self.rest_out(status, h, text):
                pass  # REST's hour, not a secondary limit: comments go on over GraphQL
            elif status in {403, 422, 429} and (status == 429 or h.get("retry-after")
                    or h.get("x-ratelimit-remaining") == "0" or THROTTLED.search(text)):
                self.post_hold_for(h, path, item)

    def outbox_request(self, method: str, api: str, body: dict | None, actor: dict | None):
        if not actor:
            return self.request(method, api, body, content=method != "GET")
        if time.monotonic() >= self.tick_deadline or not self.secondary_admit("rest", 1):
            raise OutOfTime
        headers = {"Authorization": "Bearer " + actor["token"], "Accept": "application/vnd.github+json",
                   "Content-Type": "application/json", "User-Agent": "glaeda-gh", "X-GitHub-Api-Version": "2022-11-28"}
        status, h, raw = self.transport(method, API + api, headers, json.dumps(body).encode() if body is not None else None)
        self.sent.append((self.now, "app"))
        try:
            return status, h, json.loads(raw) if raw else None
        except ValueError:
            raise WatchError("App request returned an unreadable response") from None

    def post_find(self, item: dict, actor: dict | None = None) -> tuple[dict | None, bool]:
        """(this write if it already landed, whether the look got an answer): the open PR for its head,
        or a comment or review with the same body posted since it was queued."""
        repo, since = item["repo"], dt.datetime.fromtimestamp(item["queuedAt"] - 60, dt.timezone.utc)
        if item["kind"] == "pr":
            head = item["head"] if ":" in item["head"] else f"{repo.split('/')[0]}:{item['head']}"
            api = f"/repos/{repo}/pulls?state=open&head={urllib.parse.quote(head)}&base={urllib.parse.quote(item['base'])}"
        elif item["kind"] == "comment":
            api = f"/repos/{repo}/issues/{item['number']}/comments?per_page=100&since={since.strftime('%Y-%m-%dT%H:%M:%SZ')}"
        else:
            api = f"/repos/{repo}/pulls/{item['number']}/reviews?per_page=100"
        try:
            status, h, doc = self.outbox_request("GET", api, None, actor)
            last = re.search(r'<([^>]+)>;\s*rel="last"', h.get("link") or "")
            if status == 200 and last and last.group(1).startswith(API + "/"):
                status, _, doc = self.outbox_request("GET", last.group(1)[len(API):], None, actor)
        except WatchError:
            return None, False
        if status != 200 or not isinstance(doc, list):
            return None, False
        for found in reversed(doc):
            if isinstance(found, dict) and (item["kind"] == "pr" or (found.get("body") or "") == item["body"]):
                if found.get("html_url"):
                    return found, True
        return None, True

    def post_retry(self, path: Path, item: dict, error: str, uncertain: bool = False) -> None:
        item["attempts"] = int(item.get("attempts") or 0) + 1
        item["lastError"] = error
        item["uncertain"] = uncertain
        if item["attempts"] >= POST_ATTEMPTS:
            self.post_finish(path, item, error=f"gave up after {item['attempts']} attempts: {error}")
            return
        item["notBefore"] = self.now + POST_RETRY * item["attempts"]
        write_json(path, item)

    def post_finish(self, path: Path, item: dict, url: str | None = None, number: Any = None,
                    note: str | None = None, error: str | None = None, superseded: str | None = None) -> None:
        """SUPERSEDED: the write was retired unsent, for that recorded reason (superseded_by); never deleted silently."""
        done = {k: v for k, v in item.items() if k not in {"body", "ownBody", "notBefore", "holdUntil"}}
        state = "superseded" if superseded else "failed" if error else "posted"
        done.update({"state": state, "url": url, "number": number if not superseded else item.get("number"),
                     "note": superseded or note, "error": error, "finishedAt": self.now})
        if state == "posted":
            with contextlib.suppress(Exception):
                note_run_ends(item, self.now)
        write_json(posted_dir() / path.name, done)
        path.unlink(missing_ok=True)
        for member in item.get("group") or []:  # one comment for all of them: each caller gets its URL
            mpath = outbox_dir() / f"{member}.json"
            other = read_json(mpath)
            if isinstance(other, dict) and other.get("joinedInto") == item.get("id"):
                self.post_finish(mpath, other, url=url, number=number, error=error,
                                 note=f"posted in one comment with {len(item['group'])} other queued comment"
                                      f"{'s' if len(item['group']) > 1 else ''} for this thread")
        with contextlib.suppress(Exception):  # answers this host's gh cache kept from before the write (none: unsent)
            if not superseded:
                gh_cache_note_write(str(item.get("repo") or "").lower() or None, time.time(), gh_cache_post_scopes(item))
        log({"event": "post", "id": done.get("id"), "state": done["state"], "url": url, "error": error,
             **({"why": superseded} if superseded else {})})

    # -- the outbox's comments: joined per thread, over the richer bucket, a writer's status edited in place

    @staticmethod
    def joinable(item: dict) -> bool:
        """Plain prose only: never anything a wait, a bot or a reader keys on (a slash command, an @mention, an HTML
        marker, a review receipt), nor a status, nor a write already tried."""
        body = str(item.get("body") or "")
        first = next((line for line in body.splitlines() if line.strip()), "").strip()
        return (item.get("kind") == "comment" and not item.get("status") and not item.get("uncertain")
                and not item.get("delivered") and not item.get("group") and not item.get("joinedInto") and not item.get("gate")
                and not int(item.get("attempts") or 0) and isinstance(item.get("by"), str) and bool(item["by"])
                and not first.startswith(("<!--", "/")) and not RISK_RECEIPT.match(first)
                and not JOIN_MENTION.search(body))

    def post_join(self, path: Path, item: dict) -> None:
        """Join the comments queued for this thread within POST_JOIN_WINDOW of ITEM into ITEM's comment, in queue
        order. Each member is marked joinedInto first, then the leader is written with the joined body and its
        group: a crash between the two leaves members whose leader does not name them, and those are released
        (post_member) instead of being posted twice."""
        if not self.joinable(item) or self.thread_watched(str(item["repo"]), item["number"]):
            return  # a wait watching the thread may match a member's first line: each goes out on its own
        # at most what every comment reader keeps of a body (COMMENT_BODY_MAX characters): a member past it would
        # drop out of the cached comment a wait matches (`--match READY` after a long comment)
        members, size = [], len(str(item["body"]))
        for other_path in sorted(outbox_dir().glob("*.json")):  # queue order
            if other_path.stem <= path.stem:
                continue  # the leader, and what was queued before it
            other = read_json(other_path)
            if not isinstance(other, dict) or other.get("id") != other_path.stem:
                continue
            if other.get("kind") not in {"comment", "review"} or other.get("repo") != item.get("repo") \
                    or other.get("number") != item.get("number"):
                continue  # another thread's write: it does not stand between this thread's comments
            if (not self.joinable(other) or other.get("by") != item.get("by") or (other.get("notBefore") or 0) > self.now
                    or not 0 <= float(other.get("queuedAt") or 0) - float(item.get("queuedAt") or 0) <= POST_JOIN_WINDOW):
                break  # a write to this thread that stays on its own: nothing queued after it moves ahead of it
            grown = size + len(POST_JOIN_RULE) + len(str(other["body"]))
            if grown > COMMENT_BODY_MAX:
                break
            members.append((other_path, other))
            size = grown
        if not members:
            return
        for other_path, other in members:
            write_json(other_path, {**other, "joinedInto": item["id"]})
        item["group"] = [other["id"] for _, other in members]
        item["ownBody"] = item["body"]
        item["body"] = POST_JOIN_RULE.join([str(item["body"])] + [str(other["body"]) for _, other in members])
        write_json(path, item)
        log({"event": "post-join", "id": item["id"], "joined": item["group"]})

    def post_unjoin(self, path: Path, item: dict) -> None:
        """Undo a join not yet sent: the leader takes back its own body and its members, no longer named, are released
        (post_member) and sent on their own."""
        item["body"] = item.pop("ownBody", item["body"])
        released = item.pop("group", [])
        write_json(path, item)
        log({"event": "post-unjoin", "id": item["id"], "released": released})

    def post_member(self, path: Path, item: dict) -> bool:
        """A member of a joined comment: True while its leader holds it (or once it took the leader's answer),
        False when the leader does not name it (a join cut short), so it is sent on its own."""
        leader = item["joinedInto"]
        queued = read_json(outbox_dir() / f"{leader}.json")
        if isinstance(queued, dict) and item["id"] in (queued.get("group") or []):
            return True
        done = read_json(posted_dir() / f"{leader}.json")
        if not isinstance(queued, dict) and isinstance(done, dict) and item["id"] in (done.get("group") or []):
            self.post_finish(path, item, url=done.get("url"), number=done.get("number"), error=done.get("error"),
                             note="posted in one comment with other queued comments for this thread")
            return True
        item.pop("joinedInto", None)
        write_json(path, item)
        return False

    def outbox_richness(self, bucket: str) -> float:
        """richness() for the outbox: the daemon's own REST share does not hold sessions' writes, nor does the hard
        reserve, which holds the daemon's own reads (a queued write is a session's, sent once, and its routing between
        the buckets is not a read): it weighs the configured reserve (writeFloors)."""
        if self.backoff[bucket] > self.now:
            return -1.0
        seen = self.budget.get(bucket) or {}
        limit = seen.get("limit") or 5000
        reserve = (self.policy.get("writeFloors") or self.policy["floors"])[bucket][1]
        if not seen or (seen.get("reset") or 0) <= self.now:
            return max(0, limit - reserve) / FULL_WINDOW
        return max(0, seen.get("remaining", limit) - reserve) / max(seen["reset"] - self.now, RICH_WINDOW_MIN)

    def post_over_graphql(self, item: dict) -> bool:
        """A comment goes through GraphQL's addComment while GraphQL is the richer bucket, as the reads choose (a
        lost answer is looked for, and resent, over REST)."""
        if item.get("uncertain"):
            return False
        if self.status_editable(item) and self.outbox_richness("graphql") > 0:
            return True  # only GraphQL edits in place: a writer's status goes there while it has any points
        seen = self.budget.get("graphql") or {}
        if not seen or (seen.get("reset") or 0) <= self.now:
            return False  # no live GraphQL reading: REST, as before
        return self.outbox_richness("graphql") > max(self.outbox_richness("rest"), 0.0)

    def status_editable(self, item: dict) -> dict | None:
        """The writer's earlier status comment on this thread that ITEM may replace in place (not yet checked to be
        the thread's last: post_comment_graphql reads that), else None."""
        if item.get("kind") != "comment" or not item.get("status"):
            return None
        statuses = read_json(BASE / POST_STATUSES)
        thread = f"{str(item['repo']).lower()}#{int(item['number'])}"
        prior = statuses.get(thread) if isinstance(statuses, dict) else None
        ok = (isinstance(prior, dict) and prior.get("key") == item["status"] and prior.get("by") == item.get("by")
              and isinstance(prior.get("nodeId"), str) and self.now - float(prior.get("at") or 0) < POST_STATUS_MAX
              and not self.thread_watched(str(item["repo"]), item["number"]))
        return prior if ok else None

    def thread_watched(self, repo: str, number: Any) -> bool:
        """A comment wait is watching this thread: an edit in place would be a comment it never sees as new."""
        return (watch_dir() / file_name(f"comment:{repo.lower()}#{int(number)}")).exists()

    def note_status(self, item: dict, node_id: Any, database_id: Any, url: Any) -> None:
        """Remember (or forget) the last status comment the outbox posted on this thread."""
        thread = f"{str(item['repo']).lower()}#{int(item['number'])}"
        statuses = read_json(BASE / POST_STATUSES)
        statuses = statuses if isinstance(statuses, dict) else {}
        if item.get("status") and isinstance(node_id, str) and node_id:
            statuses[thread] = {"by": item.get("by"), "key": item["status"], "nodeId": node_id, "id": database_id,
                                "url": url, "at": self.now}
        elif thread not in statuses:
            return
        else:
            statuses.pop(thread)
        statuses = {k: v for k, v in statuses.items() if isinstance(v, dict)
                    and self.now - float(v.get("at") or 0) < POST_STATUS_MAX}
        write_json(BASE / POST_STATUSES, statuses)

    def post_gql(self, query: str, variables: dict, reason: str) -> tuple[int, dict, Any]:
        """One outbox GraphQL request: content, so a secondary limit holds the outbox; logged in the spend log."""
        status, h, doc = self.request("POST", "/graphql", {"query": query, "variables": variables}, content=True)
        rate = ((doc.get("data") or {}).get("rateLimit") or {}) if isinstance(doc, dict) else {}
        cost = rate.get("cost") if isinstance(rate, dict) and isinstance(rate.get("cost"), int) else 1
        self.gql_log.append((self.clock(), reason, cost))
        self.note_spend("graphql", reason, 1, cost)
        return status, h, doc

    @staticmethod
    def gql_throttled(status: int, h: dict, doc: Any) -> bool:
        """A secondary limit, as the REST path tells one: a lasting 403 (scope, SSO, a block) fails the item
        instead of holding every write."""
        return (status == 429 or bool(h.get("retry-after"))
                or (status in {403, 422, 200} and bool(THROTTLED.search(json.dumps(doc)[:4000] if doc else ""))))

    @staticmethod
    def gql_transient(errors: list[dict]) -> bool:
        """GitHub's own failure answered as HTTP 200 (an internal error, a timeout): retried like a 5xx. A refusal
        that names the request (NOT_FOUND, FORBIDDEN, a validation error) still fails the write."""
        return bool(errors) and not any(e.get("type") in GQL_REFUSALS for e in errors) and all(
            e.get("type") in GQL_TRANSIENT_TYPES or GQL_TRANSIENT.search(str(e.get("message") or ""))
            for e in errors)

    def rest_out(self, status: int, h: dict, text: str) -> bool:
        """REST's own hourly limit (a 403 or 429 with no requests left, and no secondary limit named): nothing was
        written. REST is backed off until its reset, so the next turn sends a comment over GraphQL (post_over_graphql)
        and only writes REST alone can make wait, as gql_out does the other way. Before, it held every queued write
        until REST's reset: on 2026-11-10 receipts queued 10 to 48 deep in an hour while GraphQL had points."""
        if status not in {403, 429} or h.get("x-ratelimit-remaining") != "0" or h.get("retry-after") \
                or THROTTLED.search(text):
            return False
        try:
            until = float(h.get("x-ratelimit-reset") or 0)
        except ValueError:
            until = 0.0
        self.backoff["rest"] = max(self.backoff["rest"], until, self.now + CYCLE)
        log({"event": "post-rest-out", "until": round(self.backoff["rest"])})
        return True

    def gql_out(self, status: int, h: dict, doc: Any) -> bool:
        """GraphQL's own hourly limit (a RATE_LIMITED error, or no points left and no secondary limit named): nothing
        ran. GraphQL is backed off until its reset, so the next turn sends the write over REST (post_over_graphql)
        instead of holding every queued write."""
        # only a definite refusal: every error is RATE_LIMITED, or a 403 for the spent counter. A 200 that spent the
        # last point on an internal error may still have written: that one is retried uncertain (post_find first)
        errors = [e for e in (doc.get("errors") or []) if isinstance(e, dict)] if isinstance(doc, dict) else []
        limited = bool(errors) and all(e.get("type") == "RATE_LIMITED" for e in errors)
        spent = (h.get("x-ratelimit-remaining") == "0" and status == 403
                 and not THROTTLED.search(json.dumps(doc)[:4000] if doc else ""))
        if not (limited or spent):
            return False
        try:
            until = float(h.get("x-ratelimit-reset") or 0)
        except ValueError:
            until = 0.0
        self.backoff["graphql"] = max(self.backoff["graphql"], until, self.now + CYCLE)
        return True

    def post_comment_graphql(self, path: Path, item: dict) -> None:
        """addComment (or, for the writer's own status, updateIssueComment) with the same queue semantics as REST:
        uncertain while in flight, held on a secondary limit, retried on a 5xx, failed on a refusal."""
        repo, number = str(item["repo"]), int(item["number"])
        owner, name = repo.split("/", 1)
        thread = f"{repo.lower()}#{number}"
        subjects = read_json(BASE / POST_SUBJECTS)
        subjects = subjects if isinstance(subjects, dict) else {}
        prior = self.status_editable(item)
        editable = prior is not None
        subject, last = subjects.get(thread), None
        if subject is None or editable:
            try:
                status, h, doc = self.post_gql(SUBJECT_QUERY, {"o": owner, "r": name, "n": number}, "outbox-subject")
            except WatchError as error:
                self.post_at = self.now
                return self.post_retry(path, item, describe(error))  # a read: nothing was written
            node = (((doc.get("data") or {}).get("repository") or {}).get("issueOrPullRequest") or {}) \
                if isinstance(doc, dict) else {}
            if self.gql_out(status, h, doc):
                write_json(path, item)  # GraphQL is out (backed off): the next turn posts over REST
                return None
            if self.gql_throttled(status, h, doc):
                return self.post_hold_for(h, path, item)
            if status == 401:
                return self.post_retry(path, item, "graphql subject: HTTP 401")  # request() re-reads the token
            if status != 200 or not isinstance(node, dict) or not node.get("id"):
                if (status >= 500 or not isinstance(doc, dict) or not doc.get("errors")
                        or self.gql_transient([e for e in doc["errors"] if isinstance(e, dict)])):
                    return self.post_retry(path, item, f"graphql subject: HTTP {status}")
                message = str(((doc.get("errors") or [{}])[0] or {}).get("message") or "")[:200]
                return self.post_finish(path, item, error=f"graphql: {message or 'no such issue or pull request'}")
            subject = subjects[thread] = node["id"]
            write_json(BASE / POST_SUBJECTS, dict(list(subjects.items())[-2000:]))
            nodes = (node.get("comments") or {}).get("nodes") or []
            last = nodes[-1] if nodes and isinstance(nodes[-1], dict) else None
        if item.get("group") and self.thread_watched(repo, number):
            self.post_unjoin(path, item)  # a wait began watching during the lookup: the leader goes out alone
        edit = bool(editable and last and last.get("id") == prior.get("nodeId"))
        if edit and isinstance(prior.get("id"), int):
            # before the edit is sent: an edit that lands behind a lost answer is still one the waits see
            edits = read_json(BASE / POST_EDITS)
            edits = [x for x in edits if isinstance(x, int) and x != prior["id"]] if isinstance(edits, list) else []
            write_json(BASE / POST_EDITS, (edits + [prior["id"]])[-POST_EDITS_KEEP:])
        write_json(path, {**item, "uncertain": True})
        try:
            if edit:
                status, h, doc = self.post_gql(EDIT_COMMENT, {"c": prior["nodeId"], "b": item["body"]}, "outbox")
            else:
                status, h, doc = self.post_gql(ADD_COMMENT, {"s": subject, "b": item["body"]}, "outbox")
        except WatchError as error:
            self.post_at = self.now
            return self.post_retry(path, item, describe(error), uncertain=True)
        except OutOfTime:
            write_json(path, item)  # raised before anything was sent
            raise
        self.post_at = self.now
        item["uncertain"] = False
        doc = doc if isinstance(doc, dict) else {}
        data = doc.get("data") if isinstance(doc.get("data"), dict) else {}
        made = ((((data.get("addComment") or {}).get("commentEdge") or {}).get("node"))
                or ((data.get("updateIssueComment") or {}).get("issueComment")))
        errors = [e for e in doc.get("errors") or [] if isinstance(e, dict)]
        text = json.dumps(errors)[:2000]
        if status == 200 and isinstance(made, dict) and made.get("url"):
            self.post_backoff = POST_BACKOFF
            self.note_status(item, made.get("id"), made.get("databaseId"), made.get("url"))
            note = "edited this writer's earlier status comment, the thread's last" if edit else None

            author = made.get("author") if isinstance(made.get("author"), dict) else {}
            # the REST answer's shape, for post_delivered's risk-receipt check
            answer = {"html_url": made["url"], "author_association": made.get("authorAssociation"),
                      "user": {"type": author.get("__typename"), "login": author.get("login")}}
            return self.post_delivered(path, item, answer, note=note)
        if status == 401:
            return self.post_retry(path, item, "graphql: HTTP 401")  # refused before it ran; request() re-reads the token
        if self.gql_out(status, h, doc):
            write_json(path, item)  # not run: GraphQL is out, so the next turn sends it over REST
            return None
        if self.gql_throttled(status, h, doc):
            return self.post_hold_for(h, path, item)
        if status >= 500 or (status == 200 and (not errors or self.gql_transient(errors))):
            # it may have landed: the retry looks for it over REST first (post_find)
            return self.post_retry(path, item, f"graphql: HTTP {status}", uncertain=True)
        if edit and any(e.get("type") == "NOT_FOUND" for e in errors):
            self.note_status({**item, "status": None}, None, None, None)  # deleted: post it as a new comment
            write_json(path, item)
            return None
        said = "; ".join(str(e.get("message") or e.get("type")) for e in errors) or str(doc.get("message") or "")
        return self.post_finish(path, item, error=f"graphql: HTTP {status}: {said}"[:300])

    def post_prune(self) -> None:
        for path in posted_dir().glob("*.json") if posted_dir().is_dir() else []:
            with contextlib.suppress(OSError):
                if self.now - path.stat().st_mtime > POST_KEEP:
                    path.unlink()

    # -- one tick

    def watches(self) -> list[dict]:
        """Live watch entries; expired ones are removed here."""
        out = []
        for path in sorted(watch_dir().glob("*.json")) if watch_dir().is_dir() else []:
            doc = read_json(path)
            try:
                age = self.now - path.stat().st_mtime
            except OSError:
                continue
            if not isinstance(doc, dict) or "key" not in doc:
                path.unlink(missing_ok=True)
                continue
            key = doc["key"]
            if doc.get("dormant"):
                # an answered one-off look's record (once_answered): never polled, kept so a look again later is a
                # repeat reader's; it ends at IDLE_EXPIRY after its last interest like any watch
                if age > IDLE_EXPIRY:
                    path.unlink(missing_ok=True)
                continue
            try:
                parse_key(split_key(key)[0], key.split(":", 1)[1])
            except (WatchError, ValueError, IndexError):
                path.unlink(missing_ok=True)
                continue
            cached = read_cache(key)
            kind = split_key(key)[0]
            # a comment watch only serves a wait that is running: it touches the file every 30 s
            done = kind == "comment" or (kind != "head" and cached is not None and terminal(kind, cached.get("data")))
            if age > IDLE_EXPIRY or (done and age > TERMINAL_GRACE):
                path.unlink(missing_ok=True)
                continue
            asked = doc.get("consumers") if isinstance(doc.get("consumers"), dict) else {}
            waited = doc.get("waitedAt") if isinstance(doc.get("waitedAt"), (int, float)) else None
            began = doc.get("waitBegan") if isinstance(doc.get("waitBegan"), (int, float)) else None
            since = doc.get("since")
            since = since if isinstance(since, (int, float)) and not isinstance(since, bool) else None
            entry = {"key": key, "jobs": bool(doc.get("jobs")), "cache": cached, "touched": self.now - age,
                     "waitedAt": waited, "waitBegan": began, "readers": readers_of(doc, time.time()),
                     "reader": doc.get("reader") if isinstance(doc.get("reader"), str) else "",
                     "consumers": {str(k): float(v) for k, v in asked.items() if isinstance(v, (int, float))},
                     "since": since}
            if self.once_answered(entry) and self.make_dormant(path, doc, self.now - age):
                continue
            out.append(entry)
        return out

    def make_dormant(self, path: Path, doc: dict, touched: float) -> bool:
        """Turn an answered watch into its dormant record, under .register.lock and only if nobody registered it since
        it was read (its mtime is still TOUCHED): a registration racing the daemon is never lost (review of #1960).
        The record keeps `since` (a look again later is a repeat reader's, F3) and the last interest as its mtime."""
        with bounded_lock(watch_dir() / ".register.lock") as held:
            if not held:
                return False
            try:
                if path.stat().st_mtime != touched:
                    return False
            except OSError:
                return True  # gone already
            # A forwarded registration may keep the mtime (an older downstream `touched`) while it adds a wait or a
            # job list: the file must still be what the daemon read (review of #1961 F2).
            if read_json(path) != doc:
                return False
            dormant = {"key": doc["key"], "dormant": True}
            if isinstance(doc.get("since"), (int, float)) and not isinstance(doc.get("since"), bool):
                dormant["since"] = doc["since"]
            write_json(path, dormant)
            with contextlib.suppress(OSError):
                os.utime(path, (touched, touched))
        return True

    def once_answered(self, e: dict) -> bool:
        """Whether nothing live needs this PR or run watch any more: no wait is on it, its last interest was a one-off
        (a `status` read, a sweep over many PRs: one ask, not renewed ONCE_SPAN after the first) or the wait that
        ended, and the daemon has read it without error since that interest. Such a watch used to be polled every
        cycle for IDLE_BACKOFF_AFTER and then backed off until IDLE_EXPIRY: about seven reads for one ask, so one
        sweep's `status pr` over 140 PRs (land-list.sh, 2026-11-11 16:37Z) held ~90 extra PRs for 15 minutes. The
        cache file stays (CACHE_KEEP), so the next ask still answers at once while it registers again."""
        kind = split_key(e["key"])[0]
        if kind not in ("pr", "run") or self.waited(e) or e["consumers"]:
            return False
        touched = e["touched"]
        waited_at, since = e.get("waitedAt"), e.get("since")
        ended_wait = waited_at is not None and touched <= waited_at + ONCE_SLACK
        one_off = since is not None and touched - since < ONCE_SPAN
        if not (ended_wait or one_off):
            return False
        cached = e.get("cache") or {}
        if cached.get("error"):
            return False  # not answered yet: the last read failed
        # A read that ended in the cache, not one tried: rest_tried moves when a REST read runs out of time too (F1).
        read_at = cached.get("restAt") if cached.get("source") == "controller" else cached.get("fetchedAt")
        if not isinstance(read_at, (int, float)) or read_at < touched:
            return False
        if e["jobs"]:  # a `--jobs` look: its job list read since the ask, not one kept from before (F2)
            jobs_at = cached.get("jobsAt")
            return isinstance(jobs_at, (int, float)) and jobs_at >= touched
        return True

    def waited(self, e: dict) -> bool:
        """Whether a wait here (or downstream, through an upstream read) registered the watch lately."""
        at = e.get("waitedAt")
        return isinstance(at, (int, float)) and self.now - at < WAIT_INTEREST

    def last_read(self, e: dict) -> float:
        """When GitHub was last read for this entry, or a REST read of it last ended (a read that failed must move
        back too, or failing keys would hold the head of every tick): a controller-fed run's REST clock, else its
        last fetch. Never read nor tried (no cache) sorts first, so a new watch is filled at once."""
        c = e.get("cache") or {}
        at = c.get("restAt") if c.get("source") == "controller" else c.get("fetchedAt")
        return max(float(at) if isinstance(at, (int, float)) else float("-inf"),
                   self.rest_tried.get(e["key"], float("-inf")))

    def rest_order(self, entries: list[dict]) -> list[dict]:
        """The order a tick reads REST keys in. A finished run a wait only needs confirmed (wait_confirms) goes first:
        one read each, and then it is an ordinary key. Every key a wait is blocked on (an interactive wait, a due land)
        goes next, deferred or not: those the last tick ran out of time for first, oldest deferral first, then the
        longest unread (never read first). Then the plain watches: the deferred ones, oldest deferral first, so a newer
        one (a new watch, never read) cannot overtake a key deferred tick after tick; then the longest unread. One
        exception, a floor: the PR or run never read watched longest, past UNREAD_LEAD_AFTER, goes ahead of the
        deferred plain keys (unread_lead), one key a tick. The
        blocked rank can starve plain keys while blocked ones fill the tick; tick() keeps them a floor
        (PLAIN_FLOOR_EVERY: the first plain key goes first once a minute)."""
        carried = self.deferred_before
        # A head a consumer asked for that holds no answer yet (`glaeda-gh checks` on a new SHA) goes first of all, ahead
        # of the carried backlog: it is read once a retry cycle at most and paid by its consumer's cap, so it cannot
        # crowd the PRs out, and its asker waits on it (huge-blue 2026-11-20: unread for 10+ min behind ~1000 PRs).
        # Among the deferred, a key a wait is blocked on (an interactive wait, a due land) goes ahead of every plain
        # watch: huge-blue 2026-11-18 19:56Z, 740 deferred keys, mostly plain watches, ahead of every wait; and at
        # 21:5xZ a WAIT_PRIORITY head start was not enough, the share's few reads a minute went to older deferrals.
        # Among those heads the one asked last goes first, and one never tried ahead of one that failed: under a backlog of
        # asked heads (huge-blue 2026-11-20 17:1xZ: 20 never-read heads due, about 3 read a tick over a slow REST, GraphQL
        # out) a new merge gate's head was read 4.5 min after it was asked, first in, first out behind asks whose waiters
        # had mostly given up. Newest first serves the live waiter within a tick; the older asks are read as the burst
        # drains, and a head nobody asks for again leaves at HEAD_INTEREST. They go ahead of the confirmations too: one
        # head read answers a merge gate, a confirmation only a run wait that already has its finish.
        # Then a key a wait is blocked on goes ahead of every plain watch, deferred or not: a waited key read once (so not
        # deferred) sorted behind every deferred plain key when it came due again. huge-blue 2026-11-20 12:0xZ, 1154
        # deferred keys and ~4 PR reads a tick: every waited read cost a whole tick behind the backlog before it ranked
        # (huge_blue_waited_age, TickBudgetTest).
        # And a floor for the waits themselves: the one waited PR or run whose data is oldest, once past
        # STALE_DATA_AFTER, goes first of all, ahead of the asked heads too. huge-blue 2026-11-20, GraphQL out for the
        # hour: every tick's ~90 s went to the fleet brokers' asked heads (each new SHA, newest first) and to plain
        # keys, waited PRs sat 3,800 to 39,600 s unread, and nothing above ever reached them. One key a tick bounds a
        # waited read at (starved waited keys x one tick) whatever else is asked.
        # And a floor for a key nobody has read yet: the one PR or run with no copy at all, never tried, watched
        # longest past UNREAD_LEAD_AFTER, goes next after the waits, ahead of the carried backlog. Until its first read
        # every `read` of it answers null, where a deferred key has a copy to answer with. huge-blue 2026-11-21 20:38Z:
        # cmuxterm-hq#17119 and cmux#49236 had no cache file at all while the carried PRs filled every tick, and each
        # caller's glaeda-read fell back to 4 broker reads of 25-72 s. One key a tick, so new watches arriving every
        # tick still leave the deferred keys the rest; once tried (answered or failed) the key is ordinary.
        lead = self.starved_lead(entries)
        unread = self.unread_lead(entries)
        return sorted(entries, key=lambda e: (e is not lead, not self.head_unanswered(e), self.head_rank(e),
                                              not self.wait_confirms(e),
                                              not self.waited(e),
                                              e is not unread,
                                              e["key"] not in carried,
                                              carried.get(e["key"], 0.0),
                                              self.last_read(e)))

    def never_read(self, e: dict) -> bool:
        """A PR or run watch with no copy at all, never read nor tried over REST: its readers get null until its first
        read (unread_lead)."""
        if not e["key"].startswith(("pr:", "run:")) or e["key"] in self.rest_tried:
            return False
        c = e.get("cache") or {}
        return not c.get("data") and not isinstance(c.get("fetchedAt"), (int, float))

    def unread_lead(self, entries: list[dict]) -> dict | None:
        """The never_read PR or run among ENTRIES watched longest, when that is past UNREAD_LEAD_AFTER (rest_order's
        floor for a first read), else None."""
        since = getattr(self, "since", {}) or {}
        best, best_age = None, float(UNREAD_LEAD_AFTER)
        for e in entries:
            if self.never_read(e):
                age = self.now - since.get(e["key"], self.now)
                if age >= best_age:
                    best, best_age = e, age
        return best

    def starved_lead(self, entries: list[dict]) -> dict | None:
        """The waited, unfinished PR or run among ENTRIES with the oldest data, when that is past STALE_DATA_AFTER
        (rest_order's floor), else None. Data never stored counts from the watch's start (self.since)."""
        best, best_age = None, float(STALE_DATA_AFTER)
        since = getattr(self, "since", {}) or {}
        for e in entries:
            kind = e["key"].split(":", 1)[0]
            if kind not in ("pr", "run") or not self.waited(e):
                continue
            c = e.get("cache") or {}
            if terminal(kind, c.get("data")):
                continue
            seen = c.get("dataAt") if isinstance(c.get("dataAt"), (int, float)) else since.get(e["key"], self.now)
            # a failed try moves it back too, so a key GitHub keeps failing cannot hold the floor from the others
            seen = max(seen, (getattr(self, "rest_tried", None) or {}).get(e["key"], float("-inf")))
            age = self.now - seen
            if age > best_age:
                best, best_age = e, age
        return best

    def head_rank(self, e: dict) -> tuple[bool, float]:
        """An asked head with no answer: (tried and failed, minus its newest ask), so the newest ask of a head never tried
        sorts first (rest_order); (False, 0.0) for any other key."""
        if not self.head_unanswered(e):
            return False, 0.0
        failed = bool((e.get("cache") or {}).get("error"))
        return failed, -max((e.get("consumers") or {}).values(), default=0.0)

    def head_direct_room(self) -> bool:
        """Whether one more asked head with no answer may be read over REST past the daemon's share: the login's REST is
        neither stopped nor under its floor, no secondary hold, and fewer than HEAD_DIRECT_MAX such reads this hour."""
        self.head_direct_at = [t for t in self.head_direct_at if self.now - t < CONSUMER_WINDOW]
        return (self.mode("rest") != "stop" and self.rest_above_floor() and self.clock() >= self.secondary_until
                and len(self.head_direct_at) < HEAD_DIRECT_MAX)

    def due_heads_direct(self, mine: list[dict]) -> list[dict]:
        """The asked heads with no answer read over REST this tick though the daemon's REST share is spent and GraphQL
        is stopped: a merge gate waits on each, and one head is a few requests. Charged to their consumers' caps
        (due_heads), and to HEAD_DIRECT_MAX."""
        asked = sorted((e for e in mine if self.head_unanswered(e)), key=self.head_rank)
        if not asked or not self.head_direct_room():
            return []
        due = self.due_heads(asked, "normal", rest=True)
        out = due[:HEAD_DIRECT_MAX - len(self.head_direct_at)]
        for e in due[len(out):]:
            self.refund(e["key"])  # past the hourly bound: not read, so not charged
            self.attempted.pop(e["key"], None)
        self.head_direct_at += [self.now] * len(out)
        return out

    def head_unanswered(self, e: dict) -> bool:
        """A head watch a consumer asked for within HEAD_INTEREST that holds no answer (never read, or only errors):
        what an on-demand `glaeda-gh checks` is waiting on."""
        if not e["key"].startswith("head:") or (e.get("cache") or {}).get("data"):
            return False
        return any(self.now - t < HEAD_INTEREST for t in (e.get("consumers") or {}).values())

    def fed(self, key: str) -> bool:
        """Whether the controller's webhooks cover this key's repository now: its feed answered within
        CONTROLLER_FRESH and delivered an event for the repository within FED_REPO_KEEP."""
        if self.now - self.controller_ok_at > CONTROLLER_FRESH:
            return False
        _, owner, repo, _ = split_key(key)
        return self.now - self.fed_repos.get(f"{owner}/{repo}".lower(), float("-inf")) <= FED_REPO_KEEP

    def idle_interval(self, e: dict, interval: float) -> float:
        """How often an open PR is polled: every cycle while a wait is on it or someone read it lately; an
        unwaited one nobody has read for a while as often as it was last read (its readers touch the watch, and
        broker answers from the cache touch it too), up to IDLE_BACKOFF_MAX. IDLE_EXPIRY drops it after that."""
        idle = self.now - e["touched"]
        if self.waited(e) or idle < IDLE_BACKOFF_AFTER:
            return interval
        return min(max(IDLE_BACKOFF_MAX, interval), max(interval, idle))

    def due(self, kind: str, entries: list[dict]) -> list[dict]:
        mine = [e for e in entries if e["key"].startswith(kind + ":")]
        path = self.route(kind)
        mode = self.mode(path)
        app_mine = self.app_entries_eligible(kind, mine, path)
        if app_mine:
            mine = app_mine
            mode = "normal"
        elif mode == "stop":
            # The whole set is eligible for nothing only because it mixes owners: read the owners an App can answer
            # rather than nothing. The others have one pool (the login) and wait for its reset, as they must.
            app_mine = self.app_eligible_by_owner(kind, mine, path)
            if app_mine:
                mine, mode = app_mine, "normal"
        if (mode == "stop" or (path == "rest" and kind in BALANCED + FALLBACK and self.rest_capped())) and not app_mine:
            # Spent, or the daemon's REST share is and GraphQL is stopped too: a kind with nowhere to
            # go waits rather than spend the REST the sessions are left with. Except a failed attempt
            # whose job list is not read yet, the one read the share does not hold back, whichever
            # bucket runs are routed to: tick() reads just that list, from the run already cached.
            # Once per attempt, answered or not: an error or an empty list leaves the attempt without
            # jobs, and asking again every cycle would make the exemption a loop past the share. A later
            # read that the share admits (the run's own) still fills it in.
            if kind == "run" and self.mode("rest") != "stop":
                self.jobs_only = [e for e in mine if self.failed_without_jobs(e)
                                  and (e["cache"] or {}).get("jobsTried") != (((e["cache"] or {}).get("data") or {}).get("run_attempt") or 1)]
                for e in self.jobs_only:
                    self.attempted[e["key"]] = self.now
            if kind == "head":
                self.heads_direct = self.due_heads_direct(mine)
            return []
        if kind == "head":
            # REST lean only because the daemon is past its own share (the yield): consumers are admitted as when
            # normal, and every head, a reserved consumer's too, is read at most once per lean cycle (review F1, F2)
            yielding = path == "rest" and mode == "lean" and self.rest_above_floor()
            return self.due_heads(mine, "normal" if yielding else mode, paced=yielding, rest=path == "rest")
        interval = self.policy["cycles"][kind] * (LEAN_FACTOR if mode == "lean" else 1)
        # GraphQL scarce (lean): what a session waits on keeps its cycle and goes first, oldest data first; the
        # unwaited rest takes the lean pace (huge-blue 2026-11-11: at the fleet's 1000 floor a waited PR was 2509 s old)
        scarce = mode == "lean" and path == "graphql"  # (REST lean is the daemon's share: no faster reads there)
        full = self.now - self.last_cycle[kind] >= interval
        if full:
            self.last_cycle[kind] = self.now
        out = [e for e in mine if e["key"] in self.deferred]  # the last tick ran out of time for these
        # Oldest deferral first: a refresh paced over minutes (graphqlPerMinute) defers again whatever came due
        # meanwhile, and in watch order those re-due keys went ahead of keys deferred ticks earlier, unread since.
        since = getattr(self, "deferred_since", {})
        out.sort(key=lambda e: since.get(e["key"], self.now))
        first = {e["key"] for e in out}
        self.deferred -= first
        for e in mine:
            c = e["cache"]
            if e["key"] in first:
                continue
            if kind == "run" and c is not None and self.run_needs_confirm(e) \
                    and (self.now - self.attempted.get(e["key"], float("-inf")) >= self.policy["cycles"][kind]
                         or self.first_confirm(e)):
                out.append(e)  # a wait (or a rerun) since GitHub last showed this finish: read it once now
                continue
            if (kind == "pr" and c is not None and e["key"] in self.nudged
                    and self.now - self.attempted.get(e["key"], float("-inf")) >= NUDGE_MIN):
                self.nudged.discard(e["key"])  # a check event on its head: re-read now, not at the cycle
                # (an idle one keeps its slower cycle, except a PR in the land queue: its nudge is a wait. huge-blue,
                # 2026-11-21 20:15Z: pinned lands sat 1.5-2 h in pin_wait while the idle backoff dropped each nudge)
                if (self.idle_interval(e, interval) <= interval
                        or (self.land_queue is not None and e["key"] in self.land_queue.entries)):
                    out.append(e)
                    continue
            if kind == "run" and c is not None and e["key"] in self.controller_filled and c.get("source") == "controller":
                # (a run REST has shown newer than the controller's record keeps its normal cycle below: the
                # controller missed that attempt's deliveries, so it is not the source for it)
                data = c.get("data") or {}
                # A failed attempt whose job list is not this attempt's: REST reads it once (per cycle
                # at most), for the failed steps and to tell a runner's refusal from a real failure.
                failed = (data.get("status") == "completed" and data.get("conclusion") not in RUN_OK
                          and jobs_attempt(c.get("jobs")) < (data.get("run_attempt") or 1)
                          and self.now - self.attempted.get(e["key"], float("-inf")) >= self.policy["cycles"][kind])
                # A finished run with a reader newer than both its data and the last REST read: that
                # reader's wait will not rule on older data, so REST confirms it once (it may have
                # been rerun before the webhook said so).
                # And a finish the controller reported that REST has not read since: a rerun's deliveries can be
                # lost (manaflow-ai/cmux run 40434431701, 2026-10-27: the controller kept attempt 1 "cancelled"
                # while GitHub had attempt 2 queued), and wait_step rules on it only once REST confirms it.
                confirm = terminal(kind, data) and (e["touched"] > max(c.get("dataAt") or 0, c.get("restAt") or 0)
                                                    or controller_unconfirmed(c, self.now))
                # Otherwise the controller answered on this tick: REST only as the safety net. A failed read leaves
                # each of these true (restAt keeps its time), so a key is read at most once a cycle.
                paced = self.now - self.attempted.get(e["key"], float("-inf")) >= self.policy["cycles"][kind]
                # Still queued or in progress by the controller's word, a wait blocked on it, and nothing new
                # from either source for STALE_RUN_REREAD: its finish may be a lost delivery, and REST_SAFETY is
                # too long for a waiter to sit on it. One read (an unchanged run answers 304, which is free).
                stale = (not terminal(kind, data) and self.waited(e)
                         and self.now - max(c.get("dataAt") or 0, c.get("restAt") or 0) >= STALE_RUN_REREAD)
                if failed or (paced and (confirm or stale or self.now - (c.get("restAt") or 0) >= REST_SAFETY)):
                    out.append(e)
                continue
            if c is None:
                # a new entry is filled at once, but at most once per cycle when the fetch never gets as
                # far as storing an answer (a failed fetch stores its error, and then waits for full cycles)
                if self.now - self.attempted.get(e["key"], float("-inf")) >= self.policy["cycles"][kind]:
                    out.append(e)
            elif (full or (scarce and self.waited(e) and self.now - c.get("fetchedAt", 0) >= self.policy["cycles"][kind]
                           and not terminal(kind, c.get("data")))) \
                    and (not terminal(kind, c.get("data")) or self.now - c.get("fetchedAt", 0) >= TERMINAL_REFRESH
                           # a reader came after the last fetch: a rerun or reopen may have changed it
                           or e["touched"] > c.get("fetchedAt", 0)):
                since = self.now - c.get("fetchedAt", 0)
                if kind == "run" and c.get("missing") and not c.get("data") and since < RUN_MISSING_RETRY \
                        and not (self.waited(e) and self.wait_start(e) > c.get("fetchedAt", 0)):  # a new wait is read once
                    continue  # not found: settled, asked again only now and then (it was read every cycle)
                if kind == "comment" and self.fed(e["key"]) and since < COMMENT_FED_CYCLE - TICK:
                    continue  # the controller's issue_comment webhooks carry its new comments (merge_comments)
                want = self.idle_interval(e, interval) if kind == "pr" and not terminal(kind, c.get("data")) else interval
                if (kind == "pr" and path == "rest" and self.waited(e) and not terminal(kind, c.get("data"))
                        and self.now - self.wait_start(e) >= LONG_WAIT_AFTER):
                    want = max(want, interval * LONG_WAIT_FACTOR)  # a long wait over REST (a nudge still reads it)
                if want > interval and since < want - interval / 2:
                    continue  # unread and unwaited: polled about as often as it was last read
                out.append(e)
        # A key a wait is blocked on that GitHub has never been asked about goes ahead of the deferred ones: until its
        # first read a wait on a PR or run that does not exist cannot say so, and on a daemon at its GraphQL pace
        # (76 deferred, 2026-11-08) `wait pr o/r#999999 --timeout 120` timed out with "no data yet" instead.
        # Bounded: its first read stores an answer (or an error), and then it is an ordinary key.
        # So does a finished run a wait is blocked on that GitHub has not shown since (run_needs_confirm): wait_step will
        # not rule on it until that read, and behind 88 deferred keys on a lean daemon (2026-11-09, a 60 s confirmation
        # wait on a CI run) it timed out every time while the cache held its failure.
        # Bounded too: the read stores restRunAt, and then the run no longer needs confirming for that wait.
        # Waited keys (a wait or, since #2191, a due land is blocked on them) first, oldest data first, whatever holds
        # the reads: the per-minute pace, the REST share, the batch or the tick's budget each reads them before the
        # rest, which keep their order (oldest deferral first) and get what is left. Before, only while scarce or with
        # a deferred backlog (2026-11-11: a waited PR 2509 s old 14 min after GraphQL came back); huge-blue 2026-11-18
        # 21:5xZ, 3403 s at a 40 points/min pace, the rest went first. Stable: never-read waited keys stay first.
        out.sort(key=lambda e: (not (self.wait_confirms(e) or (e["cache"] is None and self.waited(e))),
                                not self.waited(e), ((e["cache"] or {}).get("dataAt") or 0) if self.waited(e) else 0))
        if kind == "run":
            self.confirming = {e["key"]: (rest_run((e["cache"] or {}).get("data")), (e["cache"] or {}).get("fetchedAt"))
                               for e in out if self.wait_confirms(e)}
        if kind == "pr":
            out = self.snapshot_first(mine, out)
        for e in out:
            self.attempted[e["key"]] = self.now
        return out

    def snapshot_first(self, mine: list[dict], out: list[dict]) -> list[dict]:
        """OUT with the PRs a land judgment waits on for its rollup snapshot (snapshot_waits) first, due or not, ahead
        of the deferred backlog: the judgment runs land_judge live, on its own reads, if the snapshot is not there
        within LAND_SNAPSHOT_WAIT. One read per waiting head at most every NUDGE_MIN; the rest keep their order."""
        waiting = self.snapshot_waits()
        if not waiting:
            return out
        front = [e for e in mine if e["key"] in waiting and e.get("cache") is not None
                 and not terminal("pr", (e["cache"] or {}).get("data"))
                 and self.now - self.attempted.get(e["key"], float("-inf")) >= NUDGE_MIN]
        keys = {e["key"] for e in front}
        return front + [e for e in out if e["key"] not in keys]

    def snapshot_waits(self) -> frozenset[str]:
        """The PRs whose land judgment waits for the daemon's read of its head's rollup (LandQueue.snapshot_wait)."""
        q = self.land_queue
        if q is None:
            return frozenset()
        with q.lock:
            return frozenset(k for k, e in q.entries.items()
                             if e.get("state") not in LAND_DONE and isinstance(e.get("snapshotWait"), dict))

    def wait_confirms(self, e: dict) -> bool:
        """A finished run a wait is blocked on that GitHub has not shown since the wait (run_needs_confirm): the cache
        holds the answer, and wait_step rules on it after one read. That read goes ahead of every other, deferred keys
        included; then the run is an ordinary key again. Once per finish and wait (confirm_tried, waitBegan): a wait's
        touches move waitedAt, so a wait held on (rescue grace), or a run GitHub keeps refusing, would otherwise take
        the head of every cycle ahead of healthy deferred work (review of glaeda#1924). Later reads age and defer."""
        if not (e["key"].startswith("run:") and self.waited(e) and self.run_needs_confirm(e)):
            return False
        tried = self.confirm_tried.get(e["key"])
        if tried is None or tried[1] != rest_run((e.get("cache") or {}).get("data")):
            return True  # (a new finish, a rerun's say, gets its own first read)
        began = e.get("waitBegan")
        return isinstance(began, (int, float)) and began > tried[0]  # a new wait since

    def first_confirm(self, e: dict) -> bool:
        """A wait that began after this run's last read (waitBegan, which touches leave) and needs its finish
        confirmed: read now, not when the cycle's pace allows. A run read just before the wait began otherwise sat a
        whole cycle, as long as a short confirmation wait. Once per wait: the read is an attempt after its start."""
        began = e.get("waitBegan")
        return (isinstance(began, (int, float)) and began > self.attempted.get(e["key"], float("-inf"))
                and self.wait_confirms(e))

    def run_needs_confirm(self, e: dict) -> bool:
        """A finished run a wait blocks on, or a rerun was brokered for, after GitHub last showed it (restRunAt): its
        newest attempt may be queued again (RUN_CONFIRM_MAX). Read once per wait; a failed read is paced by due()."""
        c = e.get("cache") or {}
        if not terminal("run", c.get("data")):
            return False
        rest_at = c.get("restRunAt") if isinstance(c.get("restRunAt"), (int, float)) else float("-inf")
        if c.get("restRun") != rest_run(c.get("data")):
            rest_at = float("-inf")  # GitHub never showed this finish (the controller's, or an upstream's)
        waited = e.get("waitedAt") if self.waited(e) else None
        return max(waited or float("-inf"), run_confirmed_since(c) or float("-inf")) > rest_at

    def head_allowed(self, name: str, mode: str, policy: dict) -> bool:
        """Whether this consumer may be charged one more head read now. A reserved consumer has its own
        hourly reservation and is served even when the quota is lean; anyone else draws on the shared
        pool (and a per-consumer cap) and waits for the cache when the quota is lean."""
        spent = len(self.head_spend.get(name, []))
        if name in policy["reserved"]:
            return spent < policy["reserved"][name]
        if mode != "normal":
            return False
        pool = sum(len(v) for k, v in self.head_spend.items() if k not in policy["reserved"])
        return spent < policy["limit"] and pool < policy["pool"]

    def refund(self, key: str) -> None:
        """A head read that deferred or failed costs its consumer nothing."""
        paid = self.payer.pop(key, None)
        if paid and paid[1] in self.head_spend.get(paid[0], []):
            self.head_spend[paid[0]].remove(paid[1])
            self.refunded[key] = paid[0]

    def head_answered(self, key: str) -> None:
        """A head read answered: its charge stands, and one a failed read on the other bucket refunded this tick
        is charged again, so a fallback never reads a head for free past its consumer's cap."""
        if self.payer.pop(key, None) is None and key in self.refunded:
            self.head_spend.setdefault(self.refunded[key], []).append(self.now)
        self.refunded.pop(key, None)

    def due_heads(self, mine: list[dict], mode: str, paced: bool = False, rest: bool = False) -> list[dict]:
        """Heads somebody asked for recently whose answer is missing or older than its TTL. One read serves
        every consumer of the head; it is charged to the first consumer (reserved ones first) that may pay.
        A head nobody may pay for is left to the cache, and the refused consumers are marked denied. REST: the heads
        are read over REST, which leaves out a head too big for it (rest_oversized) until HEAD_OVERSIZED_RETRY."""
        policy = consumer_policy()
        self.head_spend = {k: [t for t in v if self.now - t < CONSUMER_WINDOW] for k, v in self.head_spend.items()}
        for key, (_, at) in list(self.payer.items()):
            if self.now - at > 2 * self.policy["cycle"]:  # a read that raised never reported back
                self.refund(key)
        out = []
        due, soon = [], []
        for e in mine:
            c = e["cache"] or {}
            if not any(self.now - t < HEAD_INTEREST for t in e["consumers"].values()):
                continue
            if not c.get("data"):
                due.append(e)
                continue
            ttl, age = self.head_ttl(e), self.now - (c.get("dataAt") or 0)
            if age >= ttl or (e["key"] in self.nudged and age >= NUDGE_MIN):
                due.append(e)
            elif age >= ttl - HEAD_ALIGN:
                soon.append(e)  # due shortly: it rides along with a head due now, one query instead of two
        due_keys = {e["key"] for e in due}
        for e in due + (soon if due else []):
            asked = {n: t for n, t in e["consumers"].items() if self.now - t < HEAD_INTEREST}
            c = e["cache"] or {}
            retry = HEAD_MISSING_RETRY if c.get("missing") else self.policy["cycles"]["head"]
            if paced:
                retry = max(retry, self.policy["cycles"]["head"] * LEAN_FACTOR)
            if rest and self.rest_oversized(e):
                self.deferred.discard(e["key"])
                continue  # REST cannot answer it (HEAD_OVERSIZED_RETRY): no read, no charge, no tick spent on it
            if e["key"] in self.deferred:
                self.deferred.discard(e["key"])  # the last tick ran out of time for it: no cycle to wait
            elif self.now - self.attempted.get(e["key"], float("-inf")) < retry:
                continue  # a read that failed, found nothing or is still running waits a cycle
            payer = next((n for n in sorted(asked, key=lambda n: (n not in policy["reserved"], n))
                          if self.head_allowed(n, mode, policy)), None)
            if payer is None:
                if e["key"] in due_keys:  # (a head only riding along was not refused anything: its TTL has not run out)
                    for n in asked:
                        self.denied[n] = self.now
                continue
            self.head_spend.setdefault(payer, []).append(self.now)
            self.payer[e["key"]] = (payer, self.now)
            self.attempted[e["key"]] = self.now
            self.nudged.discard(e["key"])  # (kept until it is read: a check event inside the retry gate still counts)
            out.append(e)
        return out

    def rest_oversized(self, e: dict) -> bool:
        """Whether this head's last REST read, within HEAD_OVERSIZED_RETRY, found more than one REST read pages through
        (fetch_head_rest): asking REST again before then would page the same requests and fail the same way."""
        at = (e.get("cache") or {}).get("restOversizedAt")
        return isinstance(at, (int, float)) and not isinstance(at, bool) and self.now - at < HEAD_OVERSIZED_RETRY

    def head_ttl(self, e: dict) -> float:
        """How long a head's answer stands: a settled one HEAD_SETTLED_TTL; a running one HEAD_PENDING_TTL, or
        HEAD_PENDING_FED_TTL where the controller's webhooks cover its repository and re-read it on its own check
        events (nudge)."""
        data = (e["cache"] or {}).get("data") or {}
        if data.get("settled"):
            return HEAD_SETTLED_TTL
        return HEAD_PENDING_FED_TTL if self.fed(e["key"]) else HEAD_PENDING_TTL

    def write_consumers(self) -> None:
        policy = consumer_policy()
        names = sorted(set(self.head_spend) | set(self.denied) | set(policy["reserved"]))
        doc = {"policy": policy, "consumers": {
            n: {"reserved": n in policy["reserved"], "spent": len(self.head_spend.get(n, [])),
                "limit": policy["reserved"].get(n, policy["limit"]), "deniedAt": self.denied.get(n)}
            for n in names}, "spends": {n: [round(t) for t in v] for n, v in self.head_spend.items() if v}}
        text = json.dumps(doc, sort_keys=True)
        # rewritten when a spend or denial changes (the ticks' own `at` would make every tick a write)
        if text != self.saved_consumers:
            write_json(BASE / CONSUMERS_FILE, {**doc, "at": self.now})
            self.saved_consumers = text

    def defer(self, entries: list[dict], why: str = "") -> None:
        """Read ENTRIES first next tick. WHY (the budget, pace or limit that held them) is kept per kind for
        deferral(): old waited data behind a deferral is the budget's, not a stuck reader's."""
        self.deferred.update(e["key"] for e in entries)
        for e in entries:
            self.refund(e["key"])
        if why:
            for kind in {split_key(e["key"])[0] for e in entries if ":" in e["key"]}:
                self.defer_why[kind] = (self.now, why)

    def tick(self, now: float | None = None) -> dict:
        self.now = time.time() if now is None else now
        self.clock_real = now is None
        self.tick_deadline = time.monotonic() + TICK_BUDGET
        self.feed_after_controller, self.tick_thread = False, threading.get_ident()
        with contextlib.suppress(Exception):  # never stops a tick
            self.free_slots()
        if self.started_tick is None:
            self.started_tick = self.now
        self.errors = []
        self.refunded = {}
        self.spill = []
        self.policy = daemon_policy()
        self.jobs_only = []
        self.heads_direct = []
        self.settle_rest()  # a counter whose window ended leaves the reading to the others
        self.settle_counters("graphql")
        if self.failing is None:
            # and again in serve_waits: a long read phase must not look like a dead daemon; ticks that
            # keep raising stop marking, so their blockers hand the wait back (resume_wait says why)
            mark_waits_served()
        up = self.upstream()
        if up is not None:
            return self.upstream_tick(up)
        try:
            with self.phase("outbox"):
                self.post_tick()  # first, so a long read phase never delays a write
        except Exception as error:  # noqa: BLE001  a bad queue entry must not stop the reads
            self.errors.append(f"outbox: {describe(error)} at {error_site(error)}")
        with self.phase("watches"):
            entries = self.watches()
        self.adopt_pace_hold()
        try:
            with self.phase("controller"):
                self.from_controller(entries)
        except Exception as error:  # noqa: BLE001  the controller is an optional, free source: a fault
            # there must not stop GitHub polling (it did: glaeda#1305). A WatchError is expected and
            # says what failed; anything else is a bug, so it carries its code site.
            self.controller_down(error, None if isinstance(error, WatchError) else error_site(error))
        self.feed_after_controller = True  # from here a long tick reads the feed between its reads (feed_due)
        # due() consumes the deferred set; the REST order below still needs it, oldest deferral first
        self.deferred_since = {k: self.deferred_since.get(k, self.now) for k in self.deferred}
        self.deferred_before = dict(self.deferred_since)
        with self.phase("due"):
            prs, runs, comments = self.due("pr", entries), self.due("run", entries), self.due("comment", entries)
            heads = self.due("head", entries)
        due = {"pr": prs, "run": runs, "comment": comments, "head": heads}
        over = {kind: self.paths[kind] for kind in due}  # due() routed each kind
        spilled: list[dict] = []
        # The per-minute ceiling (graphqlPerMinute) can hold a tick partway. The kind after the one it held goes first
        # next tick, so PR refreshes cannot take every minute's points while a run, comment or head waits behind them.
        kinds = ("pr", "comment", "run", "head")
        first = getattr(self, "gql_first", 0) % len(kinds)
        # What waits and due lands are blocked on, of every kind, goes ahead of the round robin's turns: a minute's
        # points read it first, and only what is left reads the rest (huge-blue 2026-11-18 21:5xZ: waited pr data
        # 3403 s old at 40 points/min while unblocked watches took the points).
        # The watches nothing is blocked on keep a floor first (PLAIN_FLOOR_EVERY): one batch of them per kind.
        # An asked head with no answer (`checks` on a new SHA, a merge gate waiting on it) counts as blocked too, and the
        # blocked heads go first: huge-blue 2026-11-20 15:45Z, a fresh merge-hold head sat unread behind 828 due PRs once
        # pr moved to GraphQL (heads are never "waited", so they only had their round robin turn after the plain PRs).
        urgent = lambda e: self.waited(e) or self.head_unanswered(e)  # noqa: E731
        blocked = {kind: [e for e in due[kind] if urgent(e)] for kind in kinds}
        blocked["head"].sort(key=self.head_rank)  # the newest ask of a head never tried first (rest_order)
        floor: set[str] = set()
        for kind in sorted(kinds[first:] + kinds[:first], key=lambda k: k != "head"):
            if over[kind] != "graphql":
                continue
            plain = [e for e in due[kind] if not urgent(e)]
            # (a minute with none read since it was first due: a fresh daemon's first tick is no starvation)
            if plain and blocked[kind] and self.now - self.plain_at.setdefault(kind, self.now) >= PLAIN_FLOOR_EVERY:
                chunk = plain[:max(1, self.batch[kind])]
                floor |= {e["key"] for e in chunk}
                before = len(self.gql_log)
                with self.phase(f"read {kind}"):
                    spilled += self.batched(kind, chunk, self.graphql_fetch[kind])
                if len(self.gql_log) > before:
                    self.plain_at[kind] = self.now
            if blocked[kind]:
                with self.phase(f"read {kind}"):
                    spilled += self.batched(kind, blocked[kind], self.graphql_fetch[kind])
                self.post_between()
        self.gql_paced = None
        sent = len(self.gql_log)
        paced_sent = False  # whether the kind the ceiling held had sent a query of its own first, this tick
        for kind in kinds[first:] + kinds[:first]:
            if over[kind] == "graphql":
                before = len(self.gql_log)
                with self.phase(f"read {kind}"):
                    spilled += self.batched(kind, [e for e in due[kind] if not urgent(e) and e["key"] not in floor],
                                            self.graphql_fetch[kind])
                if len(self.gql_log) > before:
                    self.plain_at[kind] = self.now
                if self.gql_paced == kind:
                    paced_sent = len(self.gql_log) > before
                self.post_between()
        # Only a tick that sent a query moves the order: one that met the ceiling before reading anything (most ticks
        # in a full minute, TICK is 2 s) leaves it, or the count of empty ticks would decide who reads next. The kind
        # the ceiling held goes first next time when it read nothing itself (it was starved), the one after it when it
        # had its turn: a round robin over the kinds with something due.
        if self.gql_paced is not None and len(self.gql_log) > sent:
            self.gql_first = (kinds.index(self.gql_paced) + (1 if paced_sent else 0)) % len(kinds)
        for kind, picked in self.app_graphql_share(due, over).items():
            keys = {e["key"] for e in picked}
            due[kind] = [e for e in due[kind] if e["key"] not in keys]
            with self.phase(f"read {kind}"):
                spilled += self.batched(kind, picked, self.graphql_fetch[kind])
            self.post_between()
        over_rest = [e for kind in ("pr", "run", "comment", "head") if over[kind] == "rest" for e in due[kind]]
        # GraphQL ran out of primary quota partway: REST reads what it could not, this tick. A secondary
        # hold stops REST too, so the REST loop below defers them instead.
        over_rest += spilled
        # With PRs always ahead of runs, a busy daemon read PRs tick after tick while a blocked `wait run` sat on a
        # run nobody reached (2026-10-27: 581 s and counting, with STALE_RUN_REREAD due at 180 s).
        over_rest = self.rest_order(over_rest)
        plain = next((e for e in over_rest if not self.waited(e) and not self.wait_confirms(e)), None)
        if plain is not None and any(self.waited(e) for e in over_rest) \
                and self.now - self.plain_at.setdefault("rest", self.now) >= PLAIN_FLOOR_EVERY:
            # the floor (PLAIN_FLOOR_EVERY): the first watch nothing is blocked on goes next after the confirmations
            confirms = [e for e in over_rest if self.wait_confirms(e)]
            over_rest = confirms + [plain] + [e for e in over_rest if e is not plain and not self.wait_confirms(e)]
        plain_until = time.monotonic() + REST_PLAIN_BUDGET
        head_until = time.monotonic() + REST_HEAD_BUDGET
        try:
            for i, e in enumerate(over_rest):
                if e["key"].startswith("head:") and time.monotonic() >= head_until and not self.head_unanswered(e) \
                        and any(x["key"].startswith(("pr:", "run:")) and self.waited(x) for x in over_rest[i + 1:]):
                    self.defer([e])  # the heads' share is spent and a waited PR or run is still unread: it reads now
                    continue
                if time.monotonic() >= plain_until and not (self.waited(e) or self.wait_confirms(e)
                                                            or self.head_unanswered(e)):
                    self.defer([e])  # the plain watches' share of this tick is spent: first next tick, in order
                    continue
                # A read is admitted only when its worst case fits in the share, so the share holds at a
                # request, not at a batch; the rest go first next tick, over whichever bucket is richer.
                kind = e["key"].split(":", 1)[0]
                app_ok = bool(self.app_entries_eligible(kind, [e], "rest"))
                if (self.mode("rest") == "stop" or not self.rest_room(REST_READ_MAX[kind])) and not app_ok:
                    if kind == "head" and self.head_unanswered(e) and self.head_direct_room():
                        self.head_direct_at.append(self.now)  # past the share, within HEAD_DIRECT_MAX (due_heads_direct)
                    else:
                        self.to_graphql(over_rest[i:], spilled)
                        break
                sent = len(self.sent)
                self.resume_key, self.resume_from = "", float("inf")
                cut = self.cut_reads.pop(e["key"], None)
                data_at = (read_cache(e["key"]) or {}).get("dataAt") if cut is not None else None
                if cut is not None and self.now - cut <= RESUME_MAX and not (isinstance(data_at, (int, float))
                                                                             and data_at >= cut):
                    self.resume_key, self.resume_from = e["key"], cut
                self.prefetch_rest(over_rest[i:i + REST_PREFETCH_AHEAD])
                began = time.monotonic()
                try:
                    with self.calling(*caller_of(e["key"]), waiter_of(e)), self.phase("read rest"):
                        self.rest_fetch[e["key"].split(":", 1)[0]](e)
                    self.note_read_seconds(kind, "rest", time.monotonic() - began, 1)
                except OutOfTime:
                    # No reason: a tick spent waiting for GraphQL slots ends here too, and a stall the valve must act on
                    # would read as a budget's deferral (review of glaeda#2189, F1)
                    self.defer(over_rest[i:])
                    if len(self.sent) > sent:  # cut off partway: it had its turn, and queues as a new deferral
                        self.rest_tried[e["key"]] = self.now
                        self.deferred_since.pop(e["key"], None)
                        # its next try resumes from what this one got (RESUME_MAX), dated from the first cut attempt
                        self.cut_reads[e["key"]] = min(self.resume_from, self.now) if self.resume_key == e["key"] else self.now
                    elif cut is not None:
                        self.cut_reads[e["key"]] = cut  # not sent this time: still resumable
                    break  # (cut off before its first request, it was not read: it keeps its place, first next tick)
                except Exception as error:  # noqa: BLE001
                    # an error of ours says what failed; anything else names where it was raised, or a TypeError that
                    # recurs on every REST tick reads as bare "TypeError" with nothing to find it by (2026-11-22)
                    why = describe_at(error)
                    self.errors.append(f"{e['key']}: {why}")
                    self.refresh_note("rest", why, key_name(e["key"]), "retry next cycle")
                else:
                    stored = read_cache(e["key"]) or {}
                    if stored.get("error") and stored.get("fetchedAt") == self.now:
                        self.refresh_note("rest", stored["error"], key_name(e["key"]),
                                          f"REST asks again in {HEAD_OVERSIZED_RETRY}s, GraphQL whenever heads route there"
                                          if stored.get("restOversizedAt") == self.now else "retry next cycle")
                if self.mode("rest") == "stop" and (read_cache(e["key"]) or {}).get("error"):
                    # this read is the one that ran REST out: GraphQL reads it, and the rest, this tick
                    self.to_graphql(over_rest[i:], spilled)
                    break
                self.rest_tried[e["key"]] = self.now  # read, or failed: either way it moves back
                if not self.waited(e):
                    self.plain_at["rest"] = self.now
                # and a read that deferred itself for the rest of its work (fill_steps_rest) queues as a new deferral
                self.deferred_since.pop(e["key"], None)
        finally:
            self.resume_key, self.resume_from = "", float("inf")
            self.settle_prefetch()
        for e in self.jobs_only:
            try:
                with self.calling(*caller_of(e["key"]), waiter_of(e)):
                    self.read_jobs(e, {}, False)  # read_jobs reads the list a failed attempt is missing
            except Exception as error:  # noqa: BLE001
                self.errors.append(f"{e['key']} jobs: {describe(error)}")
        for i, e in enumerate(self.heads_direct):
            try:
                with self.calling(*caller_of(e["key"]), waiter_of(e)), self.phase("read rest"):
                    self.fetch_head_rest(e)
            except OutOfTime:
                self.defer(self.heads_direct[i:])
                break
            except Exception as error:  # noqa: BLE001
                self.refund(e["key"])
                self.errors.append(f"{e['key']}: {describe(error)}")
        try:
            with self.phase("read waited"):
                self.read_waited(entries, {e["key"] for e in prs + runs})
        except Exception as error:  # noqa: BLE001  a fault there must not stop the tick
            self.errors.append(f"waited: {describe(error)} at {error_site(error)}")
        # After the reads, so a busy daemon never pays for it: its own responses' x-ratelimit
        # headers have already brought the view up to date, and only an idle one goes stale.
        self.refresh_budget()
        return self.finish_tick(entries, prs, runs, comments, heads)

    def read_waited(self, entries: list[dict], read: set[str]) -> None:
        """The PRs and runs a wait is blocked on (here, or a lane VM's through the broker: its upstream read carries
        "wait"), read over GraphQL once their data is WAITED_FRESH old while the GraphQL reserve alone stops the
        daemon's polling (huge-blue 2026-11-16: under it 5.5 of 14 hours, waited PR data 1000-6000 s old). Oldest data
        first; unchanged PRs by the probe, WAITED_PROBE_BATCH a point; at most WAITED_PER_MINUTE points a minute, so
        more waiters make each read less often, never refused; never below WAITED_RESERVE_SHARE of the reserve, nor
        through GitHub's own back-off or a secondary hold. READ: the keys this tick already read."""
        self.waited_log = [(t, p) for t, p in self.waited_log if self.now - t < 60]
        self.waited_tried = {k: t for k, t in self.waited_tried.items() if self.now - t < WAITED_FRESH}
        if (self.mode("graphql") != "stop" or self.backoff["graphql"] > self.now or self.secondary_until > self.now
                or self.waited_points() >= WAITED_PER_MINUTE):
            return
        self.waived = True
        try:
            if self.mode("graphql") == "stop":
                return  # under the part of the reserve kept for lands
            # (a key never read has no dataAt: first in line, and a lane VM's wait on a new PR is filled at once)
            data_at = lambda e: float((e["cache"] or {}).get("dataAt") or 0)  # noqa: E731
            # Not a kind REST reads on its full cycle (route() sent it there and REST is normal): that is fresh already.
            # A key tried within WAITED_FRESH waits (a read that keeps failing never takes every pass).
            served = {k for k in ("pr", "run") if self.paths.get(k) == "rest" and self.mode("rest") == "normal"}
            stale = [e for e in entries if split_key(e["key"])[0] in ("pr", "run") and self.waited(e)
                     and split_key(e["key"])[0] not in served
                     and e["key"] not in read and not (e["cache"] or {}).get("missing")
                     and self.now - data_at(e) >= WAITED_FRESH
                     and self.now - self.waited_tried.get(e["key"], float("-inf")) >= WAITED_FRESH]
            stale.sort(key=lambda e: (data_at(e), e["key"]))
            prs = [e for e in stale if e["key"].startswith("pr:")]
            runs = [e for e in stale if e["key"].startswith("run:")]
            probe = [e for e in prs if self.probe_ok(e)]
            full = [e for e in prs if not self.probe_ok(e)]
            for i in range(0, len(probe), WAITED_PROBE_BATCH):
                if not self.waited_room():
                    return
                chunk = probe[i:i + WAITED_PROBE_BATCH]
                self.waited_tried.update((e["key"], self.now) for e in chunk)
                repos = sorted({caller_of(e["key"])[1] for e in chunk})
                with self.waited_spend(), self.calling("pr", repos[0] if len(repos) == 1 else f"{len(repos)} repos",
                                                       waiters_of(chunk)):
                    changed, error = self.probe_prs(chunk)
                if error is not None:
                    self.errors.append(f"waited: {error}")
                    return
                full += changed
            for kind, todo, fetch in (("pr", full, lambda chunk: self.fetch_aliased(chunk, "pr")),
                                      ("run", runs, self.graphql_fetch["run"])):
                size = max(1, self.batch[kind])
                for i in range(0, len(todo), size):
                    if not self.waited_room():
                        return
                    self.waited_tried.update((e["key"], self.now) for e in todo[i:i + size])
                    with self.waited_spend():
                        left = self.batched(kind, todo[i:i + size], fetch)
                    if left:
                        return  # GraphQL stopped partway: the rest wait for the next pass
        except OutOfTime:
            return  # the tick's budget is spent: the next tick goes on
        finally:
            self.waived = False

    def waited_points(self) -> int:
        return sum(p for t, p in self.waited_log if self.now - t < 60)

    def waited_room(self) -> bool:
        return self.waited_points() < WAITED_PER_MINUTE and self.mode("graphql") != "stop" \
            and self.secondary_until <= self.now

    @contextlib.contextmanager
    def waited_spend(self):
        """The GraphQL points the reads inside spend count against WAITED_PER_MINUTE."""
        before = len(self.gql_log)
        try:
            yield
        finally:
            spent = sum(p for _, _, p in self.gql_log[before:])
            if spent:
                self.waited_log.append((self.now, spent))

    def to_graphql(self, left: list[dict], spilled: list[dict]) -> None:
        """REST is throttled or its share spent with these still to read: GraphQL reads them this tick when it
        is not stopped (and they did not just come from it); the rest go first next tick."""
        came = {e["key"] for e in spilled}
        if self.mode("graphql") == "stop":
            return self.defer(left, f"REST {self.rest_hold()} and GraphQL is stopped (under its reserve)")
        held = [e for e in left if e["key"] in came]
        for kind in ("pr", "comment", "run", "head"):
            mine = [e for e in left if e["key"].startswith(kind + ":") and e["key"] not in came]
            if mine:
                log({"event": "fallback", "to": "graphql", "kind": kind, "entries": len(mine)})
                held += self.batched(kind, mine, self.graphql_fetch[kind])
        self.defer(held, f"REST {self.rest_hold()} and GraphQL stopped partway")

    def finish_tick(self, entries: list[dict], prs: list[dict], runs: list[dict], comments: list[dict],
                    heads: list[dict]) -> dict:
        """Rule on the waits, prune, and write the heartbeat: the end of every tick, whatever read it."""
        self.tick_deadline = float("inf")
        try:
            with self.phase("land"):
                self.land_tick()
        except Exception as error:  # noqa: BLE001  the land queue must never stop the reads or the waits
            self.errors.append(f"land: {describe(error)} at {error_site(error)}")
        try:
            with self.phase("waits"):
                waiting = self.serve_waits()
        except Exception as error:  # noqa: BLE001  the waits are the clients' business; the reads go on
            waiting = None
            self.errors.append(f"waits: {describe(error)} at {error_site(error)}")
        # A confirming read that was made has had its turn ahead of the rest (wait_confirms): it stored an answer or
        # an error (fetchedAt moved), even if what it read next (a failed attempt's jobs) is deferred. One cut off
        # before its request keeps its place.
        for key, (finish, fetched) in self.confirming.items():
            if key not in self.deferred or (read_cache(key) or {}).get("fetchedAt") != fetched:
                self.confirm_tried[key] = (self.now, finish)
        self.confirming = {}
        self.deferred &= {e["key"] for e in entries}
        self.nudged &= {e["key"] for e in entries}
        self.attempted = {k: t for k, t in self.attempted.items() if self.now - t < 2 * IDLE_EXPIRY}
        self.rest_tried = {k: t for k, t in self.rest_tried.items() if self.now - t < 2 * IDLE_EXPIRY}
        self.cut_reads = {k: t for k, t in self.cut_reads.items() if self.now - t <= RESUME_MAX}
        self.confirm_tried = {k: t for k, t in self.confirm_tried.items() if self.now - t[0] < 2 * IDLE_EXPIRY}
        oldest = self.oldest_data(entries, {e["key"] for e in prs + runs + comments + heads})
        self.note_explained()  # before check_alarms: the stale alarm and the valve read it (catching_up)
        self.flush_refresh_notes()
        # errors[] is this tick's only, and a heartbeat tick writes it empty: what failed a minute ago stays visible
        for message in self.errors:
            self.recent_errors[message] = self.now
        self.recent_errors = dict(sorted(((m, t) for m, t in self.recent_errors.items()
                                          if self.now - t < RECENT_ERRORS_KEEP), key=lambda x: -x[1])[:10])
        self.prune({e["key"] for e in entries})
        self.post_prune()
        first_minute = int(self.clock() // 60) - 60
        self.fold_rest_hours({m: n for m, n in self.rest_minutes.items() if m < first_minute})
        self.rest_minutes = {m: n for m, n in self.rest_minutes.items() if m >= first_minute}
        if self.rest_minutes != self.saved_rest_minutes:
            write_json(BASE / REST_SPEND_FILE, {str(m): n for m, n in self.rest_minutes.items()})
            self.saved_rest_minutes = dict(self.rest_minutes)
        if self.budget != self.saved_budget:
            write_json(BASE / "budget.json", self.budget)
            self.saved_budget = json.loads(json.dumps(self.budget))
        if self.controller_fallback != self.saved_controller_fallback:
            write_json(BASE / CONTROLLER_FALLBACK_FILE, self.controller_fallback)
            self.saved_controller_fallback = json.loads(json.dumps(self.controller_fallback))
        self.save_spend()
        self.save_named_reads()
        try:
            with self.phase("alarms"):
                self.check_alarms()
        except Exception as error:  # noqa: BLE001  an alarm that cannot be sent must never stop the reads
            self.errors.append(f"alarm: {describe(error)} at {error_site(error)}")
        self.write_consumers()
        self.sent = [(t, what) for t, what in self.sent if self.now - t < 3600]
        hour = {what: sum(1 for _, w in self.sent if w == what)
                for what in ("rest", "rest304", "graphql", "free", "write", "kept")}
        app_reads = sum(1 for _, w in self.sent if w == "app")  # on the ci-watch App (AppPool), never the login's
        if app_reads:
            hour["app"] = app_reads
        self.reads = [r for r in self.reads if self.now - r[0] < 3600]
        self.read_secs = [r for r in self.read_secs if self.now - r[0] < READ_SECONDS_WINDOW]
        self.gql_log = [g for g in self.gql_log if self.now - g[0] < 3600]
        graphql_by: dict[str, dict[str, int]] = {}
        for _, why, points in self.gql_log:
            mine = graphql_by.setdefault(why, {"queries": 0, "points": 0})
            mine["queries"] += 1
            mine["points"] += points
        self.fed_repos = {r: t for r, t in self.fed_repos.items() if self.now - t < FED_REPO_KEEP}
        reads = {kind: {b: sum(1 for _, k, w in self.reads if k == kind and w == b) for b in ("graphql", "rest")}
                 for kind in CYCLES}
        status = {"pid": os.getpid(), "at": self.now, "watching": len(entries), "waits": WAITS_CONTRACT,
                  "waiting": waiting,
                  "fetched": {"pr": len(prs), "run": len(runs), "comment": len(comments), "head": len(heads)},
                  # `fedRepos` and `okAt` are Daemon.fed's own two inputs, published so a client can tell whether a
                  # run's finish still arrives over the feed when its read bucket has stopped (feed_covers).
                  "controller": {**self.controller_status, "runs": len(self.controller_filled),
                                 "fedRepos": {r: round(t, 3) for r, t in self.fed_repos.items()},
                                 "okAt": round(self.controller_ok_at, 3) if self.controller_ok_at > 0 else None},
                  "modes": {b: self.mode(b) for b in ("rest", "graphql")}, "errors": self.errors[:10],
                  "secondaryHold": {"until": self.secondary_until, "strikes": self.secondary_strikes}
                  if self.secondary_until > self.now else None, "forceLow": list(self.policy.get("forceLow", ())),
                  "lastHour": hour,
                  "restShare": {"spent": self.rest_spent(), "cap": self.rest_cap(), "yield": self.rest_yield(),
                                "share": self.policy["restShare"], "capped": self.rest_capped(),
                                "hours": self.rest_hours_view()},
                  "heartbeat": HEARTBEAT_EVERY, "paths": dict(self.paths), "reads": reads, "graphqlBy": graphql_by,
                  "spendBy": self.spend_by(), "alarms": self.alarms,
                  "perMinute": {b: round(self.richness(b) * 60, 1) for b in ("rest", "graphql")},
                  "batch": dict(self.batch), "oldestData": oldest, "deferred": len(self.deferred),
                  "newestData": dict(self.newest_data),
                  "graphqlDown": {"until": round(self.gql_down_until, 3), "strikes": self.gql_down_strikes}
                  if self.gql_down() else None,
                  "staleWaited": dict(self.stale_waited), "feedUnstarved": self.feed_unstarved,
                  "staleAfter": STALE_DATA_AFTER, "stale": self.stale_record(),
                  "staleWhy": self.stale_why(), "progress": self.progress(), "staleCause": self.stale_causes(),
                  "staleExplainedAt": {k: round(t, 3) for k, t in self.explained_at.items()},
                  "recentErrors": [{"error": m, "at": t} for m, t in self.recent_errors.items()],
                  "outbox": {"queued": len(list(outbox_dir().glob("*.json"))) if outbox_dir().is_dir() else 0,
                             "holdUntil": self.post_hold if self.post_hold > self.now else None,
                             "pause": self.content_pause_status()}}
        if self.upstream_status is not None:
            status["upstream"] = self.upstream_status
        if self.read_pool is not None:  # never a token: how many keys it read, and why the last repo got none
            status["readToken"] = {"served": self.read_served, "appServed": self.read_pool.served,
                                   "fellBack": self.read_pool.fell_back, "why": self.read_pool.why or None,
                                   "resting": sorted(o for o, t in self.read_pool.rest_until.items() if t > self.now)}
        # A fresh heartbeat over a refresh loop that reads nothing is not health: say so in the heartbeat itself, so
        # `budget`, `restart` and a wait's daemon_starved see it (stall_alarm; "held" when the quota explains it).
        stall = self.stall_alarm()
        status["healthy"] = stall is None
        if stall is not None:
            status["stalled"] = {"kind": "pr", "age": int(self.newest_data["pr"] or 0), "explained": stall == "held"}
        if self.app_pool is not None and (self.app_pool.served or self.app_pool.fell_back or self.app_pool.why):
            status["appPool"] = self.app_pool.status()
        # the heartbeat lets clients tell a hung daemon (lock held, nothing written) from an idle one
        recovered, self.failing = self.failing is not None, None
        if recovered or prs or runs or comments or heads or self.errors or self.now - self.beat >= HEARTBEAT_EVERY:
            write_json(BASE / "daemon.json", status)
            self.beat = self.now
        self.status = status
        return status

    def land_busy(self) -> bool:
        """A land job (a judgment or the step it took) is running. An update waits for it (reexec_due): under
        REEXEC_UPDATE_GAP of uptime it holds and the queue works on; past it, it drains (no new job starts) for at most
        REEXEC_DRAIN_MAX, and a step's claim is judged again by the next daemon (LandQueue.claim)."""
        q = self.land_queue
        if q is None:
            return False
        q.reap()
        return bool(q.jobs)

    def land_nudge(self, key: str) -> None:
        """Keep an event or queue-triggered nudge visible to LandQueue after the read scheduler consumes it."""
        self.nudged.add(key)
        if self.land_queue is not None and key in self.land_queue.entries:
            self.land_dirty.add(key)

    def land_tick(self) -> None:
        """The land queue's pass: cheap (its entries are in memory; judgments and steps run on its workers). None while
        an update waits to re-execute (reexec_waiting): the steps running end, no new one starts, and the new daemon
        takes the queue from there."""
        if self.reexec_waiting:
            return
        if self.land_queue is None:
            if not land_dir().is_dir():
                return
            self.land_queue = LandQueue(nudge=self.land_nudge, notice=self.write_notice, reading=self.land_reading,
                                        feed_quiet=self.land_feed_quiet)
        dirty, self.land_dirty = self.land_dirty, set()
        # A direct reader can update the shared cache in another process. Consume its key before reading
        # the cache, so a concurrent update is either visible this pass or leaves its own wake for the next.
        for marker in (land_dir() / "changed").glob("*.json"):
            key = read_json(marker)
            if isinstance(key, str) and key in self.land_queue.entries:
                dirty.add(key)
            marker.unlink(missing_ok=True)
        self.land_queue.tick(None if getattr(self, "clock_real", True) else self.now, dirty=dirty)

    # -- upstream: no login here; another host's glaeda-gh reads GitHub (UPSTREAM_CONFIG)

    def upstream(self) -> Callable[[dict], dict] | None:
        source = self.upstream_source
        if source == "config":
            command = upstream_command()
            return None if command is None else (lambda req: run_upstream(command, req, self.upstream_left()))
        return source if callable(source) else None

    def read_tokens(self) -> "ReadTokenPool | None":
        """This host's ReadTokenPool while upstream.json names a way to mint (read_token_command), else None; kept
        across ticks, and dropped when the config stops naming one."""
        command = read_token_command() if self.upstream_source == "config" else self.read_token_source
        if not command:
            self.read_pool = self.read_reader = None
            return None
        if self.read_pool is None or (isinstance(command, list) and self.read_pool.command != command):
            self.read_pool = command if isinstance(command, ReadTokenPool) else ReadTokenPool(command, clock=self.clock)
            self.read_reader = None
        return self.read_pool

    def read_direct(self, due: list[dict]) -> set[str]:
        """Read DUE's PRs and runs from GitHub with this host's read token, within READ_DIRECT_BUDGET: the keys read
        and stored. A key whose repo has no token, a read the token is refused, or one cut off goes upstream."""
        pool = self.read_tokens()
        if pool is None:
            return set()
        if self.read_reader is None:
            self.read_reader = read_token_daemon(pool)
            if self.read_transport is not None:
                self.read_reader.transport = self.read_transport
        reader, done = self.read_reader, set()
        reader.now, reader.clock_real = self.now, self.clock_real
        reader.tick_deadline = min(self.tick_deadline, time.monotonic() + READ_DIRECT_BUDGET)
        for e in due:
            kind, owner, repo, _ = split_key(e["key"])
            if kind not in READ_DIRECT_KINDS or pool.token(f"{owner}/{repo}".lower()) is None:
                continue
            path = cache_dir() / file_name(e["key"])
            before = read_json(path) if path.exists() else None  # a failed direct read leaves the cache as it was
            try:
                with self.phase("read direct"), reader.calling(*caller_of(e["key"]), "tool:glaeda-gh serve (read token)"):
                    reader.fetch_pr_rest(e) if kind == "pr" else reader.fetch_run(e)
            except OutOfTime:
                self.restore_cache(path, before)
                break
            except Exception as error:  # noqa: BLE001  the upstream reads it instead
                self.errors.append(f"read direct {e['key']}: {describe(error)}"[:UPSTREAM_ERROR_MAX])
                self.restore_cache(path, before)
                continue
            cached = read_cache(e["key"]) or {}
            if not cached.get("error") and (cached.get("fetchedAt") or 0) >= self.now:
                e["cache"] = cached
                self.attempted[e["key"]] = self.now
                done.add(e["key"])
            else:
                self.restore_cache(path, before)
        self.read_served += len(done)
        return done

    @staticmethod
    def restore_cache(path: Path, before: Any) -> None:
        """Put back the cache file a failed direct read wrote over: the upstream's answer, not this host's
        no-login error, is what the key keeps."""
        with contextlib.suppress(OSError):
            if before is None:
                path.unlink(missing_ok=True)
            else:
                write_json(path, before)

    def upstream_left(self) -> float:
        """Seconds left of this tick's UPSTREAM_TICK_BUDGET for one upstream run, at most UPSTREAM_DEADLINE."""
        return min(float(UPSTREAM_DEADLINE), self.upstream_end - time.monotonic())

    def upstream_tick(self, ask: Callable[[dict], dict]) -> dict:
        """One tick with an upstream: refuse what needs a login, read the due keys in one request, rule."""
        self.upstream_status = self.upstream_status or {"state": "starting"}
        self.controller_status = {"state": "off", "why": "reads through upstream"}
        self.upstream_refuse_posts()
        with self.phase("watches"):
            entries = self.watches()
        due = []
        full = self.now - self.upstream_at >= UPSTREAM_EVERY
        for e in entries:
            kind = split_key(e["key"])[0]
            if kind == "head" and not self.head_askers(e):
                continue  # nobody asked for it lately (HEAD_INTEREST): the upstream is not charged for it either
            if kind not in UPSTREAM_KINDS:
                if e["cache"] is None:
                    self.store(e["key"], None, error=f"{kind} reads need a GitHub login; this host reads through "
                                                     "its upstream")
                continue
            fresh = e["cache"] is None  # the upstream has answered nothing for it yet, not even an error
            if full or (fresh and self.now - self.attempted.get(e["key"], float("-inf")) >= UPSTREAM_NEW):
                due.append(e)
        # The least recently asked first (a key never asked is -inf): past UPSTREAM_MAX_KEYS they rotate, none starves.
        due = sorted(due, key=lambda e: (self.attempted.get(e["key"], float("-inf")), e["key"]))[:UPSTREAM_MAX_KEYS]
        if full:
            self.upstream_at = self.now
        if due:
            done = self.read_direct(due)  # read with this host's read token: those need no upstream
            due = [e for e in due if e["key"] not in done]
        if due:
            # Heads go in a request of their own: an upstream older than head keys refuses a whole request that has
            # one, and that must not stop the PRs' and runs' reads.
            # Each read sets upstream_status: a failing first read must not be called "ok" by a head read after it
            # (the stale alarm holds, and stale waits stay, only for an "ok" upstream). Either failing, the tick fails.
            failed = None
            parts = {"keys": [e for e in due if not e["key"].startswith("head:")],
                     "heads": [e for e in due if e["key"].startswith("head:")]}
            # The tick's upstream runs share UPSTREAM_TICK_BUDGET; the part a slow upstream cut off last time goes first.
            self.upstream_end = time.monotonic() + UPSTREAM_TICK_BUDGET
            order = ["heads", "keys"] if self.upstream_cut == "heads" else ["keys", "heads"]
            self.upstream_cut = None
            for name in order:
                part = parts[name]
                if not part:
                    continue
                if self.upstream_end - time.monotonic() < UPSTREAM_MIN_RUN:
                    self.upstream_cut = name  # not sent and not stamped: first next tick
                    log({"event": "upstream-budget", "cut": name, "keys": len(part), "budget": UPSTREAM_TICK_BUDGET})
                    continue
                with self.phase("read upstream"):
                    self.upstream_read(ask, part)
                if self.upstream_status.get("state") == "failing":
                    failed = failed or self.upstream_status
            if failed is not None:
                self.upstream_status = failed
        self.attempted = {k: t for k, t in self.attempted.items() if self.now - t < 2 * IDLE_EXPIRY}
        self.upstream_feed = {k: v for k, v in self.upstream_feed.items()
                              if self.now - v["answeredAt"] <= UPSTREAM_FEED_FRESH}
        self.consumer_sent ={k: t for k, t in self.consumer_sent.items() if self.now - t < 2 * HEAD_INTEREST}
        kinds = {kind: [e for e in due if e["key"].startswith(kind + ":")] for kind in CYCLES}
        return self.finish_tick(entries, kinds["pr"], kinds["run"], kinds["comment"], [])

    def head_askers(self, e: dict) -> list[str]:
        """The consumers that registered a head here (checks --consumer) within HEAD_INTEREST, newest first."""
        asked = e.get("consumers") or {}
        return sorted((n for n, t in asked.items() if self.now - t < HEAD_INTEREST), key=lambda n: (-asked[n], n))

    def upstream_read(self, ask: Callable[[dict], dict], due: list[dict]) -> None:
        # A head goes up once per consumer that asked for it here: the upstream registers each and charges its one
        # read to the first that may pay, as this host's own due_heads would. Whole keys go up to UPSTREAM_MAX_KEYS
        # lines; only those sent are stamped, so the rest stay least recently asked and go first next tick.
        # Each line carries this host's own interest times (touched, waitedAt, asked): the upstream stamps them, not
        # its now, so its interest ends when this host's does. A head with more askers than fit sends the least
        # recently sent first (consumer_sent), so every consumer goes up in turn, as keys rotate.
        keys, sent, lines_of = [], [], {}
        for e in due:
            # a reader that names its own host (a caller over reach) keeps it; any other is this host's
            reader = waiter_of(e) if "/" in waiter_of(e) else f"{policy_host()}/{waiter_of(e)}"
            base = {"key": e["key"], "jobs": e["jobs"], **({"reader": reader} if safe_reader(reader) else {}),
                    **({"touched": e["touched"]} if isinstance(e.get("touched"), (int, float)) else {}),
                    **({"wait": True, "waitedAt": e["waitedAt"]} if self.waited(e) else {})}
            askers = sorted(self.head_askers(e), key=lambda n: (self.consumer_sent.get((e["key"], n), float("-inf")), n)) \
                if e["key"].startswith("head:") else [None]
            lines = [{**base, **({"consumer": n, "asked": e["consumers"][n]} if n else {})} for n in askers]
            if keys and len(keys) + len(lines) > UPSTREAM_MAX_KEYS:
                break
            lines = lines[:UPSTREAM_MAX_KEYS]
            keys += lines
            sent.append(e)
        due = sent
        for e in due:
            self.attempted[e["key"]] = self.now
        for line in keys:
            if line.get("consumer"):
                self.consumer_sent[(line["key"], line["consumer"])] = self.now
        request = {"keys": keys}
        try:
            answer = ask(request)
            got = answer.get("entries") if isinstance(answer, dict) else None
            if not isinstance(got, dict):
                why = answer.get("error") if isinstance(answer, dict) and isinstance(answer.get("error"), str) else None
                raise WatchError(f"upstream: {why or 'its answer has no entries'}"[:UPSTREAM_ERROR_MAX])
        except Exception as error:  # noqa: BLE001  a broken upstream is reported, never fatal
            why = str(error) if isinstance(error, WatchError) else f"upstream: {describe(error)}"
            self.errors.append(why)
            self.upstream_status = {"state": "failing", "error": why, "at": self.now}
            for e in due:  # the data is kept; a status names the outage instead of showing it as current
                self.store(e["key"], e["cache"], error=why, errorFrom=UPSTREAM_OUTAGE, readAt=upstream_read_at(e["cache"]))
            return
        self.upstream_status = {"state": "ok", "at": self.now, "keys": len(due)}
        self.upstream_denials(got)
        # The upstream answered, so the outage is over for every key sent, whether it has data for the key or not:
        # each `continue` below clears it (upstream_outage_over); every store() after them drops errorFrom anyway.
        for e in due:
            entry = got.get(e["key"])
            feed = entry.get("feed") if isinstance(entry, dict) else None
            if isinstance(feed, dict):  # the upstream's feed view of a PR (feed_view), for land_feed_quiet here
                self.upstream_feed[e["key"]] = {**feed, "answeredAt": self.now}
            else:
                self.upstream_feed.pop(e["key"], None)
            if not isinstance(entry, dict):
                self.upstream_outage_over(e)
                continue  # the upstream has not read it yet: asked again in UPSTREAM_NEW
            data = entry.get("data") if isinstance(entry.get("data"), dict) else None
            error = entry.get("error") if isinstance(entry.get("error"), str) else None
            if data is None and error is None:
                self.upstream_outage_over(e)
                continue  # registered there, not read yet
            at, fetched = entry.get("dataAt"), entry.get("fetchedAt")
            mine = (e["cache"] or {}).get("dataAt")
            if data is not None and isinstance(at, (int, float)) and isinstance(mine, (int, float)) and at < mine:
                self.upstream_outage_over(e)
                self.keep_feed_view(e)
                continue  # a wait's own read here (direct_read) is newer: the upstream's older one never replaces it
            fields: dict[str, Any] = {"error": error[:UPSTREAM_ERROR_MAX] if error else None, "source": "upstream",
                                      "missing": entry.get("missing") is True,
                                      # provenance: a controller-only finish stays unconfirmed downstream too
                                      "origin": entry.get("origin") if isinstance(entry.get("origin"), str) else None,
                                      "restRun": entry.get("restRun") if isinstance(entry.get("restRun"), dict) else None,
                                      # the same view in the entry, for a wait client here (wait_starved): None clears
                                      "upstreamFeed": self.upstream_feed.get(e["key"])}
            if error and entry.get("errorFrom") == UPSTREAM_OUTAGE:
                # the upstream's own upstream was down: cleared as this host's is, back to its last real read
                read_at = entry.get("readAt")
                fields.update(errorFrom=UPSTREAM_OUTAGE, readAt=min(self.now, float(read_at)) if isinstance(
                    read_at, (int, float)) and not isinstance(read_at, bool) else None)
            if isinstance(fetched, (int, float)):
                fields["fetchedAt"] = min(self.now, float(fetched))  # a wait rules only on reads after it began
            shown = entry.get("restRunAt")  # when the upstream's GitHub read last showed restRun (run_unconfirmed)
            fields["restRunAt"] = (min(self.now, float(shown))
                                   if isinstance(shown, (int, float)) and not isinstance(shown, bool) else None)
            if data is not None:
                fields.update(data=data, dataAt=float(at) if isinstance(at, (int, float)) else self.now)
                vouched = entry.get("updatedAtAt")  # the upstream's own claim for this data (confirmed_updated)
                if isinstance(vouched, (int, float)) and not isinstance(vouched, bool):
                    fields["updatedAtAt"] = min(self.now, float(vouched))
            if isinstance(entry.get("jobs"), list):
                # this host's ETag (and a list it found final) vouch for its own last read, not the upstream's list:
                # a 304 on that ETag must not confirm this one as a completed attempt's (attempt_jobs_put)
                fields.update(jobs=entry["jobs"], jobsEtag=None, jobsDone=None)
                # when the upstream read that job list, so a downstream `--jobs` look is answered (once_answered)
                jobs_at = entry.get("jobsAt")
                if isinstance(jobs_at, (int, float)) and not isinstance(jobs_at, bool):
                    fields["jobsAt"] = min(self.now, float(jobs_at))
            self.store(e["key"], e["cache"], **fields)

    def keep_feed_view(self, e: dict) -> None:
        """The upstream's feed view of a PR whose copy here is newer (a wait's direct read), written on the entry as
        upstreamFeed with nothing else changed, when the view is of the head this copy names: wait_starved rules on
        the entry, and without it every wait that read its PR once re-read it every UPSTREAM_DIRECT_AFTER however
        quiet the feed said the PR was. A view of another head, or none, clears it."""
        cache = cache_dir() / file_name(e["key"])
        with bounded_lock(cache_dir() / ".write.lock") as held:
            if not held:
                return
            current = read_json(cache)
            if not isinstance(current, dict):
                return
            view = self.upstream_feed.get(e["key"])
            data = current.get("data") if isinstance(current.get("data"), dict) else {}
            head = str(data.get("headRefOid") or "").lower()
            if not (isinstance(view, dict) and head and str(view.get("head") or "").lower() == head):
                view = None
            if current.get("upstreamFeed") != view:
                write_json(cache, {**current, "upstreamFeed": view})

    def upstream_outage_over(self, e: dict) -> None:
        """A key the upstream answered with nothing to store no longer names an outage this host stored on it
        (2026-11-18: huge-blue's 9 s restart showed as "not running on the upstream host" on lane VMs for 30 min).
        An error the upstream gave for the key itself carries no errorFrom and stays. Nothing was read, so the entry goes
        back to what it was before the outage: fetchedAt the last real read (readAt), or no entry at all for a key never
        read. The outage's own fetchedAt would tell once_answered a one-off `status` was answered, and drop its watch."""
        if (e["cache"] or {}).get("errorFrom") != UPSTREAM_OUTAGE:
            return
        cache = cache_dir() / file_name(e["key"])
        with bounded_lock(cache_dir() / ".write.lock") as held:
            if not held:
                self.errors.append(f"{e['key']}: cache write lock timeout")
                return
            current = read_json(cache)
            if not isinstance(current, dict) or current.get("errorFrom") != UPSTREAM_OUTAGE:
                return  # written since this tick read it
            read_at = current.get("readAt")
            known = isinstance(read_at, (int, float)) and not isinstance(read_at, bool)
            if not known and current.get("data") is None:
                cache.unlink(missing_ok=True)  # never read: as before the outage, asked again in UPSTREAM_NEW
                return
            current = {k: v for k, v in current.items() if k not in ("errorFrom", "readAt")}
            write_json(cache, {**current, "error": None, **({"fetchedAt": float(read_at)} if known else {})})

    def upstream_denials(self, got: dict) -> None:
        """A head consumer the upstream refused for its budget is denied here too (this host's consumers ledger), so
        `checks` on this host says "budget spent" instead of "not read yet"."""
        for entry in got.values():
            budgets = entry.get("budgets") if isinstance(entry, dict) else None
            for name, budget in budgets.items() if isinstance(budgets, dict) else ():
                at = budget.get("deniedAt") if isinstance(budget, dict) else None
                if isinstance(name, str) and isinstance(at, (int, float)) and not isinstance(at, bool):
                    self.denied[name] = max(self.denied.get(name) or 0, min(self.now, float(at)))

    def upstream_refuse_posts(self) -> None:
        for path in sorted(outbox_dir().glob("*.json")) if outbox_dir().is_dir() else []:
            if not path.exists():
                continue  # a joined comment's member, finished with its leader
            item = read_json(path)
            self.post_finish(path, item if isinstance(item, dict) else {"id": path.stem},
                             error="this host reads GitHub through its upstream and has no login to post with")

    def serve_waits(self) -> int:
        """Rule on the `wait pr|run` requests clients left in waits/ (subscribe_wait): keep their interest
        registered, and when one is decided or out of time write what it prints and its exit code, then
        wake its blocker with the code. waits/.served tells the blockers waits are being ruled on. A
        request whose blocker is gone, or that cannot be read, is dropped. Returns how many are pending."""
        d = waits_dir()
        if not d.is_dir():
            return 0
        mark_waits_served()
        now = time.time()  # requests carry wall-clock times, whatever clock a tick was given
        pending, touch = 0, {}
        for path in sorted(d.glob("*.json")):
            rid = path.stem
            try:
                req = read_json(path)
                decided = self.serve_wait(d, rid, req, now, touch)
            except OSError:  # a full disk, say: the request stays, and the next tick tries again
                pending += 1
                continue
            except Exception:  # noqa: BLE001  a request that cannot be ruled on must not stop the others
                drop_wait(rid)  # its blocker sees the FIFO gone and hands the wait back (BLOCKER)
                continue
            if decided is None:
                pending += 1
        # One registration per key, all under one bound: a wedged holder of .register.lock costs a tick
        # LOCK_WAIT, not LOCK_WAIT per waiter.
        with lock_budget(LOCK_WAIT):
            for key, (jobs, readers) in touch.items():
                for reader in readers or [None]:
                    register(key, jobs, waited=True, reader=reader or "tool:glaeda-gh wait")
        # What a blocker killed after its wake, or a wait handed back to Python, left behind.
        for left in d.glob("*.*"):
            rid = left.name.split(".", 1)[0]
            pid = rid.split("-", 1)[0]
            if rid and not (d / f"{rid}.json").exists() and not (pid.isdigit() and waiter_alive(int(pid))):
                drop_wait(rid)
        return pending

    @staticmethod
    def note_wait_state(d: Path, rid: str, req: dict) -> None:
        """The one line BLOCKER's progress lines carry (progress_state), rewritten only when it changes -- and, once,
        with the stuck diagnosis for a state that has not changed in WAIT_STUCK_AFTER (progress_update, whose memory
        lives in REQ["progress"] here, as each tick has a fresh daemon). Written once and left alone: the blocker
        prints the file only when its text differs from the line it last printed, so an unchanged state is said once
        and not every WAIT_PROGRESS_EVERY."""
        try:
            # a copy: serve_wait keeps a shallow `before`, so a dict mutated in place is never written back
            seen = dict(req["progress"]) if isinstance(req.get("progress"), dict) else {}
            said = progress_update(seen, req, read_cache(req["key"]), time.time())
            req["progress"] = seen
            if said is None:
                return
            line = said.replace("\n  ", " ").replace("\nnext: ", "; next: ").replace("\n", " ") + "\n"
            path = d / f"{rid}.out.state"
            if not path.is_file() or path.read_text() != line:
                path.write_text(line)
        except Exception:  # noqa: BLE001  a progress line never stops a wait from being ruled on
            pass

    def straggler_reads(self, repo: str, paths: list[str]) -> dict[str, Any]:
        """straggler_pass's reads from a wait the daemon serves: through this daemon's own GET, charged and within the
        tick's deadline, when it has a login; an upstream host's through the broker within STRAGGLER_TICK_BUDGET.
        straggler_pass asks at most one list and STRAGGLER_JOB_READS jobs a head, the list once per STRAGGLER_FRESH."""
        if self.upstream() is not None:
            return straggler_get(repo, paths, STRAGGLER_TICK_BUDGET)
        out: dict[str, Any] = {}
        for path in paths:
            try:
                state, doc, _ = self.get(f"/repos/{repo}/{path}", None)
            except OutOfTime:
                state, doc = "error", "out of time this tick"
            out[path] = doc if state == "fresh" else str(doc)
        return out

    def serve_wait(self, d: Path, rid: str, req: Any, now: float, touch: dict[str, bool]) -> bool | None:
        """One request: None while pending, else whether its blocker was woken. Raises on a bad one."""
        if (isinstance(req, dict) and req.get("stale") is not None and waiter_alive(req.get("pid"))
                and now <= wait_deadline(req) + WAITS_LEFTOVER):
            return None  # handed back (below): its blocker takes it to resume_wait within WAITS_CHECK
        if (not isinstance(req, dict) or not waiter_alive(req.get("pid")) or not (d / f"{rid}.fifo").exists()
                or now > wait_deadline(req) + WAITS_LEFTOVER):
            drop_wait(rid)
            return False
        if req.get("code") is None:
            before = dict(req)
            if now - float(req.get("touched") or 0) >= TOUCH_EVERY:
                jobs_before, readers = touch.get(req["key"], (False, []))
                touch[req["key"]] = (jobs_before or bool(req.get("jobs")),
                                     readers + [str(req["reader"])] if isinstance(req.get("reader"), str) else readers)
                req["touched"] = now
                self.note_wait_state(d, rid, req)
            try:
                done, err = wait_step(req, now, self.straggler_reads), ""
            except WatchError as error:
                done, err = wait_refusal(req, "refused", str(error), "glaeda-gh wait --help")
            except Exception as error:  # noqa: BLE001  said to the waiter, not raised into the tick
                done, err = wait_refusal(req, "could-not-judge", f"the daemon could not rule on this wait: "
                                         f"{describe(error)}", wait_command(req))
            if done is not None:
                if err:
                    (d / f"{rid}.out.err").write_text(err)
                (d / f"{rid}.out").write_text(done[1])
                (d / f"{rid}.out.rc").write_text(f"{done[0]}\n")
                req["code"] = done[0]
            else:
                # Not while GitHub's quota explains the old data: the wait's own read could not get through either,
                # and every live wait would turn into a Python poll for the rest of its timeout (the memory the
                # blocker saves; review of glaeda#1942).
                # Nor while the upstream's own alarm covers it, unless this host can read the one target itself
                # (direct_command): the upstream may not read a new head for many minutes, and a wait on it then
                # times out on the superseded one (one lane VM, cmux#44462, 2026-11-16).
                explained = self.stale_explained(req.get("kind"))
                if explained == "upstream" and direct_command() is not None:
                    explained = None
                cached = read_cache(req["key"])
                starved = None if explained else wait_starved(req, cached, now)
                if starved is not None and self.wait_feed_quiet(req, cached, now):
                    starved = None  # nothing reached the PR since its copy: a direct read reads the same
                if starved is not None:
                    # This daemon is not refreshing what the wait is blocked on: hand the wait back (its blocker sees
                    # the FIFO gone and execs wait-resume), where poll_wait says so and reads GitHub once itself.
                    req["stale"] = round(starved)
                    write_json(d / f"{rid}.json", req)
                    with contextlib.suppress(OSError):
                        (d / f"{rid}.fifo").unlink()
                    return None
            if req != before:
                write_json(d / f"{rid}.json", req)
            if req.get("code") is None:
                return None
        if wake_waiter(d / f"{rid}.fifo", int(req["code"])):
            with contextlib.suppress(OSError):
                (d / f"{rid}.json").unlink()  # the blocker prints .out and removes the rest
            return True
        return False

    @property
    def graphql_fetch(self) -> dict[str, Callable[[list[dict]], str | None]]:
        return {"pr": self.fetch_prs, "comment": self.fetch_comments, "run": self.fetch_runs_graphql,
                "head": self.fetch_heads}

    def app_request_for(self, kind: str, entries: list[dict], bucket: str) -> tuple[str, str, dict] | None:
        """Return the representative App request when one installation can answer the whole read."""
        pool = self.app_pool
        if pool is None or not entries:
            return None
        if bucket == "rest":
            _, owner, repo, value = split_key(entries[0]["key"])
            paths = {"pr": f"/repos/{owner}/{repo}/pulls/{value}",
                     "run": f"/repos/{owner}/{repo}/actions/runs/{value}",
                     "comment": f"/repos/{owner}/{repo}/issues/{value}",
                     "head": f"/repos/{owner}/{repo}/commits/{value}/check-runs"}
            path = paths.get(kind)
            return ("GET", path, {}) if path else None
        if kind == "run":
            query, variables = run_query([e["key"] for e in entries])
        elif kind in ("pr", "comment"):
            query, variables = pr_query([e["key"] for e in entries], kind)
        elif kind == "head":
            query, variables = heads_query([e["key"] for e in entries]), {}
        else:
            return None
        return "POST", "/graphql", {"query": query, "variables": variables}

    def app_entries_eligible(self, kind: str, entries: list[dict], bucket: str) -> list[dict]:
        """Entries that can be served by the held App without touching the login quota."""
        pool = self.app_pool
        request = self.app_request_for(kind, entries, bucket)
        if pool is None or request is None:
            return []
        method, path, body = request
        owner = pool.owner_of(method, path, body)
        if owner is None:
            return []
        scope = pool.scope(owner, method, path, body)
        if pool.pick(owner, scope) is None:
            return []
        return entries

    def app_graphql_share(self, due: dict[str, list[dict]], over: dict[str, str]) -> dict[str, list[dict]]:
        """{kind: the due entries an App answers over GraphQL} of the PR and comment reads route() sent to REST because
        the login's GraphQL is low or stopped. route() weighs only the login's counters, but an App's GraphQL is its own
        12,500 points an hour, and batched() lets its chunks past the login's stop and pace: ten PRs a query instead of
        a REST read each. One host, 2026-11-22 03:26Z: the login's GraphQL stopped, every PR went over REST, and the
        tick's 260 s of REST stored 29 PRs in 600 s while the App's GraphQL sat more than 95% unspent."""
        if self.mode("graphql") == "normal" or self.gql_down():
            return {}
        share = {}
        for kind in ("pr", "comment"):
            if over.get(kind) == "rest" and due.get(kind):
                picked = self.app_eligible_by_owner(kind, due[kind], "graphql")
                if picked:
                    share[kind] = picked
        return share

    def app_eligible_by_owner(self, kind: str, entries: list[dict], bucket: str) -> list[dict]:
        """app_entries_eligible asked per owner, unioned in ENTRIES' order. It builds one representative request for
        the whole set, so a set that mixes owners is eligible for nothing at all (AppPool.owner_of returns None for a
        cross-owner query): one watch on an account with no App installed made every App-servable watch beside it
        ineligible too, and under a login stop due() then read none of them. One dev host, 2026-11-21 11Z, watched 18
        manaflow-ai and 14 teamleaderleo keys, so the mixed set was never eligible."""
        groups: dict[str, list[dict]] = {}
        for e in entries:
            groups.setdefault("/".join(split_key(e["key"])[1:3]).lower(), []).append(e)  # owner/repo: a benched repo alone
        if len(groups) < 2:
            return self.app_entries_eligible(kind, entries, bucket)
        ok = {e["key"] for g in groups.values() for e in self.app_entries_eligible(kind, g, bucket)}
        return [e for e in entries if e["key"] in ok]

    @property
    def rest_fetch(self) -> dict[str, Callable[[dict], None]]:
        return {"pr": self.fetch_pr_rest, "run": self.fetch_run, "comment": self.fetch_comment_rest,
                "head": self.fetch_head_rest}

    def batched(self, kind: str, entries: list[dict], fetch: Callable[[list[dict]], str | None]) -> list[dict]:
        """Read `entries` over GraphQL in queries of self.batch[kind]. A query that times out (504)
        halves the batch (once per tick, never below GQL_BATCH_MIN) and is retried at once as two
        halves, so one heavy entry cannot keep the rest stale: it ends up alone, is remembered as
        heavy and read alone from then on (every LEAN_FACTOR cycles once it keeps timing out), and
        the batch grows back. A 502 or 503 is split and retried without shrinking. GQL_SPLITS bounds
        the extra queries a tick spends on splitting; what is left waits for the next cycle. Returns the
        entries left unread because GraphQL stopped (its quota, or a throttle) partway, the one that hit it
        included, for the caller to read over REST, and the entries GraphQL failed with a 5xx or no answer that could
        not be split further, or every entry while GraphQL is out (gql_down): REST reads them this tick (GQL_DOWN)."""
        self.heavy = {k: h for k, h in self.heavy.items() if self.now - h["at"] < IDLE_EXPIRY}
        size = self.batch[kind]

        # A heavy entry GraphQL times out on alone, between its lone retries: REST reads it (the broker host, 2026-11-22:
        # a PR with 163 checks 504'd on every lone query, nothing read it, and the PR a due land was blocked on kept
        # data 14,000+ s old while the stale valve restarted the daemon every 30 min).
        backing_off: list[dict] = []

        def chunks(group: list[dict]) -> list[list[dict]]:
            alone, rest = [], []
            for e in group:
                h = self.heavy.get(e["key"])
                if h is None:
                    rest.append(e)
                elif h["fails"] < HEAVY_AFTER or self.now - h["at"] >= LEAN_FACTOR * self.policy["cycles"][kind]:
                    alone.append([e])
                else:
                    backing_off.append(e)
            # One owner per query. An App installation answers a read only when the whole query names one owner
            # (AppPool.owner_of returns None for a cross-owner body), so a batch that mixes owners has no App and
            # all of it -- the App-servable entries included -- goes on the shared login's 5,000 points an hour
            # while the role Apps hold 12,500 each. One dev host, 2026-11-21 11Z: 18 manaflow-ai and 14 teamleaderleo
            # watches interleaved at GQL_BATCH 15, so 108 of the hour's 163 login GraphQL points were spent by
            # cross-owner batches and only 5 by a manaflow-ai batch an App could take. Grouping costs one query per
            # owner (a query is a point at most, and an App's costs the login nothing).
            # And one repository per query: a refused query benches the repositories its errors name, and one that names
            # none benches nothing, so a mixed chunk's refusal would cost the App's whole set another try each tick.
            groups: dict[str, list[dict]] = {}
            for e in rest:
                groups.setdefault("/".join(split_key(e["key"])[1:3]).lower(), []).append(e)
            return alone + [g[i:i + size] for g in groups.values() for i in range(0, len(g), size)]
        # What a wait or a due land is blocked on goes first, heavy or not: the pace reads it before the rest
        queue = chunks([e for e in entries if self.waited(e)]) + chunks([e for e in entries if not self.waited(e)])
        splits, shrunk = 0, False
        to_rest: list[dict] = list(backing_off)
        while queue:
            chunk = queue.pop(0)
            on_app = bool(self.app_entries_eligible(kind, chunk, "graphql"))
            if (self.mode("graphql") == "stop" and not on_app) or self.gql_down():
                return to_rest + chunk + [e for c in queue for e in c]
            # The pace is the login's (gql_minute_points counts no App point), so a chunk the App answers is never
            # held by it. One host, 2026-11-22: every PR batch went on the App (12,500 an hour, under 5% spent) while
            # the login's head and check-page queries filled the minute, and 1,242 PR reads sat deferred behind
            # "42 of 40 points this minute": a waited PR's data was 13,401 s old.
            if not on_app and not self.gql_room(self.gql_expected(kind)):
                # Over the per-minute ceiling: this chunk waits, first next tick. Not REST's to read: GraphQL is not
                # spent, only paced, and a REST spill of a whole post-reset refresh would be the same burst there.
                # Only this chunk: an App-answered chunk queued behind a paced login chunk (an owner with no App, or a
                # heavy entry read alone) still goes this tick, since the pace is not its to keep.
                self.defer(chunk, f"the GraphQL pace: {self.gql_minute_points()} of "
                                  f"{self.policy.get('graphqlPerMinute', GRAPHQL_PER_MINUTE)} points this minute")
                if getattr(self, "gql_paced", None) is None:
                    self.gql_paced = kind
                self.paced_at[kind] = self.now  # the evidence pace_short needs
                continue
            self.gql_limited = False
            self.gql_reason = kind
            repos = sorted({caller_of(e["key"])[1] for e in chunk})
            self.limited = []
            try:
                began = time.monotonic()
                with self.calling(kind, repos[0] if len(repos) == 1 else f"{len(repos)} repos", waiters_of(chunk)):
                    error = fetch(chunk)
                spilled, self.spill = self.spill, []
                if not error:
                    self.note_read_seconds(kind, "graphql", time.monotonic() - began, len(chunk) - len(spilled))
                limited, self.limited = self.limited, []
            except OutOfTime:
                self.defer(chunk + [e for c in queue for e in c])  # no reason, as in the REST loop
                return to_rest
            except Exception as failure:  # noqa: BLE001  one bad batch must not stop the rest
                # A bug on one entry's answer (an AttributeError on a null node, huge-blue 2026-11-11) used to drop the
                # whole chunk here with nothing stored: every PR in it kept its old data, errors[] was empty again by the
                # next heartbeat, and the batch was cut the same way next cycle. Split the chunk so the healthy entries
                # are read this tick, and store the error (with its code site) on an entry read alone, so `status` and
                # `wait` say what failed and oldestData shows it. Bounded by GQL_SPLITS like a timeout's split.
                message = f"graphql: {describe(failure)} at {error_site(failure)}"
                self.errors.append(message)
                self.spill = []
                if len(chunk) >= 2 and splits + 2 <= GQL_SPLITS:
                    splits += 2
                    half = (len(chunk) + 1) // 2
                    queue = [chunk[:half], chunk[half:]] + queue
                    continue
                with contextlib.suppress(Exception):  # noqa: BLE001  storing the error must not stop the rest
                    for e in chunk:
                        self.store(e["key"], e["cache"], error=message[:300])
                continue
            if (error or self.gql_limited) and self.mode("graphql") == "stop":
                # this query hit the limit (a RATE_LIMITED answer can still carry data.rateLimit and null aliases):
                # whatever it stored for them, REST reads them this tick and replaces it
                return to_rest + chunk + [e for c in queue for e in c]
            if spilled:
                return to_rest + spilled + [e for c in queue for e in c]
            if limited:
                # Partial: not a clean query, and the batch was too big for these entries. Halve it, then re-read only
                # the partial ones at a size below this chunk's (so a re-read ends at one entry alone), within
                # GQL_SPLITS and, through gql_room above, the per-minute ceiling. Partial even alone: stored partial
                # with its error, as any partial read, and read again next cycle.
                self.clean[kind] = 0
                if len(chunk) < 2:
                    continue
                if self.batch[kind] > 1:
                    self.batch[kind] = max(1, self.batch[kind] // 2)
                    log({"event": "batch", "kind": kind, "size": self.batch[kind], "after": RESOURCE_LIMITS,
                         "partial": len(limited), "of": len(chunk)})
                size = min(self.batch[kind], max(1, len(chunk) // 2))
                redo = [limited[i:i + size] for i in range(0, len(limited), size)]
                if splits + len(redo) > GQL_SPLITS:
                    redo = []  # this tick's re-reads are spent: they wait for the next cycle, at the smaller size
                splits += len(redo)
                left = [e for c in queue for e in c]
                size = self.batch[kind]
                queue = redo + [left[i:i + size] for i in range(0, len(left), size)]
                continue
            down = bool(error and GQL_DOWN.search(error))  # a 5xx or no answer: not the entries' doing
            if down and GQL_NO_ANSWER.search(error):
                # No answer at all (URLError, a reset): unlike a 502 it says nothing about this batch, and splitting
                # only asks again. REST reads it this tick when it has room (the REST loop defers it otherwise).
                self.refresh_note("graphql", error, f"{kind} batch of {len(chunk)} ({', '.join(repos)})",
                                  "REST reads it this tick")
                to_rest += chunk
                continue
            if error and (down or SLOW.search(error)):
                what = (f"{kind} {key_name(chunk[0]['key'])}" if len(chunk) == 1
                        else f"{kind} batch of {len(chunk)} ({', '.join(repos)})")
                then = ("REST reads it this tick" if down and (len(chunk) < 2 or splits + 2 > GQL_SPLITS)
                        else "split into halves and retried" if len(chunk) >= 2 and splits + 2 <= GQL_SPLITS
                        else "REST reads it this tick")  # a lone timeout: too heavy for GraphQL even alone
                self.refresh_note("graphql", error, what, then)
            if len(chunk) == 1 and chunk[0]["key"] in self.heavy or (len(chunk) == 1 and error and SLOW.search(error)):
                if down or (error and SLOW.search(error)):
                    to_rest += chunk  # too heavy for GraphQL even alone: REST reads it this tick, page by page
                # a lone read says nothing about the batch size; it only judges this entry
                h = self.heavy.setdefault(chunk[0]["key"], {"at": self.now, "fails": 0, "oks": 0})
                h["at"] = self.now
                if error is None:
                    h["fails"], h["oks"] = 0, h["oks"] + 1
                    if h["oks"] >= 2:
                        self.heavy.pop(chunk[0]["key"])  # answered twice alone: back into the batches
                elif SLOW.search(error):
                    h["fails"], h["oks"] = h["fails"] + 1, 0
                continue
            if error is None:
                self.clean[kind] += 1
                if self.clean[kind] >= GQL_GROW_AFTER and len(chunk) >= self.batch[kind] < GQL_BATCH:
                    self.batch[kind] += 1
                    self.clean[kind] = 0
                continue
            slow = bool(SLOW.search(error))
            if down and (len(chunk) < 2 or splits + 2 > GQL_SPLITS):
                to_rest += chunk  # GitHub failed it and splitting cannot help any more: REST reads it this tick
                continue
            if not slow and not down or len(chunk) < 2:
                continue
            self.clean[kind] = 0
            if slow and not shrunk and self.batch[kind] > GQL_BATCH_MIN:
                shrunk = True
                self.batch[kind] = max(GQL_BATCH_MIN, self.batch[kind] // 2)
                log({"event": "batch", "kind": kind, "size": self.batch[kind], "after": error})
            if splits + 2 <= GQL_SPLITS:
                splits += 2
                half = (len(chunk) + 1) // 2
                left = [e for c in queue for e in c]
                size = self.batch[kind]
                queue = [chunk[:half], chunk[half:]] + [left[i:i + size] for i in range(0, len(left), size)]
        return to_rest

    def oldest_data(self, entries: list[dict], fetched: set[str]) -> dict[str, float | None]:
        """Per kind, how old the oldest data of an open (not finished) watch is. A finished one is
        re-read only every TERMINAL_REFRESH by design, so it does not count. self.stale_waited gets the same
        for the watches a wait is blocked on only: those are read every cycle, so an old one there is starved
        (STALE_DATA_AFTER), where an idle PR's old data is only its backoff."""
        oldest: dict[str, float | None] = {kind: None for kind in CYCLES}
        # And per kind the freshest data of a live watch, one a wait is on or someone read lately (polled every cycle,
        # not on an idle back-off): the refresh loop's own pulse, which stall_alarm reads.
        self.newest_data = {kind: None for kind in CYCLES}
        self.stale_waited = {kind: None for kind in CYCLES}
        self.blocked = {kind: 0 for kind in CYCLES}
        self.fresh_waited: dict[str, float | None] = {kind: None for kind in CYCLES}  # the newest waited data's age
        self.stale_waited_key: dict[str, str] = {}
        # A waited key this daemon has not seen yet is watched since its wait began (waitBegan) at the latest: after a
        # restart, a target never read successfully (504s since it was registered) keeps its age instead of starting
        # at zero, which capped its blocked time at zero and silenced the alarm (review of glaeda#1970, F1).
        self.since = {e["key"]: self.since.get(e["key"], self.wait_start(e) if self.waited(e) else self.now)
                      for e in entries}
        # When a wait first took an interest in each key (kept while it keeps it): a wait that lands on an idle PR
        # (read every IDLE_BACKOFF_MAX) finds old data that no wait has been blocked on yet. Its starvation is the time
        # a wait has actually waited, not the data's age, or the alarm fired at once on a PR that the next tick
        # reads (huge-blue 2026-11-12: FIRE at 2637 s, cleared 21 s later, and `restart` said nothing was wrong).
        # A key this daemon has not seen yet starts at the wait's own start (waitBegan, kept in the watch file), so
        # a restart does not make a wait that has already been blocked for long look new for another bound.
        prior = getattr(self, "waited_since", {})
        self.waited_since = {e["key"]: prior.get(e["key"], self.wait_start(e)) for e in entries if self.waited(e)}
        for e in entries:
            kind = split_key(e["key"])[0]
            cached = read_cache(e["key"]) if e["key"] in fetched else e["cache"]
            if cached and terminal(kind, cached.get("data")):
                continue
            # never read yet (a heavy PR timing out since it was registered): as old as its watch here
            seen = (cached or {}).get("dataAt") or self.since[e["key"]]
            age_s = max(0.0, self.now - seen)
            oldest[kind] = max(oldest[kind] or 0.0, age_s)
            if self.waited(e) or self.now - e["touched"] < IDLE_BACKOFF_AFTER:
                newest = self.newest_data[kind]
                self.newest_data[kind] = age_s if newest is None else min(newest, age_s)
            blocked = min(age_s, self.now - self.waited_since[e["key"]]) if self.waited(e) else 0.0
            self.blocked[kind] += self.waited(e)
            if self.waited(e) and (self.fresh_waited[kind] is None or age_s < self.fresh_waited[kind]):
                self.fresh_waited[kind] = age_s
            if self.waited(e) and blocked >= (self.stale_waited[kind] or 0.0):
                self.stale_waited[kind] = blocked
                self.stale_waited_key[kind] = e["key"]
        return oldest

    def wait_start(self, e: dict) -> float:
        """When the wait on this watch began, from its persisted waitBegan (never in the future), else now."""
        began = e.get("waitBegan")
        if isinstance(began, (int, float)) and not isinstance(began, bool):
            return min(float(began), self.now)
        return self.now

    def tick_failed(self, error: str, site: str, now: float | None = None) -> None:
        """A tick raised. The daemon is alive but refreshes nothing, so keep the heartbeat and say
        why: without this, a tick that raised every time looked like a hung daemon to clients, and a
        restart (which could not help) was their only advice."""
        self.now = time.time() if now is None else now
        first = self.failing is None
        since = self.now if first else self.failing["since"]
        count = 1 if first else self.failing["count"] + 1
        self.failing = {"error": error, "site": site, "since": since, "count": count}
        if first or self.now - self.beat >= HEARTBEAT_EVERY:
            write_json(BASE / "daemon.json", {**self.status, "pid": os.getpid(), "at": self.now,
                                              "heartbeat": HEARTBEAT_EVERY, "failing": self.failing})
            self.beat = self.now

    def store(self, key: str, prior: dict | None, **fields: Any) -> None:
        cache_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
        cache = cache_dir() / file_name(key)
        with bounded_lock(cache_dir() / ".write.lock") as held:
            if not held:
                self.errors.append(f"{key}: cache write lock timeout")
                return
            current = read_json(cache)
            base = current if isinstance(current, dict) else prior
            entry = {"key": key, "fetchedAt": self.now, "dataAt": None, "data": None, "error": None}
            if base:
                entry.update({k: base[k] for k in ("dataAt", "data", "etag", "jobs", "jobsEtag", "jobsAt", "jobsTried", "jobsDone", "restAt", "source", "restParts", "restRun", "restRunAt", "origin", "via", "rerunAt", "gqlBlindAt", "fp", "fullAt", "wholeAt", "restFullAt", "updatedAtAt")
                              if k in base})
            if key == self.resume_key and fields.get("dataAt") == self.now:
                fields = {**fields, "dataAt": self.resume_from}  # its oldest part's tick: no newer than that
            elif fields.get("dataAt") is not None:
                self.cut_reads.pop(key, None)  # read since (GraphQL, a wait's read): nothing older may replace it
            entry.update(fields)
            if "data" in fields and "updatedAtAt" not in fields:
                # updatedAtAt says when `data`'s head and updatedAt were last read from GitHub together (a whole
                # GraphQL read, a probe or a confirming first page: confirmed_updated). Data from any other writer
                # (REST, which may keep a pull up to PULL_REUSE_MAX; a wait's direct read) does not carry that claim.
                entry.pop("updatedAtAt", None)
            if key.startswith("pr:") and isinstance(entry.get("data"), dict) and "data" in fields:
                old = (base or {}).get("data") if isinstance((base or {}).get("data"), dict) else {}
                head = entry["data"].get("headRefOid")
                seen = old.get("headSeenAt") if head and old.get("headRefOid") == head else None
                if head and entry["data"].get("headSeenAt") is None:
                    entry["data"] = {**entry["data"], "headSeenAt": seen if seen is not None else self.now}
            write_json(cache, entry)
        if key.startswith("pr:") and "data" in fields:
            if self.land_queue is not None:
                if key in self.land_queue.entries and land_fingerprint(base) != land_fingerprint(entry):
                    self.land_dirty.add(key)
            elif (LandQueue.entries_dir() / file_name(key)).is_file() and land_fingerprint(base) != land_fingerprint(entry):
                write_json(land_dir() / "changed" / file_name(key), key)
        if fields.get("dataAt") is not None and not fields.get("error"):
            self.note_read(key)

    def fail(self, entries: list[dict], message: str) -> None:
        self.errors.append(message)
        for e in entries:
            self.store(e["key"], e["cache"], error=message)

    def refresh_note(self, source: str, error: str, target: str, then: str) -> None:
        """Write down one refresh failure (REFRESH_NOTE_EVERY): in full the first time a (source, error) is seen in a
        window, else counted into the window's summary line (flush_refresh_notes)."""
        now = self.clock()
        error = " ".join(str(error).split())
        error = (error[len(source) + 2:] if error.startswith(source + ": ") else error)[:160]
        key = (source, error)
        state = self.refresh_notes.get(key)
        if state is not None and now - state["at"] < REFRESH_NOTE_EVERY:
            state.update(count=state["count"] + 1, target=target, then=then)
            return
        if state is not None and state["count"]:
            self.refresh_summary(key, state, now)
        self.refresh_notes[key] = {"at": now, "count": 0, "target": target, "then": then}
        refresh_log_write(f"{utc_stamp(now)} glaeda-gh refresh: {source}: {error} on {target}; next: {then}")

    def refresh_summary(self, key: tuple[str, str], state: dict, now: float) -> None:
        refresh_log_write(f"{utc_stamp(now)} glaeda-gh refresh: {key[0]}: {key[1]}: {state['count']} more in the last "
                          f"{int(now - state['at'])}s (last on {state['target']}; next: {state['then']})")

    def flush_refresh_notes(self) -> None:
        """Each tick: a window past REFRESH_NOTE_EVERY with failures counted in it says how many, in one line."""
        now = self.clock()
        for key, state in list(self.refresh_notes.items()):
            if now - state["at"] < REFRESH_NOTE_EVERY:
                continue
            if state["count"]:
                self.refresh_summary(key, state, now)
                self.refresh_notes[key] = {**state, "at": now, "count": 0}
            elif now - state["at"] >= 10 * REFRESH_NOTE_EVERY:
                del self.refresh_notes[key]  # quiet for a while: the next one prints in full again

    def note_gql_health(self, error: str | None) -> None:
        """Count one GraphQL answer toward GQL_DOWN_AFTER: ERROR None is a clean one (anything under 500), which ends
        an outage; a 5xx or no answer at all (GQL_DOWN) adds to the streak, and at GQL_DOWN_AFTER over GQL_DOWN_SPAN
        takes GraphQL out (gql_down) for the doubling back-off; once out, the first failure after a hold takes it out
        again. A timeout or a hold says nothing either way."""
        if error is None:
            if self.gql_down_until > self.clock():
                log({"event": "graphql-up", "after": self.gql_down_strikes})
                refresh_log_write(f"{utc_stamp(self.clock())} glaeda-gh refresh: graphql: answering again after "
                                  f"{self.gql_down_strikes} hold(s); next: reads go back to GraphQL")
            self.gql_down_streak = self.gql_down_strikes = 0
            self.gql_down_until = 0.0
            return
        if not GQL_DOWN.search(error):
            return
        if self.gql_down_streak == 0:
            self.gql_down_since = self.clock()
        self.gql_down_streak += 1
        if self.gql_down_strikes == 0 and (self.gql_down_streak < GQL_DOWN_AFTER
                                           or self.clock() - self.gql_down_since < GQL_DOWN_SPAN):
            return
        self.gql_down_streak = 0
        self.gql_down_strikes += 1
        hold = min(GQL_DOWN_MAX, GQL_DOWN_BACKOFF * 2 ** (self.gql_down_strikes - 1))
        self.gql_down_until = self.clock() + hold
        log({"event": "graphql-down", "after": error, "hold": hold, "strikes": self.gql_down_strikes})
        refresh_log_write(f"{utc_stamp(self.clock())} glaeda-gh refresh: graphql: taken out after "
                          f"{error.removeprefix('graphql: ')} "
                          f"(strike {self.gql_down_strikes}); next: every GraphQL read goes to REST until "
                          f"{utc_clock(self.gql_down_until)}")

    def gql_down(self) -> bool:
        """Whether GraphQL is out (note_gql_health): its reads go to REST this tick."""
        return self.gql_down_until > self.clock()

    def graphql(self, query: str, variables: dict, route: "list[str] | None" = None) -> tuple[dict | None, str | None]:
        """(doc, None) or (None, error message). Notes the rateLimit field when the query asks for it. ROUTE names
        the repositories ("OWNER/REPO") a query by node id reads, so one owner's App can answer it (graphql_named_repos)."""
        began = time.monotonic()
        body: dict[str, Any] = {"query": query, "variables": variables}
        if route:
            body[APP_POOL_ROUTE_FIELD] = sorted(set(route))
        try:
            status, _, doc = self.request("POST", "/graphql", body)
        except (WatchError, OSError) as error:  # (a held or timed-out query is not counted: it may not have run)
            message = f"graphql: {describe(error)}"
            self.note_gql_health(message)
            return None, message
        took = time.monotonic() - began
        if status in (502, 503) and took >= GQL_SLOW_5XX_AFTER:
            # past GitHub's time budget (GQL_SLOW_5XX_AFTER): SLOW, so batched() shrinks and splits; not GQL_DOWN
            return None, f"graphql: timed out (GitHub answered {status} after {took:.1f}s)"
        self.note_gql_health(f"graphql: HTTP {status}" if status >= 500 else None)
        rate =((doc.get("data") or {}).get("rateLimit") or {}) if isinstance(doc, dict) else {}
        cost = rate.get("cost") if isinstance(rate, dict) else None
        points = cost if isinstance(cost, int) and not isinstance(cost, bool) and cost > 0 else 1
        if self.last_request_source == "app":
            # The App has its own GraphQL bucket. Do not let its rateLimit answer stop or pace the login.
            if self.last_app_pool is not None:
                self.last_app_pool.graphql_answered(rate if isinstance(rate, dict) else {}, points)
        else:
            self.gql_log.append((self.clock(), self.gql_reason, points))  # (gql_minute_points: one clock)
            self.note_spend("graphql", self.gql_reason, 1, points)
        if status != 200 or not isinstance(doc, dict):
            return None, f"graphql: HTTP {status}"
        if rate and self.last_request_source != "app":
            self.note_budget("graphql", rate.get("limit"), rate.get("remaining"), iso_epoch(rate.get("resetAt")))
        return doc, None

    def fetch_aliased(self, entries: list[dict], kind: str) -> str | None:
        """None, or the error when the whole query failed (batched() halves on a timeout)."""
        query, variables = pr_query([e["key"] for e in entries], kind)
        self.reads += [(self.now, kind, "graphql")] * len(entries)
        doc, error = self.graphql(query, variables)
        if doc is None:
            self.fail(entries, error or "graphql: no response")
            return error or "graphql: no response"
        data = doc.get("data") or {}
        if not data and doc.get("errors"):  # GitHub reports a timeout as 200 with data null
            message = "graphql: " + str((doc["errors"][0] or {}).get("message"))[:200]
            self.fail(entries, message)
            return message
        problems: dict[str, dict] = {}
        limits: dict[str, str] = {}  # alias -> GitHub's message, for an alias a field of which hit the resource limit
        for err in doc.get("errors") or []:
            path = err.get("path") or [""]
            problems[str(path[0])] = err
            if err.get("type") == RESOURCE_LIMITS:
                limits.setdefault(str(path[0]), str(err.get("message") or RESOURCE_LIMITS)[:200])
        alias, field = ("p", "pullRequest") if kind == "pr" else ("c", "issueOrPullRequest")
        if kind == "pr":
            for err in doc.get("errors") or []:
                found = re.fullmatch(rf"{alias}(\d+)", str(err["path"][0])) if protection_forbidden(err) else None
                i = int(found.group(1)) if found else -1
                base = ((data.get(f"{alias}{i}") or {}).get(field) or {}).get("baseRef") if found else None
                if 0 <= i < len(entries) and isinstance(base, dict):  # (APP_FORBIDDEN_PROTECTION)
                    base["branchProtectionRule"] = {
                        "requiredStatusCheckContexts": sorted(prior_required(entries[i].get("cache") or {}))}
        parsed = {}
        fps: dict[int, str | None] = {}  # PR alias -> its fingerprint (pr_fingerprint), None when partial
        attempts: dict[int, list[str] | str] = {}  # PR alias -> its suites whose newest attempt ran nothing
        nulls: dict[int, int] = {}  # PR alias -> context nodes GitHub answered null (drop_null_contexts)
        kept: set[int] = set()  # PR aliases whose cached, paged answer this first page confirms (unchanged_paged)
        if kind == "pr":
            for i in range(len(entries)):
                node = (data.get(f"{alias}{i}") or {}).get(field)
                if node:
                    nulls[i] = drop_null_contexts(node)
                    if not nulls[i] and f"{alias}{i}" not in limits and self.unchanged_paged(entries[i], node):
                        kept.add(i)
                        continue
                    commit = (((node.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}
                    attempts[i] = ran_nothing_suites(commit)
        # one read for the whole batch's suites, not one per PR: most cmux heads have a few such suites
        suite_runs, suites_error = self.suite_runs(
            [s for found in attempts.values() if isinstance(found, list) for s in found], paced=False,
            route=["/".join(split_key(e["key"])[1:3]) for e in entries])
        wanted = self.rollup_wanted() if kind == "pr" else frozenset()
        captured: dict[int, dict] = {}  # PR alias -> its rollup snapshot (capture_rollup), for a land PR
        for i, e in enumerate(entries):
            node = (data.get(f"{alias}{i}") or {}).get(field)
            if i in kept:
                continue
            if node:
                page_error = None
                if kind == "pr" and e["key"] in wanted:
                    captured[i] = self.capture_rollup(e["key"], node, nulls.get(i, 0) + (f"{alias}{i}" in limits))
                if kind == "pr":
                    page_error = self.extend_pr_contexts(e, node)
                    page_error = self.add_last_real_contexts(node, attempts[i], suite_runs, suites_error) or page_error
                    # a context GitHub could not read may be a red one: partial, never greener
                    page_error = page_error or (null_contexts_error(nulls[i]) if nulls.get(i) else None)
                parsed[i] = parse_pr(node) if kind == "pr" else parse_comments(node)
                if kind == "pr" and f"{alias}{i}" in limits:
                    # a field GitHub gave up on is null here, wherever it sits: the PR reads pending, never green
                    page_error = page_error or "graphql: " + limits[f"{alias}{i}"]
                if page_error:
                    parsed[i]["checksPageError"] = page_error
                    split_unread(parsed[i])  # a required name past the pages read is unread, not missing
                if kind == "pr":
                    fps[i] = None if page_error else pr_fingerprint(node)
                if i in captured:
                    self.save_rollup(e["key"], node, captured[i], fps[i])
        if kind == "pr":
            self.fill_steps([(entries[i], d) for i, d in parsed.items()])
        self.limited = [e for i, e in enumerate(entries) if f"{alias}{i}" in limits]
        for i, e in enumerate(entries):
            if i in kept:
                self.store(e["key"], e["cache"], dataAt=self.now, via="graphql-probe", fullAt=self.now,
                           **confirmed_updated(e["cache"], (data.get(f"{alias}{i}") or {}).get(field), self.now))
                continue
            if i in parsed:
                # a REST read's kept answers are dead weight in a file clients re-read every 3 s
                more = {"fp": fps.get(i), "fullAt": self.now, "wholeAt": self.now,
                        "updatedAtAt": self.now} if kind == "pr" else {}
                self.store(e["key"], e["cache"], dataAt=self.now, data=parsed[i], restParts=None, via="graphql", **more)
                continue
            err = problems.get(f"{alias}{i}") or {}
            what = "pull request" if kind == "pr" else "issue or pull request"
            # only GitHub saying NOT_FOUND for this alias means it does not exist (or is not visible)
            self.store(e["key"], e["cache"], error=str(err.get("message") or f"no data for this {what}")[:200],
                       missing=err.get("type") == "NOT_FOUND")

    def unchanged_paged(self, e: dict, node: dict) -> bool:
        """Whether a full read's first page of a PR past one page of checks confirms its cached, whole answer: the
        cache is a whole GraphQL read with a fingerprint, the fingerprint (every check run and status counted by
        state, over all pages) is the same, and every check on this first page reads as cached. Then the cache stands
        (dataAt and fullAt move) and its follow-up pages, its last-real-attempt suites and its steps are not read.
        cosmic-gray, 2026-11-11 15:40Z: 7 of 74 open PRs sat partial with "PR check pages wait for the per-minute
        ceiling"; a partial PR is never probed, so each was read in full again every cycle, and pages that waited for
        the ceiling made it partial again (688 "pr" points in the hour, the daemon at its 40 a minute)."""
        contexts = ((((node.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}).get(
            "statusCheckRollup") or {}
        if not ((contexts.get("contexts") or {}).get("pageInfo") or {}).get("hasNextPage"):
            return False  # one page: the full read is cheap and replaces the answer whole
        if not self.probe_ok({**e, "cache": {**(e.get("cache") or {}), "fullAt": self.now}}):
            return False  # (probe_ok's rules but the PR_FULL_EVERY bound: this is that full read)
        cached = e["cache"]
        whole = cached.get("wholeAt")
        if not isinstance(whole, (int, float)) or self.now - whole >= PR_WHOLE_EVERY:
            return False  # pages, the base's rules and required flags are read whole this often (review of #1956)
        if pr_fingerprint(node) != cached.get("fp"):
            return False
        known = {(c.get("workflow"), c.get("name")): (c.get("status"), c.get("conclusion"), bool(c.get("required")))
                 for c in cached["data"].get("checks") or []}
        first = parse_pr(node).get("checks") or []
        return all(known.get((c.get("workflow"), c.get("name"))) == (c.get("status"), c.get("conclusion"),
                                                                      bool(c.get("required"))) for c in first)

    def gql_minute_points(self) -> int:
        """GraphQL points this daemon spent in the last 60 s (graphqlPerMinute), by the clock the points were logged
        with (clock(): the wall clock, or the pinned one a test drives tick(now=...) with).

        Both used to be the tick's start (self.now), which stands still for a whole tick while its queries go out over
        up to TICK_BUDGET and more, and the outbox's queries (post_between) were logged by the wall clock: two clocks
        for one counter. huge-blue, 2026-11-20: ticks of ~90 s; a tick's first 40 points kept "this minute" full for the
        rest of the tick, so every later batch was deferred ("41 of 40 points this minute") though the real minute had
        room, and the next tick, its start 90 s on, found the window empty and spent 40 at once: bursts, and fewer
        points a minute than the pace allows."""
        now = self.clock()
        return sum(points for at, _why, points in self.gql_log if now - at < 60)

    def gql_expected(self, why: str) -> int:
        """The points the next query of WHY is expected to cost: the most of its last GQL_EXPECT_LAST queries in
        READ_PROGRESS_WINDOW, else 1."""
        now = self.clock()
        costs = [points for at, w, points in self.gql_log if w == why and now - at < READ_PROGRESS_WINDOW]
        return max(costs[-GQL_EXPECT_LAST:], default=1)

    def gql_room(self, cost: int = 1) -> bool:
        """Whether one more GraphQL query of COST points fits under the per-minute ceiling (policy graphqlPerMinute).
        The cost counts: a gate that asked only "under the ceiling?" let a 39th point admit a query of several, the
        "41 of 40 points this minute" huge-blue showed. A query costing more than the whole pace still goes out
        alone, in a minute with nothing else spent, or it could never be read."""
        spent = self.gql_minute_points()
        pace = self.policy.get("graphqlPerMinute", GRAPHQL_PER_MINUTE)
        return spent < pace and (spent == 0 or spent + max(1, cost) <= pace)

    def app_answers(self, query: str, variables: dict, route: "list[str] | None" = None) -> bool:
        """Whether this GraphQL query would go on an App pool, not the login: the login's pace and hourly shares
        (gql_room, pr_pages_points) never hold it, as batched() never holds a chunk the App answers."""
        pool = self.app_pool
        if pool is None:
            return False
        body: dict[str, Any] = {"query": query, "variables": variables}
        if route:
            body[APP_POOL_ROUTE_FIELD] = sorted(set(route))
        owner = pool.owner_of("POST", "/graphql", body)
        return owner is not None and pool.pick(owner, pool.scope(owner, "POST", "/graphql", body)) is not None

    def pr_pages_points(self) -> int:
        """GraphQL points the follow-up check pages spent in the last hour (PR_PAGES_POINTS_PER_HOUR)."""
        now = self.clock()
        return sum(points for at, why, points in self.gql_log if why == "pr-pages" and now - at < 3600)

    def add_last_real_contexts(self, node: dict, suites: list[str] | str, runs: dict[str, list[dict]],
                               runs_error: str | None) -> str | None:
        """Add to a PR node's rollup the check runs of SUITES, its suites whose newest attempt ran nothing, from RUNS
        (suite_runs over the batch); the error when they cannot be read, so the cached rollup is partial, never green."""
        commit = (((node.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}
        extra, error = suites_contexts(suites, runs, runs_error)
        if extra:
            rollup = commit.get("statusCheckRollup")
            if not isinstance(rollup, dict):
                rollup = commit["statusCheckRollup"] = {"state": None, "contexts": {"nodes": []}}
            contexts = rollup.setdefault("contexts", {})
            contexts["nodes"] = list(contexts.get("nodes") or []) + extra
        return error

    def extend_pr_contexts(self, entry: dict, node: dict) -> str | None:
        """Make a PR's cached statusCheckRollup hold every required check, past the first 100 contexts too.

        The first PR query is deliberately batched. A required name it did not show is read by name first
        (required_by_name: one conditional REST read per such name, so the cost follows the required names, not the
        contexts); only what that cannot settle falls back to the follow-up pages, which use the already-known exact
        head commit and are bounded. A partial read is retained with an explicit error and never treated as a green
        verdict; the names it left unread are kept apart from the ones known missing (split_unread).
        """
        commits = ((node.get("commits") or {}).get("nodes") or [{}])
        commit = (commits[0] or {}).get("commit") or {}
        rollup = commit.get("statusCheckRollup") or {}
        contexts = rollup.get("contexts") or {}
        page = contexts.get("pageInfo") or {}
        sha = node.get("headRefOid")
        if not page.get("hasNextPage") or not sha or not re.fullmatch(r"[0-9a-fA-F]{40}", str(sha)):
            return None
        _, owner, repo, number = split_key(entry["key"])
        nodes = list(contexts.get("nodes") or [])
        required = required_names(node.get("baseRef") or {})
        reported = {c.get("name") or c.get("context") for c in nodes}
        # Once every required context is in the first page, keep the cache to one cheap query. The
        # rollup's totalCount/pageInfo still tell callers that optional contexts are only a slice, and a
        # truncated rollup's verdict comes from GitHub's checkState (check_verdict). A base that requires
        # no context has nothing to find past the first page either: paging every such PR on every
        # cycle was 1678 of one daemon's 1958 GraphQL points an hour (2026-11-04 03:33Z, 139 cmux PRs
        # over 100 checks on feat-cmux-next, which requires none), and ran the shared login's GraphQL
        # hour out before landings could read their gates.
        if not required or required.issubset(reported):
            return None
        named, unsettled = self.required_by_name(owner, repo, str(sha), sorted(required - reported), int(number))
        if unsettled is None:
            # every required name is read (or proven unreported): the rollup is as whole as a first page that held them
            contexts["nodes"] = nodes + [c for found in named.values() for c in found]
            return None
        error = self.page_pr_contexts(owner, repo, str(sha), int(number), contexts, nodes, required, reported)
        if error is not None:
            # the pages stopped short: a required name they did not reach stands on its own read, when it had one
            left = [c for name, found in named.items() if name not in reported for c in found]
            contexts["nodes"] = nodes + left
        return error

    def page_pr_contexts(self, owner: str, repo: str, sha: str, number: int, contexts: dict, nodes: list,
                         required: set[str], reported: set) -> str | None:
        """Follow the rollup's pages into CONTEXTS until every REQUIRED name is in REPORTED (NODES and REPORTED grow
        in place); None, or why the read stopped short (the rollup is partial)."""
        page = contexts.get("pageInfo") or {}
        cursor = page.get("endCursor")
        for _ in range(PR_CONTEXT_MAX_PAGES - 1):
            if not cursor:
                return "graphql: PR check page has no cursor"
            query = "query{" + head_query(owner, repo, sha, cursor, number) + "}"
            on_app = self.app_answers(query, {})  # the login's hourly share and pace are the login's alone
            if not on_app and self.pr_pages_points() >= PR_PAGES_POINTS_PER_HOUR:
                # Over its hourly share: a required context may sit past this page, so the PR reads pending
                # (checksPageError), never green on a partial rollup, until the rolling hour frees room.
                return "graphql: PR check pages over their hourly share"
            if not on_app and not self.gql_room():
                return "graphql: PR check pages wait for the per-minute ceiling"
            reason, self.gql_reason = self.gql_reason, "pr-pages"
            try:
                more, error = self.graphql(query, {})
            finally:
                self.gql_reason = reason
            if more is None:
                return error or "graphql: PR check page unavailable"
            rollup_more = (((more.get("data") or {}).get("repository") or {}).get("object") or {}).get("statusCheckRollup")
            contexts_more = (rollup_more or {}).get("contexts") or {}
            if more.get("errors") or not rollup_more:
                return "graphql: PR check page unavailable"
            more_nodes = contexts_more.get("nodes") or []
            dropped = sum(1 for c in more_nodes if not isinstance(c, dict))
            more_nodes = [c for c in more_nodes if isinstance(c, dict)]
            nodes.extend(more_nodes)
            reported |= {c.get("name") or c.get("context") for c in more_nodes}
            page = contexts_more.get("pageInfo") or {}
            cursor = page.get("endCursor")
            contexts["nodes"] = nodes
            contexts["totalCount"] = contexts_more.get("totalCount", contexts.get("totalCount", len(nodes)))
            contexts["pageInfo"] = page
            if dropped:
                return null_contexts_error(dropped)
            if not page.get("hasNextPage"):
                return None
            if required and required.issubset(reported):
                return None
        return f"graphql: more than {PR_CONTEXT_MAX_PAGES * 100} PR checks"

    def named_get(self, path: str) -> tuple[Any, str | None]:
        """(doc, None) or (None, error): a conditional REST read whose ETag and answer the daemon keeps in memory, so
        an unchanged answer is a free 304."""
        etag, kept = self.named_reads.get(path, (None, None))
        try:
            state, doc, new_etag = self.get(path, etag if kept is not None else None)
        except OutOfTime:
            return None, "rest: out of time this tick"
        if state == "error":
            return None, doc
        if state == "same":
            return kept, None
        doc = slim_named(doc)
        self.named_reads.pop(path, None)  # (re-inserted last: the oldest answers go first)
        while len(self.named_reads) >= NAMED_READS_KEPT:
            del self.named_reads[next(iter(self.named_reads))]  # bounded: an old head's answers are worth nothing
        if new_etag:
            self.named_reads[path] = (new_etag, doc)
            self.named_dirty = True
        return doc, None

    def save_named_reads(self) -> None:
        """NAMED_READS_FILE, when a read changed it this tick."""
        if self.named_dirty:
            write_json(BASE / NAMED_READS_FILE, {"schema": "glaeda-gh-named-reads/v1",
                                                 "reads": {p: list(v) for p, v in self.named_reads.items()}})
            self.named_dirty = False

    def required_by_name(self, owner: str, repo: str, sha: str, names: list[str],
                         number: int) -> tuple[dict[str, list[dict]], str | None]:
        """Read each required name the first page did not show, by name: one REST
        `commits/SHA/check-runs?check_name=NAME&filter=latest` per name and, only when a name has no check run, one
        read of the commit's statuses (a required context may be a status). The cost follows the required names, not
        the contexts: manaflow-ai/cmux#43194 had 100 to 250 contexts and one required name, and the pages that would
        reach it were held by PR_PAGES_POINTS_PER_HOUR (leo-workspace#5184, ask 3).

        ({name: its context nodes in statusCheckRollup's shape, [] when proven unreported}, None) when every name is
        settled, else (the names settled so far, why the rest are not). Held by the daemon's REST share and floor."""
        settled: dict[str, list[dict]] = {}
        if not names:
            return settled, None
        if not (self.rest_room(len(names) + 1) and self.rest_above_floor()):
            return settled, "rest: required checks by name wait for the REST share"
        root = f"/repos/{owner}/{repo}/commits/{sha}"
        absent: list[str] = []
        for name in names:
            doc, error = self.named_get(
                f"{root}/check-runs?check_name={urllib.parse.quote(name, safe='')}&filter=latest&per_page=100")
            if error is not None or not isinstance(doc, dict) or not isinstance(doc.get("check_runs"), list):
                return settled, error or "rest: check runs by name unreadable"
            runs = [r for r in doc["check_runs"] if isinstance(r, dict) and r.get("name") == name]
            if runs:
                settled[name] = [named_check_node(r) for r in runs]
            else:
                absent.append(name)
        if absent:
            doc, error = self.named_get(f"{root}/status?per_page=100")
            if error is not None or not isinstance(doc, dict) or not isinstance(doc.get("statuses"), list):
                return settled, error or "rest: commit statuses unreadable"
            statuses = {s.get("context"): s for s in doc["statuses"] if isinstance(s, dict)}
            whole = (doc.get("total_count") or 0) <= len(doc["statuses"])
            for name in absent:
                if name in statuses:
                    s = statuses[name]
                    settled[name] = [{"__typename": "StatusContext", "context": name, "state": upper(s.get("state")),
                                      "targetUrl": s.get("target_url"), "createdAt": s.get("created_at"),
                                      "isRequired": True}]
                elif whole:
                    settled[name] = []  # no check run and no status by that name: not reported, read in full
            if any(name not in settled for name in absent):
                return settled, "rest: more than 100 commit statuses"
        return settled, None

    def fetch_prs(self, entries: list[dict]) -> str | None:
        """The batch's PRs: the ones a probe may confirm (probe_ok) are probed first, one cheap query (PR_PROBE_FIELDS),
        and only the rest, and the probed ones that changed, are read in full."""
        probe = [e for e in entries if self.probe_ok(e)]
        full = [e for e in entries if not self.probe_ok(e)]
        if probe:
            changed, error = self.probe_prs(probe)
            if error is not None:
                self.fail(entries, error)
                return error
            full += changed
        return self.fetch_aliased(full, "pr") if full else None

    def probe_ok(self, e: dict) -> bool:
        """Whether this PR's cached answer may be confirmed by a probe instead of read in full: a whole GraphQL read
        (no error, nothing partial) with its fingerprint, read in full within PR_FULL_EVERY (PR_FULL_BEHIND_EVERY while
        PR reads are behind, pr_behind), still open, and every
        failed or cancelled check's steps already read (fill_steps reads a few a cycle and only on a full read)."""
        c = e.get("cache") or {}
        data = c.get("data")
        # (an answer from an upstream keeps this host's old fp: never confirmed against it)
        return (isinstance(c.get("fp"), str) and c.get("via") in ("graphql", "graphql-probe") and not c.get("error")
                and c.get("source") != "upstream"
                and isinstance(data, dict) and not data.get("checksPageError") and data.get("state") == "OPEN"
                and isinstance(c.get("fullAt"), (int, float))
                and self.now - c["fullAt"] < (PR_FULL_BEHIND_EVERY if self.pr_behind(c) else PR_FULL_EVERY)
                and not any(wants_steps(ch) and "failedSteps" not in ch for ch in data.get("checks") or [])
                and not self.rollup_stale(e["key"], c))

    def pr_behind(self, cache: dict) -> bool:
        """Whether PR reads are behind, so probe_ok lets a probe stand in for a full read up to PR_FULL_BEHIND_EVERY:
        the last tick deferred a PR read, or this PR's own data is already older than PR_FULL_EVERY (a restarted
        daemon has no deferral to go by, and its first tick is the longest)."""
        memo = getattr(self, "pr_deferred_memo", None)
        if memo is None or memo[0] != self.now or memo[1] is not self.deferred_before:
            # once a tick: probe_ok asks for every due PR, and a backlog defers about as many
            memo = self.pr_deferred_memo = (self.now, self.deferred_before,
                                            any(k.startswith("pr:") for k in self.deferred_before))
        if memo[2]:
            return True
        at = cache.get("dataAt")
        return isinstance(at, (int, float)) and self.now - at >= PR_FULL_EVERY

    def rollup_wanted(self) -> frozenset[str]:
        """The PRs the land queue holds (not done): a full read of one keeps its rollup snapshot. Once per tick."""
        at, keys = self.rollup_keys
        if at == self.now:
            return keys
        q = self.land_queue
        if q is None:
            keys = frozenset()
        else:
            with q.lock:
                keys = frozenset(k for k, e in q.entries.items() if e.get("state") not in LAND_DONE)
        self.rollup_keys = (self.now, keys)
        if self.now - self.rollup_swept >= ROLLUP_SWEEP_EVERY:
            self.rollup_swept = self.now
            self.sweep_rollups(keys)
        return keys

    def sweep_rollups(self, keep: frozenset[str]) -> None:
        """Remove the snapshots (and the land queue's per-judgment copies) of PRs it no longer holds."""
        names = {file_name(k) for k in keep}
        for d in (BASE / ROLLUP_DIR, land_dir() / LAND_SNAPSHOT_DIR):
            with contextlib.suppress(OSError):
                for f in d.iterdir():
                    if f.name not in names and f.suffix == ".json":
                        with contextlib.suppress(OSError):
                            f.unlink()
        self.rollups = {k: v for k, v in self.rollups.items() if k in keep}

    def rollup_stale(self, key: str, cache: dict) -> bool:
        """KEY is a land PR whose rollup snapshot is missing, or is not at the head and fingerprint CACHE holds: its
        next read is a full one, which writes the snapshot (one read for the head, shared by every judgment)."""
        if key not in self.rollup_wanted():
            return False
        if key not in self.rollups:
            doc = read_rollup(key) or {}
            self.rollups[key] = (doc.get("head"), doc.get("fp"))
        head = ((cache or {}).get("data") or {}).get("headRefOid")
        return self.rollups[key] != (head, (cache or {}).get("fp"))

    def capture_rollup(self, key: str, node: dict, nulls: int) -> dict:
        """A PR NODE's rollup as land_judge's HEAD_REDS_QUERY reads it, before anything is folded in: the first page's
        context nodes, and every later page read here (page_pr_contexts under its own hourly share). complete is
        False when a page stopped short or GitHub answered a context null: land_judge then reads the head itself."""
        commit = (((node.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}
        rollup = commit.get("statusCheckRollup")
        if rollup is None:
            return {"rollup": None, "complete": "statusCheckRollup" in commit and not nulls}
        contexts = rollup.get("contexts") or {}
        nodes = [dict(c) for c in contexts.get("nodes") or [] if isinstance(c, dict)]
        page = dict(contexts.get("pageInfo") or {})
        complete = not nulls and isinstance(page.get("hasNextPage"), bool)
        sha = str(node.get("headRefOid") or "")
        if complete and page["hasNextPage"]:
            _, owner, repo, number = split_key(key)
            more = {"nodes": nodes, "pageInfo": page}
            complete = (re.fullmatch(r"[0-9a-fA-F]{40}", sha) is not None and self.page_pr_contexts(
                owner, repo, sha, int(number), more, nodes, {ROLLUP_ALL}, set()) is None)
        return {"rollup": {"nodes": nodes}, "complete": complete}

    def save_rollup(self, key: str, node: dict, captured: dict, fp: str | None) -> None:
        """Write KEY's rollup snapshot (ROLLUP_DIR) at NODE's head, with the fingerprint its cache entry now holds."""
        _, owner, repo, number = split_key(key)
        head = node.get("headRefOid")
        write_json(rollup_path(key), {"schema": ROLLUP_SCHEMA, "key": key, "repo": f"{owner}/{repo}",
                                      "number": int(number), "head": head, "fp": fp, "readAt": self.now, **captured})
        self.rollups[key] = (head, fp)

    def probe_prs(self, entries: list[dict]) -> tuple[list[dict], str | None]:
        """One PR_PROBE query for ENTRIES: those whose fingerprint matches their cache are confirmed (dataAt and
        fetchedAt move, the answer stays); the ones that changed, or that the probe could not read, come back to be read
        in full. (changed, None), or ([], the error) when the whole query failed."""
        query, variables = pr_query([e["key"] for e in entries], "probe")
        reason, self.gql_reason = self.gql_reason, "pr-probe"
        try:
            doc, error = self.graphql(query, variables)
        finally:
            self.gql_reason = reason
        if doc is None:
            return [], error or "graphql: no response"
        data = doc.get("data") or {}
        if not data and doc.get("errors"):
            return [], "graphql: " + str((doc["errors"][0] or {}).get("message"))[:200]
        failed = {str((err.get("path") or [""])[0]) for err in doc.get("errors") or [] if isinstance(err, dict)}
        changed = []
        for i, e in enumerate(entries):
            node = (data.get(f"p{i}") or {}).get("pullRequest")
            if f"p{i}" in failed or pr_fingerprint(node) != (e.get("cache") or {}).get("fp"):
                changed.append(e)
                continue
            self.reads.append((self.now, "pr", "graphql"))
            self.store(e["key"], e["cache"], dataAt=self.now, via="graphql-probe",
                       **confirmed_updated(e.get("cache"), node, self.now))
        return changed, None

    def fetch_comments(self, entries: list[dict]) -> str | None:
        return self.fetch_aliased(entries, "comment")

    def fetch_heads(self, entries: list[dict]) -> str | None:
        """Every check on each head commit, one aliased query for the batch (a head with more than 100
        contexts is followed page by page). None, or the error when the whole query failed."""
        self.reads += [(self.now, "head", "graphql")] * len(entries)
        doc, error = self.graphql(heads_query([e["key"] for e in entries]), {})
        if doc is None:
            self.fail(entries, error or "graphql: no response")
            for e in entries:
                self.refund(e["key"])
            return error or "graphql: no response"
        data = doc.get("data") or {}
        if not data and doc.get("errors"):
            message = "graphql: " + str((doc["errors"][0] or {}).get("message"))[:200]
            self.fail(entries, message)
            for e in entries:
                self.refund(e["key"])
            return message
        # Suites whose newest attempt ran nothing, in each head and its check-of-record commit: one read for the batch.
        attempts = {alias: ran_nothing_suites((data.get(alias) or {}).get("object"))
                    for i in range(len(entries)) for alias in (f"h{i}", f"m{i}")}
        suite_runs, suites_error = self.suite_runs(
            [s for found in attempts.values() if isinstance(found, list) for s in found], paced=False,
            route=heads_repos([e["key"] for e in entries]))
        for i, e in enumerate(entries):
            _, owner, repo, sha = split_key(e["key"])
            node = ((data.get(f"h{i}") or {}).get("object") or {}).get("statusCheckRollup")
            if not (data.get(f"h{i}") or {}).get("object"):
                self.store(e["key"], e["cache"], error="no such commit", missing=True)
                self.refund(e["key"])
                continue
            sources = [(owner, repo, (node or {}).get("contexts") or {})]
            if (owner, repo) in CHECKS_OF_RECORD:
                # An error on the check-of-record read is an error for the head, never a head without those checks:
                # a partial answer would read as a smaller, greener head.
                failed = [err for err in doc.get("errors") or [] if (err.get("path") or [None])[0] == f"m{i}"]
                if failed:
                    self.store(e["key"], e["cache"],
                               error="graphql: " + str(failed[0].get("message") or "check-of-record read failed")[:200])
                    self.refund(e["key"])
                    continue
                # A commit the fork does not have yet (sync-main pushes there within a minute) adds nothing, as does a
                # pull request head opened here, which the fork never gets.
                commit = (data.get(f"m{i}") or {}).get("object")
                record = (commit or {}).get("statusCheckRollup") or {}
                sources.append((*CHECKS_OF_RECORD[(owner, repo)], record.get("contexts") or {}))
            # Suites whose newest attempt ran nothing, in each source (the check-of-record one under its prefix).
            extra, extra_error = [], None
            objects = [("", f"h{i}")]
            if (owner, repo) in CHECKS_OF_RECORD:
                objects.append(("{}/{}: ".format(*CHECKS_OF_RECORD[(owner, repo)]), f"m{i}"))
            for prefix, obj in objects:
                nodes, extra_error = suites_contexts(attempts[obj], suite_runs, suites_error)
                if extra_error:
                    break
                extra.append((prefix, nodes))
            if extra_error:
                self.store(e["key"], e["cache"], error=extra_error)
                self.refund(e["key"])
                continue
            result = self.head_pages(sha, sources, extra)
            if (owner, repo) in CHECKS_OF_RECORD and commit and isinstance(result, dict) \
                    and not ((record.get("contexts") or {}).get("nodes")):
                # the fork has the commit but its checks have not started: not settled on this repository's alone
                result["settled"] = False
            if isinstance(result, str):
                self.store(e["key"], e["cache"], error=result)
                self.refund(e["key"])
                if self.mode("graphql") == "stop":
                    self.spill.append(e)  # a later page met the limit: REST reads it this tick
            else:
                self.store(e["key"], e["cache"], error=None, dataAt=self.now, data=result, restParts=None, via="graphql")
                self.head_answered(e["key"])

    def last_real_contexts(self, suites: list[str] | str) -> tuple[list[dict], str | None]:
        """Check-run context nodes (statusCheckRollup's shape, marked lastRealAttempt) for every attempt of SUITES,
        suites whose newest attempt ran nothing (ran_nothing_suites). ([], error) when they cannot all be read: a
        partial read would be a smaller, greener head."""
        if isinstance(suites, str):
            return [], suites
        runs, error = self.suite_runs(suites)
        return suites_contexts(suites, runs, error)

    def suite_runs(self, suites: list[str], paced: bool = True,
                   route: "list[str] | None" = None) -> tuple[dict[str, list[dict] | str], str | None]:
        """Suite id -> its check-run context nodes over every attempt (statusCheckRollup's shape, marked
        lastRealAttempt), or the error that suite alone could not be read with (held by the pace, no response, a
        nested error), SUITE_RUNS_BATCH suites per query. The second value is always None, kept for the callers.

        Paced like every other query (glaeda#1844 F2): past graphqlPerMinute it reads nothing, and unread is partial,
        never green; the next cycle reads it. A batch's own follow-up (PACED false) is never held: it is part of the
        read the ceiling already admitted, and holding a later chunk starved the PRs whose suites sort last, which the
        next cycle held the same way (router-review BLOCK on glaeda#1916 at 73069ea7). It is bounded by the batch: at
        most GQL_BATCH PRs (or heads and their check-of-record commits) of at most 100 suites, so 2 * GQL_BATCH queries
        of one point each, and far fewer in practice (a cmux head has about 15 such suites)."""
        suites = list(dict.fromkeys(suites))
        out: dict[str, list[dict] | str] = {}
        # Every failure is the error of the suites it left unread only (router-review BLOCKs on glaeda#1916 at
        # a01313fc and af5363f6): the batch holds many PRs' suites, and what was read stays read.
        for start in range(0, len(suites), SUITE_RUNS_BATCH):
            chunk = suites[start:start + SUITE_RUNS_BATCH]
            if paced and not self.app_answers(SUITE_RUNS, {"suites": chunk}, route) and not self.gql_room():
                for suite_id in suites[start:]:
                    out[suite_id] = "graphql: last real attempt: held by graphqlPerMinute; read next cycle"
                break
            reason, self.gql_reason = self.gql_reason, "last-real-attempt"
            try:
                doc, error = self.graphql(SUITE_RUNS, {"suites": chunk}, route)
            finally:
                self.gql_reason = reason
            if doc is None:
                for suite_id in suites[start:]:
                    out[suite_id] = error or "graphql: no response"
                break
            found = (doc.get("data") or {}).get("suiteRuns")
            errors = [e for e in doc.get("errors") or [] if isinstance(e, dict)]
            message = "graphql: last real attempt: " + str(
                (errors[0] if errors else {}).get("message") or "a suite could not be read")[:200]
            # a nested error names its suite by path (["suiteRuns", i, ...]); one with no such path names them all
            hit: set[int] = set()
            for e in errors:
                path = e.get("path")
                if isinstance(path, list) and len(path) > 1 and path[0] == "suiteRuns" and type(path[1]) is int:
                    hit.add(path[1])
                else:
                    hit.update(range(len(chunk)))
            if not isinstance(found, list) or len(found) != len(chunk):
                found = [None] * len(chunk)
            for n, (suite_id, suite) in enumerate(zip(chunk, found)):
                runs = suite.get("checkRuns") if isinstance(suite, dict) else None
                nodes = runs.get("nodes") if isinstance(runs, dict) else None
                if n in hit or not isinstance(nodes, list) or not all(isinstance(r, dict) for r in nodes):
                    out[suite_id] = message  # a null field beside an error is no empty suite: never greener
                    continue
                if (runs.get("pageInfo") or {}).get("hasNextPage"):
                    out[suite_id] = "graphql: last real attempt: more than 100 check runs in one suite"
                    continue
                context = {"conclusion": suite.get("conclusion"), "app": suite.get("app"),
                           "workflowRun": suite.get("workflowRun")}
                out[suite_id] = [{"__typename": "CheckRun", **run, "checkSuite": context, "lastRealAttempt": True}
                                 for run in nodes]
        return out, None

    def head_pages(self, sha: str, sources: list[tuple[str, str, dict]],
                   extra: list[tuple[str, list[dict]]] = ()) -> dict | str:
        """A head's data from the first page of its contexts in each repository of `sources` ((owner, repo,
        contexts): the head's own, then its CHECKS_OF_RECORD repository's), following the rest page by page; an
        error message when a later page cannot be read (the head keeps its older answer)."""
        runs: dict = {}
        statuses: dict = {}
        ids: dict = {}
        order: dict = {}  # head_data's `runs`
        failed: dict = {}  # failed check run databaseId -> node id (head_steps)
        for n, (owner, repo, contexts) in enumerate(sources):
            prefix = f"{owner}/{repo}: " if n else ""  # the head's own checks keep their names
            for _ in range(HEAD_BATCH_MAX_CONTEXTS_PAGES):
                fold_contexts(contexts.get("nodes"), runs, statuses, ids, prefix, order, failed)
                page = contexts.get("pageInfo") or {}
                if not page.get("hasNextPage"):
                    break
                reason, self.gql_reason = self.gql_reason, "head-pages"
                try:
                    more, error = self.graphql("query{" + head_query(owner, repo, sha, page.get("endCursor")) + "}", {})
                finally:
                    self.gql_reason = reason
                if more is None:
                    return error or "graphql: no response"
                rollup = ((((more.get("data") or {}).get("repository") or {}).get("object") or {}).get("statusCheckRollup"))
                if more.get("errors") or not rollup:  # a partial page would read as a smaller, greener head
                    return "graphql: " + str(((more.get("errors") or [{}])[0] or {}).get("message") or "no further page")[:200]
                contexts = rollup.get("contexts") or {}
            else:
                return f"more than {HEAD_BATCH_MAX_CONTEXTS_PAGES * 100} checks on one commit"
        for prefix, nodes in extra:  # suites whose newest attempt ran nothing (last_real_contexts), per source
            fold_contexts(nodes, runs, statuses, ids, prefix, order, failed)
        data = head_data(sha, runs, statuses, ids, order)
        self.head_steps(data, failed, route=[f"{owner}/{repo}" for owner, repo, _ in sources])
        return data

    def head_steps(self, data: dict, failed: dict[int, str], root: str | None = None,
                   route: "list[str] | None" = None) -> None:
        """Store the step count of each failed check run of a head's `data` (attach_steps), so a reader of the store
        judges a red as a live read does (a failed job that ran no step is the runner's refusal, not a red). A
        completed job never changes: each is read once (self.job_steps), in GraphQL by node id (STEPS_QUERY) or, with
        ROOT (`/repos/OWNER/REPO`, a head read over REST), one job at a time within REST_STEPS_MAX. A read that fails
        or is out of time leaves its rows without `steps` (unknown), and the next read of the head tries again."""
        if len(self.job_steps) > 20000:
            self.job_steps.clear()
        want = [i for i in failed if i not in self.job_steps]
        if root is None:
            want = want[:2 * STEPS_BATCH]
            for n in range(0, len(want), STEPS_BATCH):
                if self.mode("graphql") == "stop":
                    break
                chunk = {failed[i]: i for i in want[n:n + STEPS_BATCH]}
                reason, self.gql_reason = self.gql_reason, "steps"
                try:
                    doc, error = self.graphql(STEPS_QUERY, {"ids": list(chunk)}, route)
                except OutOfTime:
                    break
                finally:
                    self.gql_reason = reason
                if doc is None:
                    self.errors.append(f"head steps: {error}")
                    break
                for node in (doc.get("data") or {}).get("nodes") or []:
                    steps = (node.get("steps") or {}).get("nodes") if isinstance(node, dict) else None
                    if isinstance(steps, list) and node.get("id") in chunk:  # null is unknown, never "no step ran"
                        self.job_steps[chunk[node["id"]]] = len(steps)
        else:
            for job_id in want[:REST_STEPS_MAX]:
                if self.mode("rest") == "stop" or not self.rest_room(1):
                    break
                try:
                    state, doc, _ = self.get(f"{root}/actions/jobs/{job_id}", None)
                except OutOfTime:
                    break
                if state == "fresh" and isinstance(doc, dict) and isinstance(doc.get("steps"), list):
                    self.job_steps[job_id] = len(doc["steps"])
        attach_steps(data, self.job_steps)

    def fill_steps(self, pairs: list[tuple[dict, dict]]) -> None:
        """Name the failed steps of each failed check run. A completed check does not change, so a
        check whose steps an earlier fetch read keeps them and costs nothing; the rest share one
        small query. When that query fails the checks go without, and the next cycle tries again."""
        known = known_steps(pairs)
        want: dict[str, list[dict]] = {}
        owners: dict[str, set[str]] = {}  # check id -> the keys of the PRs that show it
        for e, data in pairs:
            for c in data.get("checks") or []:
                if not wants_steps(c):
                    continue
                if c["id"] in known:
                    c["failedSteps"], c["stepCount"] = known[c["id"]]
                elif not settled_pr(data):  # a settled PR keeps what is cached; nothing new is read for it
                    want.setdefault(c["id"], []).append(c)
                    owners.setdefault(c["id"], set()).add(e["key"])
        ids = list(want)[:2 * STEPS_BATCH]  # the rest wait a cycle (failed and cancelled checks; each is read once)
        for i in range(0, len(ids), STEPS_BATCH):
            if self.mode("graphql") == "stop":
                return
            try:
                reason, self.gql_reason = self.gql_reason, "steps"
                try:
                    # the repositories of the PRs that show these checks: one owner's App answers it (owner_of)
                    route = sorted({"/".join(split_key(k)[1:3]) for c in ids[i:i + STEPS_BATCH] for k in owners[c]})
                    doc, error = self.graphql(STEPS_QUERY, {"ids": ids[i:i + STEPS_BATCH]}, route)
                finally:
                    self.gql_reason = reason
            except OutOfTime:  # the checks go without their steps; their PRs go first next tick
                for check_id in ids[i:]:
                    self.deferred.update(owners[check_id])
                return
            if doc is None:
                self.errors.append(f"steps: {error}")
                return
            for node in (doc.get("data") or {}).get("nodes") or []:
                if isinstance(node, dict) and node.get("id") in want:
                    steps = (node.get("steps") or {}).get("nodes")
                    names = failed_steps(steps)
                    for c in want[node["id"]]:
                        # steps null (a partial error) is unknown, never "no step ran"
                        c["failedSteps"], c["stepCount"] = names, len(steps) if isinstance(steps, list) else None

    def get(self, path: str, etag: str | None) -> tuple[str, Any, str | None]:
        """("fresh", doc, etag), ("same", None, etag) on 304, or ("error", message, None)."""
        try:
            status, h, doc = self.request("GET", path, etag=etag)
        except (WatchError, OSError) as error:
            return "error", f"rest: {describe(error)}", None
        if status == 304:
            return "same", None, etag
        if status == 200 and isinstance(doc, (dict, list)):  # .../rules/branches/B answers a list
            return "fresh", doc, h.get("etag")
        message = (doc or {}).get("message", "") if isinstance(doc, dict) else ""
        return "error", f"HTTP {status} {message}".strip()[:200], None

    def fetch_run(self, e: dict) -> None:
        _, owner, repo, run_id = split_key(e["key"])
        prior = e["cache"] or {}
        self.reads.append((self.now, "run", "rest"))
        if self.controller_missed_deadline and self.now < self.controller_down_until:
            self.note_controller_fallback("restRuns")  # a read the controller would have served for free
        base = f"/repos/{owner}/{repo}/actions/runs/{run_id}"
        # a confirmation asks without the ETag: a 304 would prove only what the ETag's own read showed, which the
        # controller's newer record replaced (and a cache from before restRun has nothing to prove it with)
        unconfirmed = controller_unconfirmed(prior, self.now)
        state, doc, etag = self.get(base, prior.get("etag") if prior.get("data") and not unconfirmed else None)
        if state == "error":
            self.errors.append(f"{e['key']}: {doc}")
            # a 404 for a run no read ever showed: it does not exist (or is not visible), wait_step's not-found
            return self.store(e["key"], e["cache"], error=doc,
                              missing=not prior.get("data") and str(doc).startswith("HTTP 404"))
        # restAt: the last direct read from GitHub, over either bucket (the controller's safety-net clock)
        fields: dict[str, Any] = {"error": None, "etag": etag, "dataAt": self.now, "restAt": self.now, "via": "rest"}
        if state == "fresh":
            fields["data"] = slim_run(doc)
            fields["restRun"] = rest_run(fields["data"])
            fields["restRunAt"] = self.now
            # a run the controller tracks keeps that source; REST was only the safety-net check
            if prior.get("source") != "controller" or \
                    (iso_epoch(doc.get("updated_at")) or 0) > (iso_epoch((prior.get("data") or {}).get("updated_at")) or 0):
                fields["source"] = "rest"
        elif prior.get("restRun") is not None:
            fields["restRunAt"] = self.now  # a 304: what the ETag's read showed is still GitHub's
        self.read_jobs(e, fields, state == "fresh")

    def gql_blind(self, e: dict) -> bool:
        return self.now - float((e["cache"] or {}).get("gqlBlindAt") or float("-inf")) < GQL_BLIND_TTL

    def gql_blind_read(self, e: dict, stamp: bool) -> bool:
        """Read a run GraphQL cannot resolve over REST, which is authoritative for it: data on a 200, missing on a
        404 for a run never shown, an error otherwise. `stamp` (a fresh GraphQL null) starts GQL_BLIND_TTL (gqlBlindAt),
        so the next cycles go straight to REST; a read inside the window leaves the stamp, so the window ends.
        False when REST has no room: the caller stores GraphQL's own answer, or reads it over GraphQL."""
        if self.mode("rest") == "stop" or not self.rest_room(REST_READ_MAX["run"]):
            return False
        try:
            with self.calling(*caller_of(e["key"]), waiter_of(e)):
                self.fetch_run(e)
        except OutOfTime:  # nothing was read: nothing is stored, and the run goes first next tick
            self.deferred.add(e["key"])
            return True
        if stamp:
            read = read_cache(e["key"]) or {}
            self.store(e["key"], read or e["cache"], gqlBlindAt=self.now, error=read.get("error"),
                       missing=read.get("missing"))
        return True

    def fetch_runs_graphql(self, entries: list[dict]) -> str | None:
        """Runs over GraphQL, for when REST is the poorer bucket: one aliased query by run URL. A run
        GraphQL cannot resolve is an error, as REST's 404 is; it is also missing (wait_step's not-found) when no
        read ever showed it: a run that exists has data from its first read."""
        # A run GraphQL went blind to (resource() null for it: a private repo the GraphQL token has no installation on)
        # is read over REST at once, without a query that cannot answer, until GQL_BLIND_TTL passes.
        blind = [e for e in entries if self.gql_blind(e) and self.gql_blind_read(e, False)]
        entries = [e for e in entries if e not in blind]  # (REST without room leaves a run to GraphQL's own answer)
        if not entries:
            return None
        query, variables = run_query([e["key"] for e in entries])
        self.reads += [(self.now, "run", "graphql")] * len(entries)
        doc, error = self.graphql(query, variables)
        if doc is None:
            self.fail(entries, error or "graphql: no response")
            return error or "graphql: no response"
        data = doc.get("data") or {}
        problems = {str((err.get("path") or [""])[0]): err for err in doc.get("errors") or [] if isinstance(err, dict)}
        if not data and problems:  # the whole query failed (a schema change, say): say what GitHub said
            message = "graphql: " + str(next(iter(problems.values())).get("message"))[:200]
            self.fail(entries, message)
            return message
        for i, e in enumerate(entries):
            node = data.get(f"w{i}")
            if not isinstance(node, dict) or node.get("__typename") != "WorkflowRun":
                message = "graphql: " + str((problems.get(f"w{i}") or {}).get("message") or "no workflow run at this URL")[:200]
                problem = problems.get(f"w{i}") or {}
                # null with no problem of its own, or NOT_FOUND: GraphQL cannot see it (a timeout or a 5xx says nothing)
                if (not problem or problem.get("type") == "NOT_FOUND") \
                        and not any(p.get("type") in ("RATE_LIMITED", "FORBIDDEN") for p in problems.values()) \
                        and self.gql_blind_read(e, True):
                    continue  # REST answered for it (a run the GraphQL token cannot see, or does not exist)
                self.errors.append(f"{e['key']}: {message}")
                self.store(e["key"], e["cache"], error=message,
                           missing=not (e["cache"] or {}).get("data")
                           and (problem.get("type") == "NOT_FOUND" or not problems))
                continue
            prior = e["cache"] or {}
            before = prior.get("data") or {}
            run = graphql_run(node)
            run["head_branch"] = run["head_branch"] or before.get("head_branch") or ""
            fresh = any(run.get(k) != before.get(k) for k in ("status", "conclusion", "run_attempt", "updated_at"))
            fields: dict[str, Any] = {"error": None, "data": run, "dataAt": self.now, "restAt": self.now,
                                      "restRun": rest_run(run), "restRunAt": self.now, "via": "graphql"}
            if prior.get("source") != "controller" or \
                    (iso_epoch(run.get("updated_at")) or 0) > (iso_epoch(before.get("updated_at")) or 0):
                fields["source"] = "graphql"
            self.read_jobs(e, fields, fresh)

    def jobs_spaced(self, e: dict, run: dict, attempt: int) -> bool:
        """Whether a `--jobs` watch of a run still in progress keeps its job list this cycle instead of reading it
        (RUN_JOBS_RUNNING_EVERY): only a watch a wait keeps live, whose last interest was that wait (a touch at its
        waitedAt) or came before the kept list, and whose kept list is this attempt's and younger than the spacing.
        A one-off `--jobs` look (a `status`, a downstream's read) asked since the list was read is never spaced, so it
        gets a list read after its ask (F2, once_answered); nor is a new wait started since; nor a completed run."""
        if run.get("status") == "completed" or not self.waited(e):
            return False
        prior = e["cache"] or {}
        jobs, jobs_at = prior.get("jobs"), prior.get("jobsAt")
        if not isinstance(jobs, list) or not jobs or jobs_attempt(jobs) != attempt \
                or not isinstance(jobs_at, (int, float)) or isinstance(jobs_at, bool) \
                or not 0 <= self.now - jobs_at < RUN_JOBS_RUNNING_EVERY:
            return False
        touched, waited_at, began = e.get("touched"), e.get("waitedAt"), e.get("waitBegan")
        if isinstance(began, (int, float)) and began > jobs_at:
            return False  # a wait that began after the kept list: its first look reads one
        if isinstance(touched, (int, float)) and touched > jobs_at:
            # interest since the kept list: a wait's own touch (at its waitedAt) is not an ask for a new list
            return isinstance(waited_at, (int, float)) and touched <= waited_at + ONCE_SLACK
        return True

    def read_jobs(self, e: dict, fields: dict[str, Any], fresh: bool) -> None:
        """Store a run read, with its job list when wanted. Job lists come from REST on either path:
        only REST names the runner and its labels, which tell a runner's refusal from a failure."""
        _, owner, repo, run_id = split_key(e["key"])
        prior = e["cache"] or {}
        base = f"/repos/{owner}/{repo}/actions/runs/{run_id}"
        run = fields.get("data") or prior.get("data") or {}
        # A failed attempt's job list names the failed steps, and tells a runner's refusal from a real
        # failure. It is read once per attempt, lean or not: callers would otherwise each read it. That
        # is also why it is the one read the REST share does not hold back: a wait cannot rule on a
        # failed run without it, and one request per failed attempt is what keeps every waiter off gh.
        attempt = run.get("run_attempt") or 1
        failed_attempt = (run.get("status") == "completed" and run.get("conclusion") not in RUN_OK
                          and self.mode("rest") != "stop"
                          and (fresh or jobs_attempt(prior.get("jobs")) < attempt)
                          # past the REST share, once per attempt, answered or not: an error or an empty
                          # list would otherwise be asked for again every cycle, past the share
                          and (self.rest_room(1) or prior.get("jobsTried") != attempt))
        # A completed attempt's list, read once already (here, or kept on disk by any watch of the run before): no
        # request, in any mode. A re-run is a new attempt, which this run read shows, so it misses and is read.
        if (e["jobs"] or failed_attempt) and run.get("status") == "completed":
            kept = prior.get("jobs") if prior.get("jobsDone") == attempt and isinstance(prior.get("jobs"), list) \
                else attempt_jobs_get(f"{owner}/{repo}", int(run_id), attempt)
            if kept is not None and attempt_jobs_done(run, kept) == attempt:
                fields.update(jobs=kept, jobsAt=self.now, jobsDone=attempt)
                if kept is not prior.get("jobs"):
                    fields["jobsEtag"] = None  # the kept ETag was another list's: a 304 on it must not keep this one
                if failed_attempt:
                    fields["jobsTried"] = attempt
                self.sent.append((self.now, "kept"))  # a job list answered with no request (budget: hour.kept)
                self.store(e["key"], e["cache"], **fields)
                return
        if e["jobs"] and not failed_attempt and self.jobs_spaced(e, run, attempt):
            self.sent.append((self.now, "kept"))  # served from the kept list (budget: hour.kept)
            self.store(e["key"], e["cache"], **fields)
            return
        if (e["jobs"] and self.mode("rest") == "normal") or failed_attempt:
            try:
                with self.calling(*caller_of(e["key"]), waiter_of(e)):  # its own waiter, inside a batch's call too
                    jstate, jdoc, jetag = self.get(base + "/jobs?per_page=100",
                                                   prior.get("jobsEtag") if "jobs" in prior else None)
            except OutOfTime:  # the run itself is read: store it, and its jobs wait for a later read
                jstate, jdoc, jetag = "late", None, None
            if failed_attempt and jstate != "late":  # sent: a tick out of time sent nothing, so it is not tried
                fields["jobsTried"] = attempt  # in the cache entry, so a restart or a new watch remembers it
            if jstate == "fresh":
                fields.update(jobs=slim_jobs(jdoc), jobsEtag=jetag, jobsAt=self.now)
            elif jstate == "same":
                fields["jobsAt"] = self.now
            elif jstate == "late":
                self.deferred.add(e["key"])
            else:
                self.errors.append(f"{e['key']} jobs: {jdoc}")
            if jstate in ("fresh", "same"):
                done = attempt_jobs_done(run, fields["jobs"] if jstate == "fresh" else prior.get("jobs"))
                if done is not None:  # final: the next read of this attempt sends nothing (above)
                    fields["jobsDone"] = done
                    if prior.get("jobsDone") != done:
                        attempt_jobs_put(f"{owner}/{repo}", int(run_id), done,
                                         fields["jobs"] if jstate == "fresh" else prior["jobs"])
        self.store(e["key"], e["cache"], **fields)

    def rest_part(self, old: dict, new: dict, path: str, slim: Callable[[Any], Any], absent: Any = None) -> Any:
        """A conditional GET whose slimmed answer is kept with its ETag: an unchanged resource answers
        304, which costs nothing, and its kept answer is reused. Raises WatchError on an error, except
        a 404 when `absent` is given: then the last answer stands, or `absent` without one. A 403 saying
        the repository's plan lacks the feature (NO_FEATURE) is `absent` too, and says so in `new`."""
        kept = old.get(path) or {}
        if absent is not None and kept.get("unavailable"):
            new[path] = kept  # not asked again until a GraphQL read drops the kept answers
            return absent
        state, doc, etag = self.get(path, kept.get("etag") if "doc" in kept else None)
        if state == "error" and absent is not None and NO_FEATURE.search(str(doc)):
            new[path] = {"doc": absent, "unavailable": True}
            return absent
        if state == "error" and absent is not None and str(doc).startswith("HTTP 404"):
            new[path] = {"doc": kept["doc"], "gone": True} if "doc" in kept else {"doc": absent, "gone": True}
            return new[path]["doc"]
        if state == "error":
            raise WatchError(doc)
        new[path] = kept if state == "same" else {"etag": etag, "doc": slim(doc)}
        return new[path]["doc"]

    def repo_part(self, old: dict, new: dict, path: str, slim: Callable[[Any], Any], absent: Any = None,
                  ttl: float = REST_REPO_PART_TTL) -> Any:
        """rest_part for a path every watch that needs it reads alike (a repository- or base-level path every PR on
        it reads, or a commit's, a pull's or a run's job list, REST_HEAD_PART_TTL): one answer serves every read for
        TTL, then one conditional read (with the newest ETag known) refreshes it for all. A per-PR `unavailable`
        stands as in rest_part; a 404 (a deleted base) is shared as the fact, and each PR keeps its own last answer,
        as rest_part does. An error is never shared."""
        kept = old.get(path) or {}
        if absent is not None and kept.get("unavailable"):
            new[path] = kept
            return absent
        shared = self.repo_parts.get(path)
        # (a resumed read, RESUME_MAX, keeps what its cut attempts got: shared["at"] is never older than resume_from)
        if shared is None or (self.now - shared["at"] >= ttl and shared["at"] < self.resume_from):
            lent = (shared or {}).get("part") or {}
            seed = {path: lent} if lent.get("etag") and "doc" in lent else old
            scratch: dict = {}
            self.rest_part(seed, scratch, path, slim, absent)  # raises on an error: nothing is shared
            shared = self.repo_parts[path] = {"at": self.now, "part": scratch[path]}
            self.forget_parts()
        part = shared["part"]
        if part.get("gone"):
            new[path] = {"doc": kept["doc"], "gone": True} if "doc" in kept else {"doc": absent, "gone": True}
        else:
            new[path] = part
        return new[path]["doc"]

    def forget_parts(self) -> None:
        """Drop shared answers past REST_REPO_PART_KEEP, then the oldest past REST_SHARED_MAX."""
        for stale in [p for p, v in self.repo_parts.items() if self.now - v["at"] >= REST_REPO_PART_KEEP]:
            del self.repo_parts[stale]
        over = len(self.repo_parts) - REST_SHARED_MAX
        if over > 0:  # oldest first; this tick's answers last, so the one just stored is never the one dropped
            for stale in sorted(self.repo_parts, key=lambda p: (self.repo_parts[p]["at"] >= self.now,
                                                                self.repo_parts[p]["at"]))[:over]:
                del self.repo_parts[stale]

    def head_part(self, old: dict, new: dict, path: str, slim: Callable[[Any], Any]) -> Any:
        """A commit's, a pull's or a run's job-list read, shared by every watch on it (repo_part, REST_HEAD_PART_TTL)."""
        return self.repo_part(old, new, path, slim, None, REST_HEAD_PART_TTL)

    def fetch_pr_rest(self, e: dict) -> None:
        """One PR over REST, for when GraphQL is the poorer bucket: the pull, its head's check runs,
        statuses and workflow runs (for superseded runs), the repo's workflow names, and the base
        branch's required checks from its rulesets and classic protection. Every read is conditional,
        so a quiet PR costs nothing; the last three are shared by every PR on the repository and base
        (repo_part). A failed read keeps the cached data and says why."""
        _, owner, repo, number = split_key(e["key"])
        prior = e["cache"] or {}
        self.reads.append((self.now, "pr", "rest"))
        root = f"/repos/{owner}/{repo}"
        old, parts = prior.get("restParts") or {}, {}
        if self.rest_gate_holds(e, prior, old, root, number):
            return None
        try:
            pull, reused = self.rest_pull(old, parts, root, number)
            sha = (pull.get("head") or {}).get("sha") or ""
            was = prior.get("data") if isinstance(prior.get("data"), dict) else {}
            # settled: the same head with every check completed, which the gate never takes (a FAILURE head still
            # running is not settled; review F1)
            settled_head = (was.get("headRefOid") == sha and bool(was.get("checks"))
                            and all(str(c.get("status") or "").upper() == "COMPLETED" for c in was.get("checks") or []))
            if sha and (not settled_head or was.get("checkState") == "FAILURE"):
                # the gate's baseline, read before the check runs so a suite finishing meanwhile reads as a change
                # (a settled failed head's too: PR_REST_SETTLED_FULL_EVERY gates it on its suites)
                with contextlib.suppress(WatchError):
                    self.head_part(old, parts, suites_path(root, sha), slim_check_suites)
            checks, statuses, runs, workflows = self.rest_head(old, parts, root, sha)
            if reused and not head_pending(checks, statuses) and head_moved(old, parts, f"{root}/commits/{sha}/"):
                # every check finished, and something changed since the kept pull: the merge state is final now
                pull, _ = self.rest_pull(old, parts, root, number, reuse=False)
                if ((pull.get("head") or {}).get("sha") or "") != sha:  # (a push the issue had not shown yet)
                    sha = (pull.get("head") or {}).get("sha") or ""
                    checks, statuses, runs, workflows = self.rest_head(old, parts, root, sha)
            base = urllib.parse.quote(str((pull.get("base") or {}).get("ref") or ""), safe="/")
            listed = checks["check_runs"]
            # a deleted base (a stacked PR's, after its merge) has no requirements left to read
            rules, protection = f"{root}/rules/branches/{base}?per_page=100", f"{root}/branches/{base}"
            required = set(self.repo_part(old, parts, rules, slim_rules, []))
            if not self.reads_protection:
                # The base's classic protection is not read here (reads_protection): the checks GraphQL last
                # called required stay required, beside the rulesets' read now.
                required |= prior_required(prior)
            else:
                required |= set(self.repo_part(old, parts, protection, slim_branch, []))
            if self.reads_protection and parts[rules].get("unavailable") and parts[protection].get("unavailable"):
                # A private repository on a plan without either feature: GitHub enforces no required check there,
                # so none is the true answer. GraphQL's last word is kept all the same (it can name a rule that
                # predates a plan change); a first read with no GraphQL answer has none, and none is enforced.
                required = prior_required(prior)
        except WatchError as error:
            message = f"rest: {error}"
            self.errors.append(f"{e['key']}: {message}")
            # only GitHub answering 404 for the pull itself means it does not exist (or is not visible)
            return self.store(e["key"], e["cache"], error=message[:200],
                              missing=not parts and str(error).startswith("HTTP 404"))
        review = (prior.get("data") or {}).get("reviewDecision")  # REST has none: keep GraphQL's last
        data = parse_pr(rest_pr_node(pull, checks, statuses, runs, required, review, workflows))
        self.fill_steps_rest(e, data, root, {c.get("node_id"): c.get("id") for c in listed})
        self.store(e["key"], e["cache"], dataAt=self.now, data=data, restParts=parts, via="rest",
                   restFullAt=min(self.now, self.resume_from))

    def rest_gate_holds(self, e: dict, prior: dict, old: dict, root: str, number: Any) -> bool:
        """The REST PR read's gate (PR_REST_FULL_EVERY): True when the issue, the head's check suites and its first
        status page show nothing changed since the last full read, which then stands, stored as read now. False sends
        the read on in full: no full read within PR_REST_FULL_EVERY, a settled, closed or GraphQL-read entry, `--jobs`,
        a head with no suite or more than one page of them, a changed suite or status, a closed issue, or an issue that
        changed while the kept pull is past PULL_REUSE_MAX. Raises OutOfTime."""
        if not self.rest_gate_due(e, prior):
            return False
        sha = str(prior["data"]["headRefOid"])
        issue_path, pull_path = f"{root}/issues/{number}", f"{root}/pulls/{number}"
        gate_paths = (suites_path(root, sha), f"{root}/commits/{sha}/status?per_page=100&page=1")
        kept = {p: old.get(p) for p in (issue_path, pull_path) + gate_paths}
        if any(not isinstance(k, dict) or "doc" not in k for k in kept.values()):
            return False
        total = (kept[gate_paths[0]]["doc"] or {}).get("total")
        if not isinstance(total, int) or not 0 < total <= PR_REST_SUITE_PAGE:
            return False
        probe: dict = {}
        try:
            issue = self.head_part(old, probe, issue_path, slim_issue_gate)
            if str((issue or {}).get("state") or "").lower() != "open":
                return False
            if probe[issue_path].get("etag") != kept[issue_path].get("etag"):
                pulled = kept[pull_path].get("at")
                if not isinstance(pulled, (int, float)) or self.now - pulled >= PULL_REUSE_MAX:
                    return False
                # The issue moved (a comment, usually): the kept pull stands until PULL_REUSE_MAX, and the issue's
                # old answer is kept so the next full read still sees the change and reads the pull.
                probe[issue_path] = kept[issue_path]
            for path, slim in zip(gate_paths, (slim_check_suites, slim_status_page)):
                if self.head_part(old, probe, path, slim) != kept[path]["doc"]:
                    return False
        except WatchError:
            return False  # the full read says what failed
        self.store(e["key"], e["cache"], error=None, dataAt=self.now, restParts={**old, **probe}, via="rest")
        return True

    def rest_gate_due(self, e: dict, prior: dict) -> bool:
        """Whether E's REST PR read goes to its gate (rest_gate_holds) rather than straight to a full read: an open,
        REST-read entry with a running PENDING or FAILURE head read in full within PR_REST_FULL_EVERY, or a settled
        failed head within PR_REST_SETTLED_FULL_EVERY. No request."""
        data = prior.get("data") if isinstance(prior.get("data"), dict) else None
        full = prior.get("restFullAt")
        if (data is None or e.get("jobs") or prior.get("via") != "rest" or prior.get("error")
                or not isinstance(full, (int, float)) or isinstance(full, bool)
                or str(data.get("state") or "").upper() != "OPEN" or not data.get("headRefOid")
                or self.mode("rest") == "stop"):
            return False
        checks = data.get("checks") or []
        running = any(str(c.get("status") or "").upper() != "COMPLETED" for c in checks)
        if running and data.get("checkState") in ("PENDING", "FAILURE"):
            bound = PR_REST_FULL_EVERY
        elif checks and not running and data.get("checkState") == "FAILURE":
            bound = PR_REST_SETTLED_FULL_EVERY  # a settled failed head
        else:
            return False
        return self.now - full < bound

    def prefetch_paths(self, e: dict) -> list[tuple[str, str]]:
        """(path, ETag) of the conditional GETs E's REST PR read will most likely send, as it will send them: its
        gate's three when the gate is due (rest_gate_due), else every path its last read kept; with the ETag repo_part
        will seed (a shared answer's, else the kept one's). None a shared answer still serves (no request), none
        unconditional (a first read: an unasked answer would cost), none an `unavailable` or `gone` part. No request."""
        if not e["key"].startswith("pr:"):
            return []
        prior = e.get("cache") or {}
        old = prior.get("restParts") or {}
        data = prior.get("data") if isinstance(prior.get("data"), dict) else None
        if not isinstance(old, dict) or not old or data is None or prior.get("via") != "rest" or e.get("jobs"):
            return []
        _, owner, repo, number = split_key(e["key"])
        root = f"/repos/{owner}/{repo}"
        if self.rest_gate_due(e, prior):
            sha = str(data["headRefOid"])
            paths = [f"{root}/issues/{number}", suites_path(root, sha), f"{root}/commits/{sha}/status?per_page=100&page=1"]
        else:
            paths = list(old)
            pull = old.get(f"{root}/pulls/{number}")
            at = pull.get("at") if isinstance(pull, dict) else None
            # rest_pull asks the issue first while the kept pull may stand (and the pull only when the issue moved),
            # else the pull, and the issue only when the PR changed since: the likelier one goes early
            reusable = (self.etags and isinstance(at, (int, float)) and self.now - at < PULL_REUSE_MAX
                        and bool((old.get(f"{root}/issues/{number}") or {}).get("etag")))
            unlikely = f"{root}/pulls/{number}" if reusable else f"{root}/issues/{number}"
            paths = [path for path in paths if path != unlikely]
        out = []
        for path in paths:
            kept = old.get(path) if isinstance(old.get(path), dict) else {}
            if kept.get("unavailable") or kept.get("gone"):
                continue
            shared = self.repo_parts.get(path)
            repo_level = path.startswith((f"{root}/actions/workflows", f"{root}/rules/branches/", f"{root}/branches/"))
            if shared is not None and self.now - shared["at"] < (REST_REPO_PART_TTL if repo_level else REST_HEAD_PART_TTL):
                continue
            lent = (shared or {}).get("part") or {}
            seed = lent if lent.get("etag") and "doc" in lent else kept
            if seed.get("etag") and "doc" in seed:
                out.append((path, str(seed["etag"])))
        return out

    def read_headers(self, token: str, etag: str | None, json_body: bool = False) -> dict[str, str]:
        headers = {"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
                   "User-Agent": "glaeda-gh", "X-GitHub-Api-Version": "2022-11-28"}
        if etag:
            headers["If-None-Match"] = etag
        if json_body:
            headers["Content-Type"] = "application/json"
        return headers

    def prefetch_rest(self, upcoming: list[dict]) -> None:
        """Send early, on the prefetch pool, the conditional GETs the UPCOMING REST reads will send (prefetch_paths;
        REST_PREFETCH_*), each with the credential request() will pick for it (the App's for an owner it serves, else
        the login's). A login request goes only as request() would send it: no secondary hold, REST not stopped, room
        in the REST share and the per-minute cap for it and for every login request already held. Never raises."""
        if self.prefetch_workers <= 0 or self.upstream() is not None or self.writing:
            return
        try:
            held_login = sum(1 for h in self.prefetched.values() if h["login"])
            login_ok = None  # decided at the first login request
            for e in upcoming:
                for path, etag in self.prefetch_paths(e):
                    if len(self.prefetched) >= REST_PREFETCH_HELD or time.monotonic() >= self.tick_deadline:
                        return
                    key = ("GET", path, etag)
                    if key in self.prefetched:
                        continue
                    pool = self.app_pool
                    owner = pool.owner_of("GET", path) if pool is not None else None
                    scope = pool.scope(owner, "GET", path) if owner else ""
                    chosen = pool.pick(owner, scope) if owner else None
                    token = chosen.token(owner) if chosen else None
                    login = not token
                    if login:
                        if login_ok is None:
                            login_ok = self.mode("rest") != "stop" and self.secondary_admit("rest", 1)
                        cap = int(pace_settings()["minute_cap_calls"])
                        recent = sum(1 for t in self.minute_sent["rest"] if self.clock() - t < PACE_WINDOW)
                        if not login_ok or not self.rest_room(held_login + 1) or recent + held_login + 1 >= cap:
                            continue
                        if self.token is None:
                            self.token = self.token_source()
                        token = self.token
                    headers = self.read_headers(token, etag)
                    if self.prefetch_pool is None:
                        import concurrent.futures
                        self.prefetch_pool = concurrent.futures.ThreadPoolExecutor(
                            max_workers=self.prefetch_workers, thread_name_prefix="glaeda-gh-rest")
                    self.prefetched[key] = {"future": self.prefetch_pool.submit(self.transport, "GET", API + path,
                                                                                headers, None),
                                            "headers": headers, "login": login, "pool": chosen, "owner": owner,
                                            "scope": scope, "caller": self.caller_for(e), "route": route_of("GET", path),
                                            "minute": int(self.clock() // 60)}
                    self.prefetch_stats["sent"] += 1
                    held_login += login
        except Exception as error:  # noqa: BLE001  (an early read is only ever a saving)
            self.errors.append(f"prefetch: {describe(error)}")

    def caller_for(self, e: dict) -> tuple:
        return tuple(caller_of(e["key"])) + (waiter_of(e),)

    def send(self, method: str, path: str, headers: dict[str, str], raw_body: bytes | None) -> tuple[int, dict, bytes]:
        """request()'s one transport call: the answer a prefetch already asked for with these exact headers
        (prefetch_rest), waited for within the tick, else the request itself, now."""
        held = self.prefetched.pop((method, path, headers.get("If-None-Match") or ""), None) if raw_body is None else None
        if held is not None and held["headers"] != headers:
            self.settle_one(held)  # another credential (a token minted or a pool refused since): not this request's
            held = None
        if held is None:
            return self.transport(method, API + path, headers, raw_body)
        import concurrent.futures
        self.prefetch_stats["taken"] += 1
        try:
            return held["future"].result(timeout=max(0.1, min(HTTP_DEADLINE, self.tick_deadline - time.monotonic()
                                                              + SOCKET_TIMEOUT)))
        except concurrent.futures.TimeoutError:
            # charged as sent (request() charged it before): GitHub may count it whenever it ends
            raise WatchError("request failed: no answer from the prefetch in time") from None

    def settle_prefetch(self) -> None:
        """Account for every early request no read asked for (prefetch_rest): spent, logged and limited as request()
        would have, once its answer is in (each within SOCKET_TIMEOUT, else charged as sent)."""
        while self.prefetched:
            self.settle_one(self.prefetched.pop(next(iter(self.prefetched))))

    def settle_one(self, held: dict) -> None:
        import concurrent.futures
        self.prefetch_stats["unasked"] += 1
        try:
            status, h, raw = held["future"].result(timeout=SOCKET_TIMEOUT)
        except concurrent.futures.TimeoutError:
            status, h, raw = 0, {}, b""
        except Exception:  # noqa: BLE001  (never answered: GitHub may still have counted it)
            status, h, raw = 0, {}, b""
        with self.calling(*held["caller"]):
            if not held["login"]:
                self.note_spend("rest", held["route"], 0)
                if status and held["pool"] is not None:
                    held["pool"].answered(held["owner"], held["scope"], status, h, "")
                self.sent.append((self.now, "app"))
                return
            counted = 0 if status == 304 else 1
            if counted:
                self.charge_rest(held["minute"], 1)
            self.minute_sent["rest"].append(self.clock())
            self.note_spend("rest", held["route"], counted)
            self.sent.append((self.now, "rest304" if status == 304 else "rest"))
        if status in {403, 429} and h.get("retry-after") and h.get("x-ratelimit-remaining") != "0":
            self.secondary_hit("rest", h.get("retry-after"))
        elif status in {403, 429} and SECONDARY.search(raw.decode("utf-8", "replace") if raw else ""):
            self.secondary_hit("rest", h.get("retry-after"))

    def rest_pull(self, old: dict, parts: dict, root: str, number: Any, reuse: bool = True) -> tuple[dict, bool]:
        """(the pull, whether it is the kept one) for a REST PR read. The kept pull stands, with no pulls/N request,
        when GET issues/N answers 304 (the PR has not changed since) and the kept pull is under PULL_REUSE_MAX old with
        its mergeability computed; otherwise pulls/N is read (head_part), and its time kept for that bound. The issue
        answer is kept beside a pull only when both name the same updated_at (a pull and its issue share it; live,
        manaflow-ai/cmux#44595), so a 304 on it means unchanged since that pull. A failed issue read falls back to
        reading the pull. Raises WatchError (the pull's), OutOfTime."""
        path, gate = f"{root}/pulls/{number}", f"{root}/issues/{number}"
        kept = old.get(path) or {}
        at = kept.get("at")
        doc = kept.get("doc") if isinstance(kept.get("doc"), dict) else None
        held = old.get(gate) or {}
        can_reuse = (reuse and self.etags and doc is not None and doc.get("mergeable") is not None
                     and isinstance(at, (int, float)) and self.now - at < PULL_REUSE_MAX and bool(held.get("etag")))
        if can_reuse and gate not in parts:
            try:
                self.head_part(old, parts, gate, slim_issue_gate)
            except WatchError:
                parts.pop(gate, None)
            else:
                if parts[gate].get("etag") == held.get("etag"):  # 304 (or shared now): unchanged since the kept pull
                    parts[path] = kept
                    return doc, True
        pull = self.head_part(old, parts, path, slim_pull)
        parts[path] = {**parts[path], "at": min(self.now, self.resume_from)}  # (a resumed read: its first try's)
        if gate not in parts and held.get("etag") and (held.get("doc") or {}).get("updated_at") == pull.get("updated_at"):
            parts[gate] = held  # the issue answer kept still describes this pull
        elif gate not in parts and self.etags and self.mode("rest") != "stop":
            try:  # the issue as of now, for the next read's question (shared: a kept ETag makes it a 304)
                self.head_part(old, parts, gate, slim_issue_gate)
            except WatchError:
                parts.pop(gate, None)
        if (parts.get(gate) or {}).get("doc", {}).get("updated_at") != pull.get("updated_at"):
            parts.pop(gate, None)  # the PR changed between the two reads (or the issue lags): no 304 can vouch yet
        return pull, False

    def rest_head(self, old: dict, parts: dict, root: str, sha: str) -> tuple[dict, list, list, dict]:
        """A commit's check runs (every attempt, up to REST_CHECK_PAGES pages), statuses, workflow runs and the
        repository's workflow names, each a conditional read kept in `parts`. Raises WatchError."""
        # filter=all: every attempt, as GraphQL's rollup lists them, so parse_pr dedupes both alike
        path = f"{root}/commits/{sha}/check-runs?filter=all&per_page=100"
        checks = self.head_part(old, parts, path, slim_check_runs)
        listed = list(checks.get("check_runs") or [])
        for page in range(2, min(REST_CHECK_PAGES, -(-(checks.get("total_count") or 0) // 100)) + 1):
            listed += self.head_part(old, parts, f"{path}&page={page}", slim_check_runs).get("check_runs") or []
        checks = {"total_count": checks.get("total_count"), "check_runs": listed}
        statuses: list[dict] = []
        total = 0
        for page in range(1, REST_STATUS_PAGES + 1):
            got = self.head_part(old, parts, f"{root}/commits/{sha}/status?per_page=100&page={page}", slim_status_page)
            statuses += got.get("statuses") or []
            total = int(got.get("total") or 0)
            if len(statuses) >= total or not got.get("statuses"):
                break
        runs: list[dict] = []
        runs_total = 0
        for page in range(1, REST_RUN_PAGES + 1):
            got = self.head_part(old, parts, f"{root}/actions/runs?head_sha={sha}&per_page=100&page={page}",
                                 slim_head_runs_page)
            runs += got.get("runs") or []
            runs_total = int(got.get("total") or 0)
            if len(runs) >= runs_total or not got.get("runs"):
                break
        if total > len(statuses) or runs_total > len(runs):
            # a partial list would read as a smaller, greener head (a check without its run loses its workflow)
            checks = {**checks, "total_count": max(int(checks.get("total_count") or 0), len(checks["check_runs"]) + 1)}
        workflows = self.repo_part(old, parts, f"{root}/actions/workflows?per_page=100", slim_workflows)
        return checks, statuses, runs, workflows

    def fetch_head_rest(self, e: dict) -> None:
        """One head over REST, for when GraphQL is low or throttled: the same contexts fetch_heads folds."""
        _, owner, repo, sha = split_key(e["key"])
        prior = e["cache"] or {}
        if self.rest_oversized(e):
            # (a GraphQL read that spilled here this tick: due_heads leaves these out of REST's own turn)
            self.refund(e["key"])
            return None
        self.reads.append((self.now, "head", "rest"))
        old, parts = prior.get("restParts") or {}, {}
        try:
            checks, statuses, runs, workflows = self.rest_head(old, parts, f"/repos/{owner}/{repo}", sha)
        except WatchError as error:
            self.refund(e["key"])
            # GitHub answers 422 (No commit found) or 404 for a commit it does not know
            missing = not parts and re.match(r"HTTP (404|422)", str(error)) is not None
            return self.store(e["key"], e["cache"], error="no such commit" if missing else f"rest: {error}"[:200],
                              missing=missing)
        if (checks.get("total_count") or 0) > len(checks["check_runs"]):
            self.refund(e["key"])  # a partial list would read as a smaller, greener head
            # Those counts only grow: REST is not asked again before HEAD_OVERSIZED_RETRY (rest_oversized; GraphQL is)
            return self.store(e["key"], e["cache"], error=f"more than {REST_CHECK_PAGES * 100} checks, {REST_STATUS_PAGES * 100} statuses or "
                              f"{REST_RUN_PAGES * 100} workflow runs over REST", restOversizedAt=self.now)
        found: dict = {}
        statuses_by: dict = {}
        ids: dict = {}
        order: dict = {}  # head_data's `runs`
        failed: dict = {}
        fold_contexts(rest_contexts(checks, statuses, runs, set(), workflows), found, statuses_by, ids, order=order,
                      failed=failed)
        data = head_data(sha, found, statuses_by, ids, order)
        self.head_steps(data, failed, f"/repos/{owner}/{repo}")
        self.store(e["key"], e["cache"], error=None, dataAt=self.now, data=data, restParts=parts, via="rest")
        self.head_answered(e["key"])

    def fetch_comment_rest(self, e: dict) -> None:
        """One comment watch over REST, for when GraphQL is low or throttled: the issue (its state and comment
        count), then the page or two that hold its last COMMENTS_LAST comments. Conditional reads, so a quiet
        issue costs nothing."""
        _, owner, repo, number = split_key(e["key"])
        prior = e["cache"] or {}
        self.reads.append((self.now, "comment", "rest"))
        root = f"/repos/{owner}/{repo}/issues/{number}"
        old, parts = prior.get("restParts") or {}, {}
        try:
            issue = self.rest_part(old, parts, root, slim_issue)
            total = int(issue.get("comments") or 0)
            last = max(1, -(-total // 100))
            comments: list[dict] = []
            # the page before the last too, when the last holds fewer than COMMENTS_LAST
            for page in ([last - 1] if last > 1 and total - 100 * (last - 1) < COMMENTS_LAST else []) + [last]:
                comments += self.rest_part(old, parts, f"{root}/comments?per_page=100&page={page}", slim_comments)
        except WatchError as error:
            message = f"rest: {error}"
            self.errors.append(f"{e['key']}: {message}")
            return self.store(e["key"], e["cache"], error=message[:200],
                              missing=not parts and str(error).startswith("HTTP 404"))
        self.store(e["key"], e["cache"], error=None, dataAt=self.now, data=parse_comments(rest_issue_node(issue, comments)),
                   restParts=parts, via="rest")

    def fill_steps_rest(self, e: dict, data: dict, root: str, job_ids: dict[str, Any]) -> None:
        """fill_steps over REST, for a PR read over REST (GraphQL is the poorer bucket, or stopped). An Actions
        check run's id is its job's id, and a run's job list names every job's steps. A completed job does not
        change, so each is read once. Steps come, cheapest first, from the PR's own cache, the run watch's cached
        job list (free), and the run's job list (`runs/ID/jobs?filter=all`, one read for every job of the run,
        shared by every PR and tick through repo_parts, conditional past REST_HEAD_PART_TTL); a job none of those
        names (a run past REST_JOB_PAGES pages) is read alone, GET .../actions/jobs/ID. At most REST_STEPS_MAX
        reads per PR read, and the rest on the next one. Without its steps a refused or never-started check
        cannot be held. On 2026-11-11 huge-blue's daemon sent 22 jobs/{id} reads in an hour, one per failed job
        of a few runs."""
        known = known_steps([(e, data)])
        left = REST_STEPS_MAX
        self.steps_failed = {j: t for j, t in self.steps_failed.items() if self.now - t < STEPS_RETRY}
        _, owner, repo, _ = split_key(e["key"])
        for c in data.get("checks") or []:
            if not wants_steps(c):
                continue
            if c["id"] in known:
                c["failedSteps"], c["stepCount"] = known[c["id"]]
                continue
            if settled_pr(data):
                continue  # kept above when cached; nothing new is read for a settled PR
            job_id = job_ids.get(c["id"])
            if not job_id or not c.get("runId") or self.mode("rest") == "stop":
                continue
            if job_id in self.steps_failed:
                continue
            got = self.run_cache_job(owner, repo, c["runId"], job_id)
            if got is None and left > 0 and self.rest_room(1):
                try:
                    got, sent = self.run_list_job(root, c["runId"], job_id, left)
                except OutOfTime:  # the PR's checks and statuses are read; it goes first next tick for the steps
                    self.deferred.add(e["key"])
                    return
                left -= sent
            if got is not None:
                c["failedSteps"], c["stepCount"] = got
                continue
            if left <= 0 or not self.rest_room(1):
                continue
            left -= 1
            try:
                state, doc, _ = self.get(f"{root}/actions/jobs/{job_id}", None)
            except OutOfTime:
                self.deferred.add(e["key"])
                return
            if state != "fresh" or not isinstance(doc, dict):
                self.errors.append(f"{e['key']} steps: {doc}")
                if STEPS_GONE.match(str(doc)):
                    self.steps_failed[job_id] = self.now
                continue
            steps = doc.get("steps")
            c["failedSteps"], c["stepCount"] = failed_steps(steps), len(steps) if isinstance(steps, list) else None

    @staticmethod
    def run_cache_job(owner: str, repo: str, run_id: Any, job_id: Any) -> list | None:
        """[failedSteps, stepCount] of JOB_ID from the run watch's cached job list (no request), or None."""
        try:
            jobs = (read_cache(f"run:{owner}/{repo}/{int(run_id)}") or {}).get("jobs")
        except (TypeError, ValueError):
            return None
        for j in jobs if isinstance(jobs, list) else []:
            if isinstance(j, dict) and j.get("id") == job_id and settled_job(j):
                return [j["failedSteps"], j["stepCount"]]
        return None

    def run_list_job(self, root: str, run_id: Any, job_id: Any, budget: int = REST_STEPS_MAX) -> tuple[list | None, int]:
        """([failedSteps, stepCount] of JOB_ID or None, requests sent) from RUN_ID's job list, one page after another
        (REST_JOB_PAGES, and BUDGET requests, at most), each shared by every PR (repo_parts). A page the store holds is
        read again, conditional on its ETag, only when it does not show the job completed yet, and a page is asked at
        most once a tick, answered or not (a failed read is not repeated for each failed job of the run). Raises
        OutOfTime."""
        sent = 0
        for page in range(1, REST_JOB_PAGES + 1):
            path = f"{root}/actions/runs/{run_id}/jobs?filter=all&per_page=100&page={page}"
            shared = self.repo_parts.get(path)
            doc = (shared or {}).get("part", {}).get("doc") if shared else None
            found = next((j for j in (doc or {}).get("jobs") or [] if j.get("id") == job_id), None)
            if not settled_job(found) and self.job_lists_asked.get(path) != self.now:
                if sent >= budget or not self.rest_room(1):
                    return None, sent
                self.job_lists_asked = {p: t for p, t in self.job_lists_asked.items() if t == self.now}
                self.job_lists_asked[path] = self.now
                sent += 1
                try:  # TTL 0: always asked, with the newest ETag; a failure leaves the stored page as it was
                    doc = self.repo_part({}, {}, path, slim_run_jobs, None, 0)
                except WatchError as error:
                    self.errors.append(f"{root} run {run_id} jobs: {error}")
                    return None, sent
                found = next((j for j in doc.get("jobs") or [] if j.get("id") == job_id), None)
            if settled_job(found):
                return [found["failedSteps"], found["stepCount"]], sent
            if found is not None or int((doc or {}).get("total") or 0) <= 100 * page:
                return None, sent  # listed but not finished, or not in the run at all: read alone
        return None, sent

    def note_controller_fallback(self, what: str, n: int = 1) -> None:
        """Count what a fallback from the controller to REST cost, in the hour it happened in: `what` is
        "deadline" for a deadline the controller missed, "restRuns" for a run this host then read over REST on
        the shared quota. `glaeda-gh budget` reports both (controller_fallback_line)."""
        doc = self.controller_fallback
        hours = doc.get("hours")
        if not isinstance(hours, dict):
            hours = doc["hours"] = {}
        hour = time.strftime("%Y-%m-%dT%HZ", time.gmtime(self.now))
        bucket = hours.get(hour)
        if not isinstance(bucket, dict):
            bucket = hours[hour] = {}
        bucket[what] = int(bucket.get(what) or 0) + n
        for old in sorted(hours)[:-CONTROLLER_FALLBACK_HOURS]:
            hours.pop(old, None)
        if not isinstance(doc.get("since"), (int, float)):
            doc["since"] = self.now  # the window the counts cover: when this host first counted one
        if what == "deadline":
            doc["lastAt"] = self.now

    def controller_down(self, error: Exception, site: str | None = None) -> None:
        """Leave the controller alone for a while; REST serves meanwhile. The cursor is kept, so the
        feed catches up on what happened in between when it answers again."""
        what = describe(error) + (f" at {site}" if site else "")
        self.controller_missed_deadline = isinstance(error, ControllerTimeout)
        if self.controller_missed_deadline:
            # the run reads this sends to REST are counted as they happen (fetch_run), not guessed at here
            self.note_controller_fallback("deadline")
        if isinstance(error, NoReceiver):
            wait, state = CONTROLLER_ABSENT, "absent"  # not an error: that controller has no receiver
        else:
            self.controller_failures += 1
            wait, state = min(CONTROLLER_ABSENT, CONTROLLER_RETRY * 2 ** (self.controller_failures - 1)), "down"
            self.errors.append(what)
        self.controller_down_until = self.now + wait
        self.feed_live_since = None  # what the feed misses while out is not known: no PR is quiet until it is back
        self.save_feed_view()  # nor on a downstream host that rules with this view
        if not isinstance(error, NoReceiver):
            # The notice says what the fallback costs, not only that it happened: every run read this host makes until
            # the controller answers again spends the shared REST quota (one account, 5000/h for every lane together)
            # that the controller served for free. A reader told only "REST serves runs" has to know that to see the
            # price, and a notice whose mechanism the reader has to re-derive gets re-derived wrong.
            cost = ("REST serves runs, and each one spends the shared REST quota the controller served free"
                    if self.controller_missed_deadline else "REST serves runs")
            self.refresh_note("controller", what, getattr(self.controller, "base", None) or "controller",
                              f"{cost}; the controller is asked again at {utc_clock(self.now + wait)}")
        self.controller_status = {"state": state, "error": what, "retryAt": self.now + wait,
                                  "token": bool(getattr(self.controller, "token", None))}

    def read_feed(self) -> list[dict]:
        """The feed pages after the cursor. The first call only learns the cursor; a reset (the
        controller lost its state) starts over, so every watched run gets a fresh baseline. A page after the first
        that fails ends the read with the pages before it (the cursor is past them: dropping them would lose their
        runs' on-event hooks) and leaves its error in controller_feed_error."""
        self.controller_feed_error = None
        if self.controller_cursor is None:
            doc = self.controller.events(None)
            self.controller_cursor, self.controller_seen = doc["cursor"], {}
            return [doc]
        pages = []
        for _ in range(FEED_PAGES):
            if pages and not self.controller_room():
                break  # the tick's controller budget is spent: the backlog continues next tick, from the cursor
            try:
                doc = self.controller.events(self.controller_cursor)
            except WatchError as error:
                if not pages:
                    raise
                self.controller_feed_error = error
                break
            if doc.get("reset"):
                self.controller_cursor, self.controller_seen = doc["cursor"], {}
                return [doc]
            pages.append(doc)
            self.controller_cursor = doc["cursor"]
            if not doc.get("more"):
                break
        return pages

    def follow_controller(self) -> None:
        """Switch to the controller the source names now. Its feed starts over: a cursor is only
        meaningful to the controller that issued it, and the old one, drained, serves stale reads."""
        if self.controller_source is None:
            return
        if (self.controller_source is Controller.from_env and not os.environ.get("CMUX_CI_CONTROLLER")
                and CONTROLLER_CONFIG.exists() and not isinstance(read_json(CONTROLLER_CONFIG), dict)):
            return  # a config caught mid-write reads as garbage: keep the controller rather than the default
        current = self.controller_source()
        if getattr(current, "base", None) == getattr(self.controller, "base", None):
            if current is not None and self.controller is not None:
                self.controller.token = current.token  # a rotated token applies without a restart
            return
        log({"event": "controller", "from": getattr(self.controller, "base", None),
             "to": getattr(current, "base", None)})
        self.controller = current
        self.controller_cursor, self.controller_seen, self.feed_held = None, {}, []
        # coverage is the old controller's: the new one's feed has to show it again (fed())
        self.fed_repos, self.controller_ok_at = {}, float("-inf")
        self.feed_marks, self.feed_live_since = {}, None
        self.controller_down_until, self.controller_failures = 0.0, 0
        self.controller_missed_deadline = False
        self.controller_status = {"state": "off" if current is None else "starting"}

    def from_controller(self, entries: list[dict]) -> None:
        """Follow the controller's change feed: free, one request every CONTROLLER_FEED_EVERY seconds,
        plus one baseline read for each run newly watched. Job lists still come from REST."""
        self.controller_filled = set()
        self.follow_controller()
        if self.controller is None or self.now < self.controller_down_until:
            return
        self.controller_budget_end = time.monotonic() + CONTROLLER_TICK_BUDGET
        with contextlib.suppress(AttributeError):  # (a controller object without the attribute just is not cut)
            self.controller.budget_end = self.controller_budget_end
        try:
            self.read_controller(entries)
        finally:
            self.controller_budget_end = float("inf")
            with contextlib.suppress(AttributeError):
                self.controller.budget_end = float("inf")

    def controller_room(self) -> bool:
        """Whether this tick may ask the controller one more thing: it is not out (controller_down) and a whole
        CONTROLLER_READ_TIMEOUT fits in what is left of the tick's CONTROLLER_TICK_BUDGET. A request is never
        started to be cut short by the budget: that cut would read as the controller failing, and take it out
        (#2201 review). The allowance is the read deadline, not the connect one, because the read is the part a
        slow answer spends: a request allowed to start can always wait out an answer that is on its way, which is
        what keeps the run it carries off the shared REST quota."""
        return (self.controller is not None and self.now >= self.controller_down_until
                and time.monotonic() + CONTROLLER_READ_TIMEOUT <= self.controller_budget_end)

    def read_controller(self, entries: list[dict]) -> None:
        """from_controller's reads, within the tick's CONTROLLER_TICK_BUDGET. Pages feed_between_reads read during the
        last tick's reads (feed_held) are applied here first: their cursor is already past them."""
        pages, self.feed_held = self.feed_held, []
        if self.now - self.controller_feed_at >= CONTROLLER_FEED_EVERY:
            self.controller_feed_at = self.now
            try:
                fresh = self.read_feed()
            except WatchError as error:
                self.feed_held = pages  # read, cursor past them: the next tick that reads applies them
                return self.controller_down(error)
            self.took_feed(fresh)
            pages += fresh
        if pages or self.on_event_procs:
            # here, before the baseline reads below can return early: the cursor has moved past these pages
            try:
                self.on_event_tick(pages)
            except Exception as error:  # noqa: BLE001  a hook must never stop the reads
                self.errors.append(f"on-event: {describe(error)} at {error_site(error)}")
        runs = {e["key"]: e for e in entries if e["key"].startswith("run:") and not e["jobs"]}
        self.controller_seen = {k: v for k, v in self.controller_seen.items() if k in runs}
        for key, e in runs.items():
            if key in self.controller_seen:
                continue
            if not self.controller_room():
                break  # the rest get their baseline on the next tick; REST covers them meanwhile
            _, owner, repo, run_id = split_key(key)
            try:
                run = self.controller.run(run_id)
            except WatchError as error:
                self.controller_feed_error = None
                return self.controller_down(error)
            known = run is not None and (run.get("repo") or "").lower() == f"{owner}/{repo}"
            self.controller_seen[key] = known
            if known:
                self.apply_run(e, run)
        for page in pages:
            for run in page.get("runs") or []:
                key = f"run:{str(run.get('repo') or '').lower()}/{run.get('id')}"
                if key in runs:
                    self.controller_seen[key] = True  # newer than any baseline
                    self.apply_run(runs[key], run)
            self.nudge(entries, page)
            self.merge_comments(entries, page)
        self.controller_filled = {k for k, known in self.controller_seen.items() if known}
        if pages and getattr(self, "controller_feed_error", None) is not None:
            error, self.controller_feed_error = self.controller_feed_error, None
            return self.controller_down(error)
        if pages and self.now >= self.controller_down_until:  # an on-event lookup above may have taken it out
            self.controller_status = {"state": "ok", "lastDelivery": pages[-1].get("receiver_last_delivery"),
                                      "token": bool(self.controller.token)}
        if pages:
            self.save_feed_view()

    def took_feed(self, pages: list[dict]) -> None:
        """The feed answered now with PAGES: when it answered (controller_ok_at), since when without a gap
        (feed_live_since), and what it delivered per repository and PR (fed_repos, feed_marks)."""
        if getattr(self, "controller_feed_error", None) is None:
            self.controller_failures = 0
            self.controller_missed_deadline = False  # it answered: REST reads from here are not its fallback
        if (self.feed_live_since is None or self.now - self.controller_ok_at > LAND_FEED_GAP
                or any(page.get("reset") for page in pages)):
            self.feed_live_since = self.now  # what came before a gap or reset is not known: quiet starts here
        self.controller_ok_at = self.now
        for page in pages:
            for item in (page.get("runs") or []) + (page.get("suites") or []) + (page.get("comments") or []):
                repo = str(item.get("repo") or "").lower()
                if "/" in repo:
                    self.fed_repos[repo] = self.now
                    self.feed_mark(repo, item)
        if pages:
            self.feed_marks = {k: t for k, t in self.feed_marks.items() if self.now - t <= LAND_FEED_KEEP}

    def feed_due(self) -> None:
        """feed_between_reads, asked before every read request (as post_due is), on the tick's own thread only: a land
        worker's request on another thread never touches the feed's cursor or view. A fault takes the controller out,
        as one in the tick's controller phase does, and never fails the read that asked."""
        if not self.feed_after_controller or threading.get_ident() != self.tick_thread:
            return
        try:
            self.feed_between_reads()
        except Exception as error:  # noqa: BLE001
            self.controller_down(error, None if isinstance(error, WatchError) else error_site(error))

    def feed_between_reads(self) -> None:
        """Read the change feed between a tick's GitHub reads once CONTROLLER_FEED_EVERY has passed since the last
        feed read. A tick with a read backlog runs for minutes, and a feed read only at its start lets controller_ok_at
        age past CONTROLLER_FRESH: then every downstream's read answer drops this host's feed view (feed_view), nothing
        vouches for any lane VM's copy, and each of them reads its PRs from GitHub itself (hq#17503: 12k GETs an hour
        with the view never fresh). The pages are kept in feed_held for the next tick's read_controller to apply
        (on-event hooks, runs, nudges, comments); here only the view's bookkeeping moves, and the view is saved."""
        if (self.feed_between or self.controller is None or self.controller_cursor is None
                or len(self.feed_held) >= FEED_HELD_MAX):
            return  # (no cursor: this daemon follows no feed yet, or reads through an upstream)
        now = self.clock()
        if (now <= self.now or now - self.controller_feed_at < CONTROLLER_FEED_EVERY
                or now < self.controller_down_until):
            return  # (now <= self.now: no time has passed since the tick's own feed read)
        tick_now, budget_end = self.now, self.controller_budget_end
        self.feed_between, self.now, self.controller_feed_at = True, now, now
        self.controller_budget_end = time.monotonic() + CONTROLLER_TICK_BUDGET
        with contextlib.suppress(AttributeError):
            self.controller.budget_end = self.controller_budget_end
        try:
            try:
                pages = self.read_feed()
            except WatchError as error:
                self.controller_feed_error = None
                return self.controller_down(error)
            self.took_feed(pages)
            self.feed_held += pages
            self.save_feed_view()
            if self.controller_feed_error is not None:  # a later page failed: the pages before it are kept above
                error, self.controller_feed_error = self.controller_feed_error, None
                self.controller_down(error)
        finally:
            self.feed_between, self.now, self.controller_budget_end = False, tick_now, budget_end
            with contextlib.suppress(AttributeError):
                self.controller.budget_end = budget_end

    def save_feed_view(self) -> None:
        """Keep this daemon's feed view in UPSTREAM_FEED_FILE for `read` (feed_view): what a downstream host, which
        follows no feed, rules land_feed_quiet with. Written after each feed read (every CONTROLLER_FEED_EVERY at
        most), and when the feed goes out (controller_down), so a downstream never trusts a view this daemon dropped.
        Best effort: a lost write leaves the old view, whose okAt ages out of CONTROLLER_FRESH."""
        view = {"liveSince": self.feed_live_since,
                "okAt": self.controller_ok_at if math.isfinite(self.controller_ok_at) else None,
                "fedRepos": self.fed_repos, "marks": self.feed_marks}
        mark = (view["liveSince"], view["okAt"], len(self.feed_marks), len(self.fed_repos))
        if mark == self.feed_view_saved:
            return
        try:
            write_json(BASE / UPSTREAM_FEED_FILE, view)
            self.feed_view_saved = mark
        except (OSError, ValueError, TypeError):
            pass

    def feed_mark(self, repo: str, item: dict) -> None:
        """Note that the feed delivered ITEM (a run, suite or comment of REPO) now, under every PR, head and branch it
        names: land_feed_quiet's evidence that nothing happened to a PR."""
        marks = set()
        if item.get("number") is not None:  # a comment
            marks.add(f"pr:{repo}#{item.get('number')}")
        for pr in (item.get("prs") or []) + (item.get("pull_requests") or []) + (item.get("pr_heads") or []):
            number = pr.get("number") if isinstance(pr, dict) else pr
            if number is not None:
                marks.add(f"pr:{repo}#{number}")
            if isinstance(pr, dict) and pr.get("head_sha"):
                marks.add(f"sha:{repo}@{str(pr['head_sha']).lower()}")
        if item.get("head_sha"):
            marks.add(f"sha:{repo}@{str(item['head_sha']).lower()}")
        if item.get("head_branch"):
            marks.add(f"branch:{repo}@{item['head_branch']}")
        for mark in marks:
            self.feed_marks[mark] = self.now

    def wait_feed_quiet(self, req: dict, cached: dict | None, now: float) -> bool:
        """A PR wait's copy that only looks starved: the feed shows nothing reached the PR, its head or its branch since
        the copy was read (land_feed_quiet), within LAND_FEED_QUIET_MAX of that read. Each lane VM handed such waits
        back every UPSTREAM_DIRECT_AFTER (120 s) to read their PR through the broker themselves; huge-blue,
        2026-11-21 20:10-20:40Z: 2,435 of glaeda-upstream's 5,949 GETs were TTL re-reads of a path the same VM had read
        about 118 s before, while the broker's uncached GETs took 11-25 s at p50 and a land's owner_check 135-224 s.
        Counted once per copy kept (feedUnstarved in daemon.json)."""
        at = (cached or {}).get("dataAt")
        if req.get("kind") != "pr" or not isinstance(at, (int, float)) or isinstance(at, bool) \
                or not 0 <= now - at < LAND_FEED_QUIET_MAX or not self.land_feed_quiet(req["key"], "", at):
            return False
        if req.get("feedUnstarved") != at:
            req["feedUnstarved"] = at
            self.feed_unstarved += 1
        return True

    def land_feed_quiet(self, key: str, sha: str, since: float) -> bool:
        """True when the controller's feed says nothing could have happened to KEY's PR since SINCE: it has answered
        without a gap since before then (feed_live_since), answers now, covers the repository (fed) and delivered no
        run, suite or comment for the PR, for SHA or for the branch the cached PR names since then. Anything else
        (no feed, a gap, an event) is False: the land queue reads as it would with no feed (LAND_FEED_QUIET_MAX).
        On an upstream host, which follows no feed, the upstream's view of the key rules (upstream_feed_quiet)."""
        view = self.upstream_feed.get(key)
        if view is not None:
            return upstream_feed_quiet(view, sha, since, self.now)
        if not key.startswith("pr:") or self.feed_live_since is None or self.feed_live_since > since:
            return False
        if not self.fed(key):
            return False
        try:
            _, owner, repo, number = split_key(key)
        except ValueError:
            return False
        repo = f"{owner}/{repo}".lower()
        data = (read_cache(key) or {}).get("data") or {}
        marks = [f"pr:{repo}#{number}"]
        for head in {str(sha or "").lower(), str(data.get("headRefOid") or "").lower()} - {""}:
            marks.append(f"sha:{repo}@{head}")
        if data.get("headRefName"):
            marks.append(f"branch:{repo}@{data['headRefName']}")
        return all(self.feed_marks.get(m, float("-inf")) < since for m in marks)

    def on_event_tick(self, pages: list[dict], given: dict[str, list] | None = None, rest_now: bool = False) -> None:
        """Run on-event hooks for the finished runs in these feed pages, and retry the runs still pending.
        `given` (replay) holds job lists by on_event_key, in place of the controller's; `rest_now` asks GitHub at
        once when neither holds the job."""
        self.on_event_reap()
        runs = self.on_event_kept + [
            r for p in pages for r in (p.get("runs") or []) if isinstance(r, dict) and r.get("status") == "completed"]
        if not runs and self.on_event_idle():
            return
        hooks, problems = on_event_hooks()
        for problem in problems:
            if problem not in self.on_event_problems:
                self.on_event_problems.add(problem)
                log({"event": "on-event", "refused": problem})
        if not hooks and self.on_event_idle():
            return  # nothing configured, nothing left over: a stat of the config per feed read is all it costs
        runs = [r for r in runs if any(on_event_matches(h, r) for h in hooks)]
        BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
        with bounded_lock(BASE / ".on-event.lock") as held:
            if not held:
                # a replay holds it, and the feed cursor is already past these runs: keep them for the next tick
                # (#2020 F1); the pending runs on disk are retried then too
                self.on_event_kept = runs[-ON_EVENT_RUNS_MAX:]
                return
            self.on_event_kept = []
            state = on_event_state()
            before = json.dumps(state, sort_keys=True)
            by_name = {h["name"]: h for h in hooks}
            for run in runs:
                for hook in hooks:
                    if not on_event_matches(hook, run):
                        continue
                    key = on_event_key(hook["name"], hook["repo"], run.get("id"), run.get("attempt") or 1)
                    if key in state["runs"] or key in state["pending"]:
                        continue
                    state["pending"][key] = {"hook": hook["name"], "since": self.now, "run": {
                        k: run.get(k) for k in ("id", "repo", "attempt", "head_sha", "head_branch", "conclusion", "url")}}
            keys = sorted(state["pending"])
            if self.on_event_next is not None:  # start where the last tick stopped, so slow runs starve none (#2022 F1)
                at = next((i for i, k in enumerate(keys) if k >= self.on_event_next), 0)
                keys = keys[at:] + keys[:at]
            self.on_event_next = None
            for key in keys:
                if given is None and time.monotonic() >= self.tick_deadline:
                    self.on_event_next = key  # a slow controller used up the tick: the rest stay pending (#2020 F3)
                    break
                hook = by_name.get(state["pending"][key].get("hook"))
                if hook is None:
                    self.on_event_finish(state, key, "unresolved", why="the hook is no longer configured")
                else:
                    self.on_event_resolve(state, key, hook, (given or {}).get(key), rest_now)
            if json.dumps(state, sort_keys=True) != before:  # a pending run asked again unchanged writes nothing
                on_event_prune(state, self.now)
                write_json(BASE / ON_EVENT_STATE, state)
            self.on_event_pending = bool(state["pending"])
            self.on_event_seen = on_event_stat()

    def on_event_idle(self) -> bool:
        """Nothing pending, as of a state file nobody has changed since (a replay writes it too: #2020 F4)."""
        return self.on_event_pending is False and not self.on_event_kept and self.on_event_seen == on_event_stat()

    def on_event_finish(self, state: dict, key: str, outcome: str, **fields: Any) -> dict:
        p = state["pending"].pop(key, {})
        run = p.get("run") or {}
        record = {"outcome": outcome, "at": self.now, "hook": p.get("hook"), "sha": run.get("head_sha"),
                  "run_url": run.get("url"), **fields}
        state["runs"][key] = record
        if outcome != "started":
            log({"event": "on-event", "key": key, "outcome": outcome, **fields})
        return record

    def on_event_resolve(self, state: dict, key: str, hook: dict, given: list | None, rest_now: bool) -> None:
        p = state["pending"][key]
        run = p["run"]
        if not re.fullmatch(r"[0-9a-f]{40}", str(run.get("head_sha") or "")):
            self.on_event_finish(state, key, "no-match", why="the run's head_sha is not a full 40-hex commit")
            return
        job_url = ""
        if hook.get("job"):
            job = self.on_event_find_job(p, hook["job"], given, rest_now)
            if job is None:
                if self.now - float(p.get("since") or self.now) >= ON_EVENT_PENDING_MAX:
                    self.on_event_finish(state, key, "unresolved", why=f"job {hook['job']} never seen finished")
                return
            if job.get("conclusion") != hook["conclusion"]:
                self.on_event_finish(state, key, "no-match", conclusion=job.get("conclusion"))
                return
            job_url = str(job.get("url") or job.get("html_url") or "")
        elif run.get("conclusion") != hook["conclusion"]:
            self.on_event_finish(state, key, "no-match", conclusion=run.get("conclusion"))
            return
        self.on_event_start(state, key, hook, job_url)

    def on_event_find_job(self, p: dict, name: str, given: list | None, rest_now: bool) -> dict | None:
        """The finished job: from `given`, else the controller (free), else once from GitHub past
        ON_EVENT_REST_AFTER."""
        run = p["run"]
        repo, run_id, attempt = str(run.get("repo") or "").lower(), int(run.get("id")), int(run.get("attempt") or 1)
        if given is not None:
            return on_event_job(given, name)
        if self.controller_room() and hasattr(self.controller, "run_jobs"):
            try:
                doc = self.controller.run_jobs(repo, run_id, attempt)
            except NoReceiver as error:  # no run-jobs endpoint (or a brief 503): the feed is still served
                doc = {}
                self.errors.append(f"on-event jobs of {repo}/{run_id}/{attempt}: {describe(error)}")
            except WatchError as error:
                # One failure takes the controller out (CONTROLLER_TICK_BUDGET's comment): each pending run asking it
                # again was how a timing-out controller took 17.1 s of the tick
                doc = {}
                self.controller_down(error)
            job = on_event_job(doc.get("jobs") if doc.get("known") else None, name)
            if job is not None:
                return job
        waited = self.now - float(p.get("since") or self.now)
        if p.get("restTried") or not (rest_now or waited >= ON_EVENT_REST_AFTER):
            return None
        if self.mode("rest") == "stop" or not self.rest_room(1):
            return None  # past the daemon's share the mode is only lean: wait for room, restTried unset (#2020 F2)
        p["restTried"] = self.now
        with self.calling("on-event", repo):
            got, doc, _ = self.get(f"/repos/{repo}/actions/runs/{run_id}/attempts/{attempt}/jobs?per_page=100", None)
        if got != "fresh":
            self.errors.append(f"on-event jobs of {repo}/{run_id}/{attempt}: {doc}")
            return None
        return on_event_job((doc or {}).get("jobs"), name)

    def on_event_start(self, state: dict, key: str, hook: dict, job_url: str) -> None:
        """Claim the run on disk, then start the command detached. A crash between the two leaves the claim:
        at most once."""
        run = state["pending"][key]["run"]
        values = {"head_sha": run["head_sha"], "run_id": str(run.get("id")), "attempt": str(run.get("attempt") or 1),
                  "repo": str(run.get("repo") or ""), "run_url": str(run.get("url") or ""), "job_url": job_url,
                  "hook": hook["name"]}
        argv = [re.sub(ON_EVENT_PLACEHOLDER, lambda m: values[m.group(1)], a) for a in hook["command"]]
        logs = BASE / "on-event"
        logs.mkdir(parents=True, exist_ok=True, mode=0o700)
        out = logs / f"{hook['name']}-{values['run_id']}-{values['attempt']}.log"
        record = self.on_event_finish(state, key, "started", log=os.fspath(out), job_url=job_url or None)
        write_json(BASE / ON_EVENT_STATE, state)
        env = {k: os.environ[k] for k in ON_EVENT_ENV if k in os.environ}
        env.setdefault("PATH", "/usr/bin:/bin:/usr/sbin:/sbin")
        env.update(hook.get("env") or {})  # the hook's own literal values (a writer name, a PATH)
        env.update({f"GLAEDA_EVENT_{k.upper()}": v for k, v in values.items()})
        try:
            with open(out, "ab") as sink:
                proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=sink, stderr=subprocess.STDOUT,
                                        cwd=hook.get("cwd") or os.environ.get("HOME") or "/", env=env,
                                        start_new_session=True, close_fds=True)
        except OSError as error:
            record.update(outcome="failed", error=describe(error))
            log({"event": "on-event", "key": key, "outcome": "failed", "error": describe(error)})
            return
        record["pid"] = proc.pid
        self.on_event_procs[key] = proc
        log({"event": "on-event", "key": key, "outcome": "started", "pid": proc.pid, "sha": run["head_sha"]})

    def on_event_reap(self) -> None:
        """Collect the commands that ended, and record each one's exit code."""
        ended = {k: p.returncode for k, p in self.on_event_procs.items() if p.poll() is not None}
        if not ended:
            return
        with bounded_lock(BASE / ".on-event.lock") as held:
            if not held:
                return  # the next tick
            state = on_event_state()
            for key, code in ended.items():
                del self.on_event_procs[key]
                if key in state["runs"]:
                    state["runs"][key].update(outcome="ran", exit=code, ended=time.time())
                log({"event": "on-event", "key": key, "outcome": "ran", "exit": code})
            write_json(BASE / ON_EVENT_STATE, state)

    def apply_run(self, e: dict, run: dict) -> None:
        prior = e["cache"] or {}
        before = prior.get("data") or {}
        older = iso_epoch(run.get("updated_at")) or 0
        if prior.get("source") in {"rest", "graphql"} and (iso_epoch(before.get("updated_at")) or 0) > older:
            return  # a lost delivery: GitHub has shown a newer state than the controller
        data = controller_run(run)
        for k in ("display_title", "created_at"):  # the webhook record lacks these; keep REST's
            data[k] = before.get(k)
        same = prior.get("source") == "controller" and all(
            before.get(k) == data.get(k) for k in ("status", "conclusion", "run_attempt", "updated_at"))
        fields: dict[str, Any] = {"error": None, "data": data, "source": "controller"}
        if not same:
            fields["dataAt"] = self.now  # unchanged data keeps its time, so wait cannot rule on it anew
        if prior.get("source") != "controller":
            fields["restAt"] = self.now  # the safety-net clock starts when the controller takes over
        self.store(e["key"], e["cache"], **fields)
        e["cache"] = read_cache(e["key"])

    def nudge(self, entries: list[dict], page: dict) -> None:
        """Mark watched PRs whose head commit or branch had a run or check suite event."""
        touched: set[tuple[str, str]] = set()
        for item in (page.get("runs") or []) + (page.get("suites") or []):
            repo = str(item.get("repo") or "").lower()
            touched.add((repo, "sha:" + str(item.get("head_sha") or "").lower()))
            if item.get("head_branch"):
                touched.add((repo, "branch:" + str(item["head_branch"])))
        if not touched:
            return
        for e in entries:
            if e["key"].startswith("head:"):
                _, owner, repo, sha = split_key(e["key"])
                if (f"{owner}/{repo}".lower(), "sha:" + sha) in touched:
                    self.land_nudge(e["key"])  # a check event on this commit: its rollup changed
                continue
            data = (e["cache"] or {}).get("data") or {}
            if not e["key"].startswith("pr:") or not data:
                continue
            _, owner, repo, _ = split_key(e["key"])
            marks = {"sha:" + str(data.get("headRefOid") or "").lower()}
            if data.get("headRefName"):
                marks.add("branch:" + str(data["headRefName"]))  # a push: runs for a head GitHub has not shown yet
            if any((f"{owner}/{repo}", m) in touched for m in marks):
                self.land_nudge(e["key"])

    def merge_comments(self, entries: list[dict], page: dict) -> None:
        """Add new, edited and deleted comments on watched issues to their cached comment list. The
        next GraphQL read (every COMMENT_CYCLE) replaces the list with GitHub's latest 50."""
        watched = {e["key"]: e for e in entries if e["key"].startswith("comment:")}
        for c in page.get("comments") or []:
            try:
                key = f"comment:{str(c.get('repo') or '').lower()}#{int(c.get('number') or 0)}"
            except (TypeError, ValueError):
                continue
            e = watched.get(key)
            if e is None:
                continue
            prior = e["cache"] or {}
            data = dict(prior.get("data") or {"url": None, "state": None, "type": None, "total": None, "comments": []})
            by_id = {x.get("id"): x for x in data.get("comments") or []}
            if c.get("deleted"):
                by_id.pop(c.get("id"), None)
            else:
                edited = c.get("updated_at") if c.get("updated_at") not in {None, c.get("created_at")} else None
                by_id[c.get("id")] = {"id": c.get("id"), "url": c.get("url"), "createdAt": c.get("created_at"),
                                      "author": c.get("author"), "body": str(c.get("body") or "")[:COMMENT_BODY_MAX],
                                      "editedAt": edited or (by_id.get(c.get("id")) or {}).get("editedAt")}
            data["comments"] = sorted(by_id.values(), key=lambda x: x.get("id") or 0)[-2 * COMMENTS_LAST:]
            self.store(key, e["cache"], data=data, dataAt=self.now, error=None)
            e["cache"] = read_cache(key)

    def prune(self, live: set[str]) -> None:
        if not cache_dir().is_dir():
            return
        names = {file_name(k) for k in live}
        for path in cache_dir().glob("*.json"):
            if path.name in names:
                continue
            try:
                if self.now - path.stat().st_mtime > CACHE_KEEP:
                    path.unlink()
            except OSError:
                pass


# -- land: a queue that lands PRs by taking the next steps land_judge names (`glaeda-gh land`)
#
# Leo, 2026-11-16: "glaeda clearly needs improvement given the amount of manual work we've had to do these past days".
# A lane said "merge it", and a person then ran update-branch, waited, read the new head, merged pinned again, reran
# cancelled jobs, re-judged a head that moved during a review, and chained "after #X, update #Y" by hand. Here a lane
# says it once (`glaeda-gh land OWNER/REPO#N [--after OWNER/REPO#M]`) and the daemon does the rest: it asks
# land_judge (`land-judge explain R N --sha HEAD --json`) what the PR needs, takes the machine-actionable step its
# answer's "action" names (lane-scratch/glaeda-land-2026-11-16/action-schema.md, v1), and stops and tells the requester
# only on a real stop. Every step is an argv from an allowlist, never a shell string, and every `gh` goes through the
# gh-quota shim, so land_judge judges every merge again; without the shim no merge is sent.
#
# State: BASE/land/entries/<file_name(key)> (one entry per PR, atomic writes), BASE/land/requests/ (the CLI's enqueue
# and cancel requests; the daemon alone writes entries), BASE/land/counts.json (the steps taken, by kind and UTC day:
# the manual work this took over). An entry is judged only when something could have changed its answer: its PR's
# cache entry (head, checks, state) since the last decision, its wake-at, a dependency's merge, the run or comment
# it waits on. While its head's checks still run, land_judge is not asked at all. Judging and steps run on a small
# worker pool, one job per entry, each bounded, so the tick and the watchdog never wait on them. A step is claimed in
# the entry before it starts; a restart re-judges an entry whose step was claimed and never finished (a pinned
# update-branch and a pinned merge are both safe to repeat), and a review is claimed per head so it never runs twice.

LAND_CONFIG = Path(os.environ.get("GLAEDA_GH_LAND_CONFIG") or Path.home() / ".config/glaeda/land.json")
LAND_GH = Path.home() / ".local/lib/gh-quota/bin/gh"  # the gh-quota shim: land_judge judges every merge it sends
LAND_JUDGE = Path.home() / ".local/share/ws-sync/deploy/tools/land-judge"
# Where land-judge is, in order, after land.json's landJudge: the ws-sync deploy (Leo's own hosts), then the
# leo-workspace checkout (a lane VM has no ws-sync deploy). The first that exists is run. When none does, a land stops
# at once with land_judge_missing naming every path tried. Before, python exited 2 ("can't open file"), every job judged
# explain_failed and retried, and `land status` read like quota trouble (one lane VM, 2026-11-17).
LAND_JUDGE_PATHS = (LAND_JUDGE, Path.home() / "Projects/leo-workspace/tools/land-judge")
# The land worker's startup check: with no land-judge at any of those paths it refuses to start (no entry is judged
# or stepped; the daemon itself runs on), writes why to land/refused.json, and `glaeda-gh land` refuses to queue. It is
# checked every tick, so installing land-judge or setting land.json's landJudge starts it without a restart. Before,
# a configured path that did not exist was run anyway and every land judged explain_failed (gcp-agent-lane-6,
# 2026-11-17: cmux#44604 stopped after 8 of them).
LAND_REFUSED_FILE = "refused.json"
LAND_LATCH_FILE = "latch.json"  # the login's latch mark the queue last saw holding (land_latch), for `land status`
LAND_QUOTA_FILE = "quota.json"  # host-wide land pause after a quota refusal, for restart-safe queue parking
LAND_STALE_CHECKOUT_FILE = "stale-checkout.json"  # LandQueue.check_behind's warning, while it holds
# On an upstream host (a lane VM: no login, its PR data is the controller's copy), the land worker's nudge reaches
# nothing: upstream_tick asks the upstream every UPSTREAM_EVERY and takes whatever copy it has. When that copy of a
# landing PR is older than LAND_REFRESH_AFTER, the worker reads the PR itself through the broker (direct_read, as a
# starved wait does): at most every LAND_REFRESH_AFTER while it waits for a pushed head or is queued, else every
# LAND_REFRESH_EVERY. gcp-agent-lane-6, 2026-11-17: cmux#44537's copy was 8923 s old two minutes after the worker's
# own update-branch, so it sat out LAND_HEAD_TIMEOUT and judged unpinned; cmux#44209's held 02:24Z data for hours.
LAND_REFRESH_AFTER = float(UPSTREAM_DIRECT_AFTER)
LAND_REFRESH_EVERY = float(STALE_DATA_AFTER)


def land_judge(config: dict) -> tuple[Path | None, list[Path]]:
    """(the land-judge to run, or None; every path tried): CONFIG's landJudge, then LAND_JUDGE_PATHS."""
    given = config.get("landJudge")
    tried = [Path(os.path.expanduser(given))] if isinstance(given, str) and given else []
    tried += [p for p in LAND_JUDGE_PATHS if p not in tried]
    return next((p for p in tried if p.is_file()), None), tried


def land_judge_missing(tried: list[Path]) -> tuple[str, str]:
    """(why, the step that fixes it) when no land-judge is at any path TRIED."""
    why = "land-judge is not at any of " + ", ".join(map(os.fspath, tried))
    nxt = (f'set "landJudge" in {LAND_CONFIG} to land-judge\'s path (on a lane VM: '
           "~/Projects/leo-workspace/tools/land-judge, from `reach enroll HOST --apply`)")
    return why, nxt


# Where router-review is, in order, after land.json's routerReview: ~/.local/bin (a host that links it there), the
# ws-sync deploy's tools/, the leo-workspace checkout's tools/, then the daemon's PATH. The first that exists is run.
# Before, only ~/.local/bin/router-review was tried, and on a host with no such link every review step stopped
# review_cannot_start with FileNotFoundError (cmux#45626, 2026-11-17).
LAND_ROUTER_REVIEW_PATHS = (Path.home() / ".local/bin/router-review", LAND_JUDGE.parent / "router-review",
                            Path.home() / "Projects/leo-workspace/tools/router-review")


def land_router_review(config: dict) -> tuple[Path | None, list[Path]]:
    """(the router-review to run, or None; every path tried): CONFIG's routerReview as given (a path set by hand is
    run, and its own failure stops review_failed), else the first of LAND_ROUTER_REVIEW_PATHS that is executable,
    else router-review on PATH."""
    given = config.get("routerReview")
    if isinstance(given, str) and given:
        return Path(os.path.expanduser(given)), [Path(os.path.expanduser(given))]
    tried = list(LAND_ROUTER_REVIEW_PATHS)
    found = next((p for p in tried if p.is_file() and os.access(p, os.X_OK)), None)
    on_path = None if found else shutil.which("router-review")
    return (Path(on_path) if on_path else found), tried + ([] if found else [Path("$PATH/router-review")])


def land_review_start_failure(error: OSError, rr: Path) -> tuple[str, str]:
    """(why, the step that fixes it) when router-review was resolved to RR but could not be started.

    `describe` reduces anything that is not our own WatchError to its type name, so the stop read only
    "router-review could not start: FileNotFoundError": it named no path, and nobody could tell what to repair.
    cmux#45626 sat stopped on that line for 5,351 minutes (2026-11-17 18:40Z to 2026-11-21 11:52Z).
    An OSError from Popen carries the path the kernel refused in .filename (the executable, or the cwd), which is a
    path we passed, never a message from anywhere else. ENOENT on a file that is there is its `#!` interpreter, not
    the tool, so the reason says which of the two it is and the next step repairs that one.
    """
    named = Path(error.filename) if error.filename else rr
    what = error.strerror or str(error) or type(error).__name__
    why = f"router-review at {named} could not start: {what}"
    if error.errno is not None:
        why += f" (errno {error.errno})"
    if named.is_file():
        why += "; that file is there, so what is missing is its `#!` interpreter"
        nxt = f"head -1 {named}, then install the interpreter it names"
    else:
        why += "; no file is at that path"
        nxt = (f"ln -s {LAND_ROUTER_REVIEW_PATHS[-1]} {LAND_ROUTER_REVIEW_PATHS[0]} "
               "(or `reach enroll HOST --apply`, which links it)")
    return why, nxt


# The startup check's second half: land-judge found is in a git checkout (on a lane VM, ~/Projects/leo-workspace)
# that may sit far behind main when nothing deploys it. gcp-codex-lane-12, 2026-11-17: its checkout sat at
# leo-workspace#5512 while main moved on, and its old land_judge could not read main's TWINS (after #5580), so every
# pinned merge from that VM was refused "unreadable: not judged, retry" until `tools/ws-deploy --local` ran. The check
# warns when the checkout is more than LAND_MH_BEHIND_COMMITS commits behind its origin/main, its origin/main tip is
# more than LAND_MH_BEHIND_HOURS newer than its HEAD, it was last fetched more than LAND_MH_BEHIND_HOURS ago, or it has
# tracked changes (someone's local edit: ws-deploy keeps such a checkout as it is, so nothing moves it again).
# land.json's landJudgeBehindCommits and landJudgeBehindHours override the bounds. Read at most every
# LAND_MH_BEHIND_EVERY seconds. Such a checkout is not run when the ws-sync deploy release is current
# (LandQueue.check_behind falls back to it, said once); with no current release the land runs it and warns, naming
# the command that makes one. It never refuses: an old land_judge still judges.
# "Last fetched" is the newest of what a fetch leaves: FETCH_HEAD's mtime, the origin/main reflog's, and ws-sync's own
# record (LAND_WS_SYNC_LOG: a `no-op SHA` or `deployed OLD..SHA` line is a fetch that found main at SHA) when SHA is
# this checkout's HEAD. A fetch that writes no FETCH_HEAD (--no-write-fetch-head, a broker's update-ref) and finds
# nothing new touches neither file. When HEAD is its origin/main and fetch age is the only finding, the line says main
# has not moved since that fetch rather than calling the code old (interim-coord, 2026-11-18: "last fetched 7.7 h ago"
# while leo-workspace main had not moved for 13 h and huge-blue's checkout sat at main, ws-sync's no-op every 10 min).
LAND_MH_BEHIND_COMMITS = 20
LAND_MH_BEHIND_HOURS = 6.0
LAND_MH_BEHIND_EVERY = 600.0
LAND_MH_BEHIND_DEADLINE = 10.0
# The check refreshes such a checkout itself, never only warns: it runs the `tools/ws-deploy --local` its warning names
# (beside land-judge) off the tick, bounded by LAND_MH_REFRESH_DEADLINE, at most every LAND_MH_REFRESH_EVERY, then
# judges the checkout again. gcp-agent-lane-6, 2026-11-19: `land status` warned "last fetched 6.5 h ago" while
# cmux#46208 and #46210 stopped retry_deadline ("waited 10152 s ... still unreadable"), and nothing ran the command the
# warning named. land.json "landJudgeRefresh": false turns it off.
LAND_MH_REFRESH_EVERY = 1800.0
LAND_MH_REFRESH_DEADLINE = 600.0
LAND_WS_SYNC_LOG = Path(os.environ.get("WS_SYNC_STATE") or Path.home() / ".cache/ws-sync") / "deploys.log"
LAND_WS_SYNC_SEEN = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) (?:no-op ([0-9a-f]{7,40})\b|deployed [0-9a-f]+\.\.([0-9a-f]{7,40})\b)")
LAND_WS_SYNC_TAIL = 16384  # bytes of the record read: hours of 10-minute runs


def land_ws_sync_seen(head: str, log_path: Path | None = None) -> float | None:
    """When ws-sync's newest no-op or deployed line found main at HEAD (a fetch that ended at HEAD's commit), or None."""
    if not head:
        return None
    try:
        with open(log_path or LAND_WS_SYNC_LOG, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - LAND_WS_SYNC_TAIL))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        m = LAND_WS_SYNC_SEEN.match(line)
        if not m:
            continue
        if not head.startswith(m.group(2) or m.group(3)):
            return None  # the newest fetch found main elsewhere: it says nothing of this checkout
        try:
            return float(calendar.timegm(time.strptime(m.group(1), "%Y-%m-%dT%H:%M:%SZ")))
        except ValueError:
            return None
    return None


def land_checkout_behind(script: Path, max_commits: int, max_hours: float, now: float,
                         git: Callable[[list[str]], str | None] | None = None,
                         ws_log: Path | None = None) -> str | None:
    """Why the git checkout holding SCRIPT is too far behind its origin/main, or edited, to trust its land_judge, or
    None (current, or not a checkout, or git could not tell). GIT runs `git -C DIR ARGS` and answers its stdout, or
    None. WS_LOG is ws-sync's record (LAND_WS_SYNC_LOG)."""
    def real(args: list[str]) -> str | None:
        try:
            got = run_bounded(["git", "-C", os.fspath(script.parent), *args], LAND_MH_BEHIND_DEADLINE)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return got.stdout.strip() if got.returncode == 0 else None
    git = git or real
    root = git(["rev-parse", "--show-toplevel"])
    if not root:
        return None
    behind = git(["rev-list", "--count", "HEAD..origin/main"])
    times = (git(["log", "-1", "--format=%ct", "HEAD"]), git(["log", "-1", "--format=%ct", "origin/main"]))
    shas = (git(["rev-parse", "HEAD"]), git(["rev-parse", "origin/main"]))
    dirty = git(["status", "--porcelain", "--untracked-files=no"])
    why = []
    if behind and behind.isdigit() and int(behind) > max_commits:
        why.append(f"{behind} commits behind origin/main (over {max_commits})")
    if all(x and x.isdigit() for x in times) and (int(times[1]) - int(times[0])) / 3600 > max_hours:
        why.append(f"origin/main is {(int(times[1]) - int(times[0])) / 3600:.1f} h newer than HEAD (over {max_hours:g})")
    seen = []
    for name in ("FETCH_HEAD", "logs/refs/remotes/origin/main"):
        path = git(["rev-parse", "--path-format=absolute", "--git-path", name])
        with contextlib.suppress(OSError, TypeError):
            if path:
                seen.append(Path(path).stat().st_mtime)
    synced = land_ws_sync_seen(shas[0] or "", ws_log)
    if synced is not None:
        seen.append(synced)
    age = (now - max(seen)) / 3600 if seen else None
    if age is not None and age > max_hours:
        if not why and shas[0] and shas[0] == shas[1]:
            why.append(f"at its origin/main, but main has not been fetched for {age:.1f} h (over {max_hours:g}), so "
                       "main may have moved since")
        else:
            why.append(f"last fetched {age:.1f} h ago (over {max_hours:g})")
    if dirty:
        n = len(dirty.splitlines())
        why.append(f"{n} tracked change{'' if n == 1 else 's'} (someone's local edit; ws-deploy keeps such a checkout "
                   "as it is, so nothing moves it)")
    if not why:
        return None
    return (f"land-judge's checkout {root} is not current: " + "; ".join(why) + f". next: {root}/tools/ws-deploy "
            f"--local (on a pinned host it deploys the ws-sync release {LAND_JUDGE.parent.parent}, which the land "
            "then runs; an ff host's checkout moves only once it is clean), or set land.json landJudge to a current "
            "land-judge (an old land_judge can refuse every merge as unreadable; knobs: land.json "
            "landJudgeBehindCommits, landJudgeBehindHours)")


def land_reads_upstream() -> bool:
    """This host reads PRs through an upstream and can read one itself through the broker (direct_read)."""
    return upstream_command() is not None and direct_command() is not None


# How a land update-branch is sent. A lane VM's gh is lane-gh's broker client, which refuses every `gh api -X PUT`
# but a media upload ("gh api -X PUT: only a media upload goes through the broker"), so the REST form land_judge names
# (`gh api -X PUT repos/O/R/pulls/N/update-branch -f expected_head_sha=SHA`) exited 1 at every try there and stopped
# the entry after three identical refusals (hq#12553, hq#12590, cmux#45254, 2026-11-17). The broker takes
# `gh pr update-branch N -R O/R --match-head-commit SHA [--needs-newer-base CHECK]...` (its update_branch tool, pinned
# to SHA); gh's own `pr update-branch` takes no head, so a host with its own login keeps the pinned REST call.
# gh_quota.lane_gh_client reads the same file: the bootstrap's wrapper that runs lane-gh-credential.
LAND_LANE_GH_CLIENT = Path.home() / ".local/lib/lane-gh/bin/gh"


def land_broker_client(client: Path | None = None) -> bool:
    """This host's gh goes through the lane-gh broker (LAND_LANE_GH_CLIENT runs lane-gh-credential)."""
    try:
        return "lane-gh-credential" in (client or LAND_LANE_GH_CLIENT).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def land_update_branch_args(repo: str, number: str, head: str, needs: list[str], broker: bool) -> list[str]:
    """The gh argv of an update-branch pinned to HEAD: the broker's `pr update-branch` form (BROKER, a lane VM), one
    --needs-newer-base per check NEEDS names, else GitHub's REST PUT with expected_head_sha."""
    if broker:
        return (["pr", "update-branch", number, "-R", repo]
                + [arg for name in needs for arg in ("--needs-newer-base", name)] + ["--match-head-commit", head])
    return ["api", "-X", "PUT", f"repos/{repo}/pulls/{number}/update-branch", "-f", f"expected_head_sha={head}"]


LAND_PIN_READ_FAILS = 3  # failed direct reads in a row before a pinned land waiting for its head stops (pin_unread)


def land_direct_read(key: str) -> str | None:
    """One read of KEY's PR from GitHub through the broker, stored in the cache; None, or why it could not."""
    return direct_read({"key": key, "kind": "pr", "jobs": False, "began": time.time(), "land": True})


# The land executor: a host that only forwards its lands. cosmic-gray (Leo's Mac), 2026-11-17: load 48 on 15 cores,
# swap 9.4 of 10.7 GB, and its land queue ran land_judge for every queued PR on it (base_red_excuse.py x5 and
# pr_owner.py x2 at one look) and was its top REST caller (500/h). land.json's "executor" names a program, as
# upstream.json's "command" does (`["reach", "huge-blue", ".local/bin/glaeda-gh", "land", "serve"]`), that takes one
# JSON request line on stdin and answers one JSON line: the far side is `glaeda-gh land serve` on the executor host.
# With it, this host judges, steps, watches and runs land_judge for nothing:
# - `land`, `land cancel` and `land status` go to the executor (the same answer they print here: a request is
#   applied there, and the executor's queue notifies the requester, HOST/SESSION as named here, with acpmux send);
# - a request the executor did not take (it was unreachable) stays in this host's requests/ (an outbox), and the
#   daemon forwards it, in order, until the executor takes it: nothing is lost in flight;
# - the cutover: every entry this host's queue still has open is handed to the executor (its requester, --after and
#   request id kept, so a resend is applied once), then left "forwarded" here. One whose step is running here is
#   handed off when that step ends; a request for it in the meantime is applied here first, so the handoff carries it.
LAND_EXECUTOR_KEY = "executor"
LAND_FORWARD_DEADLINE = 60.0  # one run of the executor command (plus a land's --wait)
LAND_FORWARD_RETRY = 60.0  # after a failed forward, doubling, at most LAND_FORWARD_RETRY_MAX
LAND_FORWARD_RETRY_MAX = 600.0
LAND_FORWARD_BATCH = 50  # requests per forward
LAND_SERVE_OPS = ("land", "withdraw", "status", "batch", "room")
LAND_FORWARDED = "forwarded"
LAND_REQUESTER_SHAPE = re.compile(r"[^\s\x00-\x1f]{1,200}")  # acpmux send takes it as one argv word
LAND_FORWARD_FILE = "forward.json"  # the last forward's outcome, for `land status`
LAND_REQUEST_ID = re.compile(r"[A-Za-z0-9._:-]{1,160}")


def land_executor(config: dict | None = None) -> list[str] | None:
    """land.json's "executor" program (a list of words), or None: this host runs its own land queue."""
    command = (land_config() if config is None else config).get(LAND_EXECUTOR_KEY)
    if isinstance(command, list) and command and all(isinstance(a, str) and a for a in command):
        return command
    return None


# Land overflow: more than one host takes a busy host's lands. huge-blue, 2026-11-22 07:59Z: 888 open, 624 due late (the
# oldest 8.9 h), 1-3 of 12 workers busy, held by its own load line (1.0/core, mostly the lane-gh broker, acpmux and
# reviews, not land work), while air-blue's queue (5 workers) and cmux16's (6) had 0 due late. Leo: "if huge-blue is
# so weak and liable to falling over, then don't put so much reliance on it." land.json's "overflow" names peer land
# hosts, each as a program like "executor" (`["reach", "air-blue", ".local/bin/glaeda-gh", "land", "serve"]`). A due
# row this host's own gates (workers, load line) have held LAND_OVERFLOW_AFTER past its due time goes to the first
# peer whose `land serve` "room" answer has room, at most that many, as an executor handoff does (requester, lane,
# override and request id kept; the peer's queue judges it with its own reads and login and tells the requester).
# Here it is left "forwarded", naming the peer. A row held by the login's latch, parked on quota or landing --after
# another stays here: the peer would read on the same login, and a chain keeps its order on one host. A peer answers
# room only from its own last land-pool line (LAND_POOL_FILE, at most LAND_ROOM_FRESH old), never more than its idle
# workers less the rows already due there, and none at its own load line, so two hosts never pass rows back and forth
# (a host with an executor serves nothing).
LAND_OVERFLOW_KEY = "overflow"
LAND_OVERFLOW_AFTER = 600.0
LAND_OVERFLOW_EVERY = 120.0  # at most one overflow pass this often
LAND_POOL_FILE = "pool.json"  # the last land-pool line, for `land serve`'s room answer
LAND_ROOM_FRESH = 2 * 300.0  # 2 x LAND_POOL_LOG_EVERY


def land_overflow(config: dict | None = None) -> list[list[str]]:
    """land.json's "overflow" peers (each a program, as "executor"), in the order they are asked; [] for none."""
    peers = (land_config() if config is None else config).get(LAND_OVERFLOW_KEY)
    if not isinstance(peers, list):
        return []
    return [p for p in peers if isinstance(p, list) and p and all(isinstance(a, str) and a for a in p)]


def land_room(pool: Any, now: float) -> int:
    """How many more lands this host's queue takes from a peer now, from its last land-pool line POOL: its idle
    workers less the rows already due here (the host's load is no part of it: LAND_LOAD_LINE is gone); 0 when the line
    is older than LAND_ROOM_FRESH, or the login's latch or a quota park holds the queue."""
    if not isinstance(pool, dict):
        return 0
    at = pool.get("at")
    if not isinstance(at, (int, float)) or isinstance(at, bool) or now - float(at) > LAND_ROOM_FRESH:
        return 0
    if pool.get("latch") or pool.get("queueParked"):
        return 0
    try:
        return max(0, int(pool.get("workers") or 0) - int(pool.get("busy") or 0) - int(pool.get("due") or 0))
    except (TypeError, ValueError):
        return 0


def land_forward(command: list[str], request: dict, deadline: float = LAND_FORWARD_DEADLINE,
                 run: Callable[..., subprocess.CompletedProcess] | None = None) -> dict:
    """REQUEST sent to the executor (land_executor) as one JSON line; its answer, a dict with "ok", or WatchError."""
    exe = program_path(command[0])
    try:
        result = (run or run_bounded)([exe, *command[1:]], deadline, input_text=json.dumps(request) + "\n")
    except subprocess.TimeoutExpired:
        raise WatchError(f"land executor: no answer within {deadline:.0f}s") from None
    except OSError as error:
        raise WatchError(f"land executor: {type(error).__name__} running {command[0]}") from None
    lines = (result.stdout or "").strip().splitlines()
    try:
        answer = json.loads(lines[-1]) if lines else None
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        tail = (result.stderr or "").strip().splitlines()[-1:] or [f"exit {result.returncode}"]
        raise WatchError(f"land executor: {command[0]}: {tail[0]}"[:UPSTREAM_ERROR_MAX])
    if not answer.get("ok") and answer.get("code") in ("not_executor", "bad_request"):
        raise WatchError(f"land executor: {answer.get('code')}: {land_trim(answer.get('reason'), 200)}")
    return answer


def land_forward_name(command: list[str]) -> str:
    """The executor as said in messages: `reach HOST ...`'s HOST, else the program's words."""
    if Path(command[0]).name in ("reach", "ssh") and len(command) > 1:
        return command[1]
    return " ".join(command)[:120]


LAND_STATES = ("queued", "waiting_after", "judging", "acting", "waiting", "merged", "stopped", "cancelled",
               LAND_FORWARDED)
LAND_DONE = frozenset({"merged", "stopped", "cancelled", LAND_FORWARDED})
LAND_WITHDRAW = "withdraw"  # the request op `land cancel` writes


class LandCancelled(Exception):
    """`land cancel` arrived while a job ran: the job leaves the entry cancelled."""
LAND_TAG = "glaeda-land"  # who the gh-quota call log and may_merge's landing record charge these calls to
# Environment a land subprocess inherits (the on-event pattern: nothing else), then the tags. The session keys gh_quota
# reads its caller from (ACPMUX_SESSION_NAME, ACPMUX_SESSION_ID, CLAUDE_SESSION_ID, CODEX_THREAD_ID) are never passed:
# CMUX_AGENT_SESSION alone names the caller, so ~/.local/state/gh-quota/calls.jsonl says session:glaeda-land and the
# manual-ops detector can tell these calls from a person's.
LAND_ENV = ON_EVENT_ENV + ("GH_CONFIG_DIR", "XDG_CONFIG_HOME", "GH_HOST", "SSH_AUTH_SOCK")
# Every lander's read (land_judge, post-merge checks, rerun lookup) is a landing read and routes to the lander App.
# Writes still follow gh-app-roles.json: merge/update-branch use the lander role where permitted, while comments,
# reviews and PR edits keep the account login so their author and CLA semantics do not change.
LAND_ENV_TAGS = {"CMUX_AGENT_SESSION": LAND_TAG, "MAY_MERGE_PATH": LAND_TAG, "GLAEDA_GH_AGENT": LAND_TAG,
                 "GH_QUOTA_LANDING_READ": "land-judge"}
LAND_PATH_EXTRA = ("~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin")
# The land pool is sized by the host it runs on, read at every pass, never a hand-set count (cmuxterm-hq
# docs/handbook/hand-set-concurrency-number.md; the lane-gh broker's land slots, hq#17274, use the same rule): a ceiling
# of one worker per LAND_CORES_EACH cores (land_worker_ceiling). land.json "workers" stays an operator's override of
# the ceiling. No host-load line admits or holds a judgment: LAND_LOAD_LINE (0.8 per core) is gone (see
# land_load_per_core's comment for what it measured and why). The 4 this replaced was set by hand; gcp-agent-lane-1,
# 2026-11-21 20:05Z: 28 lands past due, waiting p50 82 min (max 129), each "every worker busy" (4 of 4) on 32 cores.
LAND_CORES_EACH = 2  # a judgment is one python land_judge plus its gh children: about two cores at its peak


def land_cores() -> int:
    """The cores this process may run on (its affinity, else the host's count), at least 1."""
    with contextlib.suppress(AttributeError, OSError):
        return max(1, len(os.sched_getaffinity(0)))
    return max(1, os.cpu_count() or 1)


def land_worker_ceiling(cores: int | None = None) -> int:
    """One land worker per LAND_CORES_EACH cores, at least 1."""
    return max(1, (land_cores() if cores is None else int(cores)) // LAND_CORES_EACH)


# The host's load is reported (the land-pool line, `land status`), never gated on. LAND_LOAD_LINE (0.8 per core, the
# handbook's headroom line) held every judgment past the first while the host's load per core was over it, and later
# (glaeda#2457) its busy CPU share. A judgment is land_judge waiting on GitHub: what it costs does not move with the
# host's load (measured in the PR that removed the line), so the line held lands and protected nothing. huge-blue,
# 2026-11-22 04:13-07:47Z: 12 workers, 1-2 busy, 265-305 due rows "over the line" every pass the 1-minute load read
# 0.86-1.57/core (agents and reviews, not lands), 887 open rows, queue-to-merge p50 77 min.
def land_load_per_core(cores: int | None = None) -> float | None:
    """The 1-minute load average per core, for the record only (no gate reads it), or None where the host does not say."""
    try:
        one = os.getloadavg()[0]
    except (AttributeError, OSError):
        return None
    return one / (land_cores() if cores is None else max(1, int(cores)))


LAND_EXPLAIN_DEADLINE = 1500.0  # land_judge's own CHECK_BUDGET_S is 1470 s
LAND_MERGE_DEADLINE = 1800.0  # the shim judges the merge again before it sends it
LAND_GH_DEADLINE = 120.0  # update-branch, rerun, pr edit, pr view
LAND_NOTIFY_DEADLINE = 30.0
# The acpmux class of every land notice sent (LandQueue.notify): what is sent is something the requester acts on, and
# an unclassified notice is an FYI that waits up to 15 min for the inbox's flush (acpmux hub/inbox.rs FLUSH_MS).
LAND_NOTICE_CLASS = "block"
LAND_HEAD_TIMEOUT = 300.0  # after a push-making step, how long to wait for the cache to show the new head
# After the queue's own update-branch moved a pinned head, how long a read that does not say the new head's first
# parent (a REST read, a lagging commit list) is waited for before the pin stops the row as it always did.
LAND_PIN_PARENT_WAIT = 300.0
LAND_NO_DATA_AFTER = 120.0  # an entry whose PR the cache has not read yet is judged without a pin after this
LAND_WAIT_DEFAULT = 3600.0  # a wait whose action named no timeout
LAND_RETRY_DEFAULT = 120.0
LAND_RETRY_MAX = 1800.0
LAND_REVIEW_WAIT = 3600.0
# A wait_pr verdict is kept, not judged again, while what it judged is unchanged (LandQueue.verdict_holds): the same
# head and the same check runs, statuses and conclusions in the daemon's own cache (land_check_fingerprint), with no
# run of checks between. hq docs/investigations/2026-11-18-boneheaded-designs.md §4.2, huge-blue 2026-11-18:
# glaeda-land ran 841 explains (816 live reads, 46 snapshot judgments) for 97 merges; one PR made 214 shim calls in
# 44 min at an unchanged head, and at 14:29-14:45Z host:glaeda-land was the broker's top caller every minute (~1,400
# REST/h). One leak: land_fingerprint holds `mergeable`, which GitHub turns UNKNOWN and back on every push to the base,
# so each base push woke every PR parked on a wait_pr verdict twice, each a land_judge explain answering the same. A
# head or check change, a CONFLICTING turn and a wait's own timeout (land_judge's timed step, its timeout_s) still
# judge at once. 600 s bounds what the fingerprint cannot see (the base moving under a green head: stale_green,
# tip_merge; a webview wait): a change it held back is judged at most this late, so a PR parked on a wait costs at
# most 6 explains an hour from base churn, not two per base push. Twice LAND_SNAPSHOT_MAX_AGE and under land_judge's
# RUNNING_WAIT_S (1800 s), so a wait land_judge names still times out on its own clock.
LAND_VERDICT_KEEP = 600.0
# The controller's webhook feed (the deliveries the daemon already follows: workflow runs, check suites and comments,
# Daemon.read_controller) says when a PR's checks or head could have changed; GitHub is read only when it says they
# did, or when it cannot say. Retro hq#17174 theme 3, gcp-codex-lane-5 2026-11-21: session:glaeda-land made 5,336
# gh calls in 15.7 h (3,016 of them land_judge explain's own reads: `pr view` 1,270, check-runs 1,092, run jobs 868)
# for 528 judgments, 411 of them answers that judged nothing (unreadable 286, quota 83, host_cap 42), and 189 judged
# unpinned after a quota park because no read had shown the cached head since (head_unpinned). The feed is "quiet"
# for a PR since T (Daemon.land_feed_quiet) when it has answered without a gap since before T, covers the repository
# (Daemon.fed), and delivered no run, suite or comment for the PR, its head or its branch since T. While it is:
# - a cached head read before the latch cleared or the park ended is still the head (fresh_head): a push shows up as
#   runs for the new head, so no read is waited for and land_judge is pinned (no `pr view` of its own);
# - an upstream host's copy is not re-read through the broker (refresh_due);
# - a wait verdict at the head (feedVerdict: a wait_pr that judged something) is the answer a judgment would give
#   again: neither a could-not-judge retry's wake nor a fingerprint change re-runs land_judge (feed_holds).
# Each is bounded by LAND_FEED_QUIET_MAX from the read or verdict it trusts: what the feed carries no event for (the
# base moving under a green head, mergeability, a PR merged or closed) is judged at most this late. A feed that is
# down, reset, switched or not covering the repository holds nothing: every path reads as before.
LAND_FEED_QUIET_MAX = 1800.0
LAND_FEED_GAP = 4 * CONTROLLER_FEED_EVERY  # a longer gap between feed answers starts its quiet over
LAND_FEED_KEEP = 2 * LAND_FEED_QUIET_MAX  # how long one PR's, head's or branch's last event is remembered
# An upstream host (a lane VM) follows no feed of its own: it holds no controller token, and its daemon reads through
# the upstream (controller "off"). So its feed_live_since stayed None, land_feed_quiet was always False there, and
# neither feed gate (wait_feed_quiet, refresh_due) ever held a read: each lane VM read every PR it waited on or landed
# through the broker every UPSTREAM_DIRECT_AFTER. huge-blue's broker, 2026-11-21 22Z: glaeda-upstream made 14,180 GETs,
# 11,673 of them a path the same VM had read before (pulls/N re-read at a median 120 s gap), while only about 6% were
# a path more than one VM read. The upstream host's daemon now keeps its feed view in UPSTREAM_FEED_FILE (written each
# time it reads the feed), `read` answers each PR key with it (feed_view), and the downstream rules with that view
# (upstream_feed_quiet) exactly as land_feed_quiet does with its own feed.
UPSTREAM_FEED_FILE = "feed-view.json"  # under BASE: {"liveSince", "okAt", "fedRepos", "marks"} (Daemon.save_feed_view)
UPSTREAM_FEED_FRESH = 3 * UPSTREAM_EVERY  # a downstream trusts a key's feed view this long after the upstream gave it
UPSTREAM_FEED_SKEW = 5.0  # seconds of clock difference between hosts an event time is given against a copy's dataAt
LAND_NOT_JUDGED = frozenset({"quota", "unreadable", "host_cap", "explain_failed"})  # answers that judged nothing
LAND_STREAK_STOP = 3 # identical refusals in a row (code, head, step) that stop an entry
LAND_RETRY_STREAK_STOP = 8  # ... for could-not-judge answers (quota, unreadable), which back off between tries
# The steps of a could-not-judge answer: a retry, and the mirror fill an unreadable answer names (fetch), whose
# failures step_refused counts on their own
LAND_RETRY_KINDS = frozenset({"retry", "fetch"})
# A refusal whose step is a wait on the PR's checks (wait_pr, wait_run: checks_running, checks_queued_no_runner,
# ws_check_missing, a "command" that is a glaeda-gh wait) never counts toward LAND_STREAK_STOP, nor a refused step's
# LAND_STEP_STOP when its `next:` is such a wait. Checks still running are a wait, not a failure. 2026-11-18 ~15:50Z,
# hosted Linux runners queued ~50 min: land_judge refused hq#12626 (d5bf1325) and hq#12595 (db2a372b) checks_running
# with a 1800 s wait; each wait timed out with the checks still queued, the judgment after it counted, and the third
# stopped both: "checks_running: 3 identical refusals in a row", each a requeue by hand. Now such a refusal takes its
# wait and is judged again, for as long as the checks move: the bound is LAND_WAIT_STUCK with no change at that head in
# any check's status or conclusion (land_check_fingerprint), and its stop (checks_stuck) names the checks still
# unfinished. A new head or a requeue starts it again (an "ok" whose merge is refused for running checks does not).
# Past STRAGGLER_AFTER a check queued with no runner is a straggler to `wait`; four hours of nothing moving at all is
# a check that will never start.
LAND_WAIT_KINDS = frozenset({"wait_pr", "wait_run"})
# What made a judgment run (judge's WHY, kept on the entry and counted with explain_unmoved_<why>): a bound of the
# queue's own ran out (LAND_JUDGE_DUE) or some evidence changed. An "unmoved" judgment -- same head, same check
# fingerprint -- is the queue working as designed when a bound ran out, and redundant only when it was a change the
# verdict provably does not depend on. Counting the two together read as waste and invited a hold that would have
# delayed every recovery (hq#15832 Fix 120: 171 unmoved judgments, 161 of them a bound running out).
LAND_JUDGE_WHY = frozenset({"queued", "woke", "no_data", "repin", "head_moved", "head_timeout", "checks_woke",
                            "run_done", "comment_seen", "reran", "fp_moved", ""})
LAND_JUDGE_DUE = frozenset({"queued", "woke", "no_data", "repin", "head_timeout", "checks_woke"})
LAND_WAIT_STUCK = 4 * 3600.0
# The rest of the waits land_judge names never count toward LAND_STREAK_STOP either: a review still running
# (wait_comment), a judgment it could not make (retry: unreadable, explain_failed) and the rerun of a cancelled job
# (rerun_failed; its checks' wait after it is a wait_pr above). interim-coord, 2026-11-18: "A refusal whose next step
# is a wait (a check queued, pending or cancelled-and-rerun) should keep waiting up to a deadline, with no strike; only
# a real red or a hold counts toward the 3" (cmux#46183, #46220: cancelled shards a rerun clears). Keyed on the action's
# kind, never its words. These waits in a row at one head share one budget (e["waitBudget"], wait_spent), so kinds that
# alternate (a review running while reads flap unreadable: wait_comment, retry, wait_comment...) never restart it
# (review of glaeda#2174, F1): from its first such judgment at the head,
# sized max(the kind's LAND_WAIT_DEADLINE, twice the action's own timeout_s, so a wait always gets judged again at
# least once); the judgment that finds it spent stops "<kind>_deadline", naming the wait that ran out. A new head
# starts a new budget; an "ok" or a wait on the checks (checks_stuck bounds it) drops it, any other step keeps it. A fetch
# is work, not a wait:
# LAND_RETRY_STREAK_STOP and step_refused
# still bound it. Only a "stop" or "command" (a red not excused, a hold, a BLOCK, a teammate's PR, a conflict) and the
# remaining steps (repin, review, retarget) count toward or stop at LAND_STREAK_STOP.
LAND_WAIT_DEADLINE = {"wait_comment": 7200.0, "retry": 7200.0, "rerun_failed": 7200.0}
# LAND_WAIT_HELD: a wait budget counts the time the queue chose to wait (each judgment's backoff), never the time the
# login's quota kept it from judging: due and held by the login's latch (hold), or parked on a quota refusal
# (park_quota), up to the judgment that follows (e["waitBudget"]["held"], wait_spent). 2026-11-19: two PRs stopped retry_deadline "waited 8273 s (deadline 7200 s,
# 3 judgments) ... still unreadable" and "waited 7965 s ... 3 judgments", each held by the latch through three or four
# windows: three judgments in over two hours was the latch's doing, not the PR's. A stop the old count made that way is
# queued again with a whole budget once the latch clears (rearm, latch_owed). A wait that keeps failing for its own
# reason still runs its budget out in the time the queue spent waiting.
LAND_WAIT_WHAT = {"wait_comment": "a review verdict at the head", "retry": "a judgment land_judge could not make",
                  "rerun_failed": "the rerun of the cancelled jobs"}
# A judgment land_judge could not make because a read could not complete (code "unreadable": a live read that timed
# out, a classifier that could not read the reds, a GitHub read refused) is no judgment of the PR: its retry waits
# LAND_UNREAD_DEADLINE, not the 2 h of a wait on something the PR's own state decides. 2026-11-19: cmux#46508 at
# 0ca8cdb6 and #46516 at fa982deb stopped retry_deadline after 3 judgments over 14,131 s, #46754 at d6c38be508bc after
# 7,542 s (each live webview-verdict read "took over 40 s"), and #46995 at 6dbdbf3a8801 after 3 judgments over
# 14,356 s (base_red_excuse.py's gh api graphql read failed); each was a requeue by hand. Coordinator: "A read timeout
# must not end a land ... and let a stuck read never count toward the three-strike stop." Still bounded: a read that
# never completes stops retry_deadline at LAND_UNREAD_DEADLINE, and re-arms (LAND_REARM_*) as before.
LAND_UNREAD_DEADLINE = 6 * 3600.0
LAND_UNREAD_CODES = frozenset({"unreadable"})
# Answers that read nothing about the PR, which a lane VM hands to the broker host's land queue (unjudgeable_here):
# webview_unreadable is land_judge's stop after three live webview reads timed out, the same slow read
# (gcp-agent-lane-10, 2026-11-22: cmux#48009, #49213, #48839 stopped on it, each read "took over 40 s").
LAND_HANDOFF_UNREAD = frozenset({"unreadable", "explain_failed", "webview_unreadable"})
# An "unreadable" answer holds no worker to learn nothing again (hq docs/handbook/read-with-one-quota-route.md: every
# read on the land path has two routes, the first costing no quota). Its next judgment runs from this host's caches
# (`explain --cache-only`, no read sent, no broker queue waited on, a local read of seconds); only a miss goes live,
# in the same job.
# And the same unreadable text (digits aside) LAND_UNREAD_SAME_STOP times in a row at one head stops the entry with
# that text named to its requester, instead of retrying it for LAND_UNREAD_DEADLINE. gcp-agent-lane-1, 2026-11-21
# 18:05-20:05Z: 26 of 38 judgments ended "unreadable"/retry, one judgment held its worker 3+ min on one broker read,
# and cmux#49035 was judged unreadable 5+ times (16:11-19:12Z) on one base_red_excuse.py GraphQL RuntimeError.
LAND_UNREAD_SAME_STOP = 3
# Only a read that failed for a reason of its own counts toward that stop: a raised error (a traceback, a
# RuntimeError) that is no timeout or wait. A read that timed out or waited (a broker queue, a rate limit, a verdict
# not published yet) is the world's state, not the read's, and still retries to LAND_UNREAD_DEADLINE (cmux#46754: the
# live webview-verdict read "took over 40 s" each time, then read).
LAND_UNREAD_RAISED = re.compile(r"Traceback|\b\w*(?:Error|Exception)\b")
LAND_UNREAD_TRANSIENT = re.compile(r"timed? ?out|timeout|took over|deadline|retry after|rate.?limit|secondary|queued|"
                                   r"busy|not published|cache-only", re.I)
# A train_wait (another PR's merge-train reservation holds the base for a file this one changes) is a retry land_judge
# itself bounds: the reservation lives TRAIN_HOLD_S (1.5 h) from the holder's head, under the retry's 2 h. So its budget
# is the reservation's, keyed on the holder and its head: a new holder head is a new reservation and a new budget. Keyed
# on the waiting head alone, one budget spanned every holder head: 2026-11-19 hq#12558, #13035, #12713, #12590, #12844
# and #12653 each stopped retry_deadline ("still train_wait") behind hq#13113's two heads, each a requeue by hand.
LAND_TRAIN_HOLDER = re.compile(r"\b([\w.-]+/[\w.-]+#\d+) \(label [\w.-]+, head ([0-9a-f]{7,40})\)")
# A cancelled job is rerun at most this many times per (head, run) (e["reruns"], take's rerun_failed): its rerun's checks
# can finish within minutes, so the 2 h budget alone let a job cancelled every time (a concurrency group, a timeout
# reported as cancelled) be rerun dozens of times (review of glaeda#2174, F2). The next names it and stops
# "rerun_failed_cap". A new head starts the count again.
LAND_RERUN_CAP = 3
# A rerun of a pull_request run (`--failed`, one job, the whole run) keeps the run's merge commit: refs/pull/N/merge as
# GitHub built it when the run was created, never a fresh one. A red the base fixed after that merge is replayed and
# fails again (2026-11-22: cmux run 44964926915 attempt 3, 02:42Z, re-tested a 00:05Z merge that lacked base fix
# 27647ffd3ae, 01:50Z, scripts/ci/api_call_log/env.sh; 4 of 13 react-apps-check reruns since 02:20Z were such replays).
# So both rerun steps (take's rerun_failed, rerun_unrelated) ask stale_replay_why first, and a stale one takes a pinned
# base merge (update_branch) instead: only a new head gets a new merge commit. This is a copy of cmuxterm-hq
# tools/fleet-reconcilers/stale_replay.py why() (cmuxterm-hq#17798): the same rule and constants; change both together.
# Any read that fails or answers nothing usable gives "": the rerun goes ahead as before.
STALE_REPLAY_BEHIND = int(os.environ.get("STALE_REPLAY_BEHIND", "50"))  # base commits past the merge: stale either way
STALE_REPLAY_FIX_PATHS = (".github/*", "scripts/ci/*")  # base changes that can fix a red the PR never touched
STALE_REPLAY_PR_EVENTS = frozenset({"pull_request", "pull_request_target"})


def stale_replay_base_ref(run: dict, default: str = "") -> str:
    """The base branch the run's merge was built on (its pull_requests' base), else `default`."""
    for pr in run.get("pull_requests") or []:
        ref = ((pr or {}).get("base") or {}).get("ref") if isinstance(pr, dict) else None
        if isinstance(ref, str) and ref:
            return ref
    return default


def stale_replay_fix_hits(files: Any, patterns: Any = ()) -> list[str]:
    """The files a STALE_REPLAY_FIX_PATHS or caller pattern matches, sorted."""
    pats = tuple(STALE_REPLAY_FIX_PATHS) + tuple(p for p in patterns if p)
    return sorted(f for f in set(files) if isinstance(f, str) and any(fnmatch.fnmatchcase(f, p) for p in pats))


def stale_replay_why(run: dict, base_then: Callable[[str, str], str | None], compare: Callable[[str, str], dict],
                     patterns: Any = (), default_base: str = "", behind: int | None = None) -> str:
    """"" when a rerun of RUN may go ahead, else why it would replay a merge older than the base's fix (cmuxterm-hq
    tools/fleet-reconcilers/stale_replay.py why(), copied). `base_then(ref, created_at)` names the base's newest commit
    at or before the run's creation; `compare(that, ref)` is GitHub's compare of it to the base now."""
    if not isinstance(run, dict) or run.get("event") not in STALE_REPLAY_PR_EVENTS:
        return ""
    created, ref = run.get("created_at"), stale_replay_base_ref(run, default_base)
    if not isinstance(created, str) or not created or not ref:
        return ""
    limit = STALE_REPLAY_BEHIND if behind is None else behind
    try:
        then = base_then(ref, created)
        if not isinstance(then, str) or not then:
            return ""
        found = compare(then, ref)
    except (RuntimeError, ValueError, KeyError, TypeError, OSError):
        return ""
    if not isinstance(found, dict) or found.get("status") not in ("ahead",):
        return ""  # identical: nothing moved; diverged or unread: no proof, so the rerun goes ahead
    ahead = found.get("ahead_by")
    if not isinstance(ahead, int) or isinstance(ahead, bool) or ahead <= 0:
        return ""
    run_id = run.get("id")
    what = f"run {run_id}'s merge" if run_id else "the run's merge"
    if ahead > limit:
        return (f"{what} was built on {ref} at {then[:12]} ({created}), {ahead} commits behind {ref} now (more than "
                f"{limit}); a rerun replays that merge")
    hits = stale_replay_fix_hits([f.get("filename") if isinstance(f, dict) else f for f in found.get("files") or []],
                                 patterns)
    if hits:
        more = f" and {len(hits) - 1} more" if len(hits) > 1 else ""
        return (f"{what} was built on {ref} at {then[:12]} ({created}); {ref} has changed the CI path {hits[0]}{more} "
                "since, and a rerun replays the merge without it")
    return ""
# A stop whose cause can clear by itself is re-armed (LandQueue.rearm): retry_deadline (land_judge could not judge:
# an old land_judge checkout, a mirror, a flapping read) and <step>_transient (the step timed out or GitHub answered
# 5xx, LAND_STEP_TRANSIENT) and review_cannot_start (router-review is not on this host, or would not exec: a link or
# a deploy made since the stop clears it, and the entry must not read as a review that refused). It is queued again
# once land_judge's checkout was refreshed or turned current after the
# stop (retry_deadline), else LAND_REARM_AFTER after it, at most LAND_REARM_CAP times per entry per UTC day. Its wait
# budget and transient count are kept, so a judgment that still reads the same stops it again at once (one probe, not
# another 2 h); one that reads clean goes on. gcp-agent-lane-6, 2026-11-19: cmux#46208 and #46210 stayed stopped
# retry_deadline behind a stale land_judge checkout, each landing only on a requeue by hand. cmux#45626 stayed stopped
# "review_failed" for 89 h because the reviewer could not start here and that reads the same as a review that refused:
# a review verdict (a BLOCK, land_judge's stop class "block") is a judgment and is never re-armed, while
# review_cannot_start is this host missing a tool and is.
LAND_REARM_CODES = re.compile(r"^(?:retry_deadline|review_cannot_start|[a-z_]+_transient)$")
LAND_REARM_AFTER = 3600.0
LAND_REARM_CAP = 3
# LAND_STOP_REPEAT: a re-armed entry that stops again with the stop it was re-armed from (same code, same head, the
# same reason once its counts and seconds are left out) tells its requester nothing: they were told at the first stop,
# and every acpmux notice is a whole model turn for them. efficiency-scout pass 6, 2026-11-21: cmux#47074's session
# was woken 3 times in 19 h by retry_deadline, each the same unreadable webview verdict, and coordinators answered
# "nothing for me" to repeat notices 6+ times. A new head, another code or reason, or a fresh `land` (which clears
# lastStop) is told as before; the quiet stop is in the entry's history ("quiet": "repeat") and the daemon's log.
LAND_STOP_DIGITS = re.compile(r"\d+(?:\.\d+)?")


def land_stop_repeats(last: Any, st: dict) -> bool:
    """Whether stop ST repeats LAST, the stop its entry was re-armed from (LAND_STOP_REPEAT's comment)."""
    if not isinstance(last, dict) or not last.get("code"):
        return False
    gist = lambda d: LAND_STOP_DIGITS.sub("#", " ".join(str(d.get("reason") or "").split()))  # noqa: E731
    # a stop saved before stops kept their head has none: its head is not known to differ
    same_head = "head" not in last or (last.get("head") or "") == (st.get("head") or "")
    return (last.get("code") == st.get("code") and same_head
            and gist(last) == gist(st))
# An --after PR whose predecessor's land stopped keeps waiting for it this long (consider, after_stopped), telling its
# requester once: landing the predecessor again, or merging it, resumes the whole chain, and nobody re-queues the PRs
# behind it (before, each stopped at once: cmux#46237, #46217, #46236 behind #46157, #46183, #46220). Past it, it
# stops naming the predecessor and the one command that re-queues it. A cancelled predecessor stops it at once.
LAND_AFTER_STOPPED_WAIT = 86400.0
# A quota refusal parks the entry: no judge, read, watch or nudge for it until the reset the refusal names (Leo,
# 2026-11-17, on Claude desktop's "GitHub rate limit" hover: "this is... interesting. so claude desktop shows rate limit
# on hover of the github links sometimes..."). Before, every quota-refused entry was judged again about every 5 min
# while the login was dry, each judge spending land_judge's reads on it: session:glaeda-land 549 REST / 360 GraphQL in
# an hour on gcp-agent-lane-5, 498 REST on cosmic-gray. land_judge names the reset ("quota: not judged, retry after
# HH:MMZ (reset); no attempt before HH:MMZ", leo-workspace tools/gh_latch.py not_judged, lw#5626): parked until it
# plus a per-caller jitter of 0..LAND_QUOTA_JITTER s, the same spread land_judge's own callers take, so the queues on
# every host do not all fire at the reset second. A refusal that names no time (an older land_judge) backs off
# LAND_QUOTA_BACKOFF, doubled per quota refusal in a row, at most LAND_QUOTA_BACKOFF_MAX. A quota park is the login's
# state, not the PR's: it never counts toward a stop.
LAND_QUOTA_JITTER = 120
LAND_QUOTA_BACKOFF = 300.0
LAND_QUOTA_BACKOFF_MAX = 3600.0
LAND_QUOTA_MAX_S = 3700.0  # gh_latch MAX_S: a reset never lies more than GitHub's hour ahead
LAND_LATCH_ECHO = "echo"  # gh_latch.ECHO (lw#5869): our own refusal of a held mark read back; holds no land (land_latch)
# A latch mark is checked against GitHub's own count (land_latch, Daemon.land_reading): GET /rate_limit no more often
# than LAND_READING_REFRESH while a mark would hold, and a reading counts only when seen after the mark was written,
# at most LAND_READING_MAX_AGE ago, with its reset still ahead (a passed reset is unknown, never "0 left").
LAND_READING_REFRESH = 60.0
LAND_READING_MAX_AGE = 300.0
LAND_LATCH_OVERRIDES = ("reading_above_reserve", "ends_at_reading_reset", "window_reset", "graphql_rest_judges")
LAND_LATCH_SECONDARY = "secondary"  # GitHub's secondary limit: /rate_limit cannot see it; it holds to its own until
LAND_QUOTA_REFUSAL = re.compile(r"quota: not judged|\[quota: not judged")
# An "unreadable" judgment (LAND_UNREAD_CODES) whose read the gh-quota shim refused, in the shim's own words. Read on
# that code's reason only: it names the read that failed, never a red job's log. Such a judgment is the login's state,
# not the PR's, so it parks until the reset it names (park_quota) as a "quota" answer does. The broker client
# gcp-agent-lane-1, 2026-11-19 22:38-22:50Z: 30 of 63 judgments were "unreadable" with "gh-quota: refused: GitHub's
# GraphQL rate limit is spent for login until 23:38Z"; each took the 120 s retry (LAND_RETRY_DEFAULT) and spent about 5
# REST (`pr view`, check-runs, runs) before its refused read. The 44 explains after an "unreadable" answer took 262 of
# session glaeda-land's 568 REST in those 12 min, with glaeda#2234's stagger loaded (it caps only latch-held entries).
# The broker's own words for the same refusal count too: lw#6031 at 803fcf96, gcp-agent-lane-1 2026-11-20 02:02Z, was
# "unreadable" with "gh api graphql failed: until 02:39Z (reset); not sent, retry after 02:39Z; reason: [RATE_LIMITED]"
# and took the 120 s retry until the reset.
# This host's own read guards refuse for the same reason and say so in their own words: the gh-quota shim in
# cache-only mode ("cache-only: not held in this host's caches") and glaeda-gh's sweep guard ("this caller read the
# jobs of 30 different runs or jobs in the last 10 minutes"). gcp-agent-lane-5, 2026-11-20: hq#13017, #12590, #12553
# and #12558 each stopped retry_deadline after about 6 h ("12928 s due and not judged, not counted" beside 21874 s
# counted); the counted judgments were these words, each taking the 120 s retry and counting toward the PR's deadline.
LAND_UNREAD_QUOTA = re.compile(r"gh-quota: refused: GitHub(?:'s)? (?:REST |GraphQL )?rate limit is spent"
                               r"|\[RATE_LIMITED\]|not sent, retry after \d\d:\d\dZ"
                               r"|cache-only: not held in this host's caches"
                               r"|glaeda-gh(?:'s sweep guard refused|: refused: this caller read the jobs of)")
# A step's own output (update-branch, rerun, merge) that GitHub refused for the login's quota, in the words the broker
# and the gh-quota shim use, as well as land_judge's. Read on a step's output only, never on land_judge's reason (which
# can quote a red job's log). Before, only land_judge's words parked a step: cmux#42244's update-branch was refused
# "GitHub rate limit (HTTP 403) on the broker host's gh login" twice, each judgment after it counted, and the entry
# stopped "3 identical refusals in a row" at 19:17Z on a quota that reset minutes later.
LAND_STEP_QUOTA = re.compile(LAND_QUOTA_REFUSAL.pattern + r"|GitHub(?:'s)? (?:REST |GraphQL )?rate limit"
                             r"|rate limit is spent|secondary rate limit|content-creation cooldown", re.I)
# The time a refusal names, in gh_latch.reset_from's order: land_judge's "no attempt before", then "retry after" /
# "until" (the latch SENTENCE). HH:MMZ with no seconds is the end of that minute, as gh_latch reads it.
LAND_QUOTA_SAID = (re.compile(r"\bno attempt before\s+(\d{2}):(\d{2})(?::(\d{2}))?Z"),
                   re.compile(r"(?:\bretry after|\buntil)\s+(\d{2}):(\d{2})(?::(\d{2}))?Z"))
# A step land_judge named that then fails at the same head is never sent again on a short timer. gcp-agent-lane-3,
# 2026-11-17: explain answered "ok, merge" for cmux#45102 at 43cac146 and the pinned merge failed after it, 27 times
# in 59 min; cmux#44496's update-branch was refused the same way 30 times in 40 min, and that day's land took explain
# 1218, update_branch 524 and merge 454 steps for about 12 PRs (session:glaeda-land: REST 963 + GraphQL 1148 an hour).
# Each "ok" answer cleared the refusal streak, so the merge's own refusal never counted toward a stop, and a refused
# step was judged again 5 s (merge) or 60 s (update-branch) later. Now a step refused at the same head (step_refused):
# - takes the step the refusal itself names, when it names one this queue runs: an update-branch (LAND_STEP_NEXT_UPDATE)
#   or a wait on the PR's checks (LAND_STEP_NEXT_WAIT: an event wait on the daemon's cache, no explain until it moves);
#   a named wait is never counted toward LAND_STEP_STOP (LAND_WAIT_STUCK bounds it);
# - else waits LAND_STEP_BACKOFF, doubling with each identical refusal at that head, at most LAND_STEP_BACKOFF_MAX;
# - and stops the entry, telling the requester, at the LAND_STEP_STOP-th identical refusal at that head. A new head
#   starts the count again. An "ok" judgment never clears it: only the step's own success or a new head does.
LAND_STEP_BACKOFF = 60.0
LAND_STEP_BACKOFF_MAX = 1800.0
LAND_STEP_STOP = 6  # 60+120+240+480+960 s of backoff (~31 min) before the 6th identical refusal stops it
# A step that timed out (exit 124: LandQueue.call's bound) or that GitHub answered 5xx is transient: it never counts
# toward LAND_STEP_STOP. It backs off on its own count (e["stepTransient"], per head) and stops "<kind>_transient" only
# after LAND_RETRY_STREAK_STOP in a row, a stop LAND_REARM_CODES re-arms. cmux#46145, 2026-11-19: five broker refusals
# and one "timed out after 120s" stopped it update_branch_refused, the timeout counted as the sixth.
LAND_STEP_TRANSIENT = re.compile(r"\btimed out after \d+s\b|\bHTTP 5\d\d\b|\b5\d\d (?:Bad Gateway|Service Unavailable"
                                 r"|Gateway Time-?out|Internal Server Error)\b|\bconnection (?:reset|timed out)\b",
                                 re.I)
# A refusal whose step is an update-branch (land_judge's action kind "update_branch", any code: tip_merge, stale_green,
# ws_check_stale_base, startup_failure, red_not_excused with --needs-newer-base) is taken, not counted. Before, the
# judgment counted it toward LAND_STREAK_STOP before the step ran, so an update refused once or twice at a head (or
# deferred, or sent with the cache still showing the old head) stopped the entry at the third judgment with the named
# update never done: cmux#45870 on gcp-codex-lane-11, 2026-11-18 (judged, refused, judged, refused, judged: "3 identical
# refusals in a row"), and claude-sr2-coord ran the update by hand on cmux#44938, #45870, #45709 and #46281 within the
# hour. Decided (claude-sr2-coord): "when land_judge's refusal names an update-branch (expected_head_sha=...), the
# daemon runs it once per head and requeues, with no third refusal and no person". So update_branch:
# - sends it pinned to the judged head (take refuses any other pin), at most once per head: e["updateSent"] is written
#   when the step is claimed (a restart mid-send counts as sent) and dropped when the step is refused before GitHub;
# - a refused send backs off on the step's own count (step_refused, LAND_STEP_STOP), never the judgment's;
# - a second refusal naming the update at a head it was sent at waits for the new head instead, and stops, saying so,
#   once LAND_UPDATE_ONCE has passed since the send with no new head.
# A teammate's PR is a land_judge stop (code teammate) before any update is named, so this never sends one there.
LAND_UPDATE_ONCE = 3600.0
LAND_STEP_NEXT_UPDATE = re.compile(r"\bnext: (?:gh pr update-branch \d+|gh api -X PUT \S*/pulls/\d+/update-branch)")
LAND_STEP_NEXT_WAIT = re.compile(r"\bnext: glaeda-gh wait pr \S+[^\n;]*?(?:--timeout (\d+))?(?=\s*(?:\(|$|\n|;))")
LAND_STEP_CODE = re.compile(r"\brefused \[([a-z_]+)")
# A finished PR is never stepped. manaflow-ai/cmuxterm-hq#13226, 2026-11-18: it merged at 07:38Z (squash e2c89417ace1)
# while this lane VM's copy of it stayed OPEN (every broker refresh refused "read Apps busy"). land_judge judged the
# stale head tip_merge against its own squash merge ("base commit e2c89417ace1 ... changed goals/agent-shortcut-found.md,
# which this PR changes"), the queue sent update-branch 12 times ("PR 13226 is closed ..."), and 7 hours later stopped on
# "3 identical refusals in a row", telling the requester to update a merged PR's branch. Now:
# - an entry whose PR reads MERGED ends merged (with the merge commit), CLOSED ends stopped "closed unmerged": no step,
#   no refusal counted, no message asking for one (LandQueue.ended), whether the cache, a merge's read or a state read
#   says so;
# - a step GitHub refused because the PR is closed (LAND_STEP_CLOSED) is not counted: the PR's state is read
#   (LandQueue.state_first) before anything else is judged or taken for it;
# - on a host that reads PRs through an upstream (a lane VM), a base-changing step (LAND_STATE_FIRST_KINDS: its
#   base change can be the PR's own merge commit) is never taken on a copy older than LAND_REFRESH_AFTER: the state is
#   read first. A state read that fails is no refusal either: the entry waits and reads it again (backoff doubling to
#   LAND_STEP_BACKOFF_MAX), and stops only after LAND_RETRY_STREAK_STOP failed reads in a row.
# A broker refusal "closed or its head is not a branch of" also fits a fork's open PR: a read that says OPEN at that
# head lets the next such refusal count as before (stateOpen).
# A draft PR is a permanent refusal, not a streak: GitHub answers every mergePullRequest on it "Pull Request is still
# a draft", so the backoff spent LAND_STEP_STOP merge calls (~31 min) on an answer the first one already gave, and the
# stop named no step. efficiency-standing-lane, 2026-11-21: leo-workspace#7087 was pushed as a draft by the
# PreCompact checkpoint hook (tools/wip_checkpoint.py opens one), and `land` reported merge_refused after six identical
# refusals with the GraphQL pool at its floor. Stopping at the first one names `gh pr ready`, the step that clears it.
# Nothing here marks a PR ready: that is a state change on someone's PR (a teammate's included), so it stays the
# requester's call.
LAND_STEP_DRAFT = re.compile(r"\bPull Request is still a draft\b|\bpull request is in draft state\b"
                             r"|\bdraft pull requests? (?:cannot|can not|can't) be merged\b", re.I)
# The other half of the same answer: *when* it is given. Stopping at the first merge refusal still spends the whole
# wait before it -- the CI wait, the judgment, the merge call -- on a property of the PR the request could have read.
# efficiency-standing-lane, 2026-11-21: one host's queue stopped 7 rows merge_draft, 139 min between their land
# requests and those refusals in total (median 13.6, worst 53.3: manaflow-ai/cmuxterm-hq#16729), every refusal
# carrying "land-judge (pass): ok: ... may merge at <sha>" -- the judge passed, the checks passed, and the merge
# was refused for `isDraft`, which was already true when `land` was typed. They then sat stopped another 65 min in total waiting to be noticed. Re-queued after a
# `gh pr ready` they merged in 30-136 s, first try, all of them.
# So `land` answers it at the request now (land_draft_refusal), under three bounds:
# - no read of its own: only this host's cache, so a land is still queued whatever the quota (check_land_pin's rule).
#   An absent, failed or stale read refuses nothing, and the request is queued exactly as before.
# - LAND_DRAFT_AGE, the live-field bound BROKER_MAX_AGE (`isDraft` is in BROKER_LIVE_FIELDS): a draft read older than
#   that is not an answer anything may refuse on, and a write that could have marked the PR ready (gh_cache_writes,
#   stamped by the brokered `gh pr ready` itself) after the read drops it too.
# - the merge-time check above stays: a PR can be converted back to a draft after its request, and this one answers
#   only the rows where the cache already knew. Nothing here marks a PR ready either -- `gh pr ready` is the
#   requester's call, as it is above, and [hold-own-pr] exists so a draft can be a deliberate hold.
LAND_DRAFT_AGE = 90.0  # == BROKER_MAX_AGE, asserted by a test (the daemon's cycle is 60 s)
# A merge conflict between a PR's base and its head is permanent at that head too, the same way: GitHub decides it
# from the two trees, so the same update-branch (or merge) at the same head cannot answer anything else, and only a
# push that resolves it can. efficiency-standing-lane, 2026-11-21: one host's `land status` held four rows stopped
# update_branch_refused on {"message":"merge conflict between base and head"} (HTTP 422), each after 6 identical
# update-branch calls at one head -- 48 of the host's 57 conflict refusals that day were the 2nd through 6th of a
# streak -- and the stop's `next:` was empty (the refusal names no step of its own), so manaflow-ai/cmuxterm-hq#13750
# sat parked 3343 min, #13608 1923 min and #13624 836 min with nobody told what to do. Stopping at the first refusal
# names the one step that clears it: resolve the conflict and re-land pinned. Nothing here rebases or pushes anything:
# that is a write on someone's branch, so it stays the requester's call, as the draft case stays theirs.
LAND_STEP_CONFLICT = re.compile(r"\bmerge conflict between base and head\b"
                                r"|\b(?:pull request|PR) has merge conflicts\b"
                                r"|\bmerge conflicts? must be resolved\b", re.I)
# A refusal that asks in its own words to be tried again is a queue in front of the step, not an answer about the
# head: the broker's lane lease is held by another session, or its read Apps are busy. Those are the one family whose
# refusals still count per class rather than per head (the sig below), so that two of them alternating keep the entry
# waiting instead of stopping it -- glaeda#2239's router review found exactly that, and it stays true.
LAND_STEP_RETRYABLE = re.compile(r"\btry again\b|\bis held by another session\b|\b(?:are|is) busy\b", re.I)
LAND_STEP_CLOSED = re.compile(r"\bPR #?\d+ is closed\b|\bpull request (?:#?\d+ )?(?:is|was) (?:closed|already merged)\b"
                              r"|\bwas already merged\b|\bpull request is not open\b|\bPR is (?:closed|not open)\b",
                              re.I)
LAND_STATE_FIRST_KINDS = frozenset({"update_branch", "retarget", "rerun_failed"})  # a merge reads it after (do_merge)
# The check snapshot land_judge explain judges from (ROLLUP_DIR's comment): the per-judgment copy's file under
# land/LAND_SNAPSHOT_DIR, named to land_judge by LAND_SNAPSHOT_ENV. It is handed over only when the daemon's cache
# entry shows the same head and fingerprint it was read at, within LAND_SNAPSHOT_MAX_AGE (land_judge keeps its own
# bound too). A head the snapshot does not hold yet waits up to LAND_SNAPSHOT_WAIT for the daemon's next full read
# (nudged), then land_judge reads it itself, as before; an upstream host (a lane VM) keeps no snapshot and never waits.
LAND_SNAPSHOT_ENV = "LAND_JUDGE_ROLLUP_SNAPSHOT"
LAND_SNAPSHOT_SCHEMA = "land-judge-rollup-snapshot/v1"
LAND_SNAPSHOT_DIR = "snapshots"
LAND_SNAPSHOT_MAX_AGE = 300.0
LAND_SNAPSHOT_WAIT = 120.0
# A wait parked on the PR's checks is read at full pace again this long before it wakes, so the judgment its own
# timeout asks for is handed a snapshot instead of paying for a live read. Two constants decided this on their own:
# a parked entry's unwaited read comes at most every LAND_PEEK_EVERY (600 s), which is strictly looser than the
# LAND_SNAPSHOT_MAX_AGE (300 s) a snapshot must be inside, so a wait_pr verdict that slept its 1800 s woke with a
# cache that could not qualify -- snapshot() answered "wait", snapshot_wait() nudged a read and gave it
# LAND_SNAPSHOT_WAIT, and when that ran out the judgment went live. Measured on this host 2026-11-17..21: the
# snapshot share of explains fell 94% -> 85% -> 71% -> 56% -> 35% as more lands parked on check waits, and 136 of
# 232 snapshot waits ended snapshot_missing. An explain costs a median of 4 GitHub calls (p90 24, max 52, 82%
# REST), and the ones at an unmoved fingerprint cost no less than the rest, so this is where that spend goes.
# Nothing about the judgment changes: it is asked at the same moment, of the same tool, and every verdict's own
# wait is still honoured to the second. Only the evidence handed to it is fresh. Inside LAND_SNAPSHOT_MAX_AGE with
# room for the read to land, and the read is one the daemon's batch was going to make anyway.
LAND_WAKE_PREFETCH = 180.0
# Judgments run on the land workers and are handed one only when one is free (LandQueue.judge), least recently judged
# first (LandQueue.judge_order). huge-blue, 2026-11-18: every due judgment went onto the pool's own queue at once (596
# lands, 4 workers), hours deep; each update's re-exec (glaeda releases land 10-60 min apart) dropped that queue and
# the next daemon judged from the top again, so cmux#45661 (SHIP, CLEAN, 60/60 green) went 7 h unjudged, its history
# ending at snapshot_missing every pass: every due land waited on its snapshot at once, so the reads they were put
# first for (Daemon.snapshot_waits) could not come within LAND_SNAPSHOT_WAIT. Ahead of the workers at most this many
# per worker wait on their snapshot reads.
LAND_SNAPSHOT_AHEAD = 1
LAND_POOL_LOG_EVERY = 300.0
LAND_LATCH_FREE_EVERY = 60.0  # how often an owner's unlatched read source is asked again (LandQueue.latch_free)
LAND_LATCH_FREE_DEADLINE = 10.0  # the land-pool log line (LandQueue.log_pool)
# The head a judgement pins is the cache's only when the cache read the PR after the entry was unparked or the login's
# latch last cleared (LandQueue.fresh_head). huge-blue, 2026-11-18 09:43Z: parked on the latch, the daemon read
