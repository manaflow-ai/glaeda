HEAD_MISSING_RETRY = 600  # a commit GitHub does not know is asked about this rarely
# A head with more checks, statuses or workflow runs than one REST read pages through (REST_CHECK_PAGES and the rest) is
# asked over REST again only this rarely: those counts only grow, so a retry cannot answer, and GraphQL (up to
