TOUCH_EVERY = 30  # clients refresh their interest this often
DOWN_GRACE = 5.0  # clients look this long for the daemon before calling it down (it re-executes on update)
# A wait that finds the daemon down keeps waiting this long before it gives up: launchd holds a
# respawn back for up to ThrottleInterval (30 s) after a short run, and on 10-20 every wait that
# exited in that window had its session kickstart the daemon again, killing the one just started.
DOWN_PATIENCE = 90
RESTART_COOLDOWN = 180  # `glaeda-gh restart` within this long of the last one waits instead of restarting again
RESTART_SETTLE = 45  # how long `restart` waits for a new daemon's heartbeat
BOOTSTRAP_RETRY = 10  # launchctl bootstrap is retried this long after bootout
HEARTBEAT_EVERY = 30  # the daemon rewrites daemon.json at least this often
# A request's socket timeout bounds each read, not the request: a server that trickles bytes, or a tick
# of many slow reads, kept one 10-20 daemon silent for 20 minutes. So every request also has a hard
# wall-clock deadline, a tick stops starting requests after TICK_BUDGET (the rest go first next tick),
# and a watchdog thread exits the process when the loop has not come round for WATCHDOG_AFTER, so
# launchd or systemd starts a fresh one.
SOCKET_TIMEOUT = 20  # each connect, TLS handshake and read
HTTP_DEADLINE = 45  # one whole GitHub request, from connect to the last body byte
SUBPROCESS_DEADLINE = 20  # gh auth token, launchctl, ps: killed with their whole process group after
TICK_BUDGET = 90  # seconds a tick may spend starting requests
WATCHDOG_CYCLES = 5
WATCHDOG_AFTER = WATCHDOG_CYCLES * CYCLE  # the loop silent this long is hung: exit EXIT_WATCHDOG
EXIT_WATCHDOG = 75  # EX_TEMPFAIL: the service manager restarts the daemon
# The watchdog thread logs before it exits, so a main thread stuck inside a write to stdout or stderr
# (a full pipe, a hung disk) holds the stream lock it needs. faulthandler's own C thread needs neither
# the GIL nor that lock: it ends the process (status 1) this long after the watchdog should have.
WATCHDOG_BACKSTOP = 60
STALE_HEARTBEAT = 2 * WATCHDOG_AFTER  # a lock holder silent this long is hung; a waiting daemon takes over
LOCK_RETRY = 15  # a daemon waiting for the lock looks at its holder this often
TAKEOVER_GRACE = 10  # after SIGTERM, how long a hung holder has before SIGKILL
FAILING_AFTER = 120  # every tick raising for this long is a broken daemon, not a transient error
