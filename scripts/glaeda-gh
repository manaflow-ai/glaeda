REST_COUNTERS = 4  # most core counters budget.json keeps (GitHub showed two per token on 2026-10-30)
RESET_JITTER = 2  # seconds: two readings whose resets differ by at most this are one core counter
# The REST paths GitHub always answered from one core counter, the "actions" one (X-RateLimit-Reset of real answers,
# cosmic-gray 2026-11-04 06:15-06:20Z, 28 of 28): a run, its attempts and artifacts, and workflows (a list, one, its
# runs, its dispatches). Pulls, a repo, check runs, the runs list, a run's jobs and /rate_limit answered mostly from
# the other counter and now and then from this one, so no reading of theirs can name a counter. A reading from one of
# these paths tags its counter "actions" in restCounters, so gh-quota (leo-workspace tools/gh_quota.py rest_reading)
# can hold a call to the counter it spends rather than the poorest.
ACTIONS_COUNTER_PATH = re.compile(r"/repos/[^/]+/[^/]+/actions/(?:workflows(?:/[^?]*)?|runs/\d+(?:/attempts/\d+|/artifacts)?)(?:\?.*)?")
GQL_BATCH = 15  # most PRs (or runs, or comment watches) per GraphQL query
# GitHub answers 504 when a query runs past ~10 s. Measured 2026-10-19 on cosmic-gray: 25 PRs per
# query took 10-11 s (half answered 504), 10 took 4-6 s, 5 took 2-3 s; each cost 1 point. So each
# kind's batch starts at GQL_BATCH_START, halves on a 504 or timeout, and grows by one after
# GQL_GROW_AFTER clean queries in a row.
GQL_BATCH_START = 10
GQL_GROW_AFTER = 5
GQL_SPLITS = 8  # queries a kind may add per tick by splitting timed-out batches
GQL_BATCH_MIN = 2  # each query costs a point however small, so the batch never drops below this
SLOW = re.compile(r"HTTP 504|[Tt]imeout|timed out|[Rr]esource limits")  # the query took too long: shrink and split
# GitHub caps the work one query may do. Past it, it answers 200 with the data it got and, per field it gave up on, a
# null beside an error of type RESOURCE_LIMITS_EXCEEDED ("Resource limits for this query exceeded."). On ten large
# cmux PRs read ten to a query (2026-11-08) 5 of the 10 came back partial so, read pending, and read again partial
# next cycle. batched() halves the batch (down to 1, not GQL_BATCH_MIN: a PR this heavy is the point of reading it
# alone) and re-reads only the partial entries at the smaller size; GQL_GROW_AFTER clean queries grow it back by one.
RESOURCE_LIMITS = "RESOURCE_LIMITS_EXCEEDED"
def heavy_pause(fails: int) -> float:
    """Seconds a heavy entry waits between lone GraphQL reads while REST cannot take it: 30 s, doubling per failure past
    HEAVY_AFTER, at most 10 minutes. Per entry: one slow PR never slows the batches or the other heavy entries."""
    return float(min(600, 30 * 2 ** max(0, fails - HEAVY_AFTER)))


HEAVY_AFTER = 3  # lone timeouts in a row after which a heavy entry is read only every LEAN_FACTOR cycles
# A due PR no tick stores a clean read of (Daemon.note_unread). cmux-cp-1, 2026-11-25: manaflow-ai/cmux#46795 (195-285
# checks) made every PR batch it sat in answer 502; the tick's GQL_SPLITS ran out before it was ever read alone, so
# `heavy` never learned it, its chunk went to REST (capped) and back to a deferral, and for 14 h nothing was stored:
# no read, no error, "data 838m ago" while the stale valve re-executed the daemon every 30 min to no effect. A PR whose
# GraphQL chunk was sent and failed it on UNREAD_ALONE_AFTER ticks is read alone, ahead of the batches (at most
# UNREAD_ALONE_MAX a call), so it cannot keep failing its batch or wait on the split budget; and a waited one unread on
# that many due ticks says so, on its entry (unreadWhy, which `status` prints) and in the refresh log, naming the PR
# and what held it, every UNREAD_NOTE_EVERY while it lasts (UNREAD_NOTE_LINES lines a tick, the rest counted).
UNREAD_ALONE_AFTER = 2
UNREAD_ALONE_MAX = 3
UNREAD_NOTE_EVERY = 300.0
UNREAD_NOTE_LINES = 5
# GraphQL down, REST up. huge-blue 2026-11-17: GitHub's GraphQL answered 502 for long stretches (and the controller
# URLError) and waited PR data reached 3585 s, then 1392 s old, with the heartbeat fresh, both times until a session
# restarted the daemon. A 502 only split the batch and left it for the next cycle, so a kind routed to GraphQL was
# never read at all while it lasted, though REST answered. Now an entry GraphQL fails with a 5xx (or no answer at all)
# that cannot be split further is read over REST this tick, and GQL_DOWN_AFTER such failures in a row over at least
# GQL_DOWN_SPAN with no clean GraphQL answer between take GraphQL out for GQL_DOWN_BACKOFF (doubling to GQL_DOWN_MAX
# while the first query after each hold fails again): its reads go to REST at once instead of each spending ~10 s of
# the tick on another 502. One clean answer ends it. The span keeps one PR GitHub fails alone from taking GraphQL out
# for everyone: the split halves without it answer, every tick.
GQL_DOWN_AFTER = 3
GQL_DOWN_SPAN = 60
# Every refresh failure is written down where it can be read after the fact (huge-blue 2026-11-17: the 502s were only
# in daemon.json's health record, not one journal line, so nobody could read the stall afterwards): one line on stderr
# (the journal, or launchd's log) and in BASE/refresh-errors.log, with the UTC time, the source, the error, what it hit
# and what happens next. The first failure of a (source, error) prints in full, then one line per REFRESH_NOTE_EVERY
# with the count, so a 30-minute 502 storm is a few dozen lines, not one per PR per tick. The file is cut to its
# newest half past REFRESH_LOG_MAX; `glaeda-gh budget` prints its last REFRESH_LOG_SHOWN lines.
REFRESH_NOTE_EVERY = 60
REFRESH_LOG = "refresh-errors.log"
REFRESH_LOG_MAX = 1024 * 1024
REFRESH_LOG_SHOWN = 5
GQL_DOWN_BACKOFF = 60
GQL_DOWN_MAX = 600
# GitHub failed the query (a 5xx, or no answer): split and retry, then REST. A 504 or a timeout is SLOW instead.
GQL_DOWN = re.compile(r"HTTP 5(?!04)\d\d|request failed: (?!TimeoutError)")
# A 502 or 503 that came only after this long is GitHub giving up on a query past its time budget, not GraphQL down:
# it is the batch's doing, so it shrinks the batch like a 504 (SLOW) and counts nothing toward GQL_DOWN_AFTER. The
# broker host, 2026-11-22 04:08Z, the ci-watch App reading cmux PRs (each ~61 KB of checks) with the daemon's own
# pr_query: 1 PR 4.0 and 5.8 s, 2 PRs 3.1 and 2.4 s, 4 PRs HTTP 502 after 14.1 and 10.9 s, 8 PRs HTTP 502 after 12.2
# and 15.7 s. The batch sat at 8, every query 502'd, the 502s took GraphQL "down" and every PR went to REST one at a
# time: 143 PR reads stored in 600 s against ~1,000 waited PRs, waited data 17,794 s old.
GQL_SLOW_5XX_AFTER = 8.0
GQL_NO_ANSWER = re.compile(r"request failed: (?!TimeoutError)")  # GQL_DOWN with no answer: REST reads it, unsplit
MAX_BODY = 8 * 1024 * 1024
WAIT_POLL = 3  # clients re-read the cache this often
TOUCH_EVERY = 30  # clients refresh their interest this often
DOWN_GRACE = 5.0  # clients look this long for the daemon before calling it down (it re-executes on update)
# `read` (an upstream serving its downstreams) looks this long before answering "not running", which each downstream
# stores on every key it asked for. huge-blue's glaeda-gh took 9 s to restart (2026-11-18, 21:10:12-21:10:21) against
# DOWN_GRACE's 5, so every lane VM was told it was down. Twice that, and well inside UPSTREAM_DEADLINE. Kept apart
# from DOWN_GRACE, which a local `status`, `budget` or `restart` pays in full whenever the daemon really is down.
UPSTREAM_DOWN_GRACE = 20.0
# A wait that finds the daemon down keeps waiting this long before it gives up: launchd holds a
# respawn back for up to ThrottleInterval (30 s) after a short run, and on 10-20 every wait that
