# A run the controller still shows queued or in progress, that a wait is blocked on, and that neither changed nor
# was read from GitHub for this long, is read once more (a lost completion delivery: manaflow-ai/cmux run
# 40557947333, 2026-10-27, finished on GitHub while the controller kept it in_progress and its waiter blocked).
STALE_RUN_REREAD = 180
# A wait rules on a finished run only once GitHub itself has shown that finish since the wait began (or since a
# `gh run rerun` this host brokered): a cached or controller-fed finish can be the attempt a rerun superseded
# (manaflow-ai/cmux run 42368426030, 2026-11-07: `wait run` right after `gh run rerun --failed` returned attempt 1's
# failure at once, "data 0s ago", while GitHub had attempt 2 queued). The daemon reads it once for that
# (Daemon.due); when GitHub cannot be read this long (a spent quota), the wait rules on what it has, as before.
RUN_CONFIRM_MAX = STALE_RUN_REREAD
WAIT_PRIORITY = STALE_RUN_REREAD  # in a busy tick, a waited key is read as if this much longer unread
# The client's own controller long-poll before it hands its wait to the daemon (subscribe_wait). That poll does not
# see the cache, so a finish the daemon reads from GitHub (a lost delivery, STALE_RUN_REREAD) reaches the waiter
# only when it ends: at 300 s, a run finished at 20:46:40Z released its waiter at 20:51:16Z, 2 min after the
# daemon's 20:49:20Z read (2026-10-27). Once the daemon rules, it does so within a tick.
CLIENT_RUN_LONG_POLL = STALE_RUN_REREAD
# A watch counts as waited on this long after a wait (or a downstream's) last registered it: past the client's
# controller long-poll (subscribe_wait), which registers once before it blocks, and the daemon's touches after it.
WAIT_INTEREST = CLIENT_RUN_LONG_POLL + 2 * TOUCH_EVERY
