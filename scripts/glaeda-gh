# Reads a wait or a due land is blocked on go first in every window; watches nothing is blocked on still get one batch
# (one REST read) at least this often, per kind, so a blocked set past the pace cannot starve them (review of #2199).
PLAIN_FLOOR_EVERY = 60.0
