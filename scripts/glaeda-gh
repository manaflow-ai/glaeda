HEAD_OVERSIZED_RETRY = 1800
CONSUMER_WINDOW = 3600
# An asked head with no answer (`glaeda-gh checks` on a new SHA) is read over REST even when this daemon's REST share is
# spent and GraphQL is stopped, while the login's REST is above its floor: at most this many such reads an hour, each
# also charged to its consumer's cap. huge-blue 2026-11-20 14:2xZ: share 137 of 150, GraphQL 0 left, the account 2129
# REST left, and a merge-hold head stayed "unread (not read yet)" until the hour turned.
HEAD_DIRECT_MAX = 60
# A head asked after a tick's due phase (`glaeda-gh checks` on a new SHA: a merge gate's bounded wait) is read between
# that tick's read batches, not at the next tick's due phase. cosmic-gray, 2026-11-23 23:17-23:49Z: ticks ran 1.5-5 min
# (PR reads took 483 of 614 s), the lane-gh broker's land waits 20 s for an unread head (next_autoland
# CACHED_WEBVIEW_WAIT_S) after its 45 s live read, and fs-agent-lane-18's lands of cmux#52295, #52646, #52773 and
# #52296 were refused six times "glaeda-gh holds no checks for SHA (not read yet)": 93e83cd2 was asked at 23:37:35Z
# and read at 23:41:22Z, at the next tick. Looked for every HEADS_BETWEEN_EVERY s, at most one GraphQL batch or
# HEADS_BETWEEN_REST REST heads a look and HEADS_BETWEEN_TICK_MAX a tick, newest ask first, so a flood of asks (the
# land queue's, glaeda#2489) keeps its turn at the tick's due phase and never takes the tick from the waited PRs.
# And no look past the tick's heads' share (REST_HEAD_BUDGET, Daemon.past_heads_share) while a waited PR or run is due:
# the looks had no time bound, and a look's batch reads each head's suites, check pages and steps (a 285-check head is
