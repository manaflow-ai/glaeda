POST_SPACING = 3  # seconds between two content writes from this machine (GitHub: at least 1 s between writes)
POST_BACKOFF = 60  # a throttled write without Retry-After holds the outbox this long, doubling to POST_BACKOFF_MAX
POST_BACKOFF_MAX = 900
POST_ATTEMPTS = 6  # transport failures and 5xx answers before a write is given up
POST_RETRY = 30  # after a transport failure or 5xx, the write waits this long times its attempts
POST_KEEP = 7 * 86400  # finished writes stay this long for `post status`
POST_UNREADABLE = 60  # a queue file unreadable this long after its last write is dropped as failed
POST_BODY_MAX = 65536  # GitHub's limit for a comment, review or PR body
POST_ID = re.compile(r"\d{13}-\d+-[0-9a-f]{6}")  # queued-at ms, client pid, random: sorts oldest first
THROTTLED = re.compile(r"submitted too quickly|secondary rate limit|abuse detection", re.I)
# Comments for one thread that are in the queue together, queued within POST_JOIN_WINDOW of the first, go out as one
# comment: each body whole, in queue order, under a rule. Only what is already queued is joined (no write waits for a
# partner): over 2026-11-10 01:00-02:00Z, 110 comments went to 53 threads, and holding each for 60 s would have
# joined 3 of them while delaying all 110. A body that starts with a machine-read marker (`<!--`: review-running,
# pr-owner, risk receipts), a slash command or an @mention, or carries a status key is never joined: its readers read
# it whole, from its first line. Only one writer's comments are joined, and a join a wait began watching since is undone
# before its retry (post_unjoin).
POST_JOIN_WINDOW = 60
POST_JOIN_RULE = "\n\n---\n\n"
JOIN_MENTION = re.compile(r"(?<![\w.`])@[A-Za-z0-9][\w-]*")  # an @mention: a bot or a person is called; never joined
# A comment queued with --status-key KEY is that writer's status on its thread: the next one from the same writer
# ("by") with the same key edits it in place, over GraphQL, while it is still the thread's last comment, no comment
# wait watches the thread, and it is under POST_STATUS_MAX old. router-review's review-running marker and its
# verdict (one run token) were 2 comments per review, back to back: 25 of the 63 the shared login posted on the 20
# busiest threads in that hour.
POST_STATUS_MAX = 6 * 3600
STATUS_KEY = re.compile(r"[\w.:=@/-]{1,120}")
# A review-running marker (leo-workspace tools/review_running.py) still queued once its own run has ended is retired as
# superseded, never sent: its run's verdict or done line (`<!-- review-run=<run> -->`, or a comment keyed
# `review-run=<run>`) is queued or was posted on the thread. Sent after that end, it would hold the head's merge for
# nothing (review_running._runs counts only an end that comes after the marker). Receipts go out first (outbox_gate), so
# on huge-blue 2026-11-21 15:4xZ about 206 markers sat behind them. Nothing else retires one: another run's receipt at
# the same head leaves that run's own hold standing (cmux#31529's second review), and an old marker whose run never
# ended still starts review_running.slow()'s SHIP clock once posted (review_model). A queued end counts even if its own
# post later fails: the run has ended either way. RUN_ENDS records, per thread, the runs the outbox posted an end for
# (kept RUN_ENDS_KEEP).
REVIEW_MARK = re.compile(r"^<!-- review-running sha=([0-9a-f]{40}) at=(\S+) run=(run-[0-9a-f]{16}) by=([\w -]*) -->", re.I)
RUN_END = re.compile(r"<!-- review-run=(run-[0-9a-f]{16}) -->")
RUN_ENDS = "run-ends.json"
RUN_ENDS_KEEP = 24 * 3600
POST_STATUSES = "statuses.json"  # thread -> the last status comment the outbox posted there
POST_SUBJECTS = "subjects.json"  # thread -> its GraphQL node id (an issue's or PR's id never changes)
POST_EDITS = "edited.json"  # the comments the outbox edited in place: only their edits count as said again
POST_EDITS_KEEP = 2000
GQL_TRANSIENT = re.compile(r"something went wrong|timed? ?out|timeout|internal (?:server )?error|try (?:again|later)|"
                           r"service unavailable|temporarily|loading", re.I)
GQL_TRANSIENT_TYPES = frozenset({"INTERNAL", "INTERNAL_ERROR", "SERVICE_UNAVAILABLE", "TIMEOUT"})
GQL_REFUSALS = frozenset({"NOT_FOUND", "FORBIDDEN", "UNPROCESSABLE", "ARGUMENT_ERROR", "INSUFFICIENT_SCOPES",
                          "SAML_ERROR", "UNAUTHENTICATED"})
SUBJECT_QUERY = """query($o: String!, $r: String!, $n: Int!) { repository(owner: $o, name: $r) {
issueOrPullRequest(number: $n) { ... on Issue { id comments(last: 1) { nodes { id } } }
... on PullRequest { id comments(last: 1) { nodes { id } } } } } }"""
ADD_COMMENT = """mutation($s: ID!, $b: String!) { addComment(input: {subjectId: $s, body: $b}) {
commentEdge { node { id databaseId url authorAssociation author { __typename login } } } } }"""
EDIT_COMMENT = """mutation($c: ID!, $b: String!) { updateIssueComment(input: {id: $c, body: $b}) {
issueComment { id databaseId url authorAssociation author { __typename login } } } }"""
# Match cmux's base-owned risk classifier. This only wakes that classifier; it never grants SHIP authority.
RISK_RECEIPT = re.compile(r"^\W*(?:independent\s+)?review\s*\(([^)\n]*)\)\s*:\W*(ship|block|fix|not ship|hold)(?![\w-])",
                          re.I)
# GitHub Event Streams (cmuxterm-hq#24703, Leo 2026-11-24: "4. event streams. let's all go look into these and
# gogog"). The controller holds one stream per pull request somebody waits on (GET /v1/github/streams?v=1&want=...),
# shared by every host. Every STREAMS_EVERY seconds the daemon names its waited, open PRs; one whose stream is live
# since before its last read, settled (every check finished, mergeable known) and quiet since, is read every
# EVENT_BACKSTOP seconds instead of every cycle: a stream event on it nudges a read at once. A controller without the
# route (404) or of another version (400) or with streams off answers nothing and polling is unchanged; it is asked
# again after STREAMS_RETRY. GLAEDA_GH_STREAMS=off or {"streams": false} in gh-daemon.json turns it off.
EVENT_STREAMS = True
EVENT_BACKSTOP = 300
STREAMS_EVERY = 20
STREAMS_RETRY = 600
STREAMS_WANT = 90  # (the controller holds at most 90 streams; it answers the rest not live)
STREAMS_VERSION = 1


def outbox_gate(item: Any) -> bool:
    """A write a merge waits on: queued with --gate, or a comment whose first
    line is a review receipt (router-review's `Review (...): SHIP at SHA`). These go out ahead of every other queued
    write, so a SHIP never waits behind a hundred awareness comments while the login's create pause spaces them."""
    if not isinstance(item, dict):
        return False
    if item.get("gate") is True:
        return True
    body = str(item.get("body") or "")
    first = next((line for line in body.splitlines() if line.strip()), "").strip()
    return item.get("kind") == "comment" and bool(RISK_RECEIPT.match(first))


def thread_of(item: Any) -> str:
    return f"{str(item.get('repo') or '').lower()}#{item.get('number')}" if isinstance(item, dict) else ""


def run_end_of(item: Any) -> str | None:
    """The review run this queued or posted comment ends (superseded_by): its done line, or its run's status key."""
    if not isinstance(item, dict) or item.get("kind") != "comment":
        return None
    body = str(item.get("body") or "")
    if REVIEW_MARK.match(body):
        return None  # a marker ends nothing, even with its run's status key
    ended = RUN_END.search(body) or RUN_END.search(f"<!-- {item.get('status') or ''} -->")
    return ended.group(1) if ended else None


def superseded_by(item: Any, queue: list[tuple[Path, Any]], ended: dict) -> str | None:
    """Why a queued review-running marker need not go out (REVIEW_MARK's notes), or None: it must."""
    if not isinstance(item, dict) or item.get("kind") != "comment":
        return None
    mark = REVIEW_MARK.match(str(item.get("body") or ""))
    if not mark:
        return None
    run, thread = mark.group(3), thread_of(item)
    record = ended.get(thread)
    runs = record.get("runs") if isinstance(record, dict) else None
    if isinstance(runs, dict) and run in runs:
        return f"its run {run} already posted its verdict or done line on {thread}"
    for _, other in queue:
        if other is not item and thread_of(other) == thread and run_end_of(other) == run:
            return f"its run {run} has its verdict or done line queued ({other.get('id')})"
    return None


def note_run_ends(item: Any, at: float) -> None:
    """Record the run a posted comment ends (run_end_of) for superseded_by, pruned past RUN_ENDS_KEEP."""
    run = run_end_of(item)
    if not run:
        return
    path = BASE / RUN_ENDS
    doc = read_json(path)
    doc = doc if isinstance(doc, dict) else {}
    record = doc.get(thread_of(item))
    runs = record.get("runs") if isinstance(record, dict) else None
    doc[thread_of(item)] = {"runs": {**(runs if isinstance(runs, dict) else {}), run: at}}
    cut = at - RUN_ENDS_KEEP
    for thread in list(doc):
        runs = doc[thread].get("runs") if isinstance(doc[thread], dict) else None
        runs = {r: t for r, t in (runs if isinstance(runs, dict) else {}).items()
                if isinstance(t, (int, float)) and t > cut}
        if runs:
            doc[thread] = {"runs": runs}
        else:
            doc.pop(thread)
    write_json(path, doc)


def outbox_queue() -> list[tuple[Path, Any]]:
    """The outbox in send order: land-gating writes (outbox_gate) first, then the rest, each in queue order
    (oldest first). An unreadable entry keeps its queue place among the rest."""
    if not outbox_dir().is_dir():
        return []
    rows = [(path, read_json(path)) for path in sorted(outbox_dir().glob("*.json"))]
    return sorted(rows, key=lambda row: not outbox_gate(row[1]))  # stable: queue order within each class


VERDICTS = {"success", "neutral", "failure", "timed_out", "action_required", "startup_failure"}

NAME = r"[A-Za-z0-9_.-]+"
PR_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/pull/)(\d+)(?:[/?#].*)?")
RUN_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})/(?:actions/runs/)?(\d+)(?:[/?#].*)?")
ISSUE_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/pull/|/issues/)(\d+)(?:[/?#].*)?")
HEAD_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:@|/commit/)([0-9a-fA-F]{{40}})")
# A *key's* target comes with its kind named, so the separator before the number can be whichever one the
# caller typed: `#`, the URL's own path, or a plain `/`. `o/r/5` was 153 of the 358 targets this host's
# transcripts had refused by 2026-11-21 (a bare number another 173; see cwd_repo), and with the kind given
# none of it is ambiguous. A pr target still refuses `o/r/issues/5`: an issue is not a pull request.
# infer_kind keeps the strict forms above, where the kind is *not* given and `o/r/12345678901` is a run.
PR_KEY_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/pull/|/)(\d+)(?:[/?#].*)?")
RUN_KEY_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/(?:actions/runs/)?)(\d+)(?:[/?#].*)?")
ISSUE_KEY_RE = re.compile(rf"(?:https://github\.com/)?({NAME})/({NAME})(?:#|/pull/|/issues/|/)(\d+)(?:[/?#].*)?")
# `origin` as GitHub writes it, for a bare number's repository (cwd_repo)
REMOTE_RE = re.compile(rf"(?:git@github\.com:|(?:https?://|ssh://git@)github\.com/)({NAME})/({NAME}?)(?:\.git)?/?")
KEY_RES = {"pr": PR_KEY_RE, "run": RUN_KEY_RE, "comment": ISSUE_KEY_RE, "head": HEAD_RE}
# `KIND:TARGET` -- the notation this tool *prints* for a target, and so the string an agent copies out of a
# line and back into the next call. parse_key's output (`pr:owner/repo#5`, `run:owner/repo/123`) names the
# target in every waiting, still-waiting and summary line, and until 2026-11-21 handing one back was an
# argparse refusal ("argument kind: invalid choice: 'pr:teamleaderleo/leo-workspace/7241'") that cost a
# whole background wait: the job printed a usage block and exited having waited on nothing. Accepted
# everywhere a target is: the prefix carries the kind, so nothing here is a guess across kinds -- a prefix
# naming a *different* kind than the command's refuses, and names the spellings (drop_kind_prefix).
PREFIX_KINDS = ("pr", "run", "comment", "head", "file", "pid", "until")
STATUS_KINDS = ("pr", "run", "comment")  # the kinds `status` takes; `head` is read for a PR, never asked for
WAIT_KINDS = STATUS_KINDS + ("file", "pid", "until")
KIND_PREFIX_RE = re.compile(rf"({'|'.join(PREFIX_KINDS)}):\s*(\S.*)", re.I | re.S)
# The spellings of one target, for a refusal to name. `wait until`'s own targets (`quota:rest`) hold a
# colon that is not a kind, and a URL's `https:` is not one either: both fall through unchanged.
KIND_FORMS = {"pr": "OWNER/REPO#N, OWNER/REPO/N, pr:OWNER/REPO#N, a bare N in this checkout, or a pull request URL",
              "run": "OWNER/REPO/RUN_ID, OWNER/REPO#RUN_ID, run:OWNER/REPO/RUN_ID, or a run URL",
              "comment": "OWNER/REPO#N, OWNER/REPO/N, comment:OWNER/REPO#N, a bare N in this checkout, "
                         "or an issue or pull request URL",
              "head": "OWNER/REPO@SHA, head:OWNER/REPO@SHA, or a commit URL",
              "file": "a path, or file:PATH", "pid": "a process id, or pid:PID",
              "until": "quota, quota:rest, quota:graphql, an ISO time, a UTC time (14:40Z) or a duration (45m)"}


def split_kind_prefix(text: str) -> tuple[str, str] | None:
    """`("pr", "o/r#5")` for `pr:o/r#5`, the notation this tool prints; None when there is no kind prefix."""
    match = KIND_PREFIX_RE.fullmatch(text.strip())
    return (match.group(1).lower(), match.group(2).strip()) if match else None


def drop_kind_prefix(text: str, kind: str, also: tuple[str, ...] = ()) -> str:
    """TEXT without the `KIND:` prefix this tool prints for it, for a caller that already knows the kind.

    A prefix naming another kind is never read as this one: `wait pr run:o/r/123` refuses, and says which
    spellings a pr target has, rather than reading the run id as a pull request number. ALSO names the
    other prefixes this caller accepts (`post comment pr:o/r#5` posts on that pull request's thread)."""
    split = split_kind_prefix(text)
    if split is None:
        return text.strip()
    named, rest = split
    if named == kind or named in also:
        return rest
    forms = KIND_FORMS.get(kind, "")
    raise WatchError(f"{text!r} names a {named} target, but this is a {kind} target: a {kind} is "
                     f"{forms or 'named by its own form'}"
                     + (f"; a {named} target goes to a {named} call" if named in PREFIX_KINDS else ""))
CYCLES = {"pr": CYCLE, "run": CYCLE, "comment": COMMENT_CYCLE, "head": CYCLE}
BUCKETS = {"pr": "graphql", "run": "rest", "comment": "graphql", "head": "graphql"}  # each kind's usual bucket
OTHER = {"rest": "graphql", "graphql": "rest"}
BALANCED = ("pr", "run")  # kinds either bucket can read, routed to the richer one every tick
# Kinds GraphQL reads more cheaply (a comment watch every 15 s, a head in one aliased query) that REST
# reads only while GraphQL is low (below its floor) or throttled and REST is not.
FALLBACK = ("comment", "head")
# GitHub's secondary limit is one per account across REST and GraphQL, so a secondary 403 holds both
# buckets (moving the reads to the other one is the burst it asks us not to send), for its Retry-After
# or SECONDARY_BACKOFF doubling with each hit in a row up to SECONDARY_BACKOFF_MAX, whichever is longer.
SECONDARY_BACKOFF = 60
SECONDARY_BACKOFF_MAX = 900
SECONDARY = re.compile(r"secondary rate limit|abuse detection|For more on scraping GitHub and how it may affect your rights",
                       re.I)  # the last: GitHub's restriction page for a login it reads as scraping (2026-11-17)
CONTENT_ONLY = re.compile(r"content creation", re.I)  # "...temporarily blocked from content creation"
# The primary limit in words, with neither Retry-After nor "x-ratelimit-remaining: 0" beside it: a broker's read pool
# ("API rate limit exceeded on every read credential for OWNER/REPO; the first is free again in 433s") answers so, and
# broker_transport carries no headers. Unclassified, it set no backoff, so the daemon asked again every tick, stored
# only the refusal and recorded no hold: PR data a wait was blocked on went 35 to 115 minutes old with the verdict
# "stalled" (no reason), and the valve restarted a daemon that could read no sooner. Matched at the start only, never
# inside a refusal that quotes it. PRIMARY_SAID_WAIT reads the wait out of the sentence when no header says it.
PRIMARY_SAID = re.compile(r"^\s*API rate limit (already )?exceeded\b", re.I)
PRIMARY_SAID_WAIT = re.compile(r"\b(?:free again in|retry after|try again in)\s+(\d+(?:\.\d+)?)\s*s\b", re.I)
# The host-wide pacer for the secondary limit (gh-quota's pace.json, in this directory), when one is installed:
# its hold stops this daemon's reads too, and a secondary 403 the daemon meets is reported to it. Read only;
# the pacer alone writes it.
PACE_FILE = "pace.json"
PACE_CLI = Path.home() / ".local/lib/gh-quota/bin/gh"  # a link into the pacer's checkout, next to gh_quota.py
PACE_DEADLINE = 5
PACE_HOLD_MAX = 3600
# The login's create pause (GitHub's secondary content-creation limit), one fact per login that the gh guard keeps:
# `<cmd> content-pause` prints {"blocked_until": epoch seconds, "level": n} (blocked_until alone says paused), and
# `<cmd> content-pause --hold UNTIL --what TEXT` extends it (never shortens). The outbox posts with the token, not
# through the guard, so it asks before each create and reports its own throttles: a writer that kept posting through
# the pause renewed it for every other writer on the login. CONTENT_PAUSE_ENV names the command (shell words; empty
# turns it off); else the guard's gh_quota.py next to PACE_CLI's link, else CONTENT_PAUSE_NAMES on PATH. With none,
# the outbox posts as before.
CONTENT_PAUSE_ENV = "GLAEDA_CONTENT_PAUSE_CMD"
CONTENT_PAUSE_NAMES = ("gh-quota",)
CONTENT_PAUSE_TTL = 15  # seconds an answer is reused
# The daemon's main thread waits this long for the ask, so it is what the reads and waits lose to a hung keeper. A
# healthy answer read from the host's own file took 0.09-0.10 s (median 0.09 s, ten runs); 2 s is twenty times that,
# room for a loaded host's interpreter start. A slower answer is not lost: see CONTENT_PAUSE_SLOW_DEADLINE.
CONTENT_PAUSE_DEADLINE = 2
CONTENT_PAUSE_RETRY = 60  # seconds after a failed or timed-out ask before the next; the last answer stands meanwhile
# The ask runs on its own thread, and the daemon waits CONTENT_PAUSE_DEADLINE for it; a slower one goes on, bounded by
# this, and its answer is taken on a later pass (a keeper slower than 2 s was otherwise never heard: every ask timed
# out). The --hold report runs off the post's path on the same kind of thread, bounded by the same: the keeper writes
# the pause under a file lock that another writer on the host can hold for seconds, and a report killed at 2 s
# mid-write never told the other writers of the pause it was sent to share.
CONTENT_PAUSE_SLOW_DEADLINE = 15
CONTENT_PAUSE_REPORT_DEADLINE = 15
# While no answer is newer than CONTENT_PAUSE_RETRY and the ask is failing or still running, the pause is unknown:
# creates wait rather than go out into a pause other writers may have reported. For CONTENT_PAUSE_BLIND_MAX at most
# past the last answer (or the first ask, with none): a keeper broken for good then stops no create, and the outbox
# posts as a host with no keeper does, logged once per outage and shown by `post status`.
CONTENT_PAUSE_BLIND_MAX = 600
# A keeper that answers the ask with a usage error (argparse's "usage: ..." or "invalid choice", exit 2) has no
# `content-pause`: an older gh-quota than this outbox. That is an answer, not a failed ask: the outbox posts as a host
# with no keeper does (logged once), and asks again every CONTENT_PAUSE_ABSENT_REPROBE, so the pause applies again as
# soon as the keeper gains the command. Counted as failures, it held every create for CONTENT_PAUSE_BLIND_MAX after
# each daemon start, on every host whose gh-quota lagged (cosmic-gray, 2026-11-18).
CONTENT_PAUSE_ABSENT_REPROBE = 600
CONTENT_PAUSE_USAGE = re.compile(r"(?im)^\s*usage:|invalid choice")
# A private repository on a plan without branch protection or rulesets answers 403 with this: there are
# no requirements to read, as for a deleted base branch.
NO_FEATURE = re.compile(r"Upgrade to GitHub Pro|make this repository public to enable this feature", re.I)
RICH_WINDOW_MIN = 60  # seconds: a bucket about to reset is rich, but not infinitely so
FULL_WINDOW = 3600  # a bucket not seen yet, or past its reset, counts as a full hour's quota
SWITCH_MARGIN = 1.25  # a kind moves to the other bucket only when that one is this much richer
# Richness is reads per second, not requests: a PR read over REST is its pull, check runs, statuses and workflow runs
# (each conditional), over GraphQL a share of one aliased query for up to 10 PRs plus its probes. cosmic-gray,
# 2026-11-16 14:45 to 15:45Z: 268 counted REST over 105 REST PR reads (2.55 each) against 200 GraphQL points over 198
# GraphQL PR reads (1.0). Comparing what is left as if a request and a point bought the same read moved PRs to REST
# whenever it had 25% more left (10:49, 11:16, 11:43, 12:44, 13:39, 13:41 and 14:39Z that day), at 2.5 times the
# cost. The daemon's own spend log measures the cost (read_cost); these stand until it has READ_COST_MIN_READS reads
# over a bucket. Runs keep the plain comparison: over REST an unchanged run is a free 304.
COST_WEIGHTED = ("pr",)
READ_COST_DEFAULT = {("pr", "rest"): 2.5, ("pr", "graphql"): 1.0}
READ_COST_MIN_READS = 20
READ_COST_FLOOR = 0.05  # a measured cost of nothing (every read a 304) still costs something to route on
# And reads per second of the daemon's own time: a bucket's quota is not its only bound. A REST PR read is a dozen
# requests sent one after another (the pull, check-run pages, statuses, workflow runs, job lists), nearly all of them
# 304s, which are free, so read_cost fell to READ_COST_FLOOR and PRs stayed on REST whatever GraphQL had left.
# huge-blue, 2026-11-21 20:30-20:45Z: GraphQL back with 2875 points, every PR still on REST, 599 REST requests in
# 600 s (572 free) at ~0.65 s each on the tick's one thread, 32-53 PR reads stored per 600 s, waited PR data 9119 s
# old behind 1498 deferred keys, while one GraphQL query reads up to a batch of PRs. route() weighs each bucket by
# the lesser of what its quota affords and what its measured seconds per read afford (read_seconds: the wall time
# of the reads over the last READ_SECONDS_WINDOW, a slot wait or a slow edge included).
READ_SECONDS_DEFAULT = {("pr", "rest"): 4.0, ("pr", "graphql"): 0.5}
READ_SECONDS_MIN_READS = 10
READ_SECONDS_WINDOW = 900.0
REST_CHECK_PAGES = 5  # check-run pages (100 each) one PR read over REST takes at most
REST_STATUS_PAGES = 2  # commit-status pages (100 each) likewise
REST_RUN_PAGES = 2  # a commit's workflow-run pages (100 each) likewise: without its run a check has no workflow
REST_STEPS_MAX = 10  # step reads (a run's job-list page or one job) one PR read over REST makes at most
REST_JOB_PAGES = 3  # pages (100 jobs each) of one run's job list a step lookup reads before it reads the job alone
# A job whose steps read GitHub refused for good (404 for a job of a deleted run, 410, 422) is not asked again for
# this long: each such read was retried on every read of its PR, a counted request each time. A 5xx or a transport
# error is asked again at the normal pace: the steps hold a runner refusal for the rescue, whose grace is 360 s.
STEPS_RETRY = 900.0
STEPS_GONE = re.compile(r"HTTP (?:404|410|422)\b")
# The most counted REST requests one read can make before its step lookups, which are admitted one
# at a time: a PR is its pull, REST_CHECK_PAGES of check runs, statuses, runs, workflows, rules and
# the branch; a run is the run and its job list. The share admits a read only when this much fits. The
# workflows, rules and branch reads are shared (REST_REPO_PART_TTL), but a cold or expired share still sends them.
# A comment watch is the issue and at most two pages of its comments; a head is REST_CHECK_PAGES of check
# runs, its statuses, its workflow runs and the workflow names.
# The repository- and base-level parts of a REST PR read (the workflow names, the base's rulesets and its
# classic protection) are the same answer for every PR on that repository and base. The daemon keeps one
# answer for all of them this long; past it, the next PR read refreshes it with one conditional read. The
# branch's ETag moves with every commit to the base, so without this each PR paid a counted 200 after
# every base move. A required check added or dropped on the base shows within this time.
REST_REPO_PART_TTL = 600
REST_REPO_PART_KEEP = 3600  # an answer past its TTL still lends its ETag to the refresh this long
# A commit's check runs, statuses and workflow runs, a pull and a run's job list are read the same way for every
# watch that needs them (a PR and a head watch on one commit, PRs whose failed jobs share a run): one answer serves
# them all for REST_HEAD_PART_TTL, and past it the newest ETag known makes the refresh conditional, so a commit
# nothing changed on answers 304 (free). Before, a GraphQL read dropped a PR's kept answers (restParts=None), so the
# next REST read of that PR sent every one of them cold: on 2026-11-11 huge-blue's daemon sent 19 check-run, 17
# status, 17 workflow-run and 22 pull reads in an hour and not one came back 304. Short, so a nudged PR (NUDGE_MIN)
# still reads its head anew. REST_SHARED_MAX bounds the store; the oldest answers go first.
REST_HEAD_PART_TTL = 15
# Land refreshes are launched by separate worker processes. Keep one successful answer hot for the same short
# window as commit/head parts, so two workers that noticed the same stale PR do not both spend the broker read.
LAND_DIRECT_REUSE = REST_HEAD_PART_TTL
LAND_DIRECT_LOCK_WAIT = DIRECT_READ_BUDGET + LAND_DIRECT_REUSE + 1
REST_SHARED_MAX = 600
# A pull's ETag moves without the pull changing: GET pulls/N embeds its base and head repositories whole (pushed_at,
# open_issues_count, ...), so on a busy repository every read is a counted 200. cosmic-gray, 2026-11-16 15:25 to
# 15:38Z, GraphQL under its reserve and every PR on REST: 89 of 103 pull reads were counted, the largest single route
# (248 counted in all). GET issues/N is the same record without the repositories: its ETag holds until the PR
# itself changes (a push, a comment, a review, a label, a close or merge all move its updated_at), and an unchanged
# one answers 304, which is free (live, manaflow-ai/cmux#44595: two reads 90 s apart, pulls 200 and 200, issues 200
# then 304). So a REST PR read asks the issue first and reuses the pull it holds when the issue is unchanged
# (rest_pull). What the issue does not show is mergeability, which moves when the base moves: the kept pull is reused
# at most PULL_REUSE_MAX, never once GitHub had not computed mergeability (mergeable null), and never on a head whose
# checks have all finished and changed since (then the merge state the waits rule on is final, and is read anew).
# Through broker_transport (a lane VM's direct reads: no ETag asked or answered) the issue's updated_at vouches in
# place of its 304 (issue_vouches, issue_same): before 2026-11-25 that path never reused a pull, and glaeda-upstream's
# GET pulls/N was the broker's top App read, 274 an hour over 6 h and 551 over the latest 3 h fleet-wide.
PULL_REUSE_MAX = 300
# A REST PR read whose head is still running pages nothing while the head's check suites say nothing changed
# (claude-sr2-coord, 2026-11-17 09:41Z and 10:36Z: with GraphQL stopped, waits on cmux PRs cost 9.31 counted REST a
# read, check-run pages, job lists and pulls, and the pool drained at 127-169/min). The gate is one conditional
# GET commits/SHA/check-suites (one page: a suite per workflow run and app) beside the head's first status page and
# the issue: while every suite's status, conclusion and run count are as the last full read left them, the statuses
# too, and the issue shows the PR still open, the cached checks stand, read again as of now. A suite finishing (a
# failure included), a new suite or rerun, a status, a close, `--jobs`, a head with no suites, or a full read older
# than PR_REST_FULL_EVERY reads the head in full. So a moving cmux head costs about two counted requests a minute
# instead of nine; the price is that a check's own progress inside a running suite (one job failing early, a
# required check passing before its workflow ends) shows within PR_REST_FULL_EVERY rather than the next cycle. Only
# the REST route: GraphQL's rollup is one read already.
PR_REST_FULL_EVERY = 300
# A full REST read whose head's check suites are unchanged (a 304, or the same slimmed answer: the gate's test) takes
# the check-run pages its last read kept, with no request, while those were read within PR_REST_FULL_EVERY: the gate's
# own bound. Never for `--jobs`, which the gate never takes either. gcp-agent-lane-11's direct ledger, 2026-11-22 14:36-19:52Z: glaeda-upstream asked check-suites 325 and
# check-runs 291 times in 4 h, mostly the full read that follows a gate broken by the issue (a comment) on an
# unchanged head. The check-runs part keeps "at", when it was last read or confirmed.
# A failed head with every check finished (settled) passes the same gate for this long after its last full read: its
# check runs can change only through a suite (a rerun queues the suite again, a new push is a new head the pull and
# issue show), so the gate's three reads see every change a full read would. Under a backlog no read came within
# PR_REST_FULL_EVERY of the last, so every read was a full one: huge-blue 2026-11-22 00:05Z, 650 waited PRs (609 of
# them land's, the oldest five all failed heads), GraphQL stopped, 33-43 PR reads per 600 s at ~12 requests a read,
# and the oldest waited PR 13701 s unread. Only failed heads: a green one is about to merge, and its full read
# re-reads the pull whose merge state a land rules on.
PR_REST_SETTLED_FULL_EVERY = 1800
PR_REST_SUITE_PAGE = 100  # a head with more suites than one page is read in full
# The gate's check suites come from the controller's check rollup (GET /v1/github/commits/SHA/rollup, over the
# tailnet: no GitHub request) when it says the head's check runs are complete: rollup_suites groups them by suite, in
# slim_check_suites' terms (status completed once every run is, its conclusions, its run count), so a suite finishing,
# a new suite or a rerun's runs move it and a run's progress does not. A rollup answer and GitHub's never compare equal
# ("via"), so a head whose source changes reads in full once. An incomplete, slow or unreachable rollup reads GitHub as
# before. Why (rest_breakdown of manaflow-ai/cmuxterm-hq, 2026-11-24 21:28-23:28Z): glaeda-upstream asked
# commits/{sha}/check-suites 2,136 times in 2 h, 2% of them served by the broker, which never answers check-suites
# from the rollup; the probe at 2026-11-25 00:15Z found all 57 of the most recently updated open cmux and cmuxterm-hq
# heads' rollups complete.
PR_REST_SUITES_FROM_CONTROLLER = True
CONTROLLER_ROLLUP_TIMEOUT = 2.0  # a complete rollup answers in 0.05-1.4 s; a cold one is seeding from GitHub
CONTROLLER_ROLLUP_SLOW_SKIP = 15.0  # a head whose rollup timed out is not asked again for this long
CONTROLLER_ROLLUP_DOWN = 30.0  # a controller that failed otherwise is not asked for a rollup for this long
# The land queue's pass and refill ask the controller for each row's rollup (LAND_ROLLUP_JUDGE) on the serve loop's own
# thread, and a timed-out ask skips only its own head (CONTROLLER_ROLLUP_SLOW_SKIP). So with the controller's cold
# rollups seeding from a GitHub answering 502s, every row's ask spent its whole deadline, one pass ran past
# WATCHDOG_AFTER, and the watchdog restarted the daemon: the control-plane host, 2026-11-25 10:19-11:39Z, eight
# restarts (exit 75), the main thread each time in land_tick > rollup_green > controller_rollup_doc, and every lane VM
# reading through it served PR data 560-1150 s old (hq#20521). A pass's and a refill's controller asks together get
# this long (the same cut from_controller's CONTROLLER_TICK_BUDGET makes); a row past it keeps the GitHub snapshot
# path and is asked on the next pass, not after LAND_ROLLUP_SEEN_TTL.
LAND_ROLLUP_BUDGET = 20.0
# The REST loop reads one PR at a time, and each read's requests went out one after another: ~650 waited PRs at ~2 s a
# read is a ~1300 s pass however few requests each costs (huge-blue 2026-11-22). So the conditional GETs the next
# REST_PREFETCH_AHEAD reads will send (the paths and ETags their last read kept: Daemon.prefetch_rest) go out early on
# REST_PREFETCH_WORKERS threads, and each read takes its answers as it asks for them. Only the transport runs on a
# worker: admission (the quota latch, the REST share, the secondary hold, the per-minute cap) is decided before a
# request is sent, and charging, the spend log and the limits are request()'s, on the loop's thread, as for any other
# request. Only conditional requests go early, so one a read does not ask for after all is most often a free 304; one
# that is not is charged when the tick settles it (settle_prefetch). REST_PREFETCH_HELD bounds what is in flight or
# held unasked.
REST_PREFETCH_WORKERS = 4
REST_PREFETCH_AHEAD = 6
REST_PREFETCH_HELD = 24
# A wait on a PR read over REST that has run LONG_WAIT_AFTER is read every LONG_WAIT_FACTOR cycles (a check event the
# controller delivers still reads it at once): a cmux wait runs 30-60 minutes, and its last minutes decide nothing the
# first ones did not.
LONG_WAIT_AFTER = 900
LONG_WAIT_FACTOR = 2
REST_READ_MAX = {"pr": REST_CHECK_PAGES + REST_STATUS_PAGES + REST_RUN_PAGES + 5, "run": 2, "comment": 3,
                 "head": REST_CHECK_PAGES + REST_STATUS_PAGES + REST_RUN_PAGES + 1}

# NUM is the alias's PR-number variable: isRequired needs it. parents(first: 3), at least 2: a base merge's second parent is what
# land_base_merge_parent reads to follow a pin over it (glaeda#2508). With first: 1 every read carried one parent, so
# that follow never fired: hq#18897 (pinned efbd3106) and hq#18838 (pinned f7643e61), gcp-agent-lane-14, 2026-11-22
# 19:22Z-19:27Z, stopped head_moved on cmux-agents-lander[bot]'s "Merge branch 'main'" over the pin, the cache's
# headParents [efbd3106...] one entry long.
PR_FIELDS = """number url title state isDraft merged mergedAt mergeCommit { oid } mergeable mergeStateStatus headRefOid
headRefName baseRefName reviewDecision updatedAt baseRef { branchProtectionRule { requiredStatusCheckContexts }
rules(first: 50) { nodes { type parameters { ... on RequiredStatusChecksParameters {
  requiredStatusChecks { context } } } } } } commits(last: 1) { nodes { commit { oid
parents(first: 3) { nodes { oid } } SUITE_ATTEMPTS statusCheckRollup { state
contexts(first: 100) { totalCount PR_COUNTS pageInfo { hasNextPage endCursor } nodes { __typename
... on CheckRun { id name status conclusion detailsUrl databaseId startedAt completedAt
  isRequired(pullRequestNumber: NUM) checkSuite { databaseId conclusion app { slug }
  workflowRun { databaseId event workflow { name databaseId } } } }
... on StatusContext { context state description targetUrl createdAt isRequired(pullRequestNumber: NUM) } } } } } } }"""
# A check reads as its last real attempt left it (2026-11-05). statusCheckRollup, like every latest-attempt view, lists
# only each check suite's newest attempt, and one that ended in startup_failure ran no jobs: after two such reruns of
# run 41931705470, cmux#35906's "publish tree-addressed cmux-tui" red was gone from it, and the PR merged as 633d5e38
# at e1d1894a with that red not excused. Such an attempt is no result, never green. So each read also counts every
# suite's check runs in its newest attempt; a suite whose newest attempt ran nothing has its check runs (every attempt)
# read by id (last_real_contexts), one query for the whole batch, and folded in, newest per name.
# The count of every attempt's runs is not asked here (2026-11-08): GitHub prices a connection nested under
# checkSuites(first: 100) at 100 requests per PR whatever its own first is, so the two counts were 200 of the 204
# requests in each PR of the batched read, 20 points for a batch of ten. The suites whose newest attempt ran nothing
# (on a cmux head about 15 of 55, mostly apps' suites that never run anything) are read by id instead, where each
# suite is one request: a suite that never ran anything comes back with no runs and adds nothing.
SUITE_ATTEMPTS = ("checkSuites(first: 100) { totalCount pageInfo { hasNextPage } nodes { id "
                  "latest: checkRuns(first: 1) { totalCount } } }")
SUITE_RUNS_BATCH = 100  # suite ids per SUITE_RUNS query: GitHub's nodes(ids:) takes at most 100
PR_FIELDS = PR_FIELDS.replace("SUITE_ATTEMPTS", SUITE_ATTEMPTS)
# A PR's fingerprint (pr_fingerprint): what a verdict or a wait reads from a PR, as counts. The full read above costs
# about 1.4 points a PR (contexts, suites and rules at up to 100 each) and the daemons re-read every watched PR every
# cycle: on 2026-11-11 11Z, PR reads were 1,550 of the two daemons' ~2,000 GraphQL points an hour (huge-blue 602,
# cosmic-gray 949), most of them answers identical to the last. PR_PROBE asks only the fingerprint, about 3 requests a
# PR, so ten PRs cost 1 point; a PR whose fingerprint matches its last full read is confirmed (dataAt moves) without
# the full read, its check pages, its last-real-attempt suites or its steps. Any change, a PR never fully read, a
# partial one, or one fully read longer than PR_FULL_EVERY ago, is read in full.
PR_COUNTS = ("checkRunCount checkRunCountsByState { state count } statusContextCount "
             "statusContextCountsByState { state count }")
PR_FIELDS = PR_FIELDS.replace("PR_COUNTS", PR_COUNTS)
# `updatedAt` rides along without being part of the fingerprint: a comment, a label or a body edit moves it and nothing
# a verdict reads, so a probe that matched would otherwise keep the full read's updatedAt for up to PR_FULL_EVERY, and
# the broker's vouched `pr view` answers (gh_cache_vouch) go by it. A scalar, so it costs the probe nothing.
PR_PROBE_FIELDS = (f"number state isDraft merged mergeable mergeStateStatus headRefOid reviewDecision updatedAt "
                   f"commits(last: 1) "
                   f"{{ nodes {{ commit {{ checkSuites(first: 1) {{ totalCount }} statusCheckRollup {{ state "
                   f"contexts(first: 1) {{ totalCount {PR_COUNTS} }} }} }} }} }}")
PR_FULL_EVERY = 600  # a probed PR is still read in full this often (a renamed check, a base's required contexts)
# GitHub cuts a GraphQL query at about 10 s (a 502 or 504 after 10.x s). A full PR read costs what its checks cost:
# about 0.5 s for a small repository's PR, 5 s or more for a cmux PR with 160+ checks. One batch size serves the
# cheap probes and the full reads alike, and it restarts at GQL_BATCH_START, so on the land host (
# 2026-11-25) full-read queries of 2 to 10 cmux PRs 502'd after 10.5 s, 335 times in 36 h, and each tick spent most of
# its time in them while the land queue's PR data aged past 7,000 s. So fetch_prs splits its full reads into queries
# whose expected time, by the seconds per full PR measured for that repository (full_pr_secs), stays under this.
PR_FULL_QUERY_SECONDS = 6.0
PR_FULL_SLOW_AT = 8.0  # a failed full-read query this slow taught that its PRs cost at least this much between them
# ... unless PR reads are behind (pr_behind): then a probe stands in for a full read up to PR_FULL_BEHIND_EVERY. A full
# cmux PR costs GitHub about 3.5 s to answer and a probe about 0.5 s (one host, 2026-11-22: 13-16 s for a batch of 8,
# 4-6 s for a probe of 10, the same PRs). With PR_FULL_EVERY as short as the stale bound, every PR in a backlog was past
# it, so none could be probed: ~1,000 waited PRs needed ~3,500 s of full reads a pass, about 100 PRs were stored per
# 600 s, and waited PR data reached 16,000 s old. A backlog is now drained by probes, the changed PRs read in full.
PR_FULL_BEHIND_EVERY = 3600
PR_WHOLE_EVERY = 1800  # ... and a PR past one page of checks is read whole (pages and all) at least this often
SUITE_RUNS = """query($suites: [ID!]!) { rateLimit { limit remaining resetAt cost } suiteRuns: nodes(ids: $suites) {
... on CheckSuite { id conclusion app { slug } workflowRun { databaseId workflow { name databaseId } }
checkRuns(first: 100, filterBy: { checkType: ALL }) { pageInfo { hasNextPage } nodes { id name status conclusion
  detailsUrl databaseId startedAt completedAt } } } } }"""
# Whether each suite ran anything in any attempt, asked of an App before SUITE_RUNS. Most suites whose newest attempt
# ran nothing never ran anything (another App's suite that is requested and never run), and SUITE_RUNS's `app { slug }`
# on a suite whose App another organization owns is that organization's IP allow list's FORBIDDEN: the suite was
# node-benched (bench_nodes) and read on the login. The broker host, 2026-11-22 23:39Z-00:46Z: 165 login-fallback
# lines, every one a last-real-attempt read, 89 "refused" and 55 more of those benched suites (then misnamed
# "pool-resting"). This query asks no App node, so it stays on the App; a suite with no check run in any attempt is
# answered here, empty, and only a suite that ran something is read with SUITE_RUNS (it needs the slug).
SUITE_COUNTS = """query($suites: [ID!]!) { rateLimit { limit remaining resetAt cost } suiteRuns: nodes(ids: $suites) {
... on CheckSuite { id checkRuns(first: 1, filterBy: { checkType: ALL }) { totalCount } } } }"""


def ran_nothing_suites(commit: dict | None) -> list[str] | str:
    """The ids of COMMIT's check suites whose newest attempt ran no check run (an older attempt may have run some:
    last_real_contexts reads them); an error message when COMMIT has more suites than one page shows (one past it
    could hide a red: never greener)."""
    if commit is None:
        return []  # no such commit here (a fork that lacks it): nothing to read
    suites = commit.get("checkSuites")
    if not isinstance(suites, dict):
        # GitHub answers a field it failed to read as null beside an error: an unread field is never "none ran nothing"
        return "graphql: last real attempt: the commit's check suites could not be read"
    if (suites.get("pageInfo") or {}).get("hasNextPage"):
        return "graphql: last real attempt: more than 100 check suites on one commit"
    nodes = suites.get("nodes")
    if not isinstance(nodes, list):
        return "graphql: last real attempt: malformed check suites (no node list)"
    out = []
    for suite in nodes:
        # A null node, or a null, missing or non-count total, is GitHub failing that field beside a nested error:
        # read as zero it made a partial read look complete and could hide an older red (glaeda#1844 F1).
        latest = count_field(suite, "latest")
        if latest is None:
            return "graphql: last real attempt: malformed check suite counts (a partial read)"
        if latest == 0:
            if not suite.get("id"):
                return "graphql: last real attempt: malformed check suite (no id)"
            out.append(suite["id"])
    return out


def count_field(suite: object, field: str) -> int | None:
    """SUITE's FIELD.totalCount when it is a whole number of zero or more, else None (unread or malformed)."""
    if not isinstance(suite, dict):
        return None
    holder = suite.get(field)
    total = holder.get("totalCount") if isinstance(holder, dict) else None
    return total if type(total) is int and total >= 0 else None


def suites_contexts(suites: list[str] | str, runs: dict[str, list[dict]],
                    runs_error: str | None) -> tuple[list[dict], str | None]:
    """The check-run context nodes of SUITES (ran_nothing_suites: a list, or its error) out of RUNS (suite_runs);
    ([], error) when SUITES or RUNS could not be read: a partial read would be a smaller, greener head."""
    if isinstance(suites, str):
        return [], suites
    if not suites:
        return [], None
    if runs_error:
        return [], runs_error
    for s in suites:
        if s not in runs:
            return [], "graphql: last real attempt: a suite could not be read"
        if isinstance(runs[s], str):
            return [], runs[s]
    return [node for s in suites for node in runs[s]], None


def first_page_more(node: dict) -> bool:
    """Whether a PR NODE's rollup says more contexts follow its first page (or cannot say: never one whole page)."""
    commit = (((node.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}
    rollup = commit.get("statusCheckRollup")
    if rollup is None:
        return False
    more = ((rollup.get("contexts") or {}).get("pageInfo") or {}).get("hasNextPage")
    return more is not False


COMMENT_FIELDS = f"""comments(last: {COMMENTS_LAST}) {{ totalCount nodes {{ databaseId url createdAt lastEditedAt
author {{ login }} body }} }}"""
ISSUE_FIELDS = f"""__typename ... on Issue {{ url state {COMMENT_FIELDS} }}
... on PullRequest {{ url state {COMMENT_FIELDS} }}"""
RUN_FIELDS = """__typename ... on WorkflowRun { databaseId runAttempt event createdAt updatedAt url displayTitle
workflow { name } checkSuite { status conclusion commit { oid } branch { name } } }"""
STEPS_QUERY = """query($ids: [ID!]!) { rateLimit { limit remaining resetAt cost }
nodes(ids: $ids) { ... on CheckRun { id steps(first: 100) { nodes { name conclusion } } } } }"""
TOKEN_RE = re.compile(r"(gh[pousr]_[A-Za-z0-9._-]{20,2048}|github_pat_[A-Za-z0-9_]{20,251}|[0-9a-f]{40})")


class WatchError(RuntimeError):
    """Our own message, which describe() hands on as written -- so GitHub's personal identifiers come out of it
    where it is raised, not at each print.

    Every GitHub or `gh` sentence that reaches a person through an exception reaches it here, because describe()
    reduces anything that is not ours to a type name: the stderr tail of a refused `gh api` child, a broker's or
    an upstream's forwarded refusal, a land executor's reason, a search that was not answered. gh_sanitize names
    the login whose bucket a quota refusal spent and is idempotent, so a message with no identifier in it is
    raised byte for byte and the words stay GitHub's own."""

    def __init__(self, *args: Any) -> None:
        super().__init__(*(gh_sanitize(a) if isinstance(a, str) else a for a in args))


# ---------------------------------------------------------------- keys and files


def cwd_repo(cwd: str | None = None) -> str | None:
    """`owner/repo` of the GitHub `origin` of the directory the caller ran in, or None if it has none.

    This is what a bare `N` names. A bare number was 173 of the 358 targets this host's transcripts had
    refused by 2026-11-21, more than any other form, and it is the one an agent reaches for while working in
    a worktree of the repository the number belongs to -- where the answer is sitting in `origin`."""
    try:
        done = subprocess.run(["git", "-C", cwd or ".", "remote", "get-url", "origin"],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    match = REMOTE_RE.fullmatch(done.stdout.strip()) if done.returncode == 0 else None
    return f"{match.group(1)}/{match.group(2)}" if match else None


def target_readable(kind: str, text: str) -> bool:
    """Whether KIND would read TEXT as a target at all, for a refusal deciding what to suggest. No side
    effects and no `cwd_repo` read: a bare number is a target's shape whether or not an origin answers."""
    text = text.strip()
    split = split_kind_prefix(text)
    if split is not None:
        if split[0] != kind:
            return False
        text = split[1]
    if kind in ("pr", "run", "comment") and BARE_NUMBER.fullmatch(text):
        return True
    return kind in KEY_RES and bool(KEY_RES[kind].fullmatch(text))


def local_branch(name: str, cwd: str | None = None) -> bool:
    """Whether NAME is a branch of the checkout the caller ran in (its own or a remote-tracking one). One local git
    call, on a refusal path only: it is what makes a slash-bearing branch name (`feat/x`, which reads exactly like
    OWNER/REPO) safe to answer as a branch."""
    # for-each-ref takes patterns: an empty name, or one holding a glob character, would match every branch there
    # is and read as a branch of any name (an empty target did, 2026-11-22).
    if not name or any(c in name for c in "*?[]~^: \t\\") or name.startswith("/") or name.endswith("/"):
        return False
    try:
        done = subprocess.run(["git", "-C", cwd or ".", "for-each-ref", "--count=1", "--format=%(refname:short)",
                               f"refs/heads/{name}", f"refs/remotes/origin/{name}"],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    return done.returncode == 0 and bool(done.stdout.strip())


def branch_target_step(kind: str, text: str, cwd: str | None = None) -> str:
    """The one command that turns a branch name into the target `status`, `wait` and `land` take, when TEXT names a
    branch rather than a PR, else "". `OWNER/REPO@BRANCH` says the repository itself; a bare word is a branch only
    when the checkout the caller stands in has one by that name, and then the repository is its origin.

    A PR is the thing an agent has in hand least often: what it has is the branch it just pushed. `glaeda-gh status
    pr --head BRANCH` and `status run --branch main` are both unrecognized arguments (two refused calls in this
    lane, 2026-11-21), and the refusal for a branch typed as a target said only what a target must look like, which
    does not say how to get from the branch to the number. `--field target` prints `owner/repo#5`, a target this
    tool takes as it stands, so the printed step's output is the next call's argument."""
    if kind not in ("pr", "comment") or not text or "#" in text or "://" in text or text.startswith("-"):
        return ""
    repo, branch = "", text
    if "@" in text:
        left, branch = text.rsplit("@", 1)
        # NAME, not `[^/\s]+`: git allows `@` in a branch name, so `o/r@feat@v2` would otherwise print a step whose
        # `--repo o/r@feat` the search refuses -- a printed command that does not run (Opus review of #2428).
        if not re.fullmatch(rf"{NAME}/{NAME}", left):
            return ""
        repo = left
    # `HEAD` and friends resolve as refs in any clone but name no branch GitHub could search for.
    if not branch or BARE_NUMBER.fullmatch(branch) or "@" in branch or SHA40.fullmatch(branch) \
            or branch in ("HEAD", "FETCH_HEAD", "ORIG_HEAD", "MERGE_HEAD"):
        return ""  # `o/r@<40 hex>` is a head, which `parse_key("head", ...)` takes as it stands
    if not repo:
        if not local_branch(branch, cwd):
            return ""
        repo = cwd_repo(cwd) or ""
    if not repo:
        return ""
    return f"glaeda-gh search prs --repo {repo} head:{branch} --state open --field target,state"


def repo_targets(kind: str, targets: str | list[str], repo: str) -> str | list[str]:
    """TARGETS with each bare N or #N named in REPO (`--repo` of status and wait), the rest as typed. Measured
    2026-11-16..23: `status pr N --repo R` was refused as "unrecognized arguments", the form gh itself takes."""
    if kind not in ("pr", "run", "comment"):
        raise WatchError(f"--repo names the repository of a bare number, which {kind} does not take")
    if not re.fullmatch(rf"{NAME}/{NAME}", repo):
        raise WatchError(f"--repo takes OWNER/REPO, not {repo!r}")

    def one(text: str) -> str:
        bare = BARE_NUMBER.fullmatch(drop_kind_prefix(text, kind))
        return f"{repo}{'/' if kind == 'run' else '#'}{int(bare.group(1))}" if bare else text

    return [one(t) for t in targets] if isinstance(targets, list) else one(targets)


def parse_key(kind: str, text: str) -> str:
    """`pr:owner/repo#n`, `run:owner/repo/id` or `comment:owner/repo#n`, lowercased so every session
    shares one entry. A bare `N` or `#N` is that number in the repository the caller is standing in,
    and a target already spelled the way this function prints it (`pr:o/r#5`) is taken as it stands."""
    text = drop_kind_prefix(text, kind)
    bare = BARE_NUMBER.fullmatch(text) if kind in ("pr", "run", "comment") else None
    if bare:
        repo = cwd_repo()
        if not repo:
            raise WatchError(f"{text!r} is a number with no repository: name it as OWNER/REPO#{bare.group(1)}, "
                             f"or run this where the repository's origin is ({os.getcwd()} has none)")
        # said, not silent: a number resolved against the wrong checkout would read as the right PR
        text = f"{repo}{'/' if kind == 'run' else '#'}{int(bare.group(1))}"
        say_waiting(f"glaeda-gh: {bare.group(0)} is {text} (the origin of {os.getcwd()})")
    match = KEY_RES[kind].fullmatch(text) if kind in KEY_RES else None
    if not match:
        form = {"pr": "OWNER/REPO#N or a pull request URL", "run": "OWNER/REPO/RUN_ID or a run URL",
                "comment": "OWNER/REPO#N or an issue or pull request URL"}.get(kind, "pr, run or comment")
        step = branch_target_step(kind, text)
        if step:
            raise WatchError(f"{text!r} is a branch, and {kind} takes {form}: that number is one search away; "
                             f"next: {step}")
        raise WatchError(f"{kind} must be {form}, not {text!r}")
    owner, repo, number = match.groups()
    if kind == "head":
        return f"head:{owner.lower()}/{repo.lower()}@{number.lower()}"
    sep = "/" if kind == "run" else "#"
    return f"{kind}:{owner.lower()}/{repo.lower()}{sep}{int(number)}"


def split_key(key: str) -> tuple[str, str, str, Any]:
    """(kind, owner, repo, number); a head's last part is its 40-hex commit id."""
    kind, rest = key.split(":", 1)
    owner, rest = rest.split("/", 1)
    repo, number = re.split(r"[#/@]", rest, maxsplit=1)
    return kind, owner, repo, number.lower() if kind == "head" else int(number)


ROUTE_SHA = re.compile(r"[0-9a-fA-F]{40}")


def route_of(method: str, path: str) -> str:
    """A REST request's route template, for the spend log: METHOD /repos/{owner}/{repo}/pulls/{id}?per_page&state.
    Ids and commit SHAs are templated, a branch (which may hold slashes) or a label is one {branch} or {label}, and
    the query keeps its parameter names only, so one route counts every PR and page it read."""
    path, _, query = path.partition("?")
    parts = path.split("/")
    if len(parts) > 3 and parts[1] == "repos":
        parts[2:4] = ["{owner}", "{repo}"]
    out: list[str] = []
    for seg in parts:
        if out and out[-1] == "branches":
            out.append("{branch}")
            break
        if out and out[-1] == "labels":
            out.append("{label}")
            break
        out.append("{id}" if seg.isdigit() else "{sha}" if ROUTE_SHA.fullmatch(seg) else seg)
    names = sorted({p.split("=", 1)[0] for p in query.split("&") if p})
    return f"{method} {'/'.join(out)}" + ("?" + "&".join(names) if names else "")


def load_spend(doc: Any) -> dict[int, dict[str, list[int]]]:
    """SPEND_FILE's minutes, the well-formed rows only."""
    minutes = doc.get("minutes") if isinstance(doc, dict) else None
    out: dict[int, dict[str, list[int]]] = {}
    for minute, rows in (minutes if isinstance(minutes, dict) else {}).items():
        if not str(minute).isdigit() or not isinstance(rows, dict):
            continue
        for key, row in rows.items():
            if (isinstance(key, str) and isinstance(row, list) and len(row) == 3
                    and all(isinstance(n, int) and not isinstance(n, bool) and n >= 0 for n in row)):
                out.setdefault(int(minute), {})[key] = list(row)
    return out


SPEND_WAITERS_SHOWN = 3  # waiters named inside one restByCaller or graphqlByQuery row


def spend_summary(rows: list[dict], seconds: float = 3600.0, top: int = SPEND_TOP) -> dict:
    """The spend log's tables, most spent first: REST by route (with the caller that spent most on it), REST by
    route and caller, GraphQL by query and caller, and each bucket's totals."""
    rest = [r for r in rows if r["bucket"] == "rest"]
    gql = [r for r in rows if r["bucket"] == "graphql"]
    routes: dict[str, dict] = {}
    for r in rest:
        mine = routes.setdefault(r["name"], {"route": r["name"], "requests": 0, "counted": 0, "callers": {},
                                             "waiters": {}})
        mine["requests"] += r["requests"]
        mine["counted"] += r["counted"]
        who = f"{r['kind']} {r['repo']}".strip()
        mine["callers"][who] = mine["callers"].get(who, 0) + r["counted"]
        if r.get("waiter"):
            mine["waiters"][r["waiter"]] = mine["waiters"].get(r["waiter"], 0) + r["counted"]
    by_route = []
    for mine in routes.values():
        callers, waiters = mine.pop("callers"), mine.pop("waiters")
        lead = max(callers.items(), key=lambda kv: (kv[1], kv[0]), default=("", 0))
        held = max(waiters.items(), key=lambda kv: (kv[1], kv[0]), default=("", 0))
        by_route.append({**mine, "topCaller": lead[0], "topCallerCounted": lead[1], "callers": len(callers),
                         "topWaiter": held[0], "topWaiterCounted": held[1], "waiters": len(waiters)})
    def rank(r: dict, field: str) -> tuple:
        return (-r[field], -r["requests"], r.get("route") or r.get("name") or "", r.get("kind", ""), r.get("repo", ""))

    def by_caller(rows: list[dict], field: str) -> list[dict]:
        """ROWS merged per name, kind and repo before ranking, its waiters inside (most FIELD first): a key holds
        the waiter too, so twelve 1-point pr queries for twelve waiters were twelve rows, not one of 12 (#1931)."""
        merged: dict[tuple, dict] = {}
        for r in rows:
            row = merged.setdefault((r["name"], r["kind"], r["repo"]), {"name": r["name"], "kind": r["kind"],
                                                                         "repo": r["repo"], "requests": 0,
                                                                         field: 0, "waiters": {}})
            row["requests"] += r["requests"]
            row[field] += r[field]
            if r.get("waiter"):
                row["waiters"][r["waiter"]] = row["waiters"].get(r["waiter"], 0) + r[field]
        out = sorted(merged.values(), key=lambda r: rank(r, field))[:top]
        for row in out:
            row["waiters"] = [{"waiter": w, field: n} for w, n in
                              sorted(row["waiters"].items(), key=lambda kv: (-kv[1], kv[0]))[:SPEND_WAITERS_SHOWN]]
        return out
    return {"window": int(seconds),
            "rest": {"requests": sum(r["requests"] for r in rest), "counted": sum(r["counted"] for r in rest)},
            "graphql": {"queries": sum(r["requests"] for r in gql), "points": sum(r["points"] for r in gql)},
            "restByRoute": sorted(by_route, key=lambda r: rank(r, "counted"))[:top],
            "restByCaller": [{"route": r["name"], "kind": r["kind"], "repo": r["repo"], "requests": r["requests"],
                              "counted": r["counted"], "waiters": r["waiters"]} for r in by_caller(rest, "counted")],
            "graphqlByQuery": [{"query": r["name"], "kind": r["kind"], "repo": r["repo"], "queries": r["requests"],
                                "points": r["points"], "waiters": r["waiters"]} for r in by_caller(gql, "points")],
            "graphqlLoginWhy": login_why_rows(gql, top)}


def login_why_rows(gql: list[dict], top: int = SPEND_TOP) -> list[dict]:
    """The login's GraphQL points by why no App took them (note_login_fallback's cause) and query, most first: the
    detector for a daemon whose GraphQL stays on the login while its Apps have their hour. Every point graphql()
    books is the login's (an App's answer is never in spend), so these rows sum to graphql.points less rows an older
    build wrote without a cause. Before, spendBy said which query spent the login (graphqlByQuery) but not why: the
    login carried 26% of an hour's GraphQL with the Apps at 11.4k-12.5k of 12.5k left, the daemons on three hosts
    spending 173-274 points/h of it, and nothing on the census could tell an owner no App serves from a resting pool."""
    merged: dict[tuple, dict] = {}
    for r in gql:
        if not r.get("why"):
            continue
        row = merged.setdefault((r["why"], r["name"]), {"why": r["why"], "query": r["name"], "queries": 0, "points": 0})
        row["queries"] += r["requests"]
        row["points"] += r["points"]
    return sorted(merged.values(), key=lambda r: (-r["points"], -r["queries"], r["why"], r["query"]))[:top]


def waiters_text(r: dict, field: str) -> str:
    """" for W1 5, W2 3" from a spend_summary row's top waiters."""
    shown = [f"{w.get('waiter')} {w.get(field, 0)}" for w in r.get("waiters") or [] if isinstance(w, dict)]
    return f" for {', '.join(shown)}" if shown else ""


def route_waiter(r: dict) -> str:
    """"; waiter W" for a restByRoute row whose reads were for a named waiter (spend_summary topWaiter)."""
    return f"; waiter {r['topWaiter']}" if r.get("topWaiter") else ""


def host_spenders(run: Callable[..., Any] = subprocess.run) -> tuple[list[dict], int | None]:
    """This host's top REST spenders on the shared login over the last hour (SPENDERS_CMD usage --json), with the REST
    all its callers spent: ([], None) when it cannot say. Each row is {caller, rest, graphql, source}."""
    try:
        # Every host signed in to the login first (gh-quota `usage --fleet --cache-only` answers from its
        # last sweep or starts one and exits nonzero), so the pool alarm's "unlogged" is what no host logged; on
        # 2026-11-16 another host's logs held 2892 REST an hour this alarm called unlogged. An older gh-quota, or no
        # fresh sweep yet: this host's own usage, as before.
        done = run([SPENDERS_CMD, "usage", "--json", "--fleet", "--cache-only"], capture_output=True, text=True,
                   timeout=SPENDERS_TIMEOUT)
        if done.returncode != 0 or not (done.stdout or "").strip():
            done = run([SPENDERS_CMD, "usage", "--json"], capture_output=True, text=True, timeout=SPENDERS_TIMEOUT)
        if done.returncode != 0 or not (done.stdout or "").strip():
            return [], None  # it could not say: an empty answer is not "spent nothing" (#1936 review)
        rows = json.loads(done.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return [], None
    if not isinstance(rows, list):
        return [], None
    rows = [r for r in rows if isinstance(r, dict) and any(
        isinstance(r.get(pool), int) and not isinstance(r.get(pool), bool) and r[pool] > 0
        for pool in ("rest", "graphql"))]
    rows.sort(key=lambda r: (-max(int(r.get("rest", 0)), int(r.get("graphql", 0))),
                           str(r.get("caller"))))
    return ([{k: r.get(k) for k in ("caller", "rest", "graphql", "source", "host") if k in r} for r in rows[:SPENDERS_TOP]],
            sum(r.get("rest", 0) for r in rows if isinstance(r.get("rest"), int)))


def consumer_share_alarm(rows: list[dict], policy: dict) -> tuple[str, str, dict] | None:
    """Page when one observed caller exceeds the configured share of either account pool."""
    fraction = float(policy.get("fraction", CONSUMER_SHARE_FRACTION))
    minimum = int(policy.get("minCalls", CONSUMER_SHARE_MIN_CALLS))
    alarms = []
    for pool, label in (("rest", "REST"), ("graphql", "GraphQL")):
        for row in rows:
            calls = row.get(pool)
            if isinstance(calls, int) and not isinstance(calls, bool) and calls >= minimum and calls > fraction * 5000:
                caller = f"{row.get('host')}:{row.get('caller')}" if row.get("host") else str(row.get("caller") or "?")
                alarms.append((calls, pool, label, caller))
    if not alarms:
        return None
    alarms.sort(reverse=True)
    calls, pool, label, caller = alarms[0]
    details = "; ".join(f"{name}={value}" for value, _pool, _label, name in alarms[:5])
    text = (f"WARN glaeda-gh on {policy_host()}: {caller} consumed {calls}/5000 {label} in the last hour, "
            f"over the {fraction:.0%} consumer-share threshold. Top flagged consumers: {details}.")
    return "warn", text, {"pool": pool, "caller": caller, "calls": calls, "limit": 5000,
                           "fraction": fraction, "minCalls": minimum, "alarms": [
                               {"pool": p, "caller": n, "calls": c, "limit": 5000, "fraction": fraction}
                               for c, p, _l, n in alarms]}


def share_slow(shed: dict | None, spenders: list[dict]) -> dict | None:
    """The one caller the share alarm names to slow: the login's top REST spender on this host (host_spenders), unless
    that is this daemon, or the daemon's top waiter (share_alarm's shed) spent more; then that waiter. None when
    neither is known."""
    other = next((r for r in spenders if not str(r.get("caller") or "").startswith("daemon:")), None)
    if shed and (other is None or shed["counted"] >= other["rest"]):
        return {"caller": shed["waiter"], "rest": shed["counted"], "via": "glaeda-gh waits"}
    if other is not None:
        return {"caller": other["caller"], "rest": other["rest"], "via": other.get("source") or "gh",
                **({"host": other["host"]} if other.get("host") else {})}
    return None


def share_slow_text(slow: dict | None) -> str:
    if slow is None:
        return "No caller to slow is known: the spend is the daemon's own; check restYield in its policy."
    if slow["via"] == "glaeda-gh waits":
        return f"Slow {slow['caller']} ({slow['rest']} counted REST, its glaeda-gh waits): end or slow its waits."
    where = f"on {slow['host']}" if slow.get("host") else "here"
    return f"Slow {slow['caller']} ({slow['rest']} REST this hour, {slow['via']}): the login's top REST caller {where}."


# The pool alarm names the REST no log on this host holds, once it is this share of what the pool spent and at least
# UNLOGGED_MIN. GitHub's limit is the login's, on every host signed in to it and every token of it: on 2026-11-10
# cosmic-gray's logs held about 64 of the pool's 180 a minute, and every alarm named only those.
UNLOGGED_SHARE = 0.25
UNLOGGED_MIN = 300
UNLOGGED_EARLY = 600  # a window younger than this is too early to measure (#1937 review)


def unlogged_text(limit: int | None, remaining: int | None, reset: float | None, now: float,
                  host_rest: int | None, fleet: bool = False) -> tuple[str, int | None]:
    """(" At least G of the U REST ... ", G) for the REST no log on this host holds, else ("", None). Both sides
    cover the same requests, so a burst is not taken for a rate (#1936 review): U is what GitHub says the pool spent
    since its window opened (LIMIT - REMAINING, at most an hour back from RESET), and HOST_REST is every logged call
    on this host in the last hour, which holds that window. G = U - HOST_REST can only understate what is unlogged.
    NOW is read after the usage read: a long tick can cross RESET first (#1937 review)."""
    if host_rest is None or not isinstance(limit, int) or not isinstance(remaining, int) or reset is None:
        return "", None
    if reset <= now:  # the counter expired while usage ran: the host's hour has dropped requests it still counts
        return "", None
    since = max(0.0, min(3600.0, 3600.0 - (reset - now)))
    if since < UNLOGGED_EARLY:  # a fresh window has spent too little to compare: say so, never "nothing unlogged"
        return (f" Too early in GitHub's window ({since / 60:.0f} min old) to say how much REST no log on "
                f"{policy_host()} holds.", None)
    used = limit - remaining
    gap = used - host_rest
    if gap < UNLOGGED_MIN or gap < UNLOGGED_SHARE * used:
        return "", None
    if fleet:  # HOST_REST summed every login host's logs (`gh-quota usage --fleet`)
        return (f" At least {gap} of the {used} REST the pool spent in the last {since / 60:.0f} min ({gap / used:.0%}) "
                f"is in no host's log (`{Path(SPENDERS_CMD).name} usage --fleet`): this login's token used outside gh.",
                gap)
    return (f" At least {gap} of the {used} REST the pool spent in the last {since / 60:.0f} min ({gap / used:.0%}) is "
            f"in no log on {policy_host()}: other hosts signed in to this login (their `{Path(SPENDERS_CMD).name} "
            f"usage`), or its token used outside gh.", gap)


def spenders_text(rows: list[dict]) -> str:
    rest_rows = [r for r in rows if isinstance(r.get("rest"), int) and r["rest"] > 0]
    if not rest_rows:
        return f"Top REST callers on {policy_host()}: unknown ({Path(SPENDERS_CMD).name} usage gave none); glaeda-gh budget."
    said = "; ".join(f"{r['caller']} {r['rest']}" + (f" ({r['source']})" if r.get("source") else "") for r in rest_rows)
    where = "on every login host" if any(r.get("host") for r in rest_rows) else f"on {policy_host()}"
    return f"Top REST callers {where}, last hour: {said}."


def waiter_of(e: dict) -> str:
    """The reader that read a watch entry last (the watch's `reader`), "" when none is named."""
    return e.get("reader") if isinstance(e.get("reader"), str) else ""


def waiters_of(entries: list[dict]) -> str:
    """The spend log's waiter of a batch: its one waiter, or how many there are."""
    names = sorted({waiter_of(e) for e in entries} - {""})
    return names[0] if len(names) == 1 else f"{len(names)} waiters" if names else ""


def caller_of(key: str) -> tuple[str, str]:
    """(watch kind, owner/repo) of a watch key, for the spend log."""
    try:
        kind, owner, repo, _ = split_key(key)
    except (ValueError, IndexError):
        return key.split(":", 1)[0] or "other", ""
    return kind, f"{owner}/{repo}"


def watch_dir() -> Path:
    return BASE / "watch"


def cache_dir() -> Path:
    return BASE / "cache"


def outbox_dir() -> Path:
    return BASE / "outbox"  # writes `post` queued, one file each, named by id (oldest first)


def posted_dir() -> Path:
    return BASE / "posted"  # finished writes: the URL, or why it failed (kept POST_KEEP)


def waited_since_load() -> dict[str, float]:
    """The waited keys' wait starts a daemon before this one kept (WAITED_SINCE_FILE), unless it is older than
    WAIT_INTEREST; never in the future."""
    doc = read_json(BASE / WAITED_SINCE_FILE)
    if not isinstance(doc, dict) or not isinstance(doc.get("since"), dict):
        return {}
    at, now = doc.get("at"), time.time()
    if not isinstance(at, (int, float)) or isinstance(at, bool) or not 0 <= now - at < WAIT_INTEREST:
        return {}
    return {str(k): min(float(v), now) for k, v in doc["since"].items()
            if isinstance(v, (int, float)) and not isinstance(v, bool)}


def file_name(key: str) -> str:
    return hashlib.sha256(key.encode()).hexdigest()[:32] + ".json"


# A watch's mtime is its last read. A read within this long of the last touch leaves the file alone when nothing could
# tell the two apart: on cosmic-gray (2026-11-05) fseventsd held a 27 GB footprint while watch/ files were rewritten
# with the same bytes many times a minute. 5 s is noise against what reads the mtime: IDLE_BACKOFF_AFTER (300 s),
# TERMINAL_GRACE (120 s) and IDLE_EXPIRY (15 min). The one exact comparison, a reader newer than the cache's last
# fetch (Daemon.due), keeps its answer: the touch is skipped only while the mtime is already past every stamp the
# cache holds, so the comparison comes out the same with or without it (interest_fresh).
INTEREST_QUIET = 5.0


def interest_fresh(path: Path, key: str, now: float | None = None) -> bool:
    """Whether touching PATH (KEY's watch) now would change nothing a reader of its mtime decides: touched within
    INTEREST_QUIET and already newer than the cache's fetchedAt, dataAt and restAt."""
    try:
        mtime = path.stat().st_mtime
    except OSError:
        return False
    now = time.time() if now is None else now
    if not 0 <= now - mtime < INTEREST_QUIET:
        return False
    c = read_cache(key) or {}
    stamps = [c.get(k) for k in ("fetchedAt", "dataAt", "restAt")]
    return all(mtime > s for s in stamps if isinstance(s, (int, float)) and not isinstance(s, bool))


# Who keeps a watch read: each watch file names its readers ({"session:NAME" or "tool:NAME": last time}), so the
# spend log and the alarms can say which waiter a REST route is spent for. On 2026-11-10 the pool alarm named
# "pr manaflow-ai/cmux" behind pulls, check runs and job reads, and nothing said which of the dozens of sessions,
# lane VMs and reconcilers kept those PRs watched. A reader already named within READER_REFRESH is not written again,
# so a hot read stays a stat and a utime.
READER_REFRESH = 300.0
# ACPMUX_FROM and CMUX_AGENT_SESSION_ID are what `reach HOST CMD` exports on the far side of its ssh hop (the caller's
# session name, its harness session id, CMUX_AGENT_HOST its host): without them every wait an agent on another host
# ran through reach was tool:unknown (2026-11-11, huge-blue: claude-sr2-coord's waits from cosmic-gray, parent sshd).
READER_KEYS = ("ACPMUX_SESSION_NAME", "ACPMUX_FROM", "CMUX_AGENT_SESSION", "ACPMUX_SESSION_ID", "CMUX_AGENT_SESSION_ID",
               "CLAUDE_SESSION_ID", "CLAUDE_CODE_SESSION_ID", "CODEX_THREAD_ID", "CODEX_SESSION_ID")
# A helper names itself inside its session (session:NAME:agent:ID): GLAEDA_GH_AGENT, else CMUX_AGENT_NAME, else, for
# a subagent (Claude Code's AI_AGENT ends in _agent; it shares its parent's session variables) or a caller over
# reach, the checkout it works in (`wt new` gives each helper its own: .../checkouts/REPO/NAME). claude-sr2-coord's
# helpers all read as session:claude-sr2-coord, so a spend alarm could not tell which of a dozen helpers held a PR.
READER_AGENT_KEYS = ("GLAEDA_GH_AGENT", "CMUX_AGENT_NAME")
READER_ENV = READER_KEYS + READER_AGENT_KEYS + ("GLAEDA_GH_READER", "AI_AGENT", "CMUX_AGENT_HOST", "SSH_CLIENT")
READER_WRAPPERS = re.compile(r"(?i)(ba|z|da|)sh|python3?(\.\d+)?|env|xargs|timeout|nice|gh|glaeda-gh")
# A reader's name is written to watch files, spend logs, upstream requests and alarms, so it never carries command-line
# text: only a session's name or id, or an executable's or script's base name, each held to this shape. A parent
# `bash -c 'TOKEN=... python3 probe.py'` once gave the reader `tool:TOKEN=... python3 probe.py` (review, glaeda#1931).
READER_NAME = re.compile(r"[A-Za-z0-9._-]{1,64}")
# A reader handed in (GLAEDA_GH_READER, a downstream HOST/READER over the upstream): KIND:NAME parts of that shape.
READER_SAFE = re.compile(r"(?:[A-Za-z0-9._-]{1,64}/)?(?:session|tool):[A-Za-z0-9._-]{1,64}(?::agent:[A-Za-z0-9._-]{1,64})?")
_reader: str | None = None


def parent_command(pid: int) -> list[str]:
    """The words of process PID's command line ([] when it cannot be read): /proc on Linux, ps elsewhere."""
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        return [w for w in raw.decode(errors="replace").split("\0") if w]
    except OSError:
        pass
    try:  # one ps answers both this and parent_pid's question, so the reader walk forks one ps a level, not two
        done = subprocess.run(["ps", "-o", "ppid=,args=", "-p", str(pid)], capture_output=True, text=True, timeout=2)
        ppid, _, args = done.stdout.strip().partition(" ")
        if ppid.isdigit():
            _ppid_of[pid] = int(ppid)
        return args.split()
    except (OSError, subprocess.SubprocessError):
        return []


_ppid_of: dict[int, int] = {}


def parent_pid(pid: int) -> int:
    try:
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("PPid:"):
                return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    if pid in _ppid_of:
        return _ppid_of[pid]
    try:
        done = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, timeout=2)
        return int(done.stdout.strip() or 0)
    except (OSError, subprocess.SubprocessError, ValueError):
        return 0


def safe_reader(text: Any) -> str:
    """TEXT when it is a reader name of the safe shape (READER_SAFE), else ""."""
    return text if isinstance(text, str) and READER_SAFE.fullmatch(text) else ""


def command_tool(words: list[str]) -> str:
    """The tool a command line runs: its executable's base name, or, behind an interpreter or wrapper, the next word's
    (the script) when it is a path rather than a flag; "" when that is a wrapper too or not of the READER_NAME shape.
    Nothing else of the command line is looked at, so no argument (an inline TOKEN=..., a -c program) is ever kept."""
    for word in words[:2]:
        name = Path(word).name
        if word.startswith("-") or not READER_NAME.fullmatch(name):
            return ""
        if not READER_WRAPPERS.fullmatch(name):
            return name
    return ""


def checkout_name(cwd: str) -> str:
    """The checkout CWD is in: NAME of a .../checkouts/REPO/NAME path (`wt new`), "" when it is in none."""
    parts = Path(cwd).parts
    for i in range(len(parts) - 2):
        if parts[i] == "checkouts" and READER_NAME.fullmatch(parts[i + 2]):
            return parts[i + 2]
    return ""


def reader_agent(remote: bool) -> str:
    """The helper inside a session that reads: GLAEDA_GH_AGENT or CMUX_AGENT_NAME, else, for a subagent or a caller
    over reach (REMOTE), its checkout's name, else "helper" for a subagent; "" for the session itself."""
    named = next((os.environ[k].strip() for k in READER_AGENT_KEYS if os.environ.get(k, "").strip()), "")
    if READER_NAME.fullmatch(named):
        return named
    sub = os.environ.get("AI_AGENT", "").strip().endswith("_agent")
    if not (sub or remote):
        return ""
    try:
        where = checkout_name(os.getcwd())
    except OSError:
        where = ""
    return where or ("helper" if sub else "")


def reader_host() -> str:
    """The host a caller over reach runs on (CMUX_AGENT_HOST, when it is not this one), else ""."""
    host = os.environ.get("CMUX_AGENT_HOST", "").strip().lower()
    here = {socket.gethostname().split(".")[0].lower(), policy_host()}
    return host if READER_NAME.fullmatch(host) and host not in here else ""


def reader_name() -> str:
    """This process's reader: GLAEDA_GH_READER, else its agent session (session:NAME, HOST/session:NAME for a caller
    over reach), with the helper inside it (session:NAME:agent:ID, reader_agent), else the first tool up its process
    tree that is not a shell, interpreter or wrapper (tool:pr_owner.py), else, over ssh, tool:ssh-from-ADDRESS, else
    tool:unknown. Worked out once per process, and always of the READER_SAFE shape."""
    global _reader
    if _reader is None:
        named = safe_reader(os.environ.get("GLAEDA_GH_READER", "").strip())
        session = next((os.environ[k].strip() for k in READER_KEYS if os.environ.get(k, "").strip()), "")
        _reader = named
        if not _reader and READER_NAME.fullmatch(session):
            host = reader_host()
            agent = reader_agent(bool(host))
            _reader = safe_reader(f"{host + '/' if host else ''}session:{session}{':agent:' + agent if agent else ''}")
        pid = os.getppid()
        for _ in range(4 if not _reader else 0):
            tool = command_tool(parent_command(pid))
            if tool and tool not in ("sshd", "sshd-session"):
                _reader = f"tool:{tool}"
                break
            pid = parent_pid(pid)
            if pid <= 1:
                break
        if not _reader:
            client = os.environ.get("SSH_CLIENT", "").split()
            _reader = safe_reader(f"tool:ssh-from-{client[0]}") if client else ""
        _reader = _reader or "tool:unknown"
    return _reader


def readers_of(doc: dict, now: float) -> dict[str, float]:
    """A watch file's readers still within IDLE_EXPIRY."""
    got = doc.get("readers") if isinstance(doc.get("readers"), dict) else {}
    return {str(k): float(v) for k, v in got.items()
            if isinstance(v, (int, float)) and not isinstance(v, bool) and now - v < IDLE_EXPIRY}


def reader_fresh(doc: dict, reader: str, now: float) -> bool:
    """Whether READER is the watch's latest reader already, named within READER_REFRESH: writing it again would change
    nothing waiter_of decides. Another reader in between makes it stale at once, so a read is never charged to a
    reader that came and went (A, then B, then A again: A is the latest)."""
    at = doc.get("readerAt")
    return doc.get("reader") == reader and isinstance(at, (int, float)) and not isinstance(at, bool) \
        and 0 <= now - at < READER_REFRESH


def touch_interest(key: str) -> None:
    """A read the cache answered still counts as interest: the watch's mtime is its last read (the daemon's idle
    backoff and IDLE_EXPIRY go by it). Only an existing watch is touched, and a failure costs nothing. A touch
    that would change nothing (interest_fresh) is skipped. A reader the watch has not named lately is added
    (register), so the spend log can say who the watch is read for."""
    path = watch_dir() / file_name(key)
    try:
        doc = read_json(path)
        if isinstance(doc, dict) and doc.get("dormant"):
            return  # an answered one-off look: a cache answer does not make it a watch again (once_answered)
        if isinstance(doc, dict) and doc.get("key") == key and not reader_fresh(doc, reader_name(), time.time()):
            register(key)
            return
        if not interest_fresh(path, key):
            os.utime(path)
    except OSError:
        pass


def stable_replace(path: Path, data: bytes, keep_mode: bool = False) -> None:
    """Replace PATH with DATA through one temp name per target, `.NAME.tmp` beside it, never a PID, time or random
    suffix. macOS fseventsd keeps a record of every distinct path it has seen until reboot: a new temp name per write
    (`.NAME.PID.NS.tmp`) made each cache, watch and answer write a new path, and on cosmic-gray (2026-11-24) the cache
    was among the top makers of new paths while fseventsd held a 31 GB footprint. Writers in one folder take turns on a
    flock of the folder itself (no lock file, so no extra path) from opening the temp to renaming it, so two never
    share it. The temp is opened O_NOFOLLOW and must be a plain file with one link (a planted link is removed, never
    written through). Created 0600; with KEEP_MODE it takes the target's own mode (a replace with the umask's mode
    turned a 0600 file into 0644: leo-workspace#5398's BLOCK). A write cut off (a full disk, a deadline's exception)
    removes its temp: huge-blue's cache held dozens of zero-byte temps, some days old (2026-11-11)."""
    tmp = path.with_name(f".{path.name}.tmp")
    folder = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_CLOEXEC", 0))
    try:
        fcntl.flock(folder, fcntl.LOCK_EX)
        flags = os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
        try:
            fd = os.open(tmp, flags, 0o600)
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                os.close(fd)
                os.unlink(tmp)
                fd = os.open(tmp, flags | os.O_EXCL, 0o600)
            try:
                os.ftruncate(fd, 0)
                mode = 0o600
                if keep_mode:
                    with contextlib.suppress(FileNotFoundError):
                        mode = stat.S_IMODE(os.stat(path).st_mode)
                os.fchmod(fd, mode)
                view = memoryview(data)
                while view:
                    view = view[os.write(fd, view):]
            finally:
                os.close(fd)
            os.replace(tmp, path)
        except BaseException:
            with contextlib.suppress(OSError):
                tmp.unlink()
            raise
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(folder, fcntl.LOCK_UN)
        os.close(folder)


DISK_FULL_ERRNOS = frozenset(n for n in (errno.ENOSPC, getattr(errno, "EDQUOT", None), errno.EROFS) if n is not None)


def disk_full(error: BaseException) -> bool:
    """Whether ERROR is a write the disk refused for room or mode (ENOSPC, EDQUOT, EROFS): what a best-effort cache
    write may skip (Daemon.phase), never a state write the land queue or a wait needs."""
    return isinstance(error, OSError) and error.errno in DISK_FULL_ERRNOS


def write_json(path: Path, doc: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    stable_replace(path, (json.dumps(doc, sort_keys=True) + "\n").encode(), keep_mode=True)


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def read_cache(key: str) -> dict | None:
    doc = read_json(cache_dir() / file_name(key))
    return doc if isinstance(doc, dict) and doc.get("key") == key else None


LOCK_WAIT = 2.0  # how long a read-modify-write waits for a sibling before giving up on the lock
LOCK_BUDGET = 2.0  # how long one gh call may spend waiting on all of these locks together
_lock_deadline: float | None = None


@contextlib.contextmanager
def lock_budget(seconds: float = LOCK_BUDGET):
    """Bound every bounded_lock inside this block to `seconds` *in total*.

    One brokered gh call takes three of these in sequence, so per-lock bounds multiplied: with all
    three held by a wedged sibling a call waited 6.16 s, measured. The waits are each individually
    reasonable and together are not, and what a caller cares about is when `gh` runs, which is one
    number. Nested blocks keep the tighter deadline; outside any block there is no budget, so the
    daemon's own use of these locks is unaffected."""
    global _lock_deadline
    previous = _lock_deadline
    _lock_deadline = time.monotonic() + seconds
    try:
        yield
    finally:
        _lock_deadline = previous


def extend_lock_budget(seconds: float) -> None:
    """Give the budget back time a deliberate wait spent. What it bounds is waiting on a sibling's
    lock; the repeat brake's 30 s is the broker working as intended, and spending the budget on it
    would leave the bookkeeping after it unlocked for no reason."""
    global _lock_deadline
    if _lock_deadline is not None:
        _lock_deadline += seconds


@contextlib.contextmanager
def bounded_lock(path: Path, seconds: float = LOCK_WAIT):
    """Hold `path` exclusively, or yield False after `seconds` rather than wait on it.

    These locks sit on the hot path of every `gh` call on the host, and what they protect is
    bookkeeping -- a repeat delay, a watch-promotion count, a registration. With LOCK_EX and no
    deadline, a single stuck holder was enough to stop `gh` running at all: with
    `.broker-seen.lock` held, `gh pr view 7 -R o/r --json state` was still blocked past a 20 s
    kill, never having reached the real gh. Everything else slow in this file is bounded
    (run_bounded, hard_deadline, DeadlineTimeout); these were the exception, in the one place
    whose contract is that it is never the reason a call fails."""
    try:
        handle = open(path, "a+")
    except OSError:
        yield False
        return
    held = False
    deadline = time.monotonic() + seconds
    if _lock_deadline is not None:
        deadline = min(deadline, _lock_deadline)
    try:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = True
                break
            except OSError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.02)
        yield held
    finally:
        with contextlib.suppress(OSError):
            if held:
                fcntl.flock(handle, fcntl.LOCK_UN)
            handle.close()


def register(key: str, jobs: bool = False, consumer: str | None = None, waited: bool = False,
             began: float | None = None, reader: str | None = None, at: dict | None = None, once: bool = False) -> None:
    """Record interest in `key`. Wanting jobs is sticky while any reader wants them. A head's readers
    are named consumers, each with the time it last asked. A wait marks the watch waitedAt: the daemon
    re-reads a waited run the controller may have lost the finish of (STALE_RUN_REREAD). A new wait passes its start
    (BEGAN, kept as waitBegan; a touch leaves it): the daemon makes one confirming read of a finished run for it.
    READER (default: this process's, reader_name) joins the watch's readers. AT (an upstream `read`, read_times) gives
    the downstream's own interest times, {"touched", "waitedAt", "asked"}: they stamp the watch, its wait and its
    consumer instead of now, so a downstream that polls the cache renews nothing past its own interest."""
    path = watch_dir() / file_name(key)
    watch_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    # read-modify-write: two sessions must not lose each other. Unheld, the write still happens --
    # losing a concurrent registration costs one watch, and waiting costs the gh call.
    with bounded_lock(watch_dir() / ".register.lock"):
        _register_locked(path, key, jobs, consumer, waited, began, reader, at or {}, once)


def watch_entry(key: str, doc: dict, cached: dict | None, touched: float) -> dict:
    """The daemon's entry for one watch file's DOC (Daemon.watches, Daemon.heads_between): its key, cached answer,
    last interest (TOUCHED), wait, readers and consumers."""
    asked = doc.get("consumers") if isinstance(doc.get("consumers"), dict) else {}
    waited = doc.get("waitedAt") if isinstance(doc.get("waitedAt"), (int, float)) else None
    began = doc.get("waitBegan") if isinstance(doc.get("waitBegan"), (int, float)) else None
    since = doc.get("since")
    since = since if isinstance(since, (int, float)) and not isinstance(since, bool) else None
    return {"key": key, "jobs": bool(doc.get("jobs")), "cache": cached, "touched": touched,
            "waitedAt": waited, "waitBegan": began, "readers": readers_of(doc, time.time()),
            "reader": doc.get("reader") if isinstance(doc.get("reader"), str) else "",
            "consumers": {str(k): float(v) for k, v in asked.items() if isinstance(v, (int, float))},
            "since": since}


def stamp_at(now: float, given: Any, prior: Any = None) -> float:
    """A forwarded time (else now), never past now, and never older than PRIOR: interest only moves forward."""
    t = float(given) if isinstance(given, (int, float)) and not isinstance(given, bool) else now
    t = min(now, t)
    return max(t, float(prior)) if isinstance(prior, (int, float)) and not isinstance(prior, bool) else t


def _register_locked(path: Path, key: str, jobs: bool, consumer: str | None, waited: bool = False,
                     began: float | None = None, reader: str | None = None, at: dict | None = None,
                     once: bool = False) -> None:
    at = at or {}
    prior = read_json(path) or {}
    try:
        prior_mtime = path.stat().st_mtime if prior else None
    except OSError:
        prior_mtime = None
    doc: dict[str, Any] = {"key": key, "jobs": bool(jobs or prior.get("jobs"))}
    now = time.time()
    reader = safe_reader(reader) or reader_name()
    readers = readers_of(prior, now)
    if reader_fresh(prior, reader, now):
        doc["reader"], doc["readerAt"] = reader, prior["readerAt"]
    else:
        readers[reader] = now
        doc["reader"], doc["readerAt"] = reader, now
    doc["readers"] = readers
    if waited:
        doc["waitedAt"] = stamp_at(time.time(), at.get("waitedAt"), prior.get("waitedAt") if "waitedAt" in at else None)
    elif isinstance(prior.get("waitedAt"), (int, float)):
        doc["waitedAt"] = prior["waitedAt"]
    starts = [t for t in (began, prior.get("waitBegan")) if isinstance(t, (int, float)) and not isinstance(t, bool)]
    if starts:
        doc["waitBegan"] = max(starts)
    if consumer:
        asked = prior.get("consumers") if isinstance(prior.get("consumers"), dict) else {}
        now = time.time()
        stamp = stamp_at(now, at.get("asked"), asked.get(consumer) if "asked" in at else None)
        doc["consumers"] = {**{k: v for k, v in asked.items() if now - float(v or 0) < HEAD_INTEREST}, consumer: stamp}
    elif isinstance(prior.get("consumers"), dict):
        doc["consumers"] = prior["consumers"]
    # A one-off read's watch (ONCE: `status`) keeps when it was first asked for (since, Daemon.once_answered); asked
    # again ONCE_SPAN later it is a repeat reader's, and any other interest (a wait, the broker, a downstream, a
    # consumer) makes it an ordinary watch.
    if once and not prior:
        doc["since"] = time.time()
    elif once and isinstance(prior.get("since"), (int, float)) and not isinstance(prior.get("since"), bool):
        doc["since"] = prior["since"]
    if "touched" in at:
        # The downstream's own last interest, not this poll's: the watch (and IDLE_EXPIRY) ends when its does.
        touched = stamp_at(time.time(), at.get("touched"), prior_mtime)
        if doc != prior:
            write_json(path, doc)
        try:
            os.utime(path, (touched, touched))
        except OSError:
            pass
        return
    if doc == prior:
        # The same bytes again: the registration is only a read's interest, so refresh the mtime (or not even
        # that, interest_fresh) rather than replace the file through a temporary one.
        try:
            if not interest_fresh(path, key):
                os.utime(path)
            return
        except OSError:
            pass
    write_json(path, doc)


def terminal(kind: str, data: dict | None) -> bool:
    """Merged or closed PRs and completed runs; a comment watch never is (a reply can always come)."""
    if not data or kind == "comment":
        return False
    if kind == "head":
        return bool(data.get("settled"))
    return data.get("state") in {"MERGED", "CLOSED"} if kind == "pr" else data.get("status") == "completed"


def iso_epoch(text: str | None) -> float | None:
    try:
        return dt.datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def stream_time(text: Any) -> str | None:
    """A Go RFC 3339 time (nanoseconds) cut to the microseconds fromisoformat reads."""
    if not isinstance(text, str):
        return None
    return re.sub(r"(\.\d{6})\d+", r"\1", text)


def events_settled(data: Any) -> bool:
    """A PR read whose state only people or a stream event change: read whole, mergeable known and every check
    finished (a running check's commit statuses send no stream event, so it keeps its cycle)."""
    if not isinstance(data, dict) or data.get("checksTruncated") or data.get("checksPageError") \
            or data.get("requiredMissing") or data.get("requiredUnread"):
        return False
    if data.get("mergeable") not in {"MERGEABLE", "CONFLICTING"}:
        return False
    return all(str(c.get("status") or "").upper() == "COMPLETED" for c in data.get("checks") or [] if isinstance(c, dict))


def quick(started: str | None, completed: str | None) -> bool:
    """Finished within REFUSAL_SECONDS of starting: a job-start refusal, not a job that ran."""
    start, end = iso_epoch(started), iso_epoch(completed)
    return start is not None and end is not None and end - start <= REFUSAL_SECONDS


# ---------------------------------------------------------------- GitHub transport


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """urllib would copy the Authorization header to wherever a redirect points; refuse them all."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: ANN001
        return None


OPENER = urllib.request.build_opener(NoRedirect)


# api.github.com edges. On 2026-11-17 from 22:40Z one host resolved api.github.com only to one edge (from 8.8.8.8
# and the host's VPN resolver alike); from there it dropped most SYNs and answered the rest with a 403 that carried no
# rate-limit headers, while GitHub's other edges answered every call. With SOCKET_TIMEOUT's 20 s per connect every read
# failed (URLError) and a tick's reads queued behind each other. Now each connect and TLS handshake to api.github.com
# gets EDGE_CONNECT_TIMEOUT, and a dead edge (a timeout, a failed connect, or the bare 403 edge_refused names) gets one
# retry on another edge address, from a second resolver (DNS over HTTPS) since the system one named only the dead edge.
# No address is written here, and TLS still checks api.github.com's certificate, so a wrong address can only fail. The
# gh-quota shim gives every gh call the same (leo-workspace tools/gh_edge.py); this daemon talks to GitHub itself.
EDGE_HOSTS = {"api.github.com"}
EDGE_CONNECT_TIMEOUT = 3.0
EDGE_BAD_TTL = 600.0
EDGE_DOH_TTL = 300.0
EDGE_DOH_DEFAULT = "https://dns.google/resolve,https://cloudflare-dns.com/dns-query"


def edge_refused(status: int, headers: dict) -> bool:
    """A 403 the edge made, not GitHub's API: no X-RateLimit-* header and no Retry-After. GitHub's own 403s (a rate
    limit, a permission) carry the rate-limit headers and reach the caller as before."""
    if status != 403:
        return False
    return not any(k.lower().startswith("x-ratelimit-") or k.lower() == "retry-after" for k in headers)


class EdgeFailed(OSError):
    def __init__(self, why: str):
        super().__init__(why)
        self.why = why


class Edges:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.reset()

    def reset(self) -> None:
        self.bad: dict[str, float] = {}
        self.doh_cache: tuple[float, list[str]] = (float("-inf"), [])
        self.local = threading.local()

    def is_bad(self, ip: str) -> bool:
        return self.bad.get(ip, 0) > time.time()

    def mark_bad(self, ip: str) -> None:
        with self.lock:
            now = time.time()
            self.bad = {k: v for k, v in self.bad.items() if v > now}
            self.bad[ip] = now + EDGE_BAD_TTL

    def last_ip(self) -> str | None:
        return getattr(self.local, "ip", None)

    @staticmethod
    def resolve(host: str) -> list[str]:
        override = os.environ.get("GLAEDA_EDGE_TEST_RESOLVE", "")
        if override.startswith(host + "="):
            return [ip for ip in override.split("=", 1)[1].split(",") if ip]
        try:
            infos = socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
        except DeadlineTimeout:  # http()'s alarm is one-shot: swallowed here, the rest of the request has no deadline
            raise
        except OSError:
            return []
        return list(dict.fromkeys(info[4][0] for info in infos))

    def doh(self, host: str) -> list[str]:
        """A second resolver's addresses for HOST: DNS over HTTPS (JSON), each provider in GLAEDA_EDGE_DOH in turn."""
        at, ips = self.doh_cache
        if at + EDGE_DOH_TTL > time.time():
            return ips
        plain = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        out: list[str] = []
        for url in (os.environ.get("GLAEDA_EDGE_DOH") or EDGE_DOH_DEFAULT).split(","):
            url = url.strip()
            for rtype in ("A", "AAAA"):
                if not url:
                    break
                query = url + ("&" if "?" in url else "?") + urllib.parse.urlencode({"name": host, "type": rtype})
                try:
                    with plain.open(urllib.request.Request(query, headers={"Accept": "application/dns-json"}),
                                    timeout=2) as answer:
                        records = json.loads(answer.read(65536)).get("Answer") or []
                except DeadlineTimeout:
                    raise
                except (OSError, HTTPException, ValueError, AttributeError):
                    continue
                for record in records:
                    data = record.get("data") if isinstance(record, dict) else None
                    if isinstance(record, dict) and record.get("type") in (1, 28) and isinstance(data, str):
                        try:
                            ipaddress.ip_address(data)
                        except ValueError:
                            continue
                        if data not in out:
                            out.append(data)
            if out:
                break
        self.doh_cache = (time.time(), out)
        return out

    @staticmethod
    def attempt(ip: str, port: int, host: str, context: ssl.SSLContext, timeout: float):
        try:
            raw = socket.create_connection((ip, port), timeout=EDGE_CONNECT_TIMEOUT)
        except DeadlineTimeout:  # the request's hard deadline (a TimeoutError): not a dead edge, and not to be retried
            raise
        except TimeoutError:
            raise EdgeFailed("connect-timeout") from None
        except OSError:
            raise EdgeFailed("connect-failed") from None
        try:
            tls = context.wrap_socket(raw, server_hostname=host)
        except DeadlineTimeout:
            raw.close()
            raise
        except TimeoutError:
            raw.close()
            raise EdgeFailed("tls-timeout") from None
        except ssl.SSLCertVerificationError:
            raw.close()
            raise  # this host's trust store, not the edge: no verdict, the request fails as it did before
        except OSError:
            raw.close()
            raise EdgeFailed("tls-failed") from None
        tls.settimeout(timeout)
        return tls

    def candidates(self, host: str, tried: set[str]) -> list[str]:
        """Edges to retry on: the system resolver's other addresses, then the second resolver's, none marked bad."""
        out: list[str] = []
        for ip in self.resolve(host) + self.doh(host):
            if ip not in tried and ip not in out and not self.is_bad(ip):
                out.append(ip)
        return out

    def connect(self, host: str, context: ssl.SSLContext, timeout: float):
        """A TLS connection to an edge for HOST: the first try, then at most one retry on another edge."""
        port = int(os.environ.get("GLAEDA_EDGE_TEST_PORT") or 443)
        primary = self.resolve(host)
        first = next((ip for ip in primary if not self.is_bad(ip)), None)
        if first is None:
            alts = self.candidates(host, set(primary))
            if alts:  # every resolved edge failed lately: another one, the retry spent on it
                return self.second(host, port, context, timeout, None, "all-marked-bad", alts[0])
            # None known: the resolver's own first answer once more (a blip must not lock reads out for EDGE_BAD_TTL).
            first = primary[0] if primary else None
            if first is None:
                raise EdgeFailed(f"{host} resolves to nothing")
        try:
            sock = self.attempt(first, port, host, context, timeout)
            self.local.ip = first
            return sock
        except EdgeFailed as error:
            self.mark_bad(first)
            alts = self.candidates(host, {first})
            if not alts:
                log({"event": "edge-retry", "host": host, "from": first, "to": None, "why": error.why, "ok": False})
                raise
            return self.second(host, port, context, timeout, first, error.why, alts[0])

    def second(self, host: str, port: int, context: ssl.SSLContext, timeout: float, frm: str | None, why: str,
               to: str):
        try:
            sock = self.attempt(to, port, host, context, timeout)
        except EdgeFailed as error:
            self.mark_bad(to)
            log({"event": "edge-retry", "host": host, "from": frm, "to": to, "why": why, "ok": False, "why2": error.why})
            raise
        if frm is not None:  # a known-bad first edge skipped is no retry
            log({"event": "edge-retry", "host": host, "from": frm, "to": to, "why": why, "ok": True})
        self.local.ip = to
        return sock


EDGE = Edges()


class EdgeHTTPSConnection(http_client.HTTPSConnection):

    def connect(self) -> None:
        if self._tunnel_host or self.host not in EDGE_HOSTS:  # through a proxy, or another host: as before
            super().connect()
            return
        self.sock = EDGE.connect(self.host, self._context, self.timeout)


class EdgeHTTPSHandler(urllib.request.HTTPSHandler):
    def https_open(self, req):  # noqa: ANN001
        return self.do_open(EdgeHTTPSConnection, req)


GITHUB_OPENER = urllib.request.build_opener(NoRedirect, EdgeHTTPSHandler)


# The controller's own opener: urllib's one `timeout` is the socket timeout for the connect and for every read
# alike, which is what conflated "the controller is not there" with "the controller is slow right now"
# (CONTROLLER_CONNECT_TIMEOUT). Here the request carries the read deadline and the connect takes
# CONTROLLER_CONNECT_DEADLINE's value instead, so an unreachable controller still fails fast while an answer
# already coming in is waited for. The deadline travels in a thread-local because urllib has nowhere else to put
# it: it is per request (a tick's budget cuts it), and http.client is per thread anyway.
CONTROLLER_CONNECT_DEADLINE = threading.local()


class ControllerConnect:
    """A connect deadline of its own; the request's timeout then covers the reads."""

    def connect(self) -> None:
        read = self.timeout  # type: ignore[attr-defined]
        self.timeout = getattr(CONTROLLER_CONNECT_DEADLINE, "seconds", None) or CONTROLLER_CONNECT_TIMEOUT
        try:
            super().connect()  # type: ignore[misc]
        finally:
            self.timeout = read
        with contextlib.suppress(OSError, AttributeError):
            self.sock.settimeout(read)  # type: ignore[attr-defined]


class ControllerHTTPConnection(ControllerConnect, http_client.HTTPConnection):
    pass


class ControllerHTTPSConnection(ControllerConnect, http_client.HTTPSConnection):
    pass


class ControllerHTTPHandler(urllib.request.HTTPHandler):
    def http_open(self, req):  # noqa: ANN001
        return self.do_open(ControllerHTTPConnection, req)


class ControllerHTTPSHandler(urllib.request.HTTPSHandler):
    def https_open(self, req):  # noqa: ANN001
        return self.do_open(ControllerHTTPSConnection, req, context=self._context)


CONTROLLER_OPENER = urllib.request.build_opener(NoRedirect, ControllerHTTPHandler, ControllerHTTPSHandler)


def error_site(error: BaseException) -> str:
    """Where `error` was raised: file, line and function only, never values, so a recurring error
    can be found without reproducing it."""
    frames = traceback.extract_tb(error.__traceback__)
    return f"{Path(frames[-1].filename).name}:{frames[-1].lineno} {frames[-1].name}" if frames else ""


def describe(error: BaseException) -> str:
    """Our own messages are safe to show; anything else is reduced to its type name."""
    return str(error) if isinstance(error, WatchError) else type(error).__name__


def describe_at(error: BaseException) -> str:
    """describe(), and for anything not our own message where it was raised (error_site): values never, the site always."""
    site = "" if isinstance(error, WatchError) else error_site(error)
    return f"{describe(error)} at {site}" if site else describe(error)


class DeadlineTimeout(TimeoutError):
    """A hard deadline passed (hard_deadline). A TimeoutError, so callers treat it as a slow answer."""


class ScanDeadline(Exception):
    """A hard deadline passed in a block whose own frames catch OSError (broker_local_repos's scan).

    Deliberately not a TimeoutError, because TimeoutError *is* an OSError: raised from SIGALRM into
    the scan, DeadlineTimeout landed in `except OSError: continue` around the glob and in
    git_config_text's `except (OSError, ValueError): return None`, which read it as "no config
    here" -- and setitimer is one-shot, so the rest of the scan then ran with no deadline at all.
    Measured with `.git/config` a FIFO nobody writes to, which is the hung-mount case the deadline
    was added for: git_config_text returned None 0.30s after the alarm, and a 20 000-checkout scan
    under a 0.05s deadline took 0.76s, silently dropped the one checkout whose read the alarm
    interrupted, and cached that incomplete map as complete for the whole TTL."""


@contextlib.contextmanager
def hard_deadline(seconds: float, error: type[BaseException] = DeadlineTimeout):
    """Raise `error` in the block once `seconds` of wall-clock time pass, even in the middle of a
    blocking read: a socket timeout only bounds each read, so a server that trickles bytes never
    trips it. Uses SIGALRM, so only on the main thread (the daemon's loop); elsewhere it does
    nothing and the watchdog still applies.

    `error` is a parameter because the exception has to be one the block's own handlers do not
    catch; see ScanDeadline."""
    if threading.current_thread() is not threading.main_thread() or not hasattr(signal, "setitimer"):
        yield
        return

    def expire(signum: int, frame: Any) -> None:
        raise error(f"no complete answer within {seconds:g}s")

    previous = signal.signal(signal.SIGALRM, expire)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


# Kept-alive connections. Every request used to open its own TCP and TLS connection (urllib's opener closes it after
# one answer). huge-blue, 2026-11-20 20:0xZ: from there about two connects in five to api.github.com lost their SYN
# (a 7 s connect, or EDGE_CONNECT_TIMEOUT and a retry on another edge; 498 edge-retry lines in the log's tail, 287 with
# no edge left), so the daemon's REST reads averaged 4.3 s each (626 s of GitHub time for 146 requests in ten minutes)
# while a request on an open connection took 0.2-0.5 s, and its ticks spent ~600 s per 600 s in "read rest". Now each
# thread keeps one connection to api.github.com open for the next read (KEPT). Only reads ride it: a GET, or a
# GraphQL query that is not a mutation, and only those are sent again, once, on a new connection when a kept one
# turns out closed (GitHub closes idle ones; nothing was answered). A write (the outbox's POSTs, DELETEs, mutations)
# opens its own connection as before, so a write is never sent twice. A connection idle past KEEPALIVE_IDLE is closed
# rather than reused: a NAT or firewall may have dropped it, and a read on a dead one waits SOCKET_TIMEOUT.
KEEPALIVE_IDLE = 20.0
KEEPALIVE_RETRY = (http_client.RemoteDisconnected, http_client.BadStatusLine, http_client.CannotSendRequest,
                   ConnectionResetError, ConnectionAbortedError, BrokenPipeError,
                   ssl.SSLEOFError, ssl.SSLZeroReturnError)
GRAPHQL_MUTATION = re.compile(rb'"query"\s*:\s*"\s*mutation\b')


class KeptConnections:
    """One kept-alive connection to api.github.com per thread (http.client is not thread-safe)."""

    def __init__(self) -> None:
        self.local = threading.local()
        self.opened = 0  # connections opened, for tests and benchmarks

    def drop(self) -> None:
        held = getattr(self.local, "conn", None)
        self.local.conn = None
        if held is not None:
            with contextlib.suppress(Exception):
                held[0].close()

    def take(self, host: str) -> tuple[http_client.HTTPSConnection, bool]:
        """(a connection, whether it was kept from an earlier request)."""
        held = getattr(self.local, "conn", None)
        if held is not None and held[1] == host and time.monotonic() - held[2] < KEEPALIVE_IDLE:
            return held[0], True
        self.drop()
        self.opened += 1
        return EdgeHTTPSConnection(host, timeout=SOCKET_TIMEOUT), False

    def request(self, method: str, url: str, headers: dict[str, str], body: bytes | None) -> tuple[int, dict, bytes]:
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname or ""
        target = parts.path + (f"?{parts.query}" if parts.query else "")
        while True:
            conn, kept = self.take(host)
            self.local.conn = None  # held by this request only; given back below once its answer is whole
            try:
                if kept:
                    EDGE.local.ip = getattr(conn, "edge_ip", None)
                conn.request(method, target, body=body, headers=headers)
                response = conn.getresponse()
                data = response.read(MAX_BODY)
                whole = response.isclosed() or not response.read(1)
            except KEEPALIVE_RETRY:
                with contextlib.suppress(Exception):
                    conn.close()
                if kept:
                    continue  # the kept connection was closed under it: nothing was answered, a new one reads it
                raise
            except BaseException:
                with contextlib.suppress(Exception):
                    conn.close()
                raise
            if not kept:
                conn.edge_ip = EDGE.last_ip()
            if whole and not response.will_close:
                self.local.conn = (conn, host, time.monotonic())
            else:
                conn.close()
            return response.status, {k.lower(): v for k, v in response.headers.items()}, data


KEPT = KeptConnections()


def keepalive_ok(method: str, url: str, body: bytes | None) -> bool:
    """Whether this request may ride a kept connection, and be sent again on a new one (KEPT): a read to api.github.com
    with no proxy in the way."""
    host = urllib.parse.urlsplit(url).hostname or ""
    if host not in EDGE_HOSTS:
        return False
    proxies = urllib.request.getproxies()
    if (proxies.get("https") or proxies.get("all")) and not urllib.request.proxy_bypass(host):
        return False  # through a proxy: urllib's opener, as before
    if method == "GET":
        return True
    return method == "POST" and url == API + "/graphql" and not GRAPHQL_MUTATION.search(body or b"")


def http(method: str, url: str, headers: dict[str, str], body: bytes | None = None,
         *, deadline: float = float("inf")) -> tuple[int, dict, bytes]:
    if not url.startswith(API + "/"):
        raise WatchError("refusing a request outside api.github.com")
    request = urllib.request.Request(url, data=body, method=method, headers=headers)
    kept = keepalive_ok(method, url, body)

    def once() -> tuple[int, dict, bytes]:
        if kept:
            return KEPT.request(method, url, headers, body)
        try:
            with GITHUB_OPENER.open(request, timeout=SOCKET_TIMEOUT) as response:
                return response.status, {k.lower(): v for k, v in response.headers.items()}, response.read(MAX_BODY)
        except urllib.error.HTTPError as error:  # 304, refused redirects and every 4xx/5xx land here
            return error.code, {k.lower(): v for k, v in (error.headers or {}).items()}, error.read(MAX_BODY)

    try:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise OutOfTime
        with hard_deadline(min(remaining, HTTP_DEADLINE), OutOfTime if remaining < HTTP_DEADLINE else DeadlineTimeout):
            EDGE.local.ip = None
            answer = once()
            edge = EDGE.last_ip()
            if edge is not None and edge_refused(answer[0], answer[1]):
                # The edge's own 403 (no rate-limit headers): GitHub never saw the request. Once more, elsewhere.
                # With no other edge known, the edge's 403 is the answer, as before.
                EDGE.mark_bad(edge)
                KEPT.drop()  # kept to the refusing edge: the retry dials another
                if EDGE.candidates(urllib.parse.urlsplit(url).hostname or "", {edge}):
                    EDGE.local.ip = None
                    try:
                        answer = once()
                    finally:
                        log({"event": "edge-retry", "host": urllib.parse.urlsplit(url).hostname, "from": edge,
                             "to": EDGE.last_ip(), "why": "edge-403", "ok": EDGE.last_ip() is not None})
            return answer
    except (OSError, HTTPException, ValueError) as error:  # DeadlineTimeout is a TimeoutError, an OSError
        raise WatchError(f"request failed: {type(error).__name__}") from None


# ---------------------------------------------------------------- GraphQL slots (one host, one login)
#
# At most graphql_slots() GraphQL requests in flight per login on this host, whoever sends them: the daemon's refreshes
# and a wait's direct read (Daemon.request) and every `glaeda-gh gh` read that reaches GitHub over GraphQL (the broker,
# around the real gh). One flock'd file per slot under BASE/graphql-slots, so the bound holds across processes and a
# holder that dies frees its slot with its last descriptor. hq#13031 (2026-11-17): the login's GraphQL hour drained at
# ~7800 points/h against 5000; on one host a 7-way parallel fan-out of `glaeda-gh gh api graphql` open-PR reads spent
# ~45 calls in 3 min, every process its own GitHub request at once.
GRAPHQL_SLOTS_DEFAULT = 2  # gh-quota.json login_concurrency, else this; GLAEDA_GH_GRAPHQL_SLOTS overrides both
GRAPHQL_SLOT_WAIT = 120.0  # the longest a `glaeda-gh gh` read waits for a slot; past it, it runs (logged: overflow.log)
GRAPHQL_SLOT_POLL = 0.02
GRAPHQL_SLOT_ENV = "GLAEDA_GH_GRAPHQL_SLOT"  # set for gh run under a held slot: a gh call nested in it uses its parent's
GRAPHQL_SLOT_DIR = "graphql-slots"
# gh subcommands that read over GraphQL (gh's own client); `api graphql` is the rest. --watch and --web stay out: one
# holds for as long as the watch lasts, the other sends nothing worth a slot.
GH_GRAPHQL_READS = {("pr", "view"), ("pr", "list"), ("pr", "status"), ("pr", "checks"), ("issue", "view"),
                    ("issue", "list"), ("issue", "status"), ("repo", "view"), ("repo", "list")}


def graphql_slots() -> int:
    """How many GraphQL requests one login may have in flight on this host (at least 1)."""
    raw: Any = os.environ.get("GLAEDA_GH_GRAPHQL_SLOTS")
    if raw is None:
        doc = read_json(Path(os.environ.get("GLAEDA_GH_QUOTA_POLICY")
                             or Path(SPENDERS_CMD).resolve().parent.parent / "machines/gh-quota.json"))
        raw = doc.get("login_concurrency") if isinstance(doc, dict) else None
    try:
        value = int(float(raw)) if raw is not None and not isinstance(raw, bool) else GRAPHQL_SLOTS_DEFAULT
    except (TypeError, ValueError):
        value = GRAPHQL_SLOTS_DEFAULT
    return max(1, min(value, 64)) if value > 0 else GRAPHQL_SLOTS_DEFAULT


def graphql_login() -> str:
    """The github.com login gh's hosts.yml names (the slots are per login), else "default". Never raises."""
    try:
        path = gh_hosts_file()
        text = path.read_text() if path is not None else ""
    except (OSError, UnicodeDecodeError):
        text = ""
    found = re.search(r"^github\.com:[ \t]*\n(?:[ \t]+.*\n|[ \t]*\n)*?[ \t]+user:[ \t]*['\"]?([A-Za-z0-9-]{1,39})",
                      text, re.M)
    return found.group(1) if found else "default"


# GitHub quotes the token's numeric account id in its own quota refusal ("API rate limit already exceeded for user
# ID NNNN"), and quotes the caller's address when the call carried no token ("API rate limit exceeded for 203.0.113.9").
# Both are personal data, and every line this tool prints is pasted into PR bodies, issue comments and ledger rows by
# the agents that read it: on 2026-11-22 `status pr` printed "checks INCONCLUSIVE (partial: 80 of 219 read; check
# pages held: graphql: last real attempt: API rate limit already exceeded for user ID NNNNNNNN...)". A downstream
# guard (leo-workspace tools/public_body_guard.py) refuses the id in a body, but scrubbing after the fact is the
# wrong layer: the refusal must never carry the id. gh_said is the one place GitHub's own words become text this
# tool prints, stores or logs, so the id is dropped where it arrives and nowhere else -- what a reader needs in
# order to act is *whose* bucket is spent (so whose work pauses or moves), which is a login, never an id. The
# actionable words -- which limit, and the reset -- are kept.
GH_SAID_MAX = 200  # the length every message site already cut GitHub's sentence to
GH_USER_ID = re.compile(r"\b(users?)(?:\s+id)?\s+\d{3,}\b", re.I)
# An App's own bucket: no login holds it, and the id names an installation, so the phrase names the holder instead.
GH_INSTALL_ID = re.compile(r"\b(installations?)(?:\s+id)?\s+\d{3,}\b", re.I)
GH_CALLER_IP = re.compile(r"\bfor (?:IP\s+)?(?:(?:\d{1,3}\.){3}\d{1,3}|[0-9a-f:]*::[0-9a-f:]*[0-9a-f])\b", re.I)


def gh_quota_holder() -> str:
    """The login whose per-user quota a refusal names: the github.com login this host's token belongs to
    (graphql_login), else "" when no login can be read here. Never raises, never an id."""
    login = graphql_login()
    return login if login and login != "default" else ""


GH_NO_HOLDER = "(this host's gh login)"  # neutral, and still a per-user bucket: not the repository's, not an App's


def gh_quota_label() -> str:
    """What stands where GitHub wrote an account id: the holder's login, else GH_NO_HOLDER. Read only when a
    message carries an id (gh_sanitize substitutes through this), so a clean message costs nothing."""
    return gh_quota_holder() or GH_NO_HOLDER


def gh_sanitize(text: Any) -> str:
    """TEXT with GitHub's personal identifiers replaced by the holder they stand for (GH_USER_ID's comment).

    A numeric user id becomes the login whose bucket it is, and -- when this host cannot read a login -- the neutral
    "this host's gh login", which still says the spent bucket is a per-user one rather than the repository's or an
    App's. A login is written bare, never "@login": an @name in a PR or issue body notifies that account."""
    out = GH_USER_ID.sub(lambda m: f"{m.group(1)} {gh_quota_label()}", str(text or ""))
    out = GH_INSTALL_ID.sub(r"\1 (an App of this repository's owner)", out)
    return GH_CALLER_IP.sub("for an unauthenticated caller", out)


def primary_said_wait(doc: Any, message: str) -> float | None:
    """Seconds until a primary-limit refusal with no rate headers frees up, from its body's retry_after (a broker's
    answer) or its own words (PRIMARY_SAID_WAIT), at most PACE_HOLD_MAX; None when it names no wait."""
    said = doc.get("retry_after") if isinstance(doc, dict) else None
    if isinstance(said, (int, float)) and not isinstance(said, bool):
        return retry_after_seconds(said)
    found = PRIMARY_SAID_WAIT.search(message or "")
    return retry_after_seconds(found.group(1)) if found else None


def gh_said(error: Any, limit: int | None = GH_SAID_MAX, default: str = "") -> str:
    """GitHub's own words from ERROR as a line this tool may print, store or log (gh_sanitize), cut to LIMIT.

    ERROR is an error node or a response body (its "message", else its "type"), or a string already read out of one;
    DEFAULT stands in when GitHub said nothing. LIMIT None keeps the whole sentence (the caller trims it).
    Every site that reads a "message" out of GitHub's answer goes through here -- test-glaeda-gh asserts it."""
    if isinstance(error, dict):
        text = error.get("message") or error.get("type") or ""
    else:
        text = error if isinstance(error, str) else "" if error is None else str(error)
    out = gh_sanitize(text).strip() or default
    return out if limit is None or len(out) <= limit else out[:limit]


def throttle_why(status: int | None, h: dict, text: str) -> str:
    """Which refusal held this write, named from GitHub's own answer.

    A held write used to record only how long to wait, so every one of them read the same: a secondary
    content-creation limit (wait it out, every writer on the login with you), a spent hourly counter (whose reset is a
    time GitHub gave us, not a guess) and an abuse-detection refusal of this one write are three different problems
    with three different next steps. The name is the evidence a reader needs to pick one."""
    body = text or ""
    if re.search(r"abuse detection", body, re.I):
        return "abuse-detection"
    if re.search(r"submitted too quickly|secondary rate limit", body, re.I):
        return "secondary"
    if h.get("x-ratelimit-remaining") == "0":
        return "hourly-spent"
    if h.get("retry-after"):
        return "retry-after"
    if status == 429:
        return "throttled-429"
    return "unknown"


def gql_text(doc: Any) -> str:
    """A GraphQL answer as the bounded text throttle_why/throttle_message read."""
    try:
        return json.dumps(doc)[:4000] if isinstance(doc, (dict, list)) else str(doc or "")[:4000]
    except (TypeError, ValueError):
        return ""


def throttle_message(text: str) -> str:
    """GitHub's own words for a throttled write, sanitized and bounded (gh_said), or "" when it said nothing."""
    try:
        doc = json.loads(text) if text else None
    except (TypeError, ValueError):
        doc = None
    if isinstance(doc, dict):
        errors = [e for e in (doc.get("errors") or []) if isinstance(e, dict)]
        return gh_said(doc.get("message")) or (gh_said(errors[0]) if errors else "")
    return gh_said((text or "")[:400])


def graphql_slot_wanted(want: Path) -> bool:
    """Whether a priority taker (the daemon) waits for a slot now: its want mark is GRAPHQL_SLOT_WANT_FRESH fresh."""
    try:
        return 0 <= time.time() - want.stat().st_mtime < GRAPHQL_SLOT_WANT_FRESH
    except OSError:
        return False


# id(handle) -> {"handle": a weak reference (a holder that drops its handle unreleased frees the slot as before, when
# the file is collected), "slot", "thread", "what", "since"}
_SLOT_HOLDERS: dict[int, dict[str, Any]] = {}
_SLOT_HOLDERS_LOCK = threading.Lock()


def _slot_gone(h: dict[str, Any]) -> bool:
    handle = h["handle"]()
    return handle is None or handle.closed


def graphql_slot_flight(handle: Any, on: bool) -> None:
    """Mark the slot HANDLE holds as carrying a request on the wire (ON) or not: graphql_slot_reap never frees one in
    flight. Review of glaeda#2189 (F3): a land worker's thread has no SIGALRM deadline, so its request can outlive
    GRAPHQL_SLOT_HOLD_MAX, and the reap closed its slot under it while a second request took the slot."""
    with _SLOT_HOLDERS_LOCK:
        h = _SLOT_HOLDERS.get(id(handle))
        if h is not None:
            h["flight"] = on


def graphql_slot_release(handle: Any) -> None:
    """Give back a slot graphql_slot_take handed out (closing its file frees the lock). Never raises."""
    with _SLOT_HOLDERS_LOCK:
        _SLOT_HOLDERS.pop(id(handle), None)
    with contextlib.suppress(OSError, ValueError):
        handle.close()


def graphql_slot_holders(now: float | None = None) -> list[dict[str, Any]]:
    """The slots this process holds: {"slot", "thread", "what", "heldS"}, longest first."""
    now = time.monotonic() if now is None else now
    with _SLOT_HOLDERS_LOCK:
        for k in [k for k, h in _SLOT_HOLDERS.items() if _slot_gone(h)]:  # closed or dropped without release
            _SLOT_HOLDERS.pop(k, None)
        rows = [{"slot": h["slot"], "thread": h["thread"], "what": h["what"], "heldS": round(now - h["since"], 1)}
                for h in _SLOT_HOLDERS.values()]
    return sorted(rows, key=lambda r: -r["heldS"])


def graphql_slot_reap(bound: float = GRAPHQL_SLOT_HOLD_MAX, now: float | None = None,
                      flight_bound: float = GRAPHQL_SLOT_FLIGHT_MAX) -> list[dict[str, Any]]:
    """Free every slot this process has held past BOUND (GRAPHQL_SLOT_HOLD_MAX) with no request on the wire
    (graphql_slot_flight), or past FLIGHT_BOUND with one: its file is closed, so the lock goes and the next taker (the
    daemon's pr batch) gets it. The holder's own release later is a no-op. Returns who held each: {"slot", "thread",
    "what", "heldS", "inFlight"}."""
    now = time.monotonic() if now is None else now
    with _SLOT_HOLDERS_LOCK:
        for k in [k for k, h in _SLOT_HOLDERS.items() if _slot_gone(h)]:  # closed or dropped without release
            _SLOT_HOLDERS.pop(k, None)
        stale = [(k, h) for k, h in _SLOT_HOLDERS.items()
                 if now - h["since"] > (flight_bound if h.get("flight") else bound)]
        for k, _ in stale:
            _SLOT_HOLDERS.pop(k, None)
    out = []
    for _, h in stale:
        handle = h["handle"]()
        if handle is None:
            continue
        with contextlib.suppress(OSError, ValueError):
            handle.close()
        out.append({"slot": h["slot"], "thread": h["thread"], "what": h["what"], "heldS": round(now - h["since"], 1),
                    "inFlight": bool(h.get("flight"))})
    return out


def graphql_slot_take(deadline: float | None, priority: bool = False, what: str = "") -> tuple[Any, int] | None:
    """A held GraphQL slot (its open file, its index) for this login on this host, waiting until DEADLINE
    (time.monotonic()); None once it passes with every slot held. None deadline: try once. WHAT names the holder
    (graphql_slot_holders, graphql_slot_reap). PRIORITY (the daemon's
    reads) marks the wait (GRAPHQL_SLOT_WANT_FRESH): while the mark is fresh no other taker takes a free slot, so the
    daemon is never starved by the broker's `gh` reads polling the same locks."""
    d = BASE / GRAPHQL_SLOT_DIR
    try:
        d.mkdir(parents=True, exist_ok=True, mode=0o700)
    except OSError:
        return None
    login, k = graphql_login(), graphql_slots()
    want = d / f"{login}.want"
    touched = float("-inf")
    try:
        while True:
            if priority or not graphql_slot_wanted(want):
                for i in range(k):
                    try:
                        handle = open(d / f"{login}.{i}.lock", "a+")
                    except OSError:
                        continue
                    try:
                        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except OSError:
                        handle.close()
                        continue
                    with _SLOT_HOLDERS_LOCK:
                        _SLOT_HOLDERS[id(handle)] = {"handle": weakref.ref(handle), "slot": i, "what": what or "?",
                                                     "thread": threading.current_thread().name,
                                                     "since": time.monotonic()}
                    return handle, i
            if deadline is None or time.monotonic() >= deadline:
                return None
            if priority and time.monotonic() - touched >= GRAPHQL_SLOT_WANT_TOUCH:
                touched = time.monotonic()
                with contextlib.suppress(OSError):
                    want.touch()
            time.sleep(GRAPHQL_SLOT_POLL)
    finally:
        if priority and touched > float("-inf"):
            with contextlib.suppress(OSError):
                want.unlink()


def graphql_slot_overflow(what: str, waited: float) -> None:
    """A CLI read that ran without a slot after GRAPHQL_SLOT_WAIT: one line in BASE/graphql-slots/overflow.log."""
    with contextlib.suppress(OSError):
        with open(BASE / GRAPHQL_SLOT_DIR / "overflow.log", "a") as out:
            out.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} pid={os.getpid()} "
                      f"waited={waited:.0f}s {what[:120]}\n")


def gh_graphql_read(args: list[str]) -> bool:
    """Whether `gh ARGS` is a read gh sends over GraphQL (a slot's worth). Never raises."""
    try:
        words, method, seen, _values = broker_words(args)
        if words[:2] == ["api", "graphql"]:
            return not gh_cache_is_write(args, words, method)
        return tuple(words[:2]) in GH_GRAPHQL_READS and not seen & {"--watch", "--web"}
    except Exception:  # noqa: BLE001  a lookup in front of a gh call
        return False


# A lane VM holds no GitHub login (lane_vm_gh: its gh is the lane-gh broker's credential chain), so its `gh` GraphQL
# reads spend no login hour of this host's: the broker asks them on its read Apps first, behind its own per-VM read
# admission and per-identity connection caps. The two slots of the login "default" (no hosts.yml here) were a queue
# with nothing behind it: gcp-agent-lane-1, 2026-11-22 16:19:42Z, `gh pr view 49882 --json ...` waited exactly
# GRAPHQL_SLOT_WAIT (120 s) for a slot before it reached lane-gh at 16:21:42Z, and overflow.log held 3,331 such
# 120 s waits (56 in the hour to 16:25Z), every lane's land-judge read among them; with broker reads taking 15-25 s
# each under load, two slots carried about one read every 10 s for the whole VM. land-judge's explain then ran 9.5
# min against glaeda land's 300 s kill and every judgment read "unreadable". So on a lane VM a CLI read takes no slot;
# the daemon's own reads keep theirs (Daemon.request).


def gh_graphql_slot_for(args: list[str]) -> Any:
    """For the broker: a held slot's open file when `gh ARGS` is a GraphQL read that needs one, else None (not a
    GraphQL read, a lane VM's read (no login here: the lane-gh broker paces it), a gh call nested under a slot its
    parent holds, or GRAPHQL_SLOT_WAIT passed: logged)."""
    if not gh_graphql_read(args):
        return None
    if lane_vm_gh() is not None:
        return None
    holder = os.environ.get(GRAPHQL_SLOT_ENV, "")
    if holder.isdigit() and int(holder) > 1:
        with contextlib.suppress(OSError):
            os.kill(int(holder), 0)  # the holder still runs: this call is nested inside its slot
            return None
    start = time.monotonic()
    got = graphql_slot_take(start + GRAPHQL_SLOT_WAIT, what="gh " + " ".join(args[:2]))
    if got is None:
        graphql_slot_overflow(" ".join(args[:3]), time.monotonic() - start)
        return None
    return got[0]


def run_bounded(argv: list[str], timeout: float | None = None, input_text: str | None = None,
                env: dict | None = None) -> subprocess.CompletedProcess:
    """subprocess.run(capture_output=True, text=True) with a deadline that holds. On a timeout run()
    kills only the child and then waits for its pipes, which a grandchild that inherited them keeps
    open for as long as it lives. Here the child leads its own process group and the whole group is
    killed. Raises subprocess.TimeoutExpired or OSError."""
    timeout = SUBPROCESS_DEADLINE if timeout is None else timeout
    env = deadline_env(env, timeout)
    with subprocess.Popen(self_bounded(argv, timeout, env),
                          stdin=subprocess.DEVNULL if input_text is None else subprocess.PIPE, env=env,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True) as proc:
        try:
            out, err = proc.communicate(input=input_text, timeout=timeout)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, signal.SIGKILL)
            with contextlib.suppress(OSError):  # a child that left its group; Popen.__exit__ waits for it
                proc.kill()
            with contextlib.suppress(subprocess.TimeoutExpired, OSError, ValueError):
                proc.communicate(timeout=2)
            for stream in (proc.stdout, proc.stderr):  # a grandchild that left the group still holds them
                with contextlib.suppress(OSError):
                    stream.close()
            raise subprocess.TimeoutExpired(argv, timeout) from None
    return subprocess.CompletedProcess(argv, proc.returncode, out, err)


# A bound held only by its caller (communicate(timeout=) then killpg) ends with the caller: the daemon's execv (an
# update, the stale valve) or a killed `budget` drops every thread mid-wait, and the child, in its own session, runs
# on. cosmic-gray 2026-11-22: 55 `reach HOST sh -c '... @@budget ...'` probes (bound FLEET_HOST_TIMEOUT, 25 s) alive
# 29 minutes, and 19 finished children of `glaeda-gh serve` defunct for up to 1.5 days, started by an image the
# daemon had execv'd away (cmuxterm-hq handbook: mirror-read-outlives-its-bound.md). So the bound also lives in the
# child: coreutils `timeout` leads its process group and signals the whole group at the bound, whoever the parent is.
SELF_BOUND_SLACK = 5.0  # the child's own bound is this long past its caller's, so a live caller always acts first
SELF_BOUND_KILL = 5  # timeout -k: SIGKILL this long after the SIGTERM
TIMEOUT_PATHS = ("/opt/homebrew/bin/timeout", "/usr/local/bin/timeout", "/usr/bin/timeout", "/bin/timeout",
                 "/opt/homebrew/bin/gtimeout", "/usr/local/bin/gtimeout")
TIMEOUT_ENV = "GLAEDA_GH_TIMEOUT_CMD"  # a test's or an operator's coreutils timeout; empty turns the self-bound off
DETACHED_BOUND = 600.0  # a fire-and-forget alert send (tell-coordinator, coord-alert) running longer is hung


DEADLINE_ENV = "CMUX_DEADLINE"  # unix seconds past which this process tree is over its bound (agent-orphan-reaper)
DEADLINE_OWNER_ENV = "CMUX_DEADLINE_OWNER"  # the tool that set it
DEADLINE_OWNER = "glaeda-gh"


def deadline_env(env: dict | None, seconds: float | None) -> dict | None:
    """ENV (None: this process's) plus CMUX_DEADLINE, the epoch second the child's self-bound has killed it by, and
    CMUX_DEADLINE_OWNER: the shared contract by which leo-workspace's agent-orphan-reaper prunes any tool's child
    that outlived its bound, whatever tool started it. ENV unchanged with no finite bound."""
    if seconds is None or not math.isfinite(seconds):
        return env
    base = dict(os.environ if env is None else env)
    base[DEADLINE_ENV] = str(math.ceil(time.time() + max(0.0, seconds) + SELF_BOUND_SLACK + SELF_BOUND_KILL))
    base[DEADLINE_OWNER_ENV] = DEADLINE_OWNER
    return base


def coreutils_timeout() -> str | None:
    """The coreutils `timeout` this host has (GLAEDA_GH_TIMEOUT_CMD, else the first of TIMEOUT_PATHS), or None."""
    if TIMEOUT_ENV in os.environ:
        named = os.environ[TIMEOUT_ENV]
        return named if named and os.access(named, os.X_OK) else None
    return next((p for p in TIMEOUT_PATHS if os.access(p, os.X_OK)), None)


def self_bounded(argv: list[str], seconds: float | None, env: dict | None = None) -> list[str]:
    """ARGV run under `timeout -k SELF_BOUND_KILL SECONDS+SELF_BOUND_SLACK`, so it ends at its bound even when its
    caller is gone first. ARGV unchanged with no bound, no timeout on this host, or an ARGV[0] that does not resolve
    (Popen's OSError then names it, as the callers expect, instead of timeout's exit 127)."""
    tool = coreutils_timeout()
    if not argv or seconds is None or not math.isfinite(seconds) or tool is None:
        return list(argv)
    if shutil.which(argv[0], path=(env if env is not None else os.environ).get("PATH")) is None:
        return list(argv)
    return [tool, "-k", str(SELF_BOUND_KILL), f"{max(0.0, seconds) + SELF_BOUND_SLACK:g}", *argv]


def remote_self_bounded(script: str, seconds: float) -> str:
    """A `sh -c` SCRIPT for another host that bounds itself there: under that host's coreutils timeout (the first of
    TIMEOUT_PATHS; ssh's PATH has no Homebrew) at SECONDS, so a remote side whose ssh or caller died ends too; run
    as it is where the host has none."""
    inner = shlex.quote(script)
    found = " ".join(shlex.quote(p) for p in TIMEOUT_PATHS)
    return (f'for t in {found}; do if [ -x "$t" ]; then exec "$t" -k {SELF_BOUND_KILL} {seconds:g} sh -c {inner}; '
            f'fi; done; {script}')


# Every child serve starts and does not wait for is reaped here, each tick (reap_children). An unreaped child is a
# zombie until the daemon exits, and the daemon re-executes itself instead of exiting: the new image holds no Popen
# for the old image's children, so serve adopts them by PID when it starts (adopt_inherited) and reaps those too.
DETACHED: list[subprocess.Popen] = []
INHERITED: set[int] = set()
DETACHED_LOCK = threading.Lock()


def spawn_detached(argv: list[str], bound: float | None = None, **kwargs: Any) -> subprocess.Popen:
    """Popen(ARGV) in a session of its own, not waited for, kept for reap_children; with BOUND, self_bounded. Raises
    OSError as Popen does."""
    reap_children()
    if bound is not None:
        kwargs["env"] = deadline_env(kwargs.get("env"), bound)
    proc = subprocess.Popen(self_bounded(argv, bound, kwargs.get("env")), start_new_session=True, **kwargs)
    with DETACHED_LOCK:
        DETACHED.append(proc)
    return proc


def child_pids(parent: int) -> set[int]:
    """PARENT's child processes now (zombies included), from one ps."""
    try:
        done = subprocess.run(["/bin/ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True, timeout=10,
                              stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return set()
    pids = set()
    for line in done.stdout.splitlines():
        words = line.split()
        if len(words) == 2 and words[1] == str(parent) and words[0].isdigit():
            pids.add(int(words[0]))
    return pids


def adopt_inherited() -> int:
    """serve's first step: every child this PID has before the new image starts any is the previous image's (an
    execv keeps the PID and its children), kept for reap_children. The count adopted."""
    found = child_pids(os.getpid())
    with DETACHED_LOCK:
        INHERITED.update(found)
    return len(found)


def reap_children() -> int:
    """Wait for every detached and inherited child that ended (never blocking); the count still running."""
    with DETACHED_LOCK:
        alive = []
        for proc in DETACHED:
            with contextlib.suppress(Exception):  # a test's stand-in, or a poll the OS refused: dropped
                if proc.poll() is None:
                    alive.append(proc)
        DETACHED[:] = alive
        for pid in list(INHERITED):
            try:
                ended, _ = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                ended = pid  # reaped already, or not ours
            except OSError:
                continue
            if ended:
                INHERITED.discard(pid)
        return len(DETACHED) + len(INHERITED)


def internal_env() -> dict:
    """This process's environment plus GLAEDA_GH_INTERNAL: for this daemon's own `glaeda-gh gh api` reads, which
    are piped through the broker on purpose (the answer cache shares them) and keep the route they have today
    rather than being handed to the host's quota guard as a person's call is (see broker_guard_comes_back)."""
    return {**os.environ, GLAEDA_INTERNAL: "1"}


def retry_after_seconds(value: Any) -> float | None:
    """A Retry-After header as seconds, at most PACE_HOLD_MAX, or None when it says no usable number. float() takes
    "inf", "nan" and "1e12": an infinite hold overflowed every int() after it (the queued write was dropped as a bad
    entry), and a huge finite one held the outbox, and was reported to every writer on the login, for years."""
    try:
        seconds = float(value) if value else None
    except (TypeError, ValueError):
        return None
    if seconds is None or math.isnan(seconds) or seconds == -math.inf:
        return None
    return max(0.0, min(seconds, float(PACE_HOLD_MAX)))


def saved_hold(value: Any, now: float) -> float:
    """A hold read back from disk (daemon.json's outbox.holdUntil) as epoch seconds, at most PACE_HOLD_MAX past `now`
    as every other hold, or 0.0 (none) for anything that is not a finite number: a corrupt far future held the outbox
    for good, and a string, a list or an int too large for a float raised in Daemon() and stopped the daemon starting."""
    if isinstance(value, bool) or not isinstance(value, (int, float, str)):
        return 0.0
    try:
        until = float(value)
    except (ValueError, OverflowError):
        if isinstance(value, str) or value < 0:
            return 0.0  # an int past a float's range below zero: the far past, no hold
        return now + PACE_HOLD_MAX  # and above: the far future
    if not math.isfinite(until):
        return 0.0
    return max(0.0, min(until, now + PACE_HOLD_MAX))


# What the keeper says when it fails reaches daemon.json (outbox.pause.lastError) and the log: anything shaped like a
# credential is dropped first, then the text is cut to KEEPER_TEXT_MAX.
KEEPER_TEXT_MAX = 200
KEEPER_SECRET_RE = re.compile(
    r"gh[posur]_[A-Za-z0-9_]{8,}|github_pat_[A-Za-z0-9_]{8,}"  # GitHub's token shapes, even cut short
    r"|\b(?:bearer|token|basic)\s+\S+"  # an Authorization header's value
    r"|\b[0-9a-f]{32,}\b"  # a long hex run
    r"|[A-Za-z0-9+/_-]{32,}={0,2}",  # a long base64 run
    re.IGNORECASE)


def keeper_text(text: str) -> str:
    """The keeper's own words, safe to store and log: credential-shaped runs redacted, at most KEEPER_TEXT_MAX
    characters. Redacted before the cut, so a token the cut would split is never half kept."""
    return KEEPER_SECRET_RE.sub("[redacted]", text)[:KEEPER_TEXT_MAX]


_CONTENT_PAUSE_UNREAD: set[str] = set()  # CONTENT_PAUSE_ENV values already logged as unreadable


def content_pause_cmd() -> list[str] | None:
    """The command that reads and extends the login's create pause (CONTENT_PAUSE_ENV), or None: none on this host.
    A setting shlex cannot read (an unclosed quote) is no command, logged once: raising here stopped every outbox
    pass."""
    named = os.environ.get(CONTENT_PAUSE_ENV)
    if named is not None:
        try:
            return shlex.split(named) or None
        except ValueError as error:
            if named not in _CONTENT_PAUSE_UNREAD:
                _CONTENT_PAUSE_UNREAD.add(named)
                log({"event": "content-pause-cmd",
                     "error": f"{CONTENT_PAUSE_ENV} unreadable ({error}): no pause asked"})
            return None
    with contextlib.suppress(OSError):
        cli = PACE_CLI.resolve().parent / "gh_quota.py"
        if cli.is_file():
            return [sys.executable, "-I", os.fspath(cli)]
    for name in CONTENT_PAUSE_NAMES:
        found = shutil.which(name)
        if found:
            return [found]
    return None


def find_gh() -> str | None:
    """gh on PATH, else where Homebrew and distributions put it: a LaunchAgent's PATH is minimal."""
    for candidate in (shutil.which("gh"), os.fspath(Path.home() / ".local/bin/gh"), "/opt/homebrew/bin/gh",
                      "/usr/local/bin/gh", "/usr/bin/gh"):
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


def gh_token() -> str:
    gh = find_gh()
    if gh is None:
        raise WatchError("gh not found")
    try:
        # gh-auth-token-lint: allow authored-write: direct writes need the host login identity.
        result = run_bounded([gh, "auth", "token", "--hostname", "github.com"])
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WatchError(f"gh auth token: {type(error).__name__}") from None
    token = result.stdout.strip()
    if result.returncode != 0 or not token:  # neither stream is repeated: stdout may be a token
        raise WatchError(f"gh auth token exited {result.returncode}; is gh signed in?")
    if not TOKEN_RE.fullmatch(token):
        raise WatchError("gh auth token printed something that is not a GitHub token")
    return token


# ---------------------------------------------------------------- the ci-watch App pool (reads off the login)

# Leo, 2026-11-18: "you use the apps where they're useful, and it just does it automatically, so no agents necessarily
# even have to think about it." leo-workspace machines/gh-app-roles.json gives glaeda-gh to the ci-watch role, but that
# routing lives in the gh-quota shim (tools/gh_app_token.py route), and this daemon talks to GitHub itself with
# `gh auth token`, so all its reads (about 295 REST an hour on one host that day) stayed on the account's login.
# Now a REST GET of a repo the role's Apps are installed on goes out on the ci-watch installation token when this host
# holds that App (~/.config/gh-app-tokens/ci-watch.json and .pem, written by gh_app_token.py when the App was made):
# the token is `gh_app_token.py token ci-watch --owner OWNER` (the copy next to the gh-quota shim gh_quota.py, which
# caches it an hour), kept in memory, never written or logged. A host with no key (huge-blue: the role keys live only
# on the key home) holds the App too while the key home's pushed one-hour read-only token,
# ~/.config/gh-app-tokens/ci-watch-token.json, is unexpired: `token ci-watch` answers with it there. Only reads (a REST
# GET of a repository, a GraphQL query naming one owner, never a mutation, never the outbox) are offered to the pool,
# so a read-only token is enough. Writes, the outbox's lookups, /rate_limit and every owner no App is installed on stay
# on the login, so authorship (CLA, receipts) and the login's budget readings are as before. A host without the App,
# a mint that fails, or an App answer that is refused (401, 403, 429) or under APP_POOL_FLOOR left sends the read on
# the login at once, exactly as before, and rests the pool (APP_POOL_REST, or until the App's reset). App reads are
# not charged to restShare and their rate headers are not the login's budget: daemon.json appPool says what they spent.
APP_POOL_ROLE = "ci-watch"
# Spare App pools (Leo, 2026-11-20: the login's GraphQL was spent, "0 left", while one App pool served every read): a
# read goes to the first pool of the chain that holds a token, covers the route and is not resting, so a second App
# (its role in machines/gh-app-roles.json, its token pushed by the key home) is another 12,500 an hour. Comma list of
# roles after the primary; GLAEDA_GH_APP_SPARES="" turns the spares off.
# Apps first, the login last (Leo, 2026-11-22: "use more of the apps then. go make more"): every land-queue rate-limit
# refusal on one host that day was the shared login at 0 of 5,000 GraphQL points, not an App, and the five daemons
# sent about 2,730 of the login's 3,048 GraphQL calls an hour. The default chain is now land-judge (the land queue's
# reads, its own 12,500 an hour), glaeda (this daemon's own App), ci-watch, quota-goblin (the most spent). A list that
# names the primary (APP_POOL_ROLE) is the whole chain in its order (app_pool_chain); one that does not is the roles
# after the primary, as before, so GLAEDA_GH_APP_SPARES=quota-goblin is the chain before this change. A role whose
# token this host does not hold is passed over (held_here), as a spare always was.
APP_POOL_CHAIN = "land-judge,glaeda,ci-watch,quota-goblin"
APP_POOL_SPARES = tuple(r for r in (os.environ.get("GLAEDA_GH_APP_SPARES", APP_POOL_CHAIN) or "").replace(" ", "").split(",") if r)


def app_pool_chain(roles: "tuple[str, ...] | list[str]", primary: str = APP_POOL_ROLE) -> list[str]:
    """The App roles a read tries, in order: ROLES itself when it names PRIMARY, else PRIMARY then ROLES. Once each."""
    order = list(roles) if primary in roles else [primary, *roles]
    return list(dict.fromkeys(r for r in order if r))


APP_POOL_DIR = Path(os.environ.get("GH_APP_TOKEN_DIR") or Path.home() / ".config/gh-app-tokens")
APP_POOL_TTL = 300.0  # a token from gh_app_token.py is used this long (it hands out one with 10+ minutes left)
APP_POOL_REST = 300.0  # a failed mint or a refused answer: the pool is not asked again for this long
APP_POOL_ROUTE_REST = 3600.0  # a route the App answered 403 or 404 stays on the login this long
APP_POOL_PUSHED_MIN_LEFT = 120.0  # a pushed token this close to its end is not asked for (gh_app_token.py's own floor)
APP_POOL_FLOOR = 500  # an App answer with fewer left: the pool's other users (base_red_watch, cmux-ci) keep the rest
APP_POOL_BENCH_FILE = "app-pool-benched.json"  # the scopes the App refused, kept across a re-exec (restore_bench)
APP_POOL_REPO = re.compile(r"/repos/([A-Za-z0-9][A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]+(?:/|\?|$)")
APP_POOL_GRAPHQL_OWNER = re.compile(r"^o\d+$")
APP_POOL_GRAPHQL_URL = re.compile(r"^https://github\.com/([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]+)(?:/|$)", re.I)
# The follow-up queries of a read name their repository another way: a head and its check pages in the query text
# (head_query's repository(owner:"X",name:"Y")), and a suite's or a check run's nodes(ids:) not at all, so the daemon
# names the repositories it asked about in the body's APP_POOL_ROUTE_FIELD ("OWNER/REPO", ...), which request() strips
# before sending. Without either, every one of them went on the login: one day's hour on two hosts, the login's
# GraphQL points were all heads (head, head-pages), PR check pages (pr-pages), suite attempts (last-real-attempt) and
# steps, about 670 and 825 an hour, while the PR and run reads beside them went on the App and the login sat at its
# reserve with both role Apps over 90% unspent.
APP_POOL_GRAPHQL_LITERAL = re.compile(r'repository\(owner:"([A-Za-z0-9][A-Za-z0-9-]{0,38})",name:"([A-Za-z0-9._-]+)"\)')
APP_POOL_ROUTE_FIELD = "route"
APP_POOL_ROUTE_REPO = re.compile(r"^([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]+)$")


def graphql_named_repos(body: dict | None) -> list[tuple[str, str]]:
    """The (owner, repo) pairs a GraphQL body names outside its variables: head_query's literal repositories, and the
    daemon's APP_POOL_ROUTE_FIELD for a query by node id. Lowercase."""
    if not isinstance(body, dict):
        return []
    pairs = [(o.lower(), r.lower()) for o, r in APP_POOL_GRAPHQL_LITERAL.findall(str(body.get("query") or ""))]
    route = body.get(APP_POOL_ROUTE_FIELD)
    for item in route if isinstance(route, list) else []:
        m = APP_POOL_ROUTE_REPO.match(item) if isinstance(item, str) else None
        if m:
            pairs.append((m.group(1).lower(), m.group(2).lower()))
    return pairs


# A GraphQL NOT_FOUND for a pull request or issue number that does not exist is GitHub's answer for that alias, the same
# on the login: not the App lacking a permission or repository. Counted as a refusal, one closed-and-deleted PR number
# in a batch put every batch of that repository set on the login for APP_POOL_ROUTE_REST (an hour), where the login's
# pace and reserve hold it (the broker host, 2026-11-22: "app-pool-refused ... status 200" at 23:xx, 01:xx and 02:50Z).
APP_POOL_ANSWERED_NOT_FOUND = re.compile(
    r"NOT_FOUND Could not resolve to (?:a PullRequest|an Issue|an issue or pull request) with the number of \d+\.?", re.I)


# A PR's base branch with classic protection: its rule needs administration, which no read App holds, so the App's
# answer carries FORBIDDEN at pN.pullRequest.baseRef.branchProtectionRule and every other field of the PR. Counted as a
# refusal it put cmux and cmuxterm-hq on the login for APP_POOL_ROUTE_REST, under the login's pace and reserve: the
# broker host, 2026-11-22 05:0xZ, both read Apps "refused graphql:manaflow-ai:cmuxterm-hq,cmux" with 12,234 of 12,500
# points left, every path on REST, waited PR data 8,629 s old. That one field is not the App's refusal: fetch_aliased
# keeps the checks it last called required instead, as a REST read without reads_protection does.
APP_FORBIDDEN_PROTECTION = ("baseRef", "branchProtectionRule")


def protection_forbidden(error: Any) -> bool:
    """Whether one GraphQL error is the App's FORBIDDEN on a base branch's classic protection rule only."""
    path = error.get("path") if isinstance(error, dict) else None
    return (isinstance(path, list) and tuple(path[-2:]) == APP_FORBIDDEN_PROTECTION
            and str(error.get("type") or "") == "FORBIDDEN")


def app_graphql_refused(message: str) -> bool:
    """Whether a 200 GraphQL answer's errors (request's "TYPE message ..." text) say the App may not read it: FORBIDDEN,
    or a NOT_FOUND other than a missing PR or issue number (a repository the installation does not cover)."""
    if re.search(r"FORBIDDEN", message):
        return True
    return "NOT_FOUND" in APP_POOL_ANSWERED_NOT_FOUND.sub("", message)


# Another organization's IP allow list refuses one node of a batch, not the repository. Every hour both read Apps were
# answered 200 with "FORBIDDEN Although you appear to have the correct authorization credentials, the `X` organization
# has an IP allow list enabled, and your IP address is not permitted to access this resource." on a manaflow-ai/cmux
# query (one host, 2026-11-22: 5, 6, 10 and 17 per App in the 10Z-13Z hours), and the single-repository scope was
# benched APP_POOL_ROUTE_REST, so every cmux GraphQL read went on the login until its quota ran out (14:13-14:27Z: of
# 91 land judgments, 8 unreadable and 9 quota). X is not the repository's owner: it owns something one node points at
# (a check suite's app, a head repository), and GitHub names that node in the error's path. Such a refusal now benches
# that node ("node:OWNER/REPO#N", "node:OWNER/REPO@SHA", "node:OWNER/REPO/runs/ID", "node:id:NODE_ID") in every pool
# of the chain, for APP_POOL_ROUTE_REST: a query naming it goes on the login, batched() reads it apart from the rest,
# and the rest stay on the App. One that names no path, or another error beside it, keeps the scope bench.
# GLAEDA_GH_APP_NODE_BENCH=0 turns it off (the repository scope is benched, as before).
APP_POOL_NODE_BENCH = (os.environ.get("GLAEDA_GH_APP_NODE_BENCH", "1") or "1").strip().lower() not in {"0", "off", "false", "no"}
APP_POOL_IP_ALLOW_LIST = re.compile(r"the `([A-Za-z0-9][A-Za-z0-9-]{0,38})` organization has an IP allow list enabled", re.I)
APP_POOL_ALIAS = re.compile(r"^[a-z](\d+)$")
APP_POOL_RUN_URL = re.compile(r"^https://github\.com/([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]+)/actions/runs/(\d+)",
                              re.I)
APP_POOL_HEAD_ALIAS = re.compile(r'(?<![\w$])([a-z]\d+): ?repository\(owner:"([A-Za-z0-9][A-Za-z0-9-]{0,38})",'
                                 r'name:"([A-Za-z0-9._-]+)"\)\{object\(oid:"([0-9a-fA-F]{40})"\)')


def graphql_body_nodes(body: dict | None) -> dict[str, str]:
    """{alias or "FIELD.INDEX": node} for every node a GraphQL BODY asks: an aliased PR or issue (o/r/n variables),
    run (u variable) or head (head_query's literal repository and commit), and each id of a nodes(ids:) list."""
    if not isinstance(body, dict):
        return {}
    variables = body.get("variables") if isinstance(body.get("variables"), dict) else {}
    out: dict[str, str] = {}
    for key, value in variables.items():
        m = re.fullmatch(r"o(\d+)", str(key))
        if m and isinstance(value, str):
            repo, number = variables.get(f"r{m.group(1)}"), variables.get(f"n{m.group(1)}")
            if isinstance(repo, str) and isinstance(number, int) and not isinstance(number, bool):
                out[m.group(1)] = f"{value.lower()}/{repo.lower()}#{number}"
        m = re.fullmatch(r"u(\d+)", str(key))
        run = APP_POOL_RUN_URL.match(value) if m and isinstance(value, str) else None
        if m and run:
            out[m.group(1)] = f"{run.group(1).lower()}/{run.group(2).lower()}/runs/{run.group(3)}"
        if isinstance(value, list):
            for i, item in enumerate(value):
                if isinstance(item, str) and item:
                    out[f"{key}.{i}"] = f"id:{item}"
    for alias, owner, repo, sha in APP_POOL_HEAD_ALIAS.findall(str(body.get("query") or "")):
        out[alias] = f"{owner.lower()}/{repo.lower()}@{sha.lower()}"
    return out


def graphql_error_node(body: dict | None, path: Any) -> str | None:
    """The node of BODY an error's PATH is under (graphql_body_nodes), or None: an alias p3 is its o3/r3/n3 PR (or a
    head's literal h3), a path ["suiteRuns", 4, ...] the fifth id of the body's one list variable."""
    if not isinstance(path, list) or not path:
        return None
    nodes = graphql_body_nodes(body)
    alias = APP_POOL_ALIAS.match(str(path[0]))
    if alias:
        return nodes.get(str(path[0])) or nodes.get(alias.group(1))
    if len(path) > 1 and type(path[1]) is int:
        variables = (body or {}).get("variables") if isinstance((body or {}).get("variables"), dict) else {}
        lists = [k for k, v in variables.items() if isinstance(v, list)]
        if len(lists) == 1:
            return nodes.get(f"{lists[0]}.{path[1]}")
    return None


def foreign_ip_refusal(owner: str, body: dict | None, errors: Any) -> list[tuple[str, str]] | None:
    """[(node, "path.as.text"), ...] when every error of a 200 App answer that refuses (app_graphql_refused) is
    another organization's IP allow list (an organization that is not OWNER) at a path naming one node of BODY; else
    None (no such error, one with no path, or any other refusal beside it: the scope is benched as before)."""
    if not APP_POOL_NODE_BENCH or not isinstance(errors, list):
        return None
    found: list[tuple[str, str]] = []
    for e in errors:
        if not isinstance(e, dict) or protection_forbidden(e) or foreign_app_forbidden(owner, e):
            continue
        text = gh_said(str(e.get("type") or "") + " " + str(e.get("message") or ""), limit=None)
        if not app_graphql_refused(text):
            continue
        org = APP_POOL_IP_ALLOW_LIST.search(text)
        node = graphql_error_node(body, e.get("path"))
        if not (str(e.get("type") or "") == "FORBIDDEN" and org and org.group(1).lower() != owner.lower() and node):
            return None
        found.append((node, ".".join(str(p) for p in e["path"])))
    return found or None


# One field of an answer is not the answer. The broker host, 2026-11-22 18Z to 2026-11-23 02Z: 1,300
# app-pool-node-refused lines, every one at suiteRuns.N.app, every one the `cursor` organization's IP allow list: an
# App token may not read the Cursor App's own node from this address, while the suite itself (its conclusion, its
# workflow run, its check runs) came back whole beside that error. Each one benched the suite node in every pool, so
# that read and every read of that suite for the next hour went on the login (867 `refused` and 898 `pool-resting`
# login-fallback lines in those 9 hours; Leo: "we have ten App pools for exactly this"). Such an error is now part of
# the answer: the App's 200 is kept, no node or scope is benched, and the field reads as unread (unread_foreign_apps),
# never as GitHub's documented null app.
APP_FIELD = "app"


def foreign_app_forbidden(owner: str, error: Any) -> bool:
    """Whether one GraphQL error of a 200 App answer is another organization's IP allow list refusing an `app` field
    only (a check suite's App node): the rest of the answer stands."""
    if not isinstance(error, dict) or str(error.get("type") or "") != "FORBIDDEN":
        return False
    path = error.get("path")
    if not (isinstance(path, list) and len(path) > 1 and path[-1] == APP_FIELD):
        return False
    org = APP_POOL_IP_ALLOW_LIST.search(gh_said(error, None))  # (sanitized: the org name survives)
    return bool(org) and org.group(1).lower() != str(owner or "").lower()


def unread_foreign_apps(owner: str, doc: Any) -> list[str]:
    """Take DOC's foreign_app_forbidden errors out of it, in place, and return their paths ("suiteRuns.3.app"). Each
    path's `app` key is removed from its object, which is marked appUnread: a reader sees an App it could not read,
    not a null one (run_identity's appNull) and not an unread suite (suite_runs reads a suite by its errors)."""
    if not isinstance(doc, dict) or not isinstance(doc.get("errors"), list):
        return []
    kept, paths = [], []
    for e in doc["errors"]:
        if not foreign_app_forbidden(owner, e):
            kept.append(e)
            continue
        paths.append(".".join(str(p) for p in e["path"]))
        node: Any = doc.get("data")
        for step in e["path"][:-1]:
            if isinstance(node, dict) and isinstance(step, str):
                node = node.get(step)
            elif isinstance(node, list) and type(step) is int and 0 <= step < len(node):
                node = node[step]
            else:
                node = None
                break
        if isinstance(node, dict) and node.get(APP_FIELD) is None:
            node.pop(APP_FIELD, None)
            node["appUnread"] = True
    if paths:
        if kept:
            doc["errors"] = kept
        else:
            doc.pop("errors", None)
    return paths


def entry_nodes(key: str) -> list[str]:
    """The nodes (graphql_body_nodes) a watch KEY's GraphQL read asks: its PR, run or head, and a head's
    CHECKS_OF_RECORD commit."""
    try:
        kind, owner, repo, value = split_key(key)
    except ValueError:
        return []
    base = f"{owner.lower()}/{repo.lower()}"
    if kind == "head":
        nodes = [f"{base}@{value}"]
        if (owner, repo) in CHECKS_OF_RECORD:
            other = "/".join(CHECKS_OF_RECORD[(owner, repo)]).lower()
            nodes.append(f"{other}@{value}")
        return nodes
    return [f"{base}/runs/{value}" if kind == "run" else f"{base}#{value}"]


# A branch's rule or protection read is one route family of its repository: the App lacks administration for every
# branch alike, and a lane branch has a path of its own (the broker host, 2026-11-22: a 403 for each of
# rules/branches/main, .../lane/a, .../lane/b, each an App request and a login retry).
APP_POOL_BRANCH_ROUTES = (
    (re.compile(r"^(/repos/[^/]+/[^/]+)/rules/branches/.+$"), "/rules/branches/*"),
    (re.compile(r"^(/repos/[^/]+/[^/]+)/branches/.+/protection(?:/.*)?$"), "/branches/*/protection"),
)


def app_pool_tool() -> Path | None:
    """gh_app_token.py beside the gh-quota shim's gh_quota.py (leo-workspace tools/), or None."""
    with contextlib.suppress(OSError, RuntimeError):
        cli = PACE_CLI.resolve().parent / "gh_app_token.py"
        if cli.is_file():
            return cli
    return None


# Creates on the App of their purpose (ci-217x-dictator's design, 2026-11-23; Leo: "use more of the apps then. go make
# more"). A new issue goes on the issues App, and a new PR in a repo gh-app-roles.json's bot_authored_write_repos opts
# in goes on the lander App while the login's create pause holds, so neither waits on one login's pause. Each kind has
# exactly one App, the one whose purpose it is (machines/github-apps.md "Why per purpose": never N copies of one App,
# never "the App with the most budget left"). manaflow-ai/cmux's CLA counts a PR's opener as a signer, so no create
# there leaves the login. A refused or throttled App create goes on the login; the App's throttle is the App's own
# cooldown (app_create_hold), never reported as the login's pause. GLAEDA_APP_CREATES=0 (in the daemon's environment,
# or the caller's when it queues) turns this off: an issue is made in one `gh` call again and a PR waits out the
# login's pause as before.
APP_CREATES_ENV = "GLAEDA_APP_CREATES"
APP_CREATE_OP = {"pr": "create", "issue": "issue"}  # the queued kind -> gh_app_token.py broker-actor's operation
APP_CREATE_ROLE = {"create": "lander", "issue": "issues"}  # by purpose, one App each
APP_CREATE_NEVER = frozenset({"manaflow-ai/cmux"})  # the CLA counts the PR opener as a signer
APP_ACTOR_TTL = 60.0  # seconds an App writer's answer (or its absence) is reused across outbox turns

# Comments on a POOL of poster Apps (Leo, 2026-11-24: "but i already have github apps made. quota-goblin... etc. well,
# maybe we can make one specifically for posting as 'me' or whatever."; 2026-11-23: "you cannot wait. this is not a
# solution. simply make more apps."). Almost every write left as the one shared login, so GitHub's secondary
# content-creation limit paced them for minutes (cosmic-gray, 24 h: 113 comments p50 423 s, p90 1727 s, max 2523 s from
# queue to delivery). Each outbox turn asks `gh_app_token.py broker-actor post REPO --skip ROLES` for the first poster
# App (gh-app-roles.json "posters") that is installed, has a token here and is not resting; ROLES are the posters this
# daemon holds for their own throttle (app_create_hold). A throttle holds THAT App alone, for its Retry-After, and the
# next turn picks the next one; the login makes the comment only when no poster is free. Stays on the login: reviews,
# status-key comments, anything with GH_TOKEN set, and the comments a reader interprets by author (a risk receipt, a
# `<!--` marker, a `/command`, an `owner:` claim) until GLAEDA_APP_POST_RECEIPTS=1 (set once every reader accepts the
# App bots). GLAEDA_APP_POSTS=0 turns the pool off. A post that left an App and lost its answer is looked up (post_find),
# never sent again on another identity before the look.
APP_POSTS_ENV = "GLAEDA_APP_POSTS"
APP_POST_RECEIPTS_ENV = "GLAEDA_APP_POST_RECEIPTS"
APP_POST_REFUSED_HOLD = 600.0  # a poster App's refusal that is no throttle (its credential, its install) rests it this long
APP_POST_NONE_TTL = 10.0  # seconds "no poster is free" is reused: a poster that rests ends it sooner than APP_ACTOR_TTL
APP_POST_ROLE = re.compile(r"[a-z0-9][a-z0-9-]{0,63}")
APP_AUTHOR_INTERPRETED = re.compile(r"<!--|^\s*(?:/|owner:)", re.M | re.I)


APP_NON_POSTER_ROLES = frozenset(APP_CREATE_ROLE.values()) | {"review"}  # Apps of another purpose, never the pool's


def app_posts_on(env: Any = None) -> bool:
    """Whether comments may go on the poster App pool here (APP_POSTS_ENV, on unless it is "0")."""
    return str((os.environ if env is None else env).get(APP_POSTS_ENV, "1")).strip() != "0"


def app_post_receipts_on(env: Any = None) -> bool:
    """Whether author-interpreted comments (receipts, markers, commands, claims) may go on the pool too."""
    return str((os.environ if env is None else env).get(APP_POST_RECEIPTS_ENV, "0")).strip() == "1"


def app_creates_on(env: Any = None) -> bool:
    """Whether creates may go on the App of their purpose here (APP_CREATES_ENV, on unless it is "0")."""
    return str((os.environ if env is None else env).get(APP_CREATES_ENV, "1")).strip() != "0"


def app_pool_pushed_path(role: str, owner: str) -> Path:
    """The key home's pushed token filename for ROLE and OWNER."""
    owner = owner.lower()
    name = f"{role}-token.json" if owner == "manaflow-ai" else f"{role}@{owner}-token.json"
    return APP_POOL_DIR / name


def app_pool_pushed_token(role: str, owner: str, now: float | None = None) -> str | None:
    """Read a valid pushed installation token without requiring the workspace helper or an API request."""
    now = time.time() if now is None else now
    path = app_pool_pushed_path(role, owner)
    try:
        if path.stat().st_mode & 0o077:  # pushed credentials are private to this user
            return None
    except OSError:
        return None
    doc = read_json(path)
    if not isinstance(doc, dict) or not isinstance(doc.get("app_id"), int):
        return None
    token = str(doc.get("token") or "")
    if not TOKEN_RE.fullmatch(token):
        return None
    recorded_owner = doc.get("owner")
    if recorded_owner is not None and str(recorded_owner).lower() != owner.lower():
        return None
    expires = iso_epoch(str(doc.get("expires_at") or ""))
    if expires is None or expires - now <= APP_POOL_PUSHED_MIN_LEFT:
        return None
    return token


def app_pool_pushed_owners(role: str, now: float | None = None) -> list[str]:
    """Owners represented by usable pushed token filenames (no network or helper needed)."""
    owners: set[str] = set()
    try:
        paths = list(APP_POOL_DIR.iterdir())
    except OSError:
        return []
    legacy = f"{role}-token.json"
    for path in paths:
        if path.name == legacy:
            owners.add("manaflow-ai")
        elif path.name.startswith(f"{role}@") and path.name.endswith("-token.json"):
            owners.add(path.name[len(role) + 1:-len("-token.json")].lower())
    return sorted(owner for owner in owners if app_pool_pushed_token(role, owner, now))


class AppPool:
    """The ci-watch role's installation tokens on this host, per owner, for the daemon's repo reads (see above)."""

    def __init__(self, role: str = APP_POOL_ROLE, mint: Callable[[str], str | None] | None = None,
                 owners: Callable[[], list[str]] | None = None, ready: Callable[[], bool] | None = None,
                 clock: Callable[[], float] = time.time) -> None:
        self.role, self.clock = role, clock
        self.mint_fn = mint or self.mint_with_tool
        self.owners_fn = owners or self.owners_from_config
        self.ready_fn = ready or self.held_here
        self.owners_at: tuple[frozenset[str], float] = (frozenset(), float("-inf"))  # (owners, read again after)
        self.ready_at: tuple[bool, float] = (False, float("-inf"))  # passed_over's (ready_fn(), read again after)
        self.tokens: dict[str, tuple[str, float]] = {}  # owner (lowercase) -> (token, use until)
        self.unreadable: dict[str, float] = {}  # installation/repository/resource scope -> on the login until then
        self.rest_until: dict[str, float] = {}  # owner (lowercase) -> not asked again before this
        self.rest_why: dict[str, str] = {}  # owner (lowercase) -> why it rests, for passed_over (never a token)
        self.why = ""  # the last reason the pool was passed over, for daemon.json (never a token)
        self.served = self.fell_back = 0
        self.seen: dict | None = None  # the App's last rate headers: {"limit", "remaining", "reset"}
        self.graphql_served = 0
        self.graphql_points = 0
        self.graphql_seen: dict | None = None
        self.source = ""  # "key" (the App's key is here) or "pushed" (a read-only token the key home pushed)
        self.spares: list[AppPool] = []  # pools tried after this one's (never nested: a spare has none)

    def with_spares(self, roles: "tuple[str, ...] | list[str]") -> "AppPool":
        self.spares = [AppPool(role=r, clock=self.clock) for r in roles if r != self.role]
        return self

    def pick(self, owner: str, scope: str, body: dict | None = None) -> "AppPool | None":
        """The first pool of the chain (this, then its spares) with a token for OWNER that has not refused SCOPE, nor
        any node a GraphQL BODY asks (bench_nodes)."""
        now = self.clock()
        any_node = body is not None and any(k.startswith("node:") and until > now
                                            for p in [self, *self.spares] for k, until in p.unreadable.items())
        nodes = list(graphql_body_nodes(body).values()) if any_node else []  # (no node benched: no parse per read)
        for pool in [self, *self.spares]:
            if pool.covers(scope) and not pool.nodes_benched(nodes) and pool.token(owner):
                return pool
        return None

    def nodes_benched(self, nodes: "list[str]") -> bool:
        """Whether this pool has benched any of NODES (bench_nodes)."""
        now = self.clock()
        return any(self.unreadable.get(f"node:{n}", 0.0) > now for n in nodes)

    def chain_benched(self, nodes: "list[str]") -> bool:
        """Whether any pool of the chain has benched any of NODES: batched() reads such an entry apart."""
        return any(pool.nodes_benched(nodes) for pool in [self, *self.spares])

    def bench_nodes(self, nodes: "list[str]", until: float) -> None:
        """Keep NODES on the login until UNTIL in every pool of the chain: another organization's IP allow list
        refuses this host's address (foreign_ip_refusal), whichever App asks. A node bench whose time has passed is
        dropped here, so the benches a day of refusals leaves never grow without bound."""
        now = self.clock()
        for pool in [self, *self.spares]:
            for key in [k for k, at in pool.unreadable.items() if k.startswith("node:") and at <= now]:
                del pool.unreadable[key]
            for node in nodes:
                pool.unreadable[f"node:{node}"] = until
            pool.save_bench()

    def held_here(self) -> bool:
        """Whether this host can get the role's token: its App metadata and key files, or a pushed read-only token
        (ROLE-token.json, from the key home) with more than APP_POOL_PUSHED_MIN_LEFT to go (file reads, no request)."""
        tool = app_pool_tool()
        if tool is not None and (APP_POOL_DIR / f"{self.role}.json").is_file() and (APP_POOL_DIR / f"{self.role}.pem").is_file():
            self.source = "key"
            return True
        if app_pool_pushed_owners(self.role, self.clock()):
            self.source = "pushed"
            return True
        return False

    def owners_from_config(self) -> list[str]:
        """machines/gh-app-roles.json `owners`, the accounts the role Apps are installed on, beside the tool."""
        cli = app_pool_tool()
        doc = read_json(cli.parent.parent / "machines" / "gh-app-roles.json") if cli else None
        owners = doc.get("owners") if isinstance(doc, dict) else None
        if isinstance(owners, list):
            configured = [o.lower() for o in owners if isinstance(o, str)]
            if configured:
                return configured
        return app_pool_pushed_owners(self.role, self.clock())

    def mint_with_tool(self, owner: str) -> str | None:
        cli = app_pool_tool()
        if cli is not None:
            try:
                result = run_bounded([sys.executable, "-I", os.fspath(cli), "token", self.role, "--owner", owner])
            except (OSError, subprocess.TimeoutExpired):
                result = None
            if result is not None:
                token = result.stdout.strip()
                if result.returncode == 0 and TOKEN_RE.fullmatch(token):
                    return token
        return app_pool_pushed_token(self.role, owner, self.clock())

    def owner_of(self, method: str, path: str, body: dict | None = None) -> str | None:
        """The sole repository owner a read may go to the pool for, else None.

        GraphQL is routed only when it names one owner: in its variables (the daemon's aliased PR/run queries), in
        head_query's literal repositories, or in the daemon's route field (graphql_named_repos). An opaque query or
        one spanning owners stays on the login, so an App token can never change viewer or cross-owner semantics.
        """
        return self.owner_why(method, path, body)[0]

    def owner_why(self, method: str, path: str, body: dict | None = None) -> tuple[str | None, str]:
        """(owner_of's owner, "") or (None, why the read is not offered to the pool): "not-a-repo-route",
        "write", "graphql-no-owner", "graphql-many-owners" or "owner-without-app" (no App installed on it)."""
        owners: set[str] = set()
        if method == "GET":
            m = APP_POOL_REPO.match(path)
            if m:
                owners.add(m.group(1).lower())
        elif (method == "POST" and path == "/graphql" and isinstance(body, dict)
              and not re.match(r"\s*mutation\b", str(body.get("query") or ""))):
            variables = body.get("variables")
            if isinstance(variables, dict):
                for key, value in variables.items():
                    if APP_POOL_GRAPHQL_OWNER.fullmatch(str(key)) and isinstance(value, str):
                        if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,38}", value):
                            owners.add(value.lower())
                    elif re.fullmatch(r"u\d+", str(key)) and isinstance(value, str):
                        match = APP_POOL_GRAPHQL_URL.match(value)
                        if match:
                            owners.add(match.group(1).lower())
            owners.update(o for o, _ in graphql_named_repos(body))
        elif method != "GET":
            return None, "write"
        if len(owners) != 1:
            if path != "/graphql":
                return None, "not-a-repo-route"
            return None, "graphql-many-owners" if owners else "graphql-no-owner"
        now = self.clock()
        if self.owners_at[1] <= now:  # the config is read once per APP_POOL_TTL, not per request
            # every role of the chain's owners, not the first role's alone: a host holding only pushed tokens, none
            # of them the first role's for this owner, would otherwise send all of the owner's reads to the login
            # ("owner-without-app") while a later role of the chain holds its token. pick() then finds that role.
            self.owners_at = (frozenset().union(*(pool.owners_fn() for pool in [self, *self.spares])),
                              now + APP_POOL_TTL)
        owner = next(iter(owners))
        return (owner, "") if owner in self.owners_at[0] else (None, "owner-without-app")

    def rest(self, owner: str, until: float, why: str) -> None:
        """Rest this role for OWNER until UNTIL, keeping WHY beside the deadline. Every reason a role stops answering
        is written here, so passed_over and status() can say which of them held a read instead of the bare label
        "pool-resting", which read the same for a rate limit, a floor and a failed mint (115 of this host's
        login-fallback rows named "pool-resting" with no way to tell them apart, 2026-11-22..25)."""
        self.rest_until[owner] = until
        self.rest_why[owner] = why
        self.why = why

    def resting_why(self, owner: str, now: float | None = None) -> str:
        """"pool-resting" for OWNER with the reason kept beside its deadline and the seconds left, when there is
        one: "pool-resting: the glaeda App is under its floor (12 left), 237s left"."""
        now = self.clock() if now is None else now
        why, left = self.rest_why.get(owner, ""), self.rest_until.get(owner, 0.0) - now
        if not why:
            return "pool-resting"
        return f"pool-resting: {why}" + (f", {round(left)}s left" if left > 0 else "")

    def passed_over(self, owner: str, scope: str, body: dict | None = None) -> tuple[str, dict[str, str]]:
        """Why no pool of the chain answers OWNER's SCOPE after pick() found none, without a mint or a request:
        (cause, {role: its own}). A role is "no-token" (this host holds none of it), "route-benched" (it refused
        SCOPE lately, covers), "node-benched" (it refused a node the GraphQL BODY asks, bench_nodes) or
        "pool-resting" (rate limited, under its floor, or a failed mint), and a resting role names which of those
        it is and how long is left (resting_why): the bare label read the same for all three, so 2,534 of this
        host's 4,151 real login-fallback rows over 69 h said only "pool-resting" while Leo's shared login drained.
        The cause is "no-token" when no role holds
        one, else "pool-resting" when any holder rests, else "node-benched" when any holder benched a node, else
        "route-benched". A node bench used to read as "pool-resting": the broker host, 2026-11-22 23:39Z-00:46Z, 55
        last-real-attempt reads "pool-resting" on the login while every App of the chain had its points."""
        now = self.clock()
        each: dict[str, str] = {}
        bare: dict[str, str] = {}  # the label alone, which decides the cause; each[] may carry the role's reason
        nodes = list(graphql_body_nodes(body).values()) if body is not None else []
        for pool in [self, *self.spares]:
            if not pool.covers(scope):
                bare[pool.role] = each[pool.role] = "route-benched"
            elif pool.tokens.get(owner, ("", 0.0))[1] <= now and not pool.ready_cached():
                bare[pool.role] = each[pool.role] = "no-token"
            elif nodes and pool.nodes_benched(nodes):
                bare[pool.role] = each[pool.role] = "node-benched"
            else:
                bare[pool.role] = "pool-resting"
                each[pool.role] = pool.resting_why(owner, now)
        held = [c for c in bare.values() if c != "no-token"]
        if not held:
            return "no-token", each
        return next(c for c in ("pool-resting", "node-benched", "route-benched") if c in held), each

    def ready_cached(self) -> bool:
        """ready_fn() (held_here: directory scans and token file reads) once per APP_POOL_TTL, for passed_over,
        which asks it of every role on each read that goes on the login; token() refreshes it whenever it asks."""
        now = self.clock()
        if self.ready_at[1] <= now:
            self.ready_at = (bool(self.ready_fn()), now + APP_POOL_TTL)
        return self.ready_at[0]

    def token(self, owner: str) -> str | None:
        """OWNER's installation token, or None: the read then goes on the login, as it always did."""
        now = self.clock()
        if self.rest_until.get(owner, 0.0) > now:
            return None
        held = self.tokens.get(owner)
        if held and held[1] > now:
            return held[0]
        self.tokens.pop(owner, None)
        ready = bool(self.ready_fn())
        self.ready_at = (ready, now + APP_POOL_TTL)  # what passed_over says next is this read's, not an older one
        if not ready:
            self.rest(owner, now + APP_POOL_REST, f"no {self.role} App on this host")
            return None
        token = self.mint_fn(owner)
        if not token:
            self.rest(owner, now + APP_POOL_REST,
                      f"gh_app_token.py token {self.role} --owner {owner} gave no token")
            return None
        self.tokens[owner] = (token, now + APP_POOL_TTL)
        return token

    @staticmethod
    def scope(owner: str, method: str, path: str, body: dict | None = None) -> str:
        """Key a refusal to the installation and resource that produced it, never the whole owner pool. A GraphQL
        scope names its repositories sorted ("graphql:OWNER:a,b"), so the same set is one key in any order, and
        covers()/answered() weigh each repository alone. A REST branch rule or protection read is keyed to its
        repository and route family, not each branch's own path (APP_POOL_BRANCH_ROUTE)."""
        if path == "/graphql":
            repos = set()
            for key, value in (body or {}).get("variables", {}).items():
                if re.fullmatch(r"r\d+", str(key)) and isinstance(value, str):
                    repos.add(str(value).lower())
                elif re.fullmatch(r"u\d+", str(key)) and isinstance(value, str):
                    match = APP_POOL_GRAPHQL_URL.match(value)
                    if match:
                        repos.add(match.group(2).lower())
            repos.update(r for _, r in graphql_named_repos(body))
            return "graphql:" + owner + (":" + ",".join(sorted(repos)) if repos else "")
        bare = path.split("?", 1)[0]
        for pattern, family in APP_POOL_BRANCH_ROUTES:
            match = pattern.match(bare)
            if match:
                return f"{method} {match.group(1)}{family}"
        return f"{method} {bare}"

    @staticmethod
    def graphql_repos(scope: str) -> tuple[str, list[str]]:
        """("OWNER", [repo, ...]) of a GraphQL scope; ("", []) for any other."""
        if not scope.startswith("graphql:"):
            return "", []
        owner, _, repos = scope[len("graphql:"):].partition(":")
        return owner, [r for r in repos.split(",") if r]

    def bench(self, scope: str, until: float) -> None:
        """Keep SCOPE on the login until UNTIL, and write the bench down.

        The bench used to live only in this process. The daemon re-execs whenever a fix lands (one host, 2026-11-22:
        54 re-execs in a day), and every refusal went with it, so a scope no retry can win was asked again after each
        one: graphql:manaflow-ai:cmux, which the `cursor` organization's IP allow list forbids this App's address
        ("FORBIDDEN ... your IP address is not permitted to access this resource"), cost 23 doomed App queries that
        day on this host, each one a round trip on ci-watch and then quota-goblin before the same read went on the
        login anyway. An hour's bench now means an hour.
        """
        self.unreadable[scope] = until
        self.save_bench()

    def bench_file(self) -> Path:
        return BASE / APP_POOL_BENCH_FILE

    def save_bench(self) -> None:
        """Write this pool's live benches under its role, keeping the other roles' as they are."""
        now = self.clock()
        doc = read_json(self.bench_file())
        roles = dict(doc["roles"]) if isinstance(doc, dict) and isinstance(doc.get("roles"), dict) else {}
        roles[self.role] = {scope: round(until, 3) for scope, until in self.unreadable.items() if until > now}
        with contextlib.suppress(OSError):
            write_json(self.bench_file(), {"schema": "glaeda-gh-app-bench/v1", "roles": roles})

    def restore_bench(self) -> "AppPool":
        """Read the benches of this pool and its spares back (save_bench), dropping any whose hour has passed."""
        now = self.clock()
        doc = read_json(self.bench_file())
        roles = doc.get("roles") if isinstance(doc, dict) else None
        for pool in [self, *self.spares]:
            kept = roles.get(pool.role) if isinstance(roles, dict) else None
            for scope, until in (kept if isinstance(kept, dict) else {}).items():
                if isinstance(scope, str) and isinstance(until, (int, float)) and not isinstance(until, bool) \
                        and until > now:
                    pool.unreadable[scope] = float(until)
        return self

    def covers(self, scope: str) -> bool:
        """Whether SCOPE is one the App has not refused lately (a permission or resource it lacks). A GraphQL chunk is
        covered unless one of its own repositories is benched (a set is never benched as a set)."""
        now = self.clock()
        if self.unreadable.get(scope, 0.0) > now:
            return False
        owner, repos = self.graphql_repos(scope)
        return not any(self.unreadable.get(f"graphql:{owner}:{r}", 0.0) > now for r in repos)

    def named_repos(self, scope: str, message: str) -> list[str]:
        """The repositories of GraphQL SCOPE that MESSAGE (an answer's error text) names, as a whole word."""
        _, repos = self.graphql_repos(scope)
        return [r for r in repos if re.search(rf"(?<![\w.-]){re.escape(r)}(?![\w.-])", message, re.I)]

    def answered(self, owner: str, scope: str, status: int, headers: dict, message: str = "",
                 nodes: "list[str] | None" = None) -> bool:
        """Note the App's answer; False when the read must go again on the login. A rate limit or a dead token rests
        the pool; a 403 or 404 of one route (a permission or repository the App lacks: branch protection needs
        administration, which ci-watch does not hold) keeps that route on the login for APP_POOL_ROUTE_REST. NODES
        (foreign_ip_refusal) are the only nodes a 200 answer's refusal names: they are benched, never SCOPE."""
        now = self.clock()
        try:
            remaining, reset = int(headers.get("x-ratelimit-remaining", "")), float(headers.get("x-ratelimit-reset", ""))
            self.seen = {"limit": int(headers.get("x-ratelimit-limit") or 0), "remaining": remaining, "reset": reset}
        except ValueError:
            remaining, reset = None, None
        limited = status == 429 or (status == 403 and (remaining == 0 or bool(headers.get("retry-after"))
                                                       or bool(SECONDARY.search(message)))
                     or (status == 200 and bool(re.search(r"RATE_LIMITED|rate limit", message, re.I))))
        if status == 401 or limited:
            self.tokens.pop(owner, None)
            spent = remaining == 0 and reset is not None and reset > now
            self.rest(owner, min(reset, now + PACE_HOLD_MAX) if spent else now + APP_POOL_REST,
                      f"the {self.role} App answered HTTP {status}"
                      + (f" and is spent until its reset ({message[:120]})" if spent and message else ""))
            self.fell_back += 1
            return False
        if status == 200 and nodes:
            self.bench_nodes(nodes, now + APP_POOL_ROUTE_REST)
            self.fell_back += 1
            return False
        if status in {403, 404} or (status == 200 and app_graphql_refused(message)):
            owner_, repos = self.graphql_repos(scope)
            if len(repos) > 1:
                # A refused multi-repository chunk benches only the repositories its errors name; one that names none
                # benches nothing (the caller reads per repository, batched() chunks by repository, so the next
                # asks the App again). The broker host, 2026-11-22: sets "cmux,cmuxterm-hq" and "cmuxterm-hq,cmux"
                # were each benched an hour as sets while the App held 12,234 of 12,500 points.
                for repo in self.named_repos(scope, message):
                    self.bench(f"graphql:{owner_}:{repo}", now + APP_POOL_ROUTE_REST)
            else:
                self.bench(scope, now + APP_POOL_ROUTE_REST)
            self.fell_back += 1
            return False
        if remaining is not None and remaining < APP_POOL_FLOOR and reset is not None:
            # this answer still counts
            self.rest(owner, max(self.rest_until.get(owner, 0.0), reset),
                      f"the {self.role} App is under its floor ({remaining} left)")
        self.served += 1
        return True

    def status(self) -> dict:
        now = self.clock()
        resting = {o: round(t) for o, t in self.rest_until.items() if t > now}
        return {"role": self.role, "source": self.source or None, "served": self.served, "fellBack": self.fell_back, "seen": self.seen,
                "resting": resting or None, "why": self.why or None,
                "restingWhy": {o: w for o, w in self.rest_why.items() if self.rest_until.get(o, 0.0) > now} or None,
                # Published so a reader can tell an idle App from a benched one: with this unprinted, an App pool
                # 97% unspent beside a login at 0 GraphQL points read as a routing bug for hours, 2026-11-22.
                "unreadable": {scope: round(until) for scope, until in self.unreadable.items() if until > now} or None,
                "graphqlServed": self.graphql_served, "graphqlPoints": self.graphql_points,
                "graphqlSeen": self.graphql_seen,
                **({"spares": [p.status() for p in self.spares]} if self.spares else {})}

    def graphql_answered(self, rate: dict, points: int) -> None:
        """Keep an App GraphQL answer in the App pool; it must never become the login's budget or pacing data."""
        self.graphql_served += 1
        self.graphql_points += points
        if isinstance(rate, dict):
            try:
                self.graphql_seen = {"limit": int(rate["limit"]), "remaining": int(rate["remaining"]),
                                     "reset": iso_epoch(rate.get("resetAt"))}
            except (KeyError, TypeError, ValueError):
                pass


# ---------------------------------------------------------------- a lane VM's own read token
# A lane VM reads through an upstream (huge-blue's daemon, `lane-gh glaeda-read`) because it holds no login. The
# lane-gh broker now mints a read-only, single-repository, short-lived App token for a lane VM (cmuxterm-hq#17426's
# read_token tool; leo-workspace#7651 is lane-gh's own direct GET). With it this daemon reads a PR or a run from GitHub
# itself, in process: gcp-agent-lane-1 measured direct reads at p50 0.46 s against 2.44 s through the broker, and
# a tick that spent 643 s of a 600 s window waiting on the upstream. Leo: "why the f*** are you centralizing on
# f***ing huge blue anyway". Everything the token cannot read (heads, comments, a refused route, a repo the broker
# mints nothing for) still goes upstream, and every write still goes through the broker. lane-gh has no command that
# hands the token out: its `get` mints it (when lane-gh sends this VM's reads direct: its direct-reads.json or
# LANE_GH_DIRECT_READS, the switch glaeda follows as is) and keeps it, so glaeda primes it with one small `get` of the
# repo and reads the kept file. upstream.json "readToken": [...] names another program instead (`ARGV OWNER/REPO {}`
# answering {token, expires_at}); false turns it off.
# Kept where lane-gh's own direct reads keep it (leo-workspace#7651: TOKEN_DIR/OWNER__REPO.json, 0600, {token,
# expires_at, refresh_before_s}), never in BASE (the cache holds no token): one broker mint per repo, shared by this
# host's processes (the daemon, a wait's or a land's direct read, and lane-gh's own GETs). A file others can read is
# never used.
READ_TOKEN_DIR = Path(os.environ.get("LANE_GH_DIRECT_TOKEN_DIR") or Path.home() / ".cache/lane-gh/read-tokens")
READ_TOKEN_MIN_LEFT = 600.0  # a token closer than this to expires_at is minted again (the broker's own margin)
READ_TOKEN_REST = 900.0  # a repo the broker minted nothing for is not asked again for this long
READ_TOKEN_DEADLINE = 30.0  # one mint through the broker
READ_DIRECT_BUDGET = 60.0  # a tick's direct reads together; what is left goes upstream
READ_DIRECT_KINDS = ("pr", "run")
READ_TOKEN_PRIME = '{"path": "pulls", "query": {"per_page": 1}}'  # the smallest read lane-gh sends direct
READ_TOKEN_REPO = re.compile(r"^/repos/([A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]+)(?:/|\?|$)")


def read_token_command() -> list[str] | None:
    """The program that mints this host's read token, or None: upstream.json "readToken" (a list, or false for
    none), else `lane-gh call get` (the prime) of the lane-gh whose `glaeda-read` is the upstream."""
    doc = read_json(UPSTREAM_CONFIG)
    if not isinstance(doc, dict):
        return None
    given = doc.get("readToken")
    if given is False:
        return None
    if isinstance(given, list) and given and all(isinstance(a, str) and a for a in given):
        return given
    command = upstream_command()
    if command is not None and len(command) == 2 and Path(command[0]).name == "lane-gh" and command[1] == "glaeda-read":
        return [command[0], "call", "get"]
    return None


def read_token_kept(repo: str) -> tuple[str, float] | None:
    """REPO's token as lane-gh (or this file) kept it, and the time to mint again (expires_at less its
    refresh_before_s), or None. A file others can read is never used."""
    path = READ_TOKEN_DIR / (repo.lower().replace("/", "__") + ".json")
    try:
        if path.stat().st_mode & 0o077:
            return None
    except OSError:
        return None
    doc = read_json(path)
    if not isinstance(doc, dict) or not TOKEN_RE.fullmatch(str(doc.get("token") or "")):
        return None
    expires = iso_epoch(str(doc.get("expires_at") or ""))
    margin = doc.get("refresh_before_s")
    margin = float(margin) if isinstance(margin, (int, float)) and margin >= 0 else READ_TOKEN_MIN_LEFT
    return (str(doc["token"]), expires - margin) if expires is not None else None


def read_token_mint(command: list[str], repo: str) -> tuple[str, float] | None:
    """(token, the time to mint again) from one run of COMMAND for REPO, or None. `lane-gh call get` is the prime: its
    answer (the repo's newest PR) is dropped and the token is the one lane-gh kept. The token is never logged."""
    prime = len(command) >= 3 and Path(command[0]).name == "lane-gh" and command[1:3] == ["call", "get"]
    try:
        result = run_bounded([program_path(command[0]), *command[1:], repo, READ_TOKEN_PRIME if prime else "{}"],
                             READ_TOKEN_DEADLINE)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if prime:
        return read_token_kept(repo) if result.returncode == 0 else None
    try:
        doc = json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else None
    except ValueError:
        return None
    if isinstance(doc, dict) and isinstance(doc.get("data"), dict) and "token" not in doc:
        doc = doc["data"]
    if not isinstance(doc, dict):
        return None
    token, expires = str(doc.get("token") or ""), iso_epoch(str(doc.get("expires_at") or ""))
    if not TOKEN_RE.fullmatch(token) or expires is None:
        return None
    return token, expires - READ_TOKEN_MIN_LEFT


class ReadTokenPool(AppPool):
    """The broker's read tokens as an AppPool keyed by repository ("owner/repo", lowercase), for GETs of that
    repository only: Daemon.request sends a read with it and, on a refusal, asks the login, which a lane VM has
    none of (read_direct then leaves the key to the upstream). Kept in READ_TOKEN_DIR so a wait's direct read
    (its own process) reuses the daemon's token instead of asking the broker again."""

    def __init__(self, command: list[str], clock: Callable[[], float] = time.time,
                 mint: Callable[[str], tuple[str, float] | None] | None = None) -> None:
        super().__init__(role="lane-read-token", owners=lambda: [], ready=lambda: True, clock=clock)
        self.command = command
        self.mint_pair = mint or (lambda repo: read_token_mint(self.command, repo))
        self.source = "broker"

    def owner_of(self, method: str, path: str, body: dict | None = None) -> str | None:
        m = READ_TOKEN_REPO.match(path) if method == "GET" else None
        return m.group(1).lower() if m else None

    @staticmethod
    def kept_path(repo: str) -> Path:
        return READ_TOKEN_DIR / (repo.lower().replace("/", "__") + ".json")

    def keep(self, repo: str, pair: tuple[str, float] | None) -> None:
        path = self.kept_path(repo)
        with contextlib.suppress(OSError):
            if pair is None:
                path.unlink(missing_ok=True)
            else:
                write_json(path, {"token": pair[0], "refresh_before_s": int(READ_TOKEN_MIN_LEFT), "expires_at":
                                  time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(pair[1] + READ_TOKEN_MIN_LEFT))})

    def token(self, owner: str) -> str | None:
        now = self.clock()
        if self.rest_until.get(owner, 0.0) > now:
            return None
        held = self.tokens.get(owner)
        if held and held[1] > now:
            return held[0]
        kept = read_token_kept(owner)
        if kept is not None and kept[1] > now:
            self.tokens[owner] = kept
            return kept[0]
        pair = self.mint_pair(owner)
        if pair is None or pair[1] <= now:
            self.rest(owner, now + READ_TOKEN_REST, f"the broker minted no read token for {owner}")
            return None
        self.tokens[owner] = pair
        if (read_token_kept(owner) or ("",))[0] != pair[0]:  # lane-gh's prime kept it already
            self.keep(owner, pair)
        return pair[0]

    def answered(self, owner: str, scope: str, status: int, headers: dict, message: str = "",
                 nodes: "list[str] | None" = None) -> bool:
        ok = super().answered(owner, scope, status, headers, message, nodes)
        if status == 401:  # dead: the next read mints again, after the rest
            self.keep(owner, None)
        return ok


def read_token_reader(key: str) -> "Daemon | None":
    """A wait's or a land's direct read of KEY's repository with this host's read token (read_token_daemon), or None
    when there is none: the read then goes through the broker's GET as before. A token the broker minted for the
    daemon is reused (READ_TOKEN_DIR), so this asks the broker nothing then."""
    command = read_token_command()
    if command is None:
        return None
    _, owner, repo, _ = split_key(key)
    pool = ReadTokenPool(command)
    return read_token_daemon(pool) if pool.token(f"{owner}/{repo}".lower()) else None


def no_login() -> str:
    raise WatchError("this host has no GitHub login: it reads with the broker's read token or through its upstream")


def read_token_daemon(pool: "ReadTokenPool") -> "Daemon":
    """A Daemon that reads GitHub with POOL's tokens over plain HTTPS and has no login: a read the token cannot
    make fails (no_login). Charged to no REST share (a token's reads are the App's, not the login's)."""
    daemon = Daemon(transport=http, token=no_login, controller=None, upstream=None, app_pool=pool)
    daemon.reads_protection = False  # a branch's classic protection needs administration, which the token lacks
    daemon.charge_rest = lambda minute, n: None  # type: ignore[method-assign]
    daemon.post_due = lambda: None  # type: ignore[method-assign]  # writes go through the broker, never from here
    return daemon


# ---------------------------------------------------------------- upstream (a host with no login)


def upstream_command() -> list[str] | None:
    """The upstream program from UPSTREAM_CONFIG, or None (read GitHub with this host's own login)."""
    doc = read_json(UPSTREAM_CONFIG)
    command = doc.get("command") if isinstance(doc, dict) else None
    if isinstance(command, list) and command and all(isinstance(a, str) and a for a in command):
        return command
    return None


def program_path(name: str) -> str:
    """An upstream.json program as run: a path as given, else found on PATH or in ~/.local/bin."""
    return name if "/" in name else shutil.which(name) or os.fspath(Path.home() / ".local/bin" / name)


def direct_command() -> list[str] | None:
    """An upstream host's way to read one target fresh (direct_read), or None: UPSTREAM_CONFIG's "direct", a program
    that answers `ARGV OWNER/REPO -` with one GET of a repository path, given {"path", "query"} on stdin, as one
    `lane-gh call get` answer ({"ok", "status", "data"}). Without "direct", the `call get` of the lane-gh whose
    `glaeda-read` is the upstream: the lane-gh broker's GET reads GitHub with a token minted for the call, so the VM
    still holds none. Not for any other upstream: its program reads no single target."""
    doc = read_json(UPSTREAM_CONFIG)
    if not isinstance(doc, dict):
        return None
    direct = doc.get("direct")
    if isinstance(direct, list) and direct and all(isinstance(a, str) and a for a in direct):
        return direct
    command = upstream_command()
    if command is not None and len(command) == 2 and Path(command[0]).name == "lane-gh" and command[1] == "glaeda-read":
        return [command[0], "call", "get"]
    return None


def prior_required(entry: dict) -> set:
    """The checks a cached PR entry's data calls required: flagged on a check, or named as missing or unread."""
    before = entry.get("data") or {}
    required = {c.get("name") for c in before.get("checks") or [] if c.get("required")}
    return required | set(before.get("requiredMissing") or []) | set(before.get("requiredUnread") or [])


# The lane-gh broker's lane for this daemon's direct reads (cmuxterm-hq lane-gh-broker parts/24-lane-share.py
# UPSTREAM_LANES): they draw on the VM's own upstream_reserve slice, which its sessions cannot spend. 2026-11-17
# 08:15-08:40Z (hq#12687): gcp-agent-lane-3's sessions spent its lane share and every refresh here was refused, so its
# watched PRs went 13-23 minutes stale. lane-gh names a call's lane from LANE_GH_LANE first.
UPSTREAM_LANE = "glaeda-upstream"


def direct_env() -> dict:
    """The environment of a direct read's lane-gh: this daemon's, with its lane (UPSTREAM_LANE)."""
    return {**os.environ, "LANE_GH_LANE": UPSTREAM_LANE}


# One GET of a direct read through the broker (broker_transport) has at most this long, then is asked once more in what
# is left of the read (if DIRECT_GET_RETRY_MIN is), never the whole read's budget. A lane VM, 2026-11-22: 503 land
# refreshes answered "no answer within 60s" against 120 answered; one GET of a read (pulls/N, then the head's
# check-suites and check-runs, the base's rules, each a lane-gh run) waited on the broker socket ("the broker dropped
# a read's answer", "nothing listening on the broker socket ... waiting up to 180 s") and spent all 60 s itself.
DIRECT_GET_SHARE = 25.0
DIRECT_GET_RETRY_MIN = 5.0


# The broker's refusal of a read for the read Apps' reserve ("read Apps busy ... at its reserve", lane-gh's floor and
# lane share, "busy: N GitHub reads already in flight") holds every direct read on this host, a waiter's, a land
# worker's or `status`'s (one file, so every process sees it), for the wait it names (or DIRECT_BUSY_HOLD), doubling per
# refusal in a row up to DIRECT_BUSY_HOLD_MAX; any answer ends it. Before, each of a VM's waits and land entries asked
# again every few seconds through a refused window (:20-:52 of every hour; a lane VM's ledger 2026-11-23 23:50Z-00:30Z:
# 540 refused asks against 22 sent), each ask a lane-gh process and each full read's first GETs (the pull, the issue)
# paid before a later one was refused, then read again whole when the window opened: every VM at the same minute, the
# reserve drained by the backlog (rest_breakdown of manaflow-ai/cmux, 2026-11-23 23:00Z-01:00Z: glaeda-upstream 4,963
# App requests an hour, the fleet's largest caller).
DIRECT_BUSY_FILE = "direct-busy.json"  # under BASE: {"until": t, "n": refusals in a row}
DIRECT_BUSY_HOLD = 60.0
DIRECT_BUSY_HOLD_MAX = 300.0
DIRECT_BUSY_RE = re.compile(r"read Apps busy|at its reserve|reads already in flight|lane share|read floor|\bfloor\b",
                            re.IGNORECASE)
DIRECT_BUSY_WAIT_RE = re.compile(r"retry after (\d+)\s*s", re.IGNORECASE)


def direct_busy_until(now: float) -> float | None:
    """When the hold on this host's direct reads ends (DIRECT_BUSY_FILE), or None: none, or past."""
    doc = read_json(BASE / DIRECT_BUSY_FILE)
    until = doc.get("until") if isinstance(doc, dict) else None
    return float(until) if isinstance(until, (int, float)) and not isinstance(until, bool) and until > now else None


def direct_busy_note(text: str | None, now: float) -> None:
    """Record one direct GET's outcome: a refusal (TEXT names the reserve) starts or doubles the hold, an answer
    (TEXT None) ends it. Best effort: a lost write costs a read."""
    try:
        doc = read_json(BASE / DIRECT_BUSY_FILE)
        doc = doc if isinstance(doc, dict) else {}
        if text is None:
            if doc:
                write_json(BASE / DIRECT_BUSY_FILE, {})
            return
        if not DIRECT_BUSY_RE.search(text):
            return
        if float(doc.get("until") or 0) > now:
            return  # one outage, counted once: reads started before the hold was set
        n = int(doc.get("n") or 0) + 1 if now - float(doc.get("until") or 0) < DIRECT_BUSY_HOLD_MAX else 1
        said = DIRECT_BUSY_WAIT_RE.search(text)
        hold = min(DIRECT_BUSY_HOLD_MAX, max(float(said.group(1)) if said else 0.0, DIRECT_BUSY_HOLD * 2 ** (n - 1)))
        write_json(BASE / DIRECT_BUSY_FILE, {"until": now + hold, "n": n, "why": text[:160]})
    except (OSError, ValueError, TypeError):
        pass


def broker_transport(command: list[str], deadline: Callable[[], float]) -> Callable:
    """A Daemon transport for an upstream host's direct read: each GET of /repos/OWNER/REPO/PATH goes to COMMAND
    (direct_command) as `OWNER/REPO -` with {"path", "query"} on stdin, within what is left of DEADLINE (a
    time.monotonic() bound), at most UPSTREAM_DEADLINE, and at most DIRECT_GET_SHARE a try (two tries). Answers
    GitHub's status and JSON as http() does; a refusal with no GitHub status is a 502 whose message is the refusal.
    GraphQL and writes are never sent."""
    exe = program_path(command[0])

    def send(method: str, url: str, headers: dict, body: bytes | None) -> tuple[int, dict, bytes]:
        parts = urllib.parse.urlsplit(url)
        m = re.match(r"^/repos/([^/]+/[^/]+)/(.+)$", parts.path)
        if method != "GET" or m is None:
            return 405, {}, json.dumps({"message": f"an upstream host's direct read sends only a repository GET, "
                                                   f"not {method} {parts.path}"}).encode()
        args = {"path": urllib.parse.unquote(m.group(2)),
                "query": dict(urllib.parse.parse_qsl(parts.query, keep_blank_values=True))}
        held = direct_busy_until(time.time())
        if held is not None:
            # a refusal for the reserve holds every direct read here (DIRECT_BUSY_FILE): nothing is run or sent
            raise WatchError(f"direct: busy: the read Apps are at their reserve; held {int(held - time.time())}s more")
        for attempt in range(2):
            left = min(UPSTREAM_DEADLINE, deadline() - time.monotonic())
            if left <= 0:
                raise OutOfTime(f"no time left for GET {args['path']}")
            share = min(left, DIRECT_GET_SHARE)
            try:
                result = run_bounded([exe, *command[1:], m.group(1), "-"], share, input_text=json.dumps(args),
                                     env=direct_env())
                break
            except subprocess.TimeoutExpired:
                # One GET's share is spent (a broker socket wait, a dropped answer): it is asked once more in what
                # is left, never left to eat the whole read (DIRECT_GET_SHARE)
                if attempt or deadline() - time.monotonic() < DIRECT_GET_RETRY_MIN:
                    raise OutOfTime(f"GET {args['path']}: no answer in its {share:.0f}s share"
                                    + (", twice" if attempt else "")) from None
            except OSError as error:
                raise WatchError(f"direct: {type(error).__name__} running {command[0]}") from None
        try:
            answer = json.loads(result.stdout) if result.stdout.strip() else None
        except ValueError:
            answer = None
        if not isinstance(answer, dict):
            tail = (result.stderr or "").strip().splitlines()[-1:] or [f"exit {result.returncode}"]
            raise WatchError(f"direct: {command[0]}: {tail[0]}"[:UPSTREAM_ERROR_MAX])
        status = answer.get("status")
        if not isinstance(status, int) or isinstance(status, bool):
            why = answer.get("error") if isinstance(answer.get("error"), str) else "no GitHub status"
            direct_busy_note(why, time.time())
            return 502, {}, json.dumps({"message": gh_said(f"direct: {why}", limit=UPSTREAM_ERROR_MAX)}).encode()
        data = answer.get("data")
        if status == 403 and isinstance(data, dict) and gh_said(data, limit=None):
            direct_busy_note(gh_said(data, limit=None), time.time())
        elif status < 400:
            direct_busy_note(None, time.time())
        # The broker's wait rides in its answer, not in headers: kept in the body for request()'s primary_said_wait
        wait = answer.get("retry_after")
        if status in {403, 429} and isinstance(data, dict) and "retry_after" not in data \
                and isinstance(wait, (int, float)) and not isinstance(wait, bool):
            data = {**data, "retry_after": wait}
        return status, {}, json.dumps(data).encode()
    return send


def run_upstream(command: list[str], request: dict, timeout: float = UPSTREAM_DEADLINE) -> dict:
    """One run of the upstream command, within TIMEOUT (what is left of the tick's UPSTREAM_TICK_BUDGET), at most
    UPSTREAM_DEADLINE."""
    exe = program_path(command[0])
    timeout = max(1.0, min(UPSTREAM_DEADLINE, timeout))
    try:
        result = run_bounded([exe, *command[1:]], timeout, input_text=json.dumps(request) + "\n")
    except subprocess.TimeoutExpired:
        raise WatchError(f"upstream: no answer within {timeout:.0f}s") from None
    except OSError as error:
        raise WatchError(f"upstream: {type(error).__name__} running {command[0]}") from None
    try:
        answer = json.loads(result.stdout.strip().splitlines()[-1]) if result.stdout.strip() else None
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        tail = (result.stderr or "").strip().splitlines()[-1:] or [f"exit {result.returncode}"]
        raise WatchError(f"upstream: {command[0]}: {tail[0]}"[:UPSTREAM_ERROR_MAX])
    return answer


def upstream_read_at(cached: dict | None) -> float | None:
    """When a key's cache entry was last really read (its fetchedAt), looking through an outage stored on it since
    (readAt); None for a key never read. Kept on the outage so its end restores it (Daemon.upstream_outage_over)."""
    if not isinstance(cached, dict):
        return None
    at = cached.get("readAt") if cached.get("errorFrom") == UPSTREAM_OUTAGE else cached.get("fetchedAt")
    return float(at) if isinstance(at, (int, float)) and not isinstance(at, bool) else None


def read_request(text: str) -> list[tuple[str, bool, bool, str | None]]:
    """The (key, jobs, wait, consumer) of each key in one upstream request line; WatchError on anything else. `wait`
    (optional) says a wait downstream is blocked on the key, so this host's daemon treats it as waited
    (STALE_RUN_REREAD). A head key must name the `consumer` its read is charged to (as `checks --consumer`): this
    host's daemon reads it within that consumer's head budget, never on an unnamed one. `reader` (optional,
    HOST/READER) names the downstream waiter; read_readers gives it."""
    try:
        doc = json.loads(text)
    except ValueError:
        raise WatchError("read takes one JSON line on stdin: {\"keys\": [{\"key\": ..., \"jobs\": ...}]}") from None
    keys = doc.get("keys") if isinstance(doc, dict) else None
    if not isinstance(keys, list) or len(keys) > UPSTREAM_MAX_KEYS:
        raise WatchError(f"read takes a list of at most {UPSTREAM_MAX_KEYS} keys")
    out = []
    for item in keys:
        key = item.get("key") if isinstance(item, dict) else None
        jobs = item.get("jobs", False) if isinstance(item, dict) else None
        wait = item.get("wait", False) if isinstance(item, dict) else None
        consumer = item.get("consumer") if isinstance(item, dict) else None
        kind = key.split(":", 1)[0] if isinstance(key, str) else None
        if kind not in UPSTREAM_KINDS or not isinstance(jobs, bool) or not isinstance(wait, bool):
            raise WatchError(f"read serves {', '.join(UPSTREAM_KINDS)} keys, not {str(key)[:80]!r}")
        target = key.split(":", 1)[1]
        form = rf"{NAME}/{NAME}@[0-9a-f]{{40}}" if kind == "head" else rf"{NAME}/{NAME}[#/]\d+"
        if not re.fullmatch(form, target) or parse_key(kind, target) != key:
            raise WatchError(f"not a key: {key[:80]!r}")
        if kind != "head":
            consumer = None
        elif not isinstance(consumer, str) or not CONSUMER_RE.fullmatch(consumer):
            raise WatchError(f"a head key needs a consumer (a short name: letters, digits, . _ -): {key[:80]!r}")
        out.append((key, jobs, wait, consumer))
    return out


def read_readers(text: str) -> dict[str, str]:
    """{key: reader} of an upstream request line that read_request accepted: each item's `reader`, when it names one."""
    out = {}
    for item in json.loads(text).get("keys") or []:
        reader = safe_reader(item.get("reader") if isinstance(item, dict) else None)
        if reader and isinstance(item.get("key"), str):
            out[item["key"]] = reader
    return out


def read_times(text: str) -> dict[tuple[str, str | None], dict[str, float]]:
    """{(key, consumer): {"touched", "waitedAt", "asked"}} of an upstream request line that read_request accepted:
    the downstream's own interest times for each line, the numbers it gave (register's AT)."""
    out = {}
    for item in json.loads(text).get("keys") or []:
        if not isinstance(item, dict) or not isinstance(item.get("key"), str):
            continue
        times = {k: float(item[k]) for k in ("touched", "waitedAt", "asked")
                 if isinstance(item.get(k), (int, float)) and not isinstance(item.get(k), bool) and math.isfinite(item[k])}
        consumer = item.get("consumer") if isinstance(item.get("consumer"), str) else None
        out[(item["key"], consumer)] = times
    return out


def _finite(v: Any) -> bool:
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)


# UPSTREAM_FEED_FILE as last loaded, by its stat: `read` runs inside the lane-gh broker for every lane VM's upstream
# tick (several a second), so the file is parsed once per write, not once per call.
_FEED_VIEW_LOADED: dict[str, Any] = {"stamp": None, "doc": None}


def load_feed_view() -> dict | None:
    """This host's daemon's feed view (Daemon.save_feed_view), or None."""
    path = BASE / UPSTREAM_FEED_FILE
    try:
        st = path.stat()
    except OSError:
        return None
    stamp = (os.fspath(path), st.st_ino, st.st_mtime_ns, st.st_size)
    if _FEED_VIEW_LOADED["stamp"] != stamp:
        doc = read_json(path)
        _FEED_VIEW_LOADED.update(stamp=stamp, doc=doc if isinstance(doc, dict) else None)
    return _FEED_VIEW_LOADED["doc"]


def feed_view(key: str, data: dict | None, doc: dict | None, now: float) -> dict | None:
    """What this host's feed says about PR KEY, for a downstream's land_feed_quiet (upstream_feed_quiet): since when
    the feed has answered without a gap (liveSince), when it last answered (at), and the newest event it delivered for
    the PR, the head this host's copy names, or its branch (eventAt, None for none). None, so the downstream holds
    nothing quiet, unless the feed answers now (CONTROLLER_FRESH) and covers the repository (FED_REPO_KEEP), as
    Daemon.fed asks."""
    if not key.startswith("pr:") or not isinstance(doc, dict):
        return None
    live, ok = doc.get("liveSince"), doc.get("okAt")
    if not _finite(live) or not _finite(ok) or not 0 <= now - ok <= CONTROLLER_FRESH:
        return None
    try:
        _, owner, repo, number = split_key(key)
    except ValueError:
        return None
    repo = f"{owner}/{repo}".lower()
    fed_at = (doc.get("fedRepos") or {}).get(repo) if isinstance(doc.get("fedRepos"), dict) else None
    if not _finite(fed_at) or ok - fed_at > FED_REPO_KEEP:
        return None
    marks = doc.get("marks") if isinstance(doc.get("marks"), dict) else {}
    data = data if isinstance(data, dict) else {}
    head = str(data.get("headRefOid") or "").lower()
    names = [f"pr:{repo}#{number}"] + ([f"sha:{repo}@{head}"] if head else []) \
        + ([f"branch:{repo}@{data['headRefName']}"] if data.get("headRefName") else [])
    events = [marks[m] for m in names if _finite(marks.get(m))]
    return {"liveSince": live, "at": ok, "eventAt": max(events) if events else None, "head": head or None}


def upstream_feed_quiet(view: dict, sha: str, since: float, now: float) -> bool:
    """land_feed_quiet on a host that follows no feed, from the upstream's VIEW of the PR (feed_view, given at
    answeredAt): the view is fresh (UPSTREAM_FEED_FRESH), the feed answered without a gap since before SINCE and has
    answered after it, and its newest event for the PR, its head or its branch is older than SINCE, with
    UPSTREAM_FEED_SKEW for the two hosts' clocks. A SHA other than the head the upstream's view was taken for is not
    covered by it: False."""
    live, at, event, answered = view.get("liveSince"), view.get("at"), view.get("eventAt"), view.get("answeredAt")
    if not (_finite(live) and _finite(at) and _finite(answered) and _finite(since)):
        return False
    if not 0 <= now - answered <= UPSTREAM_FEED_FRESH:
        return False
    if sha and str(sha).lower() != str(view.get("head") or "").lower():
        return False
    if live > since - UPSTREAM_FEED_SKEW or at < since:
        return False
    return event is None or (_finite(event) and event < since - UPSTREAM_FEED_SKEW)


def cmd_read(text: str) -> int:
    """`read`: register each key (sessions' interest, as `status` does) and print what the cache holds
    now, never waiting and never reading GitHub. The other end of an upstream (UPSTREAM_CONFIG). A PR's entry also
    carries this host's feed view of it (feed_view), which a downstream host rules land_feed_quiet with."""
    items = read_request(text)
    readers = read_readers(text)
    times = read_times(text)
    if not daemon_running(grace=UPSTREAM_DOWN_GRACE):
        print(json.dumps({"error": "glaeda-gh is not running on the upstream host"}))
        return EXIT_DOWN
    broken = daemon_failing()
    if broken is not None:
        print(json.dumps({"error": failing_message(broken)[:UPSTREAM_ERROR_MAX]}))
        return EXIT_DOWN
    entries: dict[str, Any] = {}
    ledger = None
    for key, jobs, wait, consumer in items:
        # A head is registered under its consumer, as `checks` does: the daemon reads it charged to that consumer's
        # head budget (due_heads, head_allowed), or leaves it to the cache and marks the consumer denied.
        register(key, jobs, consumer=consumer, waited=wait, reader=readers.get(key), at=times.get((key, consumer)))
        cached = read_cache(key)
        budgets = (entries.get(key) or {}).get("budgets") or {}  # an earlier line's consumers, for this same key
        entries[key] = None if cached is None else {
            # errorFrom, readAt: an outage of this host's own upstream, which a downstream clears once this host answers
            k: cached.get(k) for k in ("data", "dataAt", "error", "errorFrom", "readAt", "fetchedAt", "jobs", "jobsAt",
                                       "missing", "restRun", "restRunAt")
            if k in cached}
        if cached is not None and cached.get("source"):  # where the data came from, so a downstream wait can
            entries[key]["origin"] = cached.get("origin") if cached.get("source") == "upstream" else cached["source"]
        if cached is not None and key.startswith("pr:"):
            view = feed_view(key, cached.get("data"), load_feed_view(), time.time())
            if view is not None:
                entries[key]["feed"] = view
        if consumer:
            if ledger is None:
                doc = read_json(BASE / CONSUMERS_FILE)
                ledger = doc.get("consumers") if isinstance(doc, dict) and isinstance(doc.get("consumers"), dict) else {}
            mine = ledger.get(consumer) if isinstance(ledger.get(consumer), dict) else {}
            # each asking consumer's head budget here, so a downstream `checks` can say "budget spent" for every
            # consumer refused, not only the last one asked (upstream_denials)
            budgets[consumer] = {k: mine.get(k) for k in ("spent", "limit", "deniedAt")}
            entries[key] = {**(entries[key] or {}), "budgets": budgets}
    print(json.dumps({"entries": entries}, sort_keys=True))
    return EXIT_OK


# ---------------------------------------------------------------- cmux build controller


class LandRollupDeferred(Exception):
    """The land pass's LAND_ROLLUP_BUDGET is spent: this row's controller rollup is not asked now (rollup_green keeps
    no answer for it, so the next pass asks)."""


class OutOfTime(Exception):
    """This tick spent TICK_BUDGET: the entries it did not reach go first on the next tick. Not a
    WatchError, so no reader stores it as an entry's error."""


class NoReceiver(WatchError):
    """The controller answers but serves no run events (not deployed there, or not configured)."""


class ControllerTimeout(WatchError):
    """The controller missed a deadline (connect, read or the whole request). A WatchError, so every caller
    treats it as before; named so the fallback it causes can be counted as REST spend (`glaeda-gh budget`)."""


def timed_out(error: BaseException) -> bool:
    """Whether `error` is a deadline, however urllib wrapped it: a socket timeout reaches us bare on a read and
    inside URLError.reason on a connect, and hard_deadline's DeadlineTimeout is a TimeoutError too."""
    return isinstance(error, TimeoutError) or isinstance(getattr(error, "reason", None), TimeoutError)


def transport_reason(error: BaseException) -> str:
    """A transport failure's type and the OS's own words for it, never the URL or a value: "URLError
    (ConnectionRefusedError: [Errno 111] Connection refused)". The type alone ("controller: URLError", huge-blue 04:26-06:00Z
    2026-11-22, nine state events) could not tell a refused connection from a DNS miss or a reset (failure-drops-its-reason)."""
    name = type(error).__name__
    inner = getattr(error, "reason", None) if isinstance(error, urllib.error.URLError) else error
    if isinstance(inner, BaseException):
        words = getattr(inner, "strerror", None)
        errno_ = getattr(inner, "errno", None)
        said = (f"[Errno {errno_}] {words}" if isinstance(errno_, int) else str(words)) if isinstance(words, str) else ""
        if inner is error:
            return f"{name} ({said})" if said else name
        return f"{name} ({type(inner).__name__}: {said})" if said else f"{name} ({type(inner).__name__})"
    return name


class Controller:
    """The build controller's GitHub events (cmuxterm-hq#675) over the tailnet: no GitHub quota.
    Without a token it answers for public repositories only."""

    def __init__(self, base: str, token: str | None) -> None:
        self.base, self.token = base.rstrip("/"), token
        self.probing = False

    @classmethod
    def from_env(cls) -> "Controller | None":
        base = os.environ.get("CMUX_CI_CONTROLLER", "").strip()
        if not base:
            doc = read_json(CONTROLLER_CONFIG)
            base = (doc.get("controller") if isinstance(doc, dict) else None) or CONTROLLER_DEFAULT
        if not isinstance(base, str) or not base.startswith(("http://", "https://")):
            return None
        path = os.environ.get("CMUX_CI_TOKEN_FILE") or os.fspath(CONTROLLER_TOKEN)
        try:
            token = Path(path).read_text().strip() or None
        except (OSError, ValueError):  # ValueError: a token file that is not UTF-8
            token = None
        return cls(base, token)

    def get(self, path: str, timeout: float | None = None) -> dict:
        """One JSON answer. Raises NoReceiver (404, 503) or WatchError."""
        headers = {"Authorization": f"Bearer {self.token}"} if self.token else {}
        request = urllib.request.Request(self.base + path, headers=headers)
        try:
            read = CONTROLLER_READ_TIMEOUT if timeout is None else timeout
            deadline = CONTROLLER_DEADLINE if timeout is None else timeout + CONTROLLER_DEADLINE
            # Cap the entire request, including a trickling body, at the tick's remaining wall time.
            left = getattr(self, "budget_end", float("inf")) - time.monotonic()
            if left <= 0:
                raise ControllerTimeout("controller: request budget expired")
            read, deadline = min(read, left), min(deadline, left)
            if self.probing:
                read = min(read, CONTROLLER_PROBE_TIMEOUT)
                deadline = min(deadline, CONTROLLER_CONNECT_TIMEOUT + CONTROLLER_PROBE_TIMEOUT)
            CONTROLLER_CONNECT_DEADLINE.seconds = min(CONTROLLER_CONNECT_TIMEOUT, left)
            try:
                with hard_deadline(deadline), CONTROLLER_OPENER.open(request, timeout=read) as response:
                    doc = json.loads(response.read(MAX_BODY))
            finally:
                CONTROLLER_CONNECT_DEADLINE.seconds = None
        except urllib.error.HTTPError as error:
            if error.code in {404, 503}:
                raise NoReceiver(f"controller HTTP {error.code}") from None
            raise WatchError(f"controller HTTP {error.code}") from None
        except (OSError, HTTPException, ValueError) as error:
            if timed_out(error):
                raise ControllerTimeout(f"controller: {transport_reason(error)}") from None
            raise WatchError(f"controller: {transport_reason(error)}") from None
        if not isinstance(doc, dict):
            raise WatchError("controller: not a JSON object")
        return doc

    def run(self, run_id: int, wait: int = 0) -> dict | None:
        """The controller's view of a run, optionally long-polling until it changes state."""
        if not isinstance(wait, int) or not 0 <= wait <= CONTROLLER_RUN_MAX_WAIT:
            raise WatchError(f"controller run wait must be 0..{CONTROLLER_RUN_MAX_WAIT} seconds")
        timeout = CONTROLLER_READ_TIMEOUT if wait == 0 else wait + CONTROLLER_READ_TIMEOUT
        doc = self.get(f"/v1/github/runs/{int(run_id)}?wait={wait}", timeout=timeout)
        run = doc.get("run")
        return run if doc.get("known") and isinstance(run, dict) else None

    def events(self, since: int | None, wait: int = 0) -> dict:
        """The change feed after cursor `since`, or only the current cursor when since is None. WAIT > 0 long-polls:
        the controller answers as soon as an event lands after `since`, or empty after WAIT seconds (FeedStream)."""
        path = "/v1/github/events?since=" + ("latest" if since is None else str(int(since)))
        if wait > 0 and since is not None:
            doc = self.get(f"{path}&wait={int(wait)}", timeout=int(wait) + CONTROLLER_READ_TIMEOUT)
        else:
            doc = self.get(path)
        if not isinstance(doc.get("cursor"), int) or doc["cursor"] < 0:
            raise WatchError("controller: feed without a cursor")
        return doc

    def statuses(self, since: int | None, wait: int = 0) -> dict:
        """The commit status feed after cursor `since` (its own cursor, not the change feed's), or only the cursor when
        since is None; WAIT > 0 long-polls as events does (STATUS_FEED_OFF)."""
        path = "/v1/github/statuses?since=" + ("latest" if since is None else str(int(since)))
        if wait > 0 and since is not None:
            doc = self.get(f"{path}&wait={int(wait)}", timeout=int(wait) + CONTROLLER_READ_TIMEOUT)
        else:
            doc = self.get(path)
        if not isinstance(doc.get("cursor"), int) or doc["cursor"] < 0:
            raise WatchError("controller: status feed without a cursor")
        return doc

    def run_jobs(self, repo: str, run_id: int, attempt: int) -> dict:
        """The jobs of one run attempt the controller holds (workflow_job deliveries): known false when none."""
        return self.get(f"/v1/github/run-jobs?repo={urllib.parse.quote(repo, safe='/')}"
                        f"&run={int(run_id)}&attempt={int(attempt)}")


def controller_run(run: dict) -> dict:
    """The controller's run record in slim_run's shape."""
    return {"id": run.get("id"), "name": run.get("name"), "display_title": None, "status": run.get("status"),
            "conclusion": run.get("conclusion") or None, "html_url": run.get("url"), "head_sha": run.get("head_sha"),
            "head_branch": run.get("head_branch") or "", "event": run.get("event"), "run_attempt": run.get("attempt"),
            "created_at": None, "updated_at": run.get("updated_at")}


# ---------------------------------------------------------------- on-event: a command per finished run or job
#
# ~/.config/glaeda/on-event.json (GLAEDA_GH_ON_EVENT_CONFIG):
#   {"hooks": [{"name": "cloud-probe-promote", "repo": "manaflow-ai/cmux", "workflow": "backend.yml",
#               "branch": "feat-cmux-next", "job": "promote-production", "conclusion": "success",
#               "command": ["/usr/bin/python3", "/abs/probe.py", "run", "--sha", "{head_sha}"], "cwd": "/abs"}]}
# The daemon matches each finished run its controller feed delivers (no GitHub read): repo, branch, and workflow by
# file name or display name. With `job`, that job of the run's attempt must have `conclusion` (read from the
# controller's run-jobs); without it, the run's own conclusion. Each (hook, repo, run, attempt) runs at most once:
# the claim is written to BASE/on-event.json before the command starts, so neither a restart nor a crash runs it
# twice. The command starts detached, with an absolute executable, an environment of ON_EVENT_ENV, the hook's `env` and
# GLAEDA_EVENT_* (never a token), its output in BASE/on-event/; the daemon records its exit code. Events that happen
# while the daemon is down, or reads through an upstream (a lane VM), are not seen.


def on_event_problem(h: Any) -> str | None:
    """Why a configured hook cannot run, or None."""
    if not isinstance(h, dict):
        return "a hook is not an object"
    name = h.get("name")
    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", name):
        return "a hook needs a name of letters, digits, dot, dash or underscore"
    if not isinstance(h.get("repo"), str) or not re.fullmatch(rf"{NAME}/{NAME}", h["repo"]):
        return f"{name}: repo must be OWNER/REPO"
    for field in ("workflow", "branch"):
        if not isinstance(h.get(field), str) or not h[field]:
            return f"{name}: {field} is required"
    for field in ("job", "conclusion", "cwd"):
        if field in h and (not isinstance(h[field], str) or not h[field]):
            return f"{name}: {field} must be a non-empty string"
    if "cwd" in h and not os.path.isabs(h["cwd"]):
        return f"{name}: cwd must be an absolute path"
    env = h.get("env", {})
    if not isinstance(env, dict) or not all(
            isinstance(k, str) and re.fullmatch(r"[A-Z_][A-Z0-9_]*", k) and not k.startswith("GLAEDA_EVENT_")
            and isinstance(v, str) for k, v in env.items()):
        return f"{name}: env must map NAME to a string value (GLAEDA_EVENT_* are the daemon's)"
    command = h.get("command")
    if not isinstance(command, list) or not command or not all(isinstance(a, str) for a in command):
        return f"{name}: command must be a list of strings"
    if not os.path.isabs(command[0]):
        return f"{name}: command[0] must be an absolute path"
    # {word} is a placeholder (other braces are literal text, like a dict in a `python3 -c` script)
    unknown = {f for a in command for f in re.findall(ON_EVENT_PLACEHOLDER, a)} - set(ON_EVENT_FIELDS)
    if unknown:
        return f"{name}: unknown placeholder {{{sorted(unknown)[0]}}} (known: {', '.join(ON_EVENT_FIELDS)})"
    return None


def on_event_hooks() -> tuple[list[dict], list[str]]:
    """The configured hooks that can run, and why each other one cannot."""
    if not ON_EVENT_CONFIG.exists():
        return [], []
    doc = read_json(ON_EVENT_CONFIG)
    if not isinstance(doc, dict) or not isinstance(doc.get("hooks"), list):
        return [], [f"{ON_EVENT_CONFIG}: not a JSON object with a hooks list"]
    hooks, problems, names = [], [], set()
    for h in doc["hooks"]:
        problem = on_event_problem(h)
        if problem is None and h["name"] in names:
            problem = f"{h['name']}: a second hook of that name"
        if problem:
            problems.append(problem)
            continue
        names.add(h["name"])
        hooks.append({**h, "conclusion": h.get("conclusion", "success")})
    return hooks, problems


def on_event_state() -> dict:
    doc = read_json(BASE / ON_EVENT_STATE)
    doc = doc if isinstance(doc, dict) else {}
    runs, pending = doc.get("runs"), doc.get("pending")
    return {"runs": runs if isinstance(runs, dict) else {}, "pending": pending if isinstance(pending, dict) else {}}


def on_event_stat() -> tuple | None:
    """on-event.json's identity and change stamp; None when it does not exist."""
    try:
        st = (BASE / ON_EVENT_STATE).stat()
    except OSError:
        return None
    return (st.st_ino, st.st_size, st.st_mtime_ns)


def on_event_key(hook: str, repo: str, run_id: Any, attempt: Any) -> str:
    return f"{hook} {repo.lower()}/{run_id}/{attempt}"


def on_event_matches(hook: dict, run: dict) -> bool:
    """Whether a finished feed run is the hook's repo, branch and workflow (file name or display name)."""
    if run.get("status") != "completed" or str(run.get("repo") or "").lower() != hook["repo"].lower():
        return False
    if run.get("head_branch") != hook["branch"]:
        return False
    return hook["workflow"] in {run.get("name"), os.path.basename(str(run.get("path") or ""))}


def on_event_job(jobs: Any, name: str) -> dict | None:
    """The finished job of that name (the last one, when a name repeats), or None."""
    found = [j for j in jobs or [] if isinstance(j, dict) and j.get("name") == name and j.get("status") == "completed"]
    return max(found, key=lambda j: j.get("id") or 0) if found else None


def on_event_prune(state: dict, now: float) -> None:
    runs = {k: v for k, v in state["runs"].items() if now - float(v.get("at") or 0) < ON_EVENT_KEEP}
    keep = sorted(runs, key=lambda k: float(runs[k].get("at") or 0))[-ON_EVENT_RUNS_MAX:]
    state["runs"] = {k: runs[k] for k in keep}


# ---------------------------------------------------------------- GraphQL for PRs


def pr_query(keys: list[str], kind: str = "pr") -> tuple[str, dict]:
    """One aliased query for every PR (or issue's comments) in `keys`, plus the rate limit. Names
    travel as variables. PRs are aliased p0, p1, ...; comment watches c0, c1, ..."""
    decls, parts, variables = [], [], {}
    for i, key in enumerate(keys):
        _, owner, repo, number = split_key(key)
        decls.append(f"$o{i}: String!, $r{i}: String!, $n{i}: Int!")
        if kind in ("pr", "probe"):
            fields = PR_FIELDS.replace("NUM", f"$n{i}") if kind == "pr" else PR_PROBE_FIELDS
            parts.append(f"p{i}: repository(owner: $o{i}, name: $r{i}) {{ pullRequest(number: $n{i}) {{ {fields} }} }}")
        else:
            parts.append(f"c{i}: repository(owner: $o{i}, name: $r{i}) {{ issueOrPullRequest(number: $n{i}) "
                         f"{{ {ISSUE_FIELDS} }} }}")
        variables.update({f"o{i}": owner, f"r{i}": repo, f"n{i}": number})
    query = f"query({', '.join(decls)}) {{ rateLimit {{ limit remaining resetAt cost }} {' '.join(parts)} }}"
    return query, variables


def run_query(keys: list[str]) -> tuple[str, dict]:
    """One aliased query for every run in `keys` (w0, w1, ...), by URL, plus the rate limit."""
    decls, parts, variables = [], [], {}
    for i, key in enumerate(keys):
        _, owner, repo, run_id = split_key(key)
        decls.append(f"$u{i}: URI!")
        parts.append(f"w{i}: resource(url: $u{i}) {{ {RUN_FIELDS} }}")
        variables[f"u{i}"] = f"https://github.com/{owner}/{repo}/actions/runs/{run_id}"
    query = f"query({', '.join(decls)}) {{ rateLimit {{ limit remaining resetAt cost }} {' '.join(parts)} }}"
    return query, variables


def graphql_run(node: dict) -> dict:
    """A WorkflowRun node in slim_run's shape (REST's lowercase status and conclusion)."""
    suite = node.get("checkSuite") or {}
    return {"id": node.get("databaseId"), "name": (node.get("workflow") or {}).get("name"),
            "display_title": node.get("displayTitle"), "status": str(suite.get("status") or "").lower() or None,
            "conclusion": str(suite.get("conclusion") or "").lower() or None, "html_url": node.get("url"),
            "head_sha": (suite.get("commit") or {}).get("oid"), "head_branch": (suite.get("branch") or {}).get("name") or "",
            "event": node.get("event"), "run_attempt": node.get("runAttempt"), "created_at": node.get("createdAt"),
            "updated_at": node.get("updatedAt")}


def upper(value: Any) -> str | None:
    return str(value).upper() if value else None


def slim_pull(doc: dict) -> dict:
    keep = ("number", "html_url", "title", "state", "draft", "merged", "merged_at", "mergeable", "mergeable_state",
            "updated_at")
    head, base = doc.get("head") or {}, doc.get("base") or {}
    return {**{k: doc.get(k) for k in keep}, "head": {"sha": head.get("sha"), "ref": head.get("ref")},
            "base": {"ref": base.get("ref")}}


def slim_check_runs(doc: dict) -> dict:
    keep = ("id", "node_id", "name", "status", "conclusion", "details_url", "started_at", "completed_at")
    return {"total_count": doc.get("total_count"),
            "check_runs": [{**{k: c.get(k) for k in keep}, "suite": (c.get("check_suite") or {}).get("id"),
                            "app": (c.get("app") or {}).get("slug")}
                           for c in doc.get("check_runs") or [] if isinstance(c, dict)]}


def slim_statuses(doc: dict) -> list[dict]:
    return [{k: c.get(k) for k in ("context", "state", "target_url", "created_at", "description")}
            for c in doc.get("statuses") or [] if isinstance(c, dict)]


def slim_issue_gate(doc: dict) -> dict:
    """GET issues/N as rest_pull's change detector: only what says the PR changed."""
    return {k: doc.get(k) for k in ("number", "state", "updated_at")}


def slim_check_suites(doc: dict) -> dict:
    """GET commits/SHA/check-suites as the REST PR read's gate (PR_REST_FULL_EVERY): each suite's id, status,
    conclusion and run count, which move when a suite finishes, fails, is added or rerun, and not while its runs only
    progress."""
    suites = [[s.get("id"), s.get("status"), s.get("conclusion"), s.get("latest_check_runs_count")]
              for s in doc.get("check_suites") or [] if isinstance(s, dict)]
    return {"total": doc.get("total_count"), "suites": sorted(suites, key=lambda s: str(s[0]))}


def rollup_suites(doc: object, sha: str) -> dict | None:
    """The controller rollup DOC of SHA as slim_check_suites' answer (PR_REST_SUITES_FROM_CONTROLLER), else None: an
    incomplete or other commit's rollup, a run without its suite id, none or more than PR_REST_SUITE_PAGE suites."""
    if not isinstance(doc, dict) or doc.get("check_runs_complete") is not True or doc.get("sha", sha) != sha:
        return None
    runs = (doc.get("check_runs") or {}).get("check_runs") if isinstance(doc.get("check_runs"), dict) else None
    if not isinstance(runs, list):
        return None
    by: dict[int, list[dict]] = {}
    for run in runs:
        suite = run.get("check_suite") if isinstance(run, dict) else None
        sid = suite.get("id") if isinstance(suite, dict) else None
        if not isinstance(sid, int) or isinstance(sid, bool):
            return None
        by.setdefault(sid, []).append(run)
    if not 0 < len(by) <= PR_REST_SUITE_PAGE:
        return None
    suites = []
    for sid, listed in by.items():
        done = all(r.get("status") == "completed" for r in listed)
        conclusions = ",".join(sorted({str(r.get("conclusion")) for r in listed})) if done else None
        suites.append([sid, "completed" if done else "in_progress", conclusions, len(listed)])
    return {"total": len(suites), "suites": sorted(suites, key=lambda s: str(s[0])), "via": "controller"}


CONTROLLER_GREEN = {"success", "skipped", "neutral"}


def controller_green_checks(doc: object, sha: str) -> list[dict] | None:
    """The controller rollup DOC of SHA as its checks, when it says the head is done and green (LAND_ROLLUP_JUDGE),
    else None: incomplete (either part), another commit's, nothing in it, a check run whose newest attempt (per app,
    suite and name) is not finished or not success, skipped or neutral, or a commit status that is not success. Each
    check: name, conclusion (lower case), statusContext, and for a check run its id, app, suite and times."""
    if not isinstance(doc, dict) or doc.get("complete") is not True or str(doc.get("sha") or sha).lower() != sha:
        return None
    runs = (doc.get("check_runs") or {}).get("check_runs") if isinstance(doc.get("check_runs"), dict) else None
    statuses = (doc.get("status") or {}).get("statuses") if isinstance(doc.get("status"), dict) else None
    if not isinstance(runs, list) or not isinstance(statuses, list) or not runs + statuses:
        return None
    newest: dict[tuple, dict] = {}
    for run in runs:
        if not isinstance(run, dict) or not isinstance(run.get("id"), int) or not isinstance(run.get("name"), str):
            return None
        suite = run.get("check_suite") if isinstance(run.get("check_suite"), dict) else {}
        app = run.get("app") if isinstance(run.get("app"), dict) else {}
        key = (app.get("slug"), suite.get("id"), run["name"])
        if key not in newest or run["id"] > newest[key]["id"]:
            newest[key] = run
    checks: list[dict] = []
    for (app, suite, name), run in sorted(newest.items(), key=lambda kv: kv[1]["id"]):
        conclusion = str(run.get("conclusion") or "").lower()
        if run.get("status") != "completed" or conclusion not in CONTROLLER_GREEN:
            return None
        checks.append({"name": name, "conclusion": conclusion, "statusContext": False, "id": run["id"], "app": app,
                       "suite": suite, "started": run.get("started_at"), "completed": run.get("completed_at"),
                       "details": run.get("details_url")})
    for st in statuses:
        if not isinstance(st, dict) or not isinstance(st.get("context"), str) or st.get("state") != "success":
            return None
        checks.append({"name": st["context"], "conclusion": "success", "statusContext": True,
                       "created": st.get("created_at")})
    return checks


def controller_green_rollup(doc: object, sha: str) -> list[dict] | None:
    """controller_green_checks as land_judge's rollup context nodes (the land queue's snapshot, LAND_ROLLUP_JUDGE).
    What the controller cannot carry (a check's workflow; isRequired, False here) can only make a judgment wait, never
    pass a red: only a green head is handed on, and the merge's own judgment still reads GitHub live."""
    checks = controller_green_checks(doc, sha)
    if checks is None:
        return None
    nodes: list[dict] = []
    for c in checks:
        if c["statusContext"]:
            nodes.append({"__typename": "StatusContext", "context": c["name"], "state": "SUCCESS",
                          "createdAt": c.get("created"), "isRequired": False})
            continue
        nodes.append({"__typename": "CheckRun", "id": None, "name": c["name"], "status": "COMPLETED",
                      "conclusion": c["conclusion"].upper(), "detailsUrl": c.get("details"), "databaseId": c["id"],
                      "startedAt": c.get("started"), "completedAt": c.get("completed"), "isRequired": False,
                      "checkSuite": {"databaseId": c["suite"], "app": {"slug": c["app"]} if c["app"] else None,
                                     "workflowRun": None}})
    return nodes


def suites_path(root: str, sha: str) -> str:
    return f"{root}/commits/{sha}/check-suites?per_page={PR_REST_SUITE_PAGE}"


def check_runs_path(root: str, sha: str) -> str:
    """A head's first check-run page (filter=all: every attempt, as GraphQL's rollup lists them, so parse_pr dedupes
    both alike); page N is this with &page=N."""
    return f"{root}/commits/{sha}/check-runs?filter=all&per_page=100"


def head_pending(checks: dict, statuses: list[dict]) -> bool:
    """A head with a check run not completed, or a status pending, by its REST reads (rest_head)."""
    return (any(str(c.get("status") or "").lower() != "completed" for c in checks.get("check_runs") or [])
            or any(str(s.get("state") or "").lower() in {"pending", "expected"} for s in statuses))


def head_moved(old: dict, parts: dict, prefix: str) -> bool:
    """Whether a head read (the parts under PREFIX, a commit's) answered anything but its kept answer."""
    return any(path.startswith(prefix) and (part.get("etag") != (old.get(path) or {}).get("etag") or path not in old)
               for path, part in parts.items())


def slim_status_page(doc: dict) -> dict:
    """One page of a commit's combined status, with the total it says there is."""
    return {"total": doc.get("total_count"), "statuses": slim_statuses(doc)}


def slim_head_runs_page(doc: dict) -> dict:
    """One page of a commit's workflow runs, with the total it says there is."""
    return {"total": doc.get("total_count"), "runs": slim_head_runs(doc)}


def slim_head_runs(doc: dict) -> list[dict]:
    return [{k: r.get(k) for k in ("id", "name", "workflow_id", "check_suite_id", "conclusion", "event")}
            for r in doc.get("workflow_runs") or [] if isinstance(r, dict)]


# A dispatched run names the commit it tests in its run-name as OWNER/REPO@<40 hex>: its own head_sha is the
# dispatch ref's tip (main), never that commit (manaflow-ai/cmux fast-checks.yml). Full ids only, with the repo.
NAMED_COMMIT = re.compile(r"(?<![\w./-])([\w.-]+/[\w.-]+)@([0-9a-fA-F]{40})(?![0-9a-zA-Z])")


def names_commit(title: Any, repo: str, sha: str | None) -> bool:
    """Whether a run-name names `sha` of `repo` (OWNER/REPO) as the commit the run tests. A full 40-hex id only:
    a prefix never matches, and neither does another repo's commit or a bare sha (fast-checks' snapshot id)."""
    if not sha or not re.fullmatch(r"[0-9a-f]{40}", sha.lower()):
        return False
    return (repo.lower(), sha.lower()) in {(r.lower(), c.lower()) for r, c in NAMED_COMMIT.findall(str(title or ""))}


def run_tests_commit(data: dict, repo: str, sha: str | None) -> bool:
    """A workflow_dispatch run whose run-name names `sha` of `repo` (names_commit): the commit it tested."""
    return data.get("event") == "workflow_dispatch" and names_commit(data.get("display_title"), repo, sha)


def slim_workflows(doc: dict) -> dict[str, str]:
    """Workflow id -> name. A run's own REST name is its run-name when the workflow sets one."""
    return {str(w.get("id")): str(w.get("name")) for w in doc.get("workflows") or [] if isinstance(w, dict)}


def slim_rules(doc: Any) -> list[str]:
    """The required checks a branch's rulesets name (GET .../rules/branches/B answers a list)."""
    names = set()
    for rule in doc if isinstance(doc, list) else []:
        if isinstance(rule, dict) and rule.get("type") == "required_status_checks":
            for item in (rule.get("parameters") or {}).get("required_status_checks") or []:
                if isinstance(item, dict) and item.get("context"):
                    names.add(str(item["context"]))
    return sorted(names)


def slim_branch(doc: dict) -> list[str]:
    """The required checks a branch's classic protection names."""
    checks = (doc.get("protection") or {}).get("required_status_checks") or {}
    names = {str(c) for c in checks.get("contexts") or []}
    names |= {str(c["context"]) for c in checks.get("checks") or [] if isinstance(c, dict) and c.get("context")}
    return sorted(names)


def slim_issue(doc: dict) -> dict:
    pull = doc.get("pull_request")
    return {"html_url": doc.get("html_url"), "state": doc.get("state"), "comments": doc.get("comments") or 0,
            "pull": isinstance(pull, dict), "merged": bool((pull or {}).get("merged_at"))}


def slim_comments(doc: Any) -> list[dict]:
    """An issue's REST comments in the GraphQL comment shape parse_comments reads (REST names an App's
    account `NAME[bot]`, GraphQL `NAME`)."""
    return [{"databaseId": c.get("id"), "url": c.get("html_url"), "createdAt": c.get("created_at"),
             # REST has no lastEditedAt; updated_at past created_at is an edit (the outbox's status edits)
             **({"lastEditedAt": c["updated_at"]} if c.get("updated_at") and c.get("updated_at") != c.get("created_at")
                else {}),
             "author": {"login": re.sub(r"\[bot\]$", "", str((c.get("user") or {}).get("login") or ""))},
             "body": str(c.get("body") or "")[:COMMENT_BODY_MAX]}
            for c in doc if isinstance(c, dict)] if isinstance(doc, list) else []


def rest_issue_node(issue: dict, comments: list[dict]) -> dict:
    """The REST answers in the GraphQL issueOrPullRequest shape."""
    state = "MERGED" if issue.get("merged") else str(issue.get("state") or "").upper() or None
    return {"__typename": "PullRequest" if issue.get("pull") else "Issue", "url": issue.get("html_url"),
            "state": state, "comments": {"totalCount": issue.get("comments"), "nodes": comments[-COMMENTS_LAST:]}}


def rest_contexts(checks: dict, statuses: list[dict], runs: list[dict], required: set[str],
                  workflows: dict[str, str] | None = None) -> list[dict]:
    """A commit's REST check runs and statuses as GraphQL statusCheckRollup context nodes."""
    suites = {r.get("check_suite_id"): r for r in runs}
    workflows = workflows or {}
    nodes: list[dict] = []
    for c in checks.get("check_runs") or []:
        run = suites.get(c.get("suite"))
        nodes.append({"__typename": "CheckRun", "id": c.get("node_id"), "name": c.get("name"),
                      "status": upper(c.get("status")), "conclusion": upper(c.get("conclusion")),
                      "detailsUrl": c.get("details_url"), "databaseId": c.get("id"), "startedAt": c.get("started_at"),
                      "completedAt": c.get("completed_at"), "isRequired": c.get("name") in required,
                      "checkSuite": {"conclusion": upper(run.get("conclusion")), "app": {"slug": c.get("app")},
                                     "databaseId": c.get("suite"),
                                     "workflowRun": {
                          "databaseId": run.get("id"), "event": run.get("event"), "workflow": {
                              "name": workflows.get(str(run.get("workflow_id"))) or run.get("name"),
                                                                    "databaseId": run.get("workflow_id")}}}
                      if run else {"conclusion": None, "app": {"slug": c.get("app")}, "databaseId": c.get("suite"),
                                   "workflowRun": None}})
    for c in statuses:
        nodes.append({"__typename": "StatusContext", "context": c.get("context"), "state": upper(c.get("state")),
                      "targetUrl": c.get("target_url"), "createdAt": c.get("created_at"),
                      **({"description": c["description"]} if isinstance(c.get("description"), str) else {}),
                      "isRequired": c.get("context") in required})
    return nodes


def rest_pr_node(pull: dict, checks: dict, statuses: list[dict], runs: list[dict], required: set[str],
                 review: str | None = None, workflows: dict[str, str] | None = None) -> dict:
    """The REST answers in the GraphQL pullRequest shape, so parse_pr reads both alike."""
    nodes = rest_contexts(checks, statuses, runs, required, workflows)
    rollup = None
    if nodes:
        results = [n.get("conclusion") if n["__typename"] == "CheckRun" else n.get("state") for n in nodes]
        pending = any(n["__typename"] == "CheckRun" and n.get("status") != "COMPLETED" or
                      n["__typename"] == "StatusContext" and n.get("state") in {"PENDING", "EXPECTED"} for n in nodes)
        truncated = (checks.get("total_count") or 0) > len(checks.get("check_runs") or [])
        # GraphQL's rollup state covers every check; ours covers only what was read, so a truncated
        # list is never called green
        state = ("FAILURE" if any(r in FAILED for r in results) else "PENDING" if pending or truncated
                 else "SUCCESS")
        total = (checks.get("total_count") or 0) + len(statuses)
        rollup = {"state": state, "contexts": {"totalCount": max(total, len(nodes)),
                                               "pageInfo": {"hasNextPage": truncated}, "nodes": nodes}}
    head = pull.get("head") or {}
    state = "OPEN" if pull.get("state") == "open" else "MERGED" if pull.get("merged") else "CLOSED"
    mergeable = {True: "MERGEABLE", False: "CONFLICTING"}.get(pull.get("mergeable"), "UNKNOWN")
    return {"number": pull.get("number"), "url": pull.get("html_url"), "title": pull.get("title"), "state": state,
            "isDraft": bool(pull.get("draft")), "merged": bool(pull.get("merged")), "mergedAt": pull.get("merged_at"),
            "mergeCommit": {"oid": pull.get("merge_commit_sha")} if pull.get("merged") else None,
            "mergeable": mergeable, "mergeStateStatus": upper(pull.get("mergeable_state")) or "UNKNOWN",
            "headRefOid": head.get("sha"), "headRefName": head.get("ref"),
            "baseRefName": (pull.get("base") or {}).get("ref"), "reviewDecision": review,
            "updatedAt": pull.get("updated_at"),
            "baseRef": {"branchProtectionRule": {"requiredStatusCheckContexts": sorted(required)}, "rules": {"nodes": []}},
            "commits": {"nodes": [{"commit": {"statusCheckRollup": rollup}}]}}


def parse_comments(node: dict) -> dict:
    comments = node.get("comments") or {}
    return {"url": node.get("url"), "state": node.get("state"), "type": node.get("__typename"),
            "total": comments.get("totalCount"),
            "comments": [{"id": c.get("databaseId"), "url": c.get("url"), "createdAt": c.get("createdAt"),
                          **({"editedAt": c["lastEditedAt"]} if c.get("lastEditedAt") else {}),
                          "author": (c.get("author") or {}).get("login"),
                          "body": str(c.get("body") or "")[:COMMENT_BODY_MAX]}
                         for c in comments.get("nodes") or [] if c]}


def brief(check: dict) -> dict:
    return {k: check.get(k) for k in ("name", "workflow", "conclusion", "required", "url")}


def outranks(new: dict, new_order: tuple, old: dict, old_order: tuple) -> bool:
    """Whether `new` replaces `old`, a check of the same workflow and name. Mostly the newer attempt, but a
    job can have a same-named twin in its own run (the compile routed to one runner, its skipped twin on
    another): a job that ran beats a skipped one, and a queued or running job is never replaced by a
    cancelled one, since a newer attempt only starts once the older one has finished."""
    skipped = [(c.get("conclusion") or "").upper() == "SKIPPED" for c in (new, old)]
    if skipped[0] != skipped[1]:
        return skipped[1]
    live = [c.get("status") not in {"COMPLETED", None} for c in (new, old)]
    cancelled = [(c.get("conclusion") or "").upper() == "CANCELLED" for c in (new, old)]
    if live[1] and cancelled[0]:
        return False
    if live[0] and cancelled[1]:
        return True
    return new_order >= old_order


def confirmed_updated(cache: dict | None, node: dict | None, now: float) -> dict:
    """Store fields for a PR whose cached answer a probe (or a full read's first page) just confirmed: the node's
    updatedAt, which the fingerprint leaves out, and updatedAtAt, the time head and updatedAt were read together. {}
    when the node carries no updatedAt or another head (then the read is not a confirmation of this data)."""
    data = (cache or {}).get("data")
    upd = node.get("updatedAt") if isinstance(node, dict) else None
    if not isinstance(data, dict) or not isinstance(upd, str) or node.get("headRefOid") != data.get("headRefOid"):
        return {}
    fields: dict[str, Any] = {"updatedAtAt": now}
    if data.get("updatedAt") != upd:
        fields["data"] = {**data, "updatedAt": upd}
    return fields


def pr_fingerprint(node: dict | None) -> str | None:
    """What a PR node says that a verdict or a wait reads, as one string: its state, mergeability, head and review, its
    rollup's state, and its check runs and statuses counted by state, and its suite count. The same from the full read
    and from PR_PROBE. None when the counts are missing (a node from REST, or an answer without them): never probed."""
    if not isinstance(node, dict):
        return None
    commits = (node.get("commits") or {}).get("nodes") if isinstance(node.get("commits"), dict) else None
    commit = ((commits or [{}])[0] or {}).get("commit") if isinstance(commits, list) else None
    if not isinstance(commit, dict):
        return None
    rollup = commit.get("statusCheckRollup")
    contexts = rollup.get("contexts") if isinstance(rollup, dict) else None
    suites = commit.get("checkSuites")
    if rollup is not None and not (isinstance(contexts, dict) and isinstance(contexts.get("checkRunCountsByState"), list)
                                   and isinstance(contexts.get("statusContextCountsByState"), list)):
        return None
    if not isinstance(suites, dict) or not isinstance(suites.get("totalCount"), int):
        return None

    def counts(rows: Any) -> list:
        return sorted((str(r.get("state")), r.get("count")) for r in rows or [] if isinstance(r, dict) and r.get("count"))

    return json.dumps([node.get(k) for k in ("state", "isDraft", "merged", "mergeable", "mergeStateStatus",
                                             "headRefOid", "reviewDecision")]
                      + [None if rollup is None else rollup.get("state"),
                         None if contexts is None else contexts.get("totalCount"),
                         None if contexts is None else counts(contexts.get("checkRunCountsByState")),
                         None if contexts is None else counts(contexts.get("statusContextCountsByState")),
                         suites.get("totalCount")], sort_keys=True)


def drop_null_contexts(node: dict) -> int:
    """Remove the null (or non-object) context nodes from a PR node's rollup, in place; how many there were. A null
    node is a context GitHub failed to read: the rollup is partial, so the caller marks it (checksPageError)."""
    commits = (node.get("commits") or {}).get("nodes") if isinstance(node.get("commits"), dict) else None
    commit = ((commits or [{}])[0] or {}).get("commit") if isinstance(commits, list) else None
    rollup = commit.get("statusCheckRollup") if isinstance(commit, dict) else None
    contexts = rollup.get("contexts") if isinstance(rollup, dict) else None
    nodes = contexts.get("nodes") if isinstance(contexts, dict) else None
    if not isinstance(nodes, list):
        return 0
    kept = [c for c in nodes if isinstance(c, dict)]
    contexts["nodes"] = kept
    return len(nodes) - len(kept)


def null_contexts_error(count: int) -> str:
    return f"graphql: {count} check context{'s' if count != 1 else ''} came back null (a partial rollup)"


def head_parents(node: dict) -> list[str] | None:
    """The PR head commit's parent oids (PR_FIELDS reads up to three: a merge's first and second at least), lowercased, or None when the
    read did not carry them (a probe, REST, an older query) or its commit is not the head. The land queue reads them to tell its own update_branch's base merge (the
    pinned head plus the base) from someone's push (LandQueue.follow_own_update)."""
    commits = (node.get("commits") or {}).get("nodes") if isinstance(node.get("commits"), dict) else None
    commit = ((commits or [{}])[0] or {}).get("commit") if isinstance(commits, list) else None
    parents = commit.get("parents") if isinstance(commit, dict) else None
    nodes = parents.get("nodes") if isinstance(parents, dict) else None
    head = str(node.get("headRefOid") or "").lower()
    if not isinstance(nodes, list) or not head or str(commit.get("oid") or "").lower() != head:
        return None
    return [str(p.get("oid") or "").lower() for p in nodes if isinstance(p, dict) and p.get("oid")]


def pr_head_parent(node: dict, commits: list) -> str:
    """The first parent of the PR's head commit as the read gave it (40 hex, lowercase), or "" when this read does not
    say. Only the head commit's own parent is taken: commits(last: 1) is the head commit, and its oid is checked
    against headRefOid, so a read whose commit list lags the head (or a REST read, which carries no parents) says
    nothing rather than naming another commit's parent. A first parent is what proves a merge commit was made on top
    of a known head: land's pin follows the merge its own update-branch made (LandQueue.pin_follow)."""
    commit = ((commits[0] if commits else {}) or {}).get("commit") or {}
    oid = str(commit.get("oid") or "").lower()
    head = str(node.get("headRefOid") or "").lower()
    if not oid or not head or oid != head:
        return ""
    parents = ((commit.get("parents") or {}).get("nodes") or [])
    first = str(((parents[0] if parents else {}) or {}).get("oid") or "").lower()
    return first if SHA40.fullmatch(first) else ""


def parse_pr(node: dict) -> dict:
    commits = ((node.get("commits") or {}).get("nodes") or [{}])
    rollup = ((commits[0] or {}).get("commit") or {}).get("statusCheckRollup") or {}
    head_parent = pr_head_parent(node, commits)
    contexts = rollup.get("contexts") or {}
    latest: dict[str, tuple[tuple, dict]] = {}
    superseded: list[dict] = []  # replaced by a newer attempt or run; GitHub's rollup still counts them
    # GitHub answers a context it failed to resolve as null beside an error. One such node raised AttributeError here,
    # which batched() swallowed for the whole batch: up to GQL_BATCH PRs kept their old data, with no error stored,
    # for as long as GitHub kept answering it (huge-blue 2026-11-11: a merged PR read OPEN for 50 minutes).
    # fetch_aliased marks such a PR partial (drop_null_contexts); this only keeps the parse total.
    nodes = [c for c in contexts.get("nodes") or [] if isinstance(c, dict)]
    # A run the concurrency group cancelled for a newer run of the same workflow on this commit
    # leaves failed checks (ci-status: cancelled) that the newer run replaces when it gets there.
    def workflow_run(c: dict) -> tuple[object, int]:
        run = (c.get("checkSuite") or {}).get("workflowRun") or {}
        workflow = run.get("workflow") or {}
        return workflow.get("databaseId") or workflow.get("name"), run.get("databaseId") or 0

    newest: dict[object, int] = {}
    for c in nodes:
        workflow, run_id = workflow_run(c)
        if workflow and run_id:
            newest[workflow] = max(newest.get(workflow, 0), run_id)
    for c in nodes:
        workflow_key, run_id = workflow_run(c)
        if c.get("__typename") == "StatusContext":
            state = c.get("state")
            done = state in {"SUCCESS", "FAILURE", "ERROR"}
            check = {"name": c.get("context"), "workflow": None, "status": "COMPLETED" if done else "PENDING",
                     "conclusion": state if done else None, "url": c.get("targetUrl"),
                     # a status's own words, which GitHub caps at 140 characters: the only place a deferred check says
                     # what starts it (land_gate_labels), and a count of check runs never shows it
                     **({"description": c["description"]} if isinstance(c.get("description"), str) else {})}
            order = (0, c.get("createdAt") or "")
        else:
            workflow = (((c.get("checkSuite") or {}).get("workflowRun") or {}).get("workflow") or {}).get("name")
            check = {"name": c.get("name"), "workflow": workflow, "status": c.get("status"),
                     "conclusion": c.get("conclusion"), "url": c.get("detailsUrl"), "id": c.get("id"),
                     "runId": run_id or None, "startedAt": c.get("startedAt"), "completedAt": c.get("completedAt")}
            if c.get("status") != "COMPLETED" and c.get("databaseId"):
                check["jobId"] = c["databaseId"]  # an unfinished run's Actions job, for straggler_cut's jobs read
            # databaseId first: a queued rerun has no startedAt yet but is still the newer attempt
            order = (c.get("databaseId") or 0, c.get("startedAt") or "")
        check["required"] = bool(c.get("isRequired"))
        if c.get("lastRealAttempt"):
            check["lastRealAttempt"] = True  # its suite's newest attempt ran nothing: GitHub's rollup state omits it
        if ((c.get("checkSuite") or {}).get("conclusion") == "CANCELLED" and workflow_key and run_id
                and run_id < newest[workflow_key]):
            superseded.append(check)
            continue
        # a rerun leaves the old attempt in the list (cancelled, then passed): keep the newest per
        # (workflow, name), so same-named jobs in different workflows stay separate
        ident = f"{check['workflow'] or ''}\0{check['name']}"
        if ident not in latest or outranks(check, order, *reversed(latest[ident])):
            if ident in latest:
                superseded.append(latest[ident][1])
            latest[ident] = (order, check)
        else:
            superseded.append(check)
    checks = [check for _, check in latest.values()]
    # A concurrency group shared across workflows cancels one workflow's job for another's: manaflow-ai/cmux#50693 at
    # f4620c79 (2026-11-22), "pr-red-checks / comment" ran in three workflow runs on the head; the "CI" one (run
    # 45046534087) was cancelled at 16:56:14Z and another workflow's started 16:56:32Z and passed, yet status counted
    # the cancel as failed and `wait pr --sha` exited 1. A cancelled check run is superseded by a same-named one of
    # another workflow that started at or after it and passed; a real failure, or a cancel with no such twin, counts.
    passed_at: dict[str, list[str]] = {}
    for c in checks:
        if c.get("workflow") and c.get("startedAt") and (c.get("conclusion") or "").upper() in {"SUCCESS", "NEUTRAL"}:
            passed_at.setdefault(str(c.get("name")), []).append(str(c["startedAt"]))
    def cancelled_by_twin(c: dict) -> bool:
        started = c.get("startedAt")
        return (bool(c.get("workflow") and started) and (c.get("conclusion") or "").upper() == "CANCELLED"
                and any(at >= str(started) for at in passed_at.get(str(c.get("name")), [])))
    superseded.extend(c for c in checks if cancelled_by_twin(c))
    checks = [c for c in checks if not cancelled_by_twin(c)]
    # only the ones that would have counted against the PR are worth keeping. One that ran nothing (GitHub
    # stamps it started and completed at once), such as a twin cancelled before it began, stays as evidence
    # for check_verdict (the rollup still counts it) but is marked so status never names it: it has no
    # error to chase, whichever of the pair has the higher id
    superseded = [{**brief(c), "ranNothing": bool(c.get("completedAt") and c.get("startedAt") == c.get("completedAt")),
                   # read by suite id, not from the rollup: not in its counts (rollup_red_is_superseded)
                   **({"lastRealAttempt": True} if c.get("lastRealAttempt") else {})}
                  for c in superseded if (c.get("conclusion") or "").upper() not in PASSED]
    # the cache keeps 20; the ones dropped past that that status would count still reach its count line
    superseded_omitted = sum(1 for c in superseded[20:] if not c["ranNothing"])
    superseded = superseded[:20]
    base = node.get("baseRef") or {}
    required = set((base.get("branchProtectionRule") or {}).get("requiredStatusCheckContexts") or [])
    for rule in ((base.get("rules") or {}).get("nodes") or []):
        for item in ((rule.get("parameters") or {}).get("requiredStatusChecks") or []):
            required.add(item.get("context"))
    # A required check that has not reported yet (ci-status appears only when its run reaches it)
    # is pending, not absent: judging only the required checks present would call a run green early.
    for check in checks:
        if check.get("lastRealAttempt") and check.get("name") in required:
            check["required"] = True  # no isRequired on a run read by suite id: the base's rules decide
    reported = {c.get("name") for c in checks}
    return {
        "requiredMissing": sorted(name for name in required if name and name not in reported),
        "requiredNames": sorted(name for name in required if name),  # what the base requires (check_verdict)
        "number": node.get("number"), "url": node.get("url"), "title": node.get("title"),
        "state": node.get("state"), "isDraft": node.get("isDraft"), "merged": node.get("merged"),
        "mergedAt": node.get("mergedAt"), "mergeCommit": node.get("mergeCommit"), "mergeable": node.get("mergeable"),
        "mergeStateStatus": node.get("mergeStateStatus"), "headRefOid": node.get("headRefOid"),
        **({"headParent": head_parent} if head_parent else {}),
        "headRefName": node.get("headRefName"), "baseRefName": node.get("baseRefName"),
        "reviewDecision": node.get("reviewDecision"), "updatedAt": node.get("updatedAt"),
        **({"headParents": parents} if (parents := head_parents(node)) is not None else {}),
        "checkState": rollup.get("state"), "checks": checks, "superseded": superseded,
        "supersededOmitted": superseded_omitted,
        "checksTotal": contexts.get("totalCount", len(checks)),
        "checkCounts": check_counts(contexts),
        "checksTruncated": bool((contexts.get("pageInfo") or {}).get("hasNextPage")),
        # a read whose head commit came back null or absent (a latched or cut-short answer) read no rollup at all:
        # partial, so no wait calls it "nothing reported" or green (check_verdict, wait_step's deadline)
        **({"checksPageError": "graphql: no head commit in the read (rollup unread)"}
           if "commits" in node and not isinstance(((commits or [None])[0] or {}).get("commit"), dict) else {}),
    }


def split_unread(data: dict) -> dict:
    """DATA (parse_pr's answer) with its required names kept apart by how sure the read is: on a partial rollup
    (checksPageError) a required name not in `checks` may sit past the pages read, so it is `requiredUnread`, and
    `requiredMissing` (not reported, read in full) is empty. manaflow-ai/cmux#43194, 2026-11-15: a held page left
    "clippy (changed cmux-tui packages)" past page one, and status sent agents at that passed check as missing."""
    if not data.get("checksPageError"):
        return data
    unread = sorted(set(data.get("requiredUnread") or []) | set(data.get("requiredMissing") or []))
    data["requiredUnread"], data["requiredMissing"] = unread, []
    return data


def required_names(base: dict) -> set[str]:
    """The contexts a PR's base requires, from its classic protection and its rulesets (GraphQL baseRef)."""
    required = set((base.get("branchProtectionRule") or {}).get("requiredStatusCheckContexts") or [])
    for rule in ((base.get("rules") or {}).get("nodes") or []):
        for item in ((rule.get("parameters") or {}).get("requiredStatusChecks") or []):
            if item.get("context"):
                required.add(item["context"])
    return {name for name in required if name}


def known_steps(pairs: list[tuple[dict, dict]]) -> dict[str, list]:
    """Check node id -> [failedSteps, stepCount] from the cached data: a completed check keeps them."""
    known: dict[str, list] = {}
    for e, _ in pairs:
        for c in (((e["cache"] or {}).get("data") or {}).get("checks") or []):
            if c.get("id") and isinstance(c.get("failedSteps"), list):
                known[c["id"]] = [c["failedSteps"], c.get("stepCount")]
    return known


def slim_run(doc: dict) -> dict:
    keep = ("id", "name", "display_title", "status", "conclusion", "html_url", "head_sha", "head_branch",
            "event", "run_attempt", "created_at", "updated_at")
    return {k: doc.get(k) for k in keep}


def settled_pr(data: dict) -> bool:
    """A merged or closed PR: its failed steps are not read from GitHub (on 2026-11-10 cosmic-gray's daemon read 54
    jobs/{id} in ten minutes, most for merged cmux PRs). Steps already cached are still carried forward: `wait pr
    --until green|done` rules on a merged PR too, and a runner refusal inside the rescue grace is held by them."""
    return str(data.get("state") or "").upper() in {"MERGED", "CLOSED"}


def wants_steps(c: dict) -> bool:
    """A check whose steps the daemon reads once: a failure (which steps failed) or a cancellation
    (did any step run: the owned-pool rescue cancels a job still queued for a runner, then re-runs it)."""
    return bool(c.get("id")) and (c.get("conclusion") or "").upper() in STEP_FAILED | {"CANCELLED"}


def failed_steps(steps: list | None) -> list[str]:
    return [str(s.get("name")) for s in steps or [] if isinstance(s, dict)
            and str(s.get("conclusion") or "").upper() in STEP_FAILED]


def slim_jobs(doc: dict) -> list[dict]:
    keep = ("id", "name", "status", "conclusion", "html_url", "run_attempt", "runner_name", "labels",
            "started_at", "completed_at")
    return [{**{k: j.get(k) for k in keep}, "failedSteps": failed_steps(j.get("steps")),
             "stepCount": len(j["steps"]) if isinstance(j.get("steps"), list) else None}
            for j in doc.get("jobs") or []]


def slim_run_jobs(doc: Any) -> dict:
    """A run's job list as fill_steps_rest keeps it: each job's id, status, failed steps and step count."""
    doc = doc if isinstance(doc, dict) else {}
    return {"total": doc.get("total_count") or 0, "jobs": [
        {"id": j.get("id"), "status": j.get("status"), "failedSteps": failed_steps(j.get("steps")),
         "stepCount": len(j["steps"]) if isinstance(j.get("steps"), list) else None}
        for j in doc.get("jobs") or [] if isinstance(j, dict)]}


def settled_job(j: Any) -> bool:
    """A job a list showed completed with its steps: its failed steps and step count are final."""
    return isinstance(j, dict) and j.get("status") == "completed" and isinstance(j.get("failedSteps"), list) \
        and isinstance(j.get("stepCount"), int)


def jobs_attempt(jobs: list[dict] | None) -> int:
    """The newest attempt the job list covers (with filter=latest a re-run of failed jobs keeps the
    jobs that passed at their old attempt)."""
    return max((j.get("run_attempt") or 0 for j in jobs or []), default=0)


# A completed run attempt's job list, kept on disk with no expiry (2026-11-17, Leo: "so claude desktop shows rate limit
# on hover of the github links sometimes"; the shared REST pool at 0/5000, its top route GET .../actions/runs/{id}/jobs
# at 56 an hour, read by this daemon for a lane VM's `--jobs` watches relayed by the broker). A watched `--jobs` run was
# read again each cycle a reader touched it, and its job list with it, long after the attempt had finished: a completed
# attempt's jobs never change (a re-run is a new attempt, with a new run_attempt), so once a list is read with the run
# completed at that attempt and every job listed completed, read_jobs answers it from here with no request. A run still
# moving reads its list as before, with If-None-Match. Keyed by (repo, run id, attempt) like the lane-gh broker's kept
# actions/runs/N/attempts/A/jobs (cmuxterm-hq tools/lane-gh-broker/parts/36-immutable-cache.py), under BASE beside the
# job-log cache (BASE/logs) and evicted the same way: least recently read first past ATTEMPT_JOBS_MAX_BYTES. It holds
# the default (filter=latest) list read_jobs reads, slimmed (slim_jobs), so it outlives the run's cache entry
# (CACHE_KEEP) and a watch dropped and registered again later.
ATTEMPT_JOBS_DIR = "run-jobs"
ATTEMPT_JOBS_MAX_BYTES = 64 * 1024 * 1024  # a slimmed 50-job list is ~8 KB gzip'd: several thousand attempts


def attempt_jobs_done(run: dict | None, jobs: Any) -> int | None:
    """The attempt a job list is final for, else None: the run (as read with or before the list) completed at that
    attempt, the list is not empty, every job in it completed, and its newest job is of that attempt. A job a
    `needs:` held back is listed by then: the run completes only after every job it will run has."""
    if not isinstance(run, dict) or run.get("status") != "completed" or not isinstance(jobs, list) or not jobs:
        return None
    attempt = run.get("run_attempt") or 1
    if not isinstance(attempt, int) or isinstance(attempt, bool):
        return None
    if not all(isinstance(j, dict) and j.get("status") == "completed" for j in jobs) or jobs_attempt(jobs) != attempt:
        return None
    # A run that did not pass lists a job that did not either; a list that does not (caught between a "re-run failed
    # jobs" dropping the failed ones and listing their new attempt, say) is not kept: the next read asks again.
    if run.get("conclusion") not in RUN_OK and all(j.get("conclusion") in RUN_OK for j in jobs):
        return None
    return attempt


def attempt_jobs_path(repo: str, run_id: int, attempt: int) -> Path:
    owner, name = repo.lower().split("/", 1)
    return BASE / ATTEMPT_JOBS_DIR / owner / name / f"{int(run_id)}.{int(attempt)}.json.gz"


def attempt_jobs_get(repo: str, run_id: int, attempt: int) -> list[dict] | None:
    """The kept job list of that completed attempt, or None. A hit is marked used (its mtime) for eviction."""
    path = attempt_jobs_path(repo, run_id, attempt)
    try:
        with open(path, "rb") as f:
            doc = json.loads(gzip.decompress(f.read()))
    except (OSError, EOFError, ValueError, zlib.error):
        return None  # missing or damaged: a miss, and the next read replaces it
    jobs = doc.get("jobs") if isinstance(doc, dict) else None
    if not isinstance(jobs, list) or not jobs or not all(isinstance(j, dict) for j in jobs):
        return None
    with contextlib.suppress(OSError):
        os.utime(path)
    return jobs


def attempt_jobs_put(repo: str, run_id: int, attempt: int, jobs: list[dict]) -> None:
    """Keep that completed attempt's job list, replaced whole, then evict past the cap. Never raises: a full disk
    only means the next read asks GitHub."""
    path = attempt_jobs_path(repo, run_id, attempt)
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        stable_replace(path, gzip.compress(json.dumps({"repo": repo.lower(), "run": int(run_id), "attempt": int(attempt),
                                                       "jobs": jobs}, separators=(",", ":")).encode(), mtime=0))
    except OSError:
        return
    kept_evict(BASE / ATTEMPT_JOBS_DIR, ".json.gz", ATTEMPT_JOBS_MAX_BYTES)


# ---------------------------------------------------------------- daemon


def newest_verdict(found: list[tuple[int, str, str]]) -> tuple[str, str]:
    """(status, conclusion) of a check from its runs (id, status, conclusion): the newest run with a verdict,
    so a later skipped, cancelled or still-running run never hides an earlier failure; the newest run when
    none has a verdict yet, but not a skipped twin while a run of that name is still going."""
    found = sorted(found)
    verdicts = [r for r in found if r[1] == "completed" and r[2] in VERDICTS]
    ran = [r for r in found if r[2] != "skipped"] or found
    _, status, conclusion = verdicts[-1] if verdicts else ran[-1]
    return status, conclusion


HEAD_CONTEXTS = """statusCheckRollup{contexts(first:100%s){pageInfo{hasNextPage endCursor} nodes{__typename
... on CheckRun{id databaseId name status conclusion startedAt completedAt checkSuite{databaseId app{slug}
workflowRun{databaseId event workflow{name databaseId}}}}
... on StatusContext{context state description}}}}"""

PR_CONTEXT_MAX_PAGES = 20  # 2,000 contexts per PR; beyond that the cache stays explicitly partial
# The follow-up pages' own share of the shared login's GraphQL hour, in points over the last hour. Past it a PR that
# still needs a page reads pending (checksPageError) until the hour frees room: paging every
# watched PR every cycle once spent 1678 of one daemon's 1958 points an hour (#1830), and the landers that need the
# same hour to read their gates must never be starved by a completeness read.
PR_PAGES_POINTS_PER_HOUR = 300
NAMED_READS_KEPT = 2000  # required_by_name's conditional answers kept; past it the oldest go first
# required_by_name's ETags and answers, kept across restarts and re-execs: an in-memory store lost them on every one,
# so the first read of each required name after it was a counted 200 instead of a free 304. On huge-blue
# (2026-11-15, a restart about every hour at :37) that burst was most of its REST share: 90 of its 148 counted
# REST an hour were these reads, and its share alarm fired about ten minutes after each restart.
NAMED_READS_FILE = "named-reads.json"


def slim_named(doc: Any) -> Any:
    """A by-name answer cut to what required_by_name reads (named_check_node's fields, a status's), so the kept store
    stays small on disk; anything else is kept as it came."""
    if isinstance(doc, dict) and isinstance(doc.get("check_runs"), list):
        keep = ("node_id", "name", "status", "conclusion", "details_url", "html_url", "id", "started_at", "completed_at")
        return {"check_runs": [{**{k: r.get(k) for k in keep}, "app": {"slug": (r.get("app") or {}).get("slug")}}
                               for r in doc["check_runs"] if isinstance(r, dict)]}
    if isinstance(doc, dict) and isinstance(doc.get("statuses"), list):
        keep = ("context", "state", "target_url", "created_at")
        return {"total_count": doc.get("total_count"),
                "statuses": [{k: s.get(k) for k in keep} for s in doc["statuses"] if isinstance(s, dict)]}
    return doc


def load_named_reads(doc: Any) -> dict[str, tuple[str | None, Any]]:
    """NAMED_READS_FILE's well-formed entries (path -> [ETag, answer]), oldest first."""
    reads = doc.get("reads") if isinstance(doc, dict) else None
    out: dict[str, tuple[str | None, Any]] = {}
    for path, pair in (reads if isinstance(reads, dict) else {}).items():
        if (isinstance(path, str) and isinstance(pair, list) and len(pair) == 2 and isinstance(pair[0], str)
                and isinstance(pair[1], dict)):
            out[path] = (pair[0], pair[1])
    return dict(list(out.items())[-NAMED_READS_KEPT:])


def named_check_node(run: dict) -> dict:
    """A REST check run read by name (required_by_name) as a statusCheckRollup context node. It is required (its
    name is), and its workflow is unknown: REST names only its suite, and parse_pr keys a check by workflow and name,
    so it never stands beside the same run read from the rollup (only names the rollup did not show are read)."""
    return {"__typename": "CheckRun", "id": run.get("node_id"), "name": run.get("name"),
            "status": upper(run.get("status")), "conclusion": upper(run.get("conclusion")),
            "detailsUrl": run.get("details_url") or run.get("html_url"), "databaseId": run.get("id"),
            "startedAt": run.get("started_at"), "completedAt": run.get("completed_at"), "isRequired": True,
            "checkSuite": {"conclusion": None, "app": {"slug": (run.get("app") or {}).get("slug")},
                           "workflowRun": None}}


def head_query(owner: str, repo: str, sha: str, cursor: str | None = None,
               pull_number: int | None = None) -> str:
    after = f', after:"{cursor}"' if cursor else ""
    required = f" isRequired(pullRequestNumber:{pull_number})" if pull_number is not None else ""
    contexts = (HEAD_CONTEXTS % after).replace("databaseId name status conclusion",
                                                f"databaseId name status conclusion{required}")
    if required:
        contexts = contexts.replace("... on StatusContext{context state description}",
                                    f"... on StatusContext{{context state description{required}}}")
    suites = "" if cursor else " " + SUITE_ATTEMPTS
    return (f'repository(owner:"{owner}",name:"{repo}"){{object(oid:"{sha}"){{... on Commit{{'
            + contexts + suites + "}}}")


def heads_query(keys: list[str]) -> str:
    """One aliased query for every head in KEYS (h0, h1, ...), with each one's CHECKS_OF_RECORD commit (m0, ...), plus
    the rate limit. Its repositories are literal (head_query), which is how AppPool.owner_of finds their owner."""
    parts = []
    for i, key in enumerate(keys):
        _, owner, repo, sha = split_key(key)
        parts.append(f"h{i}: " + head_query(owner, repo, sha))
        if (owner, repo) in CHECKS_OF_RECORD:
            parts.append(f"m{i}: " + head_query(*CHECKS_OF_RECORD[(owner, repo)], sha))
    return "query{rateLimit{limit remaining resetAt cost}\n" + "\n".join(parts) + "}"


def heads_repos(keys: list[str]) -> list[str]:
    """The repositories ("OWNER/REPO") heads_query(KEYS) reads: each head's, and its CHECKS_OF_RECORD one."""
    out = []
    for key in keys:
        _, owner, repo, _ = split_key(key)
        out.append(f"{owner}/{repo}")
        if (owner, repo) in CHECKS_OF_RECORD:
            out.append("/".join(CHECKS_OF_RECORD[(owner, repo)]))
    return out


def fold_contexts(nodes: list, runs: dict, statuses: dict, ids: dict, prefix: str = "",
                  order: dict | None = None, failed: dict | None = None) -> None:
    """Add one page of a head's contexts to runs (`workflow / job` -> [(id, status, conclusion)]), statuses
    (`status / context` -> (status, conclusion, state)) and ids (failed Actions jobs). prefix (`OWNER/REPO: `) keys
    another repository's checks apart, so a same-named check there never stands in for one here (CHECKS_OF_RECORD).
    A status's `error` is folded into the conclusion `failure` (every reader of `found` counts it red), and its own
    state is kept beside it (head_data's statusStates): an `error` is a poster that gave no verdict, which a reader
    such as a fallback dispatcher must tell apart from a red. `failed` (optional) gets each failure's databaseId ->
    node id, for the step counts head_steps reads."""
    for item in nodes or []:
        if not item:
            continue
        if item.get("__typename") == "StatusContext":
            state = (item.get("state") or "").lower()
            statuses[f"{prefix}status / {item['context']}"] = (
                "in_progress" if state in ("pending", "expected") else "completed",
                "failure" if state == "error" else state, state,
                item.get("description") if isinstance(item.get("description"), str) else None)
            continue
        suite = item.get("checkSuite") or {}
        slug = (suite.get("app") or {}).get("slug")
        owner = (((suite.get("workflowRun") or {}).get("workflow") or {}).get("name") or slug or "check")
        key = f"{prefix}{owner} / {item['name']}"
        conclusion = (item.get("conclusion") or "").lower()
        runs.setdefault(key, []).append((item.get("databaseId") or 0, (item.get("status") or "").lower(), conclusion))
        if order is not None:  # head_data's `runs`: each run's own id and times, and its identity (run_identity)
            order.setdefault(key, []).append([item.get("databaseId") or 0, (item.get("status") or "").lower(),
                                              conclusion, item.get("startedAt") or "", item.get("completedAt") or "",
                                              run_identity(item, suite)])
        if slug == "github-actions" and conclusion == "failure" and item.get("databaseId"):
            ids.setdefault(key, []).append(item["databaseId"])
        if failed is not None and conclusion == "failure" and item.get("databaseId") and item.get("id"):
            failed[item["databaseId"]] = item["id"]  # head_steps reads each one's step count


def run_identity(item: dict, suite: dict) -> dict:
    """What tells one check run's run apart from another's (head_data's `runs`, a row's sixth field): its Actions run's
    databaseId, event and workflow databaseId and name (the key's prefix, so a reader can split the job's own name off), its app's slug and its check suite's databaseId, each only when read,
    and lastRealAttempt for a run of an older suite attempt
    (last_real_contexts) that GitHub's rollup no longer lists."""
    run = suite.get("workflowRun") or {}
    workflow = run.get("workflow") or {}
    app = suite.get("app")
    out = {"run": run.get("databaseId"), "workflow": workflow.get("databaseId"), "workflowName": workflow.get("name"),
           "event": run.get("event"),
           "app": app.get("slug") if isinstance(app, dict) else None, "suite": suite.get("databaseId"),
           "lastRealAttempt": True if item.get("lastRealAttempt") else None}
    if app is None and "app" in suite:
        out["appNull"] = True  # GitHub's documented null app, not an unread one
    return {k: v for k, v in out.items() if v is not None}


def attach_steps(data: dict, counts: dict) -> None:
    """Add `steps` (the job's step count) to the identity of each failed row of data's `runs` that COUNTS (check run
    databaseId -> count) knows. A failed job with 0 steps never ran: land-judge's runner_refused reads a stored red
    as it reads a live one. A row without it is unknown, never zero; the key is an addition, older readers skip it."""
    for rows in (data.get("runs") or {}).values():
        for row in rows:
            if len(row) > 5 and isinstance(row[5], dict) and row[2] == "failure" and row[0] in counts:
                row[5]["steps"] = counts[row[0]]


# A head's `runs` (head_data's ORDER): every check run fold_contexts read at the head, by key, as [databaseId, status,
# conclusion, startedAt, completedAt, identity] (run_identity: its Actions run, workflow, event, app and suite, so a
# reader can collapse a rerun's attempts and drop a superseded cancel as a live rollup read does; leo-workspace
# land-judge's head checks read it before going live). `found` keeps one verdict per name and no order, so a reader could not tell a
# replay that ran after its shard's newest rerun from an older one: leo-workspace merge_hold's webview verdict could
# only hold on the cache (Codex F1 on lw#4070), and while the shared login's GraphQL hour was spent its live read and
# the head's own check reads all failed, so cmux#46128, #46236 and #46782 sat at glaeda land's 6 h retry deadline on
# green heads (2026-11-20). With each run's id and times the cache orders a head as its live check runs do. A reader
# that finds no `runs` (an entry written before this) has no ordering evidence, as before.
def head_data(sha: str, runs: dict, statuses: dict, ids: dict, order: dict | None = None) -> dict:
    found = {key: list(newest_verdict(rs)) for key, rs in runs.items()}
    found.update({key: list(value[:2]) for key, value in statuses.items()})
    # no check yet is not "all finished": a push's checks appear a few seconds later
    running = any(st != "completed" for rs in runs.values() for _, st, _ in rs)
    settled = bool(found) and not running and all(status == "completed" for status, _ in found.values())
    states = {key: value[2] for key, value in statuses.items() if len(value) > 2}
    data = {"sha": sha, "found": found, "ids": ids, "settled": settled, "statusStates": states}
    # each status's description where the read gave one (GraphQL's always; REST's combined status too): a reader
    # judging from the cache (land-judge's fast-gates base, a ws-check standby post) reads what a live read would
    said = {key: value[3] for key, value in statuses.items() if len(value) > 3 and value[3] is not None}
    if said:
        data["statusDescriptions"] = said
    if order is not None:
        data["runs"] = {key: sorted(rs, key=lambda r: int(r[0] or 0)) for key, rs in order.items()}
    return data


def _bounded(value: Any, default: float, low: float, high: float) -> float:
    """value when it is a plain number within [low, high], else default."""
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value != value:
        return default
    return value if low <= value <= high else default


def policy_host() -> str:
    """This host's name in the fleet policy: on a lane VM the broker's name for it (LANE_VM_NAME_FILE), else
    update.json's host, else the short hostname."""
    try:
        vm = LANE_VM_NAME_FILE.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        vm = ""
    if LANE_VM_NAME_SHAPE.fullmatch(vm):
        return vm
    doc = read_json(UPDATE_CONFIG)
    host = doc.get("host") if isinstance(doc, dict) else None
    return host if isinstance(host, str) and host else socket.gethostname().split(".")[0].lower()


def policy_doc() -> dict:
    """The fleet policy's default, then its hosts[this host], then ~/.config/glaeda/gh-daemon.json."""
    doc: dict = {}
    fleet = read_json(FLEET_POLICY)
    if isinstance(fleet, dict):
        hosts = fleet.get("hosts") if isinstance(fleet.get("hosts"), dict) else {}
        for layer in (fleet.get("default"), hosts.get(policy_host())):
            doc.update(layer if isinstance(layer, dict) else {})
    local = read_json(DAEMON_CONFIG)
    doc.update(local if isinstance(local, dict) else {})
    return doc


def daemon_policy() -> dict:
    """The daemon's pacing: ~/.config/glaeda/gh-daemon.json over the fleet policy over the module defaults.

    {"cycle": 60, "commentCycle": 15, "restShare": 0.4,
     "floors": {"rest": {"floor": 1500, "reserve": 300}, "graphql": {"floor": 500, "reserve": 100}},
     "forceLow": ["graphql"]}

    A bucket's floor is where it counts as low: below it the daemon polls it LEAN_FACTOR times less
    often and serves what it can from the other bucket. forceLow treats the buckets it names as below
    their floors whatever GitHub says, to show the fallback live without draining a real quota.

    Every key is optional, and a value that is not a number in range keeps its default, so a typo
    can neither stop the daemon nor turn it into a busy loop. A reserve above its floor keeps both
    defaults: "stop" must come after "lean". restShare 0 sends every PR and run read to GraphQL
    (a failed attempt's job list is still read once: the cap never holds that back).
    Read every tick, so an edit applies without a restart."""
    doc = policy_doc()
    cycle = int(_bounded(doc.get("cycle"), CYCLE, 15, 900))
    comment = int(_bounded(doc.get("commentCycle"), COMMENT_CYCLE, 5, 300))
    floors = dict(FLOORS)
    write_floors = dict(FLOORS)  # the configured (floor, reserve), before the hard reserve: the outbox's writes
    hard = hard_reserve_floor()
    given = doc.get("floors") if isinstance(doc.get("floors"), dict) else {}
    for bucket, (floor, reserve) in FLOORS.items():
        one = given.get(bucket) if isinstance(given.get(bucket), dict) else {}
        f = int(_bounded(one.get("floor"), floor, 0, 100000))
        r = int(_bounded(one.get("reserve"), reserve, 0, 100000))
        f, r = (f, r) if r <= f else (floor, reserve)
        write_floors[bucket] = (f, r)
        # Never under the hard reserve (hard_reserve_floor): a config's lower reserve is raised to it. A floor the
        # raised reserve reaches is raised above it by the band it had, so "lean" still comes before "stop" (GraphQL's
        # module default 500/100 becomes 900/500, not 500/500 with no lean band at all).
        raised = max(r, hard[bucket])
        floors[bucket] = (f if f > raised else raised + (f - r), raised)
    per_minute = int(_bounded(doc.get("graphqlPerMinute"), GRAPHQL_PER_MINUTE, 1, 5000))
    alarms = doc.get("alarms") if isinstance(doc.get("alarms"), dict) else {}
    consumer_setting = alarms.get("consumerShare")
    consumer = consumer_setting if isinstance(consumer_setting, dict) else {}
    return {"cycle": cycle, "commentCycle": comment, "graphqlPerMinute": per_minute,
            "streams": doc.get("streams") is not False,
            "alarms": {"pool": alarms.get("pool") is True, "share": alarms.get("share") is not False,
                       "consumerShare": False if consumer_setting is False else {
                           "fraction": float(_bounded(consumer.get("fraction"), CONSUMER_SHARE_FRACTION, 0.01, 1.0)),
                           "minCalls": int(_bounded(consumer.get("minCalls"), CONSUMER_SHARE_MIN_CALLS, 1, 5000))},
                       "landWait": alarms.get("landWait") is not False,
                       "stale": alarms.get("stale") is not False, "staleRestart": alarms.get("staleRestart") is not False,
                       "restLeft": int(_bounded(alarms.get("restLeft"), ALARM_REST_LEFT, 0, 100000)),
                       "paceShare": float(_bounded(alarms.get("paceShare"), ALARM_PACE_SHARE, 0.0, 1.0))},
            "cycles": {"pr": cycle, "run": cycle, "comment": comment, "head": cycle},
            "floors": floors, "writeFloors": write_floors, "hardReserve": hard, "restShare": float(_bounded(doc.get("restShare"), REST_SHARE, 0.0, 1.0)),
            # restYield out of range (or not a number) is left out, so the default (no yield) holds
            **({"restYield": int(doc["restYield"])} if isinstance(doc.get("restYield"), (int, float))
               and not isinstance(doc.get("restYield"), bool) and 0 <= doc["restYield"] <= 100000 else {}),
            "forceLow": tuple(b for b in ("rest", "graphql")
                              if isinstance(doc.get("forceLow"), list) and b in doc["forceLow"])}


def consumer_policy() -> dict:
    """CONSUMER_DEFAULTS with the keys of ~/.config/glaeda/gh-consumers.json laid over them."""
    policy = {**CONSUMER_DEFAULTS, "reserved": dict(CONSUMER_DEFAULTS["reserved"])}
    doc = read_json(CONSUMERS_CONFIG)
    if isinstance(doc, dict):
        if isinstance(doc.get("reserved"), dict):
            policy["reserved"] = {str(k): int(v) for k, v in doc["reserved"].items() if isinstance(v, (int, float))}
        for k in ("limit", "pool"):
            if isinstance(doc.get(k), (int, float)):
                policy[k] = int(doc[k])
    return policy


def merge_counter(counters: list[dict], seen: dict) -> list[dict]:
    """counters with one reading folded in. A reading whose reset is within RESET_JITTER of a known counter's is
    that counter (GitHub's reset for one window can differ by a second between answers), and within one window a
    counter only goes down, so the lower remaining wins whichever arrived last; the freshest seenAt and the
    later reset are kept."""
    out, merged = [], False
    for c in counters:
        if not merged and abs(c["reset"] - seen["reset"]) <= RESET_JITTER:
            c = {**c, "limit": seen.get("limit", c.get("limit")), "remaining": min(c["remaining"], seen["remaining"]),
                 "reset": max(c["reset"], seen["reset"]), "seenAt": max(c["seenAt"], seen["seenAt"])}
            if "spent" in c or "spent" in seen:  # GraphQL: the points this daemon's queries drew from it
                c["spent"] = int(c.get("spent") or 0) + int(seen.get("spent") or 0)
            tags = sorted(set(c.get("counters") or []) | set(seen.get("counters") or []))
            if tags:
                c["counters"] = tags  # a counter keeps the tag any of its readings gave it (ACTIONS_COUNTER_PATH)
            merged = True
        out.append(c)
    if not merged:
        out.append(dict(seen))
    return sorted(out, key=lambda c: c["reset"])


def graphql_drawn(budget: dict, live: list[dict], now: float) -> dict | None:
    """The GraphQL counter the daemon's own queries last drew from (budget["graphqlDrawn"], Daemon.note_budget): the
    live counter in LIVE within RESET_JITTER of its reset, or the drawn reading itself once its reset passed (that
    counter has a fresh window), or None when no query has answered with a live reset (the poorest is the reading)."""
    d = budget.get("graphqlDrawn")
    if not (isinstance(d, dict) and isinstance(d.get("reset"), (int, float)) and isinstance(d.get("remaining"), int)
            and isinstance(d.get("seenAt"), (int, float))):
        return None
    if d["reset"] <= now:
        return d
    return next((c for c in live if abs(c["reset"] - d["reset"]) <= RESET_JITTER), None)


def rest_counters(budget: dict, key: str = "restCounters") -> list[dict]:
    """The well-formed entries of budget["restCounters"] (Daemon.settle_rest), or of budget["graphqlCounters"]."""
    out = []
    for c in budget.get(key) or []:
        if (isinstance(c, dict) and isinstance(c.get("reset"), (int, float)) and isinstance(c.get("remaining"), int)
                and isinstance(c.get("seenAt"), (int, float))):
            out.append(c)
    return out


# -- the land queue's check snapshot (glaeda-gh land -> land_judge explain)
#
# cosmic-gray, 2026-11-17: the shared login ran dry before every reset, and the land queue (session glaeda-land) was
# its top caller, 606 REST in an hour, mostly `GET commits/SHA/check-runs` reads land_judge made for each queued PR at
# each judgment: every `land-judge explain` read the head's whole status rollup (and its path-routing check runs by
# name) again, though this daemon had just read the same head for every `glaeda-gh status pr` / `wait pr` caller.
# Now, for each PR the land queue holds, a full read here also keeps the head's raw rollup context nodes (the fields
# land_judge's HEAD_REDS_QUERY asks, every page) in ROLLUP_DIR, and the queue hands land_judge a copy at the judged
# head (LAND_SNAPSHOT_ENV, explain only). land_judge judges those nodes with the parser its own GraphQL read uses, so
# its verdict is the same; the final pinned merge (the shim's own judgment) and its evidence are still read live. A
# head the snapshot does not hold yet is read by the daemon on its next tick (rollup_stale makes that tick a full
# read), never by each waiter. Nodes the daemon folds in from other sources are left out: a REST read by name
# (required_by_name) and a suite's last real attempt (add_last_real_contexts) are not in land_judge's own read.
ROLLUP_DIR = "rollups"
ROLLUP_SCHEMA = "glaeda-gh-rollup/v1"
ROLLUP_SWEEP_EVERY = 3600.0  # snapshots of PRs the land queue no longer holds are removed this often
ROLLUP_ALL = "\0every page"  # page_pr_contexts' REQUIRED for a read of every page: no context has this name


def rollup_path(key: str) -> Path:
    return BASE / ROLLUP_DIR / file_name(key)


def read_rollup(key: str) -> dict | None:
    doc = read_json(rollup_path(key))
    return doc if isinstance(doc, dict) and doc.get("schema") == ROLLUP_SCHEMA and doc.get("key") == key else None


def broker_repo_slugs() -> dict[str, str]:
    """The OWNER/REPO slugs this host has a checkout of, as the broker recorded them. A local file read: it costs no
    quota and is never required, so a missing or damaged store is simply no hint."""
    with contextlib.suppress(Exception):
        doc = read_json(broker_repos_path())
        repos = doc.get("repos") if isinstance(doc, dict) else None
        if isinstance(repos, dict):
            return {str(k): str(v) for k, v in repos.items() if isinstance(k, str)}
    return {}


def write_failure(item: dict, status: int, doc: dict, known: dict[str, str] | None = None) -> str:
    """One line for a write GitHub refused, which is all its caller ever sees (`post status ID` prints it).

    It names the target, because the target is a word the caller typed and GitHub's own message never repeats it:
    on 2026-11-21 `post pr manaflow-ai/glaeda` recorded `HTTP 422: Validation Failed (invalid)` and
    `post comment manaflow-ai/glaeda#2395` recorded `HTTP 404: Not Found`, while the wrong word in both was the
    owner (glaeda is teamleaderleo/glaeda). It also keeps GitHub's `resource` and `field` next to its `code`, which
    is what turns `(invalid)` into `(PullRequest.head: invalid)`. One line, no newline: readers take the last line.
    """
    repo = str(item.get("repo") or "")
    parts = []
    for e in doc.get("errors") or []:
        if not isinstance(e, dict):
            continue
        if e.get("message"):  # GitHub wrote the sentence; its code adds nothing to it
            parts.append(gh_said(e["message"], limit=None))
            continue
        where = ".".join(str(e[k]) for k in ("resource", "field") if e.get(k))
        code = str(e.get("code") or "")
        part = f"{where}: {code}" if where and code else where or code
        if part:  # an error dict with none of the three says nothing; empty parens say less than no parens
            parts.append(part)
    line = f"HTTP {status}: {gh_said(doc.get('message'), limit=None)}".rstrip().rstrip(":")  # a body with no message: no bare colon
    if parts:
        line += f" ({'; '.join(parts)})"
    if repo:
        number = item.get("number")
        reached = f"{repo}#{number}" if number else repo
        # Every status, not only 404: the 422 that started this (`post pr manaflow-ai/glaeda`) read as a bad head
        # branch precisely because the line never said which repository the head was being pushed into.
        line += f": writing {reached}"
        if status in (403, 404):
            line += (" -- no such target this login can write to: the repository (wrong owner, renamed, or no"
                     " access)" + (f" or the number {number}" if number else ""))
        name = repo.split("/")[-1]
        elsewhere = sorted(s for s in (known or {}) if s != repo and s.split("/")[-1] == name)
        if elsewhere:
            line += f"; a repository named {name} is known here as {', '.join(elsewhere)}"
    return " ".join(line.split())


class Daemon:
    # Which credential this thread's last request() used, and its App pool: per thread, never one field on the daemon.
    # graphql() reads them right after its request() returns, while the outbox, the content-pause ask and the land
    # threads send their own requests on the same daemon (request's in_call comment: huge-blue 2026-11-22). A shared
    # field let another thread's login request flip "app" to "login" in between, so an App's GraphQL answer was booked
    # as login spend (gql_log, note_spend "graphql", spend.json's daemon:glaeda-gh) and its rateLimit as the login's
    # budget. Leo, 2026-11-22: "this is clearly not measured properly".
    @property
    def last_request_source(self) -> str:
        return getattr(self.__dict__.setdefault("_request_local", threading.local()), "source", "login")

    @last_request_source.setter
    def last_request_source(self, value: str) -> None:
        self.__dict__.setdefault("_request_local", threading.local()).source = value

    @property
    def last_app_pool(self) -> "AppPool | None":
        return getattr(self.__dict__.setdefault("_request_local", threading.local()), "pool", None)

    @last_app_pool.setter
    def last_app_pool(self, value: "AppPool | None") -> None:
        self.__dict__.setdefault("_request_local", threading.local()).pool = value

    def __init__(self, transport: Callable = http, token: Callable[[], str] = gh_token,
                 controller: Any = "env", upstream: Any = "config", app_pool: Any = "auto") -> None:
        # The clock comes first: the pool built below reads it (restore_bench), and a clock set afterwards
        # made Daemon() raise AttributeError for every caller that did not pass its own app_pool.
        self.now = time.time()
        self.clock_real = True  # tick(now=...) in tests pins the clock
        self.transport = transport
        self.last_request_source = "login"  # credential used by the most recent request (App or login)
        self.login_cause = ""  # why the most recent request went on the login (note_login_fallback's cause), or ""
        # The App chain's tokens for repo reads (AppPool, app_pool_chain); "auto" finds them on this host, None keeps
        # every read on the login.
        chain = app_pool_chain(APP_POOL_SPARES)
        self.app_pool: AppPool | None = (
            AppPool(role=chain[0], clock=lambda: self.clock()).with_spares(chain[1:]).restore_bench()
            if app_pool == "auto" else app_pool)
        self.last_app_pool: AppPool | None = None  # the pool of the last App request (a spare's answer is its own)
        # False for an upstream host's direct read: the lane-gh broker answers GET branches/B from git (the tip, no
        # protection, and on 2026-11-16 no answer within 60 s), so fetch_pr_rest takes GraphQL's last word instead.
        self.reads_protection = True
        self.rules_ttl = REST_REPO_PART_TTL  # a direct read through the broker keeps a base's rulesets longer
        # False for that read too: the broker answers no ETag (broker_transport), so an issues/N read can never vouch
        # for a kept pull (rest_pull's 304 probe) and is not sent (DIRECT_PARTS says what that read cost).
        self.etags = True
        # "config" re-reads UPSTREAM_CONFIG every tick, so writing or removing it switches the mode
        # without a restart; a test passes a callable (request -> answer) or None.
        self.upstream_source = upstream
        self.upstream_at = float("-inf")  # the last full upstream read
        self.upstream_end = float("inf")  # time.monotonic() past which this tick sends the upstream nothing more
        self.upstream_cut: str | None = None  # the part ("keys" or "heads") the last tick's budget left unsent
        # A lane VM's own read token (ReadTokenPool): "config" reads upstream.json; a test sets read_token_source to a
        # pool and read_transport to its fake GitHub.
        self.read_token_source: Any = None
        self.read_transport: Callable | None = None
        self.read_pool: ReadTokenPool | None = None
        self.read_reader: Daemon | None = None
        self.read_served = 0
        self.upstream_status: dict[str, Any] | None = None
        # "env" (or any callable) is re-read every tick, so a daemon follows a controller move
        # (cmux-fleet-client's client.json repointed) without a restart; an instance stays fixed.
        self.controller_source: Callable[[], Any] | None = (
            Controller.from_env if controller == "env" else controller if callable(controller) else None)
        self.controller = self.controller_source() if self.controller_source else controller
        self.controller_down_until = 0.0
        self.controller_feed_at = float("-inf")
        self.feed_held: list[dict] = []  # feed pages read between a tick's reads, for the next read_controller
        self.feed_between = False  # feed_between_reads is reading (a request it makes must not read again)
        self.feed_after_controller = False  # this tick is past its controller phase: its reads may read the feed
        self.tick_thread: int | None = None  # the thread running tick (feed_due reads the feed on it alone)
        self.controller_failures = 0
        self.controller_budget_end = float("inf")  # time.monotonic() past which this tick asks the controller nothing
        self.rollup_slow: dict[str, float] = {}  # head sha -> self.now before which its rollup is not asked
        self.rollup_down_until = 0.0
        # The controller a daemon with none (a direct read's: controller=None) asks for check rollups only
        # (direct_rollup_controller); every other controller path stays off for it.
        self.rollup_controller: Any = None
        self.controller_filled: set[str] = set()  # watched runs the controller tracks, while its feed answers
        self.controller_cursor: int | None = None
        self.status_cursor: int | None = None  # the controller's commit status feed (STATUS_FEED_OFF)
        self.status_feed_off_until = 0.0
        self.status_feed_error: str | None = None
        self.controller_seen: dict[str, bool] = {}  # watched run key -> the controller knows the run
        self.controller_status: dict[str, Any] = {"state": "off" if self.controller is None else "starting"}
        self.nudged: set[str] = set()  # PRs (and heads) a check event touched since their last fetch
        # Event streams (EVENT_STREAMS): the controller's last answer per PR key, when a PR's event count last moved,
        # and what the backstop saved
        self.streams_prs: dict[str, dict] = {}
        self.streams_event_at: dict[str, float] = {}
        self.streams_at, self.streams_ok_at, self.streams_retry_at = float("-inf"), float("-inf"), 0.0
        self.streams_status: dict[str, Any] = {"state": "starting"}
        self.streams_saved, self.streams_nudges = 0, 0
        self.land_dirty: set[str] = set()  # event/cache keys retained for LandQueue after due() consumes nudged
        self.controller_ok_at = float("-inf")  # the last time the change feed answered
        self.fed_repos: dict[str, float] = {}  # owner/repo (lowercase) -> the last event the feed delivered for it
        # "pr:owner/repo#N", "sha:owner/repo@SHA", "branch:owner/repo@B" -> when the feed last delivered an event
        # for it (LAND_FEED_QUIET_MAX's comment), and since when the feed has answered without a gap (None: down)
        self.feed_marks: dict[str, float] = {}
        # "owner/repo@SHA" -> when the feed last delivered a *completed* run or suite for that commit (LAND_EVENT_JUDGE)
        self.feed_done: dict[str, float] = {}
        self.feed_live_since: float | None = None
        self.feed_unstarved = 0  # PR waits not handed back as starved: the feed showed their copy current
        # On an upstream host: PR key -> the upstream's feed view of it (feed_view) and when it was given (answeredAt)
        self.upstream_feed: dict[str, dict] = {}
        self.feed_view_saved: tuple | None = None  # what save_feed_view last wrote (it writes only on a change)
        self.reexec_waiting: float | bool = False  # since when an update has waited on a running land step (serve)
        # Until when (time.monotonic) a drain past REEXEC_DRAIN_MAX lets the judgments past half their bound finish:
        # read once, when the drain limit is first reached (LandQueue.finishing; reexec_due's finish_until)
        self.reexec_finish_until: float | None = None
        self.land_forward_ident: int | None = None
        self.land_pass_lock = threading.Lock()  # one scheduler owns a pass, including an executor-role change
        self.land_queue: LandQueue | None = None  # `glaeda-gh land` (made when BASE/land first exists)
        self.rollups: dict[str, tuple[Any, Any]] = {}  # key -> (head, fp) of its ROLLUP_DIR snapshot, as last written
        self.rollup_keys: tuple[float, frozenset[str]] = (float("nan"), frozenset())  # (self.now, rollup_wanted)
        self.rollup_swept = float("-inf")
        self.on_event_procs: dict[str, subprocess.Popen] = {}  # on-event commands started and not reaped yet, by key
        self.on_event_pending: bool | None = None  # whether on-event.json holds runs to resolve (None: not read yet)
        self.on_event_seen: tuple | None = None  # on-event.json's stat when on_event_pending was learned
        self.on_event_kept: list[dict] = []  # matching runs a busy state lock held back: the cursor is past them
        self.on_event_next: str | None = None  # the pending key a tick's deadline cut off: the next tick starts there
        self.on_event_problems: set[str] = set()  # config problems already logged
        self.gql_reason = "other"  # what the GraphQL query being sent reads, for daemon.json graphqlBy
        self.gql_log: list[tuple[float, str, int]] = []  # (time, reason, points) per GraphQL query, last hour
        # REST path -> (ETag, answer) of required_by_name's reads, so an unchanged one is a free 304, kept on disk
        # (NAMED_READS_FILE) so a restart or re-exec still asks with the ETag
        self.named_reads: dict[str, tuple[str | None, Any]] = load_named_reads(read_json(BASE / NAMED_READS_FILE))
        self.named_dirty = False
        self.share_pace_at = float("-inf")  # the last share-pace log line (share_alarm)
