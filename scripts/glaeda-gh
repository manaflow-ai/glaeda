# whose one read serves every wait, not to the next of the broker's `gh` calls polling the same locks.
GRAPHQL_SLOT_WANT_FRESH = 1.0
GRAPHQL_SLOT_WANT_TOUCH = 0.25
# A slot is held per request, for at most this long by anyone in this process (graphql_slot_reap): the daemon's own
# request ends within HTTP_DEADLINE. huge-blue, 2026-11-18 ~20:00Z: both of the login's slots flocked by the serve
# process while no pr read was stored for 600 s and nothing said who held them. Past the bound the watchdog closes the
# holder's slot file (the lock goes with it), logged once naming the thread, what it read and for how long.
GRAPHQL_SLOT_HOLD_MAX = 2.0 * HTTP_DEADLINE
# A slot whose request is on the wire (graphql_slot_flight) is past the reap's reach until this: a land worker's thread
# has no SIGALRM deadline, and its slot freed under it let a second request in (review of glaeda#2189, F3). Every
# daemon request is in flight from take to release, so a hung one is still freed past it, logged as in flight with its
# thread and its call (review of glaeda#2199).
GRAPHQL_SLOT_FLIGHT_MAX = 4.0 * GRAPHQL_SLOT_HOLD_MAX
STALE_RESTART_ADVICE = "`glaeda-gh restart` restarts a daemon in this state."
