BOOTSTRAP_RETRY = 10  # launchctl bootstrap is retried this long after bootout
HEARTBEAT_EVERY = 30  # the daemon rewrites daemon.json at least this often
# What this daemon runs, in every heartbeat: the sha256 of the script's bytes when serve started (the bytes
# script_changed compares) and when. leo-workspace tools/fast-patch reads it to know a swapped-in release is the one
# running, instead of inferring it from a start after the swap; `glaeda-gh status` readers can name the build too.
RUNNING_SCRIPT: dict = {}
# A request's socket timeout bounds each read, not the request: a server that trickles bytes, or a tick
# of many slow reads, kept one 10-20 daemon silent for 20 minutes. So every request also has a hard
# wall-clock deadline, a tick stops starting requests after TICK_BUDGET (the rest go first next tick),
# and a watchdog thread exits the process when the loop has not come round for WATCHDOG_AFTER, so
# launchd or systemd starts a fresh one.
SOCKET_TIMEOUT = 20  # each connect, TLS handshake and read
HTTP_DEADLINE = 45  # one whole GitHub request, from connect to the last body byte
SUBPROCESS_DEADLINE = 20  # gh auth token, launchctl, ps: killed with their whole process group after
TICK_BUDGET = 90  # shared wall-clock budget for the tick's GitHub reads, including the last response
# A REST read the tick's budget cut off partway resumes on its next try within this long: the shared answers its cut
# attempts got (repo_part, head_part) stand for it past their TTL, and its data is dated from the first attempt. Before,
# each try asked everything again (head parts keep REST_HEAD_PART_TTL, 15 s, and ticks are ~90 s apart), so a read
# longer than what a tick had left after the reads ahead of it never stored anything, try after try.
RESUME_MAX = 300.0
REST_HEAD_BUDGET = 40  # seconds of a tick's REST phase the waited heads may take while a waited PR or run is still to read:
# past it those heads are deferred (first next tick), so the PRs a wait is blocked on get the rest of the tick
# (huge-blue 2026-11-21, 00:58Z to 23:xxZ: 99 due heads, a dozen waited, each ~5 requests at ~3 s, filled every tick and
# 325 waited PRs sat 3 h unread; the stale valve restarted the daemon every 30 min to no effect)
# The asked heads with no answer too, past the first of the tick, and on GraphQL as on REST (the head batches go first
# there): the land queue registers the head of every open entry for land-judge (watch_head), so ~700 heads were asked and
# unanswered at once, and they ranked ahead of every waited PR with no bound. The land host, 2026-11-22 10:2xZ: 48 head
# reads and 3 PR reads stored in 600 s, 331 waited PRs, waited PR data 7,195 s old; at 06:57Z and 08:51Z "no pr read
# stored in the last 600s; ticks spent 600 s, most in read head (518 s)". One asked head a tick still goes first, so a
# merge gate's new SHA is never starved; the rest share the tick with the waited PRs.
REST_PLAIN_BUDGET = 30  # seconds of a tick's REST phase the plain watches may take: past it they are deferred (first next
# tick, in order) and only what a wait blocks on, a finished run to confirm or an asked head with no answer is still read
# (huge-blue 2026-11-20: 1170 watches over REST, ticks of 90 s back to back, `checks` for a new SHA "unread" for 10+ min)
WATCHDOG_CYCLES = 5
WATCHDOG_AFTER = WATCHDOG_CYCLES * CYCLE  # the loop silent this long is hung: exit EXIT_WATCHDOG
EXIT_WATCHDOG = 75  # EX_TEMPFAIL: the service manager restarts the daemon
# The watchdog thread logs before it exits, so a main thread stuck inside a write to stdout or stderr
# (a full pipe, a hung disk) holds the stream lock it needs. faulthandler's own C thread needs neither
# the GIL nor that lock: it ends the process (status 1) this long after the watchdog should have.
WATCHDOG_BACKSTOP = 60
STALE_HEARTBEAT = 2 * WATCHDOG_AFTER  # a lock holder silent this long is hung; a waiting daemon takes over
LOCK_RETRY = 15  # a daemon waiting for the lock looks at its holder this often
TAKEOVER_GRACE = 10  # after SIGTERM, how long a hung holder has before SIGKILL
FAILING_AFTER = 120  # every tick raising for this long is a broken daemon, not a transient error
FAILED = {"FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE", "ERROR", "STALE"}
STEP_FAILED = {"FAILURE", "TIMED_OUT", "STARTUP_FAILURE", "ACTION_REQUIRED"}  # a cancelled step is not the cause
PASSED = {"SUCCESS", "NEUTRAL", "SKIPPED"}
RUN_OK = {"success", "neutral", "skipped"}
