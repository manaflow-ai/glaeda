# The coordinator, 2026-11-20: right after the GraphQL reset glaeda land held PRs "not judged this window: host cap
# (graphql)" while their verdict was a cache read away (cmux#46128, #46236, #46782 had sat 6 h on unreadable reads).
LAND_CACHE_ONLY_MAX_AGE = 900  # merge_hold's own --cache-only bound (its CACHE_ONLY_MAX_S)
# LAND_REST_ROUTE: when GraphQL's live count is spent to its hard reserve (so no pace slot opens before its reset) and
