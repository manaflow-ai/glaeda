# Head check reads (`glaeda-gh checks`): every session that wants a commit's checks asks the daemon, which
# reads each head once for all of them, in batched GraphQL queries, and keeps the answer. Each asker names
# a consumer; a consumer has an hourly budget of head reads. A reserved consumer (next-autoland) is always
# served up to its reservation, whatever the others have used; the rest share a pool, each capped, and are
# served from the cache alone once spent or when the GraphQL quota is lean.
HEAD_SETTLED_TTL = 600  # a head whose checks all finished is re-read this rarely (a rerun can change it)
