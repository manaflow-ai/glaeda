# A private repository on a plan without branch protection or rulesets answers 403 with this: there are
# no requirements to read, as for a deleted base branch.
NO_FEATURE = re.compile(r"Upgrade to GitHub Pro|make this repository public to enable this feature", re.I)
RICH_WINDOW_MIN = 60  # seconds: a bucket about to reset is rich, but not infinitely so
FULL_WINDOW = 3600  # a bucket not seen yet, or past its reset, counts as a full hour's quota
SWITCH_MARGIN = 1.25  # a kind moves to the other bucket only when that one is this much richer
REST_CHECK_PAGES = 5  # check-run pages (100 each) one PR read over REST takes at most
REST_STATUS_PAGES = 2  # commit-status pages (100 each) likewise
REST_RUN_PAGES = 2  # a commit's workflow-run pages (100 each) likewise: without its run a check has no workflow
REST_STEPS_MAX = 10  # step reads (a run's job-list page or one job) one PR read over REST makes at most
REST_JOB_PAGES = 3  # pages (100 jobs each) of one run's job list a step lookup reads before it reads the job alone
# A job whose steps read GitHub refused for good (404 for a job of a deleted run, 410, 422) is not asked again for
# this long: each such read was retried on every read of its PR, a counted request each time. A 5xx or a transport
# error is asked again at the normal pace: the steps hold a runner refusal for the rescue, whose grace is 360 s.
STEPS_RETRY = 900.0
STEPS_GONE = re.compile(r"HTTP (?:404|410|422)\b")
# The most counted REST requests one read can make before its step lookups, which are admitted one
# at a time: a PR is its pull, REST_CHECK_PAGES of check runs, statuses, runs, workflows, rules and
# the branch; a run is the run and its job list. The share admits a read only when this much fits. The
# workflows, rules and branch reads are shared (REST_REPO_PART_TTL), but a cold or expired share still sends them.
# A comment watch is the issue and at most two pages of its comments; a head is REST_CHECK_PAGES of check
# runs, its statuses, its workflow runs and the workflow names.
# The repository- and base-level parts of a REST PR read (the workflow names, the base's rulesets and its
# classic protection) are the same answer for every PR on that repository and base. The daemon keeps one
# answer for all of them this long; past it, the next PR read refreshes it with one conditional read. The
# branch's ETag moves with every commit to the base, so without this each PR paid a counted 200 after
# every base move. A required check added or dropped on the base shows within this time.
REST_REPO_PART_TTL = 600
REST_REPO_PART_KEEP = 3600  # an answer past its TTL still lends its ETag to the refresh this long
# A commit's check runs, statuses and workflow runs, a pull and a run's job list are read the same way for every
# watch that needs them (a PR and a head watch on one commit, PRs whose failed jobs share a run): one answer serves
# them all for REST_HEAD_PART_TTL, and past it the newest ETag known makes the refresh conditional, so a commit
# nothing changed on answers 304 (free). Before, a GraphQL read dropped a PR's kept answers (restParts=None), so the
# next REST read of that PR sent every one of them cold: on 2026-11-11 huge-blue's daemon sent 19 check-run, 17
# status, 17 workflow-run and 22 pull reads in an hour and not one came back 304. Short, so a nudged PR (NUDGE_MIN)
# still reads its head anew. REST_SHARED_MAX bounds the store; the oldest answers go first.
REST_HEAD_PART_TTL = 15
REST_SHARED_MAX = 600
REST_READ_MAX = {"pr": REST_CHECK_PAGES + REST_STATUS_PAGES + REST_RUN_PAGES + 4, "run": 2, "comment": 3,
                 "head": REST_CHECK_PAGES + REST_STATUS_PAGES + REST_RUN_PAGES + 1}

# NUM is the alias's PR-number variable: isRequired needs it
PR_FIELDS = """number url title state isDraft merged mergedAt mergeable mergeStateStatus headRefOid
headRefName reviewDecision updatedAt baseRef { branchProtectionRule { requiredStatusCheckContexts }
rules(first: 50) { nodes { type parameters { ... on RequiredStatusChecksParameters {
  requiredStatusChecks { context } } } } } } commits(last: 1) { nodes { commit { SUITE_ATTEMPTS statusCheckRollup { state
contexts(first: 100) { totalCount PR_COUNTS pageInfo { hasNextPage endCursor } nodes { __typename
... on CheckRun { id name status conclusion detailsUrl databaseId startedAt completedAt
  isRequired(pullRequestNumber: NUM) checkSuite { conclusion workflowRun { databaseId workflow { name databaseId } } } }
... on StatusContext { context state targetUrl createdAt isRequired(pullRequestNumber: NUM) } } } } } } }"""
# A check reads as its last real attempt left it (2026-11-05). statusCheckRollup, like every latest-attempt view, lists
# only each check suite's newest attempt, and one that ended in startup_failure ran no jobs: after two such reruns of
# run 41931705470, cmux#35906's "publish tree-addressed cmux-tui" red was gone from it, and the PR merged as 633d5e38
# at e1d1894a with that red not excused. Such an attempt is no result, never green. So each read also counts every
# suite's check runs in its newest attempt; a suite whose newest attempt ran nothing has its check runs (every attempt)
# read by id (last_real_contexts), one query for the whole batch, and folded in, newest per name.
# The count of every attempt's runs is not asked here (2026-11-08): GitHub prices a connection nested under
# checkSuites(first: 100) at 100 requests per PR whatever its own first is, so the two counts were 200 of the 204
# requests in each PR of the batched read, 20 points for a batch of ten. The suites whose newest attempt ran nothing
# (on a cmux head about 15 of 55, mostly apps' suites that never run anything) are read by id instead, where each
# suite is one request: a suite that never ran anything comes back with no runs and adds nothing.
SUITE_ATTEMPTS = ("checkSuites(first: 100) { totalCount pageInfo { hasNextPage } nodes { id "
                  "latest: checkRuns(first: 1) { totalCount } } }")
SUITE_RUNS_BATCH = 100  # suite ids per SUITE_RUNS query: GitHub's nodes(ids:) takes at most 100
PR_FIELDS = PR_FIELDS.replace("SUITE_ATTEMPTS", SUITE_ATTEMPTS)
# A PR's fingerprint (pr_fingerprint): what a verdict or a wait reads from a PR, as counts. The full read above costs
# about 1.4 points a PR (contexts, suites and rules at up to 100 each) and the daemons re-read every watched PR every
# cycle: on 2026-11-11 11Z, PR reads were 1,550 of the two daemons' ~2,000 GraphQL points an hour (huge-blue 602,
# cosmic-gray 949), most of them answers identical to the last. PR_PROBE asks only the fingerprint, about 3 requests a
# PR, so ten PRs cost 1 point; a PR whose fingerprint matches its last full read is confirmed (dataAt moves) without
# the full read, its check pages, its last-real-attempt suites or its steps. Any change, a PR never fully read, a
# partial one, or one fully read longer than PR_FULL_EVERY ago, is read in full.
PR_COUNTS = ("checkRunCount checkRunCountsByState { state count } statusContextCount "
             "statusContextCountsByState { state count }")
PR_FIELDS = PR_FIELDS.replace("PR_COUNTS", PR_COUNTS)
PR_PROBE_FIELDS = (f"number state isDraft merged mergeable mergeStateStatus headRefOid reviewDecision commits(last: 1) "
                   f"{{ nodes {{ commit {{ checkSuites(first: 1) {{ totalCount }} statusCheckRollup {{ state "
                   f"contexts(first: 1) {{ totalCount {PR_COUNTS} }} }} }} }} }}")
PR_FULL_EVERY = 600  # a probed PR is still read in full this often (a renamed check, a base's required contexts)
PR_WHOLE_EVERY = 1800  # ... and a PR past one page of checks is read whole (pages and all) at least this often
SUITE_RUNS = """query($suites: [ID!]!) { rateLimit { limit remaining resetAt cost } suiteRuns: nodes(ids: $suites) {
... on CheckSuite { id conclusion app { slug } workflowRun { databaseId workflow { name databaseId } }
checkRuns(first: 100, filterBy: { checkType: ALL }) { pageInfo { hasNextPage } nodes { id name status conclusion
  detailsUrl databaseId startedAt completedAt } } } } }"""


def ran_nothing_suites(commit: dict | None) -> list[str] | str:
    """The ids of COMMIT's check suites whose newest attempt ran no check run (an older attempt may have run some:
    last_real_contexts reads them); an error message when COMMIT has more suites than one page shows (one past it
    could hide a red: never greener)."""
    if commit is None:
        return []  # no such commit here (a fork that lacks it): nothing to read
    suites = commit.get("checkSuites")
    if not isinstance(suites, dict):
        # GitHub answers a field it failed to read as null beside an error: an unread field is never "none ran nothing"
        return "graphql: last real attempt: the commit's check suites could not be read"
    if (suites.get("pageInfo") or {}).get("hasNextPage"):
        return "graphql: last real attempt: more than 100 check suites on one commit"
    nodes = suites.get("nodes")
    if not isinstance(nodes, list):
        return "graphql: last real attempt: malformed check suites (no node list)"
    out = []
    for suite in nodes:
        # A null node, or a null, missing or non-count total, is GitHub failing that field beside a nested error:
        # read as zero it made a partial read look complete and could hide an older red (glaeda#1844 F1).
        latest = count_field(suite, "latest")
        if latest is None:
            return "graphql: last real attempt: malformed check suite counts (a partial read)"
        if latest == 0:
            if not suite.get("id"):
                return "graphql: last real attempt: malformed check suite (no id)"
            out.append(suite["id"])
    return out


def count_field(suite: object, field: str) -> int | None:
    """SUITE's FIELD.totalCount when it is a whole number of zero or more, else None (unread or malformed)."""
    if not isinstance(suite, dict):
        return None
    holder = suite.get(field)
    total = holder.get("totalCount") if isinstance(holder, dict) else None
    return total if type(total) is int and total >= 0 else None


def suites_contexts(suites: list[str] | str, runs: dict[str, list[dict]],
                    runs_error: str | None) -> tuple[list[dict], str | None]:
    """The check-run context nodes of SUITES (ran_nothing_suites: a list, or its error) out of RUNS (suite_runs);
    ([], error) when SUITES or RUNS could not be read: a partial read would be a smaller, greener head."""
    if isinstance(suites, str):
        return [], suites
    if not suites:
        return [], None
    if runs_error:
        return [], runs_error
    for s in suites:
        if s not in runs:
            return [], "graphql: last real attempt: a suite could not be read"
        if isinstance(runs[s], str):
            return [], runs[s]
    return [node for s in suites for node in runs[s]], None


COMMENT_FIELDS = f"""comments(last: {COMMENTS_LAST}) {{ totalCount nodes {{ databaseId url createdAt lastEditedAt
author {{ login }} body }} }}"""
ISSUE_FIELDS = f"""__typename ... on Issue {{ url state {COMMENT_FIELDS} }}
... on PullRequest {{ url state {COMMENT_FIELDS} }}"""
RUN_FIELDS = """__typename ... on WorkflowRun { databaseId runAttempt event createdAt updatedAt url displayTitle
workflow { name } checkSuite { status conclusion commit { oid } branch { name } } }"""
STEPS_QUERY = """query($ids: [ID!]!) { rateLimit { limit remaining resetAt cost }
nodes(ids: $ids) { ... on CheckRun { id steps(first: 100) { nodes { name conclusion } } } } }"""
TOKEN_RE = re.compile(r"(gh[pousr]_[A-Za-z0-9_]{20,251}|github_pat_[A-Za-z0-9_]{20,251}|[0-9a-f]{40})")


class WatchError(RuntimeError):
    pass


# ---------------------------------------------------------------- keys and files


def parse_key(kind: str, text: str) -> str:
    """`pr:owner/repo#n`, `run:owner/repo/id` or `comment:owner/repo#n`, lowercased so every session
    shares one entry."""
    match = KEY_RES[kind].fullmatch(text.strip()) if kind in KEY_RES else None
    if not match:
        form = {"pr": "OWNER/REPO#N or a pull request URL", "run": "OWNER/REPO/RUN_ID or a run URL",
                "comment": "OWNER/REPO#N or an issue or pull request URL"}.get(kind, "pr, run or comment")
        raise WatchError(f"{kind} must be {form}, not {text!r}")
    owner, repo, number = match.groups()
    if kind == "head":
        return f"head:{owner.lower()}/{repo.lower()}@{number.lower()}"
    sep = "/" if kind == "run" else "#"
    return f"{kind}:{owner.lower()}/{repo.lower()}{sep}{int(number)}"


def split_key(key: str) -> tuple[str, str, str, Any]:
    """(kind, owner, repo, number); a head's last part is its 40-hex commit id."""
    kind, rest = key.split(":", 1)
    owner, rest = rest.split("/", 1)
    repo, number = re.split(r"[#/@]", rest, maxsplit=1)
    return kind, owner, repo, number.lower() if kind == "head" else int(number)


ROUTE_SHA = re.compile(r"[0-9a-fA-F]{40}")


def route_of(method: str, path: str) -> str:
    """A REST request's route template, for the spend log: METHOD /repos/{owner}/{repo}/pulls/{id}?per_page&state.
    Ids and commit SHAs are templated, a branch (which may hold slashes) or a label is one {branch} or {label}, and
    the query keeps its parameter names only, so one route counts every PR and page it read."""
    path, _, query = path.partition("?")
    parts = path.split("/")
    if len(parts) > 3 and parts[1] == "repos":
        parts[2:4] = ["{owner}", "{repo}"]
    out: list[str] = []
    for seg in parts:
        if out and out[-1] == "branches":
            out.append("{branch}")
            break
        if out and out[-1] == "labels":
            out.append("{label}")
            break
        out.append("{id}" if seg.isdigit() else "{sha}" if ROUTE_SHA.fullmatch(seg) else seg)
    names = sorted({p.split("=", 1)[0] for p in query.split("&") if p})
    return f"{method} {'/'.join(out)}" + ("?" + "&".join(names) if names else "")


def load_spend(doc: Any) -> dict[int, dict[str, list[int]]]:
    """SPEND_FILE's minutes, the well-formed rows only."""
    minutes = doc.get("minutes") if isinstance(doc, dict) else None
    out: dict[int, dict[str, list[int]]] = {}
    for minute, rows in (minutes if isinstance(minutes, dict) else {}).items():
        if not str(minute).isdigit() or not isinstance(rows, dict):
            continue
        for key, row in rows.items():
            if (isinstance(key, str) and isinstance(row, list) and len(row) == 3
                    and all(isinstance(n, int) and not isinstance(n, bool) and n >= 0 for n in row)):
                out.setdefault(int(minute), {})[key] = list(row)
    return out


SPEND_WAITERS_SHOWN = 3  # waiters named inside one restByCaller or graphqlByQuery row


def spend_summary(rows: list[dict], seconds: float = 3600.0, top: int = SPEND_TOP) -> dict:
    """The spend log's tables, most spent first: REST by route (with the caller that spent most on it), REST by
    route and caller, GraphQL by query and caller, and each bucket's totals."""
    rest = [r for r in rows if r["bucket"] == "rest"]
    gql = [r for r in rows if r["bucket"] == "graphql"]
    routes: dict[str, dict] = {}
    for r in rest:
        mine = routes.setdefault(r["name"], {"route": r["name"], "requests": 0, "counted": 0, "callers": {},
                                             "waiters": {}})
        mine["requests"] += r["requests"]
        mine["counted"] += r["counted"]
        who = f"{r['kind']} {r['repo']}".strip()
        mine["callers"][who] = mine["callers"].get(who, 0) + r["counted"]
        if r.get("waiter"):
            mine["waiters"][r["waiter"]] = mine["waiters"].get(r["waiter"], 0) + r["counted"]
    by_route = []
    for mine in routes.values():
        callers, waiters = mine.pop("callers"), mine.pop("waiters")
        lead = max(callers.items(), key=lambda kv: (kv[1], kv[0]), default=("", 0))
        held = max(waiters.items(), key=lambda kv: (kv[1], kv[0]), default=("", 0))
        by_route.append({**mine, "topCaller": lead[0], "topCallerCounted": lead[1], "callers": len(callers),
                         "topWaiter": held[0], "topWaiterCounted": held[1], "waiters": len(waiters)})
    def rank(r: dict, field: str) -> tuple:
        return (-r[field], -r["requests"], r.get("route") or r.get("name") or "", r.get("kind", ""), r.get("repo", ""))

    def by_caller(rows: list[dict], field: str) -> list[dict]:
        """ROWS merged per name, kind and repo before ranking, its waiters inside (most FIELD first): a key holds
        the waiter too, so twelve 1-point pr queries for twelve waiters were twelve rows, not one of 12 (#1931)."""
        merged: dict[tuple, dict] = {}
        for r in rows:
            row = merged.setdefault((r["name"], r["kind"], r["repo"]), {"name": r["name"], "kind": r["kind"],
                                                                         "repo": r["repo"], "requests": 0,
                                                                         field: 0, "waiters": {}})
            row["requests"] += r["requests"]
            row[field] += r[field]
            if r.get("waiter"):
                row["waiters"][r["waiter"]] = row["waiters"].get(r["waiter"], 0) + r[field]
        out = sorted(merged.values(), key=lambda r: rank(r, field))[:top]
        for row in out:
            row["waiters"] = [{"waiter": w, field: n} for w, n in
                              sorted(row["waiters"].items(), key=lambda kv: (-kv[1], kv[0]))[:SPEND_WAITERS_SHOWN]]
        return out
    return {"window": int(seconds),
            "rest": {"requests": sum(r["requests"] for r in rest), "counted": sum(r["counted"] for r in rest)},
            "graphql": {"queries": sum(r["requests"] for r in gql), "points": sum(r["points"] for r in gql)},
            "restByRoute": sorted(by_route, key=lambda r: rank(r, "counted"))[:top],
            "restByCaller": [{"route": r["name"], "kind": r["kind"], "repo": r["repo"], "requests": r["requests"],
                              "counted": r["counted"], "waiters": r["waiters"]} for r in by_caller(rest, "counted")],
            "graphqlByQuery": [{"query": r["name"], "kind": r["kind"], "repo": r["repo"], "queries": r["requests"],
                                "points": r["points"], "waiters": r["waiters"]} for r in by_caller(gql, "points")]}


def waiters_text(r: dict, field: str) -> str:
    """" for W1 5, W2 3" from a spend_summary row's top waiters."""
    shown = [f"{w.get('waiter')} {w.get(field, 0)}" for w in r.get("waiters") or [] if isinstance(w, dict)]
    return f" for {', '.join(shown)}" if shown else ""


def route_waiter(r: dict) -> str:
    """"; waiter W" for a restByRoute row whose reads were for a named waiter (spend_summary topWaiter)."""
    return f"; waiter {r['topWaiter']}" if r.get("topWaiter") else ""


def host_spenders(run: Callable[..., Any] = subprocess.run) -> tuple[list[dict], int | None]:
    """This host's top REST spenders on the shared login over the last hour (SPENDERS_CMD usage --json), with the REST
    all its callers spent: ([], None) when it cannot say. Each row is {caller, rest, graphql, source}."""
    try:
        done = run([SPENDERS_CMD, "usage", "--json"], capture_output=True, text=True, timeout=SPENDERS_TIMEOUT)
        if done.returncode != 0 or not (done.stdout or "").strip():
            return [], None  # it could not say: an empty answer is not "spent nothing" (#1936 review)
        rows = json.loads(done.stdout)
    except (OSError, subprocess.SubprocessError, ValueError):
        return [], None
    if not isinstance(rows, list):
        return [], None
    rows = [r for r in rows if isinstance(r, dict) and isinstance(r.get("rest"), int) and not isinstance(r["rest"], bool)
            and r["rest"] > 0]
    rows.sort(key=lambda r: (-r["rest"], str(r.get("caller"))))
    return ([{k: r.get(k) for k in ("caller", "rest", "graphql", "source")} for r in rows[:SPENDERS_TOP]],
            sum(r["rest"] for r in rows))


# The pool alarm names the REST no log on this host holds, once it is this share of what the pool spent and at least
# UNLOGGED_MIN. GitHub's limit is the login's, on every host signed in to it and every token of it: on 2026-11-10
# cosmic-gray's logs held about 64 of the pool's 180 a minute, and every alarm named only those.
UNLOGGED_SHARE = 0.25
UNLOGGED_MIN = 300
UNLOGGED_EARLY = 600  # a window younger than this is too early to measure (#1937 review)


def unlogged_text(limit: int | None, remaining: int | None, reset: float | None, now: float,
                  host_rest: int | None) -> tuple[str, int | None]:
    """(" At least G of the U REST ... ", G) for the REST no log on this host holds, else ("", None). Both sides
    cover the same requests, so a burst is not taken for a rate (#1936 review): U is what GitHub says the pool spent
    since its window opened (LIMIT - REMAINING, at most an hour back from RESET), and HOST_REST is every logged call
    on this host in the last hour, which holds that window. G = U - HOST_REST can only understate what is unlogged.
    NOW is read after the usage read: a long tick can cross RESET first (#1937 review)."""
    if host_rest is None or not isinstance(limit, int) or not isinstance(remaining, int) or reset is None:
        return "", None
    if reset <= now:  # the counter expired while usage ran: the host's hour has dropped requests it still counts
        return "", None
    since = max(0.0, min(3600.0, 3600.0 - (reset - now)))
    if since < UNLOGGED_EARLY:  # a fresh window has spent too little to compare: say so, never "nothing unlogged"
        return (f" Too early in GitHub's window ({since / 60:.0f} min old) to say how much REST no log on "
                f"{policy_host()} holds.", None)
    used = limit - remaining
    gap = used - host_rest
    if gap < UNLOGGED_MIN or gap < UNLOGGED_SHARE * used:
        return "", None
    return (f" At least {gap} of the {used} REST the pool spent in the last {since / 60:.0f} min ({gap / used:.0%}) is "
            f"in no log on {policy_host()}: other hosts signed in to this login (their `{Path(SPENDERS_CMD).name} "
            f"usage`), or its token used outside gh.", gap)


def spenders_text(rows: list[dict]) -> str:
    if not rows:
        return f"Top REST callers on {policy_host()}: unknown ({Path(SPENDERS_CMD).name} usage gave none); glaeda-gh budget."
    said = "; ".join(f"{r['caller']} {r['rest']}" + (f" ({r['source']})" if r.get("source") else "") for r in rows)
    return f"Top REST callers on {policy_host()}, last hour: {said}."


def waiter_of(e: dict) -> str:
    """The reader that read a watch entry last (the watch's `reader`), "" when none is named."""
    return e.get("reader") if isinstance(e.get("reader"), str) else ""


def waiters_of(entries: list[dict]) -> str:
    """The spend log's waiter of a batch: its one waiter, or how many there are."""
    names = sorted({waiter_of(e) for e in entries} - {""})
    return names[0] if len(names) == 1 else f"{len(names)} waiters" if names else ""


def caller_of(key: str) -> tuple[str, str]:
    """(watch kind, owner/repo) of a watch key, for the spend log."""
    try:
        kind, owner, repo, _ = split_key(key)
    except (ValueError, IndexError):
        return key.split(":", 1)[0] or "other", ""
    return kind, f"{owner}/{repo}"


def watch_dir() -> Path:
    return BASE / "watch"


def cache_dir() -> Path:
    return BASE / "cache"


def outbox_dir() -> Path:
    return BASE / "outbox"  # writes `post` queued, one file each, named by id (oldest first)


def posted_dir() -> Path:
    return BASE / "posted"  # finished writes: the URL, or why it failed (kept POST_KEEP)


def file_name(key: str) -> str:
    return hashlib.sha256(key.encode()).hexdigest()[:32] + ".json"


# A watch's mtime is its last read. A read within this long of the last touch leaves the file alone when nothing could
# tell the two apart: on cosmic-gray (2026-11-05) fseventsd held a 27 GB footprint while watch/ files were rewritten
# with the same bytes many times a minute. 5 s is noise against what reads the mtime: IDLE_BACKOFF_AFTER (300 s),
# TERMINAL_GRACE (120 s) and IDLE_EXPIRY (15 min). The one exact comparison, a reader newer than the cache's last
# fetch (Daemon.due), keeps its answer: the touch is skipped only while the mtime is already past every stamp the
# cache holds, so the comparison comes out the same with or without it (interest_fresh).
INTEREST_QUIET = 5.0


def interest_fresh(path: Path, key: str, now: float | None = None) -> bool:
    """Whether touching PATH (KEY's watch) now would change nothing a reader of its mtime decides: touched within
    INTEREST_QUIET and already newer than the cache's fetchedAt, dataAt and restAt."""
    try:
        mtime = path.stat().st_mtime
    except OSError:
        return False
    now = time.time() if now is None else now
    if not 0 <= now - mtime < INTEREST_QUIET:
        return False
    c = read_cache(key) or {}
    stamps = [c.get(k) for k in ("fetchedAt", "dataAt", "restAt")]
    return all(mtime > s for s in stamps if isinstance(s, (int, float)) and not isinstance(s, bool))


# Who keeps a watch read: each watch file names its readers ({"session:NAME" or "tool:NAME": last time}), so the
# spend log and the alarms can say which waiter a REST route is spent for. On 2026-11-10 the pool alarm named
# "pr manaflow-ai/cmux" behind pulls, check runs and job reads, and nothing said which of the dozens of sessions,
# lane VMs and reconcilers kept those PRs watched. A reader already named within READER_REFRESH is not written again,
# so a hot read stays a stat and a utime.
READER_REFRESH = 300.0
# ACPMUX_FROM and CMUX_AGENT_SESSION_ID are what `reach HOST CMD` exports on the far side of its ssh hop (the caller's
# session name, its harness session id, CMUX_AGENT_HOST its host): without them every wait an agent on another host
# ran through reach was tool:unknown (2026-11-11, huge-blue: claude-sr2-coord's waits from cosmic-gray, parent sshd).
READER_KEYS = ("ACPMUX_SESSION_NAME", "ACPMUX_FROM", "CMUX_AGENT_SESSION", "ACPMUX_SESSION_ID", "CMUX_AGENT_SESSION_ID",
               "CLAUDE_SESSION_ID", "CLAUDE_CODE_SESSION_ID", "CODEX_THREAD_ID", "CODEX_SESSION_ID")
# A helper names itself inside its session (session:NAME:agent:ID): GLAEDA_GH_AGENT, else CMUX_AGENT_NAME, else, for
# a subagent (Claude Code's AI_AGENT ends in _agent; it shares its parent's session variables) or a caller over
# reach, the checkout it works in (`wt new` gives each helper its own: .../checkouts/REPO/NAME). claude-sr2-coord's
# helpers all read as session:claude-sr2-coord, so a spend alarm could not tell which of a dozen helpers held a PR.
READER_AGENT_KEYS = ("GLAEDA_GH_AGENT", "CMUX_AGENT_NAME")
READER_ENV = READER_KEYS + READER_AGENT_KEYS + ("GLAEDA_GH_READER", "AI_AGENT", "CMUX_AGENT_HOST", "SSH_CLIENT")
READER_WRAPPERS = re.compile(r"(?i)(ba|z|da|)sh|python3?(\.\d+)?|env|xargs|timeout|nice|gh|glaeda-gh")
# A reader's name is written to watch files, spend logs, upstream requests and alarms, so it never carries command-line
# text: only a session's name or id, or an executable's or script's base name, each held to this shape. A parent
# `bash -c 'TOKEN=... python3 probe.py'` once gave the reader `tool:TOKEN=... python3 probe.py` (review, glaeda#1931).
READER_NAME = re.compile(r"[A-Za-z0-9._-]{1,64}")
# A reader handed in (GLAEDA_GH_READER, a downstream HOST/READER over the upstream): KIND:NAME parts of that shape.
READER_SAFE = re.compile(r"(?:[A-Za-z0-9._-]{1,64}/)?(?:session|tool):[A-Za-z0-9._-]{1,64}(?::agent:[A-Za-z0-9._-]{1,64})?")
_reader: str | None = None


def parent_command(pid: int) -> list[str]:
    """The words of process PID's command line ([] when it cannot be read): /proc on Linux, ps elsewhere."""
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        return [w for w in raw.decode(errors="replace").split("\0") if w]
    except OSError:
        pass
    try:
        done = subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True, timeout=2)
        return done.stdout.split()
    except (OSError, subprocess.SubprocessError):
        return []


def parent_pid(pid: int) -> int:
    try:
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("PPid:"):
                return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    try:
        done = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, timeout=2)
        return int(done.stdout.strip() or 0)
    except (OSError, subprocess.SubprocessError, ValueError):
        return 0


def safe_reader(text: Any) -> str:
    """TEXT when it is a reader name of the safe shape (READER_SAFE), else ""."""
    return text if isinstance(text, str) and READER_SAFE.fullmatch(text) else ""


def command_tool(words: list[str]) -> str:
    """The tool a command line runs: its executable's base name, or, behind an interpreter or wrapper, the next word's
    (the script) when it is a path rather than a flag; "" when that is a wrapper too or not of the READER_NAME shape.
    Nothing else of the command line is looked at, so no argument (an inline TOKEN=..., a -c program) is ever kept."""
    for word in words[:2]:
        name = Path(word).name
        if word.startswith("-") or not READER_NAME.fullmatch(name):
            return ""
        if not READER_WRAPPERS.fullmatch(name):
            return name
    return ""


def checkout_name(cwd: str) -> str:
    """The checkout CWD is in: NAME of a .../checkouts/REPO/NAME path (`wt new`), "" when it is in none."""
    parts = Path(cwd).parts
    for i in range(len(parts) - 2):
        if parts[i] == "checkouts" and READER_NAME.fullmatch(parts[i + 2]):
            return parts[i + 2]
    return ""


def reader_agent(remote: bool) -> str:
    """The helper inside a session that reads: GLAEDA_GH_AGENT or CMUX_AGENT_NAME, else, for a subagent or a caller
    over reach (REMOTE), its checkout's name, else "helper" for a subagent; "" for the session itself."""
    named = next((os.environ[k].strip() for k in READER_AGENT_KEYS if os.environ.get(k, "").strip()), "")
    if READER_NAME.fullmatch(named):
        return named
    sub = os.environ.get("AI_AGENT", "").strip().endswith("_agent")
    if not (sub or remote):
        return ""
    try:
        where = checkout_name(os.getcwd())
    except OSError:
        where = ""
    return where or ("helper" if sub else "")


def reader_host() -> str:
    """The host a caller over reach runs on (CMUX_AGENT_HOST, when it is not this one), else ""."""
    host = os.environ.get("CMUX_AGENT_HOST", "").strip().lower()
    here = {socket.gethostname().split(".")[0].lower(), policy_host()}
    return host if READER_NAME.fullmatch(host) and host not in here else ""


def reader_name() -> str:
    """This process's reader: GLAEDA_GH_READER, else its agent session (session:NAME, HOST/session:NAME for a caller
    over reach), with the helper inside it (session:NAME:agent:ID, reader_agent), else the first tool up its process
    tree that is not a shell, interpreter or wrapper (tool:pr_owner.py), else, over ssh, tool:ssh-from-ADDRESS, else
    tool:unknown. Worked out once per process, and always of the READER_SAFE shape."""
    global _reader
    if _reader is None:
        named = safe_reader(os.environ.get("GLAEDA_GH_READER", "").strip())
        session = next((os.environ[k].strip() for k in READER_KEYS if os.environ.get(k, "").strip()), "")
        _reader = named
        if not _reader and READER_NAME.fullmatch(session):
            host = reader_host()
            agent = reader_agent(bool(host))
            _reader = safe_reader(f"{host + '/' if host else ''}session:{session}{':agent:' + agent if agent else ''}")
        pid = os.getppid()
        for _ in range(4 if not _reader else 0):
            tool = command_tool(parent_command(pid))
            if tool and tool not in ("sshd", "sshd-session"):
                _reader = f"tool:{tool}"
                break
            pid = parent_pid(pid)
            if pid <= 1:
                break
        if not _reader:
            client = os.environ.get("SSH_CLIENT", "").split()
            _reader = safe_reader(f"tool:ssh-from-{client[0]}") if client else ""
        _reader = _reader or "tool:unknown"
    return _reader


def readers_of(doc: dict, now: float) -> dict[str, float]:
    """A watch file's readers still within IDLE_EXPIRY."""
    got = doc.get("readers") if isinstance(doc.get("readers"), dict) else {}
    return {str(k): float(v) for k, v in got.items()
            if isinstance(v, (int, float)) and not isinstance(v, bool) and now - v < IDLE_EXPIRY}


def reader_fresh(doc: dict, reader: str, now: float) -> bool:
    """Whether READER is the watch's latest reader already, named within READER_REFRESH: writing it again would change
    nothing waiter_of decides. Another reader in between makes it stale at once, so a read is never charged to a
    reader that came and went (A, then B, then A again: A is the latest)."""
    at = doc.get("readerAt")
    return doc.get("reader") == reader and isinstance(at, (int, float)) and not isinstance(at, bool) \
        and 0 <= now - at < READER_REFRESH


def touch_interest(key: str) -> None:
    """A read the cache answered still counts as interest: the watch's mtime is its last read (the daemon's idle
    backoff and IDLE_EXPIRY go by it). Only an existing watch is touched, and a failure costs nothing. A touch
    that would change nothing (interest_fresh) is skipped. A reader the watch has not named lately is added
    (register), so the spend log can say who the watch is read for."""
    path = watch_dir() / file_name(key)
    try:
        doc = read_json(path)
        if isinstance(doc, dict) and doc.get("key") == key and not reader_fresh(doc, reader_name(), time.time()):
            register(key)
            return
        if not interest_fresh(path, key):
            os.utime(path)
    except OSError:
        pass


def write_json(path: Path, doc: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{time.monotonic_ns()}.tmp")
    try:
        tmp.write_text(json.dumps(doc, sort_keys=True) + "\n")
        os.replace(tmp, path)
    except BaseException:
        # A write cut off (a full disk, or a deadline's exception raised into it) left its empty temporary file behind
        # for good: huge-blue's cache held dozens of zero-byte .budget.json.*.tmp files, some days old (2026-11-11).
        with contextlib.suppress(OSError):
            tmp.unlink()
        raise


def read_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def read_cache(key: str) -> dict | None:
    doc = read_json(cache_dir() / file_name(key))
    return doc if isinstance(doc, dict) and doc.get("key") == key else None


LOCK_WAIT = 2.0  # how long a read-modify-write waits for a sibling before giving up on the lock
LOCK_BUDGET = 2.0  # how long one gh call may spend waiting on all of these locks together
_lock_deadline: float | None = None


@contextlib.contextmanager
def lock_budget(seconds: float = LOCK_BUDGET):
    """Bound every bounded_lock inside this block to `seconds` *in total*.

    One brokered gh call takes three of these in sequence, so per-lock bounds multiplied: with all
    three held by a wedged sibling a call waited 6.16 s, measured. The waits are each individually
    reasonable and together are not, and what a caller cares about is when `gh` runs, which is one
    number. Nested blocks keep the tighter deadline; outside any block there is no budget, so the
    daemon's own use of these locks is unaffected."""
    global _lock_deadline
    previous = _lock_deadline
    _lock_deadline = time.monotonic() + seconds
    try:
        yield
    finally:
        _lock_deadline = previous


def extend_lock_budget(seconds: float) -> None:
    """Give the budget back time a deliberate wait spent. What it bounds is waiting on a sibling's
    lock; the repeat brake's 30 s is the broker working as intended, and spending the budget on it
    would leave the bookkeeping after it unlocked for no reason."""
    global _lock_deadline
    if _lock_deadline is not None:
        _lock_deadline += seconds


@contextlib.contextmanager
def bounded_lock(path: Path, seconds: float = LOCK_WAIT):
    """Hold `path` exclusively, or yield False after `seconds` rather than wait on it.

    These locks sit on the hot path of every `gh` call on the host, and what they protect is
    bookkeeping -- a repeat delay, a watch-promotion count, a registration. With LOCK_EX and no
    deadline, a single stuck holder was enough to stop `gh` running at all: with
    `.broker-seen.lock` held, `gh pr view 7 -R o/r --json state` was still blocked past a 20 s
    kill, never having reached the real gh. Everything else slow in this file is bounded
    (run_bounded, hard_deadline, DeadlineTimeout); these were the exception, in the one place
    whose contract is that it is never the reason a call fails."""
    try:
        handle = open(path, "a+")
    except OSError:
        yield False
        return
    held = False
    deadline = time.monotonic() + seconds
    if _lock_deadline is not None:
        deadline = min(deadline, _lock_deadline)
    try:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = True
                break
            except OSError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.02)
        yield held
    finally:
        with contextlib.suppress(OSError):
            if held:
                fcntl.flock(handle, fcntl.LOCK_UN)
            handle.close()


def register(key: str, jobs: bool = False, consumer: str | None = None, waited: bool = False,
             began: float | None = None, reader: str | None = None, at: dict | None = None, once: bool = False) -> None:
    """Record interest in `key`. Wanting jobs is sticky while any reader wants them. A head's readers
    are named consumers, each with the time it last asked. A wait marks the watch waitedAt: the daemon
    re-reads a waited run the controller may have lost the finish of (STALE_RUN_REREAD). A new wait passes its start
    (BEGAN, kept as waitBegan; a touch leaves it): the daemon makes one confirming read of a finished run for it.
    READER (default: this process's, reader_name) joins the watch's readers. AT (an upstream `read`, read_times) gives
    the downstream's own interest times, {"touched", "waitedAt", "asked"}: they stamp the watch, its wait and its
    consumer instead of now, so a downstream that polls the cache renews nothing past its own interest."""
    path = watch_dir() / file_name(key)
    watch_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    # read-modify-write: two sessions must not lose each other. Unheld, the write still happens --
    # losing a concurrent registration costs one watch, and waiting costs the gh call.
    with bounded_lock(watch_dir() / ".register.lock"):
        _register_locked(path, key, jobs, consumer, waited, began, reader, at or {}, once)


def stamp_at(now: float, given: Any, prior: Any = None) -> float:
    """A forwarded time (else now), never past now, and never older than PRIOR: interest only moves forward."""
    t = float(given) if isinstance(given, (int, float)) and not isinstance(given, bool) else now
    t = min(now, t)
    return max(t, float(prior)) if isinstance(prior, (int, float)) and not isinstance(prior, bool) else t


def _register_locked(path: Path, key: str, jobs: bool, consumer: str | None, waited: bool = False,
                     began: float | None = None, reader: str | None = None, at: dict | None = None,
                     once: bool = False) -> None:
    at = at or {}
    prior = read_json(path) or {}
    try:
        prior_mtime = path.stat().st_mtime if prior else None
    except OSError:
        prior_mtime = None
    doc: dict[str, Any] = {"key": key, "jobs": bool(jobs or prior.get("jobs"))}
    now = time.time()
    reader = safe_reader(reader) or reader_name()
    readers = readers_of(prior, now)
    if reader_fresh(prior, reader, now):
        doc["reader"], doc["readerAt"] = reader, prior["readerAt"]
    else:
        readers[reader] = now
        doc["reader"], doc["readerAt"] = reader, now
    doc["readers"] = readers
    if waited:
        doc["waitedAt"] = stamp_at(time.time(), at.get("waitedAt"), prior.get("waitedAt") if "waitedAt" in at else None)
    elif isinstance(prior.get("waitedAt"), (int, float)):
        doc["waitedAt"] = prior["waitedAt"]
    starts = [t for t in (began, prior.get("waitBegan")) if isinstance(t, (int, float)) and not isinstance(t, bool)]
    if starts:
        doc["waitBegan"] = max(starts)
    if consumer:
        asked = prior.get("consumers") if isinstance(prior.get("consumers"), dict) else {}
        now = time.time()
        stamp = stamp_at(now, at.get("asked"), asked.get(consumer) if "asked" in at else None)
        doc["consumers"] = {**{k: v for k, v in asked.items() if now - float(v or 0) < HEAD_INTEREST}, consumer: stamp}
    elif isinstance(prior.get("consumers"), dict):
        doc["consumers"] = prior["consumers"]
    # A one-off read's watch (ONCE: `status`) keeps when it was first asked for (since, Daemon.once_answered); asked
    # again ONCE_SPAN later it is a repeat reader's, and any other interest (a wait, the broker, a downstream, a
    # consumer) makes it an ordinary watch.
    if once and not prior:
        doc["since"] = time.time()
    elif once and isinstance(prior.get("since"), (int, float)) and not isinstance(prior.get("since"), bool):
        doc["since"] = prior["since"]
    if "touched" in at:
        # The downstream's own last interest, not this poll's: the watch (and IDLE_EXPIRY) ends when its does.
        touched = stamp_at(time.time(), at.get("touched"), prior_mtime)
        if doc != prior:
            write_json(path, doc)
        try:
            os.utime(path, (touched, touched))
        except OSError:
            pass
        return
    if doc == prior:
        # The same bytes again: the registration is only a read's interest, so refresh the mtime (or not even
        # that, interest_fresh) rather than replace the file through a temporary one.
        try:
            if not interest_fresh(path, key):
                os.utime(path)
            return
        except OSError:
            pass
    write_json(path, doc)


def terminal(kind: str, data: dict | None) -> bool:
    """Merged or closed PRs and completed runs; a comment watch never is (a reply can always come)."""
    if not data or kind == "comment":
        return False
    if kind == "head":
        return bool(data.get("settled"))
    return data.get("state") in {"MERGED", "CLOSED"} if kind == "pr" else data.get("status") == "completed"


def iso_epoch(text: str | None) -> float | None:
    try:
        return dt.datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def quick(started: str | None, completed: str | None) -> bool:
    """Finished within REFUSAL_SECONDS of starting: a job-start refusal, not a job that ran."""
    start, end = iso_epoch(started), iso_epoch(completed)
    return start is not None and end is not None and end - start <= REFUSAL_SECONDS


# ---------------------------------------------------------------- GitHub transport


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """urllib would copy the Authorization header to wherever a redirect points; refuse them all."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: ANN001
        return None


OPENER = urllib.request.build_opener(NoRedirect)


def error_site(error: BaseException) -> str:
    """Where `error` was raised: file, line and function only, never values, so a recurring error
    can be found without reproducing it."""
    frames = traceback.extract_tb(error.__traceback__)
    return f"{Path(frames[-1].filename).name}:{frames[-1].lineno} {frames[-1].name}" if frames else ""


def describe(error: BaseException) -> str:
    """Our own messages are safe to show; anything else is reduced to its type name."""
    return str(error) if isinstance(error, WatchError) else type(error).__name__


class DeadlineTimeout(TimeoutError):
    """A hard deadline passed (hard_deadline). A TimeoutError, so callers treat it as a slow answer."""


class ScanDeadline(Exception):
    """A hard deadline passed in a block whose own frames catch OSError (broker_local_repos's scan).

    Deliberately not a TimeoutError, because TimeoutError *is* an OSError: raised from SIGALRM into
    the scan, DeadlineTimeout landed in `except OSError: continue` around the glob and in
    git_config_text's `except (OSError, ValueError): return None`, which read it as "no config
    here" -- and setitimer is one-shot, so the rest of the scan then ran with no deadline at all.
    Measured with `.git/config` a FIFO nobody writes to, which is the hung-mount case the deadline
    was added for: git_config_text returned None 0.30s after the alarm, and a 20 000-checkout scan
    under a 0.05s deadline took 0.76s, silently dropped the one checkout whose read the alarm
    interrupted, and cached that incomplete map as complete for the whole TTL."""


@contextlib.contextmanager
def hard_deadline(seconds: float, error: type[BaseException] = DeadlineTimeout):
    """Raise `error` in the block once `seconds` of wall-clock time pass, even in the middle of a
    blocking read: a socket timeout only bounds each read, so a server that trickles bytes never
    trips it. Uses SIGALRM, so only on the main thread (the daemon's loop); elsewhere it does
    nothing and the watchdog still applies.

    `error` is a parameter because the exception has to be one the block's own handlers do not
    catch; see ScanDeadline."""
    if threading.current_thread() is not threading.main_thread() or not hasattr(signal, "setitimer"):
        yield
        return

    def expire(signum: int, frame: Any) -> None:
        raise error(f"no complete answer within {seconds:g}s")

    previous = signal.signal(signal.SIGALRM, expire)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def http(method: str, url: str, headers: dict[str, str], body: bytes | None = None) -> tuple[int, dict, bytes]:
    if not url.startswith(API + "/"):
        raise WatchError("refusing a request outside api.github.com")
    request = urllib.request.Request(url, data=body, method=method, headers=headers)
    try:
        with hard_deadline(HTTP_DEADLINE):
            try:
                with OPENER.open(request, timeout=SOCKET_TIMEOUT) as response:
                    return response.status, {k.lower(): v for k, v in response.headers.items()}, response.read(MAX_BODY)
            except urllib.error.HTTPError as error:  # 304, refused redirects and every 4xx/5xx land here
                return error.code, {k.lower(): v for k, v in (error.headers or {}).items()}, error.read(MAX_BODY)
    except (OSError, HTTPException, ValueError) as error:  # DeadlineTimeout is a TimeoutError, an OSError
        raise WatchError(f"request failed: {type(error).__name__}") from None


def run_bounded(argv: list[str], timeout: float | None = None, input_text: str | None = None) -> subprocess.CompletedProcess:
    """subprocess.run(capture_output=True, text=True) with a deadline that holds. On a timeout run()
    kills only the child and then waits for its pipes, which a grandchild that inherited them keeps
    open for as long as it lives. Here the child leads its own process group and the whole group is
    killed. Raises subprocess.TimeoutExpired or OSError."""
    timeout = SUBPROCESS_DEADLINE if timeout is None else timeout
    with subprocess.Popen(argv, stdin=subprocess.DEVNULL if input_text is None else subprocess.PIPE,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True) as proc:
        try:
            out, err = proc.communicate(input=input_text, timeout=timeout)
        except subprocess.TimeoutExpired:
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, signal.SIGKILL)
            with contextlib.suppress(OSError):  # a child that left its group; Popen.__exit__ waits for it
                proc.kill()
            with contextlib.suppress(subprocess.TimeoutExpired, OSError, ValueError):
                proc.communicate(timeout=2)
            for stream in (proc.stdout, proc.stderr):  # a grandchild that left the group still holds them
                with contextlib.suppress(OSError):
                    stream.close()
            raise subprocess.TimeoutExpired(argv, timeout) from None
    return subprocess.CompletedProcess(argv, proc.returncode, out, err)


def find_gh() -> str | None:
    """gh on PATH, else where Homebrew and distributions put it: a LaunchAgent's PATH is minimal."""
    for candidate in (shutil.which("gh"), os.fspath(Path.home() / ".local/bin/gh"), "/opt/homebrew/bin/gh",
                      "/usr/local/bin/gh", "/usr/bin/gh"):
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


def gh_token() -> str:
    gh = find_gh()
    if gh is None:
        raise WatchError("gh not found")
    try:
        result = run_bounded([gh, "auth", "token", "--hostname", "github.com"])
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WatchError(f"gh auth token: {type(error).__name__}") from None
    token = result.stdout.strip()
    if result.returncode != 0 or not token:  # neither stream is repeated: stdout may be a token
        raise WatchError(f"gh auth token exited {result.returncode}; is gh signed in?")
    if not TOKEN_RE.fullmatch(token):
        raise WatchError("gh auth token printed something that is not a GitHub token")
    return token


# ---------------------------------------------------------------- upstream (a host with no login)


def upstream_command() -> list[str] | None:
    """The upstream program from UPSTREAM_CONFIG, or None (read GitHub with this host's own login)."""
    doc = read_json(UPSTREAM_CONFIG)
    command = doc.get("command") if isinstance(doc, dict) else None
    if isinstance(command, list) and command and all(isinstance(a, str) and a for a in command):
        return command
    return None


def run_upstream(command: list[str], request: dict) -> dict:
    exe = command[0] if "/" in command[0] else shutil.which(command[0]) or os.fspath(Path.home() / ".local/bin" / command[0])
    try:
        result = run_bounded([exe, *command[1:]], UPSTREAM_DEADLINE, input_text=json.dumps(request) + "\n")
    except subprocess.TimeoutExpired:
        raise WatchError(f"upstream: no answer within {UPSTREAM_DEADLINE}s") from None
    except OSError as error:
        raise WatchError(f"upstream: {type(error).__name__} running {command[0]}") from None
    try:
        answer = json.loads(result.stdout.strip().splitlines()[-1]) if result.stdout.strip() else None
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        tail = (result.stderr or "").strip().splitlines()[-1:] or [f"exit {result.returncode}"]
        raise WatchError(f"upstream: {command[0]}: {tail[0]}"[:UPSTREAM_ERROR_MAX])
    return answer


def read_request(text: str) -> list[tuple[str, bool, bool, str | None]]:
    """The (key, jobs, wait, consumer) of each key in one upstream request line; WatchError on anything else. `wait`
    (optional) says a wait downstream is blocked on the key, so this host's daemon treats it as waited
    (STALE_RUN_REREAD). A head key must name the `consumer` its read is charged to (as `checks --consumer`): this
    host's daemon reads it within that consumer's head budget, never on an unnamed one. `reader` (optional,
    HOST/READER) names the downstream waiter; read_readers gives it."""
    try:
        doc = json.loads(text)
    except ValueError:
        raise WatchError("read takes one JSON line on stdin: {\"keys\": [{\"key\": ..., \"jobs\": ...}]}") from None
    keys = doc.get("keys") if isinstance(doc, dict) else None
    if not isinstance(keys, list) or len(keys) > UPSTREAM_MAX_KEYS:
        raise WatchError(f"read takes a list of at most {UPSTREAM_MAX_KEYS} keys")
    out = []
    for item in keys:
        key = item.get("key") if isinstance(item, dict) else None
        jobs = item.get("jobs", False) if isinstance(item, dict) else None
        wait = item.get("wait", False) if isinstance(item, dict) else None
        consumer = item.get("consumer") if isinstance(item, dict) else None
        kind = key.split(":", 1)[0] if isinstance(key, str) else None
        if kind not in UPSTREAM_KINDS or not isinstance(jobs, bool) or not isinstance(wait, bool):
            raise WatchError(f"read serves {', '.join(UPSTREAM_KINDS)} keys, not {str(key)[:80]!r}")
        target = key.split(":", 1)[1]
        form = rf"{NAME}/{NAME}@[0-9a-f]{{40}}" if kind == "head" else rf"{NAME}/{NAME}[#/]\d+"
        if not re.fullmatch(form, target) or parse_key(kind, target) != key:
            raise WatchError(f"not a key: {key[:80]!r}")
        if kind != "head":
            consumer = None
        elif not isinstance(consumer, str) or not CONSUMER_RE.fullmatch(consumer):
            raise WatchError(f"a head key needs a consumer (a short name: letters, digits, . _ -): {key[:80]!r}")
        out.append((key, jobs, wait, consumer))
    return out


def read_readers(text: str) -> dict[str, str]:
    """{key: reader} of an upstream request line that read_request accepted: each item's `reader`, when it names one."""
    out = {}
    for item in json.loads(text).get("keys") or []:
        reader = safe_reader(item.get("reader") if isinstance(item, dict) else None)
        if reader and isinstance(item.get("key"), str):
            out[item["key"]] = reader
    return out


def read_times(text: str) -> dict[tuple[str, str | None], dict[str, float]]:
    """{(key, consumer): {"touched", "waitedAt", "asked"}} of an upstream request line that read_request accepted:
    the downstream's own interest times for each line, the numbers it gave (register's AT)."""
    out = {}
    for item in json.loads(text).get("keys") or []:
        if not isinstance(item, dict) or not isinstance(item.get("key"), str):
            continue
        times = {k: float(item[k]) for k in ("touched", "waitedAt", "asked")
                 if isinstance(item.get(k), (int, float)) and not isinstance(item.get(k), bool) and math.isfinite(item[k])}
        consumer = item.get("consumer") if isinstance(item.get("consumer"), str) else None
        out[(item["key"], consumer)] = times
    return out


def cmd_read(text: str) -> int:
    """`read`: register each key (sessions' interest, as `status` does) and print what the cache holds
    now, never waiting and never reading GitHub. The other end of an upstream (UPSTREAM_CONFIG)."""
    items = read_request(text)
    readers = read_readers(text)
    times = read_times(text)
    if not daemon_running(grace=DOWN_GRACE):
        print(json.dumps({"error": "glaeda-gh is not running on the upstream host"}))
        return EXIT_DOWN
    broken = daemon_failing()
    if broken is not None:
        print(json.dumps({"error": failing_message(broken)[:UPSTREAM_ERROR_MAX]}))
        return EXIT_DOWN
    entries: dict[str, Any] = {}
    ledger = None
    for key, jobs, wait, consumer in items:
        # A head is registered under its consumer, as `checks` does: the daemon reads it charged to that consumer's
        # head budget (due_heads, head_allowed), or leaves it to the cache and marks the consumer denied.
        register(key, jobs, consumer=consumer, waited=wait, reader=readers.get(key), at=times.get((key, consumer)))
        cached = read_cache(key)
        budgets = (entries.get(key) or {}).get("budgets") or {}  # an earlier line's consumers, for this same key
        entries[key] = None if cached is None else {
            k: cached.get(k) for k in ("data", "dataAt", "error", "fetchedAt", "jobs", "missing", "restRun", "restRunAt") if k in cached}
        if cached is not None and cached.get("source"):  # where the data came from, so a downstream wait can
            entries[key]["origin"] = cached.get("origin") if cached.get("source") == "upstream" else cached["source"]
        if consumer:
            if ledger is None:
                doc = read_json(BASE / CONSUMERS_FILE)
                ledger = doc.get("consumers") if isinstance(doc, dict) and isinstance(doc.get("consumers"), dict) else {}
            mine = ledger.get(consumer) if isinstance(ledger.get(consumer), dict) else {}
            # each asking consumer's head budget here, so a downstream `checks` can say "budget spent" for every
            # consumer refused, not only the last one asked (upstream_denials)
            budgets[consumer] = {k: mine.get(k) for k in ("spent", "limit", "deniedAt")}
            entries[key] = {**(entries[key] or {}), "budgets": budgets}
    print(json.dumps({"entries": entries}, sort_keys=True))
    return EXIT_OK


# ---------------------------------------------------------------- cmux build controller


class OutOfTime(Exception):
    """This tick spent TICK_BUDGET: the entries it did not reach go first on the next tick. Not a
    WatchError, so no reader stores it as an entry's error."""


class NoReceiver(WatchError):
    """The controller answers but serves no run events (not deployed there, or not configured)."""


class Controller:
    """The build controller's GitHub events (cmuxterm-hq#675) over the tailnet: no GitHub quota.
    Without a token it answers for public repositories only."""

    def __init__(self, base: str, token: str | None) -> None:
        self.base, self.token = base.rstrip("/"), token

    @classmethod
    def from_env(cls) -> "Controller | None":
        base = os.environ.get("CMUX_CI_CONTROLLER", "").strip()
        if not base:
            doc = read_json(CONTROLLER_CONFIG)
            base = (doc.get("controller") if isinstance(doc, dict) else None) or CONTROLLER_DEFAULT
        if not isinstance(base, str) or not base.startswith(("http://", "https://")):
            return None
        path = os.environ.get("CMUX_CI_TOKEN_FILE") or os.fspath(CONTROLLER_TOKEN)
        try:
            token = Path(path).read_text().strip() or None
        except (OSError, ValueError):  # ValueError: a token file that is not UTF-8
            token = None
        return cls(base, token)

    def get(self, path: str, timeout: float | None = None) -> dict:
        """One JSON answer. Raises NoReceiver (404, 503) or WatchError."""
        headers = {"Authorization": f"Bearer {self.token}"} if self.token else {}
        request = urllib.request.Request(self.base + path, headers=headers)
        try:
            budget = CONTROLLER_TIMEOUT if timeout is None else timeout
            deadline = CONTROLLER_DEADLINE if timeout is None else timeout + CONTROLLER_DEADLINE
            with hard_deadline(deadline), OPENER.open(request, timeout=budget) as response:
                doc = json.loads(response.read(MAX_BODY))
        except urllib.error.HTTPError as error:
            if error.code in {404, 503}:
                raise NoReceiver(f"controller HTTP {error.code}") from None
            raise WatchError(f"controller HTTP {error.code}") from None
        except (OSError, HTTPException, ValueError) as error:
            raise WatchError(f"controller: {type(error).__name__}") from None
        if not isinstance(doc, dict):
            raise WatchError("controller: not a JSON object")
        return doc

    def run(self, run_id: int, wait: int = 0) -> dict | None:
        """The controller's view of a run, optionally long-polling until it changes state."""
        if not isinstance(wait, int) or not 0 <= wait <= CONTROLLER_RUN_MAX_WAIT:
            raise WatchError(f"controller run wait must be 0..{CONTROLLER_RUN_MAX_WAIT} seconds")
        timeout = CONTROLLER_TIMEOUT if wait == 0 else wait + CONTROLLER_TIMEOUT
        doc = self.get(f"/v1/github/runs/{int(run_id)}?wait={wait}", timeout=timeout)
        run = doc.get("run")
        return run if doc.get("known") and isinstance(run, dict) else None

    def events(self, since: int | None) -> dict:
        """The change feed after cursor `since`, or only the current cursor when since is None."""
        doc = self.get("/v1/github/events?since=" + ("latest" if since is None else str(int(since))))
        if not isinstance(doc.get("cursor"), int) or doc["cursor"] < 0:
            raise WatchError("controller: feed without a cursor")
        return doc


def controller_run(run: dict) -> dict:
    """The controller's run record in slim_run's shape."""
    return {"id": run.get("id"), "name": run.get("name"), "display_title": None, "status": run.get("status"),
            "conclusion": run.get("conclusion") or None, "html_url": run.get("url"), "head_sha": run.get("head_sha"),
            "head_branch": run.get("head_branch") or "", "event": run.get("event"), "run_attempt": run.get("attempt"),
            "created_at": None, "updated_at": run.get("updated_at")}


# ---------------------------------------------------------------- GraphQL for PRs


def pr_query(keys: list[str], kind: str = "pr") -> tuple[str, dict]:
    """One aliased query for every PR (or issue's comments) in `keys`, plus the rate limit. Names
    travel as variables. PRs are aliased p0, p1, ...; comment watches c0, c1, ..."""
    decls, parts, variables = [], [], {}
    for i, key in enumerate(keys):
        _, owner, repo, number = split_key(key)
        decls.append(f"$o{i}: String!, $r{i}: String!, $n{i}: Int!")
        if kind in ("pr", "probe"):
            fields = PR_FIELDS.replace("NUM", f"$n{i}") if kind == "pr" else PR_PROBE_FIELDS
            parts.append(f"p{i}: repository(owner: $o{i}, name: $r{i}) {{ pullRequest(number: $n{i}) {{ {fields} }} }}")
        else:
            parts.append(f"c{i}: repository(owner: $o{i}, name: $r{i}) {{ issueOrPullRequest(number: $n{i}) "
                         f"{{ {ISSUE_FIELDS} }} }}")
        variables.update({f"o{i}": owner, f"r{i}": repo, f"n{i}": number})
    query = f"query({', '.join(decls)}) {{ rateLimit {{ limit remaining resetAt cost }} {' '.join(parts)} }}"
    return query, variables


def run_query(keys: list[str]) -> tuple[str, dict]:
    """One aliased query for every run in `keys` (w0, w1, ...), by URL, plus the rate limit."""
    decls, parts, variables = [], [], {}
    for i, key in enumerate(keys):
        _, owner, repo, run_id = split_key(key)
        decls.append(f"$u{i}: URI!")
        parts.append(f"w{i}: resource(url: $u{i}) {{ {RUN_FIELDS} }}")
        variables[f"u{i}"] = f"https://github.com/{owner}/{repo}/actions/runs/{run_id}"
    query = f"query({', '.join(decls)}) {{ rateLimit {{ limit remaining resetAt cost }} {' '.join(parts)} }}"
    return query, variables


def graphql_run(node: dict) -> dict:
    """A WorkflowRun node in slim_run's shape (REST's lowercase status and conclusion)."""
    suite = node.get("checkSuite") or {}
    return {"id": node.get("databaseId"), "name": (node.get("workflow") or {}).get("name"),
            "display_title": node.get("displayTitle"), "status": str(suite.get("status") or "").lower() or None,
            "conclusion": str(suite.get("conclusion") or "").lower() or None, "html_url": node.get("url"),
            "head_sha": (suite.get("commit") or {}).get("oid"), "head_branch": (suite.get("branch") or {}).get("name") or "",
            "event": node.get("event"), "run_attempt": node.get("runAttempt"), "created_at": node.get("createdAt"),
            "updated_at": node.get("updatedAt")}


def upper(value: Any) -> str | None:
    return str(value).upper() if value else None


def slim_pull(doc: dict) -> dict:
    keep = ("number", "html_url", "title", "state", "draft", "merged", "merged_at", "mergeable", "mergeable_state",
            "updated_at")
    head, base = doc.get("head") or {}, doc.get("base") or {}
    return {**{k: doc.get(k) for k in keep}, "head": {"sha": head.get("sha"), "ref": head.get("ref")},
            "base": {"ref": base.get("ref")}}


def slim_check_runs(doc: dict) -> dict:
    keep = ("id", "node_id", "name", "status", "conclusion", "details_url", "started_at", "completed_at")
    return {"total_count": doc.get("total_count"),
            "check_runs": [{**{k: c.get(k) for k in keep}, "suite": (c.get("check_suite") or {}).get("id"),
                            "app": (c.get("app") or {}).get("slug")}
                           for c in doc.get("check_runs") or [] if isinstance(c, dict)]}


def slim_statuses(doc: dict) -> list[dict]:
    return [{k: c.get(k) for k in ("context", "state", "target_url", "created_at")}
            for c in doc.get("statuses") or [] if isinstance(c, dict)]


def slim_status_page(doc: dict) -> dict:
    """One page of a commit's combined status, with the total it says there is."""
    return {"total": doc.get("total_count"), "statuses": slim_statuses(doc)}


def slim_head_runs_page(doc: dict) -> dict:
    """One page of a commit's workflow runs, with the total it says there is."""
    return {"total": doc.get("total_count"), "runs": slim_head_runs(doc)}


def slim_head_runs(doc: dict) -> list[dict]:
    return [{k: r.get(k) for k in ("id", "name", "workflow_id", "check_suite_id", "conclusion")}
            for r in doc.get("workflow_runs") or [] if isinstance(r, dict)]


# A dispatched run names the commit it tests in its run-name as OWNER/REPO@<40 hex>: its own head_sha is the
# dispatch ref's tip (main), never that commit (manaflow-ai/cmux fast-checks.yml). Full ids only, with the repo.
NAMED_COMMIT = re.compile(r"(?<![\w./-])([\w.-]+/[\w.-]+)@([0-9a-fA-F]{40})(?![0-9a-zA-Z])")


def names_commit(title: Any, repo: str, sha: str | None) -> bool:
    """Whether a run-name names `sha` of `repo` (OWNER/REPO) as the commit the run tests. A full 40-hex id only:
    a prefix never matches, and neither does another repo's commit or a bare sha (fast-checks' snapshot id)."""
    if not sha or not re.fullmatch(r"[0-9a-f]{40}", sha.lower()):
        return False
    return (repo.lower(), sha.lower()) in {(r.lower(), c.lower()) for r, c in NAMED_COMMIT.findall(str(title or ""))}


def run_tests_commit(data: dict, repo: str, sha: str | None) -> bool:
    """A workflow_dispatch run whose run-name names `sha` of `repo` (names_commit): the commit it tested."""
    return data.get("event") == "workflow_dispatch" and names_commit(data.get("display_title"), repo, sha)


def slim_workflows(doc: dict) -> dict[str, str]:
    """Workflow id -> name. A run's own REST name is its run-name when the workflow sets one."""
    return {str(w.get("id")): str(w.get("name")) for w in doc.get("workflows") or [] if isinstance(w, dict)}


def slim_rules(doc: Any) -> list[str]:
    """The required checks a branch's rulesets name (GET .../rules/branches/B answers a list)."""
    names = set()
    for rule in doc if isinstance(doc, list) else []:
        if isinstance(rule, dict) and rule.get("type") == "required_status_checks":
            for item in (rule.get("parameters") or {}).get("required_status_checks") or []:
                if isinstance(item, dict) and item.get("context"):
                    names.add(str(item["context"]))
    return sorted(names)


def slim_branch(doc: dict) -> list[str]:
    """The required checks a branch's classic protection names."""
    checks = (doc.get("protection") or {}).get("required_status_checks") or {}
    names = {str(c) for c in checks.get("contexts") or []}
    names |= {str(c["context"]) for c in checks.get("checks") or [] if isinstance(c, dict) and c.get("context")}
    return sorted(names)


def slim_issue(doc: dict) -> dict:
    pull = doc.get("pull_request")
    return {"html_url": doc.get("html_url"), "state": doc.get("state"), "comments": doc.get("comments") or 0,
            "pull": isinstance(pull, dict), "merged": bool((pull or {}).get("merged_at"))}


def slim_comments(doc: Any) -> list[dict]:
    """An issue's REST comments in the GraphQL comment shape parse_comments reads (REST names an App's
    account `NAME[bot]`, GraphQL `NAME`)."""
    return [{"databaseId": c.get("id"), "url": c.get("html_url"), "createdAt": c.get("created_at"),
             # REST has no lastEditedAt; updated_at past created_at is an edit (the outbox's status edits)
             **({"lastEditedAt": c["updated_at"]} if c.get("updated_at") and c.get("updated_at") != c.get("created_at")
                else {}),
             "author": {"login": re.sub(r"\[bot\]$", "", str((c.get("user") or {}).get("login") or ""))},
             "body": str(c.get("body") or "")[:COMMENT_BODY_MAX]}
            for c in doc if isinstance(c, dict)] if isinstance(doc, list) else []


def rest_issue_node(issue: dict, comments: list[dict]) -> dict:
    """The REST answers in the GraphQL issueOrPullRequest shape."""
    state = "MERGED" if issue.get("merged") else str(issue.get("state") or "").upper() or None
    return {"__typename": "PullRequest" if issue.get("pull") else "Issue", "url": issue.get("html_url"),
            "state": state, "comments": {"totalCount": issue.get("comments"), "nodes": comments[-COMMENTS_LAST:]}}


def rest_contexts(checks: dict, statuses: list[dict], runs: list[dict], required: set[str],
                  workflows: dict[str, str] | None = None) -> list[dict]:
    """A commit's REST check runs and statuses as GraphQL statusCheckRollup context nodes."""
    suites = {r.get("check_suite_id"): r for r in runs}
    workflows = workflows or {}
    nodes: list[dict] = []
    for c in checks.get("check_runs") or []:
        run = suites.get(c.get("suite"))
        nodes.append({"__typename": "CheckRun", "id": c.get("node_id"), "name": c.get("name"),
                      "status": upper(c.get("status")), "conclusion": upper(c.get("conclusion")),
                      "detailsUrl": c.get("details_url"), "databaseId": c.get("id"), "startedAt": c.get("started_at"),
                      "completedAt": c.get("completed_at"), "isRequired": c.get("name") in required,
                      "checkSuite": {"conclusion": upper(run.get("conclusion")), "app": {"slug": c.get("app")},
                                     "workflowRun": {
                          "databaseId": run.get("id"), "workflow": {
                              "name": workflows.get(str(run.get("workflow_id"))) or run.get("name"),
                                                                    "databaseId": run.get("workflow_id")}}}
                      if run else {"conclusion": None, "app": {"slug": c.get("app")}, "workflowRun": None}})
    for c in statuses:
        nodes.append({"__typename": "StatusContext", "context": c.get("context"), "state": upper(c.get("state")),
                      "targetUrl": c.get("target_url"), "createdAt": c.get("created_at"),
                      "isRequired": c.get("context") in required})
    return nodes


def rest_pr_node(pull: dict, checks: dict, statuses: list[dict], runs: list[dict], required: set[str],
                 review: str | None = None, workflows: dict[str, str] | None = None) -> dict:
    """The REST answers in the GraphQL pullRequest shape, so parse_pr reads both alike."""
    nodes = rest_contexts(checks, statuses, runs, required, workflows)
    rollup = None
    if nodes:
        results = [n.get("conclusion") if n["__typename"] == "CheckRun" else n.get("state") for n in nodes]
        pending = any(n["__typename"] == "CheckRun" and n.get("status") != "COMPLETED" or
                      n["__typename"] == "StatusContext" and n.get("state") in {"PENDING", "EXPECTED"} for n in nodes)
        truncated = (checks.get("total_count") or 0) > len(checks.get("check_runs") or [])
        # GraphQL's rollup state covers every check; ours covers only what was read, so a truncated
        # list is never called green
        state = ("FAILURE" if any(r in FAILED for r in results) else "PENDING" if pending or truncated
                 else "SUCCESS")
        total = (checks.get("total_count") or 0) + len(statuses)
        rollup = {"state": state, "contexts": {"totalCount": max(total, len(nodes)),
                                               "pageInfo": {"hasNextPage": truncated}, "nodes": nodes}}
    head = pull.get("head") or {}
    state = "OPEN" if pull.get("state") == "open" else "MERGED" if pull.get("merged") else "CLOSED"
    mergeable = {True: "MERGEABLE", False: "CONFLICTING"}.get(pull.get("mergeable"), "UNKNOWN")
    return {"number": pull.get("number"), "url": pull.get("html_url"), "title": pull.get("title"), "state": state,
            "isDraft": bool(pull.get("draft")), "merged": bool(pull.get("merged")), "mergedAt": pull.get("merged_at"),
            "mergeable": mergeable, "mergeStateStatus": upper(pull.get("mergeable_state")) or "UNKNOWN",
            "headRefOid": head.get("sha"), "headRefName": head.get("ref"), "reviewDecision": review,
            "updatedAt": pull.get("updated_at"),
            "baseRef": {"branchProtectionRule": {"requiredStatusCheckContexts": sorted(required)}, "rules": {"nodes": []}},
            "commits": {"nodes": [{"commit": {"statusCheckRollup": rollup}}]}}


def parse_comments(node: dict) -> dict:
    comments = node.get("comments") or {}
    return {"url": node.get("url"), "state": node.get("state"), "type": node.get("__typename"),
            "total": comments.get("totalCount"),
            "comments": [{"id": c.get("databaseId"), "url": c.get("url"), "createdAt": c.get("createdAt"),
                          **({"editedAt": c["lastEditedAt"]} if c.get("lastEditedAt") else {}),
                          "author": (c.get("author") or {}).get("login"),
                          "body": str(c.get("body") or "")[:COMMENT_BODY_MAX]}
                         for c in comments.get("nodes") or [] if c]}


def brief(check: dict) -> dict:
    return {k: check.get(k) for k in ("name", "workflow", "conclusion", "required", "url")}


def outranks(new: dict, new_order: tuple, old: dict, old_order: tuple) -> bool:
    """Whether `new` replaces `old`, a check of the same workflow and name. Mostly the newer attempt, but a
    job can have a same-named twin in its own run (the compile routed to one runner, its skipped twin on
    another): a job that ran beats a skipped one, and a queued or running job is never replaced by a
    cancelled one, since a newer attempt only starts once the older one has finished."""
    skipped = [(c.get("conclusion") or "").upper() == "SKIPPED" for c in (new, old)]
    if skipped[0] != skipped[1]:
        return skipped[1]
    live = [c.get("status") not in {"COMPLETED", None} for c in (new, old)]
    cancelled = [(c.get("conclusion") or "").upper() == "CANCELLED" for c in (new, old)]
    if live[1] and cancelled[0]:
        return False
    if live[0] and cancelled[1]:
        return True
    return new_order >= old_order


def pr_fingerprint(node: dict | None) -> str | None:
    """What a PR node says that a verdict or a wait reads, as one string: its state, mergeability, head and review, its
    rollup's state, and its check runs and statuses counted by state, and its suite count. The same from the full read
    and from PR_PROBE. None when the counts are missing (a node from REST, or an answer without them): never probed."""
    if not isinstance(node, dict):
        return None
    commits = (node.get("commits") or {}).get("nodes") if isinstance(node.get("commits"), dict) else None
    commit = ((commits or [{}])[0] or {}).get("commit") if isinstance(commits, list) else None
    if not isinstance(commit, dict):
        return None
    rollup = commit.get("statusCheckRollup")
    contexts = rollup.get("contexts") if isinstance(rollup, dict) else None
    suites = commit.get("checkSuites")
    if rollup is not None and not (isinstance(contexts, dict) and isinstance(contexts.get("checkRunCountsByState"), list)
                                   and isinstance(contexts.get("statusContextCountsByState"), list)):
        return None
    if not isinstance(suites, dict) or not isinstance(suites.get("totalCount"), int):
        return None

    def counts(rows: Any) -> list:
        return sorted((str(r.get("state")), r.get("count")) for r in rows or [] if isinstance(r, dict) and r.get("count"))

    return json.dumps([node.get(k) for k in ("state", "isDraft", "merged", "mergeable", "mergeStateStatus",
                                             "headRefOid", "reviewDecision")]
                      + [None if rollup is None else rollup.get("state"),
                         None if contexts is None else contexts.get("totalCount"),
                         None if contexts is None else counts(contexts.get("checkRunCountsByState")),
                         None if contexts is None else counts(contexts.get("statusContextCountsByState")),
                         suites.get("totalCount")], sort_keys=True)


def drop_null_contexts(node: dict) -> int:
    """Remove the null (or non-object) context nodes from a PR node's rollup, in place; how many there were. A null
    node is a context GitHub failed to read: the rollup is partial, so the caller marks it (checksPageError)."""
    commits = (node.get("commits") or {}).get("nodes") if isinstance(node.get("commits"), dict) else None
    commit = ((commits or [{}])[0] or {}).get("commit") if isinstance(commits, list) else None
    rollup = commit.get("statusCheckRollup") if isinstance(commit, dict) else None
    contexts = rollup.get("contexts") if isinstance(rollup, dict) else None
    nodes = contexts.get("nodes") if isinstance(contexts, dict) else None
    if not isinstance(nodes, list):
        return 0
    kept = [c for c in nodes if isinstance(c, dict)]
    contexts["nodes"] = kept
    return len(nodes) - len(kept)


def null_contexts_error(count: int) -> str:
    return f"graphql: {count} check context{'s' if count != 1 else ''} came back null (a partial rollup)"


def parse_pr(node: dict) -> dict:
    commits = ((node.get("commits") or {}).get("nodes") or [{}])
    rollup = ((commits[0] or {}).get("commit") or {}).get("statusCheckRollup") or {}
    contexts = rollup.get("contexts") or {}
    latest: dict[str, tuple[tuple, dict]] = {}
    superseded: list[dict] = []  # replaced by a newer attempt or run; GitHub's rollup still counts them
    # GitHub answers a context it failed to resolve as null beside an error. One such node raised AttributeError here,
    # which batched() swallowed for the whole batch: up to GQL_BATCH PRs kept their old data, with no error stored,
    # for as long as GitHub kept answering it (huge-blue 2026-11-11: a merged PR read OPEN for 50 minutes).
    # fetch_aliased marks such a PR partial (drop_null_contexts); this only keeps the parse total.
    nodes = [c for c in contexts.get("nodes") or [] if isinstance(c, dict)]
    # A run the concurrency group cancelled for a newer run of the same workflow on this commit
    # leaves failed checks (ci-status: cancelled) that the newer run replaces when it gets there.
    def workflow_run(c: dict) -> tuple[object, int]:
        run = (c.get("checkSuite") or {}).get("workflowRun") or {}
        workflow = run.get("workflow") or {}
        return workflow.get("databaseId") or workflow.get("name"), run.get("databaseId") or 0

    newest: dict[object, int] = {}
    for c in nodes:
        workflow, run_id = workflow_run(c)
        if workflow and run_id:
            newest[workflow] = max(newest.get(workflow, 0), run_id)
    for c in nodes:
        workflow_key, run_id = workflow_run(c)
        if c.get("__typename") == "StatusContext":
            state = c.get("state")
            done = state in {"SUCCESS", "FAILURE", "ERROR"}
            check = {"name": c.get("context"), "workflow": None, "status": "COMPLETED" if done else "PENDING",
                     "conclusion": state if done else None, "url": c.get("targetUrl")}
            order = (0, c.get("createdAt") or "")
        else:
            workflow = (((c.get("checkSuite") or {}).get("workflowRun") or {}).get("workflow") or {}).get("name")
            check = {"name": c.get("name"), "workflow": workflow, "status": c.get("status"),
                     "conclusion": c.get("conclusion"), "url": c.get("detailsUrl"), "id": c.get("id"),
                     "runId": run_id or None, "startedAt": c.get("startedAt"), "completedAt": c.get("completedAt")}
            # databaseId first: a queued rerun has no startedAt yet but is still the newer attempt
            order = (c.get("databaseId") or 0, c.get("startedAt") or "")
        check["required"] = bool(c.get("isRequired"))
        if c.get("lastRealAttempt"):
            check["lastRealAttempt"] = True  # its suite's newest attempt ran nothing: GitHub's rollup state omits it
        if ((c.get("checkSuite") or {}).get("conclusion") == "CANCELLED" and workflow_key and run_id
                and run_id < newest[workflow_key]):
            superseded.append(check)
            continue
        # a rerun leaves the old attempt in the list (cancelled, then passed): keep the newest per
        # (workflow, name), so same-named jobs in different workflows stay separate
        ident = f"{check['workflow'] or ''}\0{check['name']}"
        if ident not in latest or outranks(check, order, *reversed(latest[ident])):
            if ident in latest:
                superseded.append(latest[ident][1])
            latest[ident] = (order, check)
        else:
            superseded.append(check)
    checks = [check for _, check in latest.values()]
    # only the ones that would have counted against the PR are worth keeping. One that ran nothing (GitHub
    # stamps it started and completed at once), such as a twin cancelled before it began, stays as evidence
    # for check_verdict (the rollup still counts it) but is marked so status never names it: it has no
    # error to chase, whichever of the pair has the higher id
    superseded = [{**brief(c), "ranNothing": bool(c.get("completedAt") and c.get("startedAt") == c.get("completedAt")),
                   # read by suite id, not from the rollup: not in its counts (rollup_red_is_superseded)
                   **({"lastRealAttempt": True} if c.get("lastRealAttempt") else {})}
                  for c in superseded if (c.get("conclusion") or "").upper() not in PASSED]
    # the cache keeps 20; the ones dropped past that that status would count still reach its count line
    superseded_omitted = sum(1 for c in superseded[20:] if not c["ranNothing"])
    superseded = superseded[:20]
    base = node.get("baseRef") or {}
    required = set((base.get("branchProtectionRule") or {}).get("requiredStatusCheckContexts") or [])
    for rule in ((base.get("rules") or {}).get("nodes") or []):
        for item in ((rule.get("parameters") or {}).get("requiredStatusChecks") or []):
            required.add(item.get("context"))
    # A required check that has not reported yet (ci-status appears only when its run reaches it)
    # is pending, not absent: judging only the required checks present would call a run green early.
    for check in checks:
        if check.get("lastRealAttempt") and check.get("name") in required:
            check["required"] = True  # no isRequired on a run read by suite id: the base's rules decide
    reported = {c.get("name") for c in checks}
    return {
        "requiredMissing": sorted(name for name in required if name and name not in reported),
        "number": node.get("number"), "url": node.get("url"), "title": node.get("title"),
        "state": node.get("state"), "isDraft": node.get("isDraft"), "merged": node.get("merged"),
        "mergedAt": node.get("mergedAt"), "mergeable": node.get("mergeable"),
        "mergeStateStatus": node.get("mergeStateStatus"), "headRefOid": node.get("headRefOid"),
        "headRefName": node.get("headRefName"),
        "reviewDecision": node.get("reviewDecision"), "updatedAt": node.get("updatedAt"),
        "checkState": rollup.get("state"), "checks": checks, "superseded": superseded,
        "supersededOmitted": superseded_omitted,
        "checksTotal": contexts.get("totalCount", len(checks)),
        "checkCounts": check_counts(contexts),
        "checksTruncated": bool((contexts.get("pageInfo") or {}).get("hasNextPage")),
    }


def known_steps(pairs: list[tuple[dict, dict]]) -> dict[str, list]:
    """Check node id -> [failedSteps, stepCount] from the cached data: a completed check keeps them."""
    known: dict[str, list] = {}
    for e, _ in pairs:
        for c in (((e["cache"] or {}).get("data") or {}).get("checks") or []):
            if c.get("id") and isinstance(c.get("failedSteps"), list):
                known[c["id"]] = [c["failedSteps"], c.get("stepCount")]
    return known


def slim_run(doc: dict) -> dict:
    keep = ("id", "name", "display_title", "status", "conclusion", "html_url", "head_sha", "head_branch",
            "event", "run_attempt", "created_at", "updated_at")
    return {k: doc.get(k) for k in keep}


def settled_pr(data: dict) -> bool:
    """A merged or closed PR: its failed steps are not read from GitHub (on 2026-11-10 cosmic-gray's daemon read 54
    jobs/{id} in ten minutes, most for merged cmux PRs). Steps already cached are still carried forward: `wait pr
    --until green|done` rules on a merged PR too, and a runner refusal inside the rescue grace is held by them."""
    return str(data.get("state") or "").upper() in {"MERGED", "CLOSED"}


def wants_steps(c: dict) -> bool:
    """A check whose steps the daemon reads once: a failure (which steps failed) or a cancellation
    (did any step run: the owned-pool rescue cancels a job still queued for a runner, then re-runs it)."""
    return bool(c.get("id")) and (c.get("conclusion") or "").upper() in STEP_FAILED | {"CANCELLED"}


def failed_steps(steps: list | None) -> list[str]:
    return [str(s.get("name")) for s in steps or [] if isinstance(s, dict)
            and str(s.get("conclusion") or "").upper() in STEP_FAILED]


def slim_jobs(doc: dict) -> list[dict]:
    keep = ("id", "name", "status", "conclusion", "html_url", "run_attempt", "runner_name", "labels",
            "started_at", "completed_at")
    return [{**{k: j.get(k) for k in keep}, "failedSteps": failed_steps(j.get("steps")),
             "stepCount": len(j["steps"]) if isinstance(j.get("steps"), list) else None}
            for j in doc.get("jobs") or []]


def slim_run_jobs(doc: Any) -> dict:
    """A run's job list as fill_steps_rest keeps it: each job's id, status, failed steps and step count."""
    doc = doc if isinstance(doc, dict) else {}
    return {"total": doc.get("total_count") or 0, "jobs": [
        {"id": j.get("id"), "status": j.get("status"), "failedSteps": failed_steps(j.get("steps")),
         "stepCount": len(j["steps"]) if isinstance(j.get("steps"), list) else None}
        for j in doc.get("jobs") or [] if isinstance(j, dict)]}


def settled_job(j: Any) -> bool:
    """A job a list showed completed with its steps: its failed steps and step count are final."""
    return isinstance(j, dict) and j.get("status") == "completed" and isinstance(j.get("failedSteps"), list) \
        and isinstance(j.get("stepCount"), int)


def jobs_attempt(jobs: list[dict] | None) -> int:
    """The newest attempt the job list covers (with filter=latest a re-run of failed jobs keeps the
    jobs that passed at their old attempt)."""
    return max((j.get("run_attempt") or 0 for j in jobs or []), default=0)


# ---------------------------------------------------------------- daemon


def newest_verdict(found: list[tuple[int, str, str]]) -> tuple[str, str]:
    """(status, conclusion) of a check from its runs (id, status, conclusion): the newest run with a verdict,
    so a later skipped, cancelled or still-running run never hides an earlier failure; the newest run when
    none has a verdict yet, but not a skipped twin while a run of that name is still going."""
    found = sorted(found)
    verdicts = [r for r in found if r[1] == "completed" and r[2] in VERDICTS]
    ran = [r for r in found if r[2] != "skipped"] or found
    _, status, conclusion = verdicts[-1] if verdicts else ran[-1]
    return status, conclusion


HEAD_CONTEXTS = """statusCheckRollup{contexts(first:100%s){pageInfo{hasNextPage endCursor} nodes{__typename
... on CheckRun{databaseId name status conclusion checkSuite{app{slug} workflowRun{workflow{name}}}}
... on StatusContext{context state}}}}"""

PR_CONTEXT_MAX_PAGES = 20  # 2,000 contexts per PR; beyond that the cache stays explicitly partial
# The follow-up pages' own share of the shared login's GraphQL hour, in points over the last hour. Past it a PR that
# still needs a page reads pending (checksPageError) until the hour frees room: paging every
# watched PR every cycle once spent 1678 of one daemon's 1958 points an hour (#1830), and the landers that need the
# same hour to read their gates must never be starved by a completeness read.
PR_PAGES_POINTS_PER_HOUR = 300


def head_query(owner: str, repo: str, sha: str, cursor: str | None = None,
               pull_number: int | None = None) -> str:
    after = f', after:"{cursor}"' if cursor else ""
    required = f" isRequired(pullRequestNumber:{pull_number})" if pull_number is not None else ""
    contexts = (HEAD_CONTEXTS % after).replace("databaseId name status conclusion",
                                                f"databaseId name status conclusion{required}")
    if required:
        contexts = contexts.replace("... on StatusContext{context state}",
                                    f"... on StatusContext{{context state{required}}}")
    suites = "" if cursor else " " + SUITE_ATTEMPTS
    return (f'repository(owner:"{owner}",name:"{repo}"){{object(oid:"{sha}"){{... on Commit{{'
            + contexts + suites + "}}}")


def fold_contexts(nodes: list, runs: dict, statuses: dict, ids: dict, prefix: str = "") -> None:
    """Add one page of a head's contexts to runs (`workflow / job` -> [(id, status, conclusion)]), statuses
    (`status / context` -> (status, conclusion, state)) and ids (failed Actions jobs). prefix (`OWNER/REPO: `) keys
    another repository's checks apart, so a same-named check there never stands in for one here (CHECKS_OF_RECORD).
    A status's `error` is folded into the conclusion `failure` (every reader of `found` counts it red), and its own
    state is kept beside it (head_data's statusStates): an `error` is a poster that gave no verdict, which a reader
    such as a fallback dispatcher must tell apart from a red."""
    for item in nodes or []:
        if not item:
            continue
        if item.get("__typename") == "StatusContext":
            state = (item.get("state") or "").lower()
            statuses[f"{prefix}status / {item['context']}"] = (
                "in_progress" if state in ("pending", "expected") else "completed",
                "failure" if state == "error" else state, state)
            continue
        suite = item.get("checkSuite") or {}
        slug = (suite.get("app") or {}).get("slug")
        owner = (((suite.get("workflowRun") or {}).get("workflow") or {}).get("name") or slug or "check")
        key = f"{prefix}{owner} / {item['name']}"
        conclusion = (item.get("conclusion") or "").lower()
        runs.setdefault(key, []).append((item.get("databaseId") or 0, (item.get("status") or "").lower(), conclusion))
        if slug == "github-actions" and conclusion == "failure" and item.get("databaseId"):
            ids.setdefault(key, []).append(item["databaseId"])


def head_data(sha: str, runs: dict, statuses: dict, ids: dict) -> dict:
    found = {key: list(newest_verdict(rs)) for key, rs in runs.items()}
    found.update({key: list(value[:2]) for key, value in statuses.items()})
    # no check yet is not "all finished": a push's checks appear a few seconds later
    running = any(st != "completed" for rs in runs.values() for _, st, _ in rs)
    settled = bool(found) and not running and all(status == "completed" for status, _ in found.values())
    states = {key: value[2] for key, value in statuses.items() if len(value) > 2}
    return {"sha": sha, "found": found, "ids": ids, "settled": settled, "statusStates": states}


def _bounded(value: Any, default: float, low: float, high: float) -> float:
    """value when it is a plain number within [low, high], else default."""
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value != value:
        return default
    return value if low <= value <= high else default


def policy_host() -> str:
    """This host's name in the fleet policy: update.json's host, else the short hostname."""
    doc = read_json(UPDATE_CONFIG)
    host = doc.get("host") if isinstance(doc, dict) else None
    return host if isinstance(host, str) and host else socket.gethostname().split(".")[0].lower()


def policy_doc() -> dict:
    """The fleet policy's default, then its hosts[this host], then ~/.config/glaeda/gh-daemon.json."""
    doc: dict = {}
    fleet = read_json(FLEET_POLICY)
    if isinstance(fleet, dict):
        hosts = fleet.get("hosts") if isinstance(fleet.get("hosts"), dict) else {}
        for layer in (fleet.get("default"), hosts.get(policy_host())):
            doc.update(layer if isinstance(layer, dict) else {})
    local = read_json(DAEMON_CONFIG)
    doc.update(local if isinstance(local, dict) else {})
    return doc


def daemon_policy() -> dict:
    """The daemon's pacing: ~/.config/glaeda/gh-daemon.json over the fleet policy over the module defaults.

    {"cycle": 60, "commentCycle": 15, "restShare": 0.4,
     "floors": {"rest": {"floor": 1500, "reserve": 300}, "graphql": {"floor": 500, "reserve": 100}},
     "forceLow": ["graphql"]}

    A bucket's floor is where it counts as low: below it the daemon polls it LEAN_FACTOR times less
    often and serves what it can from the other bucket. forceLow treats the buckets it names as below
    their floors whatever GitHub says, to show the fallback live without draining a real quota.

    Every key is optional, and a value that is not a number in range keeps its default, so a typo
    can neither stop the daemon nor turn it into a busy loop. A reserve above its floor keeps both
    defaults: "stop" must come after "lean". restShare 0 sends every PR and run read to GraphQL
    (a failed attempt's job list is still read once: the cap never holds that back).
    Read every tick, so an edit applies without a restart."""
    doc = policy_doc()
    cycle = int(_bounded(doc.get("cycle"), CYCLE, 15, 900))
    comment = int(_bounded(doc.get("commentCycle"), COMMENT_CYCLE, 5, 300))
    floors = dict(FLOORS)
    given = doc.get("floors") if isinstance(doc.get("floors"), dict) else {}
    for bucket, (floor, reserve) in FLOORS.items():
        one = given.get(bucket) if isinstance(given.get(bucket), dict) else {}
        f = int(_bounded(one.get("floor"), floor, 0, 100000))
        r = int(_bounded(one.get("reserve"), reserve, 0, 100000))
        floors[bucket] = (f, r) if r <= f else (floor, reserve)
    per_minute = int(_bounded(doc.get("graphqlPerMinute"), GRAPHQL_PER_MINUTE, 1, 5000))
    alarms = doc.get("alarms") if isinstance(doc.get("alarms"), dict) else {}
    return {"cycle": cycle, "commentCycle": comment, "graphqlPerMinute": per_minute,
            "alarms": {"pool": alarms.get("pool") is True, "share": alarms.get("share") is not False,
                       "restLeft": int(_bounded(alarms.get("restLeft"), ALARM_REST_LEFT, 0, 100000)),
                       "paceShare": float(_bounded(alarms.get("paceShare"), ALARM_PACE_SHARE, 0.0, 1.0))},
            "cycles": {"pr": cycle, "run": cycle, "comment": comment, "head": cycle},
            "floors": floors, "restShare": float(_bounded(doc.get("restShare"), REST_SHARE, 0.0, 1.0)),
            # restYield out of range (or not a number) is left out, so the default (no yield) holds
            **({"restYield": int(doc["restYield"])} if isinstance(doc.get("restYield"), (int, float))
               and not isinstance(doc.get("restYield"), bool) and 0 <= doc["restYield"] <= 100000 else {}),
            "forceLow": tuple(b for b in ("rest", "graphql")
                              if isinstance(doc.get("forceLow"), list) and b in doc["forceLow"])}


def consumer_policy() -> dict:
    """CONSUMER_DEFAULTS with the keys of ~/.config/glaeda/gh-consumers.json laid over them."""
    policy = {**CONSUMER_DEFAULTS, "reserved": dict(CONSUMER_DEFAULTS["reserved"])}
    doc = read_json(CONSUMERS_CONFIG)
    if isinstance(doc, dict):
        if isinstance(doc.get("reserved"), dict):
            policy["reserved"] = {str(k): int(v) for k, v in doc["reserved"].items() if isinstance(v, (int, float))}
        for k in ("limit", "pool"):
            if isinstance(doc.get(k), (int, float)):
                policy[k] = int(doc[k])
    return policy


def merge_counter(counters: list[dict], seen: dict) -> list[dict]:
    """counters with one reading folded in. A reading whose reset is within RESET_JITTER of a known counter's is
    that counter (GitHub's reset for one window can differ by a second between answers), and within one window a
    counter only goes down, so the lower remaining wins whichever arrived last; the freshest seenAt and the
    later reset are kept."""
    out, merged = [], False
    for c in counters:
        if not merged and abs(c["reset"] - seen["reset"]) <= RESET_JITTER:
            c = {**c, "limit": seen.get("limit", c.get("limit")), "remaining": min(c["remaining"], seen["remaining"]),
                 "reset": max(c["reset"], seen["reset"]), "seenAt": max(c["seenAt"], seen["seenAt"])}
            tags = sorted(set(c.get("counters") or []) | set(seen.get("counters") or []))
            if tags:
                c["counters"] = tags  # a counter keeps the tag any of its readings gave it (ACTIONS_COUNTER_PATH)
            merged = True
        out.append(c)
    if not merged:
        out.append(dict(seen))
    return sorted(out, key=lambda c: c["reset"])


def rest_counters(budget: dict, key: str = "restCounters") -> list[dict]:
    """The well-formed entries of budget["restCounters"] (Daemon.settle_rest), or of budget["graphqlCounters"]."""
    out = []
    for c in budget.get(key) or []:
        if (isinstance(c, dict) and isinstance(c.get("reset"), (int, float)) and isinstance(c.get("remaining"), int)
                and isinstance(c.get("seenAt"), (int, float))):
            out.append(c)
    return out


class Daemon:
    def __init__(self, transport: Callable = http, token: Callable[[], str] = gh_token,
                 controller: Any = "env", upstream: Any = "config") -> None:
        self.transport = transport
        # "config" re-reads UPSTREAM_CONFIG every tick, so writing or removing it switches the mode
        # without a restart; a test passes a callable (request -> answer) or None.
        self.upstream_source = upstream
        self.upstream_at = float("-inf")  # the last full upstream read
        self.upstream_status: dict[str, Any] | None = None
        # "env" (or any callable) is re-read every tick, so a daemon follows a controller move
        # (cmux-fleet-client's client.json repointed) without a restart; an instance stays fixed.
        self.controller_source: Callable[[], Any] | None = (
            Controller.from_env if controller == "env" else controller if callable(controller) else None)
        self.controller = self.controller_source() if self.controller_source else controller
        self.controller_down_until = 0.0
        self.controller_feed_at = float("-inf")
        self.controller_failures = 0
        self.controller_filled: set[str] = set()  # watched runs the controller tracks, while its feed answers
        self.controller_cursor: int | None = None
        self.controller_seen: dict[str, bool] = {}  # watched run key -> the controller knows the run
        self.controller_status: dict[str, Any] = {"state": "off" if self.controller is None else "starting"}
        self.nudged: set[str] = set()  # PRs (and heads) a check event touched since their last fetch
        self.controller_ok_at = float("-inf")  # the last time the change feed answered
        self.fed_repos: dict[str, float] = {}  # owner/repo (lowercase) -> the last event the feed delivered for it
        self.gql_reason = "other"  # what the GraphQL query being sent reads, for daemon.json graphqlBy
        self.gql_log: list[tuple[float, str, int]] = []  # (time, reason, points) per GraphQL query, last hour
        self.token_source = token
        self.token: str | None = None
        doc = read_json(BASE / "budget.json")
        self.budget: dict[str, dict] = doc if isinstance(doc, dict) else {}
        self.saved_budget = json.loads(json.dumps(self.budget))
        self.backoff: dict[str, float] = {"rest": 0.0, "graphql": 0.0}
        self.secondary_until = 0.0  # a secondary 403 holds both buckets until then
        self.secondary_strikes = 0  # secondary 403s since the last clean answer: each doubles the hold
        self.budget_retry = 0.0  # /rate_limit is left alone until this time after a refusal
        self.rate_limit_at = float("-inf")  # when /rate_limit last answered (refresh_budget)
        self.last_cycle: dict[str, float] = {kind: 0.0 for kind in CYCLES}
        self.now = time.time()
        self.errors: list[str] = []
        self.attempted: dict[str, float] = {}  # when each key was last fetched: a new one at most once per cycle
        self.consumer_sent: dict[tuple[str, str], float] = {}  # (head, consumer): last sent upstream (upstream_read)
        self.rest_tried: dict[str, float] = {}  # when a REST read of each key last ended, answered or failed
        # when a confirming read (wait_confirms) of each run was last made ahead of the rest, and the finish it was
        # for (rest_run): one such read per finish
        self.confirm_tried: dict[str, tuple[float, dict]] = {}
        # the runs this tick's due() put first as confirming reads: their finish, and their cache's fetchedAt then
        self.confirming: dict[str, tuple[dict, Any]] = {}
        self.repo_parts: dict[str, dict] = {}  # REST path -> {"at", "part"}: answers every watch on them shares
        self.job_lists_asked: dict[str, float] = {}  # a run's job-list page -> the tick that last asked it
        self.deferred_before: dict[str, float] = {}  # deferred by the last tick: when each was first deferred
        self.deferred_since: dict[str, float] = {}  # when each key still deferred was first deferred
        self.sent: list[tuple[float, str]] = []  # (time, rest|rest304|graphql) for the last hour's counts
        self.paths: dict[str, str] = dict(BUCKETS)  # the bucket each kind reads over now
        self.reads: list[tuple[float, str, str]] = []  # (time, kind, bucket) per entry read, for the last hour
        self.batch: dict[str, int] = {kind: GQL_BATCH_START for kind in CYCLES}  # entries per GraphQL query
        self.clean: dict[str, int] = {kind: 0 for kind in CYCLES}  # clean GraphQL queries in a row
        # key -> {"at": last lone read, "fails": lone timeouts in a row, "oks": lone answers in a row}
        self.heavy: dict[str, dict] = {}
        self.since: dict[str, float] = {}  # key -> when the daemon first saw it watched, for oldestData
        self.stale_waited: dict[str, float | None] = {}  # oldest_data's, for the watches a wait is blocked on
        self.recent_errors: dict[str, float] = {}  # error -> when last seen (daemon.json recentErrors)
        self.beat = float("-inf")
        self.status: dict[str, Any] = {}  # the last good tick's daemon.json
        self.failing: dict[str, Any] | None = None  # set while ticks raise: the latest error and since when
        self.tick_deadline = float("inf")  # time.monotonic() after which this tick starts no request
        self.deferred: set[str] = set()  # keys a tick ran out of time for: read first on the next tick
        self.post_at = float("-inf")  # the last content write (post_tick)
        self.clock_real = True  # tick(now=...) in tests pins the clock
        held = (read_json(BASE / "daemon.json") or {}).get("outbox") or {}
        self.post_hold = float(held.get("holdUntil") or 0.0)  # GitHub's secondary limit holds the outbox until then
        self.post_backoff = POST_BACKOFF  # the next hold without a Retry-After
        saved = read_json(BASE / CONSUMERS_FILE)
        spends = saved.get("spends") if isinstance(saved, dict) else None
        # consumer -> times of the head reads charged to it in the last hour
        self.head_spend: dict[str, list[float]] = {
            str(k): [float(t) for t in v if isinstance(t, (int, float))]
            for k, v in (spends or {}).items() if isinstance(v, list)}
        self.payer: dict[str, tuple[str, float]] = {}  # head key -> (consumer, time) charged for a read in flight
        self.spill: list[dict] = []  # entries a fetch could not finish because GraphQL stopped partway
        self.limited: list[dict] = []  # entries the last fetch got only partly: GitHub's per-query resource limit
        self.gql_first = 0  # index of the kind read first next tick (rotates after the per-minute ceiling held one)
        self.gql_paced: str | None = None  # the kind the ceiling held this tick
        self.gql_limited = False  # a GraphQL answer since the last fetch began said the primary limit is reached
        self.refunded: dict[str, str] = {}  # head key -> the consumer a failed read refunded, this tick
        self.denied: dict[str, float] = {}  # consumer -> when a head read it needed was refused for budget
        self.saved_consumers: str = ""
        self.policy = daemon_policy()  # re-read at the start of every tick
        # minute (epoch // 60) -> counted REST requests sent in it. Per minute, so the cap's check is
        # at most 61 additions however busy the hour was, and on disk, so a restart does not hand the
        # daemon a fresh share of an hour it already spent.
        spend = read_json(BASE / REST_SPEND_FILE)
        self.rest_minutes: dict[int, int] = {
            int(k): int(v) for k, v in (spend if isinstance(spend, dict) else {}).items()
            if str(k).isdigit() and isinstance(v, int) and not isinstance(v, bool) and v > 0}
        self.saved_rest_minutes = dict(self.rest_minutes)
        # the spend log (SPEND_FILE): minute -> "bucket\troute\tkind\trepo" -> [requests, counted, points]
        self.spend: dict[int, dict[str, list[int]]] = load_spend(read_json(BASE / SPEND_FILE))
        self.spend_saved_at = float("-inf")
        self.spend_dirty = False
        self.caller: tuple[str, ...] = ("other", "", "")  # what the request being sent is for (calling)
        alarms = read_json(BASE / ALARMS_FILE)
        self.alarms: dict[str, dict] = {  # alarm -> {"at", "level", ...}; a malformed entry is dropped, never fatal
            str(k): v for k, v in (alarms if isinstance(alarms, dict) else {}).items()
            if isinstance(v, dict) and isinstance(v.get("at"), (int, float)) and not isinstance(v.get("at"), bool)}
        self.pool_seen: list[tuple[float, int, float]] = []  # (seenAt, remaining, reset) of the poorest REST counter
        self.alarm_procs: list[subprocess.Popen] = []  # tell-coordinator runs not yet reaped
        self.writing = False  # inside the outbox: its requests are sessions' writes, not the daemon's polling
        self.jobs_only: list[dict] = []  # failed runs whose job list is read though runs cannot be (due)
        self.steps_failed: dict[Any, float] = {}  # job id -> when GitHub refused its steps for good (STEPS_RETRY)

    # -- budget

    def mode(self, bucket: str) -> str:
        """normal, lean (below the floor, or REST past the daemon's own share) or stop (below the reserve, or told
        to back off). Past its share REST is lean even while the share yields (share_yields): the yield lets reads go
        on over REST while GraphQL is out, at a quarter of the pace (LEAN_FACTOR) and without job lists, never at the
        full cycle. On 2026-11-08/09 the share yielded from each REST reset (:18) to GraphQL's (~:33) and
        cosmic-gray's daemon sent 1,271 counted REST requests in those 15 minutes (85 a minute; its share is 300 an
        hour), and the account's REST ran out by :50 every hour while GraphQL was out from :05 (both out :05-:18)."""
        if self.backoff[bucket] > self.now:
            return "stop"
        capped = bucket == "rest" and self.past_share()
        seen = self.budget.get(bucket) or {}
        if not seen or (seen.get("reset") or 0) <= self.now:
            return "lean" if capped or bucket in self.policy.get("forceLow", ()) else "normal"
        floor, reserve = self.policy["floors"][bucket]
        remaining = seen.get("remaining", floor)
        forced = bucket in self.policy.get("forceLow", ())
        return "stop" if remaining < reserve else "lean" if remaining < floor or capped or forced else "normal"

    def charge_rest(self, minute: int, n: int) -> None:
        """Count n REST requests in that minute, on disk at once, so a daemon that dies mid-tick
        hands its successor the spend it really made. One small file write per counted request
        (about 2000 an hour at the cap) is nothing next to the request itself."""
        left = self.rest_minutes.get(minute, 0) + n
        if left > 0:
            self.rest_minutes[minute] = left
        else:
            self.rest_minutes.pop(minute, None)
        write_json(BASE / REST_SPEND_FILE, {str(m): c for m, c in self.rest_minutes.items()})
        self.saved_rest_minutes = dict(self.rest_minutes)

    @contextlib.contextmanager
    def calling(self, kind: str, repo: str = "", waiter: str = ""):
        """The requests sent inside are charged to (KIND, REPO) in the spend log, read for WAITER (waiter_of)."""
        prior, self.caller = self.caller, (kind, repo, waiter)
        try:
            yield
        finally:
            self.caller = prior

    def note_spend(self, bucket: str, name: str, counted: int, points: int = 0) -> None:
        """One request in the spend log: NAME is a REST route template or a GraphQL query name; COUNTED is 1 when
        it cost the shared pool (not a 304, not /rate_limit), whether or not the daemon's share was charged."""
        kind, repo, waiter = (tuple(self.caller) + ("", "", ""))[:3]
        key = "\t".join((bucket, name, kind, repo) + ((waiter.replace("\t", " "),) if waiter else ()))
        row = self.spend.setdefault(int(self.clock() // 60), {}).setdefault(key, [0, 0, 0])
        row[0] += 1
        row[1] += counted
        row[2] += points
        self.spend_dirty = True

    def spend_rows(self, seconds: float = 3600.0) -> list[dict]:
        """The spend log's rows over the last SECONDS (by the minute, as rest_spent counts), summed per key."""
        first = int((self.clock() - seconds) // 60) + 1  # whole minutes after the window's start, and this one
        total: dict[str, list[int]] = {}
        for minute, rows in self.spend.items():
            if minute >= first:
                for key, (requests, counted, points) in rows.items():
                    mine = total.setdefault(key, [0, 0, 0])
                    mine[0] += requests
                    mine[1] += counted
                    mine[2] += points
        out = []
        for key, (requests, counted, points) in total.items():
            bucket, name, kind, repo, waiter = (key.split("\t") + ["", "", "", "", ""])[:5]
            out.append({"bucket": bucket, "name": name, "kind": kind, "repo": repo, "waiter": waiter, "requests": requests,
                        "counted": counted, "points": points})
        return out

    def spend_by(self, seconds: float = 3600.0) -> dict:
        """daemon.json spendBy: the top SPEND_TOP rows each of REST by route, REST by route and caller, and GraphQL
        by query and caller, over the last SECONDS."""
        return spend_summary(self.spend_rows(seconds), seconds)

    def save_spend(self, force: bool = False) -> None:
        first = int(self.clock() // 60) - 60
        self.spend = {m: rows for m, rows in self.spend.items() if m >= first}
        if not self.spend_dirty or (not force and self.now - self.spend_saved_at < SPEND_SAVE_EVERY):
            return
        write_json(BASE / SPEND_FILE, {"schema": "glaeda-gh-spend/v1", "at": self.now,
                                       "fields": ["requests", "counted", "points"],
                                       "minutes": {str(m): rows for m, rows in sorted(self.spend.items())}})
        self.spend_saved_at, self.spend_dirty = self.now, False

    # -- alarms: before the pool runs dry (ALARM_CMD, NOTICES_DIR)

    def pool_projection(self) -> dict | None:
        """The shared REST pool as this host sees it: the poorest core counter's remaining, its reset, and, once
        ALARM_TREND_MIN of readings in its window are in, the drain per minute and when it runs dry at that pace."""
        seen = self.budget.get("rest") or {}
        remaining, reset, at = seen.get("remaining"), seen.get("reset"), seen.get("seenAt")
        if not all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in (remaining, reset, at)) \
                or reset <= self.now:
            self.pool_seen = []
            return None
        if not self.pool_seen or self.pool_seen[-1][0] != at:
            self.pool_seen.append((float(at), int(remaining), float(reset)))
        # one window only: a counter that reset, or a poorer one taking over, starts the trend again
        self.pool_seen = [p for p in self.pool_seen if abs(p[2] - reset) <= RESET_JITTER
                          and self.now - p[0] <= ALARM_TREND_KEEP]
        out: dict[str, Any] = {"remaining": int(remaining), "reset": float(reset), "perMinute": None, "dryAt": None}
        first = self.pool_seen[0] if self.pool_seen else None
        if first is not None and at - first[0] >= ALARM_TREND_MIN and first[1] > remaining:
            rate = (first[1] - remaining) / (at - first[0])  # per second
            out["perMinute"] = round(rate * 60, 1)
            dry = at + remaining / rate
            if dry < reset:
                out["dryAt"] = dry
        return out

    def quota_starved(self) -> bool:
        """Whether GitHub's own limits stop every read now: GraphQL stopped and REST stopped or at the daemon's share.
        Old data then is the quota's doing, which neither a restart nor a wait's own read can fix (daemon_starved)."""
        return self.mode("graphql") == "stop" and (self.mode("rest") == "stop" or self.rest_capped())

    def quota_hold(self, kind: str) -> tuple[str, bool] | None:
        """Why the quota holds this kind's reads back now, and whether it stops them (True: nothing is read for it
        until a reset, which neither a restart nor a wait's own read can change) or only slows them (lean, paced).
        None when the quota is not in the way. huge-blue, 2026-11-11: with the shared GraphQL quota sitting at the
        fleet's 1000 reserve, PR data a wait was blocked on reached 2509 s old with no error recorded: due() returned
        nothing for "pr" and said nothing, so staleWaited passed staleAfter with no cause attached, and a session
        restarted the daemon three times for what was the quota."""
        path = self.paths.get(kind) or BUCKETS[kind]
        seen = self.budget.get(path) or {}
        floor, reserve = self.policy["floors"][path]
        left = seen.get("remaining", "?")
        clock = lambda t: dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%H:%MZ")  # noqa: E731
        resets = f", resets {clock(seen['reset'])}" if isinstance(seen.get("reset"), (int, float)) else ""
        name = "GraphQL" if path == "graphql" else "REST"
        if self.backoff[path] > self.now:
            return f"GitHub told this daemon to back off {name} until {clock(self.backoff[path])}", True
        mode = self.mode(path)
        if mode == "stop":
            return (f"the shared {name} quota is under the daemon's reserve: {left} left, no {name} reads below "
                    f"{reserve} (kept for lands){resets}"), True
        if path == "rest" and kind in BALANCED + FALLBACK and self.rest_capped() and self.mode("graphql") != "normal":
            return f"this daemon's REST share is spent and GraphQL is {self.mode('graphql')}", self.mode("graphql") == "stop"
        if mode == "lean":
            if isinstance(left, int) and left < floor:
                waited = "waited reads keep their cycle and " if path == "graphql" else ""
                return (f"the shared {name} quota is under the daemon's floor: {left} left (below {floor}, {waited}"
                        f"the rest are read {LEAN_FACTOR} times less often){resets}"), False
            why = "is forced low by policy" if path in self.policy.get("forceLow", ()) else "is past this daemon's share"
            return f"{name} {why} (read {LEAN_FACTOR} times less often)", False
        if self.gql_paced == kind:
            return (f"the daemon's GraphQL pace ({self.policy.get('graphqlPerMinute', GRAPHQL_PER_MINUTE)} points a "
                    "minute) held this tick's reads"), False
        return None

    def stale_explained(self, kind: str | None = None) -> str | None:
        """Why old waited data is not this daemon's fault, which neither a restart nor a wait's own read can fix:
        "quota" (quota_starved), or "upstream" (this host reads through another host's daemon, whose own alarm
        covers it). None when it is this daemon's to fix."""
        # Only a working upstream: one this host cannot reach never gets its waited keys, so nothing there alarms on
        # them, and this host's alarm must (review of glaeda#1947).
        if (getattr(self, "upstream_status", None) or {}).get("state") == "ok":
            return "upstream"
        if self.quota_starved():
            return "quota"
        # the quota stopping the reads of KIND (a wait's own), or of the kind with the oldest waited data
        if kind is None:
            stale = {k: v for k, v in (getattr(self, "stale_waited", None) or {}).items() if isinstance(v, (int, float))}
            kind = max(stale, key=stale.get, default=None)
        hold = self.quota_hold(kind) if kind in CYCLES else None
        return "quota" if hold is not None and hold[1] else None

    def stale_why(self) -> dict[str, dict]:
        """daemon.json staleWhy: for each kind whose waited data is past STALE_DATA_AFTER and that the quota holds
        back (quota_hold), {"why": the reason, "quota": True when it stops the reads}. daemon_starved, the stale
        alarm and `restart` say it instead of calling old data a fault."""
        out = {}
        for kind, age_s in (getattr(self, "stale_waited", None) or {}).items():
            if isinstance(age_s, (int, float)) and age_s > STALE_DATA_AFTER:
                hold = self.quota_hold(kind)
                if hold is not None:
                    out[kind] = {"why": hold[0], "quota": hold[1]}
        return out

    def stale_alarm(self) -> tuple[str, str, dict] | str | None:
        """The stale alarm (alarms.stale, on by default): data a wait is blocked on older than STALE_DATA_AFTER while
        nothing outside this daemon explains it (staleWaited). The heartbeat stays fresh through this, so nothing else
        says it (huge-blue 2026-11-11: a merged PR read OPEN for 50 minutes). FIRE at three times the bound. "held"
        while the data is still old but explained (stale_explained): the alarm is neither sent nor cleared, so a brief
        quota stop never tells anyone it is fixed (review of glaeda#1946)."""
        stale = {k: v for k, v in (getattr(self, "stale_waited", None) or {}).items() if isinstance(v, (int, float))}
        kind = max(stale, key=stale.get, default=None)
        if kind is None or stale[kind] <= STALE_DATA_AFTER:
            return None
        if self.stale_explained() is not None:
            return "held"
        age_s = int(stale[kind])
        level = "fire" if age_s >= 3 * STALE_DATA_AFTER else "warn"
        where = getattr(self, "stale_waited_key", {}).get(kind) or "?"
        errors = "; ".join(list(getattr(self, "recent_errors", {}))[:3]) or "none recorded"
        hold = self.quota_hold(kind)
        quota = f" Quota: {hold[0]}." if hold else ""
        text = (f"{level.upper()} glaeda-gh on {policy_host()}: {kind} data that waits are blocked on is {age_s}s old "
                f"(over {STALE_DATA_AFTER}s; oldest {key_name(where) if where != '?' else '?'}) while its heartbeat is "
                f"fresh.{quota} Recent errors: {errors}. `glaeda-gh restart` restarts a daemon in this state.")
        return level, text, {"kind": kind, "age": age_s, "key": where, **({"quota": hold[0]} if hold else {})}

    def check_alarms(self) -> None:
        """The pool alarm (policy alarms.pool): REST left under alarms.restLeft, or the drain over the last minutes
        running it dry before its reset. The share alarm (alarms.share): this daemon's own counted REST over the last
        SPEND_RECENT seconds, at that pace for an hour, past its cap by half (or by 150 for a small cap). Each names
        the routes that spent most lately, so whoever hears it knows what to fix."""
        self.alarm_procs = [p for p in self.alarm_procs if p.poll() is None]  # reap what finished
        policy = self.policy.get("alarms") or {}
        firing: dict[str, tuple[str, str, dict]] = {}
        rows = self.spend_rows(SPEND_RECENT)
        recent = spend_summary(rows, SPEND_RECENT, top=3)
        top = "; ".join(f"{r['route']} {r['counted']} ({r['topCaller'] or '?'}{route_waiter(r)})"
                        for r in recent["restByRoute"] if r["counted"]) or "no counted REST from this daemon"
        clock = lambda t: dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%H:%MZ")  # noqa: E731
        pool = self.pool_projection()
        held: set[str] = set()  # alarms neither sent nor cleared this tick
        if policy.get("pool") and pool is not None and pool["reset"] - self.now <= 60:
            held.add("pool")  # its window is about to reset: no news either way
        if policy.get("pool") and pool is not None and pool["reset"] - self.now > 60:
            left, reset = pool["remaining"], pool["reset"]
            low = left < policy.get("restLeft", ALARM_REST_LEFT)
            limit = (self.budget.get("rest") or {}).get("limit") or 5000
            share = policy.get("paceShare", ALARM_PACE_SHARE)
            fast = isinstance(share, (int, float)) and share > 0 and pool["perMinute"] is not None \
                and pool["perMinute"] * 60 >= share * limit
            if low or fast or pool["dryAt"] is not None:
                fire = left < self.policy["floors"]["rest"][1] or (
                    pool["dryAt"] is not None and pool["dryAt"] - self.now < ALARM_FIRE_WITHIN)
                pace = f", draining {pool['perMinute']}/min" if pool["perMinute"] else ""
                if fast:
                    pace += f" (past {share:.0%} of its {limit} an hour, {share * limit / 60:.0f}/min)"
                dry = f", dry at {clock(pool['dryAt'])}" if pool["dryAt"] is not None else ""
                text = (f"{'FIRE' if fire else 'WARN'} shared GitHub REST pool on {policy_host()}: {left} left{pace}"
                        f"{dry}, resets {clock(reset)}. This daemon's top REST routes, last "
                        f"{SPEND_RECENT // 60} min: {top}.")
                firing["pool"] = ("fire" if fire else "warn", text, {**pool, "top": recent["restByRoute"]})
        cap = self.rest_cap()
        # the share's own measure: the outbox (sessions' writes) is never held to it (request)
        polling = [r for r in rows if r["bucket"] == "rest" and r["kind"] != "outbox"]
        pace = sum(r["counted"] for r in polling) * 3600 // SPEND_RECENT
        if policy.get("share", True) and pace > max(cap * 3 // 2, cap + 150):
            mine = spend_summary(polling, SPEND_RECENT, top=3)["restByRoute"]
            routes = "; ".join(f"{r['route']} {r['counted']} ({r['topCaller'] or '?'}{route_waiter(r)})"
                               for r in mine if r["counted"])
            text = (f"WARN glaeda-gh on {policy_host()} is spending REST at {pace}/h against its cap of {cap} "
                    f"({self.rest_spent()} in the last hour). Top routes, last {SPEND_RECENT // 60} min: {routes}.")
            firing["share"] = ("warn", text, {"pace": pace, "cap": cap, "spent": self.rest_spent(), "top": mine})
        if policy.get("stale", True):
            stale = self.stale_alarm()
            if stale == "held":
                held.add("stale")
            elif stale is not None:
                firing["stale"] = stale
        changed = False
        for name, (level, text, data) in firing.items():
            last = self.alarms.get(name) or {}
            # worse: it became a FIRE, or another REST window (GitHub keeps two core counters) is the one running dry
            worse = level == "fire" and last.get("level") != "fire" or (
                isinstance(last.get("reset"), (int, float)) and abs(last["reset"] - data.get("reset", last["reset"]))
                > RESET_JITTER)
            if last.get("at") and self.now - float(last["at"]) < ALARM_EVERY and not worse:
                if last.get("cleared"):  # back within the hour: still the alarm already sent
                    self.alarms[name] = {k: v for k, v in last.items() if k != "cleared"}
                    changed = True
                continue
            if name == "pool":  # read only when it is sent: at most a few times an hour
                spenders, host_rest = host_spenders()
                gap_text, gap = unlogged_text((self.budget.get("rest") or {}).get("limit") or 5000,
                                              data.get("remaining"), data.get("reset"), self.clock(), host_rest)
                data = {**data, "spenders": spenders, "hostRest": host_rest, "unlogged": gap}
                text += " " + spenders_text(spenders) + gap_text
            self.send_alarm(name, level, text, data)
            self.alarms[name] = {"at": self.now, "level": level, "text": text,
                                 **({"reset": data["reset"]} if "reset" in data else {})}
            changed = True
        for name in [n for n in self.alarms if n not in firing and n not in held and not self.alarms[n].get("cleared")]:
            if not self.alarms[name].get("clearSaid"):  # one "cleared" per alarm sent, however often it flaps
                self.write_notice(name, "info", f"glaeda-gh on {policy_host()}: the {name} alarm cleared", {})
            self.alarms[name] = {**self.alarms[name], "cleared": self.now, "clearSaid": True}
            changed = True
        for name in [n for n, a in self.alarms.items() if a.get("cleared") and self.now - a["cleared"] > ALARM_EVERY]:
            del self.alarms[name]  # cleared an hour ago: a new one is news again
            changed = True
        if changed:
            write_json(BASE / ALARMS_FILE, self.alarms)

    def write_notice(self, kind: str, level: str, text: str, data: dict) -> None:
        """One notice line (cmuxterm-hq tools/fleet-reconcilers/notices.py's schema) in NOTICES_DIR/glaeda-gh.jsonl."""
        line = {"ts": dt.datetime.fromtimestamp(self.now, dt.timezone.utc).isoformat(timespec="seconds"),
                "source": "glaeda-gh", "level": "warn" if level in ("warn", "fire") else "info", "kind": kind,
                "key": policy_host(), "text": text, "data": {**data, "severity": level}}
        try:
            NOTICES_DIR.mkdir(parents=True, exist_ok=True)
            path = NOTICES_DIR / "glaeda-gh.jsonl"
            with open(path, "a") as out:
                out.write(json.dumps(line, sort_keys=True) + "\n")
            lines = path.read_text().splitlines()
            if len(lines) > 2500:  # notices.py's KEEP, with its slack
                tmp = path.with_suffix(".jsonl.tmp")
                tmp.write_text("\n".join(lines[-2000:]) + "\n")
                tmp.replace(path)
        except OSError as error:
            log({"event": "notice-failed", "error": describe(error)})

    def send_alarm(self, name: str, level: str, text: str, data: dict) -> None:
        """The notice line, then tell-coordinator in the background: a slow or missing inbox never holds a tick."""
        log({"event": "alarm", "alarm": name, "level": level, "text": text})
        self.write_notice(name, level, text, data)
        if not (ALARM_CMD.is_file() and os.access(ALARM_CMD, os.X_OK)):
            log({"event": "alarm-unsent", "alarm": name, "why": f"no {ALARM_CMD}"})
            return
        try:
            self.alarm_procs.append(subprocess.Popen(
                [os.fspath(ALARM_CMD), "--from", "glaeda-gh", "--severity", level, text],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True))
        except OSError as error:
            log({"event": "alarm-unsent", "alarm": name, "why": describe(error)})

    def clock(self) -> float:
        """Now, for the REST share: the wall clock, or the pinned one a test drives tick(now=...) with."""
        return time.time() if self.clock_real else self.now

    def rest_spent(self) -> int:
        """REST requests this daemon sent in the last hour that GitHub counted (304s are free), by the
        minute: the minute an hour back counts whole, so this errs toward the cap, not past it."""
        oldest = int(self.clock() // 60) - 60
        return sum(n for minute, n in self.rest_minutes.items() if minute >= oldest)

    def rest_cap(self) -> int:
        limit = (self.budget.get("rest") or {}).get("limit") or 5000
        return int(self.policy["restShare"] * limit)

    def past_share(self) -> bool:
        """The largest read no longer fits in the daemon's own REST share, whether or not the share yields."""
        return self.rest_spent() + max(REST_READ_MAX.values()) > self.rest_cap()

    def rest_above_floor(self) -> bool:
        """REST is neither told to look low (forceLow) nor seen below its floor: what a fallback read over REST
        needs. Unlike mode("rest") == "normal", true while REST is lean only for being past the daemon's share."""
        if "rest" in self.policy.get("forceLow", ()):
            return False
        seen = self.budget.get("rest") or {}
        if not seen or (seen.get("reset") or 0) <= self.now:
            return True
        return int(seen.get("remaining") or 0) >= self.policy["floors"]["rest"][0]

    def rest_capped(self) -> bool:
        """The daemon spent its share of the hourly REST limit, as near as the largest read can tell:
        once that read no longer fits, routing reads to REST would only defer them tick after tick
        while GraphQL could answer them."""
        return not self.rest_room(max(REST_READ_MAX.values()))

    def failed_without_jobs(self, e: dict) -> bool:
        """A cached run whose latest attempt failed and whose job list is an older attempt's."""
        c = e["cache"] or {}
        run = c.get("data") or {}
        return (run.get("status") == "completed" and run.get("conclusion") not in RUN_OK
                and jobs_attempt(c.get("jobs")) < (run.get("run_attempt") or 1))

    def rest_room(self, cost: int) -> bool:
        """Whether `cost` more counted REST requests fit in the share, or the share yields to them."""
        return self.rest_spent() + cost <= self.rest_cap() or self.share_yields(cost)

    def rest_yield(self) -> int:
        """Counted REST the share may yield past its cap in an hour: policy restYield (a host's local override), else
        none. The share is a hard cap, so a GraphQL shortage never spends the shared REST pool (hq#8948)."""
        given = self.policy.get("restYield")
        return int(given) if isinstance(given, int) else REST_YIELD_DEFAULT

    def share_yields(self, cost: int) -> bool:
        """GraphQL is below its floor or throttled, so REST is the only bucket with room: the daemon's reads
        go past its REST share while the account's REST stays above its floor, which is what sessions' own
        gh calls keep. Only with a restYield set: by default nothing yields."""
        if self.mode("graphql") == "normal":
            return False
        if self.rest_spent() + cost > self.rest_cap() + self.rest_yield():
            return False  # the yield is spent too: the rest wait for GraphQL, or the next hour
        seen = self.budget.get("rest") or {}
        if not seen or (seen.get("reset") or 0) <= self.now:
            return True  # not seen yet, or reset since: a full hour's quota
        return int(seen.get("remaining") or 0) - cost >= self.policy["floors"]["rest"][0]

    def richness(self, bucket: str) -> float:
        """What this bucket can still spend per second until its own reset, above its reserve; -1
        while it is stopped. A bucket not seen yet, or past its reset, counts as a full hour's quota."""
        if self.mode(bucket) == "stop":
            return -1.0
        if bucket == "rest" and self.rest_capped():
            return -1.0  # the daemon's own REST share is spent: balanced kinds read over GraphQL
        if bucket in self.policy.get("forceLow", ()):
            return 0.0  # told to treat it as nearly spent: reads go elsewhere while anything else can take them
        seen = self.budget.get(bucket) or {}
        limit = seen.get("limit") or 5000
        reserve = self.policy["floors"][bucket][1]
        if not seen or (seen.get("reset") or 0) <= self.now:
            return max(0, limit - reserve) / FULL_WINDOW
        return max(0, seen.get("remaining", limit) - reserve) / max(seen["reset"] - self.now, RICH_WINDOW_MIN)

    def route(self, kind: str) -> str:
        """The bucket this kind reads over this tick: the richer one. A kind leaves its current bucket
        only when the other is SWITCH_MARGIN richer (or the current one stopped), so the reads move in
        steps instead of flapping, and the two buckets drain about evenly."""
        current = self.paths[kind]
        if kind in FALLBACK:
            # GraphQL unless it is low or throttled and REST is neither (nor is the daemon's REST share spent, unless it
            # yields): REST lean only for being past the share still takes them, at the lean pace (mode)
            want = ("rest" if self.mode("graphql") != "normal" and self.mode("rest") != "stop"
                    and self.rest_above_floor() and not self.rest_capped() else "graphql")
            if want != current:
                log({"event": "route", "kind": kind, "from": current, "to": want,
                     "modes": {b: self.mode(b) for b in ("rest", "graphql")}})
                self.paths[kind] = current = want
        if kind in BALANCED:
            here, there = self.richness(current), self.richness(OTHER[current])
            # Below its floor while the other bucket is not: move, whatever the margin says. The reverse never
            # moves by the margin (a low bucket about to reset can look richer), so the two cannot flap.
            low = self.mode(current) != "normal" and self.mode(OTHER[current]) == "normal"
            into_low = self.mode(OTHER[current]) != "normal" and self.mode(current) == "normal"
            if there >= 0 and (here < 0 or low or (not into_low and there > here * SWITCH_MARGIN)):
                log({"event": "route", "kind": kind, "from": current, "to": OTHER[current],
                     "perMinute": {current: round(here * 60, 1), OTHER[current]: round(there * 60, 1)}})
                self.paths[kind] = current = OTHER[current]
        return current

    def note_budget(self, bucket: str, limit: Any, remaining: Any, reset: float | None, path: str = "") -> None:
        try:
            seen = {"limit": int(limit), "remaining": int(remaining), "reset": reset, "seenAt": self.now}
        except (TypeError, ValueError):
            return
        if bucket == "graphql":
            # GraphQL too answers one token from two counters with their own hourly windows: on 2026-11-04 the one
            # /graphql requests spend reset at :26:29 while /rate_limit and some answers reported one resetting at
            # :21 (cosmic-gray's reading jumped from 3850 left to 3938 between them at 06:02Z while the spending one
            # had 1664). The last answer alone let the daemon, and the gh guard reading budget.json, spend from a
            # counter that was nearly gone; every live one is kept and the poorest is the reading, as for REST.
            if not isinstance(reset, (int, float)):
                if not rest_counters(self.budget, "graphqlCounters"):
                    self.budget[bucket] = seen
                return
            self.budget["graphqlCounters"] = merge_counter(rest_counters(self.budget, "graphqlCounters"), seen)
            self.settle_counters("graphql")
            return
        if bucket == "rest" and isinstance(reset, (int, float)) and ACTIONS_COUNTER_PATH.fullmatch(path):
            seen["counters"] = ["actions"]
        if bucket != "rest":
            self.budget[bucket] = seen
            return
        if not isinstance(reset, (int, float)):
            # A reading that names no window cannot say which counter it is; with counters known it would only
            # replace the poorest one with a figure mode() treats as no reading at all.
            if not rest_counters(self.budget):
                self.budget[bucket] = seen
            else:
                self.settle_rest()  # still drop a counter whose window ended, so the poorest live one shows
            return
        self.budget["restCounters"] = merge_counter(rest_counters(self.budget), seen)
        self.settle_rest()

    def settle_rest(self) -> None:
        """budget["rest"] is the core counter with the least left. GitHub answers one token's REST calls from
        two "core" counters with their own hourly windows (measured 2026-10-30: /actions/runs/N and
        /actions/workflows/N report one, resetting at :44; /rate_limit, pulls, jobs and check runs report the
        other, resetting at :10), and the headers and /rate_limit name both "core". Keeping only the last
        answer made the shared reading jump between them (3126 left at 05:28Z, 0 at 05:33Z), which read as a
        3000-call burst nobody logged, and let the gh guard and this daemon spend freely from a counter that
        was already spent. Every live counter is kept (restCounters, at most REST_COUNTERS) and the poorest
        one is what everything else reads; a counter past its reset is dropped. With no live counter the last
        reading stays as it was before restCounters existed (mode() treats a passed reset as a fresh hour)."""
        self.settle_counters("rest")

    def settle_counters(self, bucket: str) -> None:
        """settle_rest for BUCKET ("rest": restCounters, "graphql": graphqlCounters)."""
        key = "restCounters" if bucket == "rest" else "graphqlCounters"
        counters = rest_counters(self.budget, key)
        cur = self.budget.get(bucket)
        if isinstance(cur, dict) and isinstance(cur.get("reset"), (int, float)) and isinstance(cur.get("remaining"), int):
            # the reading itself counts too: a budget.json from before restCounters, or one lowered in place
            seen_at = cur.get("seenAt")
            counters = merge_counter(counters, {**cur, "seenAt": seen_at if isinstance(seen_at, (int, float)) else self.now})
        live = [c for c in counters if c["reset"] > self.now]
        live = sorted(live, key=lambda c: c["seenAt"], reverse=True)[:REST_COUNTERS]
        if not live:
            self.budget.pop(key, None)
            return
        self.budget[key] = sorted(live, key=lambda c: c["reset"])
        self.budget[bucket] = dict(min(live, key=lambda c: (c["remaining"], -c["seenAt"])))

    def refresh_budget(self) -> None:
        """Read the quota from GitHub when this host's view has gone stale.

        The quota is one pool per account, not per machine, so the glaeda daemons on cosmic-gray,
        huge-blue, cmux16, air-blue and big-red are spending the same 5000/h. They need no ledger
        between them: they need a view that is not old. Until now the budget was learned only as a
        side effect of the daemon's own requests, so a host that was not polling worked from
        whatever it last happened to see -- big-red believed a REST figure 124 hours old while the
        account was in fact nearly spent (2026-10-21).

        GET /rate_limit reports every resource family at once and does not count against either
        primary limit (only against the secondary limit, which one call per BUDGET_REFRESH is
        nowhere near), so this costs nothing and every host is at most that far behind the truth.
        It is not gated on mode() or backoff for that reason -- it is also how the daemon learns
        the quota came back. A refusal (a dead token, a secondary limit) backs off instead of
        being retried and re-reported every tick.
        """
        if BUDGET_REFRESH <= 0 or self.now < self.budget_retry or self.clock() < self.secondary_until:
            return
        # REST is fresh when every core counter was seen lately, or /rate_limit answered lately: it reports only
        # one of the counters (settle_rest), so a counter it cannot see must not force a read every tick, and a
        # fresh hidden counter must not keep the one it can see from being refreshed.
        counters = rest_counters(self.budget)
        if counters:
            oldest = min(c["seenAt"] for c in counters)
            rest_seen = max(oldest, self.rate_limit_at) if self.rate_limit_at > float("-inf") else oldest
        else:
            rest_seen = (self.budget.get("rest") or {}).get("seenAt")
        # GraphQL the same way (graphqlCounters): /rate_limit reports one of its two counters, so a poorer one it cannot
        # see is fresh enough once /rate_limit answered lately, or that counter would force a read every tick.
        gql = rest_counters(self.budget, "graphqlCounters")
        if gql:
            oldest = min(c["seenAt"] for c in gql)
            gql_seen = max(oldest, self.rate_limit_at) if self.rate_limit_at > float("-inf") else oldest
        else:
            gql_seen = (self.budget.get("graphql") or {}).get("seenAt")
        seen = [rest_seen, gql_seen]
        ages = [self.now - t for t in seen if isinstance(t, (int, float))]
        if len(ages) == 2 and max(ages) < BUDGET_REFRESH:
            return  # every bucket's view is recent enough; a bucket never seen always refreshes
        try:
            with self.calling("budget"):
                status, _, doc = self.request("GET", "/rate_limit", free=True)
        except OutOfTime:
            return  # the tick ran long; the next one refreshes
        except (WatchError, OSError) as error:
            return self.budget_failed(describe(error))
        if status != 200 or not isinstance(doc, dict):
            return self.budget_failed(f"HTTP {status}")
        resources = doc.get("resources")
        if not isinstance(resources, dict):
            return self.budget_failed("no resources in the answer")
        self.budget_retry = 0.0
        self.rate_limit_at = self.now
        for bucket, family in (("rest", "core"), ("graphql", "graphql")):
            seen = resources.get(family)
            if isinstance(seen, dict):
                self.note_budget(bucket, seen.get("limit"), seen.get("remaining"), seen.get("reset"))

    def budget_failed(self, why: str) -> None:
        """Report it once and leave /rate_limit alone for BUDGET_RETRY. Reporting it every tick
        rewrote daemon.json every tick (an error is a reason to write a heartbeat early), which
        turned a broken token into a busy loop on the disk."""
        self.errors.append(f"rate_limit: {why}")
        self.budget_retry = self.now + BUDGET_RETRY

    # -- requests

    def request(self, method: str, path: str, body: dict | None = None, etag: str | None = None,
                free: bool = False, content: bool = False) -> tuple[int, dict, Any]:
        """One GitHub request.

        content: a write from the outbox, whose throttling (GitHub's secondary limit on content
        creation) holds the outbox, not the read buckets.
        free: /rate_limit, which counts against no primary limit. Counting it as a REST request
        would overstate the spend of the very call that reads the spend."""
        if time.monotonic() >= self.tick_deadline:
            raise OutOfTime
        bucket = "graphql" if path == "/graphql" else "rest"
        if not self.secondary_admit(bucket, 1):
            # never sent: any request during a secondary hold (a write, a free /rate_limit) would only extend it
            raise WatchError(f"held: GitHub's secondary rate limit, {max(0, int(self.secondary_until - self.clock()))}s left")
        if self.upstream() is not None:
            raise WatchError("this host reads GitHub through its upstream (upstream.json) and has no login")
        if self.token is None:
            self.token = self.token_source()
        headers = {"Authorization": f"Bearer {self.token}", "Accept": "application/vnd.github+json",
                   "User-Agent": "glaeda-gh", "X-GitHub-Api-Version": "2022-11-28"}
        if etag:
            headers["If-None-Match"] = etag
        raw_body = json.dumps(body).encode() if body is not None else None
        if raw_body is not None:
            headers["Content-Type"] = "application/json"
        # The outbox -- a write and the lookups that keep it from landing twice -- is what sessions
        # asked for, at most one write per POST_SPACING, and would cost the same through gh. The share
        # caps the daemon's polling, so the outbox is neither counted against it nor held by it:
        # holding a lander's write until the hour turns would be an outage, not a saving.
        write = self.writing
        charged = bucket == "rest" and not free and not write
        if charged:
            # Charged before it is sent, and refunded only when GitHub says it was free (a 304): a
            # request whose answer never arrives (a body timeout) may still have been counted by
            # GitHub. The request's own minute, not the tick's: a tick can run TICK_BUDGET past its
            # start, and dating its requests early would let them leave the hour's window early.
            minute = int(self.clock() // 60)
            self.charge_rest(minute, 1)
        try:
            status, h, raw = self.transport(method, API + path, headers, raw_body)
        except BaseException:
            if bucket == "rest":  # never answered, but GitHub may have counted it (as charge_rest above assumes)
                self.note_spend("rest", route_of(method, path), 0 if free else 1)
            raise
        if charged and status == 304:
            self.charge_rest(minute, -1)
        if bucket == "rest":  # GraphQL's points are known from its answer (graphql)
            self.note_spend("rest", route_of(method, path), 0 if free or status == 304 else 1)
        # `free` is /rate_limit, which costs no quota: counting it as a REST request would overstate
        # what the daemon spends.
        self.sent.append((self.now, "free" if free else "rest304" if bucket == "rest" and status == 304
                          else "write" if bucket == "rest" and write else bucket))
        if status == 401:
            self.token = None  # re-read from gh next time
        if "x-ratelimit-remaining" in h and h.get("x-ratelimit-resource", "core") in {"core", "graphql"}:
            try:
                reset = float(h.get("x-ratelimit-reset", ""))
            except ValueError:
                reset = None
            self.note_budget(bucket, h.get("x-ratelimit-limit"), h.get("x-ratelimit-remaining"), reset, path)
        try:
            doc = json.loads(raw) if raw else None
        except ValueError:
            doc = None
        message = str(doc.get("message") or "") if isinstance(doc, dict) else ""
        limited = bucket == "graphql" and isinstance(doc, dict) and any(
            isinstance(e, dict) and e.get("type") == "RATE_LIMITED" for e in doc.get("errors") or [])
        if status in {403, 429} and ((SECONDARY.search(message) and not (content and CONTENT_ONLY.search(message))) or (
                not content and h.get("retry-after") and h.get("x-ratelimit-remaining") != "0")):
            # A write's refusal too, unless GitHub says it blocks only content creation: then the outbox holds
            # itself (post_hold_for) and the reads go on, as they may.
            self.secondary_hit(bucket, h.get("retry-after"))
        elif (status in {403, 429} and not content and (h.get("retry-after") or h.get("x-ratelimit-remaining") == "0")) \
                or limited:
            # the primary limit: this bucket only; its reads move to the other one (route, tick)
            self.gql_limited = self.gql_limited or bucket == "graphql"
            try:
                wait = float(h["retry-after"]) if h.get("retry-after") else float(h.get("x-ratelimit-reset", 0)) - self.now
            except ValueError:
                wait = CYCLE
            self.backoff[bucket] = self.now + max(CYCLE, wait)
        elif status < 400 and not free:
            self.secondary_strikes = 0  # a clean answer: the next secondary hold starts short again
        return status, h, doc

    def secondary_admit(self, bucket: str, n: int) -> bool:
        """Whether n more read requests may go to GitHub now: not while this daemon's own secondary hold
        lasts, nor while the host's pacer (PACE_FILE) holds every caller on the account."""
        self.adopt_pace_hold()
        return self.clock() >= self.secondary_until

    def adopt_pace_hold(self) -> None:
        """Take on the pacer's hold (another caller met the secondary limit), so both buckets stop for it."""
        doc = read_json(BASE / PACE_FILE)
        hold = doc.get("hold") if isinstance(doc, dict) else None
        until = hold.get("until") if isinstance(hold, dict) else None
        if isinstance(until, (int, float)) and not isinstance(until, bool) and until > max(self.clock(), self.secondary_until):
            until = min(until, self.clock() + PACE_HOLD_MAX)  # a corrupt far future holds an hour at most
            if until > self.secondary_until:
                self.secondary_until = until
                for b in self.backoff:
                    self.backoff[b] = max(self.backoff[b], until)
                log({"event": "secondary", "source": "pace", "hold": round(until - self.clock())})

    def report_secondary(self, hold: float) -> None:
        """Tell the host's pacer, when one is installed, so every other caller holds too. Best effort."""
        try:
            cli = PACE_CLI.resolve().parent / "gh_quota.py"
            if cli.is_file():
                run_bounded([sys.executable, "-I", os.fspath(cli), "secondary", "--retry-after", str(int(math.ceil(hold))),
                             "--source", "glaeda-gh"], PACE_DEADLINE)
        except (OSError, subprocess.SubprocessError) as error:
            self.errors.append(f"pace: {describe(error)}")

    def secondary_hit(self, bucket: str, retry_after: Any) -> None:
        """A secondary 403 or 429: hold both buckets (the limit is one for REST and GraphQL), for its
        Retry-After or the doubling back-off, whichever is longer. Never a retry within the same hold."""
        self.secondary_strikes += 1
        try:
            told = float(retry_after) if retry_after else 0.0
        except ValueError:
            told = 0.0
        hold = max(told, min(SECONDARY_BACKOFF_MAX, SECONDARY_BACKOFF * 2 ** (self.secondary_strikes - 1)))
        # from when the refusal arrived: a tick can run TICK_BUDGET past self.now, its start
        self.secondary_until = max(self.secondary_until, self.clock() + hold)
        for b in self.backoff:
            self.backoff[b] = max(self.backoff[b], self.secondary_until)
        log({"event": "secondary", "bucket": bucket, "hold": round(hold), "strikes": self.secondary_strikes})
        self.report_secondary(self.secondary_until - self.clock())

    # -- the outbox: content writes (comments, PRs, reviews) queued by `glaeda-gh post`

    def post_tick(self) -> None:
        """Send at most one queued write per tick, POST_SPACING after the last one and never while GitHub's
        secondary limit holds the outbox. Oldest first; a write waiting out its own retry is skipped."""
        self.adopt_pace_hold()
        if self.clock() < self.secondary_until:
            return  # a read met the secondary limit: writes wait it out too, as one account's
        if self.now < max(self.post_hold, self.post_at + POST_SPACING):
            return
        for path in sorted(outbox_dir().glob("*.json")) if outbox_dir().is_dir() else []:
            item = read_json(path)
            if not isinstance(item, dict) or item.get("id") != path.stem:
                with contextlib.suppress(OSError):
                    if self.now - path.stat().st_mtime > POST_UNREADABLE:
                        self.post_finish(path, {"id": path.stem}, error="unreadable queue entry")
                continue
            if (item.get("notBefore") or 0) > self.now:
                continue
            if item.get("joinedInto") and self.post_member(path, item):
                continue  # it goes out in (or went out with) its leader's comment: no request of its own
            if self.backoff["rest"] > self.now and not (item.get("kind") == "comment" and self.post_over_graphql(item)):
                continue  # REST's hour is spent (rest_out): it waits for the reset; a comment behind it goes over GraphQL
            self.writing = True
            try:
                with self.calling("outbox", str(item.get("repo") or "")):
                    self.post_one(path, item)
            except OutOfTime:
                pass
            except Exception as error:  # noqa: BLE001  a malformed entry (a key missing, an unknown kind) fails alone
                self.post_finish(path, item, error=f"bad queue entry: {describe(error)} at {error_site(error)}")
            finally:
                self.writing = False
            return

    def post_between(self) -> None:
        """post_tick between read batches: a read phase can take TICK_BUDGET, far longer than POST_SPACING."""
        tick_now = self.now
        self.now = time.time() if self.clock_real else self.now  # the outbox's own clock; the reads keep theirs
        try:
            self.post_tick()
        except Exception as error:  # noqa: BLE001
            self.errors.append(f"outbox: {describe(error)} at {error_site(error)}")
        finally:
            self.now = tick_now

    def post_hold_for(self, h: dict, path: Path, item: dict) -> None:
        try:
            wait = float(h["retry-after"]) if h.get("retry-after") else (
                float(h.get("x-ratelimit-reset", 0)) - self.now if h.get("x-ratelimit-remaining") == "0" else 0.0)
        except ValueError:
            wait = 0.0
        wait = max(wait, self.post_backoff) if wait <= 0 else wait
        self.post_backoff = min(POST_BACKOFF_MAX, self.post_backoff * 2)
        self.post_hold = self.now + max(POST_SPACING, wait)
        item["throttled"] = int(item.get("throttled") or 0) + 1
        item["holdUntil"] = self.post_hold
        write_json(path, item)
        log({"event": "post-throttled", "id": item["id"], "wait": round(wait)})

    def post_one(self, path: Path, item: dict) -> None:
        if item.get("delivered"):
            self.post_delivered(path, item)
            return
        if item.get("uncertain"):
            # The last attempt's answer was lost: it may have landed. Look before writing twice, and send only
            # when the look answered "not there"; a look that failed leaves it uncertain for the next try.
            found, looked = self.post_find(item)
            if found:
                self.post_delivered(path, item, found, note="found after a lost answer")
                return
            if not looked:
                self.post_at = self.now
                self.post_retry(path, item, "could not look for an earlier attempt", uncertain=True)
                return
        # a look that answered "not there": nothing landed, so a join may still be undone; it is resent over REST
        resend = bool(item.pop("uncertain", False))
        if item["kind"] == "comment" and not item.get("group"):
            self.post_join(path, item)
        elif item.get("group") and not item.get("delivered") \
                and self.thread_watched(str(item["repo"]), item["number"]):
            self.post_unjoin(path, item)  # a wait began watching the thread since the join: each goes out alone
        if item["kind"] == "comment" and not resend and self.post_over_graphql(item):
            return self.post_comment_graphql(path, item)
        method, api, body = post_request(item)
        write_json(path, {**item, "uncertain": True})  # a daemon that dies mid-request looks it up first
        try:
            status, h, doc = self.request(method, api, body, content=True)
        except WatchError as error:
            self.post_at = self.now
            self.post_retry(path, item, describe(error), uncertain=True)
            return
        except OutOfTime:
            write_json(path, item)  # raised before anything was sent
            raise
        self.post_at = self.now
        item["uncertain"] = False  # GitHub answered; a 5xx below sets it again
        doc = doc if isinstance(doc, dict) else {}
        text = json.dumps(doc)[:2000]
        if 200 <= status < 300:
            self.post_backoff = POST_BACKOFF
            note = self.post_after(item, doc)
            if item["kind"] == "comment":
                self.note_status(item, doc.get("node_id"), doc.get("id"), doc.get("html_url"))
            self.post_delivered(path, item, doc, note=note)
        elif self.rest_out(status, h, text):
            write_json(path, item)  # nothing was written: GraphQL posts it if it can, else it waits for REST's reset
        elif status in {403, 422, 429} and (THROTTLED.search(text) or status == 429 or h.get("retry-after")
                                            or h.get("x-ratelimit-remaining") == "0"):
            self.post_hold_for(h, path, item)
        elif status >= 500:
            self.post_retry(path, item, f"HTTP {status}", uncertain=True)  # a POST that 502s often landed
        elif status == 401:
            self.post_retry(path, item, f"HTTP {status}")
        elif item["kind"] == "pr" and status == 422 and "already exists" in text:
            found, _ = self.post_find(item)
            self.post_finish(path, item, url=found.get("html_url") if found else None,
                             note="a pull request for this head is already open",
                             error=None if found else f"HTTP 422: {doc.get('message') or 'already exists'}")
        else:
            errors = "; ".join(str(e.get("message") or e.get("code")) for e in doc.get("errors") or []
                               if isinstance(e, dict))
            self.post_finish(path, item, error=f"HTTP {status}: {doc.get('message') or ''}"
                             + (f" ({errors})" if errors else ""))

    def post_after(self, item: dict, doc: dict) -> str | None:
        """A new PR's requested reviewers (not content creation, so no spacing); a failure is a note."""
        if item["kind"] != "pr" or not item.get("reviewers") or not doc.get("number"):
            return None
        try:
            status, _, answer = self.request("POST", f"/repos/{item['repo']}/pulls/{doc['number']}/requested_reviewers",
                                             {"reviewers": item["reviewers"]}, content=True)
        except (WatchError, OutOfTime) as error:
            return f"reviewers not requested: {describe(error) if isinstance(error, WatchError) else 'out of time'}"
        if 200 <= status < 300:
            return None
        return f"reviewers not requested: HTTP {status} {(answer or {}).get('message', '') if isinstance(answer, dict) else ''}".strip()

    def post_delivered(self, path: Path, item: dict, doc: dict | None = None, note: str | None = None) -> None:
        """Checkpoint delivery before follow-up effects: a failed/interrupted regrade never replays content."""
        if doc is not None:
            item["delivered"] = {"url": doc.get("html_url"), "number": doc.get("number"), "note": note}
            first = next((line for line in str(item.get("body") or "").splitlines() if line.strip()), "")
            receipt = RISK_RECEIPT.match(first)
            heads = re.findall(r"(?<![\w])[0-9a-f]{40}(?![\w])", first)
            user = doc.get("user") or {}
            if (item.get("kind") in {"comment", "review"} and item.get("repo") == "manaflow-ai/cmux"
                    and receipt and "self" not in receipt.group(1).lower() and len(heads) == 1
                    and isinstance(user, dict) and user.get("type") == "User"
                    and doc.get("author_association") in {"OWNER", "MEMBER", "COLLABORATOR"}):
                item["riskRegrade"] = {"state": "pending", "head": heads[0]}
            write_json(path, item)
        regrade = item.get("riskRegrade")
        if regrade and regrade["state"] == "pending":
            try:
                self.post_risk_regrade(path, item)
            except OutOfTime:
                raise  # the next outbox turn resumes follow-up work, never the delivered POST
            except Exception as error:  # noqa: BLE001 preserve successful delivery even if follow-up fails
                regrade.update(state="failed", error=describe(error))
            write_json(path, item)
        delivery = item["delivered"]
        note = delivery.get("note")
        if regrade and regrade["state"] in {"failed", "uncertain"}:
            note = "; ".join(filter(None, [note, f"risk regrade {regrade['state']}: {regrade.get('error', '')}"]))
        self.post_finish(path, item, url=delivery.get("url"), number=delivery.get("number"), note=note)

    def post_risk_regrade(self, path: Path, item: dict) -> None:
        """One fresh PR read and at most one label removal, using the existing unlabeled event.

        The trusted base classifier restores its tier and decides evidence. No code is fetched or run.
        Record uncertainty before DELETE; after a crash we report it rather than repeat an unknown effect.
        """
        regrade = item["riskRegrade"]
        if self.mode("rest") == "stop":
            regrade.update(state="failed", error="REST budget stopped")
            return
        status, _, pull = self.request("GET", f"/repos/{item['repo']}/pulls/{item['number']}")
        if status != 200 or not isinstance(pull, dict):
            regrade.update(state="failed", error=f"PR metadata HTTP {status}")
            return
        if (pull.get("state") != "open" or (pull.get("base") or {}).get("ref") != "feat-cmux-next"
                or (pull.get("head") or {}).get("sha") != regrade["head"]):
            regrade.update(state="skipped", reason="PR is not open on the receipt's head and feat-cmux-next base")
            return
        labels = [label.get("name") for label in pull.get("labels") or [] if isinstance(label, dict)
                  and label.get("name") in {"risk:low", "risk:medium", "risk:normal", "risk:high"}]
        if len(labels) != 1:
            regrade.update(state="skipped", reason="no single current risk tier")
            return
        if labels[0] != "risk:high":
            # Only risk:high reads a receipt (cmux scripts/ci/risk_tier.py: "Only looked up for high"). A low or
            # normal label removal changed no verdict, but its unlabeled and the grader's relabel each started
            # every labeled-triggered workflow again: a whole CI run, webview suite included, that merge-guard
            # then waited on (cmux#29666, 2026-10-31).
            regrade.update(state="skipped", reason=f"{labels[0]} reads no receipt")
            return
        if self.mode("rest") == "stop":
            regrade.update(state="failed", error="REST budget stopped")
            return
        regrade.update(state="uncertain", label=labels[0], error="label write interrupted; inspect the risk run")
        write_json(path, item)
        try:
            status, h, answer = self.request("DELETE", f"/repos/{item['repo']}/issues/{item['number']}/labels/"
                                            + urllib.parse.quote(labels[0], safe=""), content=True)
        except OutOfTime:
            regrade.update(state="pending")  # request refused before sending
            write_json(path, item)
            raise
        if 200 <= status < 300:
            regrade.update(state="triggered")
            regrade.pop("error", None)
        else:
            regrade.update(state="failed", error=f"label removal HTTP {status}")
            text = json.dumps(answer)[:2000]
            if self.rest_out(status, h, text):
                pass  # REST's hour, not a secondary limit: comments go on over GraphQL
            elif status in {403, 422, 429} and (status == 429 or h.get("retry-after")
                    or h.get("x-ratelimit-remaining") == "0" or THROTTLED.search(text)):
                self.post_hold_for(h, path, item)

    def post_find(self, item: dict) -> tuple[dict | None, bool]:
        """(this write if it already landed, whether the look got an answer): the open PR for its head,
        or a comment or review with the same body posted since it was queued."""
        repo, since = item["repo"], dt.datetime.fromtimestamp(item["queuedAt"] - 60, dt.timezone.utc)
        if item["kind"] == "pr":
            head = item["head"] if ":" in item["head"] else f"{repo.split('/')[0]}:{item['head']}"
            api = f"/repos/{repo}/pulls?state=open&head={urllib.parse.quote(head)}&base={urllib.parse.quote(item['base'])}"
        elif item["kind"] == "comment":
            api = f"/repos/{repo}/issues/{item['number']}/comments?per_page=100&since={since.strftime('%Y-%m-%dT%H:%M:%SZ')}"
        else:
            api = f"/repos/{repo}/pulls/{item['number']}/reviews?per_page=100"
        try:
            status, h, doc = self.request("GET", api)
            last = re.search(r'<([^>]+)>;\s*rel="last"', h.get("link") or "")
            if status == 200 and last and last.group(1).startswith(API + "/"):
                status, _, doc = self.request("GET", last.group(1)[len(API):])
        except WatchError:
            return None, False
        if status != 200 or not isinstance(doc, list):
            return None, False
        for found in reversed(doc):
            if isinstance(found, dict) and (item["kind"] == "pr" or (found.get("body") or "") == item["body"]):
                if found.get("html_url"):
                    return found, True
        return None, True

    def post_retry(self, path: Path, item: dict, error: str, uncertain: bool = False) -> None:
        item["attempts"] = int(item.get("attempts") or 0) + 1
        item["lastError"] = error
        item["uncertain"] = uncertain
        if item["attempts"] >= POST_ATTEMPTS:
            self.post_finish(path, item, error=f"gave up after {item['attempts']} attempts: {error}")
            return
        item["notBefore"] = self.now + POST_RETRY * item["attempts"]
        write_json(path, item)

    def post_finish(self, path: Path, item: dict, url: str | None = None, number: Any = None,
                    note: str | None = None, error: str | None = None) -> None:
        done = {k: v for k, v in item.items() if k not in {"body", "ownBody", "notBefore", "holdUntil"}}
        done.update({"state": "failed" if error else "posted", "url": url, "number": number, "note": note,
                     "error": error, "finishedAt": self.now})
        write_json(posted_dir() / path.name, done)
        path.unlink(missing_ok=True)
        for member in item.get("group") or []:  # one comment for all of them: each caller gets its URL
            mpath = outbox_dir() / f"{member}.json"
            other = read_json(mpath)
            if isinstance(other, dict) and other.get("joinedInto") == item.get("id"):
                self.post_finish(mpath, other, url=url, number=number, error=error,
                                 note=f"posted in one comment with {len(item['group'])} other queued comment"
                                      f"{'s' if len(item['group']) > 1 else ''} for this thread")
        with contextlib.suppress(Exception):  # answers this host's gh cache kept from before the write
            gh_cache_note_write(str(item.get("repo") or "").lower() or None, time.time(), gh_cache_post_scopes(item))
        log({"event": "post", "id": done.get("id"), "state": done["state"], "url": url, "error": error})

    # -- the outbox's comments: joined per thread, over the richer bucket, a writer's status edited in place

    @staticmethod
    def joinable(item: dict) -> bool:
        """Plain prose only: never anything a wait, a bot or a reader keys on (a slash command, an @mention, an HTML
        marker, a review receipt), nor a status, nor a write already tried."""
        body = str(item.get("body") or "")
        first = next((line for line in body.splitlines() if line.strip()), "").strip()
        return (item.get("kind") == "comment" and not item.get("status") and not item.get("uncertain")
                and not item.get("delivered") and not item.get("group") and not item.get("joinedInto")
                and not int(item.get("attempts") or 0) and isinstance(item.get("by"), str) and bool(item["by"])
                and not first.startswith(("<!--", "/")) and not RISK_RECEIPT.match(first)
                and not JOIN_MENTION.search(body))

    def post_join(self, path: Path, item: dict) -> None:
        """Join the comments queued for this thread within POST_JOIN_WINDOW of ITEM into ITEM's comment, in queue
        order. Each member is marked joinedInto first, then the leader is written with the joined body and its
        group: a crash between the two leaves members whose leader does not name them, and those are released
        (post_member) instead of being posted twice."""
        if not self.joinable(item) or self.thread_watched(str(item["repo"]), item["number"]):
            return  # a wait watching the thread may match a member's first line: each goes out on its own
        # at most what every comment reader keeps of a body (COMMENT_BODY_MAX characters): a member past it would
        # drop out of the cached comment a wait matches (`--match READY` after a long comment)
        members, size = [], len(str(item["body"]))
        for other_path in sorted(outbox_dir().glob("*.json")):  # queue order
            if other_path.stem <= path.stem:
                continue  # the leader, and what was queued before it
            other = read_json(other_path)
            if not isinstance(other, dict) or other.get("id") != other_path.stem:
                continue
            if other.get("kind") not in {"comment", "review"} or other.get("repo") != item.get("repo") \
                    or other.get("number") != item.get("number"):
                continue  # another thread's write: it does not stand between this thread's comments
            if (not self.joinable(other) or other.get("by") != item.get("by") or (other.get("notBefore") or 0) > self.now
                    or not 0 <= float(other.get("queuedAt") or 0) - float(item.get("queuedAt") or 0) <= POST_JOIN_WINDOW):
                break  # a write to this thread that stays on its own: nothing queued after it moves ahead of it
            grown = size + len(POST_JOIN_RULE) + len(str(other["body"]))
            if grown > COMMENT_BODY_MAX:
                break
            members.append((other_path, other))
            size = grown
        if not members:
            return
        for other_path, other in members:
            write_json(other_path, {**other, "joinedInto": item["id"]})
        item["group"] = [other["id"] for _, other in members]
        item["ownBody"] = item["body"]
        item["body"] = POST_JOIN_RULE.join([str(item["body"])] + [str(other["body"]) for _, other in members])
        write_json(path, item)
        log({"event": "post-join", "id": item["id"], "joined": item["group"]})

    def post_unjoin(self, path: Path, item: dict) -> None:
        """Undo a join not yet sent: the leader takes back its own body and its members, no longer named, are released
        (post_member) and sent on their own."""
        item["body"] = item.pop("ownBody", item["body"])
        released = item.pop("group", [])
        write_json(path, item)
        log({"event": "post-unjoin", "id": item["id"], "released": released})

    def post_member(self, path: Path, item: dict) -> bool:
        """A member of a joined comment: True while its leader holds it (or once it took the leader's answer),
        False when the leader does not name it (a join cut short), so it is sent on its own."""
        leader = item["joinedInto"]
        queued = read_json(outbox_dir() / f"{leader}.json")
        if isinstance(queued, dict) and item["id"] in (queued.get("group") or []):
            return True
        done = read_json(posted_dir() / f"{leader}.json")
        if not isinstance(queued, dict) and isinstance(done, dict) and item["id"] in (done.get("group") or []):
            self.post_finish(path, item, url=done.get("url"), number=done.get("number"), error=done.get("error"),
                             note="posted in one comment with other queued comments for this thread")
            return True
        item.pop("joinedInto", None)
        write_json(path, item)
        return False

    def outbox_richness(self, bucket: str) -> float:
        """richness() for the outbox: the daemon's own REST share does not hold sessions' writes."""
        if self.backoff[bucket] > self.now:
            return -1.0
        seen = self.budget.get(bucket) or {}
        limit = seen.get("limit") or 5000
        reserve = self.policy["floors"][bucket][1]
        if not seen or (seen.get("reset") or 0) <= self.now:
            return max(0, limit - reserve) / FULL_WINDOW
        return max(0, seen.get("remaining", limit) - reserve) / max(seen["reset"] - self.now, RICH_WINDOW_MIN)

    def post_over_graphql(self, item: dict) -> bool:
        """A comment goes through GraphQL's addComment while GraphQL is the richer bucket, as the reads choose (a
        lost answer is looked for, and resent, over REST)."""
        if item.get("uncertain"):
            return False
        if self.status_editable(item) and self.outbox_richness("graphql") > 0:
            return True  # only GraphQL edits in place: a writer's status goes there while it has any points
        seen = self.budget.get("graphql") or {}
        if not seen or (seen.get("reset") or 0) <= self.now:
            return False  # no live GraphQL reading: REST, as before
        return self.outbox_richness("graphql") > max(self.outbox_richness("rest"), 0.0)

    def status_editable(self, item: dict) -> dict | None:
        """The writer's earlier status comment on this thread that ITEM may replace in place (not yet checked to be
        the thread's last: post_comment_graphql reads that), else None."""
        if item.get("kind") != "comment" or not item.get("status"):
            return None
        statuses = read_json(BASE / POST_STATUSES)
        thread = f"{str(item['repo']).lower()}#{int(item['number'])}"
        prior = statuses.get(thread) if isinstance(statuses, dict) else None
        ok = (isinstance(prior, dict) and prior.get("key") == item["status"] and prior.get("by") == item.get("by")
              and isinstance(prior.get("nodeId"), str) and self.now - float(prior.get("at") or 0) < POST_STATUS_MAX
              and not self.thread_watched(str(item["repo"]), item["number"]))
        return prior if ok else None

    def thread_watched(self, repo: str, number: Any) -> bool:
        """A comment wait is watching this thread: an edit in place would be a comment it never sees as new."""
        return (watch_dir() / file_name(f"comment:{repo.lower()}#{int(number)}")).exists()

    def note_status(self, item: dict, node_id: Any, database_id: Any, url: Any) -> None:
        """Remember (or forget) the last status comment the outbox posted on this thread."""
        thread = f"{str(item['repo']).lower()}#{int(item['number'])}"
        statuses = read_json(BASE / POST_STATUSES)
        statuses = statuses if isinstance(statuses, dict) else {}
        if item.get("status") and isinstance(node_id, str) and node_id:
            statuses[thread] = {"by": item.get("by"), "key": item["status"], "nodeId": node_id, "id": database_id,
                                "url": url, "at": self.now}
        elif thread not in statuses:
            return
        else:
            statuses.pop(thread)
        statuses = {k: v for k, v in statuses.items() if isinstance(v, dict)
                    and self.now - float(v.get("at") or 0) < POST_STATUS_MAX}
        write_json(BASE / POST_STATUSES, statuses)

    def post_gql(self, query: str, variables: dict, reason: str) -> tuple[int, dict, Any]:
        """One outbox GraphQL request: content, so a secondary limit holds the outbox; logged in the spend log."""
        status, h, doc = self.request("POST", "/graphql", {"query": query, "variables": variables}, content=True)
        rate = ((doc.get("data") or {}).get("rateLimit") or {}) if isinstance(doc, dict) else {}
        cost = rate.get("cost") if isinstance(rate, dict) and isinstance(rate.get("cost"), int) else 1
        self.gql_log.append((self.now, reason, cost))
        self.note_spend("graphql", reason, 1, cost)
        return status, h, doc

    @staticmethod
    def gql_throttled(status: int, h: dict, doc: Any) -> bool:
        """A secondary limit, as the REST path tells one: a lasting 403 (scope, SSO, a block) fails the item
        instead of holding every write."""
        return (status == 429 or bool(h.get("retry-after"))
                or (status in {403, 422, 200} and bool(THROTTLED.search(json.dumps(doc)[:4000] if doc else ""))))

    @staticmethod
    def gql_transient(errors: list[dict]) -> bool:
        """GitHub's own failure answered as HTTP 200 (an internal error, a timeout): retried like a 5xx. A refusal
        that names the request (NOT_FOUND, FORBIDDEN, a validation error) still fails the write."""
        return bool(errors) and not any(e.get("type") in GQL_REFUSALS for e in errors) and all(
            e.get("type") in GQL_TRANSIENT_TYPES or GQL_TRANSIENT.search(str(e.get("message") or ""))
            for e in errors)

    def rest_out(self, status: int, h: dict, text: str) -> bool:
        """REST's own hourly limit (a 403 or 429 with no requests left, and no secondary limit named): nothing was
        written. REST is backed off until its reset, so the next turn sends a comment over GraphQL (post_over_graphql)
        and only writes REST alone can make wait, as gql_out does the other way. Before, it held every queued write
        until REST's reset: on 2026-11-10 receipts queued 10 to 48 deep in an hour while GraphQL had points."""
        if status not in {403, 429} or h.get("x-ratelimit-remaining") != "0" or h.get("retry-after") \
                or THROTTLED.search(text):
            return False
        try:
            until = float(h.get("x-ratelimit-reset") or 0)
        except ValueError:
            until = 0.0
        self.backoff["rest"] = max(self.backoff["rest"], until, self.now + CYCLE)
        log({"event": "post-rest-out", "until": round(self.backoff["rest"])})
        return True

    def gql_out(self, status: int, h: dict, doc: Any) -> bool:
        """GraphQL's own hourly limit (a RATE_LIMITED error, or no points left and no secondary limit named): nothing
        ran. GraphQL is backed off until its reset, so the next turn sends the write over REST (post_over_graphql)
        instead of holding every queued write."""
        # only a definite refusal: every error is RATE_LIMITED, or a 403 for the spent counter. A 200 that spent the
        # last point on an internal error may still have written: that one is retried uncertain (post_find first)
        errors = [e for e in (doc.get("errors") or []) if isinstance(e, dict)] if isinstance(doc, dict) else []
        limited = bool(errors) and all(e.get("type") == "RATE_LIMITED" for e in errors)
        spent = (h.get("x-ratelimit-remaining") == "0" and status == 403
                 and not THROTTLED.search(json.dumps(doc)[:4000] if doc else ""))
        if not (limited or spent):
            return False
        try:
            until = float(h.get("x-ratelimit-reset") or 0)
        except ValueError:
            until = 0.0
        self.backoff["graphql"] = max(self.backoff["graphql"], until, self.now + CYCLE)
        return True

    def post_comment_graphql(self, path: Path, item: dict) -> None:
        """addComment (or, for the writer's own status, updateIssueComment) with the same queue semantics as REST:
        uncertain while in flight, held on a secondary limit, retried on a 5xx, failed on a refusal."""
        repo, number = str(item["repo"]), int(item["number"])
        owner, name = repo.split("/", 1)
        thread = f"{repo.lower()}#{number}"
        subjects = read_json(BASE / POST_SUBJECTS)
        subjects = subjects if isinstance(subjects, dict) else {}
        prior = self.status_editable(item)
        editable = prior is not None
        subject, last = subjects.get(thread), None
        if subject is None or editable:
            try:
                status, h, doc = self.post_gql(SUBJECT_QUERY, {"o": owner, "r": name, "n": number}, "outbox-subject")
            except WatchError as error:
                self.post_at = self.now
                return self.post_retry(path, item, describe(error))  # a read: nothing was written
            node = (((doc.get("data") or {}).get("repository") or {}).get("issueOrPullRequest") or {}) \
                if isinstance(doc, dict) else {}
            if self.gql_out(status, h, doc):
                write_json(path, item)  # GraphQL is out (backed off): the next turn posts over REST
                return None
            if self.gql_throttled(status, h, doc):
                return self.post_hold_for(h, path, item)
            if status == 401:
                return self.post_retry(path, item, "graphql subject: HTTP 401")  # request() re-reads the token
            if status != 200 or not isinstance(node, dict) or not node.get("id"):
                if (status >= 500 or not isinstance(doc, dict) or not doc.get("errors")
                        or self.gql_transient([e for e in doc["errors"] if isinstance(e, dict)])):
                    return self.post_retry(path, item, f"graphql subject: HTTP {status}")
                message = str(((doc.get("errors") or [{}])[0] or {}).get("message") or "")[:200]
                return self.post_finish(path, item, error=f"graphql: {message or 'no such issue or pull request'}")
            subject = subjects[thread] = node["id"]
            write_json(BASE / POST_SUBJECTS, dict(list(subjects.items())[-2000:]))
            nodes = (node.get("comments") or {}).get("nodes") or []
            last = nodes[-1] if nodes and isinstance(nodes[-1], dict) else None
        if item.get("group") and self.thread_watched(repo, number):
            self.post_unjoin(path, item)  # a wait began watching during the lookup: the leader goes out alone
        edit = bool(editable and last and last.get("id") == prior.get("nodeId"))
        if edit and isinstance(prior.get("id"), int):
            # before the edit is sent: an edit that lands behind a lost answer is still one the waits see
            edits = read_json(BASE / POST_EDITS)
            edits = [x for x in edits if isinstance(x, int) and x != prior["id"]] if isinstance(edits, list) else []
            write_json(BASE / POST_EDITS, (edits + [prior["id"]])[-POST_EDITS_KEEP:])
        write_json(path, {**item, "uncertain": True})
        try:
            if edit:
                status, h, doc = self.post_gql(EDIT_COMMENT, {"c": prior["nodeId"], "b": item["body"]}, "outbox")
            else:
                status, h, doc = self.post_gql(ADD_COMMENT, {"s": subject, "b": item["body"]}, "outbox")
        except WatchError as error:
            self.post_at = self.now
            return self.post_retry(path, item, describe(error), uncertain=True)
        except OutOfTime:
            write_json(path, item)  # raised before anything was sent
            raise
        self.post_at = self.now
        item["uncertain"] = False
        doc = doc if isinstance(doc, dict) else {}
        data = doc.get("data") if isinstance(doc.get("data"), dict) else {}
        made = ((((data.get("addComment") or {}).get("commentEdge") or {}).get("node"))
                or ((data.get("updateIssueComment") or {}).get("issueComment")))
        errors = [e for e in doc.get("errors") or [] if isinstance(e, dict)]
        text = json.dumps(errors)[:2000]
        if status == 200 and isinstance(made, dict) and made.get("url"):
            self.post_backoff = POST_BACKOFF
            self.note_status(item, made.get("id"), made.get("databaseId"), made.get("url"))
            note = "edited this writer's earlier status comment, the thread's last" if edit else None

            author = made.get("author") if isinstance(made.get("author"), dict) else {}
            # the REST answer's shape, for post_delivered's risk-receipt check
            answer = {"html_url": made["url"], "author_association": made.get("authorAssociation"),
                      "user": {"type": author.get("__typename"), "login": author.get("login")}}
            return self.post_delivered(path, item, answer, note=note)
        if status == 401:
            return self.post_retry(path, item, "graphql: HTTP 401")  # refused before it ran; request() re-reads the token
        if self.gql_out(status, h, doc):
            write_json(path, item)  # not run: GraphQL is out, so the next turn sends it over REST
            return None
        if self.gql_throttled(status, h, doc):
            return self.post_hold_for(h, path, item)
        if status >= 500 or (status == 200 and (not errors or self.gql_transient(errors))):
            # it may have landed: the retry looks for it over REST first (post_find)
            return self.post_retry(path, item, f"graphql: HTTP {status}", uncertain=True)
        if edit and any(e.get("type") == "NOT_FOUND" for e in errors):
            self.note_status({**item, "status": None}, None, None, None)  # deleted: post it as a new comment
            write_json(path, item)
            return None
        said = "; ".join(str(e.get("message") or e.get("type")) for e in errors) or str(doc.get("message") or "")
        return self.post_finish(path, item, error=f"graphql: HTTP {status}: {said}"[:300])

    def post_prune(self) -> None:
        for path in posted_dir().glob("*.json") if posted_dir().is_dir() else []:
            with contextlib.suppress(OSError):
                if self.now - path.stat().st_mtime > POST_KEEP:
                    path.unlink()

    # -- one tick

    def watches(self) -> list[dict]:
        """Live watch entries; expired ones are removed here."""
        out = []
        for path in sorted(watch_dir().glob("*.json")) if watch_dir().is_dir() else []:
            doc = read_json(path)
            try:
                age = self.now - path.stat().st_mtime
            except OSError:
                continue
            if not isinstance(doc, dict) or "key" not in doc:
                path.unlink(missing_ok=True)
                continue
            key = doc["key"]
            try:
                parse_key(split_key(key)[0], key.split(":", 1)[1])
            except (WatchError, ValueError, IndexError):
                path.unlink(missing_ok=True)
                continue
            cached = read_cache(key)
            kind = split_key(key)[0]
            # a comment watch only serves a wait that is running: it touches the file every 30 s
            done = kind == "comment" or (kind != "head" and cached is not None and terminal(kind, cached.get("data")))
            if age > IDLE_EXPIRY or (done and age > TERMINAL_GRACE):
                path.unlink(missing_ok=True)
                continue
            asked = doc.get("consumers") if isinstance(doc.get("consumers"), dict) else {}
            waited = doc.get("waitedAt") if isinstance(doc.get("waitedAt"), (int, float)) else None
            began = doc.get("waitBegan") if isinstance(doc.get("waitBegan"), (int, float)) else None
            since = doc.get("since")
            since = since if isinstance(since, (int, float)) and not isinstance(since, bool) else None
            entry = {"key": key, "jobs": bool(doc.get("jobs")), "cache": cached, "touched": self.now - age,
                     "waitedAt": waited, "waitBegan": began, "readers": readers_of(doc, time.time()),
                     "reader": doc.get("reader") if isinstance(doc.get("reader"), str) else "",
                     "consumers": {str(k): float(v) for k, v in asked.items() if isinstance(v, (int, float))},
                     "since": since}
            if self.once_answered(entry):
                path.unlink(missing_ok=True)
                continue
            out.append(entry)
        return out

    def once_answered(self, e: dict) -> bool:
        """Whether nothing live needs this PR or run watch any more: no wait is on it, its last interest was a one-off
        (a `status` read, a sweep over many PRs: one ask, not renewed ONCE_SPAN after the first) or the wait that
        ended, and the daemon has read it without error since that interest. Such a watch used to be polled every
        cycle for IDLE_BACKOFF_AFTER and then backed off until IDLE_EXPIRY: about seven reads for one ask, so one
        sweep's `status pr` over 140 PRs (land-list.sh, 2026-11-11 16:37Z) held ~90 extra PRs for 15 minutes. The
        cache file stays (CACHE_KEEP), so the next ask still answers at once while it registers again."""
        kind = split_key(e["key"])[0]
        if kind not in ("pr", "run") or self.waited(e) or e["consumers"]:
            return False
        touched = e["touched"]
        waited_at, since = e.get("waitedAt"), e.get("since")
        ended_wait = waited_at is not None and touched <= waited_at + ONCE_SLACK
        one_off = since is not None and touched - since < ONCE_SPAN
        if not (ended_wait or one_off):
            return False
        cached = e.get("cache") or {}
        if cached.get("error") or (e["jobs"] and "jobs" not in cached):
            return False  # not answered yet: a failed read, or a `--jobs` look whose job list is still to come
        return self.last_read(e) >= touched

    def waited(self, e: dict) -> bool:
        """Whether a wait here (or downstream, through an upstream read) registered the watch lately."""
        at = e.get("waitedAt")
        return isinstance(at, (int, float)) and self.now - at < WAIT_INTEREST

    def last_read(self, e: dict) -> float:
        """When GitHub was last read for this entry, or a REST read of it last ended (a read that failed must move
        back too, or failing keys would hold the head of every tick): a controller-fed run's REST clock, else its
        last fetch. Never read nor tried (no cache) sorts first, so a new watch is filled at once."""
        c = e.get("cache") or {}
        at = c.get("restAt") if c.get("source") == "controller" else c.get("fetchedAt")
        return max(float(at) if isinstance(at, (int, float)) else float("-inf"),
                   self.rest_tried.get(e["key"], float("-inf")))

    def rest_order(self, entries: list[dict]) -> list[dict]:
        """The order a tick reads REST keys in. A finished run a wait only needs confirmed (wait_confirms) goes first:
        one read each, and then it is an ordinary key. Keys the last tick ran out of time for go next, ahead of new ones
        of either kind (due() put them first only within their kind, so deferred runs still sat behind every new
        PR), oldest deferral first, so a newer one (a new watch, never read) cannot overtake a key deferred tick
        after tick. Then the longest unread, a key a wait is blocked on counted WAIT_PRIORITY older, and waited
        first on a tie (two never-read keys). Aging, not an absolute rank: an unread key's place only improves
        while read keys move back, so waiters cannot starve the rest."""
        carried = self.deferred_before
        return sorted(entries, key=lambda e: (not self.wait_confirms(e), e["key"] not in carried,
                                              carried.get(e["key"], 0.0),
                                              self.last_read(e) - (WAIT_PRIORITY if self.waited(e) else 0),
                                              not self.waited(e)))

    def fed(self, key: str) -> bool:
        """Whether the controller's webhooks cover this key's repository now: its feed answered within
        CONTROLLER_FRESH and delivered an event for the repository within FED_REPO_KEEP."""
        if self.now - self.controller_ok_at > CONTROLLER_FRESH:
            return False
        _, owner, repo, _ = split_key(key)
        return self.now - self.fed_repos.get(f"{owner}/{repo}".lower(), float("-inf")) <= FED_REPO_KEEP

    def idle_interval(self, e: dict, interval: float) -> float:
        """How often an open PR is polled: every cycle while a wait is on it or someone read it lately; an
        unwaited one nobody has read for a while as often as it was last read (its readers touch the watch, and
        broker answers from the cache touch it too), up to IDLE_BACKOFF_MAX. IDLE_EXPIRY drops it after that."""
        idle = self.now - e["touched"]
        if self.waited(e) or idle < IDLE_BACKOFF_AFTER:
            return interval
        return min(max(IDLE_BACKOFF_MAX, interval), max(interval, idle))

    def due(self, kind: str, entries: list[dict]) -> list[dict]:
        mine = [e for e in entries if e["key"].startswith(kind + ":")]
        path = self.route(kind)
        mode = self.mode(path)
        if mode == "stop" or (path == "rest" and kind in BALANCED + FALLBACK and self.rest_capped()):
            # Spent, or the daemon's REST share is and GraphQL is stopped too: a kind with nowhere to
            # go waits rather than spend the REST the sessions are left with. Except a failed attempt
            # whose job list is not read yet, the one read the share does not hold back, whichever
            # bucket runs are routed to: tick() reads just that list, from the run already cached.
            # Once per attempt, answered or not: an error or an empty list leaves the attempt without
            # jobs, and asking again every cycle would make the exemption a loop past the share. A later
            # read that the share admits (the run's own) still fills it in.
            if kind == "run" and self.mode("rest") != "stop":
                self.jobs_only = [e for e in mine if self.failed_without_jobs(e)
                                  and (e["cache"] or {}).get("jobsTried") != (((e["cache"] or {}).get("data") or {}).get("run_attempt") or 1)]
                for e in self.jobs_only:
                    self.attempted[e["key"]] = self.now
            return []
        if kind == "head":
            # REST lean only because the daemon is past its own share (the yield): consumers are admitted as when
            # normal, and every head, a reserved consumer's too, is read at most once per lean cycle (review F1, F2)
            yielding = path == "rest" and mode == "lean" and self.rest_above_floor()
            return self.due_heads(mine, "normal" if yielding else mode, paced=yielding)
        interval = self.policy["cycles"][kind] * (LEAN_FACTOR if mode == "lean" else 1)
        # GraphQL scarce (lean): what a session waits on keeps its cycle and goes first, oldest data first; the
        # unwaited rest takes the lean pace (huge-blue 2026-11-11: at the fleet's 1000 floor a waited PR was 2509 s old)
        scarce = mode == "lean" and path == "graphql"  # (REST lean is the daemon's share: no faster reads there)
        full = self.now - self.last_cycle[kind] >= interval
        if full:
            self.last_cycle[kind] = self.now
        out = [e for e in mine if e["key"] in self.deferred]  # the last tick ran out of time for these
        # Oldest deferral first: a refresh paced over minutes (graphqlPerMinute) defers again whatever came due
        # meanwhile, and in watch order those re-due keys went ahead of keys deferred ticks earlier, unread since.
        since = getattr(self, "deferred_since", {})
        out.sort(key=lambda e: since.get(e["key"], self.now))
        first = {e["key"] for e in out}
        self.deferred -= first
        for e in mine:
            c = e["cache"]
            if e["key"] in first:
                continue
            if kind == "run" and c is not None and self.run_needs_confirm(e) \
                    and (self.now - self.attempted.get(e["key"], float("-inf")) >= self.policy["cycles"][kind]
                         or self.first_confirm(e)):
                out.append(e)  # a wait (or a rerun) since GitHub last showed this finish: read it once now
                continue
            if (kind == "pr" and c is not None and e["key"] in self.nudged
                    and self.now - self.attempted.get(e["key"], float("-inf")) >= NUDGE_MIN):
                self.nudged.discard(e["key"])  # a check event on its head: re-read now, not at the cycle
                if self.idle_interval(e, interval) <= interval:  # (an idle one keeps its slower cycle)
                    out.append(e)
                    continue
            if kind == "run" and c is not None and e["key"] in self.controller_filled and c.get("source") == "controller":
                # (a run REST has shown newer than the controller's record keeps its normal cycle below: the
                # controller missed that attempt's deliveries, so it is not the source for it)
                data = c.get("data") or {}
                # A failed attempt whose job list is not this attempt's: REST reads it once (per cycle
                # at most), for the failed steps and to tell a runner's refusal from a real failure.
                failed = (data.get("status") == "completed" and data.get("conclusion") not in RUN_OK
                          and jobs_attempt(c.get("jobs")) < (data.get("run_attempt") or 1)
                          and self.now - self.attempted.get(e["key"], float("-inf")) >= self.policy["cycles"][kind])
                # A finished run with a reader newer than both its data and the last REST read: that
                # reader's wait will not rule on older data, so REST confirms it once (it may have
                # been rerun before the webhook said so).
                # And a finish the controller reported that REST has not read since: a rerun's deliveries can be
                # lost (manaflow-ai/cmux run 40434431701, 2026-10-27: the controller kept attempt 1 "cancelled"
                # while GitHub had attempt 2 queued), and wait_step rules on it only once REST confirms it.
                confirm = terminal(kind, data) and (e["touched"] > max(c.get("dataAt") or 0, c.get("restAt") or 0)
                                                    or controller_unconfirmed(c, self.now))
                # Otherwise the controller answered on this tick: REST only as the safety net. A failed read leaves
                # each of these true (restAt keeps its time), so a key is read at most once a cycle.
                paced = self.now - self.attempted.get(e["key"], float("-inf")) >= self.policy["cycles"][kind]
                # Still queued or in progress by the controller's word, a wait blocked on it, and nothing new
                # from either source for STALE_RUN_REREAD: its finish may be a lost delivery, and REST_SAFETY is
                # too long for a waiter to sit on it. One read (an unchanged run answers 304, which is free).
                stale = (not terminal(kind, data) and self.waited(e)
                         and self.now - max(c.get("dataAt") or 0, c.get("restAt") or 0) >= STALE_RUN_REREAD)
                if failed or (paced and (confirm or stale or self.now - (c.get("restAt") or 0) >= REST_SAFETY)):
                    out.append(e)
                continue
            if c is None:
                # a new entry is filled at once, but at most once per cycle when the fetch never gets as
                # far as storing an answer (a failed fetch stores its error, and then waits for full cycles)
                if self.now - self.attempted.get(e["key"], float("-inf")) >= self.policy["cycles"][kind]:
                    out.append(e)
            elif (full or (scarce and self.waited(e) and self.now - c.get("fetchedAt", 0) >= self.policy["cycles"][kind]
                           and not terminal(kind, c.get("data")))) \
                    and (not terminal(kind, c.get("data")) or self.now - c.get("fetchedAt", 0) >= TERMINAL_REFRESH
                           # a reader came after the last fetch: a rerun or reopen may have changed it
                           or e["touched"] > c.get("fetchedAt", 0)):
                since = self.now - c.get("fetchedAt", 0)
                if kind == "comment" and self.fed(e["key"]) and since < COMMENT_FED_CYCLE - TICK:
                    continue  # the controller's issue_comment webhooks carry its new comments (merge_comments)
                want = self.idle_interval(e, interval) if kind == "pr" and not terminal(kind, c.get("data")) else interval
                if want > interval and since < want - interval / 2:
                    continue  # unread and unwaited: polled about as often as it was last read
                out.append(e)
        # A key a wait is blocked on that GitHub has never been asked about goes ahead of the deferred ones: until its
        # first read a wait on a PR or run that does not exist cannot say so, and on a daemon at its GraphQL pace
        # (76 deferred, 2026-11-08) `wait pr o/r#999999 --timeout 120` timed out with "no data yet" instead.
        # Bounded: its first read stores an answer (or an error), and then it is an ordinary key.
        # So does a finished run a wait is blocked on that GitHub has not shown since (run_needs_confirm): wait_step will
        # not rule on it until that read, and behind 88 deferred keys on a lean daemon (2026-11-09, a 60 s confirmation
        # wait on a CI run) it timed out every time while the cache held its failure.
        # Bounded too: the read stores restRunAt, and then the run no longer needs confirming for that wait.
        out.sort(key=lambda e: not (self.wait_confirms(e) or (e["cache"] is None and self.waited(e))))
        if scarce or first:
            # Scarce, or a backlog the GraphQL pace deferred (after a quota stop every PR is due at once, and on
            # 2026-11-11 a waited PR was still 2509 s old 14 min after GraphQL came back): waited keys first, oldest
            # data first; the rest keep their order (oldest deferral first). Stable: never-read waited keys stay first.
            out.sort(key=lambda e: (not (self.wait_confirms(e) or (e["cache"] is None and self.waited(e))),
                                    not self.waited(e), ((e["cache"] or {}).get("dataAt") or 0) if self.waited(e) else 0))
        if kind == "run":
            self.confirming = {e["key"]: (rest_run((e["cache"] or {}).get("data")), (e["cache"] or {}).get("fetchedAt"))
                               for e in out if self.wait_confirms(e)}
        for e in out:
            self.attempted[e["key"]] = self.now
        return out

    def wait_confirms(self, e: dict) -> bool:
        """A finished run a wait is blocked on that GitHub has not shown since the wait (run_needs_confirm): the cache
        holds the answer, and wait_step rules on it after one read. That read goes ahead of every other, deferred keys
        included; then the run is an ordinary key again. Once per finish and wait (confirm_tried, waitBegan): a wait's
        touches move waitedAt, so a wait held on (rescue grace), or a run GitHub keeps refusing, would otherwise take
        the head of every cycle ahead of healthy deferred work (review of glaeda#1924). Later reads age and defer."""
        if not (e["key"].startswith("run:") and self.waited(e) and self.run_needs_confirm(e)):
            return False
        tried = self.confirm_tried.get(e["key"])
        if tried is None or tried[1] != rest_run((e.get("cache") or {}).get("data")):
            return True  # (a new finish, a rerun's say, gets its own first read)
        began = e.get("waitBegan")
        return isinstance(began, (int, float)) and began > tried[0]  # a new wait since

    def first_confirm(self, e: dict) -> bool:
        """A wait that began after this run's last read (waitBegan, which touches leave) and needs its finish
        confirmed: read now, not when the cycle's pace allows. A run read just before the wait began otherwise sat a
        whole cycle, as long as a short confirmation wait. Once per wait: the read is an attempt after its start."""
        began = e.get("waitBegan")
        return (isinstance(began, (int, float)) and began > self.attempted.get(e["key"], float("-inf"))
                and self.wait_confirms(e))

    def run_needs_confirm(self, e: dict) -> bool:
        """A finished run a wait blocks on, or a rerun was brokered for, after GitHub last showed it (restRunAt): its
        newest attempt may be queued again (RUN_CONFIRM_MAX). Read once per wait; a failed read is paced by due()."""
        c = e.get("cache") or {}
        if not terminal("run", c.get("data")):
            return False
        rest_at = c.get("restRunAt") if isinstance(c.get("restRunAt"), (int, float)) else float("-inf")
        if c.get("restRun") != rest_run(c.get("data")):
            rest_at = float("-inf")  # GitHub never showed this finish (the controller's, or an upstream's)
        waited = e.get("waitedAt") if self.waited(e) else None
        return max(waited or float("-inf"), run_confirmed_since(c) or float("-inf")) > rest_at

    def head_allowed(self, name: str, mode: str, policy: dict) -> bool:
        """Whether this consumer may be charged one more head read now. A reserved consumer has its own
        hourly reservation and is served even when the quota is lean; anyone else draws on the shared
        pool (and a per-consumer cap) and waits for the cache when the quota is lean."""
        spent = len(self.head_spend.get(name, []))
        if name in policy["reserved"]:
            return spent < policy["reserved"][name]
        if mode != "normal":
            return False
        pool = sum(len(v) for k, v in self.head_spend.items() if k not in policy["reserved"])
        return spent < policy["limit"] and pool < policy["pool"]

    def refund(self, key: str) -> None:
        """A head read that deferred or failed costs its consumer nothing."""
        paid = self.payer.pop(key, None)
        if paid and paid[1] in self.head_spend.get(paid[0], []):
            self.head_spend[paid[0]].remove(paid[1])
            self.refunded[key] = paid[0]

    def head_answered(self, key: str) -> None:
        """A head read answered: its charge stands, and one a failed read on the other bucket refunded this tick
        is charged again, so a fallback never reads a head for free past its consumer's cap."""
        if self.payer.pop(key, None) is None and key in self.refunded:
            self.head_spend.setdefault(self.refunded[key], []).append(self.now)
        self.refunded.pop(key, None)

    def due_heads(self, mine: list[dict], mode: str, paced: bool = False) -> list[dict]:
        """Heads somebody asked for recently whose answer is missing or older than its TTL. One read serves
        every consumer of the head; it is charged to the first consumer (reserved ones first) that may pay.
        A head nobody may pay for is left to the cache, and the refused consumers are marked denied."""
        policy = consumer_policy()
        self.head_spend = {k: [t for t in v if self.now - t < CONSUMER_WINDOW] for k, v in self.head_spend.items()}
        for key, (_, at) in list(self.payer.items()):
            if self.now - at > 2 * self.policy["cycle"]:  # a read that raised never reported back
                self.refund(key)
        out = []
        due, soon = [], []
        for e in mine:
            c = e["cache"] or {}
            if not any(self.now - t < HEAD_INTEREST for t in e["consumers"].values()):
                continue
            if not c.get("data"):
                due.append(e)
                continue
            ttl, age = self.head_ttl(e), self.now - (c.get("dataAt") or 0)
            if age >= ttl or (e["key"] in self.nudged and age >= NUDGE_MIN):
                due.append(e)
            elif age >= ttl - HEAD_ALIGN:
                soon.append(e)  # due shortly: it rides along with a head due now, one query instead of two
        due_keys = {e["key"] for e in due}
        for e in due + (soon if due else []):
            asked = {n: t for n, t in e["consumers"].items() if self.now - t < HEAD_INTEREST}
            c = e["cache"] or {}
            retry = HEAD_MISSING_RETRY if c.get("missing") else self.policy["cycles"]["head"]
            if paced:
                retry = max(retry, self.policy["cycles"]["head"] * LEAN_FACTOR)
            if e["key"] in self.deferred:
                self.deferred.discard(e["key"])  # the last tick ran out of time for it: no cycle to wait
            elif self.now - self.attempted.get(e["key"], float("-inf")) < retry:
                continue  # a read that failed, found nothing or is still running waits a cycle
            payer = next((n for n in sorted(asked, key=lambda n: (n not in policy["reserved"], n))
                          if self.head_allowed(n, mode, policy)), None)
            if payer is None:
                if e["key"] in due_keys:  # (a head only riding along was not refused anything: its TTL has not run out)
                    for n in asked:
                        self.denied[n] = self.now
                continue
            self.head_spend.setdefault(payer, []).append(self.now)
            self.payer[e["key"]] = (payer, self.now)
            self.attempted[e["key"]] = self.now
            self.nudged.discard(e["key"])  # (kept until it is read: a check event inside the retry gate still counts)
            out.append(e)
        return out

    def head_ttl(self, e: dict) -> float:
        """How long a head's answer stands: a settled one HEAD_SETTLED_TTL; a running one HEAD_PENDING_TTL, or
        HEAD_PENDING_FED_TTL where the controller's webhooks cover its repository and re-read it on its own check
        events (nudge)."""
        data = (e["cache"] or {}).get("data") or {}
        if data.get("settled"):
            return HEAD_SETTLED_TTL
        return HEAD_PENDING_FED_TTL if self.fed(e["key"]) else HEAD_PENDING_TTL

    def write_consumers(self) -> None:
        policy = consumer_policy()
        names = sorted(set(self.head_spend) | set(self.denied) | set(policy["reserved"]))
        doc = {"policy": policy, "consumers": {
            n: {"reserved": n in policy["reserved"], "spent": len(self.head_spend.get(n, [])),
                "limit": policy["reserved"].get(n, policy["limit"]), "deniedAt": self.denied.get(n)}
            for n in names}, "spends": {n: [round(t) for t in v] for n, v in self.head_spend.items() if v}}
        text = json.dumps(doc, sort_keys=True)
        # rewritten when a spend or denial changes (the ticks' own `at` would make every tick a write)
        if text != self.saved_consumers:
            write_json(BASE / CONSUMERS_FILE, {**doc, "at": self.now})
            self.saved_consumers = text

    def defer(self, entries: list[dict]) -> None:
        self.deferred.update(e["key"] for e in entries)
        for e in entries:
            self.refund(e["key"])

    def tick(self, now: float | None = None) -> dict:
        self.now = time.time() if now is None else now
        self.clock_real = now is None
        self.tick_deadline = time.monotonic() + TICK_BUDGET
        self.errors = []
        self.refunded = {}
        self.spill = []
        self.policy = daemon_policy()
        self.jobs_only = []
        self.settle_rest()  # a counter whose window ended leaves the reading to the others
        self.settle_counters("graphql")
        if self.failing is None:
            # and again in serve_waits: a long read phase must not look like a dead daemon; ticks that
            # keep raising stop marking, so their blockers hand the wait back (resume_wait says why)
            mark_waits_served()
        up = self.upstream()
        if up is not None:
            return self.upstream_tick(up)
        try:
            self.post_tick()  # first, so a long read phase never delays a write
        except Exception as error:  # noqa: BLE001  a bad queue entry must not stop the reads
            self.errors.append(f"outbox: {describe(error)} at {error_site(error)}")
        entries = self.watches()
        self.adopt_pace_hold()
        try:
            self.from_controller(entries)
        except Exception as error:  # noqa: BLE001  the controller is an optional, free source: a fault
            # there must not stop GitHub polling (it did: glaeda#1305). A WatchError is expected and
            # says what failed; anything else is a bug, so it carries its code site.
            self.controller_down(error, None if isinstance(error, WatchError) else error_site(error))
        # due() consumes the deferred set; the REST order below still needs it, oldest deferral first
        self.deferred_since = {k: self.deferred_since.get(k, self.now) for k in self.deferred}
        self.deferred_before = dict(self.deferred_since)
        prs, runs, comments = self.due("pr", entries), self.due("run", entries), self.due("comment", entries)
        heads = self.due("head", entries)
        due = {"pr": prs, "run": runs, "comment": comments, "head": heads}
        over = {kind: self.paths[kind] for kind in due}  # due() routed each kind
        spilled: list[dict] = []
        # The per-minute ceiling (graphqlPerMinute) can hold a tick partway. The kind after the one it held goes first
        # next tick, so PR refreshes cannot take every minute's points while a run, comment or head waits behind them.
        kinds = ("pr", "comment", "run", "head")
        first = getattr(self, "gql_first", 0) % len(kinds)
        self.gql_paced = None
        sent = len(self.gql_log)
        paced_sent = False  # whether the kind the ceiling held had sent a query of its own first, this tick
        for kind in kinds[first:] + kinds[:first]:
            if over[kind] == "graphql":
                before = len(self.gql_log)
                spilled += self.batched(kind, due[kind], self.graphql_fetch[kind])
                if self.gql_paced == kind:
                    paced_sent = len(self.gql_log) > before
                self.post_between()
        # Only a tick that sent a query moves the order: one that met the ceiling before reading anything (most ticks
        # in a full minute, TICK is 2 s) leaves it, or the count of empty ticks would decide who reads next. The kind
        # the ceiling held goes first next time when it read nothing itself (it was starved), the one after it when it
        # had its turn: a round robin over the kinds with something due.
        if self.gql_paced is not None and len(self.gql_log) > sent:
            self.gql_first = (kinds.index(self.gql_paced) + (1 if paced_sent else 0)) % len(kinds)
        over_rest = [e for kind in ("pr", "run", "comment", "head") if over[kind] == "rest" for e in due[kind]]
        # GraphQL ran out of primary quota partway: REST reads what it could not, this tick. A secondary
        # hold stops REST too, so the REST loop below defers them instead.
        over_rest += spilled
        # With PRs always ahead of runs, a busy daemon read PRs tick after tick while a blocked `wait run` sat on a
        # run nobody reached (2026-10-27: 581 s and counting, with STALE_RUN_REREAD due at 180 s).
        over_rest = self.rest_order(over_rest)
        for i, e in enumerate(over_rest):
            # A read is admitted only when its worst case fits in the share, so the share holds at a
            # request, not at a batch; the rest go first next tick, over whichever bucket is richer.
            if self.mode("rest") == "stop" or not self.rest_room(REST_READ_MAX[e["key"].split(":", 1)[0]]):
                self.to_graphql(over_rest[i:], spilled)
                break
            sent = len(self.sent)
            try:
                with self.calling(*caller_of(e["key"]), waiter_of(e)):
                    self.rest_fetch[e["key"].split(":", 1)[0]](e)
            except OutOfTime:
                self.defer(over_rest[i:])
                if len(self.sent) > sent:  # cut off partway: it had its turn, and queues as a new deferral
                    self.rest_tried[e["key"]] = self.now
                    self.deferred_since.pop(e["key"], None)
                break  # (cut off before its first request, it was not read: it keeps its place, first next tick)
            except Exception as error:  # noqa: BLE001
                self.errors.append(f"{e['key']}: {describe(error)}")
            if self.mode("rest") == "stop" and (read_cache(e["key"]) or {}).get("error"):
                # this read is the one that ran REST out: GraphQL reads it, and the rest, this tick
                self.to_graphql(over_rest[i:], spilled)
                break
            self.rest_tried[e["key"]] = self.now  # read, or failed: either way it moves back
            # and a read that deferred itself for the rest of its work (fill_steps_rest) queues as a new deferral
            self.deferred_since.pop(e["key"], None)
        for e in self.jobs_only:
            try:
                with self.calling(*caller_of(e["key"]), waiter_of(e)):
                    self.read_jobs(e, {}, False)  # read_jobs reads the list a failed attempt is missing
            except Exception as error:  # noqa: BLE001
                self.errors.append(f"{e['key']} jobs: {describe(error)}")
        # After the reads, so a busy daemon never pays for it: its own responses' x-ratelimit
        # headers have already brought the view up to date, and only an idle one goes stale.
        self.refresh_budget()
        return self.finish_tick(entries, prs, runs, comments, heads)

    def to_graphql(self, left: list[dict], spilled: list[dict]) -> None:
        """REST is throttled or its share spent with these still to read: GraphQL reads them this tick when it
        is not stopped (and they did not just come from it); the rest go first next tick."""
        came = {e["key"] for e in spilled}
        if self.mode("graphql") == "stop":
            return self.defer(left)
        held = [e for e in left if e["key"] in came]
        for kind in ("pr", "comment", "run", "head"):
            mine = [e for e in left if e["key"].startswith(kind + ":") and e["key"] not in came]
            if mine:
                log({"event": "fallback", "to": "graphql", "kind": kind, "entries": len(mine)})
                held += self.batched(kind, mine, self.graphql_fetch[kind])
        self.defer(held)

    def finish_tick(self, entries: list[dict], prs: list[dict], runs: list[dict], comments: list[dict],
                    heads: list[dict]) -> dict:
        """Rule on the waits, prune, and write the heartbeat: the end of every tick, whatever read it."""
        self.tick_deadline = float("inf")
        try:
            waiting = self.serve_waits()
        except Exception as error:  # noqa: BLE001  the waits are the clients' business; the reads go on
            waiting = None
            self.errors.append(f"waits: {describe(error)} at {error_site(error)}")
        # A confirming read that was made has had its turn ahead of the rest (wait_confirms): it stored an answer or
        # an error (fetchedAt moved), even if what it read next (a failed attempt's jobs) is deferred. One cut off
        # before its request keeps its place.
        for key, (finish, fetched) in self.confirming.items():
            if key not in self.deferred or (read_cache(key) or {}).get("fetchedAt") != fetched:
                self.confirm_tried[key] = (self.now, finish)
        self.confirming = {}
        self.deferred &= {e["key"] for e in entries}
        self.nudged &= {e["key"] for e in entries}
        self.attempted = {k: t for k, t in self.attempted.items() if self.now - t < 2 * IDLE_EXPIRY}
        self.rest_tried = {k: t for k, t in self.rest_tried.items() if self.now - t < 2 * IDLE_EXPIRY}
        self.confirm_tried = {k: t for k, t in self.confirm_tried.items() if self.now - t[0] < 2 * IDLE_EXPIRY}
        oldest = self.oldest_data(entries, {e["key"] for e in prs + runs + comments + heads})
        # errors[] is this tick's only, and a heartbeat tick writes it empty: what failed a minute ago stays visible
        for message in self.errors:
            self.recent_errors[message] = self.now
        self.recent_errors = dict(sorted(((m, t) for m, t in self.recent_errors.items()
                                          if self.now - t < RECENT_ERRORS_KEEP), key=lambda x: -x[1])[:10])
        self.prune({e["key"] for e in entries})
        self.post_prune()
        first_minute = int(self.clock() // 60) - 60
        self.rest_minutes = {m: n for m, n in self.rest_minutes.items() if m >= first_minute}
        if self.rest_minutes != self.saved_rest_minutes:
            write_json(BASE / REST_SPEND_FILE, {str(m): n for m, n in self.rest_minutes.items()})
            self.saved_rest_minutes = dict(self.rest_minutes)
        if self.budget != self.saved_budget:
            write_json(BASE / "budget.json", self.budget)
            self.saved_budget = json.loads(json.dumps(self.budget))
        self.save_spend()
        try:
            self.check_alarms()
        except Exception as error:  # noqa: BLE001  an alarm that cannot be sent must never stop the reads
            self.errors.append(f"alarm: {describe(error)} at {error_site(error)}")
        self.write_consumers()
        self.sent = [(t, what) for t, what in self.sent if self.now - t < 3600]
        hour = {what: sum(1 for _, w in self.sent if w == what)
                for what in ("rest", "rest304", "graphql", "free", "write")}
        self.reads = [r for r in self.reads if self.now - r[0] < 3600]
        self.gql_log = [g for g in self.gql_log if self.now - g[0] < 3600]
        graphql_by: dict[str, dict[str, int]] = {}
        for _, why, points in self.gql_log:
            mine = graphql_by.setdefault(why, {"queries": 0, "points": 0})
            mine["queries"] += 1
            mine["points"] += points
        self.fed_repos = {r: t for r, t in self.fed_repos.items() if self.now - t < FED_REPO_KEEP}
        reads = {kind: {b: sum(1 for _, k, w in self.reads if k == kind and w == b) for b in ("graphql", "rest")}
                 for kind in CYCLES}
        status = {"pid": os.getpid(), "at": self.now, "watching": len(entries), "waits": WAITS_CONTRACT,
                  "waiting": waiting,
                  "fetched": {"pr": len(prs), "run": len(runs), "comment": len(comments), "head": len(heads)},
                  "controller": {**self.controller_status, "runs": len(self.controller_filled)},
                  "modes": {b: self.mode(b) for b in ("rest", "graphql")}, "errors": self.errors[:10],
                  "secondaryHold": {"until": self.secondary_until, "strikes": self.secondary_strikes}
                  if self.secondary_until > self.now else None, "forceLow": list(self.policy.get("forceLow", ())),
                  "lastHour": hour,
                  "restShare": {"spent": self.rest_spent(), "cap": self.rest_cap(), "yield": self.rest_yield(),
                                "share": self.policy["restShare"], "capped": self.rest_capped()},
                  "heartbeat": HEARTBEAT_EVERY, "paths": dict(self.paths), "reads": reads, "graphqlBy": graphql_by,
                  "spendBy": self.spend_by(), "alarms": self.alarms,
                  "perMinute": {b: round(self.richness(b) * 60, 1) for b in ("rest", "graphql")},
                  "batch": dict(self.batch), "oldestData": oldest, "deferred": len(self.deferred),
                  "staleWaited": dict(self.stale_waited), "staleAfter": STALE_DATA_AFTER,
                  "staleWhy": self.stale_why(),
                  "recentErrors": [{"error": m, "at": t} for m, t in self.recent_errors.items()],
                  "outbox": {"queued": len(list(outbox_dir().glob("*.json"))) if outbox_dir().is_dir() else 0,
                             "holdUntil": self.post_hold if self.post_hold > self.now else None}}
        if self.upstream_status is not None:
            status["upstream"] = self.upstream_status
        # the heartbeat lets clients tell a hung daemon (lock held, nothing written) from an idle one
        recovered, self.failing = self.failing is not None, None
        if recovered or prs or runs or comments or heads or self.errors or self.now - self.beat >= HEARTBEAT_EVERY:
            write_json(BASE / "daemon.json", status)
            self.beat = self.now
        self.status = status
        return status

    # -- upstream: no login here; another host's glaeda-gh reads GitHub (UPSTREAM_CONFIG)

    def upstream(self) -> Callable[[dict], dict] | None:
        source = self.upstream_source
        if source == "config":
            command = upstream_command()
            return None if command is None else (lambda req: run_upstream(command, req))
        return source if callable(source) else None

    def upstream_tick(self, ask: Callable[[dict], dict]) -> dict:
        """One tick with an upstream: refuse what needs a login, read the due keys in one request, rule."""
        self.upstream_status = self.upstream_status or {"state": "starting"}
        self.controller_status = {"state": "off", "why": "reads through upstream"}
        self.upstream_refuse_posts()
        entries = self.watches()
        due = []
        full = self.now - self.upstream_at >= UPSTREAM_EVERY
        for e in entries:
            kind = split_key(e["key"])[0]
            if kind == "head" and not self.head_askers(e):
                continue  # nobody asked for it lately (HEAD_INTEREST): the upstream is not charged for it either
            if kind not in UPSTREAM_KINDS:
                if e["cache"] is None:
                    self.store(e["key"], None, error=f"{kind} reads need a GitHub login; this host reads through "
                                                     "its upstream")
                continue
            fresh = e["cache"] is None  # the upstream has answered nothing for it yet, not even an error
            if full or (fresh and self.now - self.attempted.get(e["key"], float("-inf")) >= UPSTREAM_NEW):
                due.append(e)
        # The least recently asked first (a key never asked is -inf): past UPSTREAM_MAX_KEYS they rotate, none starves.
        due = sorted(due, key=lambda e: (self.attempted.get(e["key"], float("-inf")), e["key"]))[:UPSTREAM_MAX_KEYS]
        if full:
            self.upstream_at = self.now
        if due:
            # Heads go in a request of their own: an upstream older than head keys refuses a whole request that has
            # one, and that must not stop the PRs' and runs' reads.
            # Each read sets upstream_status: a failing first read must not be called "ok" by a head read after it
            # (the stale alarm holds, and stale waits stay, only for an "ok" upstream). Either failing, the tick fails.
            failed = None
            for part in ([e for e in due if not e["key"].startswith("head:")],
                         [e for e in due if e["key"].startswith("head:")]):
                if part:
                    self.upstream_read(ask, part)
                    if self.upstream_status.get("state") == "failing":
                        failed = failed or self.upstream_status
            if failed is not None:
                self.upstream_status = failed
        self.attempted = {k: t for k, t in self.attempted.items() if self.now - t < 2 * IDLE_EXPIRY}
        self.consumer_sent = {k: t for k, t in self.consumer_sent.items() if self.now - t < 2 * HEAD_INTEREST}
        kinds = {kind: [e for e in due if e["key"].startswith(kind + ":")] for kind in CYCLES}
        return self.finish_tick(entries, kinds["pr"], kinds["run"], kinds["comment"], [])

    def head_askers(self, e: dict) -> list[str]:
        """The consumers that registered a head here (checks --consumer) within HEAD_INTEREST, newest first."""
        asked = e.get("consumers") or {}
        return sorted((n for n, t in asked.items() if self.now - t < HEAD_INTEREST), key=lambda n: (-asked[n], n))

    def upstream_read(self, ask: Callable[[dict], dict], due: list[dict]) -> None:
        # A head goes up once per consumer that asked for it here: the upstream registers each and charges its one
        # read to the first that may pay, as this host's own due_heads would. Whole keys go up to UPSTREAM_MAX_KEYS
        # lines; only those sent are stamped, so the rest stay least recently asked and go first next tick.
        # Each line carries this host's own interest times (touched, waitedAt, asked): the upstream stamps them, not
        # its now, so its interest ends when this host's does. A head with more askers than fit sends the least
        # recently sent first (consumer_sent), so every consumer goes up in turn, as keys rotate.
        keys, sent, lines_of = [], [], {}
        for e in due:
            # a reader that names its own host (a caller over reach) keeps it; any other is this host's
            reader = waiter_of(e) if "/" in waiter_of(e) else f"{policy_host()}/{waiter_of(e)}"
            base = {"key": e["key"], "jobs": e["jobs"], **({"reader": reader} if safe_reader(reader) else {}),
                    **({"touched": e["touched"]} if isinstance(e.get("touched"), (int, float)) else {}),
                    **({"wait": True, "waitedAt": e["waitedAt"]} if self.waited(e) else {})}
            askers = sorted(self.head_askers(e), key=lambda n: (self.consumer_sent.get((e["key"], n), float("-inf")), n)) \
                if e["key"].startswith("head:") else [None]
            lines = [{**base, **({"consumer": n, "asked": e["consumers"][n]} if n else {})} for n in askers]
            if keys and len(keys) + len(lines) > UPSTREAM_MAX_KEYS:
                break
            lines = lines[:UPSTREAM_MAX_KEYS]
            keys += lines
            sent.append(e)
        due = sent
        for e in due:
            self.attempted[e["key"]] = self.now
        for line in keys:
            if line.get("consumer"):
                self.consumer_sent[(line["key"], line["consumer"])] = self.now
        request = {"keys": keys}
        try:
            answer = ask(request)
            got = answer.get("entries") if isinstance(answer, dict) else None
            if not isinstance(got, dict):
                why = answer.get("error") if isinstance(answer, dict) and isinstance(answer.get("error"), str) else None
                raise WatchError(f"upstream: {why or 'its answer has no entries'}"[:UPSTREAM_ERROR_MAX])
        except Exception as error:  # noqa: BLE001  a broken upstream is reported, never fatal
            why = str(error) if isinstance(error, WatchError) else f"upstream: {describe(error)}"
            self.errors.append(why)
            self.upstream_status = {"state": "failing", "error": why, "at": self.now}
            for e in due:  # the data is kept; a status names the outage instead of showing it as current
                self.store(e["key"], e["cache"], error=why)
            return
        self.upstream_status = {"state": "ok", "at": self.now, "keys": len(due)}
        self.upstream_denials(got)
        for e in due:
            entry = got.get(e["key"])
            if not isinstance(entry, dict):
                continue  # the upstream has not read it yet: asked again in UPSTREAM_NEW
            data = entry.get("data") if isinstance(entry.get("data"), dict) else None
            error = entry.get("error") if isinstance(entry.get("error"), str) else None
            if data is None and error is None:
                continue  # registered there, not read yet
            at, fetched = entry.get("dataAt"), entry.get("fetchedAt")
            fields: dict[str, Any] = {"error": error[:UPSTREAM_ERROR_MAX] if error else None, "source": "upstream",
                                      "missing": entry.get("missing") is True,
                                      # provenance: a controller-only finish stays unconfirmed downstream too
                                      "origin": entry.get("origin") if isinstance(entry.get("origin"), str) else None,
                                      "restRun": entry.get("restRun") if isinstance(entry.get("restRun"), dict) else None}
            if isinstance(fetched, (int, float)):
                fields["fetchedAt"] = min(self.now, float(fetched))  # a wait rules only on reads after it began
            shown = entry.get("restRunAt")  # when the upstream's GitHub read last showed restRun (run_unconfirmed)
            fields["restRunAt"] = (min(self.now, float(shown))
                                   if isinstance(shown, (int, float)) and not isinstance(shown, bool) else None)
            if data is not None:
                fields.update(data=data, dataAt=float(at) if isinstance(at, (int, float)) else self.now)
            if isinstance(entry.get("jobs"), list):
                fields["jobs"] = entry["jobs"]
            self.store(e["key"], e["cache"], **fields)

    def upstream_denials(self, got: dict) -> None:
        """A head consumer the upstream refused for its budget is denied here too (this host's consumers ledger), so
        `checks` on this host says "budget spent" instead of "not read yet"."""
        for entry in got.values():
            budgets = entry.get("budgets") if isinstance(entry, dict) else None
            for name, budget in budgets.items() if isinstance(budgets, dict) else ():
                at = budget.get("deniedAt") if isinstance(budget, dict) else None
                if isinstance(name, str) and isinstance(at, (int, float)) and not isinstance(at, bool):
                    self.denied[name] = max(self.denied.get(name) or 0, min(self.now, float(at)))

    def upstream_refuse_posts(self) -> None:
        for path in sorted(outbox_dir().glob("*.json")) if outbox_dir().is_dir() else []:
            if not path.exists():
                continue  # a joined comment's member, finished with its leader
            item = read_json(path)
            self.post_finish(path, item if isinstance(item, dict) else {"id": path.stem},
                             error="this host reads GitHub through its upstream and has no login to post with")

    def serve_waits(self) -> int:
        """Rule on the `wait pr|run` requests clients left in waits/ (subscribe_wait): keep their interest
        registered, and when one is decided or out of time write what it prints and its exit code, then
        wake its blocker with the code. waits/.served tells the blockers waits are being ruled on. A
        request whose blocker is gone, or that cannot be read, is dropped. Returns how many are pending."""
        d = waits_dir()
        if not d.is_dir():
            return 0
        mark_waits_served()
        now = time.time()  # requests carry wall-clock times, whatever clock a tick was given
        pending, touch = 0, {}
        for path in sorted(d.glob("*.json")):
            rid = path.stem
            try:
                req = read_json(path)
                decided = self.serve_wait(d, rid, req, now, touch)
            except OSError:  # a full disk, say: the request stays, and the next tick tries again
                pending += 1
                continue
            except Exception:  # noqa: BLE001  a request that cannot be ruled on must not stop the others
                drop_wait(rid)  # its blocker sees the FIFO gone and hands the wait back (BLOCKER)
                continue
            if decided is None:
                pending += 1
        # One registration per key, all under one bound: a wedged holder of .register.lock costs a tick
        # LOCK_WAIT, not LOCK_WAIT per waiter.
        with lock_budget(LOCK_WAIT):
            for key, (jobs, readers) in touch.items():
                for reader in readers or [None]:
                    register(key, jobs, waited=True, reader=reader or "tool:glaeda-gh wait")
        # What a blocker killed after its wake, or a wait handed back to Python, left behind.
        for left in d.glob("*.*"):
            rid = left.name.split(".", 1)[0]
            pid = rid.split("-", 1)[0]
            if rid and not (d / f"{rid}.json").exists() and not (pid.isdigit() and waiter_alive(int(pid))):
                drop_wait(rid)
        return pending

    @staticmethod
    def note_wait_state(d: Path, rid: str, req: dict) -> None:
        """The one line BLOCKER's progress lines carry (progress_state), rewritten only when it changes."""
        try:
            line = progress_state(req["key"], read_cache(req["key"]), str(req.get("until") or "done"),
                                  float(req.get("grace", RESCUE_GRACE))).replace("\n", " ") + "\n"
            path = d / f"{rid}.out.state"
            if not path.is_file() or path.read_text() != line:
                path.write_text(line)
        except Exception:  # noqa: BLE001  a progress line never stops a wait from being ruled on
            pass

    def serve_wait(self, d: Path, rid: str, req: Any, now: float, touch: dict[str, bool]) -> bool | None:
        """One request: None while pending, else whether its blocker was woken. Raises on a bad one."""
        if (isinstance(req, dict) and req.get("stale") is not None and waiter_alive(req.get("pid"))
                and now <= float(req["began"]) + float(req["timeout"]) + WAITS_LEFTOVER):
            return None  # handed back (below): its blocker takes it to resume_wait within WAITS_CHECK
        if (not isinstance(req, dict) or not waiter_alive(req.get("pid")) or not (d / f"{rid}.fifo").exists()
                or now > float(req["began"]) + float(req["timeout"]) + WAITS_LEFTOVER):
            drop_wait(rid)
            return False
        if req.get("code") is None:
            before = dict(req)
            if now - float(req.get("touched") or 0) >= TOUCH_EVERY:
                jobs_before, readers = touch.get(req["key"], (False, []))
                touch[req["key"]] = (jobs_before or bool(req.get("jobs")),
                                     readers + [str(req["reader"])] if isinstance(req.get("reader"), str) else readers)
                req["touched"] = now
                self.note_wait_state(d, rid, req)
            try:
                done, err = wait_step(req, now), ""
            except WatchError as error:
                done, err = wait_refusal(req, "refused", str(error), "glaeda-gh wait --help")
            except Exception as error:  # noqa: BLE001  said to the waiter, not raised into the tick
                done, err = wait_refusal(req, "could-not-judge", f"the daemon could not rule on this wait: "
                                         f"{describe(error)}", wait_command(req))
            if done is not None:
                if err:
                    (d / f"{rid}.out.err").write_text(err)
                (d / f"{rid}.out").write_text(done[1])
                (d / f"{rid}.out.rc").write_text(f"{done[0]}\n")
                req["code"] = done[0]
            else:
                # Not while GitHub's quota explains the old data: the wait's own read could not get through either,
                # and every live wait would turn into a Python poll for the rest of its timeout (the memory the
                # blocker saves; review of glaeda#1942).
                starved = None if self.stale_explained(req.get("kind")) else wait_starved(req, read_cache(req["key"]), now)
                if starved is not None:
                    # This daemon is not refreshing what the wait is blocked on: hand the wait back (its blocker sees
                    # the FIFO gone and execs wait-resume), where poll_wait says so and reads GitHub once itself.
                    req["stale"] = round(starved)
                    write_json(d / f"{rid}.json", req)
                    with contextlib.suppress(OSError):
                        (d / f"{rid}.fifo").unlink()
                    return None
            if req != before:
                write_json(d / f"{rid}.json", req)
            if req.get("code") is None:
                return None
        if wake_waiter(d / f"{rid}.fifo", int(req["code"])):
            with contextlib.suppress(OSError):
                (d / f"{rid}.json").unlink()  # the blocker prints .out and removes the rest
            return True
        return False

    @property
    def graphql_fetch(self) -> dict[str, Callable[[list[dict]], str | None]]:
        return {"pr": self.fetch_prs, "comment": self.fetch_comments, "run": self.fetch_runs_graphql,
                "head": self.fetch_heads}

    @property
    def rest_fetch(self) -> dict[str, Callable[[dict], None]]:
        return {"pr": self.fetch_pr_rest, "run": self.fetch_run, "comment": self.fetch_comment_rest,
                "head": self.fetch_head_rest}

    def batched(self, kind: str, entries: list[dict], fetch: Callable[[list[dict]], str | None]) -> list[dict]:
        """Read `entries` over GraphQL in queries of self.batch[kind]. A query that times out (504)
        halves the batch (once per tick, never below GQL_BATCH_MIN) and is retried at once as two
        halves, so one heavy entry cannot keep the rest stale: it ends up alone, is remembered as
        heavy and read alone from then on (every LEAN_FACTOR cycles once it keeps timing out), and
        the batch grows back. A 502 or 503 is split and retried without shrinking. GQL_SPLITS bounds
        the extra queries a tick spends on splitting; what is left waits for the next cycle. Returns the
        entries left unread because GraphQL stopped (its quota, or a throttle) partway, the one that hit it
        included, for the caller to read over REST."""
        self.heavy = {k: h for k, h in self.heavy.items() if self.now - h["at"] < IDLE_EXPIRY}
        size = self.batch[kind]
        alone, rest = [], []
        for e in entries:
            h = self.heavy.get(e["key"])
            if h is None:
                rest.append(e)
            elif h["fails"] < HEAVY_AFTER or self.now - h["at"] >= LEAN_FACTOR * self.policy["cycles"][kind]:
                alone.append([e])
        queue = alone + [rest[i:i + size] for i in range(0, len(rest), size)]
        splits, shrunk = 0, False
        while queue:
            chunk = queue.pop(0)
            if self.mode("graphql") == "stop":
                return chunk + [e for c in queue for e in c]
            if not self.gql_room():
                # Over the per-minute ceiling: the rest wait, first next tick. Not REST's to read: GraphQL is not
                # spent, only paced, and a REST spill of a whole post-reset refresh would be the same burst there.
                self.defer(chunk + [e for c in queue for e in c])
                if getattr(self, "gql_paced", None) is None:
                    self.gql_paced = kind
                return []
            self.gql_limited = False
            self.gql_reason = kind
            repos = sorted({caller_of(e["key"])[1] for e in chunk})
            self.limited = []
            try:
                with self.calling(kind, repos[0] if len(repos) == 1 else f"{len(repos)} repos", waiters_of(chunk)):
                    error = fetch(chunk)
                spilled, self.spill = self.spill, []
                limited, self.limited = self.limited, []
            except OutOfTime:
                self.defer(chunk + [e for c in queue for e in c])
                return []
            except Exception as failure:  # noqa: BLE001  one bad batch must not stop the rest
                # A bug on one entry's answer (an AttributeError on a null node, huge-blue 2026-11-11) used to drop the
                # whole chunk here with nothing stored: every PR in it kept its old data, errors[] was empty again by the
                # next heartbeat, and the batch was cut the same way next cycle. Split the chunk so the healthy entries
                # are read this tick, and store the error (with its code site) on an entry read alone, so `status` and
                # `wait` say what failed and oldestData shows it. Bounded by GQL_SPLITS like a timeout's split.
                message = f"graphql: {describe(failure)} at {error_site(failure)}"
                self.errors.append(message)
                self.spill = []
                if len(chunk) >= 2 and splits + 2 <= GQL_SPLITS:
                    splits += 2
                    half = (len(chunk) + 1) // 2
                    queue = [chunk[:half], chunk[half:]] + queue
                    continue
                with contextlib.suppress(Exception):  # noqa: BLE001  storing the error must not stop the rest
                    for e in chunk:
                        self.store(e["key"], e["cache"], error=message[:300])
                continue
            if (error or self.gql_limited) and self.mode("graphql") == "stop":
                # this query hit the limit (a RATE_LIMITED answer can still carry data.rateLimit and null aliases):
                # whatever it stored for them, REST reads them this tick and replaces it
                return chunk + [e for c in queue for e in c]
            if spilled:
                return spilled + [e for c in queue for e in c]
            if limited:
                # Partial: not a clean query, and the batch was too big for these entries. Halve it, then re-read only
                # the partial ones at a size below this chunk's (so a re-read ends at one entry alone), within
                # GQL_SPLITS and, through gql_room above, the per-minute ceiling. Partial even alone: stored partial
                # with its error, as any partial read, and read again next cycle.
                self.clean[kind] = 0
                if len(chunk) < 2:
                    continue
                if self.batch[kind] > 1:
                    self.batch[kind] = max(1, self.batch[kind] // 2)
                    log({"event": "batch", "kind": kind, "size": self.batch[kind], "after": RESOURCE_LIMITS,
                         "partial": len(limited), "of": len(chunk)})
                size = min(self.batch[kind], max(1, len(chunk) // 2))
                redo = [limited[i:i + size] for i in range(0, len(limited), size)]
                if splits + len(redo) > GQL_SPLITS:
                    redo = []  # this tick's re-reads are spent: they wait for the next cycle, at the smaller size
                splits += len(redo)
                left = [e for c in queue for e in c]
                size = self.batch[kind]
                queue = redo + [left[i:i + size] for i in range(0, len(left), size)]
                continue
            if len(chunk) == 1 and chunk[0]["key"] in self.heavy or (len(chunk) == 1 and error and SLOW.search(error)):
                # a lone read says nothing about the batch size; it only judges this entry
                h = self.heavy.setdefault(chunk[0]["key"], {"at": self.now, "fails": 0, "oks": 0})
                h["at"] = self.now
                if error is None:
                    h["fails"], h["oks"] = 0, h["oks"] + 1
                    if h["oks"] >= 2:
                        self.heavy.pop(chunk[0]["key"])  # answered twice alone: back into the batches
                elif SLOW.search(error):
                    h["fails"], h["oks"] = h["fails"] + 1, 0
                continue
            if error is None:
                self.clean[kind] += 1
                if self.clean[kind] >= GQL_GROW_AFTER and len(chunk) >= self.batch[kind] < GQL_BATCH:
                    self.batch[kind] += 1
                    self.clean[kind] = 0
                continue
            slow = bool(SLOW.search(error))
            if not slow and not FLAKY.search(error) or len(chunk) < 2:
                continue
            self.clean[kind] = 0
            if slow and not shrunk and self.batch[kind] > GQL_BATCH_MIN:
                shrunk = True
                self.batch[kind] = max(GQL_BATCH_MIN, self.batch[kind] // 2)
                log({"event": "batch", "kind": kind, "size": self.batch[kind], "after": error})
            if splits + 2 <= GQL_SPLITS:
                splits += 2
                half = (len(chunk) + 1) // 2
                left = [e for c in queue for e in c]
                size = self.batch[kind]
                queue = [chunk[:half], chunk[half:]] + [left[i:i + size] for i in range(0, len(left), size)]
        return []

    def oldest_data(self, entries: list[dict], fetched: set[str]) -> dict[str, float | None]:
        """Per kind, how old the oldest data of an open (not finished) watch is. A finished one is
        re-read only every TERMINAL_REFRESH by design, so it does not count. self.stale_waited gets the same
        for the watches a wait is blocked on only: those are read every cycle, so an old one there is starved
        (STALE_DATA_AFTER), where an idle PR's old data is only its backoff."""
        oldest: dict[str, float | None] = {kind: None for kind in CYCLES}
        self.stale_waited = {kind: None for kind in CYCLES}
        self.stale_waited_key: dict[str, str] = {}
        self.since = {e["key"]: self.since.get(e["key"], self.now) for e in entries}
        for e in entries:
            kind = split_key(e["key"])[0]
            cached = read_cache(e["key"]) if e["key"] in fetched else e["cache"]
            if cached and terminal(kind, cached.get("data")):
                continue
            # never read yet (a heavy PR timing out since it was registered): as old as its watch here
            seen = (cached or {}).get("dataAt") or self.since[e["key"]]
            age_s = max(0.0, self.now - seen)
            oldest[kind] = max(oldest[kind] or 0.0, age_s)
            if self.waited(e) and age_s >= (self.stale_waited[kind] or 0.0):
                self.stale_waited[kind] = age_s
                self.stale_waited_key[kind] = e["key"]
        return oldest

    def tick_failed(self, error: str, site: str, now: float | None = None) -> None:
        """A tick raised. The daemon is alive but refreshes nothing, so keep the heartbeat and say
        why: without this, a tick that raised every time looked like a hung daemon to clients, and a
        restart (which could not help) was their only advice."""
        self.now = time.time() if now is None else now
        first = self.failing is None
        since = self.now if first else self.failing["since"]
        count = 1 if first else self.failing["count"] + 1
        self.failing = {"error": error, "site": site, "since": since, "count": count}
        if first or self.now - self.beat >= HEARTBEAT_EVERY:
            write_json(BASE / "daemon.json", {**self.status, "pid": os.getpid(), "at": self.now,
                                              "heartbeat": HEARTBEAT_EVERY, "failing": self.failing})
            self.beat = self.now

    def store(self, key: str, prior: dict | None, **fields: Any) -> None:
        cache_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
        cache = cache_dir() / file_name(key)
        with bounded_lock(cache_dir() / ".write.lock") as held:
            if not held:
                self.errors.append(f"{key}: cache write lock timeout")
                return
            current = read_json(cache)
            base = current if isinstance(current, dict) else prior
            entry = {"key": key, "fetchedAt": self.now, "dataAt": None, "data": None, "error": None}
            if base:
                entry.update({k: base[k] for k in ("dataAt", "data", "etag", "jobs", "jobsEtag", "jobsAt", "jobsTried", "restAt", "source", "restParts", "restRun", "restRunAt", "origin", "via", "rerunAt", "fp", "fullAt", "wholeAt")
                              if k in base})
            entry.update(fields)
            if key.startswith("pr:") and isinstance(entry.get("data"), dict) and "data" in fields:
                old = (base or {}).get("data") if isinstance((base or {}).get("data"), dict) else {}
                head = entry["data"].get("headRefOid")
                seen = old.get("headSeenAt") if head and old.get("headRefOid") == head else None
                if head and entry["data"].get("headSeenAt") is None:
                    entry["data"] = {**entry["data"], "headSeenAt": seen if seen is not None else self.now}
            write_json(cache, entry)

    def fail(self, entries: list[dict], message: str) -> None:
        self.errors.append(message)
        for e in entries:
            self.store(e["key"], e["cache"], error=message)

    def graphql(self, query: str, variables: dict) -> tuple[dict | None, str | None]:
        """(doc, None) or (None, error message). Notes the rateLimit field when the query asks for it."""
        try:
            status, _, doc = self.request("POST", "/graphql", {"query": query, "variables": variables})
        except (WatchError, OSError) as error:  # (a held or timed-out query is not counted: it may not have run)
            return None, f"graphql: {describe(error)}"
        rate = ((doc.get("data") or {}).get("rateLimit") or {}) if isinstance(doc, dict) else {}
        cost = rate.get("cost") if isinstance(rate, dict) else None
        points = cost if isinstance(cost, int) and not isinstance(cost, bool) and cost > 0 else 1
        self.gql_log.append((self.now, self.gql_reason, points))
        self.note_spend("graphql", self.gql_reason, 1, points)
        if status != 200 or not isinstance(doc, dict):
            return None, f"graphql: HTTP {status}"
        if rate:
            self.note_budget("graphql", rate.get("limit"), rate.get("remaining"), iso_epoch(rate.get("resetAt")))
        return doc, None

    def fetch_aliased(self, entries: list[dict], kind: str) -> str | None:
        """None, or the error when the whole query failed (batched() halves on a timeout)."""
        query, variables = pr_query([e["key"] for e in entries], kind)
        self.reads += [(self.now, kind, "graphql")] * len(entries)
        doc, error = self.graphql(query, variables)
        if doc is None:
            self.fail(entries, error or "graphql: no response")
            return error or "graphql: no response"
        data = doc.get("data") or {}
        if not data and doc.get("errors"):  # GitHub reports a timeout as 200 with data null
            message = "graphql: " + str((doc["errors"][0] or {}).get("message"))[:200]
            self.fail(entries, message)
            return message
        problems: dict[str, dict] = {}
        limits: dict[str, str] = {}  # alias -> GitHub's message, for an alias a field of which hit the resource limit
        for err in doc.get("errors") or []:
            path = err.get("path") or [""]
            problems[str(path[0])] = err
            if err.get("type") == RESOURCE_LIMITS:
                limits.setdefault(str(path[0]), str(err.get("message") or RESOURCE_LIMITS)[:200])
        alias, field = ("p", "pullRequest") if kind == "pr" else ("c", "issueOrPullRequest")
        parsed = {}
        fps: dict[int, str | None] = {}  # PR alias -> its fingerprint (pr_fingerprint), None when partial
        attempts: dict[int, list[str] | str] = {}  # PR alias -> its suites whose newest attempt ran nothing
        nulls: dict[int, int] = {}  # PR alias -> context nodes GitHub answered null (drop_null_contexts)
        kept: set[int] = set()  # PR aliases whose cached, paged answer this first page confirms (unchanged_paged)
        if kind == "pr":
            for i in range(len(entries)):
                node = (data.get(f"{alias}{i}") or {}).get(field)
                if node:
                    nulls[i] = drop_null_contexts(node)
                    if not nulls[i] and f"{alias}{i}" not in limits and self.unchanged_paged(entries[i], node):
                        kept.add(i)
                        continue
                    commit = (((node.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}
                    attempts[i] = ran_nothing_suites(commit)
        # one read for the whole batch's suites, not one per PR: most cmux heads have a few such suites
        suite_runs, suites_error = self.suite_runs(
            [s for found in attempts.values() if isinstance(found, list) for s in found], paced=False)
        for i, e in enumerate(entries):
            node = (data.get(f"{alias}{i}") or {}).get(field)
            if i in kept:
                continue
            if node:
                page_error = None
                if kind == "pr":
                    page_error = self.extend_pr_contexts(e, node)
                    page_error = self.add_last_real_contexts(node, attempts[i], suite_runs, suites_error) or page_error
                    # a context GitHub could not read may be a red one: partial, never greener
                    page_error = page_error or (null_contexts_error(nulls[i]) if nulls.get(i) else None)
                parsed[i] = parse_pr(node) if kind == "pr" else parse_comments(node)
                if kind == "pr" and f"{alias}{i}" in limits:
                    # a field GitHub gave up on is null here, wherever it sits: the PR reads pending, never green
                    page_error = page_error or "graphql: " + limits[f"{alias}{i}"]
                if page_error:
                    parsed[i]["checksPageError"] = page_error
                if kind == "pr":
                    fps[i] = None if page_error else pr_fingerprint(node)
        if kind == "pr":
            self.fill_steps([(entries[i], d) for i, d in parsed.items()])
        self.limited = [e for i, e in enumerate(entries) if f"{alias}{i}" in limits]
        for i, e in enumerate(entries):
            if i in kept:
                self.store(e["key"], e["cache"], dataAt=self.now, via="graphql-probe", fullAt=self.now)
                continue
            if i in parsed:
                # a REST read's kept answers are dead weight in a file clients re-read every 3 s
                more = {"fp": fps.get(i), "fullAt": self.now, "wholeAt": self.now} if kind == "pr" else {}
                self.store(e["key"], e["cache"], dataAt=self.now, data=parsed[i], restParts=None, via="graphql", **more)
                continue
            err = problems.get(f"{alias}{i}") or {}
            what = "pull request" if kind == "pr" else "issue or pull request"
            # only GitHub saying NOT_FOUND for this alias means it does not exist (or is not visible)
            self.store(e["key"], e["cache"], error=str(err.get("message") or f"no data for this {what}")[:200],
                       missing=err.get("type") == "NOT_FOUND")

    def unchanged_paged(self, e: dict, node: dict) -> bool:
        """Whether a full read's first page of a PR past one page of checks confirms its cached, whole answer: the
        cache is a whole GraphQL read with a fingerprint, the fingerprint (every check run and status counted by
        state, over all pages) is the same, and every check on this first page reads as cached. Then the cache stands
        (dataAt and fullAt move) and its follow-up pages, its last-real-attempt suites and its steps are not read.
        cosmic-gray, 2026-11-11 15:40Z: 7 of 74 open PRs sat partial with "PR check pages wait for the per-minute
        ceiling"; a partial PR is never probed, so each was read in full again every cycle, and pages that waited for
        the ceiling made it partial again (688 "pr" points in the hour, the daemon at its 40 a minute)."""
        contexts = ((((node.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}).get(
            "statusCheckRollup") or {}
        if not ((contexts.get("contexts") or {}).get("pageInfo") or {}).get("hasNextPage"):
            return False  # one page: the full read is cheap and replaces the answer whole
        if not self.probe_ok({**e, "cache": {**(e.get("cache") or {}), "fullAt": self.now}}):
            return False  # (probe_ok's rules but the PR_FULL_EVERY bound: this is that full read)
        cached = e["cache"]
        whole = cached.get("wholeAt")
        if not isinstance(whole, (int, float)) or self.now - whole >= PR_WHOLE_EVERY:
            return False  # pages, the base's rules and required flags are read whole this often (review of #1956)
        if pr_fingerprint(node) != cached.get("fp"):
            return False
        known = {(c.get("workflow"), c.get("name")): (c.get("status"), c.get("conclusion"), bool(c.get("required")))
                 for c in cached["data"].get("checks") or []}
        first = parse_pr(node).get("checks") or []
        return all(known.get((c.get("workflow"), c.get("name"))) == (c.get("status"), c.get("conclusion"),
                                                                      bool(c.get("required"))) for c in first)

    def gql_minute_points(self) -> int:
        """GraphQL points this daemon spent in the last 60 s (graphqlPerMinute)."""
        return sum(points for at, _why, points in self.gql_log if self.now - at < 60)

    def gql_room(self) -> bool:
        """Whether one more GraphQL query fits under the per-minute ceiling (policy graphqlPerMinute)."""
        return self.gql_minute_points() < self.policy.get("graphqlPerMinute", GRAPHQL_PER_MINUTE)

    def pr_pages_points(self) -> int:
        """GraphQL points the follow-up check pages spent in the last hour (PR_PAGES_POINTS_PER_HOUR)."""
        return sum(points for at, why, points in self.gql_log if why == "pr-pages" and self.now - at < 3600)

    def add_last_real_contexts(self, node: dict, suites: list[str] | str, runs: dict[str, list[dict]],
                               runs_error: str | None) -> str | None:
        """Add to a PR node's rollup the check runs of SUITES, its suites whose newest attempt ran nothing, from RUNS
        (suite_runs over the batch); the error when they cannot be read, so the cached rollup is partial, never green."""
        commit = (((node.get("commits") or {}).get("nodes") or [{}])[0] or {}).get("commit") or {}
        extra, error = suites_contexts(suites, runs, runs_error)
        if extra:
            rollup = commit.get("statusCheckRollup")
            if not isinstance(rollup, dict):
                rollup = commit["statusCheckRollup"] = {"state": None, "contexts": {"nodes": []}}
            contexts = rollup.setdefault("contexts", {})
            contexts["nodes"] = list(contexts.get("nodes") or []) + extra
        return error

    def extend_pr_contexts(self, entry: dict, node: dict) -> str | None:
        """Follow a PR's cached statusCheckRollup pages so status pr sees required checks beyond 100.

        The first PR query is deliberately batched. Follow-up pages use the already-known exact head
        commit and are bounded; a partial page is retained with an explicit error and never treated as
        a green verdict. This keeps the normal path brokered and avoids REST fallback for large rolls.
        """
        commits = ((node.get("commits") or {}).get("nodes") or [{}])
        commit = (commits[0] or {}).get("commit") or {}
        rollup = commit.get("statusCheckRollup") or {}
        contexts = rollup.get("contexts") or {}
        page = contexts.get("pageInfo") or {}
        sha = node.get("headRefOid")
        if not page.get("hasNextPage") or not sha or not re.fullmatch(r"[0-9a-fA-F]{40}", str(sha)):
            return None
        _, owner, repo, number = split_key(entry["key"])
        nodes = list(contexts.get("nodes") or [])
        base = node.get("baseRef") or {}
        required = set((base.get("branchProtectionRule") or {}).get("requiredStatusCheckContexts") or [])
        for rule in ((base.get("rules") or {}).get("nodes") or []):
            for item in ((rule.get("parameters") or {}).get("requiredStatusChecks") or []):
                if item.get("context"):
                    required.add(item["context"])
        reported = {c.get("name") or c.get("context") for c in nodes}
        # Once every required context is in the first page, keep the cache to one cheap query. The
        # rollup's totalCount/pageInfo still tell callers that optional contexts are only a slice, and a
        # truncated rollup's verdict comes from GitHub's checkState (check_verdict). A base that requires
        # no context has nothing to find past the first page either: paging every such PR on every
        # cycle was 1678 of one daemon's 1958 GraphQL points an hour (2026-11-04 03:33Z, 139 cmux PRs
        # over 100 checks on feat-cmux-next, which requires none), and ran the shared login's GraphQL
        # hour out before landings could read their gates.
        if not required or required.issubset(reported):
            return None
        cursor = page.get("endCursor")
        for _ in range(PR_CONTEXT_MAX_PAGES - 1):
            if not cursor:
                return "graphql: PR check page has no cursor"
            if self.pr_pages_points() >= PR_PAGES_POINTS_PER_HOUR:
                # Over its hourly share: a required context may sit past this page, so the PR reads pending
                # (checksPageError), never green on a partial rollup, until the rolling hour frees room.
                return "graphql: PR check pages over their hourly share"
            if not self.gql_room():
                return "graphql: PR check pages wait for the per-minute ceiling"
            reason, self.gql_reason = self.gql_reason, "pr-pages"
            try:
                more, error = self.graphql("query{" + head_query(owner, repo, str(sha), cursor, int(number)) + "}", {})
            finally:
                self.gql_reason = reason
            if more is None:
                return error or "graphql: PR check page unavailable"
            rollup_more = (((more.get("data") or {}).get("repository") or {}).get("object") or {}).get("statusCheckRollup")
            contexts_more = (rollup_more or {}).get("contexts") or {}
            if more.get("errors") or not rollup_more:
                return "graphql: PR check page unavailable"
            more_nodes = contexts_more.get("nodes") or []
            dropped = sum(1 for c in more_nodes if not isinstance(c, dict))
            more_nodes = [c for c in more_nodes if isinstance(c, dict)]
            nodes.extend(more_nodes)
            reported |= {c.get("name") or c.get("context") for c in more_nodes}
            page = contexts_more.get("pageInfo") or {}
            cursor = page.get("endCursor")
            contexts["nodes"] = nodes
            contexts["totalCount"] = contexts_more.get("totalCount", contexts.get("totalCount", len(nodes)))
            contexts["pageInfo"] = page
            if dropped:
                return null_contexts_error(dropped)
            if not page.get("hasNextPage"):
                return None
            if required and required.issubset(reported):
                return None
        return f"graphql: more than {PR_CONTEXT_MAX_PAGES * 100} PR checks"

    def fetch_prs(self, entries: list[dict]) -> str | None:
        """The batch's PRs: the ones a probe may confirm (probe_ok) are probed first, one cheap query (PR_PROBE_FIELDS),
        and only the rest, and the probed ones that changed, are read in full."""
        probe = [e for e in entries if self.probe_ok(e)]
        full = [e for e in entries if not self.probe_ok(e)]
        if probe:
            changed, error = self.probe_prs(probe)
            if error is not None:
                self.fail(entries, error)
                return error
            full += changed
        return self.fetch_aliased(full, "pr") if full else None

    def probe_ok(self, e: dict) -> bool:
        """Whether this PR's cached answer may be confirmed by a probe instead of read in full: a whole GraphQL read
        (no error, nothing partial) with its fingerprint, read in full within PR_FULL_EVERY, still open, and every
        failed or cancelled check's steps already read (fill_steps reads a few a cycle and only on a full read)."""
        c = e.get("cache") or {}
        data = c.get("data")
        # (an answer from an upstream keeps this host's old fp: never confirmed against it)
        return (isinstance(c.get("fp"), str) and c.get("via") in ("graphql", "graphql-probe") and not c.get("error")
                and c.get("source") != "upstream"
                and isinstance(data, dict) and not data.get("checksPageError") and data.get("state") == "OPEN"
                and isinstance(c.get("fullAt"), (int, float)) and self.now - c["fullAt"] < PR_FULL_EVERY
                and not any(wants_steps(ch) and "failedSteps" not in ch for ch in data.get("checks") or []))

    def probe_prs(self, entries: list[dict]) -> tuple[list[dict], str | None]:
        """One PR_PROBE query for ENTRIES: those whose fingerprint matches their cache are confirmed (dataAt and
        fetchedAt move, the answer stays); the ones that changed, or that the probe could not read, come back to be read
        in full. (changed, None), or ([], the error) when the whole query failed."""
        query, variables = pr_query([e["key"] for e in entries], "probe")
        reason, self.gql_reason = self.gql_reason, "pr-probe"
        try:
            doc, error = self.graphql(query, variables)
        finally:
            self.gql_reason = reason
        if doc is None:
            return [], error or "graphql: no response"
        data = doc.get("data") or {}
        if not data and doc.get("errors"):
            return [], "graphql: " + str((doc["errors"][0] or {}).get("message"))[:200]
        failed = {str((err.get("path") or [""])[0]) for err in doc.get("errors") or [] if isinstance(err, dict)}
        changed = []
        for i, e in enumerate(entries):
            node = (data.get(f"p{i}") or {}).get("pullRequest")
            if f"p{i}" in failed or pr_fingerprint(node) != (e.get("cache") or {}).get("fp"):
                changed.append(e)
                continue
            self.reads.append((self.now, "pr", "graphql"))
            self.store(e["key"], e["cache"], dataAt=self.now, via="graphql-probe")
        return changed, None

    def fetch_comments(self, entries: list[dict]) -> str | None:
        return self.fetch_aliased(entries, "comment")

    def fetch_heads(self, entries: list[dict]) -> str | None:
        """Every check on each head commit, one aliased query for the batch (a head with more than 100
        contexts is followed page by page). None, or the error when the whole query failed."""
        parts = []
        for i, e in enumerate(entries):
            _, owner, repo, sha = split_key(e["key"])
            parts.append(f"h{i}: " + head_query(owner, repo, sha))
            if (owner, repo) in CHECKS_OF_RECORD:
                parts.append(f"m{i}: " + head_query(*CHECKS_OF_RECORD[(owner, repo)], sha))
        self.reads += [(self.now, "head", "graphql")] * len(entries)
        doc, error = self.graphql("query{rateLimit{limit remaining resetAt cost}\n" + "\n".join(parts) + "}", {})
        if doc is None:
            self.fail(entries, error or "graphql: no response")
            for e in entries:
                self.refund(e["key"])
            return error or "graphql: no response"
        data = doc.get("data") or {}
        if not data and doc.get("errors"):
            message = "graphql: " + str((doc["errors"][0] or {}).get("message"))[:200]
            self.fail(entries, message)
            for e in entries:
                self.refund(e["key"])
            return message
        # Suites whose newest attempt ran nothing, in each head and its check-of-record commit: one read for the batch.
        attempts = {alias: ran_nothing_suites((data.get(alias) or {}).get("object"))
                    for i in range(len(entries)) for alias in (f"h{i}", f"m{i}")}
        suite_runs, suites_error = self.suite_runs(
            [s for found in attempts.values() if isinstance(found, list) for s in found], paced=False)
        for i, e in enumerate(entries):
            _, owner, repo, sha = split_key(e["key"])
            node = ((data.get(f"h{i}") or {}).get("object") or {}).get("statusCheckRollup")
            if not (data.get(f"h{i}") or {}).get("object"):
                self.store(e["key"], e["cache"], error="no such commit", missing=True)
                self.refund(e["key"])
                continue
            sources = [(owner, repo, (node or {}).get("contexts") or {})]
            if (owner, repo) in CHECKS_OF_RECORD:
                # An error on the check-of-record read is an error for the head, never a head without those checks:
                # a partial answer would read as a smaller, greener head.
                failed = [err for err in doc.get("errors") or [] if (err.get("path") or [None])[0] == f"m{i}"]
                if failed:
                    self.store(e["key"], e["cache"],
                               error="graphql: " + str(failed[0].get("message") or "check-of-record read failed")[:200])
                    self.refund(e["key"])
                    continue
                # A commit the fork does not have yet (sync-main pushes there within a minute) adds nothing, as does a
                # pull request head opened here, which the fork never gets.
                commit = (data.get(f"m{i}") or {}).get("object")
                record = (commit or {}).get("statusCheckRollup") or {}
                sources.append((*CHECKS_OF_RECORD[(owner, repo)], record.get("contexts") or {}))
            # Suites whose newest attempt ran nothing, in each source (the check-of-record one under its prefix).
            extra, extra_error = [], None
            objects = [("", f"h{i}")]
            if (owner, repo) in CHECKS_OF_RECORD:
                objects.append(("{}/{}: ".format(*CHECKS_OF_RECORD[(owner, repo)]), f"m{i}"))
            for prefix, obj in objects:
                nodes, extra_error = suites_contexts(attempts[obj], suite_runs, suites_error)
                if extra_error:
                    break
                extra.append((prefix, nodes))
            if extra_error:
                self.store(e["key"], e["cache"], error=extra_error)
                self.refund(e["key"])
                continue
            result = self.head_pages(sha, sources, extra)
            if (owner, repo) in CHECKS_OF_RECORD and commit and isinstance(result, dict) \
                    and not ((record.get("contexts") or {}).get("nodes")):
                # the fork has the commit but its checks have not started: not settled on this repository's alone
                result["settled"] = False
            if isinstance(result, str):
                self.store(e["key"], e["cache"], error=result)
                self.refund(e["key"])
                if self.mode("graphql") == "stop":
                    self.spill.append(e)  # a later page met the limit: REST reads it this tick
            else:
                self.store(e["key"], e["cache"], error=None, dataAt=self.now, data=result, restParts=None, via="graphql")
                self.head_answered(e["key"])

    def last_real_contexts(self, suites: list[str] | str) -> tuple[list[dict], str | None]:
        """Check-run context nodes (statusCheckRollup's shape, marked lastRealAttempt) for every attempt of SUITES,
        suites whose newest attempt ran nothing (ran_nothing_suites). ([], error) when they cannot all be read: a
        partial read would be a smaller, greener head."""
        if isinstance(suites, str):
            return [], suites
        runs, error = self.suite_runs(suites)
        return suites_contexts(suites, runs, error)

    def suite_runs(self, suites: list[str], paced: bool = True) -> tuple[dict[str, list[dict] | str], str | None]:
        """Suite id -> its check-run context nodes over every attempt (statusCheckRollup's shape, marked
        lastRealAttempt), or the error that suite alone could not be read with (held by the pace, no response, a
        nested error), SUITE_RUNS_BATCH suites per query. The second value is always None, kept for the callers.

        Paced like every other query (glaeda#1844 F2): past graphqlPerMinute it reads nothing, and unread is partial,
        never green; the next cycle reads it. A batch's own follow-up (PACED false) is never held: it is part of the
        read the ceiling already admitted, and holding a later chunk starved the PRs whose suites sort last, which the
        next cycle held the same way (router-review BLOCK on glaeda#1916 at 73069ea7). It is bounded by the batch: at
        most GQL_BATCH PRs (or heads and their check-of-record commits) of at most 100 suites, so 2 * GQL_BATCH queries
        of one point each, and far fewer in practice (a cmux head has about 15 such suites)."""
        suites = list(dict.fromkeys(suites))
        out: dict[str, list[dict] | str] = {}
        # Every failure is the error of the suites it left unread only (router-review BLOCKs on glaeda#1916 at
        # a01313fc and af5363f6): the batch holds many PRs' suites, and what was read stays read.
        for start in range(0, len(suites), SUITE_RUNS_BATCH):
            chunk = suites[start:start + SUITE_RUNS_BATCH]
            if paced and not self.gql_room():
                for suite_id in suites[start:]:
                    out[suite_id] = "graphql: last real attempt: held by graphqlPerMinute; read next cycle"
                break
            reason, self.gql_reason = self.gql_reason, "last-real-attempt"
            try:
                doc, error = self.graphql(SUITE_RUNS, {"suites": chunk})
            finally:
                self.gql_reason = reason
            if doc is None:
                for suite_id in suites[start:]:
                    out[suite_id] = error or "graphql: no response"
                break
            found = (doc.get("data") or {}).get("suiteRuns")
            errors = [e for e in doc.get("errors") or [] if isinstance(e, dict)]
            message = "graphql: last real attempt: " + str(
                (errors[0] if errors else {}).get("message") or "a suite could not be read")[:200]
            # a nested error names its suite by path (["suiteRuns", i, ...]); one with no such path names them all
            hit: set[int] = set()
            for e in errors:
                path = e.get("path")
                if isinstance(path, list) and len(path) > 1 and path[0] == "suiteRuns" and type(path[1]) is int:
                    hit.add(path[1])
                else:
                    hit.update(range(len(chunk)))
            if not isinstance(found, list) or len(found) != len(chunk):
                found = [None] * len(chunk)
            for n, (suite_id, suite) in enumerate(zip(chunk, found)):
                runs = suite.get("checkRuns") if isinstance(suite, dict) else None
                nodes = runs.get("nodes") if isinstance(runs, dict) else None
                if n in hit or not isinstance(nodes, list) or not all(isinstance(r, dict) for r in nodes):
                    out[suite_id] = message  # a null field beside an error is no empty suite: never greener
                    continue
                if (runs.get("pageInfo") or {}).get("hasNextPage"):
                    out[suite_id] = "graphql: last real attempt: more than 100 check runs in one suite"
                    continue
                context = {"conclusion": suite.get("conclusion"), "app": suite.get("app"),
                           "workflowRun": suite.get("workflowRun")}
                out[suite_id] = [{"__typename": "CheckRun", **run, "checkSuite": context, "lastRealAttempt": True}
                                 for run in nodes]
        return out, None

    def head_pages(self, sha: str, sources: list[tuple[str, str, dict]],
                   extra: list[tuple[str, list[dict]]] = ()) -> dict | str:
        """A head's data from the first page of its contexts in each repository of `sources` ((owner, repo,
        contexts): the head's own, then its CHECKS_OF_RECORD repository's), following the rest page by page; an
        error message when a later page cannot be read (the head keeps its older answer)."""
        runs: dict = {}
        statuses: dict = {}
        ids: dict = {}
        for n, (owner, repo, contexts) in enumerate(sources):
            prefix = f"{owner}/{repo}: " if n else ""  # the head's own checks keep their names
            for _ in range(HEAD_BATCH_MAX_CONTEXTS_PAGES):
                fold_contexts(contexts.get("nodes"), runs, statuses, ids, prefix)
                page = contexts.get("pageInfo") or {}
                if not page.get("hasNextPage"):
                    break
                reason, self.gql_reason = self.gql_reason, "head-pages"
                try:
                    more, error = self.graphql("query{" + head_query(owner, repo, sha, page.get("endCursor")) + "}", {})
                finally:
                    self.gql_reason = reason
                if more is None:
                    return error or "graphql: no response"
                rollup = ((((more.get("data") or {}).get("repository") or {}).get("object") or {}).get("statusCheckRollup"))
                if more.get("errors") or not rollup:  # a partial page would read as a smaller, greener head
                    return "graphql: " + str(((more.get("errors") or [{}])[0] or {}).get("message") or "no further page")[:200]
                contexts = rollup.get("contexts") or {}
            else:
                return f"more than {HEAD_BATCH_MAX_CONTEXTS_PAGES * 100} checks on one commit"
        for prefix, nodes in extra:  # suites whose newest attempt ran nothing (last_real_contexts), per source
            fold_contexts(nodes, runs, statuses, ids, prefix)
        return head_data(sha, runs, statuses, ids)

    def fill_steps(self, pairs: list[tuple[dict, dict]]) -> None:
        """Name the failed steps of each failed check run. A completed check does not change, so a
        check whose steps an earlier fetch read keeps them and costs nothing; the rest share one
        small query. When that query fails the checks go without, and the next cycle tries again."""
        known = known_steps(pairs)
        want: dict[str, list[dict]] = {}
        owners: dict[str, set[str]] = {}  # check id -> the keys of the PRs that show it
        for e, data in pairs:
            for c in data.get("checks") or []:
                if not wants_steps(c):
                    continue
                if c["id"] in known:
                    c["failedSteps"], c["stepCount"] = known[c["id"]]
                elif not settled_pr(data):  # a settled PR keeps what is cached; nothing new is read for it
                    want.setdefault(c["id"], []).append(c)
                    owners.setdefault(c["id"], set()).add(e["key"])
        ids = list(want)[:2 * STEPS_BATCH]  # the rest wait a cycle (failed and cancelled checks; each is read once)
        for i in range(0, len(ids), STEPS_BATCH):
            if self.mode("graphql") == "stop":
                return
            try:
                reason, self.gql_reason = self.gql_reason, "steps"
                try:
                    doc, error = self.graphql(STEPS_QUERY, {"ids": ids[i:i + STEPS_BATCH]})
                finally:
                    self.gql_reason = reason
            except OutOfTime:  # the checks go without their steps; their PRs go first next tick
                for check_id in ids[i:]:
                    self.deferred.update(owners[check_id])
                return
            if doc is None:
                self.errors.append(f"steps: {error}")
                return
            for node in (doc.get("data") or {}).get("nodes") or []:
                if isinstance(node, dict) and node.get("id") in want:
                    steps = (node.get("steps") or {}).get("nodes")
                    names = failed_steps(steps)
                    for c in want[node["id"]]:
                        # steps null (a partial error) is unknown, never "no step ran"
                        c["failedSteps"], c["stepCount"] = names, len(steps) if isinstance(steps, list) else None

    def get(self, path: str, etag: str | None) -> tuple[str, Any, str | None]:
        """("fresh", doc, etag), ("same", None, etag) on 304, or ("error", message, None)."""
        try:
            status, h, doc = self.request("GET", path, etag=etag)
        except (WatchError, OSError) as error:
            return "error", f"rest: {describe(error)}", None
        if status == 304:
            return "same", None, etag
        if status == 200 and isinstance(doc, (dict, list)):  # .../rules/branches/B answers a list
            return "fresh", doc, h.get("etag")
        message = (doc or {}).get("message", "") if isinstance(doc, dict) else ""
        return "error", f"HTTP {status} {message}".strip()[:200], None

    def fetch_run(self, e: dict) -> None:
        _, owner, repo, run_id = split_key(e["key"])
        prior = e["cache"] or {}
        self.reads.append((self.now, "run", "rest"))
        base = f"/repos/{owner}/{repo}/actions/runs/{run_id}"
        # a confirmation asks without the ETag: a 304 would prove only what the ETag's own read showed, which the
        # controller's newer record replaced (and a cache from before restRun has nothing to prove it with)
        unconfirmed = controller_unconfirmed(prior, self.now)
        state, doc, etag = self.get(base, prior.get("etag") if prior.get("data") and not unconfirmed else None)
        if state == "error":
            self.errors.append(f"{e['key']}: {doc}")
            # a 404 for a run no read ever showed: it does not exist (or is not visible), wait_step's not-found
            return self.store(e["key"], e["cache"], error=doc,
                              missing=not prior.get("data") and str(doc).startswith("HTTP 404"))
        # restAt: the last direct read from GitHub, over either bucket (the controller's safety-net clock)
        fields: dict[str, Any] = {"error": None, "etag": etag, "dataAt": self.now, "restAt": self.now, "via": "rest"}
        if state == "fresh":
            fields["data"] = slim_run(doc)
            fields["restRun"] = rest_run(fields["data"])
            fields["restRunAt"] = self.now
            # a run the controller tracks keeps that source; REST was only the safety-net check
            if prior.get("source") != "controller" or \
                    (iso_epoch(doc.get("updated_at")) or 0) > (iso_epoch((prior.get("data") or {}).get("updated_at")) or 0):
                fields["source"] = "rest"
        elif prior.get("restRun") is not None:
            fields["restRunAt"] = self.now  # a 304: what the ETag's read showed is still GitHub's
        self.read_jobs(e, fields, state == "fresh")

    def fetch_runs_graphql(self, entries: list[dict]) -> str | None:
        """Runs over GraphQL, for when REST is the poorer bucket: one aliased query by run URL. A run
        GraphQL cannot resolve is an error, as REST's 404 is; it is also missing (wait_step's not-found) when no
        read ever showed it: a run that exists has data from its first read."""
        query, variables = run_query([e["key"] for e in entries])
        self.reads += [(self.now, "run", "graphql")] * len(entries)
        doc, error = self.graphql(query, variables)
        if doc is None:
            self.fail(entries, error or "graphql: no response")
            return error or "graphql: no response"
        data = doc.get("data") or {}
        problems = {str((err.get("path") or [""])[0]): err for err in doc.get("errors") or [] if isinstance(err, dict)}
        if not data and problems:  # the whole query failed (a schema change, say): say what GitHub said
            message = "graphql: " + str(next(iter(problems.values())).get("message"))[:200]
            self.fail(entries, message)
            return message
        for i, e in enumerate(entries):
            node = data.get(f"w{i}")
            if not isinstance(node, dict) or node.get("__typename") != "WorkflowRun":
                message = "graphql: " + str((problems.get(f"w{i}") or {}).get("message") or "no workflow run at this URL")[:200]
                self.errors.append(f"{e['key']}: {message}")
                problem = problems.get(f"w{i}") or {}
                self.store(e["key"], e["cache"], error=message,
                           missing=not (e["cache"] or {}).get("data")
                           and (problem.get("type") == "NOT_FOUND" or not problems))
                continue
            prior = e["cache"] or {}
            before = prior.get("data") or {}
            run = graphql_run(node)
            run["head_branch"] = run["head_branch"] or before.get("head_branch") or ""
            fresh = any(run.get(k) != before.get(k) for k in ("status", "conclusion", "run_attempt", "updated_at"))
            fields: dict[str, Any] = {"error": None, "data": run, "dataAt": self.now, "restAt": self.now,
                                      "restRun": rest_run(run), "restRunAt": self.now, "via": "graphql"}
            if prior.get("source") != "controller" or \
                    (iso_epoch(run.get("updated_at")) or 0) > (iso_epoch(before.get("updated_at")) or 0):
                fields["source"] = "graphql"
            self.read_jobs(e, fields, fresh)

    def read_jobs(self, e: dict, fields: dict[str, Any], fresh: bool) -> None:
        """Store a run read, with its job list when wanted. Job lists come from REST on either path:
        only REST names the runner and its labels, which tell a runner's refusal from a failure."""
        _, owner, repo, run_id = split_key(e["key"])
        prior = e["cache"] or {}
        base = f"/repos/{owner}/{repo}/actions/runs/{run_id}"
        run = fields.get("data") or prior.get("data") or {}
        # A failed attempt's job list names the failed steps, and tells a runner's refusal from a real
        # failure. It is read once per attempt, lean or not: callers would otherwise each read it. That
        # is also why it is the one read the REST share does not hold back: a wait cannot rule on a
        # failed run without it, and one request per failed attempt is what keeps every waiter off gh.
        attempt = run.get("run_attempt") or 1
        failed_attempt = (run.get("status") == "completed" and run.get("conclusion") not in RUN_OK
                          and self.mode("rest") != "stop"
                          and (fresh or jobs_attempt(prior.get("jobs")) < attempt)
                          # past the REST share, once per attempt, answered or not: an error or an empty
                          # list would otherwise be asked for again every cycle, past the share
                          and (self.rest_room(1) or prior.get("jobsTried") != attempt))
        if (e["jobs"] and self.mode("rest") == "normal") or failed_attempt:
            try:
                with self.calling(*caller_of(e["key"]), waiter_of(e)):  # its own waiter, inside a batch's call too
                    jstate, jdoc, jetag = self.get(base + "/jobs?per_page=100",
                                                   prior.get("jobsEtag") if "jobs" in prior else None)
            except OutOfTime:  # the run itself is read: store it, and its jobs wait for a later read
                jstate, jdoc, jetag = "late", None, None
            if failed_attempt and jstate != "late":  # sent: a tick out of time sent nothing, so it is not tried
                fields["jobsTried"] = attempt  # in the cache entry, so a restart or a new watch remembers it
            if jstate == "fresh":
                fields.update(jobs=slim_jobs(jdoc), jobsEtag=jetag, jobsAt=self.now)
            elif jstate == "same":
                fields["jobsAt"] = self.now
            elif jstate == "late":
                self.deferred.add(e["key"])
            else:
                self.errors.append(f"{e['key']} jobs: {jdoc}")
        self.store(e["key"], e["cache"], **fields)

    def rest_part(self, old: dict, new: dict, path: str, slim: Callable[[Any], Any], absent: Any = None) -> Any:
        """A conditional GET whose slimmed answer is kept with its ETag: an unchanged resource answers
        304, which costs nothing, and its kept answer is reused. Raises WatchError on an error, except
        a 404 when `absent` is given: then the last answer stands, or `absent` without one. A 403 saying
        the repository's plan lacks the feature (NO_FEATURE) is `absent` too, and says so in `new`."""
        kept = old.get(path) or {}
        if absent is not None and kept.get("unavailable"):
            new[path] = kept  # not asked again until a GraphQL read drops the kept answers
            return absent
        state, doc, etag = self.get(path, kept.get("etag") if "doc" in kept else None)
        if state == "error" and absent is not None and NO_FEATURE.search(str(doc)):
            new[path] = {"doc": absent, "unavailable": True}
            return absent
        if state == "error" and absent is not None and str(doc).startswith("HTTP 404"):
            new[path] = {"doc": kept["doc"], "gone": True} if "doc" in kept else {"doc": absent, "gone": True}
            return new[path]["doc"]
        if state == "error":
            raise WatchError(doc)
        new[path] = kept if state == "same" else {"etag": etag, "doc": slim(doc)}
        return new[path]["doc"]

    def repo_part(self, old: dict, new: dict, path: str, slim: Callable[[Any], Any], absent: Any = None,
                  ttl: float = REST_REPO_PART_TTL) -> Any:
        """rest_part for a path every watch that needs it reads alike (a repository- or base-level path every PR on
        it reads, or a commit's, a pull's or a run's job list, REST_HEAD_PART_TTL): one answer serves every read for
        TTL, then one conditional read (with the newest ETag known) refreshes it for all. A per-PR `unavailable`
        stands as in rest_part; a 404 (a deleted base) is shared as the fact, and each PR keeps its own last answer,
        as rest_part does. An error is never shared."""
        kept = old.get(path) or {}
        if absent is not None and kept.get("unavailable"):
            new[path] = kept
            return absent
        shared = self.repo_parts.get(path)
        if shared is None or self.now - shared["at"] >= ttl:
            lent = (shared or {}).get("part") or {}
            seed = {path: lent} if lent.get("etag") and "doc" in lent else old
            scratch: dict = {}
            self.rest_part(seed, scratch, path, slim, absent)  # raises on an error: nothing is shared
            shared = self.repo_parts[path] = {"at": self.now, "part": scratch[path]}
            self.forget_parts()
        part = shared["part"]
        if part.get("gone"):
            new[path] = {"doc": kept["doc"], "gone": True} if "doc" in kept else {"doc": absent, "gone": True}
        else:
            new[path] = part
        return new[path]["doc"]

    def forget_parts(self) -> None:
        """Drop shared answers past REST_REPO_PART_KEEP, then the oldest past REST_SHARED_MAX."""
        for stale in [p for p, v in self.repo_parts.items() if self.now - v["at"] >= REST_REPO_PART_KEEP]:
            del self.repo_parts[stale]
        over = len(self.repo_parts) - REST_SHARED_MAX
        if over > 0:  # oldest first; this tick's answers last, so the one just stored is never the one dropped
            for stale in sorted(self.repo_parts, key=lambda p: (self.repo_parts[p]["at"] >= self.now,
                                                                self.repo_parts[p]["at"]))[:over]:
                del self.repo_parts[stale]

    def head_part(self, old: dict, new: dict, path: str, slim: Callable[[Any], Any]) -> Any:
        """A commit's, a pull's or a run's job-list read, shared by every watch on it (repo_part, REST_HEAD_PART_TTL)."""
        return self.repo_part(old, new, path, slim, None, REST_HEAD_PART_TTL)

    def fetch_pr_rest(self, e: dict) -> None:
        """One PR over REST, for when GraphQL is the poorer bucket: the pull, its head's check runs,
        statuses and workflow runs (for superseded runs), the repo's workflow names, and the base
        branch's required checks from its rulesets and classic protection. Every read is conditional,
        so a quiet PR costs nothing; the last three are shared by every PR on the repository and base
        (repo_part). A failed read keeps the cached data and says why."""
        _, owner, repo, number = split_key(e["key"])
        prior = e["cache"] or {}
        self.reads.append((self.now, "pr", "rest"))
        root = f"/repos/{owner}/{repo}"
        old, parts = prior.get("restParts") or {}, {}
        try:
            pull = self.head_part(old, parts, f"{root}/pulls/{number}", slim_pull)
            sha = (pull.get("head") or {}).get("sha") or ""
            base = urllib.parse.quote(str((pull.get("base") or {}).get("ref") or ""), safe="/")
            checks, statuses, runs, workflows = self.rest_head(old, parts, root, sha)
            listed = checks["check_runs"]
            # a deleted base (a stacked PR's, after its merge) has no requirements left to read
            rules, protection = f"{root}/rules/branches/{base}?per_page=100", f"{root}/branches/{base}"
            required = set(self.repo_part(old, parts, rules, slim_rules, []))
            required |= set(self.repo_part(old, parts, protection, slim_branch, []))
            if parts[rules].get("unavailable") and parts[protection].get("unavailable"):
                # A private repository on a plan without either feature: GitHub enforces no required check there,
                # so none is the true answer. GraphQL's last word is kept all the same (it can name a rule that
                # predates a plan change); a first read with no GraphQL answer has none, and none is enforced.
                before = prior.get("data") or {}
                required = {c.get("name") for c in before.get("checks") or [] if c.get("required")}
                required |= set(before.get("requiredMissing") or [])
        except WatchError as error:
            message = f"rest: {error}"
            self.errors.append(f"{e['key']}: {message}")
            # only GitHub answering 404 for the pull itself means it does not exist (or is not visible)
            return self.store(e["key"], e["cache"], error=message[:200],
                              missing=not parts and str(error).startswith("HTTP 404"))
        review = (prior.get("data") or {}).get("reviewDecision")  # REST has none: keep GraphQL's last
        data = parse_pr(rest_pr_node(pull, checks, statuses, runs, required, review, workflows))
        self.fill_steps_rest(e, data, root, {c.get("node_id"): c.get("id") for c in listed})
        self.store(e["key"], e["cache"], dataAt=self.now, data=data, restParts=parts, via="rest")

    def rest_head(self, old: dict, parts: dict, root: str, sha: str) -> tuple[dict, list, list, dict]:
        """A commit's check runs (every attempt, up to REST_CHECK_PAGES pages), statuses, workflow runs and the
        repository's workflow names, each a conditional read kept in `parts`. Raises WatchError."""
        # filter=all: every attempt, as GraphQL's rollup lists them, so parse_pr dedupes both alike
        path = f"{root}/commits/{sha}/check-runs?filter=all&per_page=100"
        checks = self.head_part(old, parts, path, slim_check_runs)
        listed = list(checks.get("check_runs") or [])
        for page in range(2, min(REST_CHECK_PAGES, -(-(checks.get("total_count") or 0) // 100)) + 1):
            listed += self.head_part(old, parts, f"{path}&page={page}", slim_check_runs).get("check_runs") or []
        checks = {"total_count": checks.get("total_count"), "check_runs": listed}
        statuses: list[dict] = []
        total = 0
        for page in range(1, REST_STATUS_PAGES + 1):
            got = self.head_part(old, parts, f"{root}/commits/{sha}/status?per_page=100&page={page}", slim_status_page)
            statuses += got.get("statuses") or []
            total = int(got.get("total") or 0)
            if len(statuses) >= total or not got.get("statuses"):
                break
        runs: list[dict] = []
        runs_total = 0
        for page in range(1, REST_RUN_PAGES + 1):
            got = self.head_part(old, parts, f"{root}/actions/runs?head_sha={sha}&per_page=100&page={page}",
                                 slim_head_runs_page)
            runs += got.get("runs") or []
            runs_total = int(got.get("total") or 0)
            if len(runs) >= runs_total or not got.get("runs"):
                break
        if total > len(statuses) or runs_total > len(runs):
            # a partial list would read as a smaller, greener head (a check without its run loses its workflow)
            checks = {**checks, "total_count": max(int(checks.get("total_count") or 0), len(checks["check_runs"]) + 1)}
        workflows = self.repo_part(old, parts, f"{root}/actions/workflows?per_page=100", slim_workflows)
        return checks, statuses, runs, workflows

    def fetch_head_rest(self, e: dict) -> None:
        """One head over REST, for when GraphQL is low or throttled: the same contexts fetch_heads folds."""
        _, owner, repo, sha = split_key(e["key"])
        prior = e["cache"] or {}
        self.reads.append((self.now, "head", "rest"))
        old, parts = prior.get("restParts") or {}, {}
        try:
            checks, statuses, runs, workflows = self.rest_head(old, parts, f"/repos/{owner}/{repo}", sha)
        except WatchError as error:
            self.refund(e["key"])
            # GitHub answers 422 (No commit found) or 404 for a commit it does not know
            missing = not parts and re.match(r"HTTP (404|422)", str(error)) is not None
            return self.store(e["key"], e["cache"], error="no such commit" if missing else f"rest: {error}"[:200],
                              missing=missing)
        if (checks.get("total_count") or 0) > len(checks["check_runs"]):
            self.refund(e["key"])  # a partial list would read as a smaller, greener head
            return self.store(e["key"], e["cache"], error=f"more than {REST_CHECK_PAGES * 100} checks, {REST_STATUS_PAGES * 100} statuses or "
                              f"{REST_RUN_PAGES * 100} workflow runs over REST")
        found: dict = {}
        statuses_by: dict = {}
        ids: dict = {}
        fold_contexts(rest_contexts(checks, statuses, runs, set(), workflows), found, statuses_by, ids)
        self.store(e["key"], e["cache"], error=None, dataAt=self.now, data=head_data(sha, found, statuses_by, ids),
                   restParts=parts, via="rest")
        self.head_answered(e["key"])

    def fetch_comment_rest(self, e: dict) -> None:
        """One comment watch over REST, for when GraphQL is low or throttled: the issue (its state and comment
        count), then the page or two that hold its last COMMENTS_LAST comments. Conditional reads, so a quiet
        issue costs nothing."""
        _, owner, repo, number = split_key(e["key"])
        prior = e["cache"] or {}
        self.reads.append((self.now, "comment", "rest"))
        root = f"/repos/{owner}/{repo}/issues/{number}"
        old, parts = prior.get("restParts") or {}, {}
        try:
            issue = self.rest_part(old, parts, root, slim_issue)
            total = int(issue.get("comments") or 0)
            last = max(1, -(-total // 100))
            comments: list[dict] = []
            # the page before the last too, when the last holds fewer than COMMENTS_LAST
            for page in ([last - 1] if last > 1 and total - 100 * (last - 1) < COMMENTS_LAST else []) + [last]:
                comments += self.rest_part(old, parts, f"{root}/comments?per_page=100&page={page}", slim_comments)
        except WatchError as error:
            message = f"rest: {error}"
            self.errors.append(f"{e['key']}: {message}")
            return self.store(e["key"], e["cache"], error=message[:200],
                              missing=not parts and str(error).startswith("HTTP 404"))
        self.store(e["key"], e["cache"], error=None, dataAt=self.now, data=parse_comments(rest_issue_node(issue, comments)),
                   restParts=parts, via="rest")

    def fill_steps_rest(self, e: dict, data: dict, root: str, job_ids: dict[str, Any]) -> None:
        """fill_steps over REST, for a PR read over REST (GraphQL is the poorer bucket, or stopped). An Actions
        check run's id is its job's id, and a run's job list names every job's steps. A completed job does not
        change, so each is read once. Steps come, cheapest first, from the PR's own cache, the run watch's cached
        job list (free), and the run's job list (`runs/ID/jobs?filter=all`, one read for every job of the run,
        shared by every PR and tick through repo_parts, conditional past REST_HEAD_PART_TTL); a job none of those
        names (a run past REST_JOB_PAGES pages) is read alone, GET .../actions/jobs/ID. At most REST_STEPS_MAX
        reads per PR read, and the rest on the next one. Without its steps a refused or never-started check
        cannot be held. On 2026-11-11 huge-blue's daemon sent 22 jobs/{id} reads in an hour, one per failed job
        of a few runs."""
        known = known_steps([(e, data)])
        left = REST_STEPS_MAX
        self.steps_failed = {j: t for j, t in self.steps_failed.items() if self.now - t < STEPS_RETRY}
        _, owner, repo, _ = split_key(e["key"])
        for c in data.get("checks") or []:
            if not wants_steps(c):
                continue
            if c["id"] in known:
                c["failedSteps"], c["stepCount"] = known[c["id"]]
                continue
            if settled_pr(data):
                continue  # kept above when cached; nothing new is read for a settled PR
            job_id = job_ids.get(c["id"])
            if not job_id or not c.get("runId") or self.mode("rest") == "stop":
                continue
            if job_id in self.steps_failed:
                continue
            got = self.run_cache_job(owner, repo, c["runId"], job_id)
            if got is None and left > 0 and self.rest_room(1):
                try:
                    got, sent = self.run_list_job(root, c["runId"], job_id, left)
                except OutOfTime:  # the PR's checks and statuses are read; it goes first next tick for the steps
                    self.deferred.add(e["key"])
                    return
                left -= sent
            if got is not None:
                c["failedSteps"], c["stepCount"] = got
                continue
            if left <= 0 or not self.rest_room(1):
                continue
            left -= 1
            try:
                state, doc, _ = self.get(f"{root}/actions/jobs/{job_id}", None)
            except OutOfTime:
                self.deferred.add(e["key"])
                return
            if state != "fresh" or not isinstance(doc, dict):
                self.errors.append(f"{e['key']} steps: {doc}")
                if STEPS_GONE.match(str(doc)):
                    self.steps_failed[job_id] = self.now
                continue
            steps = doc.get("steps")
            c["failedSteps"], c["stepCount"] = failed_steps(steps), len(steps) if isinstance(steps, list) else None

    @staticmethod
    def run_cache_job(owner: str, repo: str, run_id: Any, job_id: Any) -> list | None:
        """[failedSteps, stepCount] of JOB_ID from the run watch's cached job list (no request), or None."""
        try:
            jobs = (read_cache(f"run:{owner}/{repo}/{int(run_id)}") or {}).get("jobs")
        except (TypeError, ValueError):
            return None
        for j in jobs if isinstance(jobs, list) else []:
            if isinstance(j, dict) and j.get("id") == job_id and settled_job(j):
                return [j["failedSteps"], j["stepCount"]]
        return None

    def run_list_job(self, root: str, run_id: Any, job_id: Any, budget: int = REST_STEPS_MAX) -> tuple[list | None, int]:
        """([failedSteps, stepCount] of JOB_ID or None, requests sent) from RUN_ID's job list, one page after another
        (REST_JOB_PAGES, and BUDGET requests, at most), each shared by every PR (repo_parts). A page the store holds is
        read again, conditional on its ETag, only when it does not show the job completed yet, and a page is asked at
        most once a tick, answered or not (a failed read is not repeated for each failed job of the run). Raises
        OutOfTime."""
        sent = 0
        for page in range(1, REST_JOB_PAGES + 1):
            path = f"{root}/actions/runs/{run_id}/jobs?filter=all&per_page=100&page={page}"
            shared = self.repo_parts.get(path)
            doc = (shared or {}).get("part", {}).get("doc") if shared else None
            found = next((j for j in (doc or {}).get("jobs") or [] if j.get("id") == job_id), None)
            if not settled_job(found) and self.job_lists_asked.get(path) != self.now:
                if sent >= budget or not self.rest_room(1):
                    return None, sent
                self.job_lists_asked = {p: t for p, t in self.job_lists_asked.items() if t == self.now}
                self.job_lists_asked[path] = self.now
                sent += 1
                try:  # TTL 0: always asked, with the newest ETag; a failure leaves the stored page as it was
                    doc = self.repo_part({}, {}, path, slim_run_jobs, None, 0)
                except WatchError as error:
                    self.errors.append(f"{root} run {run_id} jobs: {error}")
                    return None, sent
                found = next((j for j in doc.get("jobs") or [] if j.get("id") == job_id), None)
            if settled_job(found):
                return [found["failedSteps"], found["stepCount"]], sent
            if found is not None or int((doc or {}).get("total") or 0) <= 100 * page:
                return None, sent  # listed but not finished, or not in the run at all: read alone
        return None, sent

    def controller_down(self, error: Exception, site: str | None = None) -> None:
        """Leave the controller alone for a while; REST serves meanwhile. The cursor is kept, so the
        feed catches up on what happened in between when it answers again."""
        what = describe(error) + (f" at {site}" if site else "")
        if isinstance(error, NoReceiver):
            wait, state = CONTROLLER_ABSENT, "absent"  # not an error: that controller has no receiver
        else:
            self.controller_failures += 1
            wait, state = min(CONTROLLER_ABSENT, CONTROLLER_RETRY * 2 ** (self.controller_failures - 1)), "down"
            self.errors.append(what)
        self.controller_down_until = self.now + wait
        self.controller_status = {"state": state, "error": what, "retryAt": self.now + wait,
                                  "token": bool(getattr(self.controller, "token", None))}

    def read_feed(self) -> list[dict]:
        """The feed pages after the cursor. The first call only learns the cursor; a reset (the
        controller lost its state) starts over, so every watched run gets a fresh baseline."""
        if self.controller_cursor is None:
            doc = self.controller.events(None)
            self.controller_cursor, self.controller_seen = doc["cursor"], {}
            return [doc]
        pages = []
        for _ in range(FEED_PAGES):
            doc = self.controller.events(self.controller_cursor)
            if doc.get("reset"):
                self.controller_cursor, self.controller_seen = doc["cursor"], {}
                return [doc]
            pages.append(doc)
            self.controller_cursor = doc["cursor"]
            if not doc.get("more"):
                break
        return pages

    def follow_controller(self) -> None:
        """Switch to the controller the source names now. Its feed starts over: a cursor is only
        meaningful to the controller that issued it, and the old one, drained, serves stale reads."""
        if self.controller_source is None:
            return
        if (self.controller_source is Controller.from_env and not os.environ.get("CMUX_CI_CONTROLLER")
                and CONTROLLER_CONFIG.exists() and not isinstance(read_json(CONTROLLER_CONFIG), dict)):
            return  # a config caught mid-write reads as garbage: keep the controller rather than the default
        current = self.controller_source()
        if getattr(current, "base", None) == getattr(self.controller, "base", None):
            if current is not None and self.controller is not None:
                self.controller.token = current.token  # a rotated token applies without a restart
            return
        log({"event": "controller", "from": getattr(self.controller, "base", None),
             "to": getattr(current, "base", None)})
        self.controller = current
        self.controller_cursor, self.controller_seen = None, {}
        # coverage is the old controller's: the new one's feed has to show it again (fed())
        self.fed_repos, self.controller_ok_at = {}, float("-inf")
        self.controller_down_until, self.controller_failures = 0.0, 0
        self.controller_status = {"state": "off" if current is None else "starting"}

    def from_controller(self, entries: list[dict]) -> None:
        """Follow the controller's change feed: free, one request every CONTROLLER_FEED_EVERY seconds,
        plus one baseline read for each run newly watched. Job lists still come from REST."""
        self.controller_filled = set()
        self.follow_controller()
        if self.controller is None or self.now < self.controller_down_until:
            return
        deadline = time.monotonic() + TICK  # a slow controller must not stall the tick
        pages: list[dict] = []
        if self.now - self.controller_feed_at >= CONTROLLER_FEED_EVERY:
            self.controller_feed_at = self.now
            try:
                pages = self.read_feed()
            except WatchError as error:
                return self.controller_down(error)
            self.controller_failures = 0
            self.controller_ok_at = self.now
            for page in pages:
                for item in (page.get("runs") or []) + (page.get("suites") or []) + (page.get("comments") or []):
                    repo = str(item.get("repo") or "").lower()
                    if "/" in repo:
                        self.fed_repos[repo] = self.now
        runs = {e["key"]: e for e in entries if e["key"].startswith("run:") and not e["jobs"]}
        self.controller_seen = {k: v for k, v in self.controller_seen.items() if k in runs}
        for key, e in runs.items():
            if key in self.controller_seen:
                continue
            if time.monotonic() > deadline:
                break  # the rest get their baseline on the next tick; REST covers them meanwhile
            _, owner, repo, run_id = split_key(key)
            try:
                run = self.controller.run(run_id)
            except WatchError as error:
                return self.controller_down(error)
            known = run is not None and (run.get("repo") or "").lower() == f"{owner}/{repo}"
            self.controller_seen[key] = known
            if known:
                self.apply_run(e, run)
        for page in pages:
            for run in page.get("runs") or []:
                key = f"run:{str(run.get('repo') or '').lower()}/{run.get('id')}"
                if key in runs:
                    self.controller_seen[key] = True  # newer than any baseline
                    self.apply_run(runs[key], run)
            self.nudge(entries, page)
            self.merge_comments(entries, page)
        self.controller_filled = {k for k, known in self.controller_seen.items() if known}
        if pages:
            self.controller_status = {"state": "ok", "lastDelivery": pages[-1].get("receiver_last_delivery"),
                                      "token": bool(self.controller.token)}

    def apply_run(self, e: dict, run: dict) -> None:
        prior = e["cache"] or {}
        before = prior.get("data") or {}
        older = iso_epoch(run.get("updated_at")) or 0
        if prior.get("source") in {"rest", "graphql"} and (iso_epoch(before.get("updated_at")) or 0) > older:
            return  # a lost delivery: GitHub has shown a newer state than the controller
        data = controller_run(run)
        for k in ("display_title", "created_at"):  # the webhook record lacks these; keep REST's
            data[k] = before.get(k)
        same = prior.get("source") == "controller" and all(
            before.get(k) == data.get(k) for k in ("status", "conclusion", "run_attempt", "updated_at"))
        fields: dict[str, Any] = {"error": None, "data": data, "source": "controller"}
        if not same:
            fields["dataAt"] = self.now  # unchanged data keeps its time, so wait cannot rule on it anew
        if prior.get("source") != "controller":
            fields["restAt"] = self.now  # the safety-net clock starts when the controller takes over
        self.store(e["key"], e["cache"], **fields)
        e["cache"] = read_cache(e["key"])

    def nudge(self, entries: list[dict], page: dict) -> None:
        """Mark watched PRs whose head commit or branch had a run or check suite event."""
        touched: set[tuple[str, str]] = set()
        for item in (page.get("runs") or []) + (page.get("suites") or []):
            repo = str(item.get("repo") or "").lower()
            touched.add((repo, "sha:" + str(item.get("head_sha") or "").lower()))
            if item.get("head_branch"):
                touched.add((repo, "branch:" + str(item["head_branch"])))
        if not touched:
            return
        for e in entries:
            if e["key"].startswith("head:"):
                _, owner, repo, sha = split_key(e["key"])
                if (f"{owner}/{repo}".lower(), "sha:" + sha) in touched:
                    self.nudged.add(e["key"])  # a check event on this commit: its rollup changed
                continue
            data = (e["cache"] or {}).get("data") or {}
            if not e["key"].startswith("pr:") or not data:
                continue
            _, owner, repo, _ = split_key(e["key"])
            marks = {"sha:" + str(data.get("headRefOid") or "").lower()}
            if data.get("headRefName"):
                marks.add("branch:" + str(data["headRefName"]))  # a push: runs for a head GitHub has not shown yet
            if any((f"{owner}/{repo}", m) in touched for m in marks):
                self.nudged.add(e["key"])

    def merge_comments(self, entries: list[dict], page: dict) -> None:
        """Add new, edited and deleted comments on watched issues to their cached comment list. The
        next GraphQL read (every COMMENT_CYCLE) replaces the list with GitHub's latest 50."""
        watched = {e["key"]: e for e in entries if e["key"].startswith("comment:")}
        for c in page.get("comments") or []:
            try:
                key = f"comment:{str(c.get('repo') or '').lower()}#{int(c.get('number') or 0)}"
            except (TypeError, ValueError):
                continue
            e = watched.get(key)
            if e is None:
                continue
            prior = e["cache"] or {}
            data = dict(prior.get("data") or {"url": None, "state": None, "type": None, "total": None, "comments": []})
            by_id = {x.get("id"): x for x in data.get("comments") or []}
            if c.get("deleted"):
                by_id.pop(c.get("id"), None)
            else:
                edited = c.get("updated_at") if c.get("updated_at") not in {None, c.get("created_at")} else None
                by_id[c.get("id")] = {"id": c.get("id"), "url": c.get("url"), "createdAt": c.get("created_at"),
                                      "author": c.get("author"), "body": str(c.get("body") or "")[:COMMENT_BODY_MAX],
                                      "editedAt": edited or (by_id.get(c.get("id")) or {}).get("editedAt")}
            data["comments"] = sorted(by_id.values(), key=lambda x: x.get("id") or 0)[-2 * COMMENTS_LAST:]
            self.store(key, e["cache"], data=data, dataAt=self.now, error=None)
            e["cache"] = read_cache(key)

    def prune(self, live: set[str]) -> None:
        if not cache_dir().is_dir():
            return
        names = {file_name(k) for k in live}
        for path in cache_dir().glob("*.json"):
            if path.name in names:
                continue
            try:
                if self.now - path.stat().st_mtime > CACHE_KEEP:
                    path.unlink()
            except OSError:
                pass


def log(event: dict) -> None:
    print(json.dumps({"at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), **event}), flush=True)


def clear_failing() -> None:
    """Drop the previous process's "failing" record. A restart or a re-exec (which is how a fix
    arrives) must not leave clients exiting 3 on it until the first good tick, which can take minutes."""
    status = read_json(BASE / "daemon.json")
    if isinstance(status, dict) and "failing" in status:
        status.pop("failing")
        write_json(BASE / "daemon.json", status)


TEMP_FILE = re.compile(r"\.(?P<name>.+)\.(?P<pid>\d+)\.\d+\.tmp")  # write_json's temporary files


def sweep_temp_files(now: float | None = None) -> int:
    """Remove write_json's temporary files under BASE that an earlier write left when it was cut off (before
    write_json cleaned up after itself): only one whose writer pid is gone and that is an hour old. How many."""
    now = time.time() if now is None else now
    gone = 0
    for folder in (BASE, *(p for p in BASE.iterdir() if p.is_dir())) if BASE.is_dir() else ():
        for path in folder.glob(".*.tmp"):
            found = TEMP_FILE.fullmatch(path.name)
            if found is None or waiter_alive(int(found["pid"])):
                continue
            with contextlib.suppress(OSError):
                if now - path.stat().st_mtime >= 3600:
                    path.unlink()
                    gone += 1
    return gone


def first_heartbeat(now: float | None = None) -> None:
    """Write a heartbeat as soon as the lock is ours, before the first tick (which can take
    TICK_BUDGET and more). Until then daemon.json held the previous process's last heartbeat, so a
    restarted daemon still looked hung, and on 10-20 each session that read that restarted it again,
    killing the new daemon inside its first tick."""
    now = time.time() if now is None else now
    status = read_json(BASE / "daemon.json")
    status = status if isinstance(status, dict) else {}
    status.pop("failing", None)
    status.pop("staleWaited", None)  # the previous process's starvation is not this one's (daemon_starved)
    write_json(BASE / "daemon.json", {**status, "pid": os.getpid(), "at": now, "startedAt": now,
                                      "heartbeat": HEARTBEAT_EVERY})


class Watchdog:
    """Exits the process (EXIT_WATCHDOG) once the serve loop has not come round for `limit` seconds,
    so launchd (KeepAlive) or systemd (Restart=always) starts a fresh daemon. A thread, so it fires
    while the loop is stuck where no deadline reaches: a name lookup, a full disk, a bug. Before it
    exits it prints where every thread was (file, line, function; no values) to stderr."""

    def __init__(self, limit: float, clock: Callable[[], float] = time.monotonic,
                 exit: Callable[[int], Any] = os._exit, backstop: float | None = None) -> None:
        self.limit, self.clock, self.exit, self.backstop = limit, clock, exit, backstop
        self.last = clock()

    def beat(self) -> None:
        self.last = self.clock()
        if self.backstop is not None:  # re-arming cancels the previous timer
            faulthandler.dump_traceback_later(self.limit + self.backstop, exit=True)

    def check(self) -> bool:
        """True (after calling exit) when the loop is overdue."""
        lag = self.clock() - self.last
        if lag <= self.limit:
            return False
        log({"event": "watchdog", "silentFor": int(lag), "limit": int(self.limit), "pid": os.getpid()})
        with contextlib.suppress(Exception):  # stderr may not be a real file (tests)
            print(f"glaeda-gh: watchdog: the serve loop has not come round for {int(lag)}s (limit {int(self.limit)}s); "
                  f"exiting {EXIT_WATCHDOG} so the service manager restarts the daemon. Where each thread was:",
                  file=sys.stderr, flush=True)
            faulthandler.dump_traceback(file=sys.stderr, all_threads=True)
        self.exit(EXIT_WATCHDOG)
        return True

    def start(self) -> threading.Thread:
        def run() -> None:
            # hard_deadline's SIGALRM is meant for the main thread's blocking read. A process-directed
            # signal goes to any thread that does not block it, and taken here it interrupts nothing.
            if hasattr(signal, "pthread_sigmask"):
                signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGALRM})
            while not self.check():
                time.sleep(max(0.05, min(15.0, self.limit / 10)))

        thread = threading.Thread(target=run, name="glaeda-gh-watchdog", daemon=True)
        thread.start()
        self.beat()
        return thread


def try_lock(lock: Any) -> bool:
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def record_holder(lock: Any) -> None:
    """Name this process in daemon.lock, so a waiting daemon can tell whom to stop when it hangs."""
    lock.seek(0)
    lock.truncate()
    lock.write(json.dumps({"pid": os.getpid(), "since": time.time()}) + "\n")
    lock.flush()


def lock_holder(now: float | None = None) -> dict | None:
    """The recorded lock holder: {"pid", "silent"}, silent being the seconds since its last
    heartbeat (or since it took the lock, before its first). None without a record. A holder older
    than this record format writes none, so it is not known here."""
    now = time.time() if now is None else now
    try:
        record = json.loads((BASE / "daemon.lock").read_text() or "null")
    except (OSError, ValueError):
        return None
    pid = record.get("pid") if isinstance(record, dict) else None
    since = record.get("since") if isinstance(record, dict) else None
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0 or not isinstance(since, (int, float)):
        return None
    status = read_json(BASE / "daemon.json")
    at = status.get("at") if isinstance(status, dict) and status.get("pid") == pid else None
    last = max(since, at) if isinstance(at, (int, float)) else since
    return {"pid": pid, "silent": now - last}


def is_serve(pid: int) -> bool:
    """Whether `pid` is a live glaeda-gh serve other than this process (not a reused pid)."""
    if pid == os.getpid():
        return False
    try:
        os.kill(pid, 0)
    except OSError:  # gone, or another user's
        return False
    try:
        result = run_bounded(["ps", "-ww", "-o", "command=", "-p", str(pid)], 10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    words = result.stdout.split()
    return result.returncode == 0 and "serve" in words and any(Path(w).name == "glaeda-gh" for w in words)


def take_over(lock: Any, now: float | None = None) -> bool:
    """Stop a hung lock holder and take the lock. Only a recorded holder that is a live glaeda-gh
    serve and has been silent for more than STALE_HEARTBEAT is stopped: SIGTERM, then SIGKILL after
    TAKEOVER_GRACE. True once this process holds the lock."""
    holder = lock_holder(now)
    if holder is None or holder["silent"] <= STALE_HEARTBEAT or not is_serve(holder["pid"]):
        return False
    pid = holder["pid"]
    log({"event": "takeover", "pid": pid, "silentFor": int(holder["silent"]), "by": os.getpid()})
    for sig, grace in ((signal.SIGTERM, TAKEOVER_GRACE), (signal.SIGKILL, 5)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            pass
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            if try_lock(lock):
                return True
            time.sleep(0.2)
    return try_lock(lock)


def acquire_lock(lock: Any, sleep: Callable[[float], Any] = time.sleep) -> None:
    """Wait for the daemon lock (a second daemon waits instead of polling twice), taking it over
    from a holder whose heartbeat went stale."""
    waiting = False
    while not try_lock(lock):
        if not waiting:
            holder = lock_holder()
            log({"event": "waiting", "pid": os.getpid(), "holder": holder and holder["pid"]})
            waiting = True
        if take_over(lock):
            break
        sleep(LOCK_RETRY)
    record_holder(lock)


def hold_daemon_lock() -> Any:
    """Take the daemon lock on the file at BASE/daemon.lock. A daemon that waited on a file which was
    moved or replaced meanwhile (a daemon before it re-executed off it) lets that one go and waits on
    the current file instead, so two daemons never poll, each locking a different inode."""
    while True:
        BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
        lock = open(BASE / "daemon.lock", "a+")
        acquire_lock(lock)
        if not lock_replaced(lock):
            return lock
        log({"event": "relock", "pid": os.getpid()})
        lock.close()


def serve(foreground_ok: bool = False) -> int:
    lock = hold_daemon_lock()
    first_heartbeat()
    with contextlib.suppress(OSError):
        swept = sweep_temp_files()
        if swept:
            log({"event": "swept", "tempFiles": swept})
    me = Path(__file__).resolve()
    stamp = me.stat().st_mtime
    daemon = Daemon()
    log({"event": "start", "pid": os.getpid()})
    watchdog = Watchdog(WATCHDOG_AFTER, backstop=WATCHDOG_BACKSTOP)
    watchdog.start()
    last = None
    while True:
        try:
            status = daemon.tick()
            summary = (status["modes"], status["paths"], status["errors"])
            if summary != last and (status["errors"] or last is not None):
                log({"event": "state", "modes": status["modes"], "paths": status["paths"], "errors": status["errors"]})
            last = summary
        except Exception as error:  # noqa: BLE001  keep serving; only the type name is logged
            site = error_site(error)  # plus where it was raised
            log({"event": "error", "error": describe(error), "site": site})
            try:
                daemon.tick_failed(describe(error), site)
            except Exception as report:  # noqa: BLE001  e.g. a full disk: keep serving
                log({"event": "error", "error": describe(report), "site": "tick_failed"})
        time.sleep(TICK)
        watchdog.beat()
        try:
            if me.stat().st_mtime != stamp:
                log({"event": "reexec"})
                os.execv(sys.executable, [sys.executable, os.fspath(me), "serve"] + (["--foreground-ok"] if foreground_ok else []))
            if lock_replaced(lock):
                # A cleanup moved or deleted BASE (huge-blue, 10-24: a hygiene pass trashed ~/.cache/glaeda):
                # this daemon still polls, but its lock is on a file nobody can see, so every client reads
                # "not running" and restart's start is a no-op on the active unit. Start over on the new path.
                log({"event": "reexec", "why": "daemon.lock was removed or replaced"})
                os.execv(sys.executable, [sys.executable, os.fspath(me), "serve"] + (["--foreground-ok"] if foreground_ok else []))
        except OSError:
            pass


def lock_replaced(lock: Any) -> bool:
    """Whether BASE/daemon.lock is no longer the file this daemon holds its lock on: removed, or another
    file now at that path. An unreadable path is not proof, so that answers False."""
    try:
        here = os.stat(BASE / "daemon.lock")
    except FileNotFoundError:
        return True
    except OSError:
        return False
    mine = os.fstat(lock.fileno())
    return (here.st_dev, here.st_ino) != (mine.st_dev, mine.st_ino)


SYSTEMD_UNIT = "glaeda-gh.service"


def under_service() -> bool:
    """Whether this process is the service manager's glaeda-gh (launchd names its job in
    XPC_SERVICE_NAME; systemd puts its unit in the process's cgroup)."""
    if os.environ.get("XPC_SERVICE_NAME") == LAUNCH_LABEL:
        return True
    try:
        return SYSTEMD_UNIT in Path("/proc/self/cgroup").read_text()
    except OSError:
        return False


def service_loaded() -> bool:
    """Whether this user's glaeda-gh service is loaded (launchd) or enabled or running (systemd), or about to be
    (a restart in progress). Between a restart's bootout and its bootstrap nothing is loaded, and a shell serve
    started then would take daemon.lock from the service, so the probes run holding restart.lock (cmd_restart):
    a restart that holds it counts as loaded, and none can begin while they run."""
    try:
        BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
        guard = open(BASE / "restart.lock", "a+")
    except OSError:
        return True  # cannot tell whether a restart is in progress
    with guard:
        return not try_lock(guard) or service_probed()


def service_probed() -> bool:
    """service_loaded's probes, without restart.lock."""
    if sys.platform == "darwin":
        # the LaunchAgent, the copy restart loads while nobody is logged in (launchd_domain), or the
        # same label as a system LaunchDaemon on a headless Mac. Only a definite "not there" (113, or 125 for a
        # gui domain nobody is logged in to) counts as not loaded: a probe that cannot tell refuses the shell serve
        for target, absent in ((f"gui/{os.getuid()}/{LAUNCH_LABEL}", (NOT_LOADED, NO_GUI_DOMAIN)),
                               (f"user/{os.getuid()}/{LAUNCH_LABEL}", (NOT_LOADED,)),
                               (f"system/{LAUNCH_LABEL}", (NOT_LOADED,))):
            try:
                if run_bounded(["launchctl", "print", target], 10).returncode not in absent:
                    return True
            except (OSError, subprocess.TimeoutExpired):
                return True
        return False
    else:
        probes = [["systemctl", "--user", "--quiet", "is-enabled", SYSTEMD_UNIT],
                  ["systemctl", "--user", "--quiet", "is-active", SYSTEMD_UNIT]]
    for probe in probes:
        try:
            if run_bounded(probe, 10).returncode == 0:
                return True
        except (OSError, subprocess.TimeoutExpired):
            continue
    return False


def serve_refusal() -> str:
    where = (f"the LaunchAgent {LAUNCH_LABEL} is loaded" if sys.platform == "darwin"
             else f"the systemd user unit {SYSTEMD_UNIT} is enabled")
    return (f"serve: refusing to start: {where}, and it runs the daemon. A serve started from a shell only "
            "waits for its lock, or takes it and stops every session's waits when it hangs or its shell goes "
            "away (10-20). Do not run serve yourself. If the daemon is down or hung: "
            f"{RESTART_ADVICE}. To run one in the foreground anyway (debugging): "
            "glaeda-gh serve --foreground-ok")


# ---------------------------------------------------------------- clients


def daemon_running(grace: float = 0.0) -> bool:
    """True while some process holds the daemon lock. With grace, keep looking that long: the lock is
    released for a moment while the daemon re-executes itself after an update."""
    deadline = time.monotonic() + grace
    while True:
        if lock_held():
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def lock_held() -> bool:
    try:
        with open(BASE / "daemon.lock", "r") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(lock, fcntl.LOCK_UN)
            return False
    except OSError:
        return False


LAUNCH_LABEL = "com.teamleaderleo.glaeda.gh-watch"


# launchctl's "5: Input/output error" (cosmic-gray, macOS 27, 10-20): bootstrap answers it whenever the
# service is already loaded (reproduced), so it says nothing about the service's health. kickstart
# answered it while launchd reported "spawn failed" for the job; unloading and loading it starts over.
LAUNCHCTL_ERROR_5 = (f"If launchctl answers \"5: Input/output error\": from bootstrap it means the service is "
                     f"already loaded (kickstart it instead); from kickstart, reload it: launchctl bootout "
                     f"gui/$(id -u)/{LAUNCH_LABEL}; launchctl bootstrap gui/$(id -u) "
                     f"~/Library/LaunchAgents/{LAUNCH_LABEL}.plist. Never run glaeda-gh serve yourself")


def start_hint(restart: bool = False, domain: str | None = None) -> str:
    """How to (re)start the daemon here, including when its service was never loaded."""
    if sys.platform == "darwin":
        domain = domain or launchd_domain()
        if domain is None:
            return DOMAIN_UNKNOWN_HINT[0].upper() + DOMAIN_UNKNOWN_HINT[1:]
        if domain.startswith("user/"):
            try:
                system = system_daemon_loaded()
            except (OSError, subprocess.TimeoutExpired):
                system = None
            if system is None:
                return (f"nobody is logged in here and {SYSTEM_UNKNOWN_HINT}, which loads a Background copy in "
                        f"user/$(id -u). Never run glaeda-gh serve yourself")
            if system:
                return SYSTEM_DAEMON_HINT[0].upper() + SYSTEM_DAEMON_HINT[1:] + ". Never run glaeda-gh serve yourself"
            return (f"nobody is logged in here, so gui/$(id -u) does not exist and the daemon runs from a Background "
                    f"copy of its LaunchAgent in user/$(id -u): launchctl bootout user/$(id -u)/{LAUNCH_LABEL}; "
                    f"launchctl bootstrap user/$(id -u) {background_copy_path()} (glaeda-gh restart writes that copy). "
                    f"Logging the user in, or a reboot with automatic login, brings the LaunchAgent back. "
                    f"Never run glaeda-gh serve yourself. Its log is ~/Library/Logs/glaeda-gh.err")
        try:
            system = system_daemon_loaded() is not False  # loaded, or launchctl cannot tell
            copy = not unloaded(f"user/{os.getuid()}/{LAUNCH_LABEL}")
        except (OSError, subprocess.TimeoutExpired):
            system = copy = True
        if system or copy:
            return (f"check first that neither the system LaunchDaemon (sudo launchctl print system/{LAUNCH_LABEL}) "
                    f"nor the Background copy of a logged-out restart (launchctl print "
                    f"user/$(id -u)/{LAUNCH_LABEL}) is loaded: either runs the daemon, and the LaunchAgent must "
                    f"not start beside it. Restart a loaded system daemon as root (sudo launchctl kickstart -k "
                    f"system/{LAUNCH_LABEL}); boot a loaded copy out (launchctl bootout user/$(id -u)/{LAUNCH_LABEL}) "
                    f"and run glaeda-gh restart again. Never run glaeda-gh serve yourself")
        if restart:
            return f"launchctl kickstart -k gui/$(id -u)/{LAUNCH_LABEL}. {LAUNCHCTL_ERROR_5}"
        return (f"launchctl kickstart gui/$(id -u)/{LAUNCH_LABEL} (if launchctl cannot find the service, load it: "
                f"launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/{LAUNCH_LABEL}.plist). "
                f"{LAUNCHCTL_ERROR_5}. Its log is ~/Library/Logs/glaeda-gh.err")
    if restart:
        return "systemctl --user restart glaeda-gh"
    return "systemctl --user start glaeda-gh (systemctl --user status glaeda-gh says why it stopped)"


# Every client message names this one command, never launchctl or systemctl: on 10-20 about ten
# sessions each ran `launchctl kickstart -k` on the same advice, every kickstart killed the daemon the
# last one had just started, and launchd throttled the respawns ("spawn scheduled", "spawn failed").
# `restart` is single-flight: one session restarts the daemon, the others are told to wait.
RESTART_ADVICE = ("glaeda-gh restart (safe to run from many sessions at once: one of them restarts it and the "
                  "others are told to wait; do not run launchctl or systemctl yourself)")

DOWN = ("glaeda-gh: the daemon is not running, so nothing is polling GitHub; do not poll GitHub yourself "
        "instead. Start it: " + RESTART_ADVICE + ". If it was never installed: glaeda-mini-setup --hygiene-only --apply."
        "\nnext: glaeda-gh restart")


class DownWait:
    """A wait that finds the daemon down: say so once, keep waiting DOWN_PATIENCE (or to the wait's
    own timeout), then print down_message and give up."""

    def __init__(self) -> None:
        self.said = False

    def patient(self, down_since: float, start: float, timeout: float) -> bool:
        now = time.monotonic()
        if now - down_since >= DOWN_PATIENCE or now - start >= timeout:
            say_waiting(down_message())
            return False
        if not self.said:
            say_waiting(f"glaeda-gh: the daemon is not running; waiting up to {DOWN_PATIENCE}s for it to "
                        "come back (a restart can take that long). Do not restart it from here.")
            self.said = True
        return True


def restart_record() -> dict | None:
    record = read_json(BASE / "restart.json")
    return record if isinstance(record, dict) and isinstance(record.get("at"), (int, float)) else None


def recent_restart(now: float | None = None, holding: bool = False) -> float | None:
    """Seconds since the last `glaeda-gh restart`, while that is under RESTART_COOLDOWN. A restart whose
    command failed does not count: sessions must not be told to wait on a restart that did not happen.
    One that ran but saw no heartbeat within RESTART_SETTLE does: the daemon it started may just be
    slow, and another session restarting it again would kill that one (the 10-19 kickstart storm).
    `holding`: the caller holds restart.lock, so no other restart is in progress, whatever pid wrote a
    "starting" record."""
    record = restart_record()
    if record is None or (record.get("ok") is False and not record.get("ran")):
        return None
    if record.get("how") == "starting" and (holding or not alive(record.get("by"))):
        return None  # a restart that died before it finished: nothing is starting a daemon
    ago = (time.time() if now is None else now) - record["at"]
    return ago if 0 <= ago < RESTART_COOLDOWN else None


def alive(pid: Any) -> bool:
    """Whether `pid` (the restart that wrote a "starting" record) still runs. Never touches restart.lock,
    so it cannot make a real restart's lock attempt fail."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:  # another user's: it exists
        return True
    return True


def down_message() -> str:
    ago = recent_restart()
    if ago is None:
        return DOWN
    return (f"glaeda-gh: the daemon is not running yet; a session restarted it {int(ago)}s ago and launchd can "
            "hold a respawn back for 30s. Do not restart it again and do not poll GitHub yourself: re-run your "
            f"command in a minute. If it is still down {RESTART_COOLDOWN}s after that restart: {RESTART_ADVICE}."
            "\nnext: none (a restart is under way; re-run this command in a minute)")


def daemon_stale() -> float | None:
    """Seconds since the daemon's last heartbeat, when that is so long ago that it looks hung."""
    holder = lock_holder() if lock_held() else None
    if holder is not None:
        # The holder's own record: its silence counts from its last heartbeat, or from when it took
        # the lock when daemon.json is its predecessor's (before its first heartbeat), missing or
        # unreadable. One read of daemon.json, so a heartbeat written meanwhile is never missed.
        lag = holder["silent"]
    else:
        status = read_json(BASE / "daemon.json")
        # an older daemon (no holder record) wrote daemon.json only when it fetched something: its
        # silence means nothing
        at = status.get("at") if isinstance(status, dict) and status.get("heartbeat") else None
        if not isinstance(at, (int, float)):
            return None
        lag = time.time() - at
    return lag if lag > STALE_HEARTBEAT else None


def unit_active_for() -> tuple[float, int] | None:
    """Linux: (seconds since glaeda-gh.service last became active, its main pid). None when it is not
    active, on macOS, or when systemctl cannot say."""
    if sys.platform == "darwin":
        return None
    try:
        result = run_bounded(["systemctl", "--user", "show", SYSTEMD_UNIT, "-p", "ActiveState",
                              "-p", "ActiveEnterTimestampMonotonic", "-p", "MainPID"], SUBPROCESS_DEADLINE)
    except (OSError, subprocess.TimeoutExpired):
        return None
    props = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if result.returncode != 0 or props.get("ActiveState") != "active":
        return None
    try:
        entered = int(props.get("ActiveEnterTimestampMonotonic", "")) / 1e6
        main = int(props.get("MainPID", ""))
    except ValueError:
        return None
    # systemd's monotonic timestamps and time.monotonic() are both CLOCK_MONOTONIC on Linux
    return (time.monotonic() - entered, main) if entered > 0 else None


def silent_unit() -> float | None:
    """Linux: seconds the active unit has written no heartbeat, when no daemon lock is visible and that
    is over STALE_HEARTBEAT (and the unit has been active that long). That daemon is hung where clients
    cannot see its lock (huge-blue, 10-23: a cleanup deleted ~/.cache/glaeda under it), and `systemctl
    --user start` is a no-op on an active unit, so only a restart recovers it. A daemon on this version
    whose lock was only moved re-execs onto the visible one within a tick, writing heartbeats meanwhile,
    so it never looks silent here. Only a heartbeat the unit's own main pid wrote counts: one left by an
    earlier daemon, or an older daemon's fetch record (no heartbeat), says nothing about this one."""
    unit = unit_active_for()
    if unit is None or unit[0] <= STALE_HEARTBEAT:
        return None
    active, main = unit
    status = read_json(BASE / "daemon.json")
    mine = isinstance(status, dict) and status.get("heartbeat") and status.get("pid") == main
    at = status.get("at") if mine else None
    silent = min(time.time() - at, active) if isinstance(at, (int, float)) else active
    return silent if silent > STALE_HEARTBEAT else None


def daemon_starved(status: Any = None) -> dict | None:
    """When the daemon's heartbeat may be fresh but the data a wait is blocked on is not: {"kind", "age", "quota"}
    for the kind with the oldest waited data past STALE_DATA_AFTER (daemon.json staleWaited), else None. "quota" is
    true when GitHub's own limits explain it (GraphQL stopped and REST stopped or at the daemon's share), which a
    restart cannot fix."""
    status = read_json(BASE / "daemon.json") if status is None else status
    if not isinstance(status, dict):
        return None
    stale = status.get("staleWaited")
    if not isinstance(stale, dict):
        return None
    bound = status.get("staleAfter") if isinstance(status.get("staleAfter"), (int, float)) else STALE_DATA_AFTER
    at = status.get("at") if isinstance(status.get("at"), (int, float)) else time.time()
    ages = {k: v + max(0.0, time.time() - at) for k, v in stale.items()
            if isinstance(v, (int, float)) and not isinstance(v, bool)}
    kind = max(ages, key=ages.get, default=None)
    if kind is None or ages[kind] <= bound:
        return None
    modes = status.get("modes") if isinstance(status.get("modes"), dict) else {}
    share = status.get("restShare") if isinstance(status.get("restShare"), dict) else {}
    quota = modes.get("graphql") == "stop" and (modes.get("rest") == "stop" or bool(share.get("capped")))
    upstream = (status.get("upstream") if isinstance(status.get("upstream"), dict) else {}).get("state") == "ok"
    held = (status.get("staleWhy") if isinstance(status.get("staleWhy"), dict) else {}).get(kind)
    held = held if isinstance(held, dict) and isinstance(held.get("why"), str) else None
    why = ("this host reads GitHub through an upstream, whose daemon reads it" if upstream
           else held["why"] if held else "GitHub's quota is spent (GraphQL stopped, REST at its share)" if quota
           else None)
    return {"kind": kind, "age": ages[kind], "quota": quota or upstream or bool(held and held.get("quota") is True),
            "why": why}


def daemon_failing() -> dict | None:
    """The daemon's "failing" record, once every tick has raised for FAILING_AFTER seconds."""
    status = read_json(BASE / "daemon.json")
    broken = status.get("failing") if isinstance(status, dict) else None
    if not isinstance(broken, dict):
        return None
    at, since = status.get("at"), broken.get("since")
    if not isinstance(at, (int, float)) or not isinstance(since, (int, float)) or at - since < FAILING_AFTER:
        return None
    return broken


def failing_message(broken: dict) -> str:
    since = broken.get("since")
    when = dt.datetime.fromtimestamp(since, dt.timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ") \
        if isinstance(since, (int, float)) else "?"
    where = f" at {broken['site']}" if broken.get("site") else ""
    return (f"glaeda-gh: the daemon is running, but every cycle since {when} has failed with "
            f"{broken.get('error') or '?'}{where} ({broken.get('count', '?')} times), so nothing is being "
            "refreshed. Restarting it will not fix this: the installed glaeda-gh needs a fix (scripts/glaeda-gh "
            "in teamleaderleo/glaeda). Tell the user; do not poll GitHub yourself in a loop meanwhile."
            "\nnext: none (the installed glaeda-gh needs a fix; tell the user)")


def stale_message(lag: float) -> str:
    holder = lock_holder()
    who = ""
    if holder is not None and is_serve(holder["pid"]):
        # a holder outside the service is what a restart cannot reach: launchd restarts its own job,
        # which then waits behind the hung one (10-20)
        who = (f" The lock holder is pid {holder['pid']}; the service's waiting daemon stops it once it has been "
               f"silent for {STALE_HEARTBEAT}s, or stop it now: kill {holder['pid']}.")
    return (f"glaeda-gh: the daemon holds its lock but has not written a heartbeat for {int(lag)}s, so it "
            f"looks hung and nothing is being refreshed.{who} Restart it: {RESTART_ADVICE}"
            "\nnext: glaeda-gh restart")


def failing(checks: list[dict]) -> list[dict]:
    return [c for c in checks if (c.get("conclusion") or "").upper() in FAILED]


def cancelled_unstarted(c: dict) -> bool:
    """A PR check cancelled before any step ran: the rescue cancels a job still queued for a runner and
    re-runs it. Unknown steps (never read) count as started, so a real cancellation still fails."""
    return (c.get("conclusion") or "").upper() == "CANCELLED" and c.get("stepCount") == 0


def refused_check(c: dict) -> bool:
    """A PR check whose runner refused the job: its job-started hook step failed at job start."""
    return ((c.get("conclusion") or "").upper() == "FAILURE" and HOOK_STEP in (c.get("failedSteps") or [])
            and quick(c.get("startedAt"), c.get("completedAt")))


def refused_job(job: dict) -> bool:
    """A run's job that a glaeda runner refused (see refused_check); the runner is named, so check it."""
    glaeda = (GLAEDA_RUNNER.search(str(job.get("runner_name") or ""))
              or any(str(label).startswith("glaeda-") for label in job.get("labels") or []))
    return (job.get("conclusion") == "failure" and bool(glaeda) and HOOK_STEP in (job.get("failedSteps") or [])
            and quick(job.get("started_at"), job.get("completed_at")))


def classify(data: dict, now: float | None = None, grace: float = RESCUE_GRACE) -> dict[str, list[dict]]:
    """Split a PR's checks into passed, failed, pending and held. A failed check is held while a job
    of its workflow run was refused at runner setup less than `grace` seconds ago: the rescue re-runs
    that run's failed jobs, dependents such as an aggregate status check included. A check cancelled
    before any step ran is held as long: the rescue cancelled it in the queue and re-runs it."""
    now = time.time() if now is None else now
    checks = data.get("checks") or []
    def recent(c: dict) -> bool:
        return now - (iso_epoch(c.get("completedAt")) or 0) < grace
    held_runs = {c.get("runId") for c in checks if c.get("runId") and refused_check(c) and recent(c)}
    # the rescue cancels the whole run: its jobs that were running come back cancelled with steps
    queued_runs = {c.get("runId") for c in checks if c.get("runId") and cancelled_unstarted(c) and recent(c)}
    out: dict[str, list[dict]] = {"passed": [], "failed": [], "pending": [], "held": []}
    for c in checks:
        cancelled = (c.get("conclusion") or "").upper() == "CANCELLED"
        if c.get("status") != "COMPLETED":
            out["pending"].append(c)
        elif (c.get("conclusion") or "").upper() in FAILED:
            held = (c.get("runId") in held_runs or (cancelled_unstarted(c) and recent(c))
                    or (cancelled and c.get("runId") in queued_runs))
            out["held" if held else "failed"].append(c)
        else:
            out["passed"].append(c)
    return out


def expected_contexts(repo: str) -> tuple[str, ...]:
    """The checks or statuses every head of REPO gets (EXPECTED_CONTEXTS, and EXPECTED_CONFIG's entry, which wins)."""
    doc = read_json(EXPECTED_CONFIG)
    if isinstance(doc, dict) and isinstance(doc.get(repo), list):
        return tuple(str(c) for c in doc[repo] if c)
    return EXPECTED_CONTEXTS.get(repo, ())


def pr_repo(data: dict) -> str:
    match = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/", str(data.get("url") or ""))
    return match.group(1) if match else ""


def expected_missing(data: dict) -> list[str]:
    reported = {c.get("name") for c in data.get("checks") or []}
    return [name for name in expected_contexts(pr_repo(data)) if name not in reported]


def pushed_by(data: dict) -> float | None:
    """The latest the head can have been pushed: the PR's updatedAt (a push updates it) and the daemon's first
    sighting of the head, whichever is earlier; None when neither is known."""
    known = [t for t in (iso_epoch(data.get("updatedAt")), data.get("headSeenAt")) if isinstance(t, (int, float))]
    return min(known) if known else None


def settling(data: dict, now: float, settle: float = SETTLE_GRACE) -> float | None:
    """Seconds left of the head's settle window (SETTLE_GRACE), or None once it is over or cannot be placed."""
    pushed = pushed_by(data)
    if pushed is None:
        return None
    left = pushed + settle - now
    return left if left > 0 else None


def check_counts(contexts: dict) -> dict | None:
    """The rollup's check runs and statuses counted by state over every page (checkRunCountsByState,
    statusContextCountsByState), or None when the read did not ask for them."""
    runs, statuses = contexts.get("checkRunCountsByState"), contexts.get("statusContextCountsByState")
    if not isinstance(runs, list) or not isinstance(statuses, list):
        return None
    tally = lambda rows: {str(r.get("state")): int(r.get("count") or 0) for r in rows  # noqa: E731
                          if isinstance(r, dict) and isinstance(r.get("count"), int)}
    return {"runs": tally(runs), "statuses": tally(statuses)}


COUNT_PENDING = {"QUEUED", "IN_PROGRESS", "PENDING", "WAITING", "REQUESTED", "EXPECTED"}
COUNT_BAD = {"FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "STALE", "ERROR"}


def rollup_red_is_superseded(data: dict) -> bool:
    """Whether a truncated rollup's FAILURE is only superseded attempts: over every page nothing is pending, and no
    more contexts are red than the superseded red attempts shown. manaflow-ai/cmux#41298, 2026-11-11: 191 contexts,
    85 counted checks all passing, and `wait --until done` failed on the rollup's FAILURE from a superseded,
    cancelled "risk evidence" attempt a newer run had replaced. Unknown counts: False (the rollup decides)."""
    counts = data.get("checkCounts")
    if not isinstance(counts, dict):
        return False
    rows = [*(counts.get("runs") or {}).items(), *(counts.get("statuses") or {}).items()]
    if any(state in COUNT_PENDING and n for state, n in rows):
        return False
    red = sum(n for state, n in rows if state in COUNT_BAD)
    # only attempts the rollup itself listed: one add_last_real_contexts read by suite id is in no count (review of
    # #1958: an uncounted superseded red cancelled a real red past page 1)
    superseded = sum(1 for c in data.get("superseded") or []
                     if str(c.get("conclusion") or "").upper() in COUNT_BAD and not c.get("lastRealAttempt"))
    return red <= superseded


def check_verdict(data: dict, until: str = "green", now: float | None = None,
                  grace: float = RESCUE_GRACE, settle: float = SETTLE_GRACE) -> int | None:
    """The checks alone, whatever the PR's state or head: EXIT_OK, EXIT_FAIL, EXIT_NOTHING (nothing reported on the
    head past its settle window), or None while pending."""
    now = time.time() if now is None else now
    checks = data.get("checks") or []
    if data.get("checksPageError"):
        return None  # a partial cached rollup is not evidence of a green head
    marked_required = any(c.get("required") for c in checks)
    shown = classify(data, now, grace)
    if any(c.get("lastRealAttempt") and (until != "required" or c.get("required") or not marked_required)
           for c in shown["failed"]):
        # A red whose suite's newest attempt ran nothing (startup_failure): GitHub's rollup state omits it, it stands;
        # --until done still waits for every shown check to finish first.
        if until == "done" and (shown["pending"] or shown["held"]):
            return None
        return EXIT_FAIL
    if data.get("checksTruncated"):
        # More than 100 checks: only the first 100 are here, so GitHub's rollup decides, except that a
        # check shown as held or still running defers its FAILURE (manaflow-ai/cmux#20733: a queued fast
        # tier the rescue cancelled read as a failure while 13 checks still ran).
        state = data.get("checkState")
        if state == "SUCCESS":
            return EXIT_OK
        if state not in {"FAILURE", "ERROR"}:
            return None
        groups = classify(data, now, grace)
        if until == "done" and (groups["pending"] or groups["held"]):
            return None  # every shown check finishes first, as under 100 checks
        if groups["failed"] and until != "required":
            return EXIT_FAIL
        # GitHub's rollup still counts a superseded attempt that failed or was cancelled, so its FAILURE
        # can be that attempt rather than a check past the first 100: with no shown failure, the shown
        # checks finish first, and then the rollup decides (manaflow-ai/cmux#24539: 0 failed and 7
        # running, yet the wait exited 1 after 5s). A failure past the first 100 fails that much later.
        if not groups["failed"] and groups["pending"] and data.get("superseded"):
            return None
        if not groups["failed"] and not groups["pending"] and not groups["held"] and rollup_red_is_superseded(data):
            return EXIT_OK  # every red context on every page is a superseded attempt
        return None if groups["held"] else EXIT_FAIL
    if not checks:
        # nothing has reported yet: not started while the head settles (or its push time is unknown), then said so
        return None if settling(data, now, settle) is not None or pushed_by(data) is None else EXIT_NOTHING
    marked = any(c.get("required") for c in checks)

    def decides(c: dict) -> bool:
        # Every check decides; only an explicit --until required ignores the ones GitHub does not require
        # (manaflow-ai/subrouter#612 merged red on "success" over two failed optional checks).
        return until != "required" or bool(c.get("required")) or not marked

    # GitHub's own merge state already counts a required check that never reported. A conflicted PR
    # (DIRTY) runs no pull_request workflows until the next push, and a merged one never will.
    waiting = (data.get("requiredMissing") and data.get("state") == "OPEN"
               and data.get("mergeStateStatus") not in {"CLEAN", "UNSTABLE", "HAS_HOOKS", "DIRTY"})
    groups = classify(data, now, grace)
    bad = [c for c in groups["failed"] if decides(c)]
    unfinished = [c for c in groups["pending"] + groups["held"] if decides(c)]
    if until in {"green", "required"} and bad:
        return EXIT_FAIL
    if unfinished or waiting:
        return None
    if data.get("requiredMissing") and data.get("state") == "OPEN" and data.get("mergeStateStatus") == "DIRTY":
        return EXIT_FAIL  # merge conflicts: the required checks will not run until the next push
    if bad:
        return EXIT_FAIL
    if data.get("state") == "OPEN" and expected_missing(data):
        return None  # a status every head of this repo gets has not been posted yet: unfinished, like a required one
    return EXIT_OK


def run_hold(data: dict, jobs: list[dict] | None, now: float | None = None,
             grace: float = RESCUE_GRACE) -> list[dict]:
    """The jobs a glaeda runner refused, while a rescue attempt of this failed run may still come.
    Empty once any job failed for another reason, when the job list is not this attempt's, or
    `grace` seconds after the run finished."""
    now = time.time() if now is None else now
    if (grace <= 0 or data.get("status") != "completed" or data.get("conclusion") not in {"failure", "cancelled"}
            or not jobs or jobs_attempt(jobs) < (data.get("run_attempt") or 1)):
        return []
    bad = [j for j in jobs if j.get("status") == "completed" and j.get("conclusion") not in RUN_OK]
    refused = [j for j in bad if refused_job(j)]
    # the rescue cancels what is still running before it re-runs, so cancelled jobs are expected
    if not refused or any(not refused_job(j) and j.get("conclusion") != "cancelled" for j in bad):
        return []
    finished = iso_epoch(data.get("updated_at")) or max(iso_epoch(j.get("completed_at")) or 0 for j in refused)
    return refused if now - finished < grace else []


def verdict(kind: str, data: dict | None, until: str = "green", sha: str | None = None,
            jobs: list[dict] | None = None, now: float | None = None, grace: float = RESCUE_GRACE,
            repo: str = "", settle: float = SETTLE_GRACE) -> int | None:
    """EXIT_OK, EXIT_FAIL, EXIT_CONFLICT (a PR that conflicts with its base), or None while still pending.
    A run is `sha`'s when its head is, or when it is a dispatch naming `sha` of `repo` (run_tests_commit)."""
    if not data:
        return None
    if kind == "run":
        if sha and not str(data.get("head_sha") or "").startswith(sha) and not run_tests_commit(data, repo, sha):
            return None
        if data.get("status") != "completed":
            return None
        if data.get("conclusion") in RUN_OK:
            return EXIT_OK
        return None if run_hold(data, jobs, now, grace) else EXIT_FAIL
    if data.get("state") == "CLOSED":
        return EXIT_FAIL
    if until == "merged":
        return EXIT_OK if data.get("state") == "MERGED" else None
    if until == "done" and data.get("state") == "MERGED":
        # Nothing more runs for it: a merged PR is done whatever its head still shows (leo-workspace#4370, 2026-11-11:
        # `--until done` saw MERGED at 600 s, then waited 15 min more on "checks: none reported yet"). A finished red
        # still fails; a pending, missing or other-head check no longer holds the wait.
        # (judged as green would: under "done" a red waits for the running checks, and that None would read as OK)
        decided = check_verdict(data, "green", now, grace, settle)
        return EXIT_FAIL if decided == EXIT_FAIL else EXIT_OK
    if sha and not str(data.get("headRefOid") or "").startswith(sha):
        return None  # the push has not reached GitHub yet, or these are an older commit's checks
    if conflicting(data):
        return EXIT_CONFLICT  # no pull_request workflow runs until the next push
    return check_verdict(data, until, now, grace, settle)


def conflicting(data: dict) -> bool:
    """An open PR GitHub says conflicts with its base. UNKNOWN is still being computed: not a conflict."""
    # mergeStateStatus can lag mergeable (or read DRAFT), so mergeable alone decides.
    return data.get("state") == "OPEN" and data.get("mergeable") == "CONFLICTING"


def age(seconds: float | None) -> str:
    if seconds is None:
        return "never"
    s = int(max(0, time.time() - seconds))
    return f"{s}s ago" if s < 120 else f"{s // 60}m ago"


def label(c: dict) -> str:
    return f"{c['workflow']} / {c.get('name')}" if c.get("workflow") else str(c.get("name"))


def steps_note(c: dict) -> str:
    names = c.get("failedSteps") or []
    if not names:
        return ""
    more = f" +{len(names) - 3}" if len(names) > 3 else ""
    return f" (step: {', '.join(names[:3])}{more})"


def outcome(conclusion: str | None) -> str:
    text = (conclusion or "").lower()
    return "failed" if text in {"failure", "error", ""} else text


# What a text summary lists by default. Agents read it, so it names the checks that need action and counts the rest:
# a superseded attempt is not counted toward the verdict, so it is one count line, not one line each (a green
# cmux PR printed seven of them, half its summary). --verbose or AGENT_VERBOSE=1 lists them all, as before; --json
# and --field never change.
SUMMARY_FAILED = 10
SUMMARY_FAILED_VERBOSE = 20


def full_output() -> bool:
    """True when the caller asked for every line (`--verbose`, or AGENT_VERBOSE=1 in its environment)."""
    return os.environ.get("AGENT_VERBOSE") == "1"


def summary(key: str, entry: dict | None, until: str = "done", grace: float = RESCUE_GRACE,
            verbose: bool | None = None) -> str:
    verbose = full_output() if verbose is None else verbose
    shown_failed = SUMMARY_FAILED_VERBOSE if verbose else SUMMARY_FAILED
    kind, owner, repo, number = split_key(key)
    name = f"{owner}/{repo}{'/' if kind == 'run' else '#'}{number}"
    if not entry:
        return f"{name}: no data yet"
    data = entry.get("data")
    lines = []
    if not data:
        lines.append(f"{name}: no data ({entry.get('error') or 'not fetched yet'})")
        return "\n".join(lines)
    now = time.time()
    if kind == "pr":
        head = (data.get("headRefOid") or "")[:10]
        draft = " draft" if data.get("isDraft") else ""
        lines.append(f"{name} {data.get('state')}{draft}  mergeable={data.get('mergeable')} "
                     f"({data.get('mergeStateStatus')})  review={data.get('reviewDecision')}  head {head}")
        checks = data.get("checks") or []
        groups = classify(data, now, grace)
        marked = any(c.get("required") for c in checks)
        more = "+" if data.get("checksTruncated") else ""
        if checks:
            # the headline is this tool's own reading, the one `wait` decides by; GitHub's rollup also
            # counts superseded attempts and checks that are not required
            result = check_verdict(data, "done" if until == "merged" else until, now, grace)
            state = {EXIT_OK: "SUCCESS", EXIT_FAIL: "FAILURE"}.get(result, "PENDING")
            held = f", {len(groups['held'])} held" if groups["held"] else ""
            rollup = data.get("checkState")
            differs = f"; GitHub's rollup says {rollup}" if rollup and rollup != state else ""
            lines.append(f"checks {state}: {len(groups['passed'])} passed, {len(groups['failed'])} failed, "
                         f"{len(groups['pending'])} pending{held} (of {len(checks)}{more}, "
                         f"{sum(1 for c in checks if c.get('required'))} required){differs}")
        else:
            left = settling(data, now)
            lines.append("checks: none reported yet for this head commit"
                         + (f" (not started; settles in {int(left)}s)" if left is not None else ""))
        if data.get("state") == "OPEN" and expected_missing(data):
            lines.append(f"  expected, not posted yet: {', '.join(expected_missing(data))}")
        if data.get("requiredMissing"):
            why = " (merge conflicts: they run after the next push)" if data.get("mergeStateStatus") == "DIRTY" else ""
            lines.append(f"  required, not reported yet: {', '.join(data['requiredMissing'])}{why}")
        # Required checks first, then real failures before cancelled ones: the capped list leads with what to fix.
        bad = sorted(groups["failed"], key=lambda c: (marked and not c.get("required"),
                                                      str(c.get("conclusion") or "").lower() == "cancelled"))
        for c in bad[:shown_failed]:
            optional = " (not required)" if marked and not c.get("required") else ""
            lines.append(f"  {outcome(c.get('conclusion'))}: {label(c)}{steps_note(c)}{optional}  {c.get('url') or ''}".rstrip())
        if len(bad) > shown_failed:
            lines.append(f"  ... {len(bad) - shown_failed} more failed (--json lists them)")
        for c in groups["held"][:shown_failed]:
            refused = any(refused_check(o) and o.get("runId") == c.get("runId") for o in checks)
            why = ("cancelled before any step ran" if cancelled_unstarted(c)
                   else "its run had a job refused at runner setup" if refused
                   else "its run was cancelled while a job was still queued")
            lines.append(f"  held: {label(c)}{steps_note(c)}: {why}; "
                         f"pending up to {int(grace)}s for the re-run  {c.get('url') or ''}".rstrip())
        replaced = [c for c in data.get("superseded") or [] if not c.get("ranNothing")]
        for c in replaced[:10] if verbose else []:
            optional = " (not required)" if marked and not c.get("required") else ""
            lines.append(f"  superseded: {label(c)} {outcome(c.get('conclusion')) if c.get('conclusion') else 'pending'}"
                         f"{optional}, "
                         "replaced by a newer attempt or run (not counted)")
        replaced_count = len(replaced) + int(data.get("supersededOmitted") or 0)
        if replaced_count and not verbose:
            lines.append(f"  {replaced_count} superseded, replaced by a newer attempt or run "
                         "(not counted; --verbose lists up to 10)")
        lines.append(str(data.get("url") or ""))
    elif kind == "comment":
        lines.append(f"{name} {str(data.get('type') or '').lower()} {data.get('state')}: "
                     f"{data.get('total')} comments  {data.get('url') or ''}".rstrip())
        for c in (data.get("comments") or [])[-5:]:
            first = (str(c.get("body") or "").strip().splitlines() or [""])[0][:100]
            lines.append(f"  {c.get('id')} {c.get('author')} {c.get('createdAt')}: {first}")
    else:
        lines.append(f"{name} {data.get('name')}: {data.get('status')}"
                     f"{' / ' + str(data.get('conclusion')) if data.get('conclusion') else ''}"
                     f"  attempt {data.get('run_attempt')}  {data.get('head_branch')} {str(data.get('head_sha') or '')[:10]}")
        jobs = entry.get("jobs")
        if jobs is not None:
            # Real failures before cancelled jobs: the capped list leads with what to fix.
            bad = sorted((j for j in jobs if j.get("conclusion") not in (None, *RUN_OK)),
                         key=lambda j: str(j.get("conclusion") or "").lower() == "cancelled")
            live = [j for j in jobs if j.get("status") != "completed"]
            covered = jobs_attempt(jobs)
            stale = (f" (from attempt {covered}; attempt {data.get('run_attempt')} not read yet)"
                     if 0 < covered < (data.get("run_attempt") or 1) else "")
            lines.append(f"jobs: {len(jobs)} total, {len(bad)} failed, {len(live)} not finished{stale}")
            for j in bad[:shown_failed]:
                refused = f" (refused by {j.get('runner_name')})" if refused_job(j) else ""
                lines.append(f"  {outcome(j.get('conclusion'))}: {j.get('name')}{steps_note(j)}{refused}  "
                             f"{j.get('html_url') or ''}".rstrip())
        held = run_hold(data, jobs, now, grace)
        if held:
            lines.append(f"  held: attempt {data.get('run_attempt')} failed only because a glaeda runner refused "
                         f"{', '.join(str(j.get('name')) for j in held[:5])} at setup; pending up to {int(grace)}s "
                         "for a rescue attempt")
        lines.append(str(data.get("html_url") or ""))
    note = f"  (last error: {entry['error']})" if entry.get("error") else ""
    via = {"rest": ", read over REST", "graphql": ", read over GraphQL",
           "graphql-probe": ", confirmed unchanged over GraphQL"}.get(entry.get("via"), "")
    lines.append(f"data {age(entry.get('dataAt'))}{via}{note}")
    return "\n".join(lines)


def render(key: str, entry: dict | None, as_json: bool, extra: dict | None = None, until: str = "done",
           grace: float = RESCUE_GRACE, verbose: bool | None = None) -> str:
    if as_json:
        return json.dumps({"key": key, **(entry or {}), **(extra or {})}, sort_keys=True) + "\n"
    rest = {k: v for k, v in (extra or {}).items() if k not in CONTRACT_KEYS}
    lines = [summary(key, entry, until, grace, verbose)] + [f"{k}: {v}" for k, v in rest.items()]
    if extra and extra.get("ok") is False:
        # the agent output contract (cmuxterm-hq docs/handbook/agent-facing-output.md): what is wrong, then
        # `next:` as the last line, on the stream the rest of the answer uses
        if extra.get("reason"):
            lines.append(f"glaeda-gh: {extra['reason']}")
        lines.append(f"next: {extra.get('next') or 'none'}")
    return "".join(f"{line}\n" for line in lines)


CONTRACT_KEYS = ("ok", "code", "reason", "next")
WAIT_PROGRESS_EVERY = 120  # a `wait pr|run` says how it stands this often while it blocks


def key_name(key: str) -> str:
    """OWNER/REPO#N for a PR or comment thread, OWNER/REPO/ID for a run: what a command takes back."""
    kind, owner, repo, number = split_key(key)
    return f"{owner}/{repo}{'/' if kind == 'run' else '#'}{number}"


def utc_clock(at: float) -> str:
    """A wall-clock time in UTC with a Z (`17:55:00Z`), or "unknown" past what a clock can hold."""
    try:
        return time.strftime("%H:%M:%SZ", time.gmtime(at))
    except (ValueError, OSError, OverflowError):
        return "unknown"


def ok_fields() -> dict:
    return {"ok": True, "code": "ok", "reason": "", "next": ""}


def fail_fields(code: str, reason: str, nxt: str) -> dict:
    return {"ok": False, "code": code, "reason": reason, "next": nxt}


def not_found_fields(key: str) -> dict:
    kind, owner, repo, _ = split_key(key)
    what = "run" if kind == "run" else "PR or issue"
    listing = f"gh run list -R {owner}/{repo} --limit 5" if kind == "run" else \
        f"gh pr list -R {owner}/{repo} --state all --limit 5"
    return fail_fields("not-found", f"{key_name(key)}: no such {what} on GitHub (or this token cannot see it)",
                       listing)


def wait_command(req: dict) -> str:
    """The same wait again: what a timed-out wait names as its `next:` (a wait is a next step only with a deadline)."""
    parts = ["glaeda-gh", "wait", req["kind"], key_name(req["key"])]
    if req["kind"] == "pr" and req.get("until", "green") != "green":
        parts += ["--until", req["until"]]
    if req.get("sha"):
        parts += ["--sha", str(req["sha"])]
    if req.get("jobs"):
        parts.append("--jobs")
    return " ".join(parts + ["--timeout", f"{float(req['timeout']):g}"])


def progress_state(key: str, entry: dict | None, until: str = "done", grace: float = RESCUE_GRACE) -> str:
    """How a waited PR or run stands, on one line: the summary's headline (and a PR's checks line)."""
    lines = [line.strip() for line in summary(key, entry, until, grace, False).splitlines()]
    keep = lines[:2] if split_key(key)[0] == "pr" else lines[:1]
    return "; ".join(line for line in keep if line and not line.startswith("http"))


def progress_line(req: dict, state: str, now: float | None = None) -> str:
    """What a wait says every WAIT_PROGRESS_EVERY while it blocks. BLOCKER prints the same words."""
    now = time.time() if now is None else now
    began, timeout = float(req["began"]), float(req["timeout"])
    return (f"glaeda-gh: still waiting on {req['key']}: {int(max(0.0, now - began))}s of {timeout:g}s, "
            f"deadline {utc_clock(began + timeout)}" + (f"; {state}" if state else ""))


def wait_outcome(req: dict, result: int, entry: dict | None, waited: int) -> dict:
    """ok, code, reason and next for a decided or timed-out `wait pr|run` (agent output contract)."""
    key, kind = req["key"], req["kind"]
    name = key_name(key)
    _, owner, repo, number = split_key(key)
    data = (entry or {}).get("data") or {}
    if result == EXIT_OK:
        return ok_fields()
    if result == EXIT_TIMEOUT:
        state = progress_state(key, entry, req.get("until", "done"), float(req.get("grace", RESCUE_GRACE)))
        deadline = utc_clock(float(req["began"]) + float(req["timeout"]))
        return fail_fields("timeout", f"waited {waited} s for {name} (deadline {deadline}); last seen: {state}",
                           wait_command(req))
    if result == EXIT_CONFLICT:
        return fail_fields("conflict", f"{name} conflicts with its base (mergeable CONFLICTING)",
                           "none (merge or rebase onto the base and push; checks run after that push)")
    if result == EXIT_NOTHING:
        head = str(data.get("headRefOid") or "")[:10]
        return fail_fields("nothing-reported", f"no check or status ever reported on {name} head {head}",
                           "none (its CI never started: push again, or check the repository's workflow triggers)")
    if kind == "pr" and data.get("state") == "CLOSED":
        return fail_fields("pr-closed", f"{name} was closed without being merged",
                           f"gh pr view {number} -R {owner}/{repo}")
    if kind == "run":
        return fail_fields("run-failed", f"run {name} finished {data.get('conclusion') or 'unsuccessfully'}",
                           f"glaeda-gh status run {name} --jobs")
    failed = classify(data, time.time(), float(req.get("grace", RESCUE_GRACE)))["failed"] if data else []
    run_id = next((c.get("runId") for c in failed if c.get("runId")), None)
    return fail_fields("checks-failed", f"{name}: {len(failed)} check(s) failed",
                       f"glaeda-gh status run {owner}/{repo}/{run_id} --jobs" if run_id
                       else "none (fix the failed checks listed above, push, and wait again)")


def emit(key: str, entry: dict | None, as_json: bool, extra: dict | None = None, until: str = "done",
         grace: float = RESCUE_GRACE) -> None:
    sys.stdout.write(render(key, entry, as_json, extra, until, grace))


BARE_NUMBER = re.compile(r"#?(\d+)")


def status_keys(kind: str, targets: list[str]) -> list[str]:
    """The cache keys of `status`'s targets, in order and each once. For PRs and comments a bare `#N` or
    `N` names that number in the repository of the target before it, so `o/r#1 #2 3` is three PRs."""
    keys: list[str] = []
    repo: str | None = None
    for text in targets:
        bare = BARE_NUMBER.fullmatch(text.strip()) if kind in ("pr", "comment") else None
        if bare:
            if repo is None:
                raise WatchError(f"{text!r} needs an OWNER/REPO#N before it to name its repository")
            key = f"{kind}:{repo}#{int(bare.group(1))}"
        else:
            key = parse_key(kind, text)
            repo = split_key(key)[1] + "/" + split_key(key)[2]
        if key not in keys:
            keys.append(key)
    return keys


def register_all(keys: list[str], jobs: bool = False, once: bool = False) -> None:
    """register() for several keys under one hold of the lock, so the daemon's next tick finds every
    one of them and reads them together (one batched GraphQL query per GQL_BATCH PRs) rather than
    one per tick as each arrives."""
    watch_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    with bounded_lock(watch_dir() / ".register.lock"):
        for key in keys:
            _register_locked(watch_dir() / file_name(key), key, jobs, None, once=once)


def status_view(key: str, entry: dict | None, grace: float = RESCUE_GRACE) -> dict:
    """What `--field` reads: the `--json` object with its `data` lifted to the top, plus `head` (the head
    commit) and, for a PR, `checks` as this tool reads them: {state, passed, failed, pending, held,
    total, required}, each group a list of checks (printed as their names)."""
    entry = entry or {}
    data = entry.get("data") if isinstance(entry.get("data"), dict) else {}
    view: dict[str, Any] = {"key": key, **{k: v for k, v in entry.items() if k != "data"}, **data}
    if not data:
        return view
    kind = split_key(key)[0]
    if kind == "pr":
        view["head"] = data.get("headRefOid")
        groups = classify(data, time.time(), grace)
        checks = data.get("checks") or []
        result = check_verdict(data, "done", time.time(), grace) if checks else None
        view["checks"] = {"state": {EXIT_OK: "SUCCESS", EXIT_FAIL: "FAILURE"}.get(result, "PENDING"),
                          **groups, "total": len(checks), "required": [c for c in checks if c.get("required")]}
    elif kind == "run":
        view["head"] = data.get("head_sha")
    return view


def field_value(view: dict, path: str) -> Any:
    here: Any = view
    walked: list[str] = []
    for part in path.split("."):
        if not isinstance(here, dict) or part not in here:
            where = ".".join(walked) or "the top level"
            valid = ", ".join(sorted(here)) if isinstance(here, dict) else "none (not an object)"
            raise WatchError(f"--field {path}: no {part!r} at {where}; valid keys there: {valid}")
        here = here[part]
        walked.append(part)
    return here


def field_text(value: Any) -> str:
    """A list prints comma-joined, a check (any object with a name) as its name alone; other objects as JSON."""
    if value is None:
        return ""
    if isinstance(value, bool):
        return str(value).lower()
    if isinstance(value, list):
        return ",".join(str(v.get("name")) if isinstance(v, dict) and "name" in v else field_text(v) for v in value)
    if isinstance(value, dict):
        return json.dumps(value, sort_keys=True)
    return str(value).replace("\t", " ").replace("\n", " ")


def render_fields(keys: list[str], entries: dict[str, dict | None], fields: list[str]) -> str:
    """One line per key, `fields` tab-separated, prefixed by OWNER/REPO#N when there are several keys. An
    entry with no data yet prints empty values; a field an entry with data does not have is an error."""
    lines = []
    for key in keys:
        has = bool((entries.get(key) or {}).get("data"))
        view = status_view(key, entries.get(key))
        if not has and split_key(key)[0] == "pr":
            # no data yet: check the names against the shape every PR has, so a typo is refused now
            # rather than printing an empty column until the first read lands
            shape = status_view(key, {"data": parse_pr({"state": "OPEN"})})
            for f in fields:
                field_value(shape, f)
        values = [field_text(field_value(view, f)) if has else "" for f in fields]
        if len(keys) > 1:
            kind, owner, repo, number = split_key(key)
            values.insert(0, f"{owner}/{repo}{'/' if kind == 'run' else '#'}{number}")
        lines.append("\t".join(values))
    return "".join(f"{line}\n" for line in lines)


def parse_fields(text: str | None) -> list[str] | None:
    if text is None:
        return None
    fields = [f.strip() for f in text.split(",")]
    if not fields or any(not f or any(not part for part in f.split(".")) for f in fields):
        raise WatchError(f"--field takes a comma list of dotted names (head,checks.failed), not {text!r}")
    return fields


def say_daemon_problem(code: str, message: str, as_json: bool) -> None:
    """A daemon message (it ends with `next:`) on fd 2, and with --json the one object on stdout."""
    say_waiting(message)
    if as_json:
        text, _, nxt = message.rpartition("\nnext: ")
        print_json_error(code, (text or message).removeprefix("glaeda-gh: "), nxt or "glaeda-gh restart")


def cmd_status(kind: str, target: str | list[str], jobs: bool, as_json: bool, first_wait: float | None = None,
               fields: list[str] | None = None) -> int:
    """One look at one or more PRs, runs or comment threads. Several targets are registered together
    and waited for together, so the daemon gathers them in one tick. One target prints exactly what it
    always has; several print one block (or `--json` object, in a list) each, in the order given."""
    if first_wait is None:
        first_wait = daemon_policy()["cycle"] + 10.0  # a first read lands within one configured cycle
    keys = status_keys(kind, [target] if isinstance(target, str) else list(target))
    if not daemon_running(grace=DOWN_GRACE):
        say_daemon_problem("daemon-down", down_message(), as_json)
        return EXIT_DOWN
    broken = daemon_failing()
    if broken is not None:
        say_daemon_problem("daemon-failing", failing_message(broken), as_json)
        return EXIT_DOWN
    lag = daemon_stale()
    if lag is not None:
        say_waiting(stale_message(lag))
    # one look: the watch is dropped once the daemon has read it, unless something asks again (once_answered)
    if len(keys) == 1:
        register(keys[0], jobs, once=True)
    else:
        register_all(keys, jobs, once=True)
    deadline = time.monotonic() + first_wait

    def unready(entry: dict | None) -> bool:
        return entry is None or (jobs and "jobs" not in entry and not entry.get("error"))
    entries = {key: read_cache(key) for key in keys}
    while any(unready(e) for e in entries.values()) and time.monotonic() < deadline:
        time.sleep(1)
        entries = {key: entry if not unready(entry) else read_cache(key) for key, entry in entries.items()}
    outcomes = {key: status_outcome(key, entries[key]) for key in keys}
    if fields is not None:
        sys.stdout.write(render_fields(keys, entries, fields))
    elif len(keys) == 1:
        emit(keys[0], entries[keys[0]], as_json, outcomes[keys[0]])
    elif as_json:
        sys.stdout.write(json.dumps([{"key": k, **(entries[k] or {}), **outcomes[k]} for k in keys],
                                    sort_keys=True) + "\n")
    else:
        for key in keys:
            emit(key, entries[key], False, outcomes[key])
    if all(o["ok"] for o in outcomes.values()):
        return EXIT_OK
    # not found is an answer (1); a target the daemon has not read yet is one it could not judge (3)
    return EXIT_FAIL if any(o["code"] == "not-found" for o in outcomes.values()) else EXIT_DOWN


def status_outcome(key: str, entry: dict | None) -> dict:
    """ok, code, reason and next for one `status` target (agent output contract)."""
    if entry and entry.get("data"):
        return ok_fields()
    if entry and entry.get("missing"):
        return not_found_fields(key)
    kind = split_key(key)[0]
    error = (entry or {}).get("error")
    return fail_fields("no-data-yet", f"{key_name(key)}: the daemon has not read it from GitHub yet"
                       + (f" (last error: {error})" if error else ""),
                       f"glaeda-gh wait {kind} {key_name(key)} --timeout 600" if kind in ("pr", "run")
                       else f"glaeda-gh status {kind} {key_name(key)}")


def git_rev_parse(prefix: str) -> str | None:
    """The full id of `prefix` in the current checkout, if it names exactly one commit. Local only."""
    try:
        result = run_bounded(["git", "rev-parse", "--verify", "--quiet", f"{prefix}^{{commit}}"], 5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    full = result.stdout.strip().lower()
    return full if result.returncode == 0 and re.fullmatch(r"[0-9a-f]{40}", full) and full.startswith(prefix) else None


def resolve_sha(sha: str) -> tuple[str, bool]:
    """(commit, exact). A 40-hex id is exact. A prefix is resolved in the current checkout; one that
    does not resolve stays a prefix, which must then match the head GitHub shows (see cmd_wait)."""
    if not re.fullmatch(r"[0-9a-fA-F]{7,40}", sha):
        raise WatchError(f"--sha must be a commit id (git rev-parse HEAD), 40 hex digits or a prefix of at least 7, not {sha!r}")
    sha = sha.lower()
    if len(sha) == 40:
        return sha, True
    full = git_rev_parse(sha)
    return (full, True) if full else (sha, False)


def waiting_line(key: str, until: str, sha: str | None, exact: bool, timeout: float) -> str:
    """What this wait is about, printed before it blocks.

    The point is what its *absence* means. A `wait` started from an agent session's foreground
    shell is reaped with that shell, silently, leaving a zero-byte output file -- which looks
    exactly like "blocked and still waiting", so the caller goes on waiting for something that is
    gone. Three of one lane's waits died that way in an afternoon before anyone noticed. With this
    line, an empty file means it never started and a file holding it means it did, which is a
    one-look diagnosis instead of a guess.

    On stderr, so a `--json` consumer still reads exactly one JSON document on stdout -- and
    through `say_waiting`, which is where the rules about not becoming the problem live.

    The deadline is a wall-clock time as well as a duration, because the duration alone cannot be
    compared with anything: a reader looking at a line in a file does not know when the process
    started, so "giving up after 3600s" says nothing about whether this wait is still inside its
    timeout. The time does."""
    return (f"glaeda-gh: waiting on {key} until {until}"
            + (f" at {sha}{'' if exact else '... (a prefix: it must match the head GitHub shows)'}"
               if sha else "")
            + f", giving up after {timeout:g}s (at {deadline_clock(timeout)})")


def seconds(text: str) -> float:
    """A timeout `argparse` can refuse, rather than one the wait loop cannot honour.

    `type=float` took `inf` and `nan`. `inf` blocks forever, which is a process nobody is waiting
    for on purpose; `nan` is worse -- every comparison against it is false, so the loop never
    reaches its deadline and never exits (measured: killed from outside after 3 s). A formatter
    printing "unknown" for those was treating the symptom one layer too late."""
    try:
        value = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{text!r} is not a number of seconds") from None
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(
            f"{text!r} is not a number of seconds this can wait for: a finite count, not negative")
    return value


def deadline_clock(timeout: float, now: float | None = None) -> str:
    """When this wait gives up, UTC with a Z (`HH:MM:SSZ`, the agent output contract), or "unknown" past what
    a clock can hold.

    `now if now is None` and not `now or`: a caller passing `0.0` meant the epoch and got the wall
    clock, which made the parameter a lie in the one case a test would use it."""
    try:
        return utc_clock((time.time() if now is None else now) + timeout)
    except (ValueError, OSError, OverflowError):
        return "unknown"


DIAGNOSTIC_WRITE_S = 0.2  # how long a wait lets its own diagnostic hold it up
_DIAGNOSTIC_WRITING = threading.Lock()


def say_waiting(line: str) -> None:
    """Put a diagnostic on fd 2 without ever becoming the reason the wait does not happen.

    Three measured ways `print(..., file=sys.stderr)` turned this into the failure it exists to
    diagnose, each one found by a review round:

    - stderr a pipe whose reader is gone -- `wait ... 2>&1 | head -1`, or the `setsid nohup ... &`
      the skill recommends, from a shell being reaped. `print` raised at interpreter shutdown and
      the process died in 0.19 s with exit **120** (CPython's "failed to flush stderr"), where it
      used to wait its full timeout and exit 2.
    - stderr closed (`2>&-`). `sys.stderr` is then `None`, and `print(file=None)` is documented as
      printing to **stdout** -- so the line became the first line of `--json` output.
    - stderr a *blocking pipe that is already full*, reader alive but not reading (a shared
      `{ ...; glaeda-gh wait ...; } 2>&1 | slow`, or a stopped reader). `os.write` then blocks
      forever: a 1 s wait hung past 5 s, which is worse for the caller than exiting 120. Errors are
      not the only way a write can be the problem; backpressure is the other.

    So the write runs on a daemon thread and the wait gives it `DIAGNOSTIC_WRITE_S`; a write still
    blocked after that is left behind (it lands if the reader drains, or dies with the process), and
    later lines are dropped while it is. Neither earlier answer held. Asking `select` first: writable
    promises room for PIPE_BUF bytes on a pipe (a 100 KB `--contains` line blocked a nearly full one),
    and 512-byte writes blocked on a full socket and on a terminal. Making fd 2 non-blocking for the
    write: O_NONBLOCK belongs to the file description, which the parent and every sibling share, so
    two overlapping waits left the parent's stderr non-blocking for good. (Cutting the line to 512
    bytes also lost the end of the serve refusal, which names `--foreground-ok`.)
    It is encoded with backslashreplace, because a filename's surrogate-escaped bytes raised
    `UnicodeEncodeError` and the wait died with exit 1 and no JSON.

    One path, which is the production path: an earlier version printed to `sys.stderr` when a
    caller had replaced it, so the suite's in-process assertions ran through a branch nothing else
    reached -- and a mutation deferring the real write to `atexit` (the line arriving *after* the
    wait, which is exactly no use) passed all 337 tests. The tests read fd 2 of the real CLI now,
    while it is still blocked."""
    data = (line + "\n").encode(errors="backslashreplace")
    if not _DIAGNOSTIC_WRITING.acquire(blocking=False):
        return  # the last line is still stuck on fd 2

    def write() -> None:
        try:
            rest = data
            while rest:
                rest = rest[os.write(2, rest):]
        except OSError:
            pass
        finally:
            _DIAGNOSTIC_WRITING.release()

    try:
        writer = threading.Thread(target=write, name="say-waiting", daemon=True)
        writer.start()
    except RuntimeError:  # no thread to be had: drop the line rather than risk the wait
        _DIAGNOSTIC_WRITING.release()
        return
    writer.join(DIAGNOSTIC_WRITE_S)


def wait_request(kind: str, target: str, until: str, timeout: float, jobs: bool, as_json: bool,
                 sha: str | None, exact: bool, grace: float, settle: float = SETTLE_GRACE) -> dict:
    """What a `wait pr|run` is ruled on: the same fields whether the client polls (cmd_wait) or the
    daemon rules on it (subscribe_wait). `began` is wall-clock time: only data fetched after it counts."""
    return {"key": parse_key(kind, target), "kind": kind, "target": target, "until": until, "timeout": timeout,
            "jobs": jobs, "json": as_json, "sha": sha, "exact": exact, "grace": grace, "settle": settle,
            "began": time.time(), "verbose": full_output()}


def rest_run(data: dict | None) -> dict:
    """What a direct GitHub read (REST or GraphQL) showed of a run: kept as restRun, the proof a finish is GitHub's."""
    data = data or {}
    return {k: data.get(k) for k in ("run_attempt", "status", "conclusion")}


def controller_unconfirmed(entry: dict | None, now: float | None = None) -> bool:
    """A finished run whose finish came from the controller (directly, or through an upstream daemon) and that no
    direct GitHub read has shown (restRun, written only by fetch_run and the GraphQL run read): the controller can
    miss a rerun's deliveries and keep the last attempt's finish (manaflow-ai/cmux run 40434431701, 2026-10-27).
    Bounded: once the record is REST_SAFETY old (dataAt, which an unchanged record keeps) it counts, so a wait still
    rules when GitHub cannot be read and the controller is all there is."""
    entry = entry or {}
    # an upstream that does not say where its data came from (an older version) is treated as the controller's
    origin = (entry.get("origin") or "controller") if entry.get("source") == "upstream" else entry.get("source")
    data = entry.get("data")
    if origin != "controller" or not terminal("run", data):
        return False
    if entry.get("restRun") == rest_run(data):
        return False
    return (time.time() if now is None else now) - (entry.get("dataAt") or 0) < REST_SAFETY


_CONFIRM_REFUSED: dict[str, Any] = {}  # daemon.json's mtime -> confirm_refused's answer (wait_step runs every poll)


def confirm_refused() -> str | None:
    """Why the daemon cannot read GitHub to confirm a finished run now, or None: both of its routes stopped by the
    quota (GraphQL stopped, REST stopped or at the daemon's share), as daemon.json says. A wait then rules on the
    finish it has instead of sitting out the confirmation bounds (RUN_CONFIRM_MAX, REST_SAFETY) on a read that cannot
    happen: manaflow-ai/cmux run 43054254048, 2026-11-11 ~16:05Z, showed completed/success at 253 s and its wait ran
    past 857 s, both buckets stopped. A host reading through an upstream never says so (its upstream confirms)."""
    path = BASE / "daemon.json"
    try:
        info = path.stat()
        stamp = (info.st_mtime_ns, info.st_size)
    except OSError:
        return None
    if _CONFIRM_REFUSED.get("stamp") == stamp:
        return _CONFIRM_REFUSED.get("why")
    status = read_json(path)
    why = None
    if isinstance(status, dict) and not isinstance(status.get("upstream"), dict):
        modes = status.get("modes") if isinstance(status.get("modes"), dict) else {}
        share = status.get("restShare") if isinstance(status.get("restShare"), dict) else {}
        if modes.get("graphql") == "stop" and (modes.get("rest") == "stop" or share.get("capped") is True):
            why = ("GitHub's quota stops the daemon's reads (GraphQL stopped, REST "
                   f"{'stopped' if modes.get('rest') == 'stop' else 'at its share'})")
    _CONFIRM_REFUSED.clear()
    _CONFIRM_REFUSED.update(stamp=stamp, why=why)
    return why


def run_confirmed_since(entry: dict | None) -> float:
    """When a wait may last have been answered by an older attempt: a `gh run rerun` this host brokered (rerunAt)."""
    at = (entry or {}).get("rerunAt")
    return float(at) if isinstance(at, (int, float)) and not isinstance(at, bool) else 0.0


def run_unconfirmed(entry: dict | None, since: float, now: float) -> bool:
    """A finished run that no direct GitHub read (restRun, at restRunAt) has shown since SINCE, nor since the last rerun:
    the newest attempt may not be this one (RUN_CONFIRM_MAX). Bounded, so a wait still rules when GitHub cannot be
    read."""
    entry = entry or {}
    data = entry.get("data")
    if not terminal("run", data):
        return False
    since = max(since, run_confirmed_since(entry))
    shown = entry.get("restRunAt")
    if (isinstance(shown, (int, float)) and not isinstance(shown, bool) and shown >= since
            and entry.get("restRun") == rest_run(data)):
        return False
    return now - since < RUN_CONFIRM_MAX


def wait_step(req: dict, now: float) -> tuple[int, str] | None:
    """One look at a `wait pr|run` (wait_request): (exit code, what it prints) once it is decided or out
    of time, else None. Rules only on data the daemon fetched after the wait began, never on an older
    cache. A short --sha that GitHub's head resolves is written back into REQ. Raises WatchError."""
    key, kind, until, grace, began = req["key"], req["kind"], req["until"], req["grace"], req["began"]
    sha, exact, as_json = req.get("sha"), req.get("exact", True), req.get("json", False)
    entry = read_cache(key)
    fresh = entry is not None and (entry.get("fetchedAt") or 0) >= began
    waited = int(max(0.0, now - began))
    if fresh and not entry.get("data") and entry.get("missing"):
        # GitHub says NOT_FOUND; transport errors and 5xx stay pending
        return EXIT_FAIL, render(key, entry, as_json, {"result": "failure", "waited_s": waited, **not_found_fields(key)},
                                 until, grace, bool(req.get("verbose")))
    data = (entry or {}).get("data")
    # only a merge is final; a completed run can be rerun and a closed PR reopened
    final = kind == "pr" and data and data.get("state") == "MERGED"
    usable = data and ((entry.get("dataAt") or 0) >= began or final)
    unconfirmed = usable and kind == "run" and (controller_unconfirmed(entry, now) or run_unconfirmed(entry, began, now))
    refused = confirm_refused() if unconfirmed else None
    if unconfirmed and refused is None:
        # the daemon reads GitHub once first (Daemon.due's confirm): the controller's finish, or a finish that may be
        # a superseded attempt's
        usable = False
    _, owner, repo, _ = split_key(key)
    if usable and sha:
        head = str(data.get("headRefOid" if kind == "pr" else "head_sha") or "").lower()
        if kind == "run" and head and not head.startswith(sha) and exact and data.get("event") == "workflow_dispatch":
            if run_tests_commit(data, f"{owner}/{repo}", sha):
                head = ""  # a dispatch that names the commit it tested: that commit is the one to match
            elif data.get("display_title") is None:
                # a record without the run-name (the controller's): neither refused nor ruled on until GitHub's read
                head, usable = "", False
        if head and not head.startswith(sha):
            if kind == "run":
                raise WatchError(f"run {req['target']} is for commit {head[:12]}, not {sha[:12]}; a run's commit never "
                                 "changes, and its run-name does not name that full commit as the one it tested")
            if not exact:
                raise WatchError(f"--sha {sha} is not a commit in this checkout and is not the head GitHub shows "
                                 f"({head[:12]}); pass the full id (git rev-parse HEAD) to wait for a push "
                                 "GitHub has not seen yet")
        elif head and not exact:
            # resolved: a later push now counts as pending, as for a full id
            req["sha"], req["exact"] = sha, exact = head, True
    settle = float(req.get("settle", SETTLE_GRACE))
    result = (verdict(kind, data, until, sha, (entry or {}).get("jobs"), time.time(), grace, f"{owner}/{repo}", settle)
              if usable else None)
    if result is not None:
        outcome_name = {EXIT_OK: "success", EXIT_CONFLICT: "conflict", EXIT_NOTHING: "nothing-reported"}.get(
            result, "failure")
        extra: dict[str, Any] = {"result": outcome_name, "waited_s": waited}
        if kind == "pr" and result == EXIT_NOTHING:
            extra["note"] = (f"no check or status reported on this head within {int(settle)}s of its push: "
                             "its CI has not started (not a pass)")
        elif kind == "pr" and result == EXIT_CONFLICT:
            extra["note"] = ("PR conflicts with its base (mergeable CONFLICTING): no checks run until you "
                             "merge or rebase onto the base and push")
        elif kind == "pr" and data.get("state") == "CLOSED":
            extra["note"] = "PR was closed without being merged"
        elif kind == "pr" and until == "done" and data.get("state") == "MERGED":
            extra["note"] = "PR was merged: done, whatever its checks still show"
        if unconfirmed and refused is not None:
            extra["note"] = f"finish not confirmed by a GitHub read: {refused}"
        if kind == "run" and result == EXIT_FAIL and grace > 0 and run_hold(data, entry.get("jobs"), time.time(), float("inf")):
            extra["note"] = f"a glaeda runner refused this attempt at setup and no rescue attempt followed within {int(grace)}s"
        extra.update(wait_outcome(req, result, entry, waited))
        return result, render(key, entry, as_json, extra, until, grace, bool(req.get("verbose")))
    if now - began >= req["timeout"]:
        extra = {"result": "timeout", "waited_s": waited}
        if sha and entry and entry.get("data"):
            head = entry["data"].get("headRefOid") or entry["data"].get("head_sha") or ""
            if not str(head).startswith(sha) and not (kind == "run" and run_tests_commit(entry["data"], f"{owner}/{repo}", sha)):
                extra["note"] = f"GitHub still shows head {str(head)[:10]}, not {sha[:10]}"
        extra.update(wait_outcome(req, EXIT_TIMEOUT, entry, waited))
        return EXIT_TIMEOUT, render(key, entry, as_json, extra, until, grace, bool(req.get("verbose")))
    return None


def cmd_wait(kind: str, target: str, until: str, timeout: float, jobs: bool, as_json: bool,
             sha: str | None = None, grace: float = RESCUE_GRACE, settle: float = SETTLE_GRACE) -> int:
    """The polling wait: this process re-reads the cache until wait_step decides. `wait pr|run` uses it
    only when the daemon cannot rule on the wait itself (subscribe_wait). Says the waiting line once,
    before it blocks; poll_wait does not, so a wait handed back to it (resume_wait) is not said twice."""
    key = parse_key(kind, target)  # a bad target is the first thing said
    exact = True
    if sha:
        sha, exact = resolve_sha(sha)
    say_waiting(waiting_line(key, until, sha, exact, timeout))
    return poll_wait(wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, settle))


def wait_starved(req: dict, entry: dict | None, now: float) -> float | None:
    """How old the data a wait is blocked on is, when it is starved: the wait has run STALE_DATA_AFTER and nothing was
    read for its target in that long (since the wait began, for a target never read), and no direct read was tried
    in that long. None otherwise. Only for an undecided wait: wait_step rules first."""
    began = float(req["began"])
    if now - began < STALE_DATA_AFTER:
        return None
    if now - float(req.get("directAt") or float("-inf")) < STALE_DATA_AFTER:
        return None
    seen = (entry or {}).get("dataAt")
    age_s = now - (seen if isinstance(seen, (int, float)) and not isinstance(seen, bool) else began)
    return age_s if age_s > STALE_DATA_AFTER else None


def direct_read(req: dict) -> str | None:
    """One read of the wait's target from GitHub by this process, outside the daemon's queue, stored in the cache the
    way the daemon stores it (so wait_step rules on it): a PR over GraphQL, a run over REST. The fallback for a wait
    whose daemon heartbeats but has not refreshed this target (wait_starved). None, or why it could not read."""
    key, kind = req["key"], req["kind"]
    if kind not in ("pr", "run"):
        return f"no direct read for a {kind}"
    bucket = "graphql" if kind == "pr" else "rest"
    try:
        if upstream_command() is not None:
            return DIRECT_UPSTREAM
        daemon = Daemon(controller=None, upstream=None)
    except Exception as failure:  # noqa: BLE001  a fallback read never stops the wait
        return f"{describe(failure)} at {error_site(failure)}"
    # The daemon's own view as well as budget.json's: a secondary hold or a backoff lives only in its memory, and
    # daemon.json's modes carry it (a fresh Daemon here starts with no backoff).
    modes = (read_json(BASE / "daemon.json") or {}).get("modes")
    if daemon.mode(bucket) == "stop" or (isinstance(modes, dict) and modes.get(bucket) == "stop"):
        return DIRECT_QUOTA
    # A wait's own read is a session's request, not the daemon's polling: it is not charged to the daemon's REST share,
    # and above all this process must never write rest-spend.json from the copy it read at construction, which would
    # overwrite the minutes the daemon counted since (review of glaeda#1942).
    daemon.charge_rest = lambda minute, n: None  # type: ignore[method-assign]
    daemon.now = time.time()
    daemon.tick_deadline = time.monotonic() + DIRECT_READ_BUDGET
    entry = {"key": key, "jobs": bool(req.get("jobs")), "cache": read_cache(key), "touched": daemon.now,
             "waitedAt": daemon.now, "waitBegan": float(req["began"]), "readers": [], "reader": "", "consumers": {}}
    try:
        with daemon.calling(*caller_of(key), "tool:glaeda-gh wait (direct read)"):
            if kind == "pr":
                daemon.gql_reason = "pr-direct"
                error = daemon.fetch_prs([entry])
            else:
                daemon.fetch_run(entry)
                error = None
    except OutOfTime:
        return f"no answer within {DIRECT_READ_BUDGET}s"
    except Exception as failure:  # noqa: BLE001  a fallback read never stops the wait
        return f"{describe(failure)} at {error_site(failure)}"
    if error:
        return error
    cached = read_cache(key) or {}
    return None if (cached.get("dataAt") or 0) >= daemon.now else (cached.get("error") or "no data stored")


def poll_wait(req: dict) -> int:
    """Re-read the cache until wait_step decides REQ, saying what a down, failing or stale daemon means.
    A wait the daemon stopped ruling on (resume_wait) carries on here, from when it began."""
    timeout, jobs = req["timeout"], req["jobs"]
    start = time.monotonic() - max(0.0, time.time() - req["began"])
    touched = -TOUCH_EVERY
    said = time.monotonic()
    warned = False
    down, down_since = DownWait(), None
    while True:
        if not daemon_running(grace=DOWN_GRACE):
            down_since = time.monotonic() if down_since is None else down_since
            if not down.patient(down_since, start, timeout):
                if req.get("json"):
                    print_json_error("daemon-down", "the daemon is not running, so nothing is polling GitHub",
                                     down_message().rpartition("\nnext: ")[2])
                return EXIT_DOWN
            time.sleep(WAIT_POLL)
            continue
        down_since = None
        broken = daemon_failing()
        if broken is not None:
            say_daemon_problem("daemon-failing", failing_message(broken), bool(req.get("json")))
            return EXIT_DOWN
        lag = daemon_stale()
        if lag is not None and not warned:
            say_waiting(stale_message(lag))
            warned = True
        now = time.monotonic()
        if now - touched >= TOUCH_EVERY:
            register(req["key"], jobs, waited=True, began=req["began"])  # (the same start every touch)
            touched = now
        done = wait_step(req, time.time())
        if done is None or done[0] == EXIT_TIMEOUT:
            starved = wait_starved(req, read_cache(req["key"]), time.time())
            if starved is not None:
                # The daemon heartbeats but has not refreshed this target: say so, loudly, and read it once here
                # instead of waiting out the timeout on data that old.
                req["directAt"] = time.time()
                say_waiting(f"glaeda-gh: WARNING: the daemon has not refreshed {key_name(req['key'])} for "
                            f"{int(starved)}s (its heartbeat is fresh, its data is not); reading GitHub directly once.")
                error = direct_read(req)
                say_waiting("glaeda-gh: direct read " + (f"failed: {error}" if error else "answered") + "."
                            + ("" if error in (DIRECT_QUOTA, DIRECT_UPSTREAM) else "\nnext: glaeda-gh restart"))
                done = wait_step(req, time.time())
        if done is not None:
            sys.stdout.write(done[1])
            return done[0]
        if time.monotonic() - said >= WAIT_PROGRESS_EVERY:
            said = time.monotonic()
            with contextlib.suppress(Exception):  # a progress line never stops the wait
                say_waiting(progress_line(req, progress_state(req["key"], read_cache(req["key"]), req["until"],
                                                              float(req["grace"]))))
        time.sleep(min(WAIT_POLL, max(0.1, req["began"] + timeout - time.time())))


WAITS_CONTRACT = 1  # daemon.json "waits": this daemon rules on `wait pr|run` requests (Daemon.serve_waits)
WAITS_CHECK = 60  # a blocker hands its wait back to Python when no tick has ruled on waits for this long
WAITS_LEFTOVER = 600  # a request this far past its deadline has no blocker left (a reused pid): dropped
WAITS_MAX_TIMEOUT = 1e8  # longer (or inf) waits poll, as before: bash keeps time in whole seconds
BASH = "/bin/bash"
# The whole waiter once the request is written: bash blocked reading the FIFO until the daemon writes
# the exit code (Daemon.serve_waits), then what the wait prints. `3<>` opens without waiting for a
# writer. Every WAITS_CHECK it looks at waits/.served, which each tick touches; at the wait's deadline,
# once no tick has served waits since its last look (the daemon is down, failing, hung, or an older
# one), or once its FIFO is gone (the daemon dropped the request), it execs "$@": `glaeda-gh
# wait-resume ID` (resume_wait). That argument list is a contract with every live blocker: keep it.
# Every GLAEDA_WAIT_PROGRESS seconds (env, set by block) it says how the wait stands on fd 2, from the
# one line the daemon keeps in $out.state (serve_wait), in progress_line's words. The printf runs in the
# background with SIGPIPE ignored and fd 1 and 3 not held, and only one at a time: like say_waiting, a closed
# or full stderr never stops or delays the wait. One still blocked on a full stderr when the wait ends is
# killed, so repeated waits leave no writers behind: only while that PID is still this shell's child, so a
# writer that already exited and whose PID was reused is never signalled. SIGKILL, because a caller can
# hand down SIGTERM ignored, and then the reap would wait on the blocked writer forever.
BLOCKER = r"""fifo=$1 out=$2 limit=$3 served=$4 check=$5
shift 5
trap '' PIPE
every=${GLAEDA_WAIT_PROGRESS:-0} said=$SECONDS sayer=
case "$every" in ''|*[!0-9]*) every=0 ;; esac
mark=$out.mark
exec 3<>"$fifo" || exec "$@"
: > "$mark"
end=$((SECONDS + limit))
rc=
while :; do
  left=$((end - SECONDS))
  [ "$left" -gt 0 ] || break
  [ "$left" -gt "$check" ] && left=$check
  IFS= read -r -t "$left" rc <&3 && break
  rc=
  [ -p "$fifo" ] && [ "$served" -nt "$mark" ] || break
  : > "$mark"
  if [ "$every" -gt 0 ] && [ $((SECONDS - said)) -ge "$every" ]; then
    said=$SECONDS state=
    [ -f "$out.state" ] && IFS= read -r state < "$out.state"
    if [ -z "$sayer" ] || ! kill -0 "$sayer" 2>/dev/null; then
      printf '%s\n' "glaeda-gh: still waiting on $GLAEDA_WAIT_KEY: $((${GLAEDA_WAIT_ELAPSED:-0} + SECONDS))s of ${GLAEDA_WAIT_TIMEOUT}s, deadline $GLAEDA_WAIT_DEADLINE${state:+; $state}" 1>&2 2>/dev/null 3<&- &
      sayer=$!
    fi
  fi
done
if [ -n "$sayer" ] && [ "$(ps -o ppid= -p "$sayer" 2>/dev/null | tr -d ' ')" = "$$" ]; then
  kill -KILL "$sayer" 2>/dev/null && wait "$sayer" 2>/dev/null
fi
exec 3<&-
rm -f "$mark" "$out.state"
case "$rc" in ''|*[!0-9]*) exec "$@" ;; esac
[ -f "$out.err" ] && cat "$out.err" >&2
[ -f "$out" ] && cat "$out"
rm -f "$fifo" "$out" "$out.err" "$out.rc"
exit "$rc"
"""
WAIT_FILES = (".json", ".fifo", ".out", ".out.err", ".out.rc", ".out.mark", ".out.state")


# How fresh waits/.served may be and still not be touched again. A blocker asks `.served -nt .out.mark` once every
# WAITS_CHECK (60 s), its mark made at its previous look; touched at most every SERVED_QUIET plus a tick, a live
# daemon's .served is always newer than a mark 60 s old. Touching it every TICK (2 s) was ~30 fseventsd events a
# minute on cosmic-gray for no blocker's benefit (2026-11-05).
SERVED_QUIET = 10.0


def mark_waits_served() -> None:
    """Tell the blockers a daemon that rules on waits is ticking (BLOCKER reads waits/.served), at most once every
    SERVED_QUIET."""
    with contextlib.suppress(OSError):
        if waits_dir().is_dir():
            served = waits_dir() / ".served"
            with contextlib.suppress(OSError):
                if 0 <= time.time() - served.stat().st_mtime < SERVED_QUIET:
                    return
            served.touch()


def waits_dir() -> Path:
    return BASE / "waits"  # `wait pr|run` requests the daemon rules on: <id>.json, .fifo, .out, .out.rc, ...


def write_wait_request(kind: str, target: str, until: str, timeout: float, jobs: bool, as_json: bool,
                       sha: str | None, exact: bool, grace: float, pid: int, began: float | None = None,
                       settle: float = SETTLE_GRACE) -> str:
    """Leave a wait for the daemon: its FIFO first, then the request, so the daemon never sees a request
    without one. Interest is registered at once, as a polling wait does. Returns the request's id."""
    req = wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, settle)
    if began is not None:  # a handoff keeps the wait's start (data read since then still counts), same deadline
        req["timeout"] += max(0.0, req["began"] - began)
        req["began"] = began
    rid = f"{pid}-{os.urandom(4).hex()}"
    waits_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    os.mkfifo(waits_dir() / f"{rid}.fifo", 0o600)
    register(req["key"], jobs, waited=True, began=req["began"])
    write_json(waits_dir() / f"{rid}.json", {**req, "pid": pid, "touched": req["began"], "reader": reader_name()})
    return rid


def serving_waits() -> bool:
    """Whether the daemon runs, rules on waits (WAITS_CONTRACT), and is neither failing nor hung."""
    status = read_json(BASE / "daemon.json") or {}
    return (isinstance(status.get("waits"), int) and status["waits"] >= WAITS_CONTRACT and lock_held()
            and daemon_failing() is None and daemon_stale() is None)


def controller_wait_run(key: str, timeout: float) -> dict | None:
    """Use one bounded controller long-poll and publish it through the cache write lock."""
    controller = Controller.from_env()
    if controller is None:
        return None
    _, owner, repo, run_id = split_key(key)
    wait = max(0, min(CLIENT_RUN_LONG_POLL, CONTROLLER_RUN_MAX_WAIT, int(timeout)))
    try:
        baseline = controller.run(run_id, wait=0)
        if not isinstance(baseline, dict) or str(baseline.get("id")) != str(run_id):
            return None
        expected_repo = f"{owner}/{repo}"
        if str(baseline.get("repo") or "").lower() != expected_repo:
            return None
        expected_attempt = baseline.get("attempt")
        run = controller.run(run_id, wait=wait)
    except (NoReceiver, WatchError, OSError):
        return None
    if (not isinstance(run, dict) or str(run.get("id")) != str(run_id)
            or str(run.get("repo") or "").lower() != expected_repo
            or run.get("attempt") != expected_attempt):
        return None
    candidate = controller_run(run)
    cache_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    cache = cache_dir() / file_name(key)
    with bounded_lock(cache_dir() / ".write.lock") as held:
        if not held:
            return None
        prior = read_json(cache) or {}
        prior_data = prior.get("data") or {}
        try:
            if (prior_data.get("run_attempt") is not None
                    and int(candidate.get("run_attempt") or 0) < int(prior_data["run_attempt"])):
                return None
        except (TypeError, ValueError):
            return None
        prior_updated = iso_epoch(prior_data.get("updated_at"))
        candidate_updated = iso_epoch(candidate.get("updated_at"))
        if prior_updated is not None and candidate_updated is not None and candidate_updated < prior_updated:
            return None
        now = time.time()
        rest_at = (prior.get("restAt") if prior.get("source") == "controller"
                   and isinstance(prior.get("restAt"), (int, float)) else now)
        # An unchanged queued or in-progress record keeps its time, as apply_run's does: a long-poll that ends
        # on the same stale record must not make it look fresh and push back the daemon's STALE_RUN_REREAD.
        data_at = now
        if (not terminal("run", candidate) and isinstance(prior.get("dataAt"), (int, float))
                and all(prior_data.get(k) == candidate.get(k) for k in ("status", "conclusion", "run_attempt", "updated_at"))):
            data_at = prior["dataAt"]
            if isinstance(prior.get("restAt"), (int, float)):
                rest_at = prior["restAt"]
        entry = {"key": key, "fetchedAt": now, "dataAt": data_at, "restAt": rest_at,
                 "data": candidate, "error": None, "source": "controller"}
        for field in ("etag", "jobs", "jobsEtag", "jobsAt", "jobsTried", "restParts", "restRun", "restRunAt", "rerunAt"):
            if field in prior:
                entry[field] = prior[field]
        write_json(cache, entry)
    return entry


def wait_refusal(req: dict, code: str, reason: str, nxt: str) -> tuple[tuple[int, str], str]:
    """A daemon-ruled wait that cannot be ruled on: ((64, its --json object or nothing), its stderr lines)."""
    out = json.dumps({"ok": False, "code": code, "reason": reason, "next": nxt}) + "\n" if req.get("json") else ""
    return (64, out), f"glaeda-gh: {reason}\nnext: {nxt}\n"


def subscribe_wait(kind: str, target: str, until: str, timeout: float, jobs: bool, as_json: bool,
                   sha: str | None = None, grace: float = RESCUE_GRACE, settle: float = SETTLE_GRACE) -> int:
    """`wait pr|run` as a request the daemon rules on: this process writes it and becomes BLOCKER, a bash
    asleep on a FIFO, instead of a Python interpreter re-reading the cache every WAIT_POLL (89 of those
    held 1.6 GB on cosmic-gray, 2026-10-21). Same arguments, output and exit codes as cmd_wait, which it
    falls back to when the daemon is not serving waits (down, failing, hung or older than WAITS_CONTRACT),
    there is no bash, or the timeout is not a finite number of seconds bash can count. (The CLI's
    `seconds` already refuses inf, nan and negative timeouts; the range check here is for direct callers
    and for finite timeouts past WAITS_MAX_TIMEOUT.)

    The waiting line is said exactly once: by cmd_wait on the first fallback, here before BLOCKER
    otherwise -- say_waiting writes fd 2 directly, so nothing is left buffered across the exec -- and
    not again on the late fallback, which goes straight to poll_wait."""
    if not (0 <= timeout <= WAITS_MAX_TIMEOUT) or not os.access(BASH, os.X_OK) or not serving_waits():
        return cmd_wait(kind, target, until, timeout, jobs, as_json, sha, grace, settle)
    key = parse_key(kind, target)
    exact = True
    if sha:
        sha, exact = resolve_sha(sha)
    say_waiting(waiting_line(key, until, sha, exact, timeout))
    req = wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, settle)
    if kind == "run" and not jobs:
        # the daemon keeps reading while this blocks (a lost finish is re-read past STALE_RUN_REREAD)
        register(key, jobs, waited=True, began=req["began"])
        started = time.monotonic()
        controller_wait_run(key, timeout)
        done = wait_step(req, time.time())
        if done is not None:
            sys.stdout.write(done[1])
            return done[0]
        # The one-shot request may have returned an in-progress run or a transport fallback. The
        # remaining deadline is recomputed after the blocking call before the FIFO wait begins.
        timeout = max(0.0, timeout - (time.monotonic() - started))
    try:
        rid = write_wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, os.getpid(),
                                 began=req["began"], settle=settle)
    except OSError:
        late = wait_request(kind, target, until, timeout, jobs, as_json, sha, exact, grace, settle)
        late["timeout"] += max(0.0, late["began"] - req["began"])
        late["began"] = req["began"]
        return poll_wait(late)
    block(rid, timeout, req)
    return EXIT_DOWN  # not reached


def block(rid: str, left: float, req: dict | None = None) -> None:
    """Become BLOCKER for request RID, with LEFT seconds to its deadline. The same pid carries on: the
    daemon tells a gone waiter by it. REQ (the wait_request) gives the words of its progress lines."""
    d = waits_dir()
    sys.stdout.flush()
    sys.stderr.flush()
    # BLOCKER reads these from its environment: os.environ, which execv hands on (the process is replaced)
    os.environ.pop("GLAEDA_WAIT_PROGRESS", None)
    if req is not None:
        began, timeout = float(req["began"]), float(req["timeout"])
        os.environ.update({"GLAEDA_WAIT_KEY": str(req["key"]), "GLAEDA_WAIT_TIMEOUT": f"{timeout:g}",
                    "GLAEDA_WAIT_DEADLINE": utc_clock(began + timeout),
                    "GLAEDA_WAIT_ELAPSED": str(int(max(0.0, time.time() - began))),
                    "GLAEDA_WAIT_PROGRESS": str(WAIT_PROGRESS_EVERY)})
    os.execv(BASH, [BASH, "-c", BLOCKER, "glaeda-gh-wait", os.fspath(d / f"{rid}.fifo"), os.fspath(d / f"{rid}.out"),
                    str(max(1, int(left + 0.999))), os.fspath(d / ".served"), str(WAITS_CHECK),
                    sys.executable, os.path.abspath(__file__), "wait-resume", rid])


def resume_wait(rid: str) -> int:
    """Where BLOCKER hands a wait back: at its deadline, or once no tick has ruled on waits for WAITS_CHECK.
    The daemon's answer if it left one; else back to sleep while the daemon serves waits and time is left;
    else on as the polling wait (poll_wait), which says what a down, failing or stale daemon means and
    rules on the timeout itself."""
    d = waits_dir()
    with contextlib.suppress(OSError, ValueError):
        code = int((d / f"{rid}.out.rc").read_text())
        with contextlib.suppress(OSError):
            sys.stderr.write((d / f"{rid}.out.err").read_text())
        with contextlib.suppress(OSError):
            sys.stdout.write((d / f"{rid}.out").read_text())
        drop_wait(rid)
        return code
    req = read_json(d / f"{rid}.json")
    if not isinstance(req, dict) or not all(k in req for k in ("key", "kind", "began", "timeout", "until", "grace")):
        drop_wait(rid)
        say_waiting("glaeda-gh: this wait's request is gone; run the wait again")
        say_waiting("next: glaeda-gh wait --help")
        return EXIT_DOWN
    left = float(req["began"]) + float(req["timeout"]) - time.time()
    if left > 0 and serving_waits() and req.get("stale") is None:  # (a stale one was handed back on purpose)
        register(req["key"], bool(req.get("jobs")), waited=True, began=float(req["began"]))
        block(rid, left, req)
    drop_wait(rid)
    try:
        return poll_wait(req)
    except WatchError as error:
        if req.get("json"):  # main's wait-resume handler says it on fd 2; the saved request knows --json
            print_json_error("refused", str(error), "glaeda-gh wait --help")
        raise


def waiter_alive(pid: Any) -> bool:
    """Whether a wait's blocker still runs: one signal-0 per request, no `ps` (a tick may hold many)."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def wake_waiter(fifo: Path, code: int) -> bool:
    """Write the exit code to a blocker's FIFO. False while no blocker has it open (not started yet, or
    handing the wait back to Python), or if it went away mid-write."""
    try:
        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        os.write(fd, f"{code}\n".encode())
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def drop_wait(rid: str) -> None:
    for suffix in WAIT_FILES:
        with contextlib.suppress(OSError):
            (waits_dir() / f"{rid}{suffix}").unlink()


def file_ready(pattern: str, mode: str, contains: re.Pattern | None) -> str | None:
    """The first path matching the glob `pattern` that satisfies `mode` (nonempty, exists, gone), else None."""
    path = os.path.expanduser(pattern)
    matches = glob.glob(path) if glob.has_magic(path) else ([path] if os.path.lexists(path) else [])
    if mode == "gone":
        return pattern if not matches else None
    for found in sorted(matches):
        if mode == "exists" and contains is None:
            return found  # even a dangling symlink exists
        try:
            size = os.stat(found).st_size
            if mode == "nonempty" and size == 0 and not os.path.isdir(found):
                continue
            if contains is not None and not contains.search(Path(found).read_text(errors="replace")):
                continue
        except OSError:
            continue
        return found
    return None


def cmd_wait_file(target: str, timeout: float, as_json: bool, mode: str = "nonempty",
                  contains: str | None = None) -> int:
    """Block until a file exists and is not empty (`[ -s FILE ]`), exists (--exists), or is gone (--gone),
    optionally with a line matching --contains. PATH may be a glob. Local stat calls only; no GitHub."""
    try:
        pattern = re.compile(contains, re.M) if contains else None
    except re.error as error:
        raise WatchError(f"--contains {contains!r} is not a regular expression: {error}")
    if contains and mode == "gone":
        raise WatchError("--contains does not apply to --gone")
    say_waiting(waiting_line(target, mode + (f" and matching {contains}" if contains else ""),
                             None, True, timeout))
    start = time.monotonic()
    while True:
        found = file_ready(target, mode, pattern)
        waited = int(time.monotonic() - start)
        if found is not None:
            print(json.dumps({"result": "success", "path": found, "waited_s": waited}) if as_json
                  else f"glaeda-gh: {found} {'is gone' if mode == 'gone' else 'is ready'} after {waited}s")
            return EXIT_OK
        if time.monotonic() - start >= timeout:
            print(json.dumps({"result": "timeout", "path": target, "waited_s": waited}) if as_json
                  else f"glaeda-gh: {target} not ready after {waited}s (timeout)")
            return EXIT_TIMEOUT
        time.sleep(min(WAIT_FILE_POLL, max(0.05, timeout - (time.monotonic() - start))))


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:  # a zombie has exited; its parent just has not reaped it
        state = subprocess.run(["ps", "-o", "stat=", "-p", str(pid)], capture_output=True, text=True, timeout=5).stdout
        return not state.strip().startswith("Z") and bool(state.strip())
    except (OSError, subprocess.SubprocessError):
        return True


def cmd_wait_pid(target: str, timeout: float, as_json: bool) -> int:
    """Block until the process exits (the `while kill -0 PID` loop). Exit 0 when it is gone, 2 on timeout."""
    if not target.isdigit() or not 0 < int(target) < 2 ** 31:
        raise WatchError(f"wait pid takes a process id, not {target!r}")
    pid, start = int(target), time.monotonic()
    say_waiting(waiting_line(f"pid {pid}", "it exits", None, True, timeout))
    while pid_alive(pid):
        waited = int(time.monotonic() - start)
        if time.monotonic() - start >= timeout:
            print(json.dumps({"result": "timeout", "pid": pid, "waited_s": waited}) if as_json
                  else f"glaeda-gh: process {pid} still running after {waited}s (timeout)")
            return EXIT_TIMEOUT
        time.sleep(min(WAIT_FILE_POLL, max(0.05, timeout - (time.monotonic() - start))))
    waited = int(time.monotonic() - start)
    print(json.dumps({"result": "success", "pid": pid, "waited_s": waited}) if as_json
          else f"glaeda-gh: process {pid} exited after {waited}s")
    return EXIT_OK


def head_served(entry: dict | None, now: float, max_age: float) -> tuple[dict | None, bool]:
    """(data, fresh): a head's data, and whether it is recent enough. Settled data is good for
    HEAD_SETTLED_TTL and two of the daemon's head cycles (the configured one, as the daemon paces
    by it), pending data for max_age."""
    data = (entry or {}).get("data")
    if not data:
        return None, False
    age = now - ((entry or {}).get("dataAt") or 0)
    if not data.get("settled"):
        return data, age < max_age
    return data, age < HEAD_SETTLED_TTL + 2 * daemon_policy()["cycles"]["head"]


def cmd_checks(repo: str, shas: list[str], consumer: str, max_age: float, wait: float, as_json: bool) -> int:
    """Every check of each commit, from the daemon's cache. The daemon reads each head once for all
    sessions, within the consumer's hourly budget; a head it may not read is served stale or reported
    unread, and this command never reads GitHub itself."""
    if not CONSUMER_RE.fullmatch(consumer or ""):
        raise WatchError("--consumer must be a short name (letters, digits, . _ -), e.g. autoland")
    keys = {}
    for sha in shas:
        keys[sha.lower()] = parse_key("head", f"{repo}@{sha}")
    began, start = time.time(), time.monotonic()
    touched = -TOUCH_EVERY
    down, down_since = DownWait(), None
    while True:
        if not daemon_running(grace=DOWN_GRACE):
            down_since = time.monotonic() if down_since is None else down_since
            if not down.patient(down_since, start, wait):
                return EXIT_DOWN
            time.sleep(WAIT_POLL)
            continue
        down_since = None
        broken = daemon_failing()
        if broken is not None:
            say_waiting(failing_message(broken))
            return EXIT_DOWN
        now = time.monotonic()
        if now - touched >= TOUCH_EVERY:
            for key in keys.values():
                register(key, consumer=consumer)
            touched = now
        served, missing = {}, []
        for sha, key in keys.items():
            entry = read_cache(key)
            data, fresh = head_served(entry, time.time(), max_age)
            if entry and entry.get("missing") and not data:
                missing.append(sha)
            elif data is not None:
                served[sha] = (data, fresh, entry.get("dataAt"))
        ledger = (read_json(BASE / CONSUMERS_FILE) or {}).get("consumers", {}).get(consumer) or {}
        spent = (ledger.get("deniedAt") or 0) >= began - 1
        settled_for_now = all(sha in served and served[sha][1] or sha in missing for sha in keys)
        if settled_for_now or time.monotonic() - start >= wait or (spent and all(
                sha in served or sha in missing or spent for sha in keys)):
            break
        time.sleep(min(WAIT_FILE_POLL, max(0.1, wait - (time.monotonic() - start))))
    heads, unread = {}, {}
    for sha in keys:
        if sha in served:
            data, fresh, at = served[sha]
            heads[sha] = {"found": data.get("found", {}), "ids": data.get("ids", {}), "settled": bool(data.get("settled")),
                          "statusStates": data.get("statusStates", {}), "at": at, "stale": not fresh}
        elif sha in missing:
            unread[sha] = "no such commit"
        else:
            unread[sha] = "budget spent" if spent else "not read yet"
    partial = bool(unread) or any(h["stale"] for h in heads.values())
    out = {"consumer": consumer, "heads": heads, "unread": unread,
           "budget": {"spent": ledger.get("spent"), "limit": ledger.get("limit"), "denied": spent}}
    if as_json:
        print(json.dumps(out, sort_keys=True))
    else:
        for sha, h in heads.items():
            red = sorted(k for k, (st, co) in h["found"].items() if st == "completed" and co not in ("success", "neutral", "skipped"))
            note = ("stale, " if h["stale"] else "") + ("settled" if h["settled"] else "checks running") + f", {age(h['at'])}"
            print(f"{sha[:12]}: {len(h['found'])} checks, {note}" + (f"; not green: {', '.join(red[:6])}" if red else ""))
        for sha, why in unread.items():
            print(f"{sha[:12]}: unread ({why})")
    return EXIT_PARTIAL if partial else EXIT_OK


def parse_since(text: str | None, began: float) -> tuple[int | None, float | None]:
    """(comment id, epoch): a comment id or URL, an ISO time, or a duration back from now (10m)."""
    if not text:
        return None, began
    text = text.strip()
    match = re.fullmatch(r"(?:https://github\.com/\S*#issuecomment-)?(\d+)", text)
    if match:
        return int(match.group(1)), None
    match = re.fullmatch(r"(\d+)([smhd])", text)
    if match:
        return None, began - int(match.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]
    at = iso_epoch(text) if re.match(r"\d{4}-\d\d-\d\d", text) else None
    if at is None:
        raise WatchError(f"--since must be a comment id or URL, an ISO time (2026-09-25T18:00:00Z) or a "
                         f"duration such as 10m, not {text!r}")
    return None, at


def login(name: str | None) -> str:
    """GraphQL names the Actions bot `github-actions`, REST and the web `github-actions[bot]`."""
    return re.sub(r"\[bot\]$", "", str(name or "").strip().lower().removeprefix("app/"))


def outbox_edits() -> frozenset:
    """The comment ids the outbox edited in place (POST_EDITS)."""
    edits = read_json(BASE / POST_EDITS)
    return frozenset(x for x in edits if isinstance(x, int)) if isinstance(edits, list) else frozenset()


def comment_matches(c: dict, author: str | None, pattern: re.Pattern | None, since_id: int | None,
                    since_time: float | None, edited_ids: set | frozenset = frozenset()) -> bool:
    """A comment the outbox edited in place (a writer's status, POST_STATUS_MAX; its ids in EDITED_IDS) was said
    again when it was edited, so a wait that began before the edit, or names that comment, sees the new text.
    Anyone else's edit (a typo fix, a ticked box, a bot's sticky comment) is not a new comment."""
    edited = iso_epoch(c.get("editedAt")) if c.get("editedAt") and c.get("id") in edited_ids else None
    if since_id is not None and (c.get("id") or 0) <= since_id:
        # `--since` this very comment: an outbox edit of it is newer than it, whenever the wait began. An older one's
        # edit is not (the outbox edits a comment only while it is the thread's last, so before the named one).
        if edited is None or (c.get("id") or 0) < since_id:
            return False
    if since_time is not None and max(iso_epoch(c.get("createdAt")) or 0, edited or 0) < int(since_time):
        return False
    if author and login(c.get("author")) != login(author):
        return False
    return not pattern or bool(pattern.search(str(c.get("body") or "")))


def cmd_wait_comment(target: str, timeout: float, as_json: bool, author: str | None = None,
                     match: str | None = None, since: str | None = None) -> int:
    """Wait for a comment on an issue or PR by `author` whose body matches `match`, posted after
    `since` (by default after this wait began). Exits 0 with the comment, 1 when the issue does not
    exist, 2 on timeout."""
    key = parse_key("comment", target)
    try:
        pattern = re.compile(match) if match else None
    except re.error as error:
        raise WatchError(f"--match is not a regular expression: {error}") from None
    began, start = time.time(), time.monotonic()
    say_waiting(waiting_line(key, "a comment" + (f" by {author}" if author else "")
                             + (f" matching {match}" if match else ""), None, True, timeout))
    since_id, since_time = parse_since(since, began)
    touched = -TOUCH_EVERY
    warned = False
    down, down_since = DownWait(), None
    _, owner, repo, number = split_key(key)
    name = f"{owner}/{repo}#{number}"
    while True:
        if not daemon_running(grace=DOWN_GRACE):
            down_since = time.monotonic() if down_since is None else down_since
            if not down.patient(down_since, start, timeout):
                return EXIT_DOWN
            time.sleep(WAIT_POLL)
            continue
        down_since = None
        broken = daemon_failing()
        if broken is not None:
            say_waiting(failing_message(broken))
            return EXIT_DOWN
        lag = daemon_stale()
        if lag is not None and not warned:
            say_waiting(stale_message(lag))
            warned = True
        now = time.monotonic()
        if now - touched >= TOUCH_EVERY:
            register(key)
            touched = now
        entry = read_cache(key)
        waited = int(now - start)
        if entry and (entry.get("fetchedAt") or 0) >= began and not entry.get("data") and entry.get("missing"):
            emit(key, entry, as_json, {"result": "failure", "waited_s": waited})
            return EXIT_FAIL
        comments = ((entry or {}).get("data") or {}).get("comments") or []
        edits = outbox_edits()
        found = next((c for c in comments if comment_matches(c, author, pattern, since_id, since_time, edits)),
                     None)
        if found:
            if as_json:
                print(json.dumps({"key": key, "result": "success", "waited_s": waited, "comment": found,
                                  "url": (entry.get("data") or {}).get("url")}, sort_keys=True))
            else:
                body = str(found.get("body") or "").splitlines()
                print(f"{name}: comment {found.get('id')} by {found.get('author')} at {found.get('createdAt')}")
                print(found.get("url") or "")
                for line in body[:40]:
                    print(f"  {line}")
                if len(body) > 40:
                    print(f"  ... {len(body) - 40} more lines")
                print(f"result: success\nwaited_s: {waited}")
            return EXIT_OK
        if now - start >= timeout:
            newer = sum(1 for c in comments if comment_matches(c, None, None, since_id, since_time, edits))
            where = "since the wait began" if not since else f"after {since}"
            hint = "; to include a reply posted before the wait, pass --since with your own comment's URL" if not since else ""
            emit(key, entry, as_json, {"result": "timeout", "waited_s": waited,
                                       "note": f"{newer} comments {where}, none matched{hint}"})
            return EXIT_TIMEOUT
        time.sleep(min(WAIT_POLL, max(0.1, timeout - (now - start))))


def controller_line(ctl: dict) -> str:
    state = ctl.get("state")
    scope = "" if ctl.get("token") else ", public repos only (no token)"
    if state == "ok":
        return (f"controller: webhook events ok, {ctl.get('runs', 0)} watched runs from it, last delivery "
                f"{age(iso_epoch(ctl.get('lastDelivery')))}{scope}")
    if state in {"down", "absent"}:
        why = "no run-events receiver there" if state == "absent" else f"unreachable ({ctl.get('error')})"
        return f"controller: {why}; polling GitHub meanwhile, next try in {max(0, int((ctl.get('retryAt') or 0) - time.time()))}s"
    if state == "off":
        return "controller: none configured; polling GitHub"
    return "controller: starting"


def spend_lines(spend: Any) -> list[str]:
    """`budget`'s spend tables from daemon.json spendBy (Daemon.spend_by)."""
    if not isinstance(spend, dict):
        return []
    rest, gql = spend.get("rest") or {}, spend.get("graphql") or {}
    out = [f"spend by path, last {int(spend.get('window') or 3600) // 60} min: {rest.get('counted', 0)} counted REST "
           f"of {rest.get('requests', 0)} sent (304s and rate_limit are free), {gql.get('points', 0)} GraphQL points "
           f"in {gql.get('queries', 0)} queries ({SPEND_FILE})"]
    for r in spend.get("restByRoute") or []:
        held = f"; waiter {r['topWaiter']} {r.get('topWaiterCounted', 0)}" if r.get("topWaiter") else ""
        out.append(f"  REST {r.get('counted', 0):>5} of {r.get('requests', 0):>5}  {r.get('route')}  "
                   f"(most: {r.get('topCaller') or '?'} {r.get('topCallerCounted', 0)}; {r.get('callers', 0)} callers{held})")
    for r in spend.get("restByCaller") or []:
        out.append(f"  REST {r.get('counted', 0):>5} of {r.get('requests', 0):>5}  {r.get('route')}  "
                   f"by {r.get('kind')} {r.get('repo') or ''}".rstrip() + waiters_text(r, "counted"))
    for r in spend.get("graphqlByQuery") or []:
        out.append(f"  GraphQL {r.get('points', 0):>5} points in {r.get('queries', 0):>4}  {r.get('query')}  "
                   f"by {r.get('kind')} {r.get('repo') or ''}".rstrip() + waiters_text(r, "points"))
    return out


def cmd_budget(as_json: bool) -> int:
    running = daemon_running(grace=DOWN_GRACE)
    budget = read_json(BASE / "budget.json") or {}
    status = read_json(BASE / "daemon.json") or {}
    lag = daemon_stale() if running else None
    broken = daemon_failing() if running else None
    watching = len(list(watch_dir().glob("*.json"))) if watch_dir().is_dir() else 0
    if as_json:
        print(json.dumps({"daemon": running, "stale": lag is not None, "failing": broken is not None,
                          "budget": budget, "watching": watching, "last": status}, sort_keys=True))
    else:
        print(f"daemon: {'running' if running else 'NOT RUNNING'}, watching {watching}, "
              f"last heartbeat {age(status.get('at'))}")
        for bucket in ("rest", "graphql"):
            b = budget.get(bucket)
            if not b:
                print(f"{bucket:<8} not seen yet")
                continue
            reset = b.get("reset")
            when = dt.datetime.fromtimestamp(reset, dt.timezone.utc).strftime("%H:%M:%SZ") if reset else "?"
            rate = (status.get("perMinute") or {}).get(bucket)
            spend = f", {rate}/min to spend until then" if isinstance(rate, (int, float)) and rate >= 0 else ""
            print(f"{bucket:<8} {b.get('remaining')}/{b.get('limit')} left, resets {when}{spend}, seen {age(b.get('seenAt'))}")
            counters = rest_counters(budget) if bucket == "rest" else []
            if len(counters) > 1:
                print("         core counters (the poorest is the one above): " + "; ".join(
                    f"{c['remaining']}/{c.get('limit')} until "
                    f"{dt.datetime.fromtimestamp(c['reset'], dt.timezone.utc).strftime('%H:%M:%SZ')}" for c in counters))
        paths, reads = status.get("paths"), status.get("reads")
        if isinstance(paths, dict):
            name = {"graphql": "GraphQL", "rest": "REST"}
            print("reading: " + ", ".join(f"{label} over {name.get(paths.get(kind), '?')}" for kind, label in
                                          (("pr", "PRs"), ("run", "runs"), ("comment", "comments")))
                  + " (each goes to the richer bucket for the time left until its reset)")
            if isinstance(reads, dict):
                print("reads in the last hour: " + "; ".join(
                    f"{label} {(reads.get(kind) or {}).get('graphql', 0)} GraphQL / {(reads.get(kind) or {}).get('rest', 0)} REST"
                    for kind, label in (("pr", "PRs"), ("run", "runs"), ("comment", "comments"), ("head", "heads"))
                    if kind in reads))
        oldest = status.get("oldestData")
        if isinstance(oldest, dict):
            def span(v: Any) -> str:
                return "-" if not isinstance(v, (int, float)) else f"{int(v)}s" if v < 120 else f"{int(v // 60)}m"
            batch = status.get("batch") or {}
            print("oldest data of an open watch: " + ", ".join(
                f"{label} {span(oldest.get(kind))}" for kind, label in (("pr", "PRs"), ("run", "runs"), ("comment", "comments")))
                  + f" (GraphQL batch: {batch.get('pr', '?')} PRs, {batch.get('run', '?')} runs, "
                    f"{batch.get('comment', '?')} comment watches per query)")
        ledger = read_json(BASE / CONSUMERS_FILE)
        if isinstance(ledger, dict) and ledger.get("consumers"):
            print("head-read budget per hour (glaeda-gh checks --consumer NAME): " + "; ".join(
                f"{name} {c.get('spent', 0)}/{c.get('limit', '?')}{' reserved' if c.get('reserved') else ''}"
                + (f", refused {age(c['deniedAt'])}" if c.get("deniedAt") else "")
                for name, c in sorted(ledger["consumers"].items())))
        ctl = status.get("controller")
        if isinstance(ctl, dict):
            print(controller_line(ctl))
        hour = status.get("lastHour")
        if isinstance(hour, dict):
            print(f"daemon requests in the last hour: {hour.get('rest', 0)} REST, {hour.get('rest304', 0)} more "
                  f"REST answered 304 (free), {hour.get('graphql', 0)} GraphQL, "
                  f"{hour.get('free', 0)} rate_limit reads (free), {hour.get('write', 0)} REST for queued writes")
        share = status.get("restShare")
        if isinstance(share, dict):
            print(f"daemon REST spend {share.get('spent', '?')}/{share.get('cap', '?')} this hour "
                  f"(restShare {share.get('share', '?')}"
                  + ("; at the cap, so REST is lean and PRs and runs read over GraphQL)" if share.get("capped") else ")"))
        for line in spend_lines(status.get("spendBy")):
            print(line)
        for name, alarm in sorted((status.get("alarms") or {}).items()):
            if isinstance(alarm, dict) and not alarm.get("cleared"):
                print(f"alarm {name} ({alarm.get('level')}, sent {age(alarm.get('at'))}): {alarm.get('text')}")
        if status.get("errors"):
            print("last errors: " + "; ".join(status["errors"][:3]))
    if not running:
        say_waiting(down_message())
        return EXIT_DOWN
    if broken is not None:
        say_waiting(failing_message(broken))
        return EXIT_DOWN
    if lag is not None:
        say_waiting(stale_message(lag))
        return EXIT_DOWN
    return EXIT_OK


# ---------------------------------------------------------------- the gh broker
#
# `glaeda-gh gh ARG...` stands in front of the real `gh`. Every agent session on the account shares
# one 5000/h REST pool and one 5000/h GraphQL pool, and `gh` itself has no cache and no idea what
# the other sessions are doing: measured over 96,102 logged calls on one host, 22% of them re-read
# something another session had read within the previous 90 seconds and 7.5% read repository source
# through the API. The broker does four things and nothing else:
#
#   serve   `pr view --json` and `run view --json` from the daemon's cache when it is fresh enough
#           and covers every field asked for. The daemon already reads those in one batched query
#           for every watched PR at once, over whichever bucket is richer.
#   refuse  reading a repository's source through the API (contents, git/blobs, git/trees) when
#           that repository is checked out on this host. `git show` answers for nothing.
#   pass    everything else, unchanged: mutations, logs, anything unrecognised, and any read the
#           cache cannot cover completely.
#   route   a `pr view`/`run view` miss whose own bucket (GraphQL for pr view, REST for run view) is
#           spent while the other is not: registered with the daemon, which reads it over the
#           other bucket, and served from that read if it lands within BROKER_SPENT_WAIT.
#
# Serving is deliberately timid, because a wrong answer is far worse than a spent request. A call
# is served only when every flag on it is one of a short per-subcommand list: an unknown flag means
# the broker does not know what the caller asked for, so it does not answer. `gh run view ID
# --attempt 2` and `--exit-status` are the shape of that hazard -- the cache holds the latest
# attempt and always exits 0, so answering either would be wrong, and they pass through instead.
#
# A second read of the same target within BROKER_REPEAT seconds registers a watch, so the daemon
# starts covering it and the third read is free; a target read once is never watched. A read that
# is about to spend a request on something this caller just read is held for
# CMUX_GH_MIN_REPEAT_SECONDS first -- the cmuxterm-hq PATH guard's rule, applied here because only
# this side knows whether the call costs anything; a served read never waits. Every path
# fails open: an error anywhere in the broker execs the real `gh`, because a wrapper around `gh` is
# never allowed to be the reason a call fails. A refusal exits 2, and GLAEDA_GH_ALLOW_API_SOURCE=1
# passes one of those through. Exit 127 is the broker's own refusal to run: no real gh on PATH,
# a chain that has been through here BROKER_MAX_HOPS times, or an exec that failed.

BROKER_MAX_AGE = 90.0  # cache entries older than this are not served (the daemon's cycle is 60 s)
BROKER_LEAN_AGE = 600.0  # below the floor, stale data beats spending the last of the quota
BROKER_REPEAT = 600.0  # a target read twice this far apart is worth watching
# The API gh itself spends on each brokered read: `pr view` is GraphQL, `run view` is REST. When
# that bucket is spent, a cache miss passed to gh is a 403, while the daemon can still read the same
# target over the other bucket (it reads each kind from whichever is richer). So the miss is handed
# to the daemon instead, and the call waits up to BROKER_SPENT_WAIT for its first read: a new watch
# is filled within one TICK.
BROKER_GH_BUCKET = {"pr": "graphql", "run": "rest"}
BROKER_SPENT_WAIT = 15.0
BROKER_SEEN_KEEP = 2000  # targets remembered for repeat detection
BROKER_LOG_MAX = 8 * 1024 * 1024  # the decision log is rotated once past this
# The call log is rotated too, and far later: it is the audit's whole input, and the audit reads
# the rotated file as well, so the window it reports spans a rotation. Uncapped it reached 117 MB
# on cosmic-gray, and nothing was ever going to shorten it.
GUARD_LOG_MAX = 64 * 1024 * 1024
BROKER_EXIT_REFUSED = 2
BROKER_EXIT_NO_GH = 127
# What `glaeda-gh gh --probe` answers with. A wrapper in front of gh delegates only to a broker
# that passes the probe, so everything in this block is part of one contract: serving, the
# refusal, the hop count, the shared log line, and the repeat delay below. Bump it when any of
# those changes in a way a wrapper can see: the log line's shape, the meaning of an exit code, the
# env vars read or exported across the hand-off, or the probe's own output. Adding a served field
# or a refused path does not need a bump -- a wrapper cannot tell.
BROKER_CONTRACT = 2  # 2: the hand-off env changed (see BROKER_MARK, BROKER_DEPTH)
BROKER_MARK = "GLAEDA_GH_BROKERED"  # "count:pid" -- this call's own history, across an exec
BROKER_MIN_REPEAT = 30.0  # seconds between two identical reads that would each spend quota
BROKER_MAX_HOPS = 2  # this broker, plus one wrapper it could not recognise. Past that, refuse.
# Two counters, because a wrapper loop comes in two shapes and one counter cannot bound both.
#
# BROKER_MARK is scoped to a pid: an exec keeps the pid, so a call handed straight back here still
# carries its own history, while a `gh` that gh *spawns* (an extension, an alias, a $EDITOR hook)
# starts a fresh call rather than inheriting its parent's count and eventually being refused for a
# loop that does not exist. That is what it is for, and it is why it cannot bound the other shape:
# a wrapper that *forks* `gh` instead of exec'ing it gets a new pid every generation, so a
# pid-scoped count resets to one forever and the chain never ends.
#
# BROKER_DEPTH is therefore unscoped and counts generations whatever the wrapper does. The bound is
# loose on purpose: a real extension or editor chain is two or three deep and must never notice it,
# while a loop reaches it in under a second.
#
# Both counters live in the environment, so neither survives a wrapper that clears it: with a `gh`
# on PATH whose body is `exec env -i PATH="$PATH" gh "$@"` -- the shape of `sudo -i` or a
# login-shell wrapper -- the chain ran as long as it was left alone, every generation reporting
# mark=1 depth=1. That is not a hole in the counters; no env-carried count can cross `env -i`. It
# is a limit worth stating rather than claiming these two bound every chain. Nothing env-carried
# closes it -- the hq guard's own CMUX_GH_GUARD_DEPTH is cleared by the same wrapper -- so what
# would is a mark in the state dir, keyed by caller and wall clock. Not built: a wrapper that
# sanitises the environment around `gh` has not been seen on these hosts, and the two counters
# cover both shapes that have.
BROKER_DEPTH = "GLAEDA_GH_DEPTH"
BROKER_MAX_DEPTH = 8
BROKER_REPOS_TTL = 600.0
# How long the checkout scan behind the refusal may take. It is the one thing here that walks the
# filesystem, it runs in front of a real gh call, and 2.4 s cold on 6566 directories is the good
# case -- a root on a hung mount is the bad one. Generous enough that the scan normally finishes.
BROKER_SCAN_DEADLINE = 5.0
BROKER_ROOTS = ("~/Projects", "~/wt", "~/.cmux/worktrees")
# Long flags that take a separate value. Only needed to keep that value out of the positional
# words; a flag not on the safe list below stops the call from being served either way.
BROKER_VALUE_FLAGS = {
    "-R", "--repo", "-X", "--method", "-H", "--header", "-F", "--field", "-f", "--raw-field",
    "-q", "--jq", "-t", "--template", "--json", "--input", "--cache", "--hostname", "--interval",
    "-L", "--limit", "-B", "--base", "--head", "-S", "--search", "--state", "--author",
    "--assignee", "--label", "-l", "-b", "--body", "--body-file", "--title", "--attempt", "--job",
}
# Short flags whose value may be glued on (`-Ro/r`) as well as separate. Cobra accepts both, and
# reading `-Ro/r` as a positional word once served another repository's PR under its number. Taken
# from the list above rather than written out again, so the two cannot disagree.
BROKER_SHORT_VALUE = "".join(sorted(f[1] for f in BROKER_VALUE_FLAGS if len(f) == 2))
# A short flag and the long spelling of the same flag, so a later one wins as cobra has it
# (`-R a/b --repo c/d` is c/d) and the safe list below can name one spelling.
BROKER_FLAG_ALIAS = {"-R": "--repo", "-X": "--method"}
# The only flags a served call may carry. Anything else -- `--jq`, `--template`, `--web`,
# `--attempt`, `--job`, `--exit-status`, or a flag gh adds next year -- means pass it on.
BROKER_SAFE_FLAGS = {"--repo", "--json"}
# Not github.com: the daemon's cache is github.com's, and an enterprise host has its own PR 7.
BROKER_GITHUB_HOSTS = {"github.com", "www.github.com", "api.github.com"}
# gh `pr view --json FIELD` -> (key in a cached PR entry, the Go type gh prints it as). gh renders a
# null string field as "", and a null time as null.
#
# A field is here only when every source the daemon reads a PR from fills it. A PR entry has two
# writers (fetch_pr_rest and the GraphQL read behind fetch_aliased) and a run entry has three, and
# some of them leave a key None to mean "this source does not carry it", which is not the same as
# GitHub answering null: serving the second as the first prints a confident wrong answer. `reviewDecision` is the dangerous one -- fetch_pr_rest keeps GraphQL's
# last value (REST has no equivalent), so it is None until some GraphQL read fills it, and stale
# afterwards however fresh `dataAt` looks. Printing "" there says "nobody has reviewed this" for a
# PR that is CHANGES_REQUESTED, which is exactly the answer a lane must not get wrong.
BROKER_PR_FIELDS = {
    "number": ("number", "int"), "url": ("url", "str"), "title": ("title", "str"),
    "state": ("state", "str"), "isDraft": ("isDraft", "bool"), "mergeable": ("mergeable", "str"),
    "mergeStateStatus": ("mergeStateStatus", "str"), "headRefOid": ("headRefOid", "str"),
    "headRefName": ("headRefName", "str"),
    "updatedAt": ("updatedAt", "time"), "mergedAt": ("mergedAt", "time"),
}
# gh `run view --json FIELD` -> the same, over slim_run's REST names. Four are missing for the
# reason above. REST's `name` is the run-name when a workflow sets one and GraphQL's is the
# workflow name, so `name` and `workflowName` could not be answered consistently; and
# `controller_run` has no `display_title` or `created_at` in the webhook record and an empty
# `head_branch` when the delivery omits it, so `displayTitle`, `createdAt` and `headBranch` are
# None or "" for any run the controller's feed is tracking.
BROKER_RUN_FIELDS = {
    "databaseId": ("id", "int"),
    "status": ("status", "str"), "conclusion": ("conclusion", "str"), "url": ("html_url", "str"),
    "headSha": ("head_sha", "str"), "event": ("event", "str"),
    "attempt": ("run_attempt", "int"),
    "updatedAt": ("updated_at", "time"),
}
# What automation pivots on: a push, a rerun, a merge or a ready-for-review changes these, and
# acting on a stale one means waiting on a superseded head, calling a run green, or reading a
# merged PR as open. The lean horizon never covers them. `updatedAt` is the mutation clock itself,
# so anything using it as a change detector would be told "nothing changed" for the whole horizon.
BROKER_LIVE_FIELDS = {"headRefOid", "conclusion", "status", "state", "attempt",
                      "mergeStateStatus", "mergeable", "mergedAt", "isDraft", "updatedAt"}
# The other half of the same decision, and the reason it is written down rather than implied: a
# served field that is in neither set is served stale under the lean horizon, and nothing noticed.
# Adding `merged` to BROKER_PR_FIELDS and leaving it unclassified served `{"merged": false}` from
# a ten-minute-old entry for a PR that had merged, with every test green. A test asserts these two
# sets cover the tables exactly, so a new served field cannot be added without classifying it.
# Stable means a change here costs nothing a lane pivots on: a number and a URL are fixed for the
# life of the object, a run's event and head sha are fixed when it is created, and a title or a
# branch name read a few minutes late is not an answer anything acts on.
BROKER_STABLE_FIELDS = {"number", "url", "title", "headRefName", "databaseId", "headSha", "event"}
BROKER_SOURCE_RE = re.compile(
    rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/(contents/|git/(?:blobs|trees)/)")
BROKER_RAW_RE = re.compile(rf"^https?://raw\.githubusercontent\.com/({NAME})/({NAME})/")
# github.com has to be the *host* of the URL, not a substring of it. Unanchored, this read
# `https://notgithub.com/o/r`, `https://gitlab.com/mirror/github.com/o/r` and
# `/srv/mirrors/github.com/o/r` as github.com's `o/r` -- a mirror's checkout offered as the
# upstream repository's, which is the one thing broker_repo's one-remote rule exists to prevent.
# The two forms are a URL with a scheme and git's scp-like `[user@]host:path`; a userinfo part
# (`https://user:token@github.com/o/r`) belongs to either.
# Split in two, because matching the whole URL in one pattern could only answer "understood" or
# "not mine", and those are different answers: a github URL whose shape is not understood has to
# poison the whole config (see broker_remotes), while another forge's is simply skipped.
# The userinfo part runs to the *last* `@` of the authority, and the host holds none: with the
# userinfo stopping at the first `@` and the host group permitting one,
# `https://user@name@github.com/cli/cli` read its host as `name@github.com`, which is not github's,
# so the remote was skipped -- and a skipped remote is a subset, which is what broker_remotes
# exists to prevent. An embedded-credential remote whose password contains `@` is all it takes.
# git hands the whole authority to curl or to ssh, both of which take the last `@` (measured: git
# 2.53.0 runs `ssh ... a@b@github.com` for `ssh://a@b@github.com/o/r`), and gh parses it with
# net/url, which does the same.
BROKER_URL_HOST_RE = re.compile(r"^(?:https?|git|ssh)://(?:[^/\s]*@)?([^/:@\s]+)(?::\d+)?(/.*)?$",
                                re.IGNORECASE)
# The scp-like form splits at the first colon, so its userinfo cannot cross one: for
# `user:pw@github.com:o/r` git runs `ssh user git-upload-pack 'pw@github.com:o/r'` -- the host is
# `user` and github.com is part of the path. Reading that as github's `o/r` would serve a
# repository git does not even clone from.
BROKER_SCP_HOST_RE = re.compile(r"^(?:[^/:\s]*@)?([^/:@\s]+):(.*)$")
BROKER_REPO_PATH_RE = re.compile(rf"^({NAME})/({NAME}?)(?:\.git)?/?$")
# Hosts whose `OWNER/REPO` the daemon's github.com cache answers for. `api.github.com` is in
# BROKER_GITHUB_HOSTS because gh's hosts.yml names it; it is not a clone host, so a remote
# pointing there is a shape we do not understand rather than one we serve.
BROKER_REMOTE_HOSTS = {"github.com", "www.github.com"}
# A git config is read by section, not scanned: see git_config_remote_urls. git accepts a key on
# the header's own line (`[remote "origin"] url = ...`), so group 3 is whatever follows the header,
# and the subsection may be quoted (`[remote "origin"]`) or dotted (`[remote.origin]`).
GIT_CONFIG_HEADER_RE = re.compile(r'^\[([^]"]*?)(?:\s+"((?:[^"\\]|\\.)*)")?\]\s*(.*)$')
GIT_CONFIG_SECTION_NAME_RE = re.compile(r"[A-Za-z0-9-]+")
# A key with no value is valid git (`[core] bare`), and is never a url.
GIT_CONFIG_KEY_RE = re.compile(r"^([A-Za-z][A-Za-z0-9-]*)\s*(?:=\s*(.*))?$")
GIT_CONFIG_ESCAPES = {"n": "\n", "t": "\t", "b": "\b", '"': '"', "\\": "\\"}
# GitHub's own credential shapes, never written to the shared log whatever slot they arrived in
BROKER_SECRET_RE = re.compile(r"gh[posur]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}", re.IGNORECASE)
# How long git may take to say what this checkout's remotes are. Two forks in front of a real gh
# call, so it is bounded like everything else here: a checkout on a hung mount declines, which
# costs one request, rather than hanging the call. Tighter than SUBPROCESS_DEADLINE because nothing
# is waiting on the answer except a decision to decline.
BROKER_GIT_DEADLINE = 5.0


def guard_log() -> Path:
    """The PATH guard's call log (cmuxterm-hq tools/local-build-guards/gh), so one audit covers
    every host. The guard writes it only when it has no broker to hand the call to; with the broker
    installed the broker is the one writer, and there is one format to read."""
    return Path(os.environ.get("CMUX_GH_LOG") or Path.home() / ".local/state/cmux-gh/calls.log")


def broker_log() -> Path:
    return BASE / "broker.jsonl"


def broker_seen_path() -> Path:
    return BASE / "broker-seen.json"


def broker_repos_path() -> Path:
    return BASE / "broker-repos.json"


def broker_words(args: list[str]) -> tuple[list[str], str, set[str], dict[str, str]]:
    """(positional words, HTTP method, flags present, flag values).

    A flag that takes a value consumes it, separately (`-R o/r`, `--json state`), glued
    (`-Ro/r`, `-XPOST`) or with `=` (`--json=state`), so no value is ever read as a positional
    word. A value flag given no value at all (`gh pr view 7 --json`, which gh rejects) is recorded
    as present with no value, so the call is never served. `flags present` names every flag seen,
    by its canonical spelling, including ones this does not know: the caller decides what to do
    about those."""
    words, method, seen, values = [], "GET", set(), {}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            words.extend(args[i + 1:])
            break
        if arg.startswith("--") and "=" in arg:
            name, value = arg.split("=", 1)
            name = BROKER_FLAG_ALIAS.get(name, name)
            seen.add(name)
            values[name] = value
        elif arg.startswith("--"):
            name = BROKER_FLAG_ALIAS.get(arg, arg)
            seen.add(name)
            if arg in BROKER_VALUE_FLAGS:
                if i + 1 < len(args):
                    values[name] = args[i + 1]
                    i += 1
                else:
                    # No value at all, so gh exits 1. An earlier occurrence's value must not stand
                    # in for it (`--json state ... --json`), or the broker answers a line gh rejects.
                    values.pop(name, None)
        elif arg.startswith("-") and arg != "-":
            short, glued = arg[:2], arg[2:]
            name = BROKER_FLAG_ALIAS.get(short, short)
            seen.add(name)
            if glued and short[1] in BROKER_SHORT_VALUE:
                values[name] = glued
            elif glued:
                seen.update(BROKER_FLAG_ALIAS.get(f"-{c}", f"-{c}") for c in glued)  # `-abc`
            elif short in BROKER_VALUE_FLAGS:
                if i + 1 < len(args):
                    values[name] = args[i + 1]
                    i += 1
                else:
                    values.pop(name, None)  # `-R o/r ... -R`: gh exits 1, so never serve it
        else:
            words.append(arg)
        i += 1
    if "--method" in values:
        method = values["--method"]
    elif {"-f", "--raw-field", "-F", "--field", "--input"} & seen:
        method = "POST"  # gh POSTs when it is given fields or a body, with no -X on the line
    return words, method.upper(), seen, values


def broker_local_repos(now: float | None = None) -> dict[str, str]:
    """owner/repo (lowercased) -> a checkout of it on this host. Built from the GitHub remote in each
    checkout's config under BROKER_ROOTS, at most two levels deep, and cached for BROKER_REPOS_TTL."""
    now = time.time() if now is None else now
    cached = read_json(broker_repos_path())
    if isinstance(cached, dict) and now - (cached.get("at") or 0) < BROKER_REPOS_TTL:
        found = cached.get("repos")
        if isinstance(found, dict):
            return found
    roots = [Path(p).expanduser() for p in
             (os.environ.get("GLAEDA_GH_REPO_ROOTS") or os.pathsep.join(BROKER_ROOTS)).split(os.pathsep) if p]
    found: dict[str, str] = {}
    # Bounded, because this runs in front of a real gh call. Two levels under three roots is 6566
    # candidate directories on this host and 2.4 s cold, each one a config read, and the TTL cache
    # bounds how *often* that happens but not how long it takes: a root on a hung mount hung the
    # call. This was the only step in the brokered path with no deadline, in a file that bounds
    # everything else. On expiry the partial map is used and not cached, so the next call tries
    # again -- and a map that is missing a repo only means the refusal declines and gh runs, which
    # is the safe direction.
    complete = True
    # Two bounds for one deadline, because each covers what the other cannot. The clock check
    # bounds the *loop* and works everywhere, including off the main thread where hard_deadline is
    # a documented no-op; SIGALRM is what interrupts a single read that is already blocked on a
    # hung mount, which no amount of checking between reads can reach. ScanDeadline rather than
    # DeadlineTimeout because this block's own frames catch OSError -- see ScanDeadline.
    deadline = time.monotonic() + BROKER_SCAN_DEADLINE
    try:
        with hard_deadline(BROKER_SCAN_DEADLINE, ScanDeadline):
            for root in roots:
                for depth in (1, 2):
                    try:
                        candidates = list(root.glob("/".join(["*"] * depth)))
                    except OSError:
                        continue
                    for d in candidates:
                        if time.monotonic() >= deadline:
                            raise ScanDeadline(f"no complete scan within {BROKER_SCAN_DEADLINE:g}s")
                        for owner_repo in broker_remotes(d):
                            if broker_better_checkout(d, found.get(owner_repo), owner_repo):
                                found[owner_repo] = str(d)
    except ScanDeadline:
        complete = False
    if complete:
        write_json(broker_repos_path(), {"at": now, "repos": found})
    return found


def broker_better_checkout(candidate: Path, current: str | None, owner_repo: str) -> bool:
    """Which checkout of `owner_repo` to name in a refusal. Glob order is arbitrary, and a host has
    many: the one whose directory is the repository's own name is the one the reader means, and
    failing that the shortest path (a clone, not a worktree or a one-off scratch copy)."""
    if current is None:
        return True
    name = owner_repo.split("/")[-1]
    return (candidate.name == name, -len(str(candidate))) > (Path(current).name == name, -len(current))


def git_config_text(checkout: Path) -> str | None:
    """A checkout's config file text. A worktree's `.git` is a file naming the common directory,
    where the config actually lives."""
    dot = checkout / ".git"
    try:
        if dot.is_dir():
            config = dot / "config"
        elif dot.is_file():
            gitdir = dot.read_text(errors="replace").strip()
            if not gitdir.startswith("gitdir:"):
                return None
            target = Path(re.sub(r"/worktrees/[^/]+/?$", "", gitdir.split(":", 1)[1].strip()))
            # git resolves a relative gitdir against the directory holding the `.git` file, not
            # against the process's cwd -- and relative is the shape it writes for a submodule and
            # for `git worktree add --relative-paths`. Resolving it against cwd read another
            # checkout's config: `gitdir: ../real/.git` from `a/inner` answered `wrong/repo` where
            # git answers `right/repo`, so the broker could serve a different repository's PR.
            if not target.is_absolute():
                target = checkout / target
            config = target / "config"
        else:
            return None
        return config.read_text(errors="replace")
    except (OSError, ValueError):
        return None


def git_config_value(raw: str) -> str | None:
    """One git config value: quoted runs, backslash escapes, and an unquoted `#` or `;` ending it.

    None for text this cannot finish reading -- a trailing backslash (the value continues on the
    next physical line), an unterminated quote, an escape git has and this does not. See
    git_config_remote_urls for why that is not the same as an empty value."""
    out: list[str] = []
    # Whether each character came from inside quotes or from an escape. git trims the whitespace
    # around a value but keeps what quotes protect, and a flat `.strip()` kept neither apart, so
    # `url = "  https://github.com/me/cli"` read as `me/cli` where git's own value is
    # `  https://github.com/me/cli`.
    #
    # An earlier version of this comment said gh "does not recognise it as a github remote at all",
    # and that is false: measured, `git config --get remote.origin.url` keeps the spaces and gh
    # resolves `me/cli` anyway, because gh reads remotes from `git remote -v`, whose output is
    # whitespace-split -- the leading spaces are field separators gh never sees. So this is not a
    # case of the broker answering where gh would not. It is simply the value git holds, which is
    # what a reader of this text is entitled to, and the serve path no longer reads this text at
    # all (git_remotes). What it costs is one entry in the local index, so a refusal declines and
    # the call goes to gh: the safe direction, for a shape no real config has.
    protected: list[bool] = []
    quoted = False
    i = 0
    while i < len(raw):
        char = raw[i]
        if char == "\\":
            mapped = GIT_CONFIG_ESCAPES.get(raw[i + 1:i + 2])
            if mapped is None:
                return None
            out.append(mapped)
            protected.append(True)
            i += 2
            continue
        if char == '"':
            quoted = not quoted
        elif not quoted and char in "#;":
            break
        else:
            out.append(char)
            protected.append(quoted)
        i += 1
    if quoted:
        return None
    start, end = 0, len(out)
    while start < end and not protected[start] and out[start].isspace():
        start += 1
    while end > start and not protected[end - 1] and out[end - 1].isspace():
        end -= 1
    return "".join(out[start:end])


def git_config_remote_urls(text: str) -> list[str] | None:
    """The `remote.*.url` values of a git config, in file order, or None for a config this cannot
    read in full.

    Read by section, because scanning the text for a github.com URL matched things that are not
    remotes: `[submodule "x"] url = ...`, an `[url "..."] insteadOf = ...` rewrite rule, and a
    commented-out line. On big-red that put 81 repositories in the local index -- every submodule
    and vendored dependency of the cmux checkout among them -- so the broker refused
    `gh api /repos/manaflow-ai/homebrew-cmux/contents/...` and pointed the caller at a cmux
    worktree whose submodules are not initialised, where the advised `git show` cannot answer.
    It also meant `broker_repo()` saw ten "remotes" in any cmux checkout and so served nothing
    there, in the repository the fleet reads most.

    All-or-nothing, because the dangerous failure is not missing every remote, it is missing *one*.
    This used to claim that a config it did not understand "yields no remote, which is the safe
    direction"; the review that followed showed the claim was false, by construction: broker_repo()
    serves when it sees exactly one remote, so a parser that drops one of two remotes turns a
    decline into answering one repository's question with another's. A fork+upstream config written
    `[remote.upstream]`, or one byte-order mark in front of `[remote "origin"]`, did exactly that --
    the BOM case served the *upstream* as the checkout's repository. So anything not understood here
    -- an unclassifiable line, an `[include]` this would have to follow, a value that continues on
    the next line -- returns None, and the caller reads None as "no remote at all", so the local
    index declines to refuse. git's own parser accepts a key on the section-header line and skips a
    UTF-8 BOM, so this does both.

    All-or-nothing is still the rule here, but it is no longer what makes a *served* answer safe:
    being exact about a config this reads in full says nothing about the scopes it never opens, and
    the round that followed measured five more ways to a subset through this file alone. That is
    git_remotes' job now, and the index is allowed to be approximate because a wrong entry there
    only costs a request (broker_source_refusal confirms the one it is about to name)."""
    urls: list[str] = []
    section, subsection = "", ""
    for raw in text.removeprefix("\ufeff").splitlines():  # git skips one; without this the first [ is not a header
        line = raw.strip()
        while True:
            if not line or line[0] in "#;":
                break
            if line[0] == "[":
                header = GIT_CONFIG_HEADER_RE.match(line)
                if header is None:
                    return None
                name, quoted_sub, line = header.group(1).strip(), header.group(2), header.group(3).strip()
                if quoted_sub is not None:
                    section, subsection = name, quoted_sub
                else:  # the deprecated `[section.subsection]` form, which git still reads
                    section, _, subsection = name.partition(".")
                section, subsection = section.strip().lower(), subsection.strip()
                if not GIT_CONFIG_SECTION_NAME_RE.fullmatch(section):
                    return None
                if section in ("include", "includeif"):
                    # git reads the named file in here, so the remotes of this checkout are not all
                    # in this text. Reproduced: with an `[include]`d upstream remote, `git remote -v`
                    # shows two and this showed one, so the broker served the fork for both.
                    return None
                continue
            key = GIT_CONFIG_KEY_RE.match(line)
            if key is None:
                return None
            if key.group(2) is None:
                break  # a valueless key, which git reads as true and is never a url
            value = git_config_value(key.group(2))
            if value is None:
                return None  # including a continuation, whose next line is this value, not a key
            if section == "remote" and subsection and key.group(1).lower() == "url" and value:
                urls.append(value)
            break
    return urls


def broker_remote_target(url: str) -> tuple[str, str] | None:
    """(host lowercased, path without its leading slash) for a remote URL that names a host, or
    None for one that does not -- a local path, a relative remote, `file://`, anything unparseable.

    git reads `host:path` as scp-like syntax only when there is no `://` and nothing before the
    first colon is a slash, so `/srv/mirrors/a:b` is a path and `git@github.com:o/r` is a host."""
    # Not stripped here: git_config_value already trims the whitespace git trims and keeps what
    # quotes protect, and stripping again would undo exactly that distinction. The old pattern
    # ended `\s*$`, which is how a quoted trailing space got in.
    if "://" in url:
        match = BROKER_URL_HOST_RE.match(url)
        if match is None:
            return None
        path = match.group(2) or ""
    else:
        match = BROKER_SCP_HOST_RE.match(url)
        if match is None or "/" in url.split(":", 1)[0]:
            return None
        path = match.group(2)
    # Exactly one leading slash, never `lstrip`: `https://github.com//cli/cli` is not a URL whose
    # repository we can claim to know, and stripping both slashes would have turned it into one.
    return match.group(1).lower(), path[1:] if path.startswith("/") else path


def broker_remotes(checkout: Path) -> list[str]:
    """The owner/repo of every github.com remote in `checkout`'s config text, lowercased, in config
    order.

    For the local index only (broker_local_repos), which is a scan of thousands of candidate
    directories and so cannot afford a fork each. What a checkout's remotes *are* is git's answer,
    not this file's -- see git_remotes, which is what the serve path asks, and what confirms an
    index entry before a refusal names it. The two differ wherever a scope this text does not hold
    has something to say, and only the one that can serve a cached answer has to be exact.

    Empty for a config this cannot read *in full*, which is the same answer as "no github remotes
    here" on purpose: the caller declines on it.

    "In full" includes every github remote's URL, not only the file's syntax. An earlier cut read
    the config all-or-nothing and then silently skipped any URL its one pattern missed, which left
    a strict *subset* of the remotes git lists -- and a subset of two is one, which is exactly what
    broker_repo's one-remote rule acts on. Measured: a checkout with `git@github.com:me/cli.git`
    and `https://www.github.com/cli/cli` left `['me/cli']`, so the broker served the fork's PR 7
    from cache where gh resolves the base repository and answers the parent's. Same for
    `https://GITHUB.COM/cli/cli`, a query string, a doubled slash and an extra path segment. So a
    URL whose host is github's and whose shape is not understood now poisons the whole config."""
    text = git_config_text(checkout)
    if text is None:
        return []
    urls = git_config_remote_urls(text)
    if urls is None:
        return []
    found: list[str] = []
    for url in urls:
        if not broker_add_remote(url, found):
            return []
    return found


def broker_add_remote(url: str, found: list[str]) -> bool:
    """Add the owner/repo of `url` to `found` when it is a github.com remote. False for a github URL
    whose shape is not understood, which the caller must answer for with "no remotes known" -- never
    with the subset it did read (see broker_remotes)."""
    target = broker_remote_target(url)
    if target is None:
        return True  # not a URL with a host at all: another kind of remote, never ours
    host, path = target
    if host != "github.com" and not host.endswith(".github.com"):
        return True  # another forge, and `notgithub.com` is one of them
    match = BROKER_REPO_PATH_RE.match(path)
    if host not in BROKER_REMOTE_HOSTS or match is None:
        return False
    name = f"{match.group(1).lower()}/{match.group(2).lower()}"
    if name not in found:
        found.append(name)
    return True


def git_remote_repo(url: str) -> str | None:
    """`owner/repo`, lowercased, for a remote URL that is a github.com clone URL this understands,
    or None for every other URL -- another forge, another GitHub host, a local path, a shape it
    cannot read.

    git_remotes declines the whole checkout on a None (see there); only broker_remotes' index,
    where being approximate costs a request and nothing else, skips them."""
    target = broker_remote_target(url)
    if target is None:
        return None
    host, path = target
    match = BROKER_REPO_PATH_RE.match(path)
    if host not in BROKER_REMOTE_HOSTS or match is None:
        return None
    return f"{match.group(1).lower()}/{match.group(2).lower()}"


GIT_FILTER_RE = re.compile(r"\[[^\s\[\]]+\]")  # `[blob:none]`, `[tree:0]`, `[blob:limit=1m]`


def git_remotes(where: Path) -> list[str] | None:
    """The owner/repo of every github.com remote git lists for the repository at or above `where`,
    lowercased, or None when that cannot be known exactly -- no repository there, a config git
    refuses, a shape this does not understand, or a `gh-resolved` entry pointing gh at a repository
    this cannot see.

    Asked of git, because `<checkout>/.git/config` is not where the answer lives. gh resolves
    remotes by running `git remote -v` and `git config --get-regexp '^remote\\..*\\.gh-resolved$'`
    (observed under GH_DEBUG=api), and both compose every config scope and apply
    `url.<base>.insteadOf` rewriting. Reading the one file left a strict *subset* of the remotes git
    lists, and a subset of two is one, which is exactly what broker_repo's one-remote rule acts on.
    Measured against git 2.53.0 and gh 2.98.0, each one serving a fork's PR 7 where gh answers the
    upstream's:
      - `remote.upstream.url` set in `~/.gitconfig`, a scope this text read nothing of;
      - `url.<base>.insteadOf` in `~/.gitconfig`, which changes the host git uses. With
        `insteadOf = https://github.com/` pointing at a mirror, gh exits 1 ("none of the git remotes
        ... point to a known GitHub host") and the broker answered `cli/cli` with exit 0 -- inventing
        success where gh refuses, which is worse than a wrong repository;
      - `gh:cli/cli` with a global `insteadOf` making it a github URL, which this read as another
        forge's and skipped;
      - a remote with a `pushurl` and no `url`, which `git remote -v` lists and gh resolves;
      - `gh-resolved` written on the section-header line, or spelled `GH-Resolved`: git config keys
        are case-insensitive and a line-anchored case-sensitive pattern over the text saw neither.
    Two forks of git, weighed against one request out of the 5000/h every agent on this account
    shares, is the right trade. git missing or unrunnable is None, which is also what gh would have
    to answer: gh resolves repositories by running git too."""
    args = ["git", "-C", str(where)]
    try:
        # git walks up from here exactly as gh does. Looking only at the directory itself meant
        # `gh pr view 7` run from `repo/src` -- which is most of how agents run it -- resolved no
        # repository and spent a request on something the cache was holding.
        resolved = run_bounded([*args, "config", "--get-regexp", r"^remote\..*\.gh-resolved$"],
                               timeout=BROKER_GIT_DEADLINE)
        listed = run_bounded([*args, "remote", "-v"], timeout=BROKER_GIT_DEADLINE)
    except (subprocess.TimeoutExpired, OSError, UnicodeDecodeError):
        # UnicodeDecodeError because a remote URL that is not UTF-8 makes run_bounded(text=True)
        # raise, and this answers "cannot be known exactly" for that the same way it does for a
        # config git refuses. cmd_gh's catch-all would exec gh anyway; declining here says it.
        return None
    # `--get-regexp` exits 1 for "asked, and no key matches"; anything else non-zero (128) is a
    # config or a repository git will not read, and neither will gh.
    if resolved.returncode not in (0, 1) or listed.returncode != 0:
        return None
    if resolved.stdout.strip():
        return None  # `gh repo set-default`: gh resolves through it, and this cannot see where to
    found: list[str] = []
    for line in listed.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        # `NAME<TAB>URL (fetch|push)`. A remote with only a pushurl prints `NAME<TAB>` with no URL
        # and no marker for its fetch line (measured), which is a shape we know rather than one we
        # cannot read; its push line is then the URL gh resolves (also measured: `gh browse -n` in
        # such a checkout asks for `repos/cli/cli`, because gh falls back to the push URL when a
        # remote has no fetch URL). Anything else -- a URL with whitespace in it, which git keeps
        # inside quotes and this output cannot express -- is unknown, and gh, which splits this
        # same text, cannot read it either.
        if len(fields) == 1:
            continue
        # A partial clone's fetch line ends in its filter: `origin<TAB>URL (fetch) [blob:none]`
        # (git 2.56.0, any remote with a partialclonefilter). gh's own remote pattern is not
        # anchored at the end, so it reads that line as it reads any other; declining it declined
        # every checkout on a host whose clones are blobless, which is the fleet's default. On
        # cosmic-gray that let 353 source reads an hour of manaflow-ai/cmux through to the API
        # past the refusal below, and kept the cache from serving any read made inside one.
        if len(fields) == 4 and fields[2] == "(fetch)" and GIT_FILTER_RE.fullmatch(fields[3]):
            fields = fields[:3]
        if len(fields) != 3 or fields[2] not in ("(fetch)", "(push)"):
            return None
        # Every URL of every remote, fetch and push, and a URL this cannot read as a github.com
        # repository ends the answer rather than being skipped. That is what makes the one-name
        # answer sound: when exactly one name comes out, every URL in the checkout names that one
        # repository, so it does not matter which remote gh prefers or which of its URLs gh reads.
        # Skipping instead was a wrong answer twice over, both measured against gh 2.98.0:
        #   - `url = https://gitlab.com/a/b.git` with `pushurl = https://github.com/cli/cli.git`:
        #     gh exits 1 ("none of the git remotes ... point to a known GitHub host") because it
        #     resolves the *fetch* URL and falls back to the push URL only when there is no fetch
        #     URL at all. Reading the push line as an answer left one GitHub remote, and the broker
        #     served `cli/cli` from cache with exit 0 -- inventing success where gh refuses.
        #   - `origin = https://github.com/o/r` with `upstream = https://ghe.example/acme/thing`
        #     and both hosts in gh's hosts.yml: gh resolves `acme/thing` **on ghe.example**
        #     (measured: `gh pr view 7` posts to `https://ghe.example/api/graphql`), because it
        #     picks a remote by name across every host it has credentials for -- `upstream`, then
        #     `github`, then `origin`, then the rest alphabetically. Skipping the enterprise remote
        #     as "another forge" left `o/r` and answered another host's repository out of
        #     github.com's cache.
        # Deciding which foreign hosts gh really ignores means reproducing gh's set of known hosts
        # (hosts.yml, $GH_HOST, enterprise tokens) exactly, and being wrong there is that second
        # case again. So any remote that is not github.com's declines: a checkout with a GitLab
        # mirror alongside its GitHub remote costs one request, where gh does resolve the GitHub
        # one.
        name = git_remote_repo(fields[1])
        if name is None:
            return None
        if name not in found:
            found.append(name)
    return found


def gh_hosts_file() -> Path | None:
    """gh's own hosts.yml, where `gh auth login` records the hosts it has credentials for, or None
    when there is nowhere it could be.

    This reads `$HOME` rather than calling `Path.home()`, but not for the reason an earlier version
    of this docstring gave: it claimed `Path.home()` *raises* with no HOME, and on Linux and macOS
    it does not -- it falls back to the password database, so `env -u HOME glaeda-gh gh pr view 7
    -R o/r --json state` runs fine, and `BASE` at import time would have been the first casualty if
    it really raised. The reason is that a job with no HOME -- a launchd job, a systemd unit --
    also has no gh config to read, and answering with *some other* home's hosts.yml on the way to
    deciding which host a call is for is worse than not answering: gh's built-in default is the
    honest answer, and the caller uses it."""
    directory = os.environ.get("GH_CONFIG_DIR")
    if not directory:
        base = os.environ.get("XDG_CONFIG_HOME") or os.environ.get("HOME")
        if not base:
            return None
        directory = str(Path(base) / "gh" if os.environ.get("XDG_CONFIG_HOME")
                        else Path(base) / ".config/gh")
    return Path(directory) / "hosts.yml"


def gh_default_host() -> str | None:
    """The host real gh uses when neither the command line nor the environment names one, or None
    for a hosts.yml this cannot read as a list of hosts.

    gh does not simply default to github.com: with exactly one host logged in, that host is its
    default, so on an enterprise-only machine every unqualified call goes there. Found by running
    it -- with GH_CONFIG_DIR naming a config whose only host was `ghe.invalid.example`, gh 2.98.0
    tried to connect there while this still printed the github.com source refusal and still served
    `pr view 7 -R acme/thing --json state` out of the github.com cache. Same wrong-answer shape as
    an explicit `--hostname`, through the one channel broker_elsewhere did not read.

    The parse is top-level YAML keys and nothing else, because that is all the question needs; a
    file it cannot read that way is None, and broker_elsewhere reads None as "not github.com",
    which declines instead of answering for a host it cannot identify."""
    path = gh_hosts_file()
    if path is None:
        return "github.com"
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return "github.com"  # no hosts.yml at all: gh's built-in default, and the normal case
    hosts: list[str] = []
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#") or line[:1].isspace():
            continue  # blank, a comment, or indented: a value under some host, not a host
        match = re.fullmatch(r"([A-Za-z0-9][A-Za-z0-9.:-]*):\s*(?:#.*)?", line.rstrip())
        if match is None:
            return None
        hosts.append(match.group(1).lower())
    if len(hosts) == 1 and hosts[0] not in BROKER_GITHUB_HOSTS:
        return hosts[0]
    return "github.com"


def broker_elsewhere(values: dict[str, str]) -> bool:
    """True when the call names, or gh would resolve, a GitHub host that is not github.com.

    `repos/acme/thing` on an enterprise host is not the same repository as `acme/thing` on
    github.com, so neither the cache nor the local-checkout refusal has anything to say about it.
    broker_repo() always declined these; the refusal did not, and sent
    `gh api --hostname ghe.example.com /repos/acme/thing/contents/README.md` to read a github.com
    clone of that path -- a different repository's bytes, offered as the same ones."""
    host = (values.get("--hostname") or os.environ.get("GH_HOST") or gh_default_host() or "").lower()
    if host not in BROKER_GITHUB_HOSTS:
        return True
    return bool(os.environ.get("GH_ENTERPRISE_TOKEN") or os.environ.get("GITHUB_ENTERPRISE_TOKEN"))


def broker_source_refusal(words: list[str]) -> str | None:
    """The message for an API read of repository source, when that repository is on this host."""
    for word in words[1:]:
        match = BROKER_SOURCE_RE.match(word) or BROKER_RAW_RE.match(word)
        if not match:
            continue
        owner, repo = match.group(1).lower(), match.group(2).lower()
        where = broker_local_repos().get(f"{owner}/{repo}")
        if where is None:
            return None
        # The index is built from config *text*, which is not where the answer lives (git_remotes):
        # a remote rewritten by an `insteadOf` in a scope that text does not hold, or one written
        # in another scope entirely, puts an entry here that names a checkout of some other
        # repository -- and this message tells the reader to run `git show` in it, so a wrong entry
        # hands back another repository's bytes as these. Confirmed with git before it is named.
        # Declining costs one request and says nothing untrue; the scan itself stays a cheap text
        # read, because one fork per candidate directory is not affordable and a miss there only
        # declines.
        if f"{owner}/{repo}" not in (git_remotes(Path(where)) or []):
            return None
        return (f"glaeda-gh: reading {owner}/{repo} source through the GitHub API spends the quota every agent "
                f"on this account shares (5000/h between all of them), and git has the same bytes for nothing.\n"
                f"  {owner}/{repo} is checked out at {where}:\n"
                f"    git -C {where} fetch origin <ref>\n"
                f"    git -C {where} show <ref>:<path>\n"
                f"  GLAEDA_GH_ALLOW_API_SOURCE=1 passes one call through, for a path git really cannot answer.")
    return None


def broker_repo(values: dict[str, str]) -> str | None:
    """OWNER/REPO for this call, or None when it cannot be known beyond doubt.

    `-R`/`--repo` first, then $GH_REPO, then the checkout the process's own working directory is in
    -- the caller's, because the broker execs in place -- but only when git lists exactly one
    GitHub remote there and no `gh-resolved` entry (`gh repo set-default`, which would point gh
    somewhere this cannot see). git does the walking up, as it does for gh (git_remotes). Guessing
    here answers one repository's question with another's.

    Anything aimed at another GitHub host is None: gh takes `[HOST/]OWNER/REPO` and reads $GH_HOST,
    and an enterprise host's PR 7 is not the PR 7 in this cache."""
    if broker_elsewhere(values):
        return None
    named = values.get("--repo") or os.environ.get("GH_REPO")
    if named:
        parts = named.rstrip("/").split("/")
        if len(parts) > 2 and parts[-3].lower() not in BROKER_GITHUB_HOSTS:
            return None
        return f"{parts[-2].lower()}/{parts[-1].lower()}" if len(parts) >= 2 else None
    if any(os.environ.get(name) for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_CEILING_DIRECTORIES",
                                             "GIT_DISCOVERY_ACROSS_FILESYSTEM")):
        # These change where git -- and so gh -- starts or stops looking. Hooks set GIT_DIR, and
        # under it this walk can land on a different repository than gh would, which since the
        # walk was added is a wrong answer rather than a wasted request.
        return None
    here = git_remotes(Path.cwd())
    if here is None:
        return None
    # Still exactly one, now that the remotes are read the way git reads them. The cmux checkout
    # really does have five (the fork a lane pushes from, and contributors' forks), so this
    # declines there and `gh pr view 7` without `-R` costs a request. Picking `origin` instead
    # would be wrong, not just bolder: with several remotes and no `gh-resolved`, gh picks a remote
    # **by name** -- `upstream`, then `github`, then `origin`, then the rest alphabetically, with no
    # request of its own (measured: in a checkout with `origin = me/cli` and `upstream = cli/cli`,
    # `gh browse -n` asks for `repos/cli/cli`; with `aaa` and `zzz`, for `aowner/arepo`). So in a
    # fork checkout `origin` answers the fork's PR 7 where gh answers the upstream's. An earlier
    # version of this comment said gh resolved the base repository through the API and landed on
    # the parent; the conclusion was right and the mechanism was not. Declining costs a request;
    # guessing answers one repository's question with another's.
    return here[0] if len(here) == 1 else None


def broker_target(words: list[str], values: dict[str, str], kind: str) -> str | None:
    """The cache key for a `pr view N` or `run view ID`, or None when it is not that exact shape.

    `gh pr view` also takes a URL or a branch name; `gh run view` takes a run ID only, so a URL
    there is a call gh rejects and this must not answer."""
    if len(words) != 3:
        return None
    target = words[2]
    if re.fullmatch(r"\d+", target):
        repo = broker_repo(values)
        return None if repo is None else parse_key(kind, f"{repo}{'#' if kind == 'pr' else '/'}{target}")
    if kind == "run":
        return None
    try:
        return parse_key(kind, target)  # a full PR URL carries its own repository
    except WatchError:
        return None


def broker_fields(values: dict[str, str], table: dict[str, tuple[str, str]],
                  raw_args: list[str]) -> list[str] | None:
    """The --json field list, if every field asked for is one the cache holds. gh unions repeated
    --json flags; only the last reaches `values`, so more than one of them is not served."""
    raw = values.get("--json")
    if not raw or sum(1 for a in raw_args if a == "--json" or a.startswith("--json=")) != 1:
        return None
    wanted = [f for f in raw.split(",") if f]
    return wanted if wanted and all(f in table for f in wanted) else None


def broker_seen_count(key: str, now: float) -> int:
    """How many times this host has read `key` since the first read in the current window. The
    first read's time is kept, not the latest, so a target read every BROKER_REPEAT-1 seconds for
    an hour does not slide its way into a watch."""
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Read-modify-write, and the callers are every gh call on the host at once: two sessions reading
    # the same PR in the same second are exactly the pair that should add up to a watch. Bounded,
    # because this count is advisory and a gh call is not: at worst two concurrent readers both
    # write their own count and the promotion to a watch happens one read later.
    with bounded_lock(BASE / ".broker-seen.lock"):
        doc = read_json(broker_seen_path())
        seen = doc if isinstance(doc, dict) else {}
        seen = {k: v for k, v in seen.items()
                if isinstance(v, list) and len(v) == 2 and now - (v[0] or 0) < BROKER_REPEAT}
        first, count = seen.get(key) or [now, 0]
        seen[key] = [first, count + 1]
        if len(seen) > BROKER_SEEN_KEEP:
            seen = dict(sorted(seen.items(), key=lambda kv: kv[1][0], reverse=True)[:BROKER_SEEN_KEEP])
        write_json(broker_seen_path(), seen)
    return count + 1


def broker_max_age(fields: list[str]) -> float:
    """The cache horizon for a read of `fields`.

    It widens as the shared quota drains: spending the last of it on a read the daemon already
    made a few minutes ago is the worst trade available. But not for the fields automation pivots
    on -- a ten-minute-old headRefOid means waiting on a head that was superseded, and a
    ten-minute-old conclusion means calling a run green -- and a spent quota is exactly when every
    session is hammering gh, so those keep the normal horizon."""
    if set(fields) & BROKER_LIVE_FIELDS:
        # Before the override, not after. GLAEDA_GH_MAX_AGE=999999 served a two-hour-old
        # `{"state":"MERGED","mergeable":"MERGEABLE"}`, so one export in a shell profile silently
        # turned off the single protection the merge path depends on. The override widens the
        # horizon for fields where staleness only costs a request; it is not a way to turn that
        # distinction off.
        return BROKER_MAX_AGE
    # A daemon configured to poll less often than every BROKER_MAX_AGE - 30 s would leave its cache
    # always older than the horizon, and every read would go to gh: the horizon follows the cycle.
    # (Not for the live fields above: their horizon is a correctness bound, not a cost.)
    cycle = daemon_policy()["cycle"]
    normal = max(BROKER_MAX_AGE, cycle + 30.0)
    lean = max(BROKER_LEAN_AGE, cycle * LEAN_FACTOR + 30.0)  # below the floor the daemon reads that rarely
    try:
        age = float(os.environ["GLAEDA_GH_MAX_AGE"])
        return age if age >= 0 else normal
    except (KeyError, ValueError):
        pass
    budget = read_json(BASE / "budget.json")
    if not isinstance(budget, dict):
        return normal
    now = time.time()
    for bucket, (floor, _reserve) in daemon_policy()["floors"].items():
        seen = budget.get(bucket)
        if not isinstance(seen, dict) or (seen.get("reset") or 0) <= now:
            continue
        remaining = seen.get("remaining")
        if isinstance(remaining, int) and remaining < floor:
            return lean
    return normal


def broker_bucket_spent(key: str, now: float) -> bool:
    """True when the bucket gh would spend on `key` is below its reserve until a reset that has not
    come yet, throttled (the daemon stopped it: GitHub refused it), or named in forceLow, and the other
    bucket is none of these: then the daemon can read what gh cannot. Below its floor alone is not
    enough here: one gh call costs one request, and waiting for the daemon costs the caller seconds."""
    budget = read_json(BASE / "budget.json")
    budget = budget if isinstance(budget, dict) else {}
    policy = daemon_policy()
    floors = policy["floors"]
    status = read_json(BASE / "daemon.json")
    modes = status.get("modes") if isinstance(status, dict) and isinstance(status.get("modes"), dict) else {}
    fresh = isinstance(status, dict) and isinstance(status.get("at"), (int, float)) and now - status["at"] < 2 * CYCLE

    def spent(bucket: str) -> bool:
        if bucket in policy["forceLow"] or (fresh and modes.get(bucket) == "stop"):
            return True
        seen = budget.get(bucket)
        if not isinstance(seen, dict) or (seen.get("reset") or 0) <= now:
            return False
        remaining = seen.get("remaining")
        return isinstance(remaining, int) and remaining < floors[bucket][1]

    mine = BROKER_GH_BUCKET.get(key.split(":", 1)[0])
    return mine is not None and spent(mine) and not spent(OTHER[mine])


def broker_await(args: list[str], key: str) -> str | None:
    """Register `key` and wait up to BROKER_SPENT_WAIT for the daemon to read it; the `--json` line
    once the cache answers every field asked for, else None (the call then goes to gh as before)."""
    register(key)
    started = time.monotonic()
    try:
        while True:
            route, line, _key = broker_plan(args, time.time())
            if route == "serve":
                return line
            if time.monotonic() - started >= BROKER_SPENT_WAIT:
                return None
            time.sleep(0.5)
    finally:
        extend_lock_budget(time.monotonic() - started)  # a deliberate wait, as broker_hold's is


def broker_value(stored: Any, kind: str) -> Any:
    """What gh prints for a stored value. gh unmarshals into Go structs, so a null string field
    comes out "" (an unreviewed PR's reviewDecision, a running job's conclusion) while a null time
    stays null. A null where gh expects a number or a bool is not something to guess at."""
    if stored is not None:
        return stored
    if kind == "str":
        return ""
    if kind == "time":
        return None
    raise WatchError(f"cached {kind} is null")


def broker_serve(key: str, fields: list[str], table: dict[str, tuple[str, str]], now: float) -> str | None:
    """The `gh --json` line for `key`, or None when the cache cannot answer it."""
    entry = read_cache(key)
    if not isinstance(entry, dict) or entry.get("error"):
        return None
    data, at = entry.get("data"), entry.get("dataAt")
    if not isinstance(data, dict) or not isinstance(at, (int, float)) or now - at > broker_max_age(fields):
        return None
    out = {}
    for field in fields:
        stored, kind = table[field]
        if stored not in data:
            return None  # the daemon did not store it at all
        try:
            out[field] = broker_value(data[stored], kind)
        except WatchError:
            return None
    return json.dumps(out, sort_keys=True, separators=(",", ":"))


def broker_note(event: dict) -> None:
    """One line per decision, for the before/after numbers. Never raises."""
    path = broker_log()
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if (path.parent.stat().st_mode & 0o077) != 0:
            path.parent.chmod(0o700)  # mode= misses a directory an earlier run already created
        if path.exists() and path.stat().st_size > BROKER_LOG_MAX:
            # Under a lock, and measured again inside it -- the same race the call log's rotation
            # fixed, still here 170 lines above it. Two callers straddling the threshold both
            # `stat` then both `replace`, and the second rotation overwrote the full `.1` with the
            # handful of bytes the first had just started: the whole decision history in neither
            # file. Reproduced with two real processes and a 2 s deschedule between one caller's
            # stat and its replace. Not rotating when the lock is held is safe: the log grows a
            # little past the cap and the next call rotates it.
            with bounded_lock(path.parent / ".broker-log-rotate.lock") as held:
                if held and path.exists() and path.stat().st_size > BROKER_LOG_MAX:
                    path.replace(path.with_name(path.name + ".1"))
        with path.open("a") as stream:
            stream.write(json.dumps({"at": round(time.time()), **event}, sort_keys=True) + "\n")
    except Exception:  # noqa: BLE001  not even an unserialisable event may fail a gh call
        pass


def broker_logged_target(words: list[str], values: dict[str, str]) -> str:
    """What may be written next to the subcommand: an identifier, never content.

    Only an API path (query cut) and a resolved cache key qualify. Everything else is dropped,
    because the tail of a command line is not safe to keep: `gh secret set NAME --body VALUE` and
    `gh pr create --title T BODY` both put text worth hiding in a positional slot, and the log is
    a long-lived plain file every session appends to."""
    if words and words[0] == "api":
        path = (words[1] if len(words) > 1 else "").split("?")[0]
        # A path, not whatever else sat in that slot: an endpoint starts with a letter, a slash or
        # a scheme, so `gh api "$BODY"` with a mistyped flag leaves nothing in the log.
        return path if re.fullmatch(r"(?:https?://)?/?[A-Za-z0-9_][A-Za-z0-9_./:#@~-]{0,199}", path) else ""
    if len(words) >= 3 and words[0] in ("pr", "run", "issue"):
        kind = "run" if words[0] == "run" else "pr"
        try:
            return broker_target(words[:3], values, kind) or ""
        except (WatchError, OSError):
            return ""
    return ""


def broker_caller() -> str:
    """Who is making this call, by the same rule the PATH guard uses, so one log has one notion
    of a caller: the agent session if there is one, else the parent process.

    Shape-checked, because this is an environment variable going into a line-oriented log that
    AUDIT_LINE reads as three whitespace-separated fields. The subcommand slot is checked the same
    way; leaving this one open would just move the hole."""
    named = os.environ.get("CLAUDE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID") or ""
    if re.fullmatch(r"[A-Za-z0-9_.:-]{1,64}", named):
        return named
    return f"ppid-{os.getppid()}"


# A read worth holding when the same caller repeats it: the ones a polling loop is written out of,
# named as (subcommand, verb). `gh api` GET joins them, by method rather than by name. Reads that
# are not poll shapes (`pr diff`, `issue view`) are left alone -- the delay is for the loop that
# drained the pool three times in a day, not a toll on reading.
BROKER_THROTTLED = {("pr", "view"), ("pr", "checks"), ("pr", "list"),
                    ("run", "view"), ("run", "list"), ("issue", "list")}


def endpoint_re(name: str) -> "re.Pattern[str]":
    """One top-level API endpoint, however `gh api` was given it: bare, rooted, or an absolute URL.

    Any host, not `api.github.com` alone: this file handles GHE remotes deliberately. Pinning the
    one host meant `https://ghe.example/api/graphql` read as an ordinary path -- undercounting the
    audit's category, and (through `BROKER_FREE_RE`) holding a GHE host's free `rate_limit` read
    behind the repeat delay. One function, so widening one endpoint's spellings cannot leave the
    other behind again.

    Both of a GHE host's bases, because they are not the same one and an earlier version of this
    said they were: GraphQL is at `/api/graphql` and REST is under `/api/v3/`, so
    `https://ghe.example/api/v3/rate_limit` is the spelling a GHE host actually serves for the free
    call -- and with `/api/` alone it was still filed as an ordinary path and still held 30 s, which
    is the defect this helper claimed to have removed (measured by a review: 0.0 s then 29.9 s).
    `/api/rate_limit` stays matched too; it 404s on GHE, so matching it costs nothing.

    `re.escape`, because this reads as the general helper and a name with a `.` or a `+` in it
    would quietly widen the pattern."""
    return re.compile(rf"^(?:https?://[^/]+/(?:api/(?:v3/)?)?)?/?{re.escape(name)}/?$")


# `GET /rate_limit` is documented as costing neither pool, and this file already treats it as free
# (`request(free=True)`, audit_category's "rate_limit (free)"). Holding it punishes the session
# doing the right thing: checking the budget around a batch of calls. `--web` opens a browser.
BROKER_FREE_RE = endpoint_re("rate_limit")


def broker_repeat_wait(args: list[str], words: list[str], method: str, seen: set[str],
                       now: float) -> float:
    """How long to hold this call before it spends the shared quota on something this caller just
    read. Nothing else in the broker sleeps.

    The rule is the cmuxterm-hq PATH guard's (2026-10-04: no agent polls GitHub faster than every
    30 s, after Lawrence's REST pool ran out three times in a day), but applied here instead of
    there, because only this side knows whether the call is about to cost a request at all. In the
    guard it also delayed the reads the cache answers for nothing -- the 22% of all traffic this
    broker exists to serve, made slower by the thing meant to protect the quota they do not spend.

    The bound is per call, not per target: the slot is stamped before the sleep, so a serial
    polling loop is held `delay` apart each time around, but a parallel fan-out of n identical
    reads is held once and then released *together*, one `delay` later -- the wait is capped at
    `delay`, so the n-th does not wait n*delay, and every lane after the first wakes at the same
    moment. A thundering herd, on purpose: queueing fifty lanes behind each other would be an
    outage, not a rate limit. So this is a brake on a loop, not a quota. What actually keeps a
    fan-out off GitHub is the cache above it."""
    try:
        delay = float(os.environ.get("CMUX_GH_MIN_REPEAT_SECONDS") or BROKER_MIN_REPEAT)
    except ValueError:
        delay = BROKER_MIN_REPEAT
    if delay <= 0:
        return 0.0
    first, second = (words + ["", ""])[:2]
    if (first, second) not in BROKER_THROTTLED and not (first == "api" and method == "GET"):
        return 0.0
    if first == "api" and any(BROKER_FREE_RE.match(word) for word in words[1:2]):
        return 0.0  # costs no quota, so there is nothing to protect by waiting
    if "--web" in seen:
        # Not free -- the argument-less forms resolve the PR or run over the API before opening a
        # URL -- but a person opening a browser twice is not the polling loop this delay is for,
        # and holding an interactive command 30 s is worse than the request. Read from `seen`, not
        # from a scan of args, or a flag whose *value* is "--web" would exempt the call.
        return 0.0
    if sys.stdout.isatty():
        # The same exemption, for the same reason, and the review that asked for broker_plan's tty
        # branch is what found this: that branch returns "pass" *before* cmd_gh reaches this brake,
        # so a person's second interactive `gh pr view 7 -R o/r --json state` went from served
        # instantly to held 30 s. Measured on a real pty: 0.12 s, then 30.00 s. A tty is a person,
        # and what this brake is for is a loop. Agents' calls are piped, so they still get it.
        return 0.0
    digest = hashlib.sha256("\0".join([broker_caller(), *args]).encode()).hexdigest()[:32]
    path = BASE / "broker-repeat.json"
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Bounded for the same reason as broker_seen_count: the delay is there to save a request, and
    # holding `gh` on a lock to decide whether to hold it 30 s is the wrong way round.
    with bounded_lock(BASE / ".broker-repeat.lock"):
        doc = read_json(path)
        seen = {k: v for k, v in (doc if isinstance(doc, dict) else {}).items()
                if isinstance(v, (int, float)) and not isinstance(v, bool) and now - v < 2 * delay}
        wait = max(0.0, min(delay, (seen.get(digest) or 0.0) + delay - now))
        seen[digest] = now + wait
        if len(seen) > BROKER_SEEN_KEEP:
            seen = dict(sorted(seen.items(), key=lambda kv: -kv[1])[:BROKER_SEEN_KEEP])
        write_json(path, seen)
    return wait


def broker_hold(seconds: float) -> None:
    """The one place the broker sleeps, and the only one: a test replaces this rather than the
    clock, because the daemon's own waits are built on that."""
    if seconds <= 0:
        return
    print(f"glaeda-gh: this caller read the same thing moments ago and the cache cannot answer it; "
          f"waiting {int(round(seconds))} s before spending a request on it again "
          f"(CMUX_GH_MIN_REPEAT_SECONDS)", file=sys.stderr)
    time.sleep(seconds)
    extend_lock_budget(seconds)


def broker_log_call(words: list[str], values: dict[str, str]) -> str:
    """Append this call to the shared log: time, caller, the subcommand, and an identifier. Returns
    that subcommand-and-identifier text, which the decision log keeps too (cmd_audit's "reached
    GitHub" figure), whether or not the PATH guard already wrote the call log's line.

    The PATH guard writes the same shape when it has no broker to delegate to, so `glaeda-gh audit`
    reads one format from every host."""
    line = broker_call_line(words, values)
    if os.environ.get("CMUX_GH_GUARD_LOGGED") == "1":
        return line
    caller = broker_caller()
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    path = guard_log()
    try:
        # 0700 like every other state path here: credentials are stripped, but this is every repo,
        # PR, run and API path every session on the host reads, and no other local account needs it.
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        # The same for the file, which said 0700 above and came out 0664 under a normal umask --
        # and so did the world-readable `.1` it was rotated into. Repaired rather than only set at
        # creation, because the loose copies already exist on every host this has run on. Never
        # through a symlink: chmod follows one, so a CMUX_GH_LOG pointing at a link would narrow
        # whatever the link names instead.
        if path.exists() and not path.is_symlink() and (path.stat().st_mode & 0o077):
            path.chmod(0o600)
        # Rotated like the decision log. One line per gh call per host is 117 MB on cosmic-gray
        # already, and this is the one append here that had no cap at all. `audit` reads the
        # rotated file too, so nothing is lost until the next rotation past it.
        if path.exists() and path.stat().st_size > GUARD_LOG_MAX:
            # Under a lock, and measured again inside it: `stat` then `replace` with two callers
            # straddling the threshold rotated twice, and the second rotation replaced the full
            # `.1` with the 51-byte log the first one had just started -- the entire audit history
            # in neither file, which is the one thing rotation exists to keep. Driven directly to
            # confirm it. Not rotating when the lock is held is safe: the log grows a little past
            # the cap and the next call rotates it.
            with bounded_lock(path.parent / ".guard-log-rotate.lock") as held:
                if held and path.exists() and path.stat().st_size > GUARD_LOG_MAX:
                    path.replace(path.with_name(path.name + ".1"))
        # Created 0600 rather than created loose and repaired on the next call, so the window in
        # which it is readable by other local accounts is no window at all.
        with os.fdopen(os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600), "a") as stream:
            stream.write(f"{stamp} {caller} {line}\n")
    except OSError:
        pass
    return line


def broker_call_line(words: list[str], values: dict[str, str]) -> str:
    """The subcommand words and one identifier for this call, as the call log keeps them."""
    # `api` carries its path in words[1], and the target is that path with its query cut: one or
    # the other, never both, or the query comes back in through the subcommand.
    head = words[:1] if words[:1] == ["api"] else words[:2]
    # A subcommand is a word. Anything else in that slot (`gh "pr view 7\n2026-..."`, or a value a
    # flag this does not know about left behind) must not reach a line-oriented shared log.
    kept: list[str] = []
    for word in head:
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}", word):
            break
        kept.append(word)
    head = kept
    line = " ".join(x for x in [*head, broker_logged_target(words, values)] if x)
    # A backstop under the parse above, which is a parse of someone else's command line: however a
    # credential reached this line, it does not stay in it.
    line = BROKER_SECRET_RE.sub("[redacted]", line)
    return line


def broker_hops() -> int:
    """How many times *this* call has already been through the broker. Carried across the exec in
    BROKER_MARK as "count:pid", and honoured only in the process the mark was written for.

    The pid is what makes the mark about one call rather than one environment. A PATH loop is a
    chain of execs, and an exec keeps the pid, so a call that really is coming back here still
    carries its own mark and the chain stays finite. A `gh` that *spawns* `gh` -- an extension,
    an alias, an $EDITOR hook -- is a new process, so it starts at zero: it gets brokered, served
    and logged like any other call, instead of inheriting its parent's hop count and eventually
    being refused for a loop that does not exist.

    Anything unreadable in the mark counts as one hop, which only ever ends the chain sooner.
    Older versions wrote a bare count, which still reads as one hop in any process."""
    raw = os.environ.get(BROKER_MARK) or ""
    if not raw:
        return 0
    count, _, owner = raw.partition(":")
    if owner and owner != str(os.getpid()):
        return 0  # another process's mark: it is not this call's history
    try:
        return max(0, int(count))
    except ValueError:
        return 1


def broker_depth() -> int:
    """How many brokered `gh` generations deep this process is, however it got here.

    Unscoped, unlike broker_hops: a wrapper that forks `gh` rather than exec'ing it gets a new pid
    each time, so only a counter that ignores the pid can end that chain. Anything unreadable
    counts as the limit, which ends it sooner rather than later."""
    raw = os.environ.get(BROKER_DEPTH) or ""
    if not raw:
        return 0
    try:
        return max(0, int(raw))
    except ValueError:
        return BROKER_MAX_DEPTH


def broker_is_wrapper(candidate: Path) -> bool:
    """Whether this `gh` is something that would come back here: this broker's own shim, or the
    cmuxterm-hq PATH guard. The marker is also why a brokered call carries BROKER_MARK across the
    exec -- a wrapper whose wording changes must not become an endless loop."""
    try:
        with candidate.open("rb") as stream:
            head = stream.read(4096)
    except OSError:
        # A gh that cannot be read is not a Python or bash wrapper; it is a binary, or a file this
        # account may execute but not read. Calling it a wrapper steps over a perfectly runnable
        # gh, and if no fallback path exists the broker is then the reason the call failed.
        return False
    return BROKER_MARK.encode() in head or b"gh guard" in head


# lane-vm-bootstrap's credential chain on a lane VM: gh with a per-command token from the lane-gh broker.
# GLAEDA_GH_LANE_CHAIN names another path (tests point it into their own HOME).
LANE_VM_GH = Path(".local/lib/lane-gh/bin/gh")


def lane_vm_gh() -> str | None:
    """The lane VM credential chain's gh, or None off a lane VM."""
    candidate = Path(os.environ.get("GLAEDA_GH_LANE_CHAIN") or Path.home() / LANE_VM_GH)
    if candidate.is_file() and os.access(candidate, os.X_OK) and not broker_is_wrapper(candidate):
        return str(candidate)
    return None


def broker_real_gh() -> str:
    """The real gh: the binary a guard that delegated here named in GLAEDA_GH_REAL, else the next
    `gh` on PATH that is not a wrapper, else one of the usual install paths (a LaunchAgent's PATH
    is nearly empty, which is where find_gh's list comes from).

    GLAEDA_GH_REAL is checked the same way as a PATH candidate. Mid-rollout a host can have two
    generations of the PATH guard on PATH, and the older one's idea of "the real gh" is the newer
    one -- taking its word for it would hand the call straight back here."""
    named = os.environ.get("GLAEDA_GH_REAL")
    if named and os.access(named, os.X_OK) and not Path(named).is_dir() \
            and not broker_is_wrapper(Path(named)):
        return named
    # A lane VM holds no GitHub login: its gh is lane-vm-bootstrap's wrapper (a "gh guard", stepped over below), and
    # the authenticated gh is the credential chain behind it. Only the wrapper names that in GLAEDA_GH_REAL, so a call
    # that reached the broker another way (`glaeda-gh gh ...` typed directly, the daemon's own reads) found the
    # distribution's /usr/bin/gh next, which is signed in to nothing: cloud-item-5 on gcp-codex-lane-1, 2026-11-01,
    # `glaeda-gh gh api repos/O/R/issues/N/comments` answered "To get started with GitHub CLI, please run: gh auth
    # login". Where the chain exists it is the real gh.
    lane = lane_vm_gh()
    if lane is not None:
        return lane
    on_path = [Path(entry) / "gh" for entry in os.environ.get("PATH", "").split(os.pathsep) if entry]
    elsewhere = [Path.home() / ".local/bin/gh", Path("/opt/homebrew/bin/gh"),
                 Path("/usr/local/bin/gh"), Path("/usr/bin/gh")]
    for candidate in on_path + elsewhere:
        if candidate.is_dir() or not os.access(candidate, os.X_OK) or broker_is_wrapper(candidate):
            continue
        return str(candidate)
    raise WatchError("no real gh found on PATH")


def broker_plan(args: list[str], now: float) -> tuple[str, str | None, str | None]:
    """(route, payload, key). route is 'serve', 'refuse' or 'pass'. Pure: no watch is registered and
    nothing is written, so a test can read the decision without touching the daemon's state."""
    words, method, seen, values = broker_words(args)
    if (words and words[0] == "api" and method == "GET" and not broker_elsewhere(values)
            and not os.environ.get("GLAEDA_GH_ALLOW_API_SOURCE")):
        # Only a GET reads source. A POST is a write, and `-f`/`-F` make gh POST without `-X`,
        # which is why the method is read from the whole command line rather than assumed.
        refusal = broker_source_refusal(words)
        if refusal:
            return "refuse", refusal, None
    head = " ".join(words[:2])
    if head not in ("pr view", "run view") or seen - BROKER_SAFE_FLAGS:
        return "pass", None, None
    if any(flag in seen and flag not in values for flag in BROKER_SAFE_FLAGS):
        return "pass", None, None  # `--json` or `--repo` with no value: gh errors, so never answer
    kind = "pr" if head == "pr view" else "run"
    table = BROKER_PR_FIELDS if kind == "pr" else BROKER_RUN_FIELDS
    fields = broker_fields(values, table, args)
    key = broker_target(words, values, kind)
    if fields is None or key is None:
        # Nothing to gain from watching a target the cache could not have answered anyway.
        return "pass", None, None
    line = broker_serve(key, fields, table, now)
    if line is not None and sys.stdout.isatty():
        # Real gh indents and colours `--json` output when stdout is a tty; this prints the compact
        # json.dumps. Answering a person's interactive call would be the same data in a different
        # shape, so what "byte-for-byte" means stays true by not answering it. A tty is a person,
        # not the polling that drains the quota, so there is nothing to save here anyway.
        return "pass", None, key
    return ("serve", line, key) if line is not None else ("pass", None, key)


# -- the answer cache: identical read-only calls within GH_CACHE_TTL share one request
#
# The daemon's cache above answers only `pr view`/`run view --json` with the fields it already
# holds. Most repeated reads are not that shape: a `gh api .../jobs --jq ...`, a `pr view 7` with a
# field the daemon does not keep, a `run view 12 --log-failed`. Measured on one host, 38% of `pr
# view` calls re-read the same PR within 90 s, mostly another session asking the same question. So
# the broker also keeps whole answers -- stdout, stderr and the exit code of one real gh run --
# keyed on the exact arguments plus everything else that can change what gh prints, and hands an
# identical call the same bytes for GH_CACHE_TTL seconds.
#
# Only reads are kept (`pr view`, `run view`, `gh api` GET, and a `gh api graphql` query -- never a
# mutation -- keyed on its query text and variables in any order), only answers that exited 0, only
# from a stdout that is not a terminal (gh prints a person a different shape), and never a
# `--web` or `--watch`. Any call that might write -- every subcommand not on GH_CACHE_PURE, every
# non-GET `gh api`, and a GraphQL call carrying a mutation -- stamps the time for its repository
# (or for all of them when it names none), and an answer older than that stamp is not served: this
# host's own write is never answered with what it read just before. A write from another host is
# bounded by the TTL, which is the trade this makes.
#
# A write is stamped no wider than what it can change (gh_cache_write_scope): a comment on PR 7
# stamps PR 7 and the repository's lists, not every answer the host holds for the repository. Until
# 2026-10-31 every write stamped its whole repository, and on cosmic-gray a write to manaflow-ai/cmux
# came about every 30 s (comments, dispatches, reruns, merges), so most answers were thrown away
# before anyone asked again: 1,000 of 17,090 calls were answered here over 8 hours, against 40% of
# reads repeating within 90 s. Replaying that host's log, scoping alone took the PR and run reads
# answered here from 12% to 16%, and the 90 s window to 18%.
#
# Each answer about one PR or run also remembers what glaeda's daemon held for that target when it
# was read (gh_cache_watch). The daemon reads its watched targets every cycle and hears the
# controller's webhooks within a tick, so when its copy changes the answer is dropped at once, from
# whichever host the change came; and a completed run the daemon still watches, unchanged since the
# answer, is kept for GH_CACHE_DONE_TTL, because a rerun would show up there first.
#
# Identical calls arriving together are filled once: the first takes the key's lock and runs gh,
# the rest wait up to GH_CACHE_FILL_WAIT on that lock and then read its answer. Identical means the
# same question, not the same bytes (gh_cache_canonical): `-R O/R --json b,a` and `--json=a,b
# --repo o/r` share one answer and one fill.
GH_CACHE_TTL = 90.0  # the window cosmic-gray's repeats fall in (glaeda-gh audit: AUDIT_WINDOW)
# An answer that cannot change: a completed job, a completed attempt's jobs, or a completed run the
# daemon still watches and has seen no change in. As long as an answer is kept at all (GH_CACHE_KEEP).
GH_CACHE_DONE_TTL = float(TERMINAL_REFRESH)
GH_CACHE_MAX_BYTES = 2 * 1024 * 1024  # a bigger answer (a whole log) is passed on, not stored
GH_CACHE_FILL_WAIT = 30.0
GH_CACHE_KEEP = 600.0  # stored answers older than this are deleted
GH_CACHE_PRUNE_EVERY = 60.0
GH_CACHE_DRAIN = 3.0  # after a fill is killed, how long its pipes are read before they are dropped
GH_CACHE_FILL_DEADLINE = 600.0
GH_CACHE_LOCK_KEEP = 3600.0  # a fill lock file is removed this long after its last use  # a filling gh still running after this is killed with its process group
GH_CACHE_DEBUG_ENV = ("GH_DEBUG", "DEBUG")  # gh prints request headers under these: never stored
# What changes the bytes gh prints for the same arguments: colour, a forced tty, the markdown style,
# the width. Part of the key, so a caller is never handed output rendered for another.
GH_CACHE_OUTPUT_ENV = ("GH_FORCE_TTY", "CLICOLOR_FORCE", "CLICOLOR", "NO_COLOR", "GLAMOUR_STYLE",
                       "GH_MDWIDTH", "COLUMNS", "TERM", "GH_PAGER", "PAGER", "LANG", "LC_ALL",
                       "GH_NO_UPDATE_NOTIFIER", "GH_SPINNER_DISABLED", "GH_PROMPT_DISABLED")
GH_CACHE_READS = {("pr", "view"), ("run", "view")}  # and `api` GET
# Reads of one object named on the line, kept like `pr view` -- but only when that object is a number
# or a github.com URL, and nothing else is a positional word. With no target gh reads the checked-out
# branch's PR, which is not on the line, and a value flag this does not know (`pr diff --color never`)
# would read as one: either way two worktrees on different branches would share an answer.
GH_CACHE_TARGETED = {("pr", "checks"), ("pr", "diff"), ("issue", "view")}
GH_CACHE_TARGET_RE = re.compile(rf"^(?:\d+|https://github\.com/{NAME}/{NAME}/(?:pull|issues)/\d+/?)$")
# Lists, which read no branch: the repository gh resolves is in the key (broker_repo), the rest is on the
# line. Measured on cosmic-gray over 20,000 calls (2026-10-29), the reads repeated most within 90 s:
# `issue list` 82%, `pr list` 64%, `search prs` 61%, `run list` 46% -- none of which this kept before.
GH_CACHE_LISTS = {("pr", "list"), ("issue", "list"), ("run", "list"), ("label", "list"),
                  ("release", "list"), ("workflow", "list")}
# `gh search` asks GitHub's search index, never the working directory's repository, so it needs none.
GH_CACHE_ANYWHERE = {"search"}
# Flags that make gh print data rather than a rendered view: with stdout not a terminal and nothing
# forcing one, what it prints then does not depend on the width, the terminal, the locale, the pager
# or the markdown style, so those are left out of the key and sessions with different terminals share
# one answer. Colour can still be forced on a pipe, so the forcing variables stay in.
GH_CACHE_DATA_FLAGS = {"--json", "-q", "--jq", "-t", "--template"}
GH_CACHE_FORCE_ENV = ("GH_FORCE_TTY", "CLICOLOR_FORCE", "CLICOLOR", "NO_COLOR")
# A finished job's log never changes (a rerun is a new job id), and it is the read a lane repeats while
# it works out why something failed: kept for GH_CACHE_KEEP, not GH_CACHE_TTL.
GH_CACHE_LONG_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/{NAME}/{NAME}/actions/jobs/\d+/logs/?$")
GH_CACHE_LONG_TTL = 600.0
GH_CACHE_NEVER = {"--web", "-w", "--watch", "--verbose", "--include", "-i"}
# (subcommand, verb) pairs that never write; `None` as the verb is every verb of that subcommand.
# A call not named here stamps a write. Listing reads rather than writes is deliberate: a write gh
# adds next year then clears the cache instead of being answered from it.
GH_CACHE_PURE = {
    ("pr", "view"), ("pr", "list"), ("pr", "checks"), ("pr", "diff"), ("pr", "status"),
    ("run", "view"), ("run", "list"), ("run", "watch"), ("run", "download"),
    ("issue", "view"), ("issue", "list"), ("issue", "status"), ("repo", "view"), ("repo", "list"),
    ("release", "view"), ("release", "list"), ("release", "download"), ("workflow", "view"),
    ("workflow", "list"), ("label", "list"), ("cache", "list"), ("search", None), ("auth", "status"), ("auth", "token"),
    ("status", None), ("browse", None), ("help", None), ("version", None), ("--version", None),
}
GH_CACHE_REPO_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})(?:[/?]|$)")
GH_CACHE_MUTATION_RE = re.compile(r"\bmutation\b")
# What one answer is about, read off an API path: a PR or issue (one number space), a run, or a job.
GH_CACHE_API_PR_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/(?:pulls|issues)/(\d+)(?:[/?]|$)")
GH_CACHE_API_RUN_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/runs/(\d+)(?:[/?]|$)")
GH_CACHE_API_JOB_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/jobs/(\d+)(?:[/?]|$)")
GH_CACHE_PR_URL_RE = re.compile(rf"^https://github\.com/({NAME})/({NAME})/(?:pull|issues)/(\d+)/?$")
# Lists of workflow runs: the REST reads repeated most on cosmic-gray (1,092 of 1,400 within 90 s over
# 8 hours, 2026-10-30), which a comment or a label cannot change.
GH_CACHE_API_RUNS_LIST_RE = re.compile(
    rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/(?:workflows/[^/?]+/)?runs/?(?:\?.*)?$")
# Reads that never change what GitHub holds, so they stamp nothing. `auth git-credential` is git
# asking gh for a password on every https fetch: it stamped every answer on the host, about once
# every 40 minutes on cosmic-gray.
GH_CACHE_PURE |= {("auth", "git-credential"), ("variable", "list"), ("variable", "get"), ("secret", "list"),
                  ("ruleset", "list"), ("ruleset", "view"), ("gist", "view"), ("gist", "list")}
# Boolean flags the canonical form may move: with every flag on a line known to take a value or not,
# reordering them cannot attach a value to the wrong flag. A flag in neither list keeps the line as
# typed (gh_cache_canonical returns None), which costs an answer, never a wrong one.
GH_CACHE_BOOL_FLAGS = {"--log", "--log-failed", "--exit-status", "--paginate", "--slurp", "--name-only",
                       "--patch", "--comments", "--required", "--verbose", "--include", "--silent",
                       "--web", "--watch", "--fail-fast"}
# Not `-i`, `-w` or any other one-letter flag: `-i` is `--include` to `gh api` and `--interval VALUE` to
# `gh pr checks`, so a short flag's arity depends on the command and the line is kept as typed.
# Two spellings of one flag, beyond the pair broker_words knows: only those that mean the same in
# every read gh has. `-b` is `--body` in one command and `--branch` in another, so it stays as typed;
# `-f` and `-F` are not aliases (a string and a typed value) and stay apart.
GH_CACHE_FLAG_ALIAS = {**BROKER_FLAG_ALIAS, "-q": "--jq", "-t": "--template", "-L": "--limit", "-H": "--header",
                       "-f": "--raw-field", "-F": "--field"}
# Request fields, string or typed: one ordered group, because gh sends them in the order given and the
# last of a repeated name wins whichever of the two spellings carried it. Sorting them apart by flag
# name answered `-f state=open --raw-field state=closed` with `--raw-field state=closed -f state=open`.
GH_CACHE_FIELD_GROUP = {"--raw-field", "--field"}
# The subcommand verbs that change one PR or issue named on the line, and nothing else about the
# repository but its lists.
GH_CACHE_TARGET_WRITES = {"comment", "edit", "ready", "close", "reopen", "review", "lock", "unlock"}
# `gh run` verbs that change one run named on the line (a rerun, or stopping it). This only reads the
# caller's command line to decide what to invalidate; the broker runs that write as it was typed.
GH_CACHE_RUN_WRITES = {"rerun", "cancel"}
# Verbs that change one PR and, through the base branch, every other PR's mergeability.
GH_CACHE_BASE_WRITES = {"merge", "update-branch"}
# The flags of those writes, by whether they take a value, so their one positional word (the PR) can
# be found. A write carrying a flag in neither set is stamped as wide as before.
GH_CACHE_WRITE_VALUE_FLAGS = BROKER_VALUE_FLAGS | {
    "--match-head-commit", "--subject", "--author-email", "--add-label", "--remove-label", "--milestone",
    "--add-reviewer", "--remove-reviewer", "--add-assignee", "--remove-assignee", "--add-project",
    "--remove-project", "-r", "-a", "-m", "-T", "--template", "-e", "--comment", "-c", "--reason"}
GH_CACHE_WRITE_BOOL_FLAGS = {
    "--squash", "-s", "--merge", "--rebase", "--auto", "--disable-auto", "--delete-branch", "-d", "--admin",
    "--approve", "--request-changes", "--undo", "--yes", "--edit-last", "--create-if-none", "--delete-last",
    "--draft", "--failed", "--debug", "--force", "--remove-milestone", "--fill", "--fill-first",
    "--fill-verbose", "--no-maintainer-edit", "--dry-run", "--editor", "--web", "-w"}


def gh_cache_dir() -> Path:
    return BASE / "answers"


def gh_cache_ttl() -> float:
    """GLAEDA_GH_CACHE_TTL seconds (0 turns the cache off), else GH_CACHE_TTL."""
    try:
        ttl = float(os.environ.get("GLAEDA_GH_CACHE_TTL") or GH_CACHE_TTL)
    except ValueError:
        return GH_CACHE_TTL
    return ttl if 0 <= ttl <= 3600 else GH_CACHE_TTL


def gh_cache_repo(words: list[str], values: dict[str, str]) -> str | None:
    """The repository a call is about, lowercased, when the line says so; None when it does not."""
    repo = values.get("--repo") or ""
    if re.fullmatch(rf"{NAME}/{NAME}", repo):
        return repo.lower()
    if words and words[0] == "api" and len(words) > 1:
        match = GH_CACHE_REPO_RE.match(words[1])
        return f"{match.group(1)}/{match.group(2)}".lower() if match else None
    for word in words[2:3]:
        match = re.match(rf"^https://github\.com/({NAME})/({NAME})/", word)
        if match:
            return f"{match.group(1)}/{match.group(2)}".lower()
    return None


def gh_cache_opaque(args: list[str]) -> bool:
    """Whether part of a `gh api` request comes from somewhere not on the line: `--input`, or a typed
    field whose value is `@FILE`."""
    for i, arg in enumerate(args):
        if arg == "--input" or arg.startswith("--input="):
            return True
        value = None
        if arg in ("-F", "--field") and i + 1 < len(args):
            value = args[i + 1]
        elif arg.startswith("--field="):
            value = arg[len("--field="):]
        elif arg.startswith("-F") and len(arg) > 2:
            value = arg[2:]
        if value is not None and value.partition("=")[2].startswith("@"):
            return True
    return False


def gh_cache_anywhere(words: list[str]) -> bool:
    """A read whose answer does not depend on which repository the working directory is in."""
    return bool(words) and words[0] in GH_CACHE_ANYWHERE


def gh_cache_is_write(args: list[str], words: list[str], method: str) -> bool:
    """Whether this call may change something on GitHub. Unknown counts as a write."""
    first, second = (words + ["", ""])[:2]
    if first == "api":
        if method != "GET" and not AUDIT_GRAPHQL_RE.match(second):
            return True
        # GraphQL is a POST whether it reads or writes; only the query says which. A body this
        # cannot read (`--input FILE`, `-F query=@FILE`) counts as a write.
        if not AUDIT_GRAPHQL_RE.match(second):
            return False
        return any(GH_CACHE_MUTATION_RE.search(a) for a in args) or gh_cache_opaque(args)
    if not first:
        return False  # bare `gh`, or only flags: help
    return (first, second) not in GH_CACHE_PURE and (first, None) not in GH_CACHE_PURE


def gh_cache_identity(real: str | None, data: bool = False) -> str:
    """A digest of who gh will be and which gh it is: any token in the environment, the config
    directory and the contents of its hosts.yml (the active account; `gh auth switch` rewrites it),
    and the real gh's path. Only the digest is kept, never a token. With `data` (gh prints JSON or a
    template to a pipe: GH_CACHE_DATA_FLAGS), only the variables that can force a terminal's output
    onto a pipe are in it, not the whole output environment."""
    parts = [os.environ.get(name) or "" for name in ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN",
                                                       "GITHUB_ENTERPRISE_TOKEN", "GH_CONFIG_DIR")]
    hosts = gh_hosts_file()
    try:
        parts.append(hosts.read_text() if hosts is not None else "")
    except OSError:
        parts.append("?")
    parts.append(real or "")
    output = GH_CACHE_FORCE_ENV if data and not any(os.environ.get(n) for n in ("GH_FORCE_TTY", "CLICOLOR_FORCE")) \
        else GH_CACHE_OUTPUT_ENV
    parts += [f"{name}={os.environ.get(name, '')}" for name in output]
    return hashlib.sha256("\0".join(parts).encode()).hexdigest()


def gh_cache_key(args: list[str], words: list[str], values: dict[str, str], seen: set[str],
                 method: str, real: str | None = None) -> str | None:
    """The answer cache's key for this call, or None when it is not a call the cache keeps."""
    if gh_cache_ttl() <= 0 or os.environ.get("GLAEDA_GH_CACHE_DISABLE") == "1" or sys.stdout.isatty() \
            or any(os.environ.get(name) for name in GH_CACHE_DEBUG_ENV):
        return None
    head = tuple(words[:2])
    graphql = head[:1] == ("api",) and len(words) > 1 and bool(AUDIT_GRAPHQL_RE.match(words[1]))
    if graphql:
        # A GraphQL read is a POST, so the method says nothing: the query does. gh_cache_is_write
        # calls a mutation, or a body read from a file, a write; anything else is a read.
        if gh_cache_is_write(args, words, method):
            return None
    elif head[:1] == ("api",):
        if method != "GET" or len(words) < 2 or BROKER_FREE_RE.match(words[1]):
            return None
    elif head in GH_CACHE_TARGETED:
        if len(words) != 3 or not GH_CACHE_TARGET_RE.match(words[2]):
            return None  # see GH_CACHE_TARGETED
    elif head in GH_CACHE_LISTS or gh_cache_anywhere(words):
        pass
    elif head not in GH_CACHE_READS or len(words) < 3:
        return None  # `pr view` with no target reads the checked-out branch, which is not on the line
    if seen & GH_CACHE_NEVER:
        return None
    # The repository gh resolves from the working directory when the line names none, and the
    # `{owner}`/`{repo}`/`{branch}` placeholders `gh api` fills from it, make the directory part of
    # the question. The token is too (an installation token sees other repositories than the
    # user's), so its digest is in the key; the token itself is never written anywhere.
    if any("{branch}" in a for a in args) or gh_cache_opaque(args):
        return None  # the checked-out branch, or a file's contents: neither is on the line
    placeholders = any(p in a for a in args for p in ("{owner}", "{repo}"))
    resolved = None
    if placeholders or (head[:1] != ("api",) and not gh_cache_anywhere(words)
                        and gh_cache_repo(words, values) is None):
        # gh fills these from the working directory's checkout. Keyed on the repository that
        # resolves to, by broker_repo's rule (which declines anything it cannot be sure of), so a
        # directory whose remote changed is a different question.
        resolved = broker_repo(values)
        if resolved is None:
            return None
    # A GraphQL question is its query and variables, in whatever order the flags came: two
    # scripts asking for the same page share one answer.
    question = gh_cache_graphql_question(args) if graphql else (gh_cache_canonical(args) or args)
    data = head[:1] == ("api",) or bool(seen & GH_CACHE_DATA_FLAGS)
    ident = [question, resolved, os.environ.get("GH_REPO") or "", os.environ.get("GH_HOST") or "",
             gh_cache_identity(real, data)]
    return hashlib.sha256(json.dumps(ident).encode()).hexdigest()[:40]


GH_CACHE_FIELD_FLAGS = {"-f": "f", "--raw-field": "f", "-F": "F", "--field": "F"}


def gh_cache_graphql_question(args: list[str]) -> list:
    """[fields as `f:name=value` / `F:name=value`, every other argument in order]. The kind stays in
    each field because `-F n=1` sends a number and `-f n=1` a string."""
    fields, other, i = [], [], 0
    while i < len(args):
        arg = args[i]
        name, eq, value = arg.partition("=")
        if arg in GH_CACHE_FIELD_FLAGS and i + 1 < len(args):
            fields.append(f"{GH_CACHE_FIELD_FLAGS[arg]}:{args[i + 1]}")
            i += 2
            continue
        if eq and name in ("--raw-field", "--field"):
            fields.append(f"{GH_CACHE_FIELD_FLAGS[name]}:{value}")
        elif arg[:2] in ("-f", "-F") and len(arg) > 2:
            fields.append(f"{arg[1]}:{arg[2:]}")
        else:
            other.append(arg)
        i += 1
    # gh keeps the last of a repeated field and sends `name[]` fields as an array in order, so a field
    # name that repeats makes the order part of the question: sorted only when every name is unique.
    names = [f[2:].partition("=")[0] for f in fields]
    if len(set(names)) == len(names) and not any(n.endswith("[]") for n in names):
        fields = sorted(fields)
    return [fields, other]


def gh_cache_canonical(args: list[str]) -> list | None:
    """The question a non-GraphQL call asks, with the spelling taken out: flags in one order (a flag
    given twice keeps its occurrences in order, since gh keeps the last or appends), each by one
    name, glued values split off, `--repo` and `--json` lists normalised, an API path without its
    host or leading slash and with its query in order, and a PR URL as its number and repository.

    None -- the line is used as typed -- when any flag on it is one this does not know to take a
    value or not, or the line has a `--`: moving such a flag could hand it the next word."""
    words: list[str] = []
    flags: list[tuple[str, str | None]] = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            return None
        if arg.startswith("--") and "=" in arg:
            name, value = arg.split("=", 1)
            if name not in BROKER_VALUE_FLAGS:
                return None
        elif arg.startswith("-") and arg != "-":
            name, value = arg, None
            if not arg.startswith("--") and len(arg) > 2:
                if arg[:2] not in BROKER_VALUE_FLAGS:
                    return None  # `-abc`: several short flags in one word
                name, value = arg[:2], arg[2:]
            elif name in BROKER_VALUE_FLAGS:
                if i + 1 >= len(args):
                    return None  # gh rejects it; keep the line as typed
                value = args[i + 1]
                i += 1
            elif name not in GH_CACHE_BOOL_FLAGS:
                return None
        else:
            words.append(arg)
            i += 1
            continue
        name = GH_CACHE_FLAG_ALIAS.get(name, name)
        if name == "--repo" and value is not None:
            value = value.rstrip("/").lower()
        elif name == "--json" and value is not None:
            # gh prints the fields as one JSON object whose keys Go sorts, so the order asked in and
            # a field asked twice change nothing gh prints.
            value = ",".join(sorted({f for f in value.split(",") if f}))
        flags.append((name, value))
        i += 1
    if words[:1] == ["api"] and len(words) > 1:
        # gh drops a leading slash from a path. The host stays: `https://api.github.com/x` and `x` are
        # one request only when gh's own host is github.com, which this does not decide.
        path = words[1] if "://" in words[1] else words[1].lstrip("/")
        base, mark, query = path.partition("?")
        pairs = [q for q in query.split("&") if q]
        if mark and len({q.partition("=")[0] for q in pairs}) == len(pairs):
            query = "&".join(sorted(pairs))  # a name given twice is an array: order kept
        words[1] = base + (f"?{query}" if mark and query else "")
    elif tuple(words[:2]) in {("pr", "view"), ("pr", "checks"), ("pr", "diff"), ("issue", "view")} \
            and len(words) == 3 and not any(name == "--repo" for name, _ in flags):
        match = GH_CACHE_PR_URL_RE.match(words[2])
        # `issue view` of a pull URL is answered by gh as the PR, and `pr view` of an issues URL is
        # an error: only the URL kind that matches the subcommand is rewritten.
        kind = "issues" if words[0] == "issue" else "pull"
        if match and f"/{kind}/" in words[2]:
            words[2] = match.group(3)
            flags.append(("--repo", f"{match.group(1)}/{match.group(2)}".lower()))
    # Stable: one flag's repeats keep their order, and so do all request fields together.
    flags.sort(key=lambda flag: "--field" if flag[0] in GH_CACHE_FIELD_GROUP else flag[0])
    return ["canonical", words, [list(flag) for flag in flags]]


def gh_cache_target(words: list[str], values: dict[str, str], repo: str | None) -> list | None:
    """[kind, owner/repo, id] for an answer about one PR or issue ("pr"), run ("run") or job ("job"),
    or None for anything else (a list, a search, an endpoint about the repository)."""
    first, second = (words + ["", ""])[:2]
    if first == "api" and len(words) > 1:
        for kind, pattern in (("pr", GH_CACHE_API_PR_RE), ("run", GH_CACHE_API_RUN_RE), ("job", GH_CACHE_API_JOB_RE)):
            match = pattern.match(words[1])
            if match:
                return [kind, f"{match.group(1)}/{match.group(2)}".lower(), match.group(3)]
        return None
    if (first, second) in {("pr", "view"), ("pr", "checks"), ("pr", "diff"), ("issue", "view")} and len(words) == 3:
        match = GH_CACHE_PR_URL_RE.match(words[2])
        if match:
            return ["pr", f"{match.group(1)}/{match.group(2)}".lower(), match.group(3)]
        if re.fullmatch(r"\d+", words[2]) and repo:
            return ["pr", repo, str(int(words[2]))]
        return None
    if (first, second) == ("run", "view") and repo:
        if len(words) == 3 and re.fullmatch(r"\d+", words[2]):
            return ["run", repo, words[2]]
        if len(words) == 2 and re.fullmatch(r"\d+", values.get("--job") or ""):
            return ["job", repo, values["--job"]]
    return None


def gh_cache_stamps(target: list | None, repo: str | None, words: list[str] | None = None) -> list[str] | None:
    """The writes.json entries that make an answer old: one about `target`, or about `repo` when it
    is about nothing narrower (a list of workflow runs has a scope of its own, "runlists"). None when the
    answer names no repository (every write counts)."""
    if target is None and repo and words and (
            tuple(words[:2]) == ("run", "list")
            or (words[:1] == ["api"] and len(words) > 1 and GH_CACHE_API_RUNS_LIST_RE.match(words[1]))):
        return ["*", repo, f"{repo} runlists"]
    if target:
        kind, repo, ident = target
        narrow = {"pr": [f"{repo} pr {ident}", f"{repo} prs"], "run": [f"{repo} run {ident}", f"{repo} runs"],
                  "job": [f"{repo} jobs", f"{repo} runs"]}[kind]
        return ["*", repo, *narrow]
    if repo:
        return ["*", repo, f"{repo} other"]
    return None


def gh_cache_write_scope(args: list[str], words: list[str], method: str,
                         values: dict[str, str]) -> tuple[str | None, list[str]]:
    """(repository or None, the scopes this write stamps): "pr N", "run ID", "prs" (every PR's
    mergeability or checks), "runs" (every run), "jobs", "runlists" (the lists of workflow runs: a
    write that can start one) and "other" (the other lists, and everything not one target). [] is
    the whole repository, as every write was before; a write naming no repository stamps every one.

    Narrow only where what the write changes is known: anything else, a GraphQL mutation included,
    stays as wide as it was."""
    repo = gh_cache_repo(words, values)
    if repo is None:
        repo = broker_repo(values) if words[:1] != ["api"] else None
    if repo is None:
        return None, []
    first, second = (words + ["", ""])[:2]
    rest = words[2:]
    if first == "api":
        if AUDIT_GRAPHQL_RE.match(second):
            return repo, []
        path = re.sub(r"^https://api\.github\.com/", "", second).lstrip("/").split("?")[0]
        tail = path.split("/")[3:]  # after repos/OWNER/REPO
        if len(tail) >= 2 and tail[0] in ("pulls", "issues") and tail[1].isdigit():
            if tail[0] == "pulls" and tail[2:3] and tail[2] in GH_CACHE_BASE_WRITES:
                return repo, [f"pr {int(tail[1])}", "prs", "runlists", "other"]
            # An edit, a label, a comment or a review: each can start a workflow (pull_request,
            # issues, issue_comment, pull_request_review), so the run lists go with them.
            return repo, [f"pr {int(tail[1])}", "runlists", "other"]
        if tail in (["issues"], ["pulls"]):
            return repo, ["runlists", "other"]  # a new issue or PR: issues.opened, pull_request
        if len(tail) >= 3 and tail[:2] == ["actions", "runs"] and tail[2].isdigit():
            return repo, [f"run {tail[2]}", "runlists", "jobs", "prs", "other"]
        if len(tail) >= 3 and tail[:2] == ["actions", "jobs"] and tail[2].isdigit():
            return repo, ["runs", "runlists", "jobs", "prs", "other"]
        if len(tail) >= 4 and tail[:2] == ["actions", "workflows"] and tail[3] == "dispatches":
            return repo, ["runlists", "prs", "other"]  # a new run: its checks reach a PR on that branch
        return repo, []
    rest = gh_cache_write_positionals(args)
    if rest is None:
        return repo, []
    rest = rest[2:]
    number = next((w for w in rest[:1] if re.fullmatch(r"\d+", w)), None)
    url = GH_CACHE_PR_URL_RE.match(rest[0]) if rest else None
    if url:
        number = url.group(3)
    if first in ("pr", "issue") and number is not None and len(rest) == 1:
        if first == "pr" and second in GH_CACHE_BASE_WRITES:
            return repo, [f"pr {int(number)}", "prs", "runlists", "other"]
        if second in GH_CACHE_TARGET_WRITES:
            # A label, a ready-for-review, a reopen, a comment or a review can each start a workflow
            # (pull_request, issue_comment, pull_request_review): the run lists go with them.
            return repo, [f"pr {int(number)}", "runlists", "other"]
    if (first, second) in {("pr", "create"), ("issue", "create")}:
        return repo, ["runlists", "other"]  # pull_request, issues.opened
    if first == "run" and second in GH_CACHE_RUN_WRITES and rest[:1] and rest[0].isdigit() and len(rest) == 1:
        return repo, [f"run {rest[0]}", "runlists", "jobs", "prs", "other"]
    if (first, second) == ("workflow", "run"):
        return repo, ["runlists", "prs", "other"]
    return repo, []


def gh_cache_write_positionals(args: list[str]) -> list[str] | None:
    """The positional words of a `gh pr|issue|run|workflow` write, or None when a flag on it is in
    neither GH_CACHE_WRITE_VALUE_FLAGS nor GH_CACHE_WRITE_BOOL_FLAGS (its value could be read as the
    PR's number) or the line has a `--`."""
    words, i = [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            return None
        if arg.startswith("-") and arg != "-":
            name = arg.split("=", 1)[0]
            if "=" in arg and name.startswith("--"):
                pass
            elif not name.startswith("--") and len(name) > 2:
                if name[:2] not in GH_CACHE_WRITE_VALUE_FLAGS:
                    return None  # `-abc`, or a glued value on a flag this does not know
            elif name in GH_CACHE_WRITE_VALUE_FLAGS:
                i += 1
            elif name not in GH_CACHE_WRITE_BOOL_FLAGS:
                return None
        else:
            words.append(arg)
        i += 1
    return words


def gh_cache_post_scopes(item: dict) -> list[str]:
    """What a queued `post` changes, as gh_cache_write_scope has it for the same write made directly: a
    comment or review its PR or issue, the lists and the run lists (it can start a workflow); a new PR
    the lists and the run lists. Anything else stamps the whole repository."""
    number = item.get("number")
    if item.get("kind") in ("comment", "review") and isinstance(number, int) and not isinstance(number, bool):
        return [f"pr {number}", "runlists", "other"]
    if item.get("kind") == "pr":
        return ["runlists", "other"]
    return []


GH_CACHE_WATCH_KIND = {"pr": "pr", "run": "run"}


def gh_cache_watch(target: list | None) -> tuple[str, dict] | None:
    """(daemon key, its cached entry) for the PR or run an answer is about, when glaeda's daemon holds
    data for it; None otherwise. Never raises: this is a lookup in front of a gh call."""
    if not target or target[0] not in GH_CACHE_WATCH_KIND:
        return None
    kind, repo, ident = target
    try:
        key = parse_key(kind, f"{repo}{'#' if kind == 'pr' else '/'}{ident}")
        entry = read_cache(key)
    except (WatchError, OSError, ValueError):
        return None
    if not isinstance(entry, dict) or not isinstance(entry.get("data"), dict):
        return None
    return key, entry


def gh_cache_watch_mark(kind: str, entry: dict) -> str:
    """A digest of what the daemon holds for one target: its data, and a run's jobs. It changes when
    the daemon has seen the target change, which is what an answer kept beside it is checked against."""
    held = {"data": entry.get("data"), "jobs": entry.get("jobs") if kind == "run" else None}
    return hashlib.sha256(json.dumps(held, sort_keys=True, default=str).encode()).hexdigest()[:32]


def gh_cache_done(words: list[str], seen: set[str], out: bytes) -> bool:
    """Whether a stored answer can no longer change: a completed job, or every job of one attempt
    completed. Read from the answer itself, so only for a raw `gh api` read (no --jq or template)."""
    if words[:1] != ["api"] or len(words) < 2 or seen & {"--jq", "-q", "--template", "-t", "--paginate"}:
        return False
    path = re.sub(r"^https://api\.github\.com/", "", words[1]).lstrip("/").split("?")[0]
    try:
        doc = json.loads(out)
    except ValueError:
        return False
    if not isinstance(doc, dict):
        return False
    if re.fullmatch(rf"repos/{NAME}/{NAME}/actions/jobs/\d+/?", path):
        return doc.get("status") == "completed"
    if re.fullmatch(rf"repos/{NAME}/{NAME}/actions/runs/\d+/attempts/\d+/jobs/?", path):
        jobs = doc.get("jobs")
        return (isinstance(jobs, list) and bool(jobs) and doc.get("total_count") == len(jobs)
                and all(isinstance(j, dict) and j.get("status") == "completed" for j in jobs))
    return False


def gh_cache_writes() -> dict[str, float]:
    doc = read_json(gh_cache_dir() / "writes.json")
    return {str(k): float(v) for k, v in (doc if isinstance(doc, dict) else {}).items()
            if isinstance(v, (int, float)) and not isinstance(v, bool)}


GH_RERUN_API_RE = re.compile(r"^/?repos/[^/]+/[^/]+/actions/runs/\d+/rerun(?:-failed-jobs)?/?$")


def note_run_rerun(repo: str | None, scopes: list[str] | None, words: list[str], now: float) -> None:
    """A brokered `gh run rerun N` (or its API POST) on a run this host caches: stamp the entry rerunAt, so a wait
    and `Daemon.due` treat its cached finish as attempt-unknown until GitHub is read again (run_unconfirmed).
    Stamped when the write starts and again when it ends (gh_cache_write), so a read while it was in flight does not
    count; a rerun that fails costs one more read, never a wrong answer."""
    rerun = (words[:2] == ["run", "rerun"]
             or (words[:1] == ["api"] and len(words) > 1 and bool(GH_RERUN_API_RE.match(words[1]))))
    run_id = next((x.split(" ", 1)[1] for x in scopes or [] if x.startswith("run ")), None)
    if not rerun or not repo or not run_id:
        return
    key = f"run:{repo}/{run_id}"
    cache = cache_dir() / file_name(key)
    with contextlib.suppress(OSError), bounded_lock(cache_dir() / ".write.lock") as held:
        entry = read_json(cache) if held and cache.exists() else None
        if isinstance(entry, dict):
            write_json(cache, {**entry, "rerunAt": now})


def gh_cache_note_write(repo: str | None, now: float, scopes: list[str] | None = None) -> None:
    """Stamp a write, so no answer read before it is served after it. A write is stamped when it
    starts and again when it finishes (gh_cache_write), so a read that began while it was in flight
    is older than the second stamp and is not served either. Bounded like every lock here: losing
    a stamp to a wedged sibling costs at most one TTL of staleness, never the gh call.

    `scopes` (gh_cache_write_scope) narrows the stamp to what the write can change within `repo`;
    none stamps the whole repository, and no repository stamps every answer on the host."""
    names = [f"{repo} {scope}" for scope in scopes] if repo and scopes else [repo or "*"]
    with bounded_lock(gh_cache_dir().parent / ".answers-writes.lock"):
        writes = {k: v for k, v in gh_cache_writes().items() if now - v < GH_CACHE_KEEP}
        for name in names:
            writes[name] = max(writes.get(name, 0.0), now)
        write_json(gh_cache_dir() / "writes.json", writes)


def gh_cache_get(key: str, repo: str | None, now: float) -> dict | None:
    """The stored answer for `key`, if it is younger than the TTL and than every write that could
    have changed it, and glaeda's daemon has seen no change in the PR or run it is about."""
    doc = read_json(gh_cache_dir() / f"{key}.json")
    if not isinstance(doc, dict) or doc.get("key") != key or not isinstance(doc.get("at"), (int, float)):
        return None
    at = float(doc["at"])
    ttl = gh_cache_ttl()
    long = ttl > 0 and doc.get("long") is True
    if long:
        ttl = max(ttl, GH_CACHE_LONG_TTL)
    watch = doc.get("watch")
    watched = None  # the daemon's entry when it still holds what it held at the read; None unknown
    if isinstance(watch, list) and len(watch) == 3 and all(isinstance(x, str) for x in watch):
        daemon_key, mark, kind = watch
        entry = None
        with contextlib.suppress(Exception):
            entry = read_cache(daemon_key)
        if isinstance(entry, dict) and isinstance(entry.get("data"), dict):
            if gh_cache_watch_mark(kind, entry) != mark:
                # The daemon read this PR or run again since the answer was taken, and what it read
                # is different: a push, a new check, a rerun, a merge -- from this host or any other.
                return None
            watched = entry
        # No entry any more (the watch lapsed): nothing to compare with, so the TTL and the write
        # stamps decide, as for an answer the daemon never held.
    if ttl > 0 and not long and (doc.get("done") is True or (
            watched and doc.get("doneWhenRead") is True and isinstance(watched.get("fetchedAt"), (int, float))
            and now - watched["fetchedAt"] < TERMINAL_REFRESH + 2 * CYCLE)):
        # Cannot change (a completed job), or a completed run whose daemon copy is still being read
        # and has not changed since. A rerun reaches that copy through the controller's webhook
        # within a tick, or the daemon's own re-read of a finished run (TERMINAL_REFRESH) when the
        # controller misses it -- the same bound `wait run` lives with -- and a rerun from this host
        # stamps the run at once. Never past what the daemon would see: GH_CACHE_DONE_TTL is
        # TERMINAL_REFRESH.
        ttl = max(ttl, GH_CACHE_DONE_TTL)
    if not 0 <= now - at < ttl:
        return None
    writes = gh_cache_writes()
    stamps = doc.get("stamps")
    if isinstance(stamps, list) and all(isinstance(x, str) for x in stamps):
        newest = max([writes.get(name, 0.0) for name in stamps] + [0.0])
    else:
        # An answer kept before writes were scoped, or one naming no repository: every write to its
        # repository counts, however narrowly it was stamped.
        newest = max([writes.get("*", 0.0)] + ([v for k, v in writes.items() if k == repo or k.startswith(f"{repo} ")]
                                               if repo else list(writes.values())))
    if newest >= at:
        return None
    try:
        return {"rc": int(doc["rc"]), "out": base64.b64decode(doc["out"]), "err": base64.b64decode(doc["err"])}
    except (KeyError, TypeError, ValueError):
        return None


def gh_cache_put(key: str, at: float, rc: int, out: bytes, err: bytes, long: bool = False,
                 meta: dict | None = None) -> None:
    """Keep one answer. `meta` carries what makes it old (gh_cache_meta): the write stamps it is
    checked against, the daemon entry it is checked against, and whether it can still change."""
    if rc != 0 or len(out) + len(err) > GH_CACHE_MAX_BYTES:
        return
    doc = {"key": key, "at": at, "rc": rc, "long": long,
           "out": base64.b64encode(out).decode(), "err": base64.b64encode(err).decode()}
    doc.update({k: v for k, v in (meta or {}).items() if k in ("stamps", "watch", "doneWhenRead", "done")})
    write_json(gh_cache_dir() / f"{key}.json", doc)
    gh_cache_prune(at)


def gh_cache_meta(words: list[str], values: dict[str, str], repo: str | None) -> dict:
    """What an answer about to be read must be checked against later, taken before gh runs: the write
    stamps for its target (gh_cache_stamps) and, when glaeda's daemon holds the PR or run, a mark of
    what it holds now. A mark taken before the read can only be older than the answer, so a change
    the daemon sees afterwards always drops it -- never the other way round."""
    target = gh_cache_target(words, values, repo)
    meta: dict[str, Any] = {}
    stamps = gh_cache_stamps(target, repo, words)
    if stamps is not None:
        meta["stamps"] = stamps
    held = gh_cache_watch(target)
    if held is not None:
        daemon_key, entry = held
        kind = daemon_key.split(":", 1)[0]
        meta["watch"] = [daemon_key, gh_cache_watch_mark(kind, entry), kind]
        meta["doneWhenRead"] = kind == "run" and terminal("run", entry.get("data"))
    return meta


def gh_cache_prune(now: float) -> None:
    """Delete stored answers past GH_CACHE_KEEP, and fill locks past GH_CACHE_LOCK_KEEP, at most once a
    GH_CACHE_PRUNE_EVERY. A lock file is removed only while this holds it, and a fill checks after taking
    its lock that the file is still the one at the path (gh_cache_fill_lock), so a fill that took a lock just
    removed gives up rather than run beside one holding the new file."""
    stamp = gh_cache_dir() / ".pruned"
    with contextlib.suppress(OSError):
        if now - stamp.stat().st_mtime < GH_CACHE_PRUNE_EVERY:
            return
    with contextlib.suppress(OSError):
        stamp.touch()
        for path in gh_cache_dir().glob("*.json"):
            if path.name != "writes.json" and now - path.stat().st_mtime > GH_CACHE_KEEP:
                path.unlink(missing_ok=True)
        for path in gh_cache_dir().glob(".*.lock"):
            if now - path.stat().st_mtime <= GH_CACHE_LOCK_KEEP:
                continue
            with contextlib.suppress(OSError), open(path, "a+") as handle:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    continue  # a fill holds it: in use, so not old
                if now - os.fstat(handle.fileno()).st_mtime > GH_CACHE_LOCK_KEEP:
                    path.unlink(missing_ok=True)


def gh_cache_emit(answer: dict) -> int:
    """Print a stored answer exactly as gh printed it."""
    for stream, data in ((sys.stdout, answer["out"]), (sys.stderr, answer["err"])):
        if not data:
            continue
        target = getattr(stream, "buffer", None)
        if target is not None:
            stream.flush()
            target.write(data)
            target.flush()
        else:
            stream.write(data.decode("utf-8", "replace"))
            stream.flush()
    return answer["rc"]


def gh_cache_child(real: str, args: list[str], capture: bool, deadline: float | None) -> tuple[int, bytes, bytes]:
    """Run the real gh once as a child, in the caller's own process group, so whoever bounds the
    caller (run_bounded kills a whole group) bounds gh too. With `capture`, a deadline after which
    gh is killed (exit 124); without, it shares the terminal and the caller's stdio. ^C reaches gh
    from the terminal as it would without the broker; the broker ignores it only once gh is running,
    so it waits for gh's own exit and stamps the write."""
    env = dict(os.environ)
    # A child, not an exec, so the hop mark (scoped to this pid) means nothing to it; the depth
    # count is what keeps a wrapper that hands gh back here finite.
    env[BROKER_DEPTH] = str(broker_depth() + 1)
    env.pop(BROKER_MARK, None)
    if capture:
        with subprocess.Popen([real, *args], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE) as proc:
            try:
                out, err = proc.communicate(timeout=deadline)
            except subprocess.TimeoutExpired:
                proc.kill()
                # A grandchild may still hold the pipes; it is in the caller's group, so the
                # caller's own bound reaches it. Not waiting for it here is what keeps this one.
                with contextlib.suppress(subprocess.TimeoutExpired):
                    proc.communicate(timeout=GH_CACHE_DRAIN)
                return 124, b"", f"glaeda-gh: gh ran past {int(deadline or 0)} s and was stopped\n".encode()
            return proc.returncode, out, err
    with subprocess.Popen([real, *args], env=env) as proc:
        # Set only after the fork: a disposition of SIG_IGN would survive gh's exec, and ^C would
        # then not stop a write it stops without the broker.
        previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
        forward = signal.signal(signal.SIGTERM, lambda *_: proc.send_signal(signal.SIGTERM))
        try:
            code = proc.wait()
        finally:
            signal.signal(signal.SIGTERM, forward)
            signal.signal(signal.SIGINT, previous)
    return (128 - code if code < 0 else code), b"", b""


@contextlib.contextmanager
def gh_cache_fill_lock(path: Path, seconds: float):
    """bounded_lock for a fill, plus one check: once held, the file must still be the one at `path`. The
    pruner removes an old lock file only while holding it, but a fill that opened the file before the removal
    can take it after; that fill yields False, as for a lock it could not get, instead of filling beside a
    fill holding the new file."""
    try:
        handle = open(path, "a+")
    except OSError:
        yield False
        return
    held = False
    deadline = time.monotonic() + seconds
    try:
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = True
                break
            except OSError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.02)
        if held:
            try:
                held = os.stat(path).st_ino == os.fstat(handle.fileno()).st_ino
            except OSError:
                held = False
            if held:
                os.utime(path)  # in use: the pruner's clock starts again
        yield held
    finally:
        with contextlib.suppress(OSError):
            handle.close()


def gh_cache_fill(real: str, args: list[str], key: str, repo: str | None, ran: list[int],
                  note: dict | None = None) -> int | None:
    """Run the real gh once for `key` and keep its answer; an identical call already doing that is
    waited for instead. None when the key's lock could not be had in GH_CACHE_FILL_WAIT: the caller
    then runs gh the ordinary way. Once gh has run its exit code is in `ran`, so a caller that
    catches an error from here knows not to run it a second time.

    `note` is the call's "pass" decision: written when gh runs here, replaced by a "cache" one when a
    sibling's answer serves it, and left to the caller when the lock could not be had. One decision
    per call, so the audit does not count a waited call as both."""
    gh_cache_dir().mkdir(parents=True, exist_ok=True, mode=0o700)
    note = note if note is not None else {"route": "pass"}
    with gh_cache_fill_lock(gh_cache_dir() / f".{key}.lock", GH_CACHE_FILL_WAIT) as held:
        if not held:
            return None  # the caller runs gh, and writes the note
        answer = gh_cache_get(key, repo, time.time())
        if answer is not None:
            broker_note({"route": "cache", "waited": True, **({"line": note["line"]} if "line" in note else {})})
            ran.append(answer["rc"])
            return gh_cache_emit(answer)
        words, _method, seen, values = broker_words(args)
        meta: dict = {}
        with contextlib.suppress(Exception):
            meta = gh_cache_meta(words, values, repo)
        broker_note({**{k: v for k, v in note.items() if k != "written"}, "filled": True})
        note["written"] = True  # the caller's record: it must not write the decision a second time
        at = time.time()
        rc, out, err = gh_cache_child(real, args, True, GH_CACHE_FILL_DEADLINE)
        ran.append(rc)
        with contextlib.suppress(Exception):
            long = words[:1] == ["api"] and len(words) > 1 and bool(GH_CACHE_LONG_RE.match(words[1]))
            meta["done"] = rc == 0 and gh_cache_done(words, seen, out)
            gh_cache_put(key, at, rc, out, err, long, meta)
    return gh_cache_emit({"rc": rc, "out": out, "err": err})


def gh_cache_write(real: str, args: list[str], repo: str | None, ran: list[int],
                   scopes: list[str] | None = None, words: list[str] | None = None) -> int:
    """Run a write as a child and stamp it again once it finished, so nothing read while it was in
    flight outlives it (a rerun's run entry too: note_run_rerun)."""
    try:
        rc, _out, _err = gh_cache_child(real, args, False, None)
        ran.append(rc)
    finally:
        if ran:
            with contextlib.suppress(Exception):
                gh_cache_note_write(repo, time.time(), scopes)
            with contextlib.suppress(Exception):
                note_run_rerun(repo, scopes, words or [], time.time())
    return rc


# -- occupancy sweeps: one runners read instead of a jobs read per run
#
# "Which runners are busy" was being answered by listing the in-progress runs and then reading
# every run's jobs (or every job) for its runner_name: 60-200 REST requests per sweep, from a loop
# that ran every few minutes. `glaeda-gh runners OWNER` answers the same question from GitHub's
# runner list, which carries `busy` and the labels for each runner: a page per 100 runners, shared
# by every session on the host for the answer cache's TTL. A caller still sweeping per-job reads
# past GH_SWEEP_MAX distinct runs or jobs in GH_SWEEP_WINDOW is refused with a message naming it.
# Polling one run's jobs is one target however often it is read, so it is never counted as a sweep.
GH_SWEEP_RE = re.compile(rf"^(?:https?://api\.github\.com/)?/?repos/({NAME})/({NAME})/actions/"
                         r"(?:runs/(\d+)(?:/attempts/\d+)?/jobs|jobs/(\d+))/?(?:\?.*)?$")
GH_SWEEP_MAX = 30
GH_SWEEP_WINDOW = 600.0
GH_SWEEP_EXIT = 2


def gh_sweep_target(words: list[str], method: str) -> str | None:
    """`o/r run 5` or `o/r job 7` for a per-run jobs read or a per-job read; None for anything else."""
    if len(words) < 2 or words[0] != "api" or method != "GET":
        return None
    match = GH_SWEEP_RE.match(words[1])
    if not match:
        return None
    owner, repo, run, job = match.groups()
    return f"{owner}/{repo} run {run}".lower() if run else f"{owner}/{repo} job {job}".lower()


def gh_sweep_refusal(words: list[str], method: str, now: float) -> str | None:
    """The refusal for a caller past GH_SWEEP_MAX distinct jobs targets in GH_SWEEP_WINDOW, or None.
    Bounded like every lock here: an unheld lock lets the call through uncounted."""
    target = gh_sweep_target(words, method)
    if target is None or os.environ.get("GLAEDA_GH_SWEEP_OK") == "1":
        return None
    caller = broker_caller()
    path = BASE / "broker-sweeps.json"
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with bounded_lock(BASE / ".broker-sweeps.lock") as held:
        if not held:
            return None
        doc = read_json(path)
        callers: dict[str, dict[str, float]] = {}
        for who, seen in (doc if isinstance(doc, dict) else {}).items():
            if isinstance(seen, dict):
                kept = {t: float(at) for t, at in seen.items()
                        if isinstance(at, (int, float)) and now - float(at) < GH_SWEEP_WINDOW}
                if kept:
                    callers[str(who)] = kept
        mine = callers.setdefault(caller, {})
        if target not in mine and len(mine) >= GH_SWEEP_MAX:
            owner = target.split("/")[0]
            return (f"glaeda-gh: refused: this caller read the jobs of {len(mine)} different runs or jobs in the last "
                    f"{int(GH_SWEEP_WINDOW // 60)} minutes, which is a runner-occupancy sweep and spends a REST request "
                    f"each from the quota every session shares. `glaeda-gh runners {owner}` answers which runners are "
                    f"busy, and with which labels, from one read the whole host shares. A read that really needs "
                    f"every job can set GLAEDA_GH_SWEEP_OK=1.")
        mine[target] = now
        write_json(path, callers)
    return None


def cmd_runners(scope: str, label: str | None, as_json: bool) -> int:
    """Self-hosted runners of an org or repository: online, busy and idle, per label. Read through
    `gh` so the answer cache shares it with every session on the host for its TTL."""
    if re.fullmatch(NAME, scope):
        path = f"orgs/{scope}/actions/runners"
    elif re.fullmatch(rf"{NAME}/{NAME}", scope):
        path = f"repos/{scope}/actions/runners"
    else:
        raise WatchError("runners takes OWNER or OWNER/REPO")
    # Through this broker, piped, so the answer cache shares the read whether or not the gh shim
    # is on PATH.
    try:
        done = run_bounded([sys.executable, str(Path(__file__).resolve()), "gh", "api", "--paginate",
                            f"{path}?per_page=100", "--jq",
                            ".runners[] | {name, status, busy, labels: [.labels[].name]}"], timeout=120)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WatchError(f"gh api {path}: {describe(error)}") from None
    if done.returncode != 0:
        raise WatchError(f"gh api {path}: {(done.stderr or '').strip()[:300]}")
    try:
        runners = [json.loads(line) for line in done.stdout.splitlines() if line.strip()]
    except ValueError as error:
        raise WatchError(f"gh api {path}: unreadable answer: {error}") from None
    online = [r for r in runners if r.get("status") == "online" and (not label or label in r.get("labels", []))]
    labels: dict[str, dict[str, int]] = {}
    for r in online:
        for name in r.get("labels") or []:
            row = labels.setdefault(name, {"online": 0, "busy": 0})
            row["online"] += 1
            row["busy"] += bool(r.get("busy"))
    doc = {"scope": scope, "label": label, "runners": len(runners), "online": len(online),
           "busy": sum(1 for r in online if r.get("busy")), "labels": labels,
           "busyRunners": sorted(r["name"] for r in online if r.get("busy"))}
    if as_json:
        print(json.dumps(doc, sort_keys=True))
        return EXIT_OK
    print(f"{scope}: {doc['online']} online of {doc['runners']} registered, {doc['busy']} busy"
          + (f" (label {label})" if label else ""))
    for name, row in sorted(labels.items(), key=lambda kv: (-kv[1]["online"], kv[0])):
        print(f"  {name:48} {row['busy']:4} busy {row['online'] - row['busy']:4} idle")
    return EXIT_OK


# A merge reaches GitHub only through the host's gh-quota guard (leo-workspace tools/gh-quota-shim, PACE_CLI; the
# GLAEDA_MERGE_GUARD path overrides): merge_hold's holds, BLOCKs, review and pin checks, the merge line, the landing
# record and the transient-error retry all live there. broker_real_gh steps over every "gh guard" file, so a call
# typed as `glaeda-gh gh ...` reached the real gh with none of that: on 2026-11-05 leo-workspace#3589 was landed with
# `glaeda-gh gh api --method PUT .../pulls/3589/merge` after `gh pr merge` failed on GitHub's side, and merge_hold
# never saw it. A merge-shaped call that the guard has not judged (no GH_QUOTA_CHECKED, which the guard exports before
# it runs the next gh) is handed to the guard instead, PATH led by the guard's dir so it finds the gh after it as
# usual. The guard then reaches this broker again with GH_QUOTA_CHECKED set, and the call passes as before.
# A host with no guard refuses the merge rather than run it unjudged: nothing on the fleet merges through
# `glaeda-gh gh` on purpose, and `gh pr merge` is the documented route.
MERGE_GUARD_ENV = "GLAEDA_MERGE_GUARD"
BROKER_MERGE_MUTATIONS = re.compile(r"\b(?:mergePullRequest|enablePullRequestAutoMerge|enqueuePullRequest)\b")
BROKER_REST_MERGE = re.compile(r"^/?(?:https?://[^/]+/(?:api/v3/)?)?repos/[^/]+/[^/]+/pulls/\d+/merge/?$")


def broker_merge_call(args: list[str]) -> bool:
    """Whether this gh call can merge a PR: `gh pr merge`, a non-GET `gh api .../pulls/N/merge`, or a `gh api graphql`
    that names a merge mutation inline or reads any file or stdin (`--input`, `-F k=@F`). A file is never read here:
    it could change between this read and gh's (router-review F2 on #1878), so the guard, which snapshots it before it
    judges (merge_hold.snapshot), gets every such call. A `?query` suffix on the endpoint is ignored (F1)."""
    words, method, seen, _values = broker_words(args)
    if "--help" in seen or "-h" in seen or any(a.lower() in ("--help=true", "--help=1") for a in args):
        return False  # gh prints help and does nothing else (router-review F3 on #1878)
    if words[:2] == ["pr", "merge"]:
        return True
    if words[:1] != ["api"] or len(words) < 2:
        return False
    endpoint = words[1].split("?", 1)[0].split("#", 1)[0]
    # gh takes `HTTPS://API.GITHUB.COM/...` as well: the scheme and host are matched lowercased (F1, second review).
    endpoint = re.sub(r"^[A-Za-z][A-Za-z0-9+.-]*://[^/]*", lambda m: m.group(0).lower(), endpoint)
    if method != "GET" and BROKER_REST_MERGE.match(endpoint):
        return True
    if not AUDIT_GRAPHQL_RE.match(endpoint):
        return False
    for i, arg in enumerate(args):
        if arg == "--input" or arg.startswith("--input="):
            return True
        value = None
        if arg in ("-F", "--field") and i + 1 < len(args):
            value = args[i + 1].partition("=")[2]
        elif arg.startswith("--field="):
            value = arg[len("--field="):].partition("=")[2]
        elif arg.startswith("-F") and len(arg) > 2:
            value = arg[2:].partition("=")[2]
        if value and value.startswith("@"):
            return True
    return bool(BROKER_MERGE_MUTATIONS.search("\n".join(args)))


def broker_merge_handoff(args: list[str]) -> int | None:
    """Hand a merge the gh-quota guard has not judged to the guard (exec, so this returns only on failure), or None
    when the call is no such merge."""
    if os.environ.get("GH_QUOTA_CHECKED") or not broker_merge_call(args):
        return None
    # From here the call is a merge: anything that fails refuses it, never runs it unguarded (F2, second review).
    try:
        guard = Path(os.environ.get(MERGE_GUARD_ENV) or PACE_CLI)
        usable = guard.is_file() and os.access(guard, os.X_OK)
    except Exception as error:  # noqa: BLE001
        print(f"glaeda-gh: refused: {' '.join(['gh', *args][:3])} merges, and the gh-quota guard could not be "
              f"found: {describe(error)}", file=sys.stderr)
        return BROKER_EXIT_REFUSED
    if not usable:
        print(f"glaeda-gh: refused: {' '.join(['gh', *args][:3])} merges, and merges go through the host's gh-quota "
              f"guard (merge_hold), which is not at {guard}. Run `gh pr merge N --squash --match-head-commit SHA` "
              f"on a host with the guard (leo-workspace tools/host-baseline gh-quota).", file=sys.stderr)
        return BROKER_EXIT_REFUSED
    try:
        os.environ["PATH"] = os.pathsep.join([str(guard.parent), os.environ.get("PATH", "")])
        os.execv(str(guard), [str(guard), *args])
    except Exception as error:  # noqa: BLE001
        print(f"glaeda-gh: refused: cannot run the merge guard {guard}: {describe(error)}", file=sys.stderr)
        return BROKER_EXIT_REFUSED
    return EXIT_OK  # unreachable: execv replaces this process


def cmd_gh(args: list[str]) -> int:
    """Stand in front of one `gh` invocation. Fails open: anything unexpected runs the real gh."""
    # Before anything else, CMUX_GH_BROKER_DISABLE included: that switch skips this broker, never merge_hold.
    try:
        handed = broker_merge_handoff(args)
    except Exception as error:  # noqa: BLE001  the broker never fails a call: that is the whole contract
        broker_note({"route": "error", "error": describe(error), "site": "broker_merge_handoff"})
        handed = None
    if handed is not None:
        return handed
    if os.environ.get("CMUX_GH_BROKER_DISABLE") == "1":
        # A person's unconditional switch, and the escape hatch the fatal message below advertises.
        # Nothing here read it, so the only documented way out of a wedged chain was a no-op. It is
        # honoured before any other work: whoever sets this wants the real gh and nothing else.
        try:
            real = broker_real_gh()
        except Exception:  # noqa: BLE001
            print("glaeda-gh: no real gh on PATH", file=sys.stderr)
            return BROKER_EXIT_NO_GH
        os.execv(real, [real, *args])
    now = time.time()
    real = None
    hops = broker_hops()
    cache_key, cache_repo, writing, write_repo, write_scopes = None, None, False, None, []
    pending: dict | None = None  # the "pass" record of a read the answer cache fills, written once it is known
    try:
        real = broker_real_gh()
        if hops:
            # Already been through here: a `gh` on PATH that this did not recognise as a wrapper
            # would otherwise be an endless exec between the two.
            raise WatchError("already brokered")
        words, method, seen, values = broker_words(args)
        # One budget for every lock this call takes, so the bound is the number the caller cares
        # about -- when gh runs -- and not three bounds that add up behind their own backs. The
        # repeat hold inside gives its own time back (see broker_hold): the budget bounds waiting
        # on a sibling, and a deliberate 30 s brake is not that.
        with lock_budget():
            # The call's logged identifier rides on each read's decision, so `audit` can say how many
            # repeat reads still reached GitHub, not only how many were asked for.
            line = broker_log_call(words, values)
            said = {"line": line} if audit_category(line.split())[1] else {}
            route, payload, key = broker_plan(args, now)
            if route == "refuse":
                broker_note({"route": "refuse"})
                print(payload, file=sys.stderr)
                return BROKER_EXIT_REFUSED
            if route == "serve":
                if key is not None:
                    touch_interest(key)
                broker_note({"route": "serve", "key": key, **said})
                print(payload)
                return EXIT_OK
            if key is not None and not sys.stdout.isatty() and broker_bucket_spent(key, now) \
                    and daemon_running():
                answered = broker_await(args, key)
                if answered is not None:
                    broker_note({"route": "serve", "key": key, "spent": True, **said})
                    print(answered)
                    return EXIT_OK
            if gh_cache_is_write(args, words, method):
                write_repo, write_scopes = gh_cache_write_scope(args, words, method, values)
                gh_cache_note_write(write_repo, now, write_scopes)
                note_run_rerun(write_repo, write_scopes, words, now)
                writing = gh_cache_ttl() > 0
            else:
                cache_key = gh_cache_key(args, words, values, seen, method, real)
                if cache_key is not None:
                    # A search spans repositories, so any write on this host makes its answer old.
                    cache_repo = None if gh_cache_anywhere(words) else gh_cache_repo(words, values) or (
                        None if words[:1] == ["api"] and not any("{" in a for a in args) else broker_repo(values))
                    answer = gh_cache_get(cache_key, cache_repo, now)
                    if answer is not None:
                        if key is not None:
                            touch_interest(key)  # a read all the same: the daemon's watch stays wanted
                        broker_note({"route": "cache", **said})
                        return gh_cache_emit(answer)
                refusal = gh_sweep_refusal(words, method, now)
                if refusal:
                    broker_note({"route": "refuse", "sweep": True})
                    print(refusal, file=sys.stderr)
                    return GH_SWEEP_EXIT
            broker_hold(broker_repeat_wait(args, words, method, seen, now))
            # No grace here, unlike every other caller. DOWN_GRACE exists so a client waiting on
            # the daemon rides out a re-exec; this answer only decides whether to register a watch,
            # which is worthless if the daemon really is down. Polling for it cost 5.20 s on the
            # hottest read shape on the host (measured: `gh pr view 7 -R o/r --json state` with no
            # daemon, 26x plain gh's startup), per call, exactly when none of the cache's value
            # exists to pay for it.
            if key is not None and daemon_running() and broker_seen_count(key, now) >= 2:
                # read twice in BROKER_REPEAT: worth a watch, so the next read of it is free. A
                # target read once is never watched, or a sweep over fifty PRs would cost more
                # than it saves.
                register(key)
                pending = {"route": "pass", "key": key, "watched": True, **said}
            else:
                pending = {"route": "pass", "key": key, **said}
            if cache_key is None:
                broker_note(pending)
                pending = None
    except Exception as error:  # noqa: BLE001  the broker never fails a call: that is the whole contract
        cache_key, writing, pending = None, False, None
        if not isinstance(error, WatchError) or str(error) != "already brokered":
            broker_note({"route": "error", "error": describe(error), "site": error_site(error)})
        if real is None:
            try:
                real = broker_real_gh()
            except Exception:  # noqa: BLE001
                print("glaeda-gh: no real gh on PATH", file=sys.stderr)
                return BROKER_EXIT_NO_GH
    depth = broker_depth()
    if hops >= BROKER_MAX_HOPS or depth >= BROKER_MAX_DEPTH:
        # The marks only stop this broker from *working* twice on one call; they cannot stop a
        # wrapper from handing it back, and `exec` leaves nothing to unwind. Counting is what makes
        # the chain finite, so a wrapper this does not recognise costs an error rather than a hang:
        # hops ends an exec chain at the second pass, depth ends a chain that forks (where every
        # generation is a new pid and hops can never climb). Named in full because whoever sees
        # this has a loop to find.
        reached = (f"{BROKER_MARK}={hops}" if hops >= BROKER_MAX_HOPS else f"{BROKER_DEPTH}={depth}")
        # The depth count is nesting under any brokered gh, not generations of one call, so it can
        # also be reached by a genuinely deep chain of gh calls with no loop in it anywhere. The
        # message says both rather than naming a loop it cannot actually tell apart.
        print(f"glaeda-gh: {' '.join(['gh', *args][:3])} has been through this broker "
              f"{max(hops, depth)} times ({reached}); either something on PATH hands `gh` back "
              f"here, or gh calls are nested this deep under one another. Not running {real} "
              f"again -- run the real gh by path, and CMUX_GH_BROKER_DISABLE=1 keeps this broker "
              f"out.", file=sys.stderr)
        return BROKER_EXIT_NO_GH
    if (cache_key is not None or writing) and real is not None:
        ran: list[int] = []
        try:
            if writing:
                return gh_cache_write(real, args, write_repo, ran, write_scopes, words)
            filled = gh_cache_fill(real, args, cache_key, cache_repo, ran, pending)
            if filled is not None:
                return filled
        except Exception as error:  # noqa: BLE001  fails open, but never runs gh twice
            broker_note({"route": "error", "error": describe(error), "site": error_site(error)})
            if ran:
                return ran[0]  # its decision is written: gh ran inside the fill
    if pending is not None and not pending.get("written"):
        broker_note(pending)
    try:
        # Survives the exec, so this call is not brokered twice; tagged with the pid so it means
        # nothing to anything gh goes on to spawn (see broker_hops). execv keeps the pid, which is
        # why the tag is written before it and not after.
        os.environ[BROKER_MARK] = f"{hops + 1}:{os.getpid()}"
        os.environ[BROKER_DEPTH] = str(depth + 1)  # unscoped: survives a fork as well as an exec
        # If `real` turns out to be the cmuxterm-hq PATH guard after all, this is what stops it
        # delegating the call straight back here. Scoped to this pid, so a guard that gh spawns
        # later is guarding a different call and brokers it normally. CMUX_GH_BROKER_DISABLE is
        # deliberately NOT set: it is a person's unconditional switch, and setting it here turned
        # it off for every descendant -- including, once it was inherited, for the person.
        os.environ["GLAEDA_GH_BROKER_PID"] = str(os.getpid())
        os.execv(real, [real, *args])
    except OSError as error:
        print(f"glaeda-gh: cannot run {real}: {describe(error)}", file=sys.stderr)
        return BROKER_EXIT_NO_GH
    return EXIT_OK  # unreachable: execv replaces this process


BROKER_SHIM = """#!/usr/bin/env bash
# GLAEDA_GH_BROKERED shim: every `gh` call on this host goes through the broker, which serves what
# glaeda's daemon already holds, refuses reading repository source through the API, and passes
# everything else to the real gh unchanged. It fails open. Written by `glaeda-gh gh --install-shim`.
exec {broker} gh "$@"
"""


AUDIT_LINE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) (\S+) (.*)$")
AUDIT_WINDOW = 90.0  # a read this soon after the same target was read is one a cache would serve
AUDIT_READS = {("pr", "view"), ("pr", "checks"), ("pr", "list"), ("pr", "diff"),
               ("run", "view"), ("run", "list"), ("issue", "view"), ("issue", "list"),
               ("search", "prs"), ("label", "list")}
# A read whose line carries no identifier (the guard logged it before 2026-10-21, or the repository
# could not be resolved) is counted, but never as a repeat: `pr view 7` in two repositories is two
# different reads, and treating them as one would overstate what a cache can do.
AUDIT_BARE = re.compile(r"^(?:pr|run|issue|search|label) [\w-]+(?: \d+)?$")
# The GraphQL endpoint, however it was typed -- four spellings: `graphql`, `/graphql`, and an
# absolute URL on either kind of host. See `endpoint_re`, which `BROKER_FREE_RE` shares: pinning
# api.github.com put a GHE host's `https://ghe.example/api/graphql` in a category of its own, so
# the count undercounted and the sentence below it could go missing altogether.
AUDIT_GRAPHQL_RE = endpoint_re("graphql")
# A logged line of the shape the broker and today's guard write: subcommand words, then an
# identifier (a cache key, an api path, or a number), then the guard's `-R owner/repo`. Anything
# else is counted but never printed back (see cmd_audit).
AUDIT_SAFE = re.compile(r"[a-z][a-z0-9-]{0,30}(?: [a-z][a-z0-9-]{0,30})?"
                        r"(?: (?:https?://)?/?[A-Za-z0-9_][A-Za-z0-9_./:#@~-]{0,199})?"
                        r"(?: [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?")


AUDIT_ENDPOINT_RE = re.compile(r"/?[A-Za-z0-9_.~-]+(?:/[A-Za-z0-9_.~:@-]+)*/?")
AUDIT_TOKEN_RE = re.compile(r"gh[pousr]_|github_pat_", re.IGNORECASE)


def audit_category(words: list[str]) -> tuple[str, bool]:
    """(category, whether repeating it would be a cache hit) for one logged call."""
    first, second = (words + ["", ""])[:2]
    if first == "api":
        if re.search(r"/(contents|git/blobs|git/trees|git/commits|git/refs)", " ".join(words)):
            return "source read through the API", False
        # One endpoint, four spellings, and the log keeps whichever the caller typed. Counted as
        # one category each, because a category split four ways is four small rows that no
        # summary line covers -- and `api /graphql` is a shape this file's own brake test pins as
        # one a script would write. `BROKER_FREE_RE` is the same pattern for rate_limit.
        if AUDIT_GRAPHQL_RE.match(second):
            return "raw gh api graphql", False
        if BROKER_FREE_RE.match(second):
            return "rate_limit (free)", False
        if re.search(r"/actions/runs/\d+/jobs", " ".join(words)):
            return "api .../actions/runs/N/jobs", True
        # A category is printed back, so only an endpoint of a path's shape is. A log written before
        # the guard cut query strings and flag values can hold anything in this word, a token included.
        if second and not (AUDIT_ENDPOINT_RE.fullmatch(second) and not AUDIT_TOKEN_RE.search(second)):
            return "api (endpoint not shown)", False
        return f"api {second}".rstrip(), False
    if (first, second) in AUDIT_READS:
        return f"{first} {second}", True
    return f"{first} {second}".strip() or "(none)", False


def cmd_audit(path: Path, last: int, as_json: bool) -> int:
    """What this host's gh traffic is, and how much of it a cache would have answered.

    Reads the shared call log: the broker writes it where it is installed, the PATH guard where it
    is not. Both write a subcommand and an identifier (an API path with its query cut, or a cache
    key) and never the tail of a command line, so this never reads a token or a comment body."""
    try:
        text = path.read_text(errors="replace")
    except OSError as error:
        raise WatchError(f"cannot read {path}: {describe(error)}") from error
    # The log is rotated once past GUARD_LOG_MAX, so without its predecessor the window this
    # reports would end at the rotation. Optional: there is none until the first one.
    with contextlib.suppress(OSError):
        older = (path.with_name(path.name + ".1")).read_text(errors="replace")
        # One newline between them, because concatenating them bare glued a rotated file's last
        # line to the current log's first and lost *both* records: a truncated `.1` turned two
        # calls into one counted as `api repos/o/r/pulls2026-10-20T00:00:05Z`.
        if older:
            text = older.rstrip("\n") + "\n" + text
    lines = text.splitlines()
    if last:
        lines = lines[-last:]
    total = 0
    counts: dict[str, int] = {}
    reads, repeats = 0, 0
    per_read: dict[str, list[int]] = {}
    seen: dict[str, float] = {}
    hot: dict[str, int] = {}
    since = None  # the first call in the window: the decision records counted below start there
    for line in lines:
        match = AUDIT_LINE.match(line)
        if not match:
            continue
        stamp, _caller, text = match.groups()
        words = text.split()
        at = iso_epoch(stamp)
        if since is None and at is not None:
            since = at
        total += 1
        category, cacheable = audit_category(words)
        counts[category] = counts.get(category, 0) + 1
        if not cacheable or at is None:
            continue
        reads += 1
        bucket = per_read.setdefault(category, [0, 0])
        bucket[0] += 1
        if AUDIT_BARE.fullmatch(text):
            continue  # no repository in the line: cannot tell one repo's PR 7 from another's
        hot[text] = hot.get(text, 0) + 1
        # Not below zero: concurrent writers can append out of order, and a line stamped before the
        # one it follows is not a re-read of it. With that, every line counted here has an earlier
        # read of the same target within the window, so it is a repeat in time order too, and the
        # figure stays a floor whatever order the log was written in.
        if 0 <= at - seen.get(text, float("-inf")) <= AUDIT_WINDOW:
            repeats += 1
            bucket[1] += 1
        seen[text] = at
    if not total:
        raise WatchError(f"no gh calls logged in {path}")
    served = {}
    # What became of the repeats: a decision record that names its read (`line`, written since
    # 2026-10-31) says whether the cache answered it or it reached GitHub. Counted over the same
    # window as the call log above, and with the same rule for a repeat, so "reached GitHub" is the
    # part of `repeatsWithin` a cache did not absorb -- the number the cache exists to bring down.
    named = {"reads": 0, "repeats": 0, "repeatsReachedGitHub": 0}
    named_seen: dict[str, float] = {}
    # Both files, newest last, for the same reason the call log reads its predecessor: these counts
    # are the broker's before/after number, and reading only the live file truncated them at every
    # rotation. Each line is self-contained JSON, so unlike the call log there is nothing to glue.
    decisions = broker_log()
    for source in (decisions.with_name(decisions.name + ".1"), decisions):
        try:
            text = source.read_text(errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            try:
                record = json.loads(line)
            except ValueError:
                continue  # a torn last line at a rotation boundary is one record, not the file
            route = record.get("route") if isinstance(record, dict) else None
            if not isinstance(route, str):
                continue  # a record of some other shape is not a decision
            served[route] = served.get(route, 0) + 1
            said, at = record.get("line"), record.get("at")
            if (not isinstance(said, str) or not isinstance(at, (int, float)) or since is None or at < since - 1
                    or route not in ("pass", "cache", "serve") or AUDIT_BARE.fullmatch(said)):
                continue
            named["reads"] += 1
            if 0 <= at - named_seen.get(said, float("-inf")) <= AUDIT_WINDOW:
                named["repeats"] += 1
                named["repeatsReachedGitHub"] += route == "pass"
            if route == "pass":
                named_seen[said] = at  # a repeat is a re-read of what last came from GitHub
    # Not a second JSON field: this is `categories["raw gh api graphql"]` by construction, and a
    # count under two names is a count that can disagree with itself.
    batched = counts.get("raw gh api graphql", 0)
    if as_json:
        print(json.dumps({"calls": total, "categories": counts, "cacheableReads": reads,
                          "repeatsWithin": {"seconds": AUDIT_WINDOW, "calls": repeats},
                          "perRead": {k: {"reads": v[0], "repeats": v[1]} for k, v in per_read.items()},
                          "brokerDecisions": served, "decisionReads": named}, sort_keys=True))
        return EXIT_OK
    print(f"{total} gh calls logged in {path}\n")
    print(f"{'category':<34}{'calls':>8}{'share':>8}")
    for category, n in sorted(counts.items(), key=lambda kv: -kv[1])[:20]:
        print(f"{category:<34}{n:>8}{100 * n / total:>7.1f}%")
    print(f"\n{'read':<34}{'calls':>8}{'repeat within ' + str(int(AUDIT_WINDOW)) + 's':>22}")
    for category, (n, again) in sorted(per_read.items(), key=lambda kv: -kv[1][0]):
        print(f"{category:<34}{n:>8}{f'{again} ({100 * again / n:.0f}%)':>22}")
    print(f"{'all cacheable reads':<34}{reads:>8}"
          f"{f'{repeats} ({100 * repeats / max(reads, 1):.0f}%)':>22}")
    print(f"\n{repeats} calls ({100 * repeats / total:.1f}% of all of them) re-read something this host had read "
          f"within {int(AUDIT_WINDOW)} seconds.")
    # Only lines of the shape today's writers produce are quoted back. A log written before
    # 2026-10-21 kept the value of a flag it did not know took one, and an audit is read and pasted
    # into reports: whatever is in those old lines stays counted but unquoted.
    hot = {text: n for text, n in hot.items() if AUDIT_SAFE.fullmatch(text)}
    if hot:
        print("hottest targets: " + "; ".join(f"{text} x{n}" for text, n in
                                              sorted(hot.items(), key=lambda kv: -kv[1])[:5]))
    if named["reads"]:
        reached = named["repeatsReachedGitHub"]
        print(f"of {named['reads']} cacheable reads the broker recorded in this window, {reached} "
              f"({100 * reached / named['reads']:.1f}%) re-read within {int(AUDIT_WINDOW)} seconds what this host had "
              f"read from GitHub and still reached it; the cache answered {named['repeats'] - reached} other repeats.")
    if served:
        print("\nbroker decisions so far: " + ", ".join(f"{k} {v}" for k, v in sorted(served.items())))
    if batched:
        # Coverage, not cost. An earlier version of this line said a batching caller "looks
        # cheaper here than its GraphQL points are", which was backwards: GitHub prices a GraphQL
        # call at the requests needed for its connections divided by 100, rounded, minimum 1, so
        # one aliased query over forty PRs is about 1 point against about 40 for the loop --
        # skills/github-ci-wait/SKILL.md says so, and this contradicted it. Per-call shares are
        # the right unit for GraphQL points. What a `graphql` line really hides is *reads*: the
        # category is not cacheable, so none of the objects inside it reaches `cacheableReads`,
        # `repeatsWithin` or `perRead`, and the repeat *count* is a floor rather than an estimate.
        # The count and not the shares beside it. A hidden read written out can land on either
        # side of a share, so a share can go up, down or stay put -- all three are in
        # AuditGraphqlTest, which is what finally made the sentence checkable rather than
        # reviewable. Four earlier drafts each inferred a direction instead: "both *fall*" from the
        # denominator alone, "either direction" said of the two counts rather than the share,
        # "grows the numerator and the denominator" -- which reads as both always growing, and a
        # review measured 33.3% -> 25.0% where only the denominator did -- and then "can grow the
        # numerator and does grow the denominator", where a review measured 33.3% -> 33.3% by
        # writing the hidden read out in place of the batched call it was carried by. Say what is
        # measured, nothing about mechanism, and let a test hold it.
        # "The calls are counted above" because the total line counts them, and the repeat
        # percentage's denominator is that total. Not "in their own category row": the category
        # table is the top 20 by count, so on a host with more than twenty distinct categories
        # this row is not in it -- measured, 21 distinct `api` paths and the graphql row gone, with
        # the sentence still true. An earlier draft said "None of them is counted above", which the
        # total contradicts. What is not counted is the *objects* inside them, and what follows
        # from that is only that no graphql call is a cacheable read or a repeat.
        # "however many ... asked for" covers zero, which is the only thing needed: the log keeps
        # the path and never the document, so a batched read of forty and a call that reads nothing
        # are the same line here, and a floor needs the hidden reads to be >= 0. Earlier drafts
        # named the mutation and the one-object probe as carrying nothing, and both were claims
        # about GitHub's API that this log cannot see -- a mutation selects its payload, and a probe
        # of an object read nearby hides a repeat. "each carrying", not "each one request": with
        # `--paginate` one command line is several HTTP requests, and the log keeps neither the
        # flags (broker_logged_target drops them) nor the request count.
        # "the same-target re-reads a cache could have been asked for", not "what a cache could
        # have answered": this broker's cache keys on the target, and the repeat count is
        # flag-blind in the other direction -- `pr view X --json state` and `pr view X --json
        # files` log the same target and score as one repeat, while the broker would have to fetch
        # the second field set. So the figure is a floor against hidden GraphQL reads and can
        # overcount against the cache's own hit rate; naming same-target re-reads is the part that
        # holds both ways.
        # The floor is over the calls in *this report*. With `--last N` the window is the last N
        # lines, so writing hidden reads out as separate lines pushes older ones out and the
        # comparison runs over two different sets of calls -- measured, and pinned as a known limit
        # by test_the_floor_is_over_one_set_of_calls: 1 repeat becomes 0 under `--last 3`. Held to
        # one set it cannot fall, because at most one repeat is counted per line per target, so the
        # figure can never exceed the true same-target re-read count; two reviews found no
        # counterexample, in 4000 and in 1800 random insertions, for repeats, reads and calls alike.
        # No pricing claim here on purpose -- this file is read as durable output, and a price is
        # the part that goes stale.
        # "was" for one call: N=1 is the common case on a host that batches rarely, and it is what
        # the crowded-table fixture prints.
        print(f"\n{batched} of those calls {'was' if batched == 1 else 'were'} `gh api graphql`, "
              f"each carrying however many objects "
              f"the caller asked for, which this cannot see. The calls are counted above; none of "
              f"the objects inside them is, so none of them is counted as a cacheable read or as a "
              f"repeat. That makes the repeat count a floor on the same-target re-reads a cache "
              f"could have been asked for in this report, not an estimate. The shares beside it "
              f"are not floors: a hidden read written out can land on either side of a share, so "
              f"a share can go up, down or stay where it is.")
    return EXIT_OK


def cmd_gh_install_shim(print_only: bool) -> int:
    broker = Path(__file__).resolve()
    text = BROKER_SHIM.format(broker=shlex.quote(str(broker)))
    if print_only:
        print(text, end="")
        return EXIT_OK
    target = Path.home() / ".local/lib/glaeda-gh/bin"
    target.mkdir(parents=True, exist_ok=True)
    shim = target / "gh"
    shim.write_text(text)
    shim.chmod(0o755)
    print(f"glaeda-gh: wrote {shim}. Put it in front of the real gh:\n"
          f"    export PATH={shlex.quote(str(target))}:$PATH\n"
          f"  Then `gh pr view N -R OWNER/REPO --json state` is served from glaeda's cache when it is "
          f"fresh. Undo by removing that line and the file.")
    return EXIT_OK


# launchctl's answer for a gui/UID domain that does not exist: "125: Domain does not support specified
# action". A Mac whose user was logged out (cmux16, 2026-10-24: the console sat at the login window with
# no reboot to log it back in) has no gui domain, so its LaunchAgent cannot load there at all.
NO_GUI_DOMAIN = 125


def launchd_domain() -> str | None:
    """gui/UID while this user has a login session; user/UID when launchd says there is none; None when
    launchctl cannot tell (any other answer, or none): callers then change nothing."""
    gui = f"gui/{os.getuid()}"
    try:
        code = run_bounded(["launchctl", "print", gui], 10).returncode
    except (OSError, subprocess.TimeoutExpired):
        return None
    return gui if code == 0 else f"user/{os.getuid()}" if code == NO_GUI_DOMAIN else None


DOMAIN_UNKNOWN_HINT = (f"launchctl could not say whether anyone is logged in here (launchctl print gui/$(id -u) "
                       f"answered neither 0 nor {NO_GUI_DOMAIN}), so nothing was started or stopped: run "
                       f"glaeda-gh restart again, and if it persists check launchctl print gui/$(id -u), "
                       f"launchctl print user/$(id -u)/{LAUNCH_LABEL} and sudo launchctl print "
                       f"system/{LAUNCH_LABEL} by hand. Never run glaeda-gh serve yourself")


def background_copy_path() -> Path:  # read BASE at call time: tests move it
    return BASE / f"{LAUNCH_LABEL}.background.plist"


def background_plist() -> str:
    """The LaunchAgent's plist, as a copy the user domain loads. launchd refuses an Aqua job there
    ("5: Input/output error"); the same job marked Background runs. The LaunchAgent stays the one
    source: the copy is rewritten from it on every user-domain restart and lives only until the next reboot."""
    source = Path.home() / "Library/LaunchAgents" / f"{LAUNCH_LABEL}.plist"
    with open(source, "rb") as handle:
        job = plistlib.load(handle)
    if not isinstance(job, dict):
        raise ValueError(f"{source} is a plist {type(job).__name__}, not a job")
    job["LimitLoadToSessionType"] = "Background"
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    copy = background_copy_path()
    # launchctl refuses a job file group or others can write, and a umask of 002 would make it one; a rename
    # also leaves an older copy's mode behind
    part = copy.with_name(copy.name + ".part")
    fd = os.open(part, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as handle:
        os.fchmod(handle.fileno(), 0o600)
        plistlib.dump(job, handle)
    os.replace(part, copy)
    return os.fspath(copy)


# launchctl print's answer for a service its domain does not have (measured on cmux16 and cmux17, macOS 27, in
# the user, system and gui domains). Any other failure says nothing either way, so callers fail closed on it.
NOT_LOADED = 113


def unloaded(target: str) -> bool:
    """Whether launchctl says TARGET (domain/label) is not loaded; False when it is, or when it cannot tell."""
    return run_bounded(["launchctl", "print", target], 10).returncode == NOT_LOADED


def system_daemon_loaded() -> bool | None:
    """Whether a headless Mac's system LaunchDaemon with the service's label is loaded (service_loaded): None
    when launchctl's answer is neither loaded (0) nor not loaded (113)."""
    code = run_bounded(["launchctl", "print", f"system/{LAUNCH_LABEL}"], 10).returncode
    return True if code == 0 else False if code == NOT_LOADED else None


SYSTEM_UNKNOWN_HINT = (f"launchctl could not say whether the system LaunchDaemon system/{LAUNCH_LABEL} is loaded: "
                       f"check with sudo launchctl print system/{LAUNCH_LABEL} before starting anything. If it is "
                       f"loaded: sudo launchctl kickstart -k system/{LAUNCH_LABEL}; if not: glaeda-gh restart")


SYSTEM_DAEMON_HINT = (f"the system LaunchDaemon system/{LAUNCH_LABEL} runs the daemon on this headless Mac; restart "
                      f"it as root: sudo launchctl kickstart -k system/{LAUNCH_LABEL}")


def launchd_state(domain: str | None = None) -> str | None:
    """The service's `state = ...` line (running, spawn scheduled, not running), or None."""
    domain = domain or launchd_domain()
    if domain is None:
        return None
    try:
        result = run_bounded(["launchctl", "print", f"{domain}/{LAUNCH_LABEL}"], 10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    found = re.search(r"^\s*state = (.+)$", result.stdout, re.M)
    return found.group(1).strip() if found else None


def restart_service(hung: bool) -> tuple[bool, str]:
    """Restart (hung) or start the service once. (started, what was run)."""
    if sys.platform != "darwin":
        # a unit that hit its start limit refuses start and restart until this
        run_bounded(["systemctl", "--user", "reset-failed", SYSTEMD_UNIT], SUBPROCESS_DEADLINE)
        argv = ["systemctl", "--user", "restart" if hung else "start", SYSTEMD_UNIT]
        result = run_bounded(argv, SUBPROCESS_DEADLINE)
        return result.returncode == 0, " ".join(argv)
    domain = launchd_domain()
    if domain is None:
        # booting a copy out, or loading one, on a guess about the login session could leave no daemon at all
        return False, "nothing: " + DOMAIN_UNKNOWN_HINT
    target = f"{domain}/{LAUNCH_LABEL}"
    # A headless Mac's system LaunchDaemon (service_loaded) runs the daemon there: neither a copy nor the
    # LaunchAgent may start beside it, whether or not someone is logged in
    system = system_daemon_loaded()
    if system is None:
        return False, "nothing: " + SYSTEM_UNKNOWN_HINT
    if system:
        return False, "nothing: " + SYSTEM_DAEMON_HINT
    if domain.startswith("user/"):
        # Always reload, never kickstart and never wait on a scheduled respawn: either would keep running a copy
        # of an older LaunchAgent
        try:
            plist = background_plist()
        except Exception as error:  # OSError, plistlib's and expat's parse errors, a plist that is not a job
            return False, f"no Background copy for {domain}: {type(error).__name__}: {error}"
        if launchd_domain() != domain:
            return False, "nothing: someone logged in or out while restarting; run glaeda-gh restart again"
        loaded = reload_job(target, domain, plist)
        how = (f"launchctl bootout and bootstrap {target} from {plist} "
               f"(nobody is logged in, so gui/{os.getuid()} does not exist)")
        return loaded == 0, how + ("" if loaded == 0 else f" (bootstrap exit {loaded})")
    # Logged in again: the copy a logged-out restart loaded would keep a second KeepAlive daemon (waiting on
    # daemon.lock behind this one) and is what a hung-holder stop would hit first, so it goes now
    if launchd_domain() != domain:
        return False, "nothing: someone logged in or out while restarting; run glaeda-gh restart again"
    gone, dropped = drop_background_copy()
    if not gone:
        return False, dropped + f"; not starting {target} beside it"
    if not hung and launchd_state(domain) == "spawn scheduled":
        return True, dropped + "nothing: launchd has already scheduled the respawn"
    argv = ["launchctl", "kickstart"] + (["-k"] if hung else []) + [target]
    result = run_bounded(argv, SUBPROCESS_DEADLINE)
    if result.returncode == 0:
        return True, dropped + " ".join(argv)
    # 5 (launchd reported "spawn failed") or 113 (not loaded): unload and load it, once, here
    plist = os.fspath(Path.home() / "Library/LaunchAgents" / f"{LAUNCH_LABEL}.plist")
    loaded = reload_job(target, domain, plist)
    how = f"{dropped}{' '.join(argv)} (exit {result.returncode}), then launchctl bootout and bootstrap"
    return loaded == 0, how + ("" if loaded == 0 else f" (bootstrap exit {loaded})")


def reload_job(target: str, domain: str, plist: str) -> int:
    """launchctl bootout TARGET, then bootstrap PLIST into DOMAIN; bootstrap's exit code."""
    run_bounded(["launchctl", "bootout", target], SUBPROCESS_DEADLINE)
    # bootout can return before the job is torn down, and bootstrap answers 5 while it is still loaded
    deadline = time.monotonic() + BOOTSTRAP_RETRY
    while True:
        loaded = run_bounded(["launchctl", "bootstrap", domain, plist], SUBPROCESS_DEADLINE)
        if loaded.returncode == 0 or time.monotonic() >= deadline:
            return loaded.returncode
        time.sleep(1)


def drop_background_copy() -> tuple[bool, str]:
    """Boot out the user-domain copy if one is loaded. (no copy is left loaded, what was done: a prefix for
    restart's report, or why the copy is still there)."""
    copy = f"user/{os.getuid()}/{LAUNCH_LABEL}"
    if unloaded(copy):
        return True, ""
    out = run_bounded(["launchctl", "bootout", copy], SUBPROCESS_DEADLINE)
    # bootout can return before the job is torn down (reload_job): it is gone when print says it is not loaded,
    # and a print that cannot tell keeps the LaunchAgent off like a copy still there
    deadline = time.monotonic() + BOOTSTRAP_RETRY
    while not unloaded(copy):
        if time.monotonic() >= deadline:
            return False, (f"launchctl bootout {copy} (the Background copy from a logged-out restart) exited "
                           f"{out.returncode} and it is still loaded after {BOOTSTRAP_RETRY}s")
        time.sleep(1)
    return True, f"launchctl bootout {copy} (the Background copy from a logged-out restart), then "


def cmd_restart(force: bool = False) -> int:
    """Restart the daemon at most once across every session: single-flight under restart.lock, and
    a no-op within RESTART_COOLDOWN of the last restart or while the daemon is healthy."""
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(BASE / "restart.lock", "a+") as guard:
        if not try_lock(guard):
            print("glaeda-gh: another session is restarting the daemon right now. Do not restart it too: "
                  "re-run your wait in a minute.")
            return EXIT_OK
        running = daemon_running(grace=DOWN_GRACE)
        broken = daemon_failing() if running else None
        if broken is not None:
            say_waiting(failing_message(broken))
            return EXIT_DOWN
        lag = daemon_stale() if running else None
        # A fresh heartbeat is not health: the data it vouches for must be fresh too (STALE_DATA_AFTER)
        starved = daemon_starved() if running and lag is None else None
        if starved is not None and starved["quota"] and not force:
            print(f"glaeda-gh: the daemon is running, but its {starved['kind']} data for waits is "
                  f"{int(starved['age'])}s old because {starved['why']}. "
                  "A restart would not read any sooner; a wait reads its own target once (direct_read).")
            return EXIT_OK
        if running and lag is None and starved is None and not force:
            print("glaeda-gh: the daemon is running, its heartbeat is fresh and the data its waits are blocked on is "
                  f"under {STALE_DATA_AFTER}s old; nothing to restart. If a wait printed an older warning, re-run it.")
            return EXIT_OK
        if starved is not None:
            slowed = f" The quota slows it ({starved['why']}), which alone should not leave it this old." \
                if starved.get("why") else " Nothing recorded explains it."
            print(f"glaeda-gh: the daemon's heartbeat is fresh, but its {starved['kind']} data for waits is "
                  f"{int(starved['age'])}s old (over {STALE_DATA_AFTER}s): it is not refreshing, so restarting it."
                  f"{slowed}")
        ago = recent_restart(holding=True)
        if ago is not None and not force:
            record = restart_record() or {}
            print(f"glaeda-gh: the daemon was restarted {int(ago)}s ago (pid {record.get('by', '?')}: "
                  f"{record.get('how', '?')}). Do not restart it again: a new daemon writes a heartbeat as soon "
                  f"as it holds its lock. Re-run your wait; after {RESTART_COOLDOWN}s a restart is allowed again.")
            return EXIT_OK
        # running but silent (or starved), or an active unit silent with no visible lock: restart; not running: start
        hung = running or silent_unit() is not None
        holder = lock_holder() if running else None
        killed = None
        began = time.time()
        write_json(BASE / "restart.json", {"at": began, "by": os.getpid(), "how": "starting"})
        if holder is not None and holder["silent"] > STALE_HEARTBEAT and is_serve(holder["pid"]):
            # Stop the hung holder itself: when it is a serve outside the service, kickstart cannot
            # reach it and the service's daemon waits behind it. When it is the service's own, launchd
            # respawns it (KeepAlive), so the start below must not kill that respawn again (no -k).
            if stop_process(holder["pid"]):
                killed = holder["pid"]
        try:
            started, how = restart_service(hung and killed is None)
        except (OSError, subprocess.TimeoutExpired) as error:
            started, how = False, f"failed: {type(error).__name__}"
        if killed is not None:
            how = f"SIGTERM to the hung lock holder pid {killed}, then {how}"
        # Success is a heartbeat written after the restart began (a new daemon writes one as soon as
        # it holds the lock), not merely a held lock: a hung holder that survived holds it too.
        ok = started and new_heartbeat(began, RESTART_SETTLE)
        # macOS keeps its rule (a restart without a heartbeat starts no cooldown): its "spawn scheduled"
        # path succeeds without running anything
        ran = started and sys.platform != "darwin"
        write_json(BASE / "restart.json", {"at": began, "by": os.getpid(), "how": how, "ok": ok, "ran": ran})
        if ok:
            print(f"glaeda-gh: restarted the daemon ({how}); a new daemon holds its lock and wrote its heartbeat. "
                  "Re-run your wait.")
            return EXIT_OK
        print(f"glaeda-gh: tried to {'restart' if hung else 'start'} the daemon ({how}), but no new daemon wrote a "
              f"heartbeat within {RESTART_SETTLE}s. Tell the user. By hand: {start_hint(restart=hung)}", file=sys.stderr)
        return EXIT_DOWN


def stop_process(pid: int) -> bool:
    """SIGTERM, then SIGKILL after TAKEOVER_GRACE (as take_over does). True once `pid` is gone."""
    for sig, grace in ((signal.SIGTERM, TAKEOVER_GRACE), (signal.SIGKILL, 5)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return True
        except OSError:
            return False
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                return True
            except OSError:
                return False
            time.sleep(0.2)
    return False


def new_heartbeat(since: float, grace: float) -> bool:
    """Whether, within `grace` seconds, the lock is held and daemon.json has a heartbeat newer than `since`."""
    deadline = time.monotonic() + grace
    while True:
        status = read_json(BASE / "daemon.json")
        at = status.get("at") if isinstance(status, dict) else None
        if isinstance(at, (int, float)) and at >= since and lock_held():
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


# ---------------------------------------------------------------- post: one paced writer for every session


def post_request(item: dict) -> tuple[str, str, dict]:
    """The REST call for a queued write."""
    repo = item["repo"]
    if item["kind"] == "comment":
        return "POST", f"/repos/{repo}/issues/{item['number']}/comments", {"body": item["body"]}
    if item["kind"] == "review":
        return "POST", f"/repos/{repo}/pulls/{item['number']}/reviews", {"body": item["body"], "event": item["event"]}
    if item["kind"] == "pr":
        return "POST", f"/repos/{repo}/pulls", {"title": item["title"], "head": item["head"], "base": item["base"],
                                                "body": item["body"], "draft": False}
    raise WatchError(f"unknown write kind {item['kind']!r}")


def read_body(body: str | None, body_file: str | None) -> str:
    if (body is None) == (body_file is None):
        raise WatchError("post takes one of --body and --body-file (- for stdin)")
    if body_file is not None:
        try:
            body = sys.stdin.read() if body_file == "-" else Path(body_file).read_text()
        except OSError as error:
            raise WatchError(f"--body-file {body_file}: {error.strerror or type(error).__name__}") from None
    if len(body.encode()) > POST_BODY_MAX:
        raise WatchError(f"the body is over GitHub's {POST_BODY_MAX} bytes")
    return body


def post_item(args: argparse.Namespace) -> dict:
    item: dict[str, Any] = {"kind": args.kind, "body": read_body(args.body, args.body_file), "queuedAt": time.time(),
                            "attempts": 0, "by": os.environ.get("CMUX_SURFACE_ID") or os.environ.get("ACPMUX_SESSION")
                            or os.getcwd()}
    if args.kind == "pr":
        if not re.fullmatch(rf"{NAME}/{NAME}", args.target):
            raise WatchError("post pr takes OWNER/REPO")
        if not args.head or not args.base or not args.title:
            raise WatchError("post pr needs --head, --base and --title")
        item.update(repo=args.target, head=args.head, base=args.base, title=args.title, reviewers=args.reviewer or [])
    else:
        m = (PR_RE if args.kind == "review" else ISSUE_RE).fullmatch(args.target)
        if not m:
            raise WatchError(f"post {args.kind} takes OWNER/REPO#N or a GitHub URL")
        if args.head or args.base or args.title or args.reviewer:
            raise WatchError("--head, --base, --title and --reviewer are for post pr")
        if args.kind == "comment" and args.event != "comment":
            raise WatchError("--event is for post review")
        key = getattr(args, "status_key", None)
        if key is not None and not isinstance(key, str):
            key = None  # a caller's own namespace without the flag (an older argv, a test's Mock)
        if key:
            if args.kind != "comment" or not STATUS_KEY.fullmatch(key):
                raise WatchError("--status-key is for post comment: letters, digits and . : = @ / - (120 at most)")
            item["status"] = key
        item.update(repo=f"{m.group(1)}/{m.group(2)}", number=int(m.group(3)))
        if args.kind == "review":
            item["event"] = args.event.upper().replace("-", "_")
    item["id"] = f"{time.time_ns() // 1_000_000:013d}-{os.getpid()}-{os.urandom(3).hex()}"
    return item


def post_state(post_id: str) -> dict | None:
    if not POST_ID.fullmatch(post_id):
        raise WatchError(f"{post_id!r} is not a post id (glaeda-gh post status lists them)")
    done = read_json(posted_dir() / f"{post_id}.json")
    if isinstance(done, dict):
        return done
    queued = read_json(outbox_dir() / f"{post_id}.json")
    if not isinstance(queued, dict):
        return None
    ahead = sum(1 for p in outbox_dir().glob("*.json") if p.stem < post_id)
    hold = ((read_json(BASE / "daemon.json") or {}).get("outbox") or {}).get("holdUntil")
    return {k: v for k, v in queued.items() if k != "body"} | {"state": "queued", "ahead": ahead, "holdUntil": hold}


def post_line(state: dict) -> str:
    if state["state"] == "posted":
        return (state.get("url") or "posted") + (f" ({state['note']})" if state.get("note") else "")
    if state["state"] == "failed":
        return f"failed: {state.get('error')}"
    parts = [f"queued as {state['id']}", f"{state.get('ahead', 0)} ahead"]
    if state.get("holdUntil") and state["holdUntil"] > time.time():
        parts.append(f"GitHub holds writes for {age(state['holdUntil'] - time.time())}")
    if state.get("lastError"):
        parts.append(f"last attempt: {state['lastError']}")
    return "; ".join(parts)


# The host's public-body guard (leo-workspace tools/public_body_guard.py, next to gh_quota.py where PACE_CLI's link
# points; GLAEDA_BODY_GUARD overrides): the check the gh shim runs on `gh pr|issue create|comment` and `gh api`
# writes. A post skips the shim (the daemon writes through REST), so it asks the same guard before it queues: no
# fleet host, session id or readable agent link in a repo not known private, and an agent's PR ends with its
# agent-identity footer. On 2026-10-28 ten public cmux PRs named fleet hosts after lanes opened them with
# `glaeda-gh post pr` (cmuxterm-hq#4946, pattern D). A host without the guard posts as before, as the shim does.
BODY_GUARD_ENV = "GLAEDA_BODY_GUARD"


def body_guard_path() -> Path | None:
    named = os.environ.get(BODY_GUARD_ENV)
    if named:
        return Path(named)
    try:
        found = PACE_CLI.resolve().parent / "public_body_guard.py"
    except OSError:
        return None
    return found if found.is_file() else None


def body_guard_args(item: dict, body_file: str) -> list[str]:
    """The gh call this post stands for, as the guard reads gh's arguments (with -R, so no checkout is asked)."""
    repo = item["repo"]
    if item["kind"] == "pr":
        return ["pr", "create", "-R", repo, "--title", item["title"], "--head", item["head"], "--base", item["base"],
                "--body-file", body_file]
    if item["kind"] == "review":
        return ["pr", "review", str(item["number"]), "-R", repo, "--body-file", body_file]
    return ["issue", "comment", str(item["number"]), "-R", repo, "--body-file", body_file]


def body_guard_refusal(item: dict) -> str | None:
    """The guard's refusal of this post, or None (allowed, or no guard on this host). The guard asks GitHub
    whether the repo is private (cached an hour); an unknown answer counts as public."""
    path = body_guard_path()
    if path is None:
        return None
    if not path.is_file():
        return f"the body guard {path} ({BODY_GUARD_ENV}) is missing"
    import importlib.util
    spec = importlib.util.spec_from_file_location("public_body_guard", path)
    if spec is None or spec.loader is None:
        return f"the body guard {path} could not be loaded"
    guard = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(guard)
    fd, name = tempfile.mkstemp(suffix=".md", prefix="glaeda-post-")
    try:
        with os.fdopen(fd, "w") as fh:  # inside the try: a failed write still removes the file
            fh.write(item["body"])
        args = body_guard_args(item, name)
        return guard.refusal(args, os.environ) or guard.footer_refusal(args, os.environ)
    finally:
        with contextlib.suppress(OSError):
            os.unlink(name)


def cmd_post(args: argparse.Namespace) -> int:
    item = post_item(args)
    try:
        why = body_guard_refusal(item)
    except Exception as error:  # noqa: BLE001 - a guard that can't judge the text: nothing is posted unread
        why = f"the body guard failed ({type(error).__name__}: {error})"
    if why:
        print(f"glaeda-gh: not queued: {why}", file=sys.stderr)
        return 3
    with contextlib.suppress(Exception):
        gh_cache_note_write(str(item.get("repo") or "").lower() or None, time.time(), gh_cache_post_scopes(item))
    write_json(outbox_dir() / f"{item['id']}.json", item)
    if not daemon_running(DOWN_GRACE):
        print(f"glaeda-gh: queued as {item['id']}; it is posted once the daemon runs. " + DOWN, file=sys.stderr)
        return 3
    return cmd_post_status(item["id"], args.wait, args.json, queued=True)


def cmd_post_status(post_id: str | None, wait: float, as_json: bool, queued: bool = False) -> int:
    """One write's state (waiting up to `wait` seconds for it to finish), or the queue and the recent writes.
    Exit 0 posted (or queued, without --wait), 1 failed, 2 still queued when --wait ran out."""
    if post_id is None:
        rows = [post_state(p.stem) for p in sorted(outbox_dir().glob("*.json"))
                if POST_ID.fullmatch(p.stem)] if outbox_dir().is_dir() else []
        recent = sorted(posted_dir().glob("*.json"))[-10:] if posted_dir().is_dir() else []
        rows = [r for r in rows + [read_json(p) for p in recent] if isinstance(r, dict) and r.get("id")]
        if as_json:
            print(json.dumps(rows, indent=2, sort_keys=True))
        else:
            for r in rows:
                print(f"{r['id']}  {r.get('kind', '?'):7} {r.get('repo')}  {post_line(r)}")
        return 0
    deadline = time.monotonic() + wait
    state = post_state(post_id)
    if state is None:
        raise WatchError(f"no queued or recent write {post_id}")
    while state["state"] == "queued" and time.monotonic() < deadline:
        time.sleep(WAIT_FILE_POLL)  # a local file read, no GitHub request
        state = post_state(post_id) or state
    if as_json:
        print(json.dumps(state, indent=2, sort_keys=True))
    elif state["state"] == "posted":
        # stdout is the URL alone (`url=$(glaeda-gh post comment ...)`, then `wait comment --since "$url"`); a note
        # (joined with other queued comments, an edit in place, an open PR found) goes to stderr
        print(state.get("url") or "posted")
        if state.get("note"):
            print(f"glaeda-gh: {state['note']}", file=sys.stderr)
    else:
        print(post_line(state))
    if state["state"] == "queued" and queued and wait <= 0:
        print(f"glaeda-gh: the daemon posts it and keeps the result: glaeda-gh post status {post_id}", file=sys.stderr)
    return 0 if state["state"] == "posted" else 1 if state["state"] == "failed" else 2 if wait > 0 else 0


class Parser(argparse.ArgumentParser):
    """`argparse`'s parser, with a bad argument exiting 64 instead of 2.

    2 is this tool's "timed out", and a caller that branches on exit codes -- which is the whole
    point of `wait` -- read a refused `--timeout -5` as a wait that had run its course. 64 is what
    every other bad argument here already exits with (`WatchError` in `main`).

    Both lines go through `say_waiting`, for its reason: with stderr closed, `print(file=None)`
    writes to **stdout**, so a usage error became the first lines of a `--json` document."""

    argv: list[str] = []  # main() sets the raw arguments, for `next:` and --json

    def error(self, message: str) -> None:  # type: ignore[override]
        nxt = usage_next(Parser.argv, self.prog)
        say_waiting(self.format_usage().rstrip("\n"))
        say_waiting(f"{self.prog}: error: {message}")
        say_waiting(f"next: {nxt}")
        if "--json" in Parser.argv:
            print_json_error("usage", message, nxt)
        raise SystemExit(64)


def print_json_error(code: str, reason: str, nxt: str) -> None:
    """The one --json object a refused call prints (agent output contract)."""
    with contextlib.suppress(OSError, ValueError):
        sys.stdout.write(json.dumps({"ok": False, "code": code, "reason": reason, "next": nxt}) + "\n")
        sys.stdout.flush()


def usage_next(argv: list[str], prog: str = "glaeda-gh") -> str:
    """The right form of a mistyped call: `wait pr OWNER/REPO N` is `wait pr OWNER/REPO#N`; else the --help."""
    words = list(argv)
    if len(words) >= 4 and words[0] in ("wait", "status") and words[1] in ("pr", "comment") \
            and re.fullmatch(rf"{NAME}/{NAME}", words[2]) and BARE_NUMBER.fullmatch(words[3]):
        fixed = [words[0], words[1], f"{words[2]}#{words[3].lstrip('#')}"] + words[4:]
        if words[0] == "wait" and "--timeout" not in fixed:
            fixed += ["--timeout", "1800"]
        return " ".join(["glaeda-gh"] + fixed)
    if prog == "glaeda-gh" and words[:1] and words[0] in ("status", "wait", "checks", "post", "budget", "audit",
                                                          "runners", "restart", "serve"):
        return f"glaeda-gh {words[0]} --help"
    return f"{prog} --help"


def parser() -> argparse.ArgumentParser:
    p = Parser(prog="glaeda-gh", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True, parser_class=Parser)
    sv = sub.add_parser("serve", help="run the daemon (the only process that polls GitHub); launchd or systemd runs it")
    sv.add_argument("--foreground-ok", action="store_true",
                    help="start even though the LaunchAgent or systemd unit is loaded (debugging only)")
    for name in ("status", "wait"):
        s = sub.add_parser(name)
        s.add_argument("kind", choices=("pr", "run", "comment") + (("file", "pid") if name == "wait" else ()))
        if name == "status":
            s.add_argument("target", nargs="+",
                           help="OWNER/REPO#N, OWNER/REPO/RUN_ID, or a GitHub URL; several are read in one gather, "
                                "and for pr and comment a bare #N or N reuses the repository before it")
            s.add_argument("--field", metavar="F,G",
                           help="print just these values of the --json object, tab-separated, one line per target "
                                "(dotted paths; head and checks.state|failed|pending|passed|held for a PR); "
                                "lists print comma-joined")
        else:
            s.add_argument("target", help="OWNER/REPO#N, OWNER/REPO/RUN_ID, or a GitHub URL")
        s.add_argument("--jobs", action="store_true", help="runs: also track the job list")
        s.add_argument("--json", action="store_true")
        s.add_argument("--verbose", action="store_true",
                       help="list up to 10 superseded attempts and up to 20 failed checks (as AGENT_VERBOSE=1); "
                            "by default the summary counts the superseded ones and lists 10 failures")
        if name == "wait":
            s.add_argument("--until", choices=("green", "done", "required", "merged"), default="green",
                           help="PRs: green (every check passes; fail fast), done (every check finished), "
                                "required (only the checks GitHub requires decide; fail fast) or merged; "
                                "all but merged exit 4 once the PR conflicts with its base")
            s.add_argument("--timeout", type=seconds, default=3600,
                           help="seconds (default 3600); exit 2 after")
            s.add_argument("--sha", help="the commit you pushed (git rev-parse HEAD): other heads count as pending")
            s.add_argument("--rescue-grace", type=float, default=RESCUE_GRACE, metavar="S",
                           help=f"hold a failure caused only by a glaeda runner refusing a job at setup this long "
                                f"for a rescue re-run (default {RESCUE_GRACE}; 0 rules on each attempt)")
            s.add_argument("--settle", type=float, default=SETTLE_GRACE, metavar="S",
                           help=f"PRs: a head with no check or status is not started for this long after its "
                                f"push, then exits {EXIT_NOTHING} (nothing reported; default {SETTLE_GRACE})")
            s.add_argument("--author", help="comments: only this author (github-actions[bot] or github-actions)")
            s.add_argument("--match", help="comments: a regular expression the body must contain")
            s.add_argument("--since", help="comments: after this comment id or URL, ISO time, or duration "
                                           "(10m); default the moment the wait began")
            s.add_argument("--exists", action="store_true", help="file: ready once it exists, even when empty")
            s.add_argument("--gone", action="store_true", help="file: ready once it does not exist")
            s.add_argument("--contains", help="file: ready once its text matches this regular expression")
    c = sub.add_parser("checks", help="every check of one or more commits, read once by the daemon for all sessions "
                                      "within each consumer's budget")
    c.add_argument("repo", help="OWNER/REPO")
    c.add_argument("shas", nargs="+", metavar="SHA", help="full 40-hex commit ids")
    c.add_argument("--consumer", required=True, help="who is asking (autoland, a session's name): the unit of the "
                   "hourly head-read budget")
    c.add_argument("--max-age", type=float, default=HEAD_PENDING_TTL * 2, metavar="S",
                   help=f"checks still running are served from the cache if read this recently (default {HEAD_PENDING_TTL * 2}s); "
                        "finished heads are good for 12 minutes")
    c.add_argument("--wait", type=float, default=30, metavar="S",
                   help="seconds to wait for the daemon's read (default 30; 0 serves the cache as it is)")
    c.add_argument("--json", action="store_true")
    po = sub.add_parser("post", help="queue a comment, PR or review; the daemon posts it, paced for every session")
    po.add_argument("kind", choices=("comment", "pr", "review", "status"))
    po.add_argument("target", nargs="?", help="comment, review: OWNER/REPO#N or a URL; pr: OWNER/REPO; status: an id")
    po.add_argument("--body", help="the text (prefer --body-file: backticks and dollar signs stay data)")
    po.add_argument("--body-file", metavar="PATH", help="the text from a file, - for stdin")
    po.add_argument("--title", help="pr: the title")
    po.add_argument("--head", help="pr: the branch (OWNER:BRANCH from a fork)")
    po.add_argument("--base", help="pr: the branch to merge into")
    po.add_argument("--reviewer", action="append", metavar="LOGIN", help="pr: request a review (repeatable)")
    po.add_argument("--event", choices=("comment", "approve", "request-changes"), default="comment",
                    help="review: the verdict (default comment)")
    po.add_argument("--wait", type=float, default=0, metavar="S",
                    help="seconds to wait for the URL (default 0: queue and return; the write survives the session)")
    po.add_argument("--status-key", metavar="KEY",
                    help="comment: this is your status KEY on the thread; your next comment with the same KEY edits "
                         "this one in place while it is still the thread's last comment and nobody waits on it")
    po.add_argument("--json", action="store_true")
    sub.add_parser("read", help="an upstream's end: register the keys of one JSON request on stdin and print "
                                "the cached entries (see upstream.json)")
    b = sub.add_parser("budget", help="REST and GraphQL quota as the daemon last saw it")
    b.add_argument("--json", action="store_true")
    a = sub.add_parser("audit", help="what this host's gh traffic is, and how much of it a cache would answer")
    a.add_argument("--log", type=Path, default=None, help="the call log to read (default the PATH guard's)")
    a.add_argument("--last", type=int, default=200000, metavar="N",
                   help="only the last N lines (default 200000; 0 reads all of it)")
    a.add_argument("--json", action="store_true")
    rn = sub.add_parser("runners", help="busy and idle self-hosted runners per label, from one shared read")
    rn.add_argument("scope", metavar="OWNER[/REPO]")
    rn.add_argument("--label", default=None, help="only runners carrying this label")
    rn.add_argument("--json", action="store_true")
    r = sub.add_parser("restart", help="restart a down or hung daemon once, however many sessions ask at the same time")
    r.add_argument("--force", action="store_true", help="restart even if it looks healthy or was just restarted")
    return p


def main(argv: list[str] | None = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    if raw and raw[0] == "gh":
        # Everything after `gh` belongs to the real gh, flags and all: argparse must not see it.
        if raw[1:2] == ["--install-shim"] or raw[1:2] == ["--print-shim"]:
            return cmd_gh_install_shim(raw[1] == "--print-shim")
        if raw[1:2] == ["--probe"]:
            # Whether this glaeda-gh has the broker at all, for a wrapper deciding whether to hand
            # a call to it. An older one answers with an argparse error, which is the point: a
            # wrapper that exec'd it would break every gh call on the host. Nothing else happens
            # here, so it is cheap enough for a caller to run once per build of this file.
            print(f"broker {BROKER_CONTRACT}")
            return EXIT_OK
        return cmd_gh(raw[1:])
    if raw[:1] == ["wait-resume"] and len(raw) == 2:
        # Not a command anyone types: BLOCKER hands a `wait pr|run` back here (resume_wait).
        try:
            return resume_wait(raw[1])
        except WatchError as error:
            say_waiting(f"glaeda-gh: {error}")  # a wait path: see the handler below
            say_waiting("next: glaeda-gh wait --help")
            return 64
        except KeyboardInterrupt:
            return 130
    Parser.argv = raw
    args = parser().parse_args(argv)
    if getattr(args, "verbose", False):
        os.environ["AGENT_VERBOSE"] = "1"  # summary() and wait_request() read it, here and in the daemon's request
    try:
        if args.command == "serve":
            if not args.foreground_ok and not under_service() and service_loaded():
                raise WatchError(serve_refusal())
            return serve(args.foreground_ok)
        if args.command == "budget":
            return cmd_budget(args.json)
        if args.command == "read":
            return cmd_read(sys.stdin.readline())
        if args.command == "audit":
            if args.last < 0:
                raise WatchError("--last must be 0 (all of it) or more lines")
            return cmd_audit(args.log or guard_log(), args.last, args.json)
        if args.command == "runners":
            return cmd_runners(args.scope, args.label, args.json)
        if args.command == "restart":
            return cmd_restart(args.force)
        if args.command == "post":
            if args.wait < 0:
                raise WatchError("--wait must be 0 or more seconds")
            if args.kind == "status":
                return cmd_post_status(args.target, args.wait, args.json)
            if not args.target:
                raise WatchError(f"post {args.kind} needs a target")
            return cmd_post(args)
        if args.command == "checks":
            if args.wait < 0:
                raise WatchError("--wait must be 0 or more seconds")
            bad = [x for x in args.shas if not re.fullmatch(r"[0-9a-fA-F]{40}", x)]
            if bad or not re.fullmatch(rf"{NAME}/{NAME}", args.repo):
                raise WatchError("checks takes OWNER/REPO and full 40-hex commit ids (git rev-parse HEAD)")
            return cmd_checks(args.repo, args.shas, args.consumer, args.max_age, args.wait, args.json)
        if args.command == "status":
            return cmd_status(args.kind, args.target, args.jobs, args.json, fields=parse_fields(args.field))
        if args.rescue_grace < 0:
            raise WatchError("--rescue-grace must be 0 or more seconds")
        if args.settle < 0:
            raise WatchError("--settle must be 0 or more seconds")
        if args.kind == "file":
            if args.exists and args.gone:
                raise WatchError("wait file takes one of --exists and --gone")
            return cmd_wait_file(args.target, args.timeout, args.json,
                                 "gone" if args.gone else "exists" if args.exists else "nonempty", args.contains)
        if args.kind == "pid":
            return cmd_wait_pid(args.target, args.timeout, args.json)
        if args.exists or args.gone or args.contains:
            raise WatchError("--exists, --gone and --contains are for wait file")
        if args.kind == "comment":
            if args.sha or args.jobs or args.until != "green":
                raise WatchError("wait comment takes --author, --match and --since, not --sha, --jobs or --until")
            return cmd_wait_comment(args.target, args.timeout, args.json, args.author, args.match, args.since)
        if args.author or args.match or args.since:
            raise WatchError("--author, --match and --since are for wait comment")
        return subscribe_wait(args.kind, args.target, args.until, args.timeout, args.jobs, args.json, args.sha,
                              args.rescue_grace, args.settle)
    except WatchError as error:
        # Through say_waiting for its stdout reason: this handler covers `wait --json`, so with
        # stderr closed `print(file=None)` made a bad-argument message the first line of the
        # document. The other stderr prints in this file are outside the wait paths and keep
        # `print`; see the PR.
        nxt = f"glaeda-gh {args.command} --help"
        say_waiting(f"glaeda-gh: {error}")
        say_waiting(f"next: {nxt}")
        if getattr(args, "json", False):
            print_json_error("refused", str(error), nxt)
        return 64
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
