THROTTLED = re.compile(r"submitted too quickly|secondary rate limit|abuse detection", re.I)
# Comments for one thread that are in the queue together, queued within POST_JOIN_WINDOW of the first, go out as one
# comment: each body whole, in queue order, under a rule. Only what is already queued is joined (no write waits for a
# partner): over 2026-11-10 01:00-02:00Z, 110 comments went to 53 threads, and holding each for 60 s would have
# joined 3 of them while delaying all 110. A body that starts with a machine-read marker (`<!--`: review-running,
# pr-owner, risk receipts), a slash command or an @mention, or carries a status key is never joined: its readers read
# it whole, from its first line. Only one writer's comments are joined, and a join a wait began watching since is undone
# before its retry (post_unjoin).
POST_JOIN_WINDOW = 60
POST_JOIN_RULE = "\n\n---\n\n"
JOIN_MENTION = re.compile(r"(?<![\w.`])@[A-Za-z0-9][\w-]*")  # an @mention: a bot or a person is called; never joined
# A comment queued with --status-key KEY is that writer's status on its thread: the next one from the same writer
# ("by") with the same key edits it in place, over GraphQL, while it is still the thread's last comment, no comment
# wait watches the thread, and it is under POST_STATUS_MAX old. router-review's review-running marker and its
# verdict (one run token) were 2 comments per review, back to back: 25 of the 63 the shared login posted on the 20
# busiest threads in that hour.
POST_STATUS_MAX = 6 * 3600
