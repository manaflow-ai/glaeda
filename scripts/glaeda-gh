# Head check reads (`glaeda-gh checks`): every session that wants a commit's checks asks the daemon, which
# reads each head once for all of them, in batched GraphQL queries, and keeps the answer. Each asker names
# a consumer; a consumer has an hourly budget of head reads. A reserved consumer (next-autoland) is always
# served up to its reservation, whatever the others have used; the rest share a pool, each capped, and are
# served from the cache alone once spent or when the GraphQL quota is lean.
HEAD_SETTLED_TTL = 600  # a head whose checks all finished is re-read this rarely (a rerun can change it)
HEAD_PENDING_TTL = 90  # a head with checks still running is re-read this often while someone wants it
HEAD_INTEREST = 600  # a consumer that asked this recently still wants the head read
HEAD_BATCH_MAX_CONTEXTS_PAGES = 20  # pages of 100 checks one head is followed through; more is an error, not a verdict
# (owner, repo) -> the repository whose checks at the same commit are this one's checks of record too. Both mains of
# glaeda hold the same commits (sync-main.yml), and Verify (ci.yml) verifies every main head in the fork on
# Blacksmith, not in the personal-account repository, so a teamleaderleo/glaeda head's checks include the fork's.
CHECKS_OF_RECORD = {("teamleaderleo", "glaeda"): ("manaflow-ai", "glaeda")}
