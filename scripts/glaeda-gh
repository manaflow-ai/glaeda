CONTROLLER_DEFAULT = "http://100.89.225.106:18765"  # cmux-lawrence since the 2026-09-28 move
CONTROLLER_CONFIG = Path.home() / ".local/share/cmux-fleet-client/client.json"
CONTROLLER_TOKEN = Path.home() / ".config/cmux/build-fleet/controller.token"
# One deadline used to protect against two very different things, and the cheap one set it. A controller that is
# not there (nothing listening, a dead tailnet route) must not stall a tick: that is what "3 s" was for, and a
# connect deadline says it exactly. A controller that has accepted the connection has proved it is alive, and
# giving up on it then is far more expensive than waiting: every run the fallback reads spends the shared REST
# quota (5000/h for every lane on this account together), and the first failure also takes the controller out for
# CONTROLLER_RETRY and more (controller_down), so one lost race sends a minute of run reads to REST. So the two
# get their own deadlines, and the read one is derived from what the controller actually costs.
# Measured 2026-11-21 10:05-10:35Z on a developer workstation, over its socat forward to cmux-lawrence
# (client.json points at http://127.0.0.1:18765, which socat forwards over `tailscale nc`, so "local" is a
# tailnet round trip):
#   connect, to the local forward              0.3-4.7 ms (n=43)
#   first byte                                 0.13-0.28 s, flat in body size
#   whole answer, /v1/github/events            0.13-1.47 s (p50 0.44, p90 0.53), throughput-bound: the tunnel
#                                              carries ~400 KB/s and the largest feed page seen was 321 KB
# CONTROLLER_CONNECT_TIMEOUT is ~200x the worst connect seen, and fails faster than the old 3 s did.
# CONTROLLER_READ_TIMEOUT is ~4x the worst whole answer seen, and still an order of magnitude under what losing
# the race costs (CONTROLLER_RETRY's 60 s of REST): waiting can never cost more than falling back.
CONTROLLER_CONNECT_TIMEOUT = 1.0  # a tick must not stall on an unreachable controller
CONTROLLER_READ_TIMEOUT = 6.0  # an alive controller is worth waiting for: the fallback spends REST
# Every controller request a tick makes (the feed, run baselines, on-event job lookups) together, at most: air-blue
# 2026-11-18 22:4xZ, 17.1 of a 19.1 s tick went to a controller answering TimeoutError, one on-event lookup after
# another (a failed lookup did not take the controller out), and no PR was refreshed for 2196 s. A request is cut at
# what is left of it (Controller.budget_end); the first failure takes the controller out for CONTROLLER_RETRY and more
# (controller_down), and REST, GitHub's own reads and the cache serve meanwhile.
# The budget is one whole request (so controller_room can start one at all: #2201's invariant is that the budget
# never cuts a request it allowed to start) plus room for a second when the first came back quickly. It is not a
# number of its own: widen a deadline above and this widens with it. Against the old 3 s timeout an unreachable
# controller cost a tick 3-4 s here; against the connect deadline it costs about 3 s in 1 s slices, and a
# controller that accepts and then says nothing costs one read deadline before it is taken out for a minute.
CONTROLLER_TICK_BUDGET = CONTROLLER_CONNECT_TIMEOUT + CONTROLLER_READ_TIMEOUT + 1.0
CONTROLLER_DEADLINE = CONTROLLER_CONNECT_TIMEOUT + CONTROLLER_READ_TIMEOUT + 1  # one whole controller request
CONTROLLER_RUN_MAX_WAIT = 300  # one bounded long-poll request for an active run waiter
CONTROLLER_FEED_EVERY = 20  # seconds between change-feed reads: each request costs the controller a tailnet
# whois, and 18 hosts at one read per tick drove tailscaled into a kernel panic on cmux-lawrence (10-07)
CONTROLLER_RETRY = 60  # after a failure, the controller is left alone this long, doubling up to CONTROLLER_ABSENT
REST_SAFETY = 900  # a run the controller tracks is still read over REST this often (a lost delivery)
# A run the controller still shows queued or in progress, that a wait is blocked on, and that neither changed nor
# was read from GitHub for this long, is read once more (a lost completion delivery: manaflow-ai/cmux run
# 40557947333, 2026-10-27, finished on GitHub while the controller kept it in_progress and its waiter blocked).
STALE_RUN_REREAD = 180
# A wait rules on a finished run only once GitHub itself has shown that finish since the wait began (or since a
# `gh run rerun` this host brokered): a cached or controller-fed finish can be the attempt a rerun superseded
# (manaflow-ai/cmux run 42368426030, 2026-11-07: `wait run` right after `gh run rerun --failed` returned attempt 1's
# failure at once, "data 0s ago", while GitHub had attempt 2 queued). The daemon reads it once for that
# (Daemon.due); when GitHub cannot be read this long (a spent quota), the wait rules on what it has, as before.
RUN_CONFIRM_MAX = STALE_RUN_REREAD
# The client's own controller long-poll before it hands its wait to the daemon (subscribe_wait). That poll does not
# see the cache, so a finish the daemon reads from GitHub (a lost delivery, STALE_RUN_REREAD) reaches the waiter
# only when it ends: at 300 s, a run finished at 20:46:40Z released its waiter at 20:51:16Z, 2 min after the
# daemon's 20:49:20Z read (2026-10-27). Once the daemon rules, it does so within a tick.
CLIENT_RUN_LONG_POLL = STALE_RUN_REREAD
# A watch counts as waited on this long after a wait (or a downstream's) last registered it: past the client's
# controller long-poll (subscribe_wait), which registers once before it blocks, and the daemon's touches after it.
WAIT_INTEREST = CLIENT_RUN_LONG_POLL + 2 * TOUCH_EVERY
CONTROLLER_ABSENT = 900  # a controller without the run-events receiver (404, 503) is asked again this rarely
FEED_PAGES = 5  # feed pages read per tick at most; a longer backlog continues on the next tick
FEED_HELD_MAX = 50  # pages feed_between_reads keeps for the next tick at most; past it the feed waits for that tick
# on-event: a command run once per finished run (or one job of it) the controller's feed shows (`on-event`).
# Leo, on an hourly Cloud probe: "but what's the point of checking every hour?"
ON_EVENT_CONFIG = Path(os.environ.get("GLAEDA_GH_ON_EVENT_CONFIG") or Path.home() / ".config/glaeda/on-event.json")
ON_EVENT_STATE = "on-event.json"  # under BASE: what ran, per (hook, run, attempt), kept across restarts
# A matched run whose job the controller does not hold yet (its workflow_job delivery is late, or the hub's 30000-job
# cap dropped it on a busy hour) is asked of the controller at each feed read; past ON_EVENT_REST_AFTER, GitHub is
# asked once (one REST request); past ON_EVENT_PENDING_MAX it is given up as unresolved.
ON_EVENT_REST_AFTER = 300
ON_EVENT_PENDING_MAX = 3600
ON_EVENT_KEEP = 30 * 86400  # records older than this are dropped, newest ON_EVENT_RUNS_MAX kept at most
ON_EVENT_RUNS_MAX = 1000
ON_EVENT_FIELDS = ("head_sha", "run_id", "attempt", "repo", "run_url", "job_url", "hook")  # {name} in a command
ON_EVENT_PLACEHOLDER = r"\{([a-z_]+)\}"
ON_EVENT_ENV = ("HOME", "PATH", "USER", "LOGNAME", "LANG", "LC_ALL", "TMPDIR", "SHELL")  # all a command inherits
NUDGE_MIN = 20  # a PR a check event nudged is re-read at most this often (GraphQL points)
# GraphQL diet (2026-11-01: the daemons on huge-blue and cosmic-gray spent 938 and 833 GraphQL queries an hour, the
# account's biggest spenders, while their clients read about two dozen PRs). A watch nobody has read lately is
# polled about as often as it was last read, a comment wait on a repository the controller's webhooks cover
# relies on them and polls GitHub only as a safety net, and a running head the controller covers is re-read on
# its own check events, so the TTL is only the safety net there too.
IDLE_BACKOFF_AFTER = 300  # a PR nobody has read or waited on for this long is polled as often as it was last read
IDLE_BACKOFF_MAX = 600  # ... but no less often than this (it expires at IDLE_EXPIRY)
# A waited, unfinished watch is read every cycle (60 s; 240 s when lean). Data older than this on one is starved, not
# paced: daemon.json's staleWaited says so, `restart` restarts a daemon whose heartbeat is fresh but whose waited data
# is this old, and a wait hands itself back from the daemon and reads GitHub once itself (direct_read). The heartbeat
# alone vouched for data that was 50 minutes old on huge-blue (2026-11-11), and `restart` refused.
STALE_DATA_AFTER = 600
UNREAD_LEAD_AFTER = 60.0  # a PR or run never read, watched this long, gets the first-read floor (rest_order)
# On an upstream host that reads one target itself through the broker (direct_command), a wait's data this old means
# the broker host is behind: the wait reads its target itself (wait_starved). The broker host reads a waited key
# within WAITED_FRESH even under its GraphQL reserve, and this host asks it every UPSTREAM_EVERY, so its copy is at
# most about 70 s old while the broker keeps up; 600 s left lane waits on data the broker had not refreshed.
UPSTREAM_DIRECT_AFTER = 120
# A starved wait's direct reads that find nothing new (wait_progress_print the same before and after) space out: each
# one doubles the gap to the next, from the bound up to DIRECT_QUIET_MAX, and a read that finds a change starts it
# over (direct_gap). The broker host's copy still reaches the wait every UPSTREAM_EVERY in between. huge-blue's broker,
# 2026-11-22 08:14-09:14Z: 7,888 glaeda-upstream GETs, 80% a path read before (pulls/N 4,010 of 4,837), and one wait
# on gcp-codex-lane-5 (cmux#50040, all checks done, --max 4800) re-read its PR every 120 s for the whole wait.
DIRECT_QUIET_MAX = 600.0
# After the quota stops explaining old waited data (staleExplainedAt), the daemon has this long to read the backlog
# before the data counts as starved. huge-blue, 2026-11-11 to 11-15: the shared GraphQL pool sat under the reserve
# for 10 to 20 minutes before each hourly reset (the alarm rightly "held"), and on the first tick after the reset, at
# :36 or :37, the stale alarm fired on data the stop had aged ("1044s old"); a session ran `glaeda-gh restart` 4 to 9
# s later every time, and the restart looked like the fix. The backlog was being read either way.
STALE_CATCH_UP = STALE_DATA_AFTER
# The release valve: waited data starved past STALE_DATA_AFTER with nothing explaining it, on this many ticks in a row,
# restarts the daemon itself (a re-exec, like an update's) instead of waiting for a session to run `glaeda-gh
# restart`. Not before the daemon has run STALE_DATA_AFTER itself (a new one has not had its chance), and at most
# once per STALE_VALVE_COOLDOWN (restart.json "valve"): a second starvation that soon is not one a restart fixes.
STALE_VALVE_TICKS = 2
STALE_VALVE_COOLDOWN = 1800
# The one-key rule below (the daemon reads its other waited keys, so one stale key is no reason to drop the land
# queue's judgments) has an end: a key this old after its nudged reads (they go first every tick) is a read loop that
# cannot reach it, and a restart is what clears that. huge-blue, 2026-11-20 03:2xZ, 04:2xZ, 05:2xZ: pr data 10446 s old
# (pr:manaflow-ai/cmux#47751 at 6751 s on the last), "backlog: 7 pr reads stored", ticks 91.8 s in "read rest", the
# valve answering "one_key" every tick, and a person running `glaeda-gh restart` each time. Above 3963 s, which the
# 11-18 incident's rule was made for, and below the hours a person waited.
STALE_ONE_KEY_MAX = 2 * 3600
# Read progress (daemon.json "progress", Daemon.stall_cause): the reads this daemon stored per kind over this window,
# where its ticks spent their time (each top-level phase, the waits for a GraphQL slot, GitHub's answers) and the
# request in flight. huge-blue, 2026-11-18: pr data for waits 3088 s, then 748 s 18 min after a restart, old behind a
# fresh heartbeat with no error recorded; the heartbeat said the loop came round, not that it read anything, and
# nothing said where the ticks went. A kind with waited data past STALE_DATA_AFTER and no read stored in this window
# is stalled, whatever another process wrote to one key's cache (the valve's one-key rule needs this daemon's own
# reads); one with reads stored is a backlog, and its cause is said once.
READ_PROGRESS_WINDOW = 600.0
# A GraphQL slot (graphql_slot_take) that the daemon waits for: its want mark (BASE/graphql-slots/LOGIN.want, touched
# while it waits) holds every other taker back while it is this fresh, so the next slot that frees goes to the daemon,
# whose one read serves every wait, not to the next of the broker's `gh` calls polling the same locks.
GRAPHQL_SLOT_WANT_FRESH = 1.0
GRAPHQL_SLOT_WANT_TOUCH = 0.25
# A slot is held per request, for at most this long by anyone in this process (graphql_slot_reap): the daemon's own
# request ends within HTTP_DEADLINE. huge-blue, 2026-11-18 ~20:00Z: both of the login's slots flocked by the serve
# process while no pr read was stored for 600 s and nothing said who held them. Past the bound the watchdog closes the
# holder's slot file (the lock goes with it), logged once naming the thread, what it read and for how long.
GRAPHQL_SLOT_HOLD_MAX = 2.0 * HTTP_DEADLINE
# A slot whose request is on the wire (graphql_slot_flight) is past the reap's reach until this: a land worker's thread
# has no SIGALRM deadline, and its slot freed under it let a second request in (review of glaeda#2189, F3). Every
# daemon request is in flight from take to release, so a hung one is still freed past it, logged as in flight with its
# thread and its call (review of glaeda#2199).
GRAPHQL_SLOT_FLIGHT_MAX = 4.0 * GRAPHQL_SLOT_HOLD_MAX
STALE_RESTART_ADVICE = "`glaeda-gh restart` restarts a daemon in this state."
STALE_DEFERRED_ADVICE = "A restart would not read any sooner: the budget above holds the reads back."
STALE_PACED_ADVICE = ("A restart would not read any sooner: the pace above is too slow for what waits are blocked on; "
                      "raise graphqlPerMinute in the policy, or block fewer waits at once.")
# "Held" is not forever. huge-blue, 2026-11-20: waited PR data sat up to 39,600 s old all day while the stale alarm read
# "held": each new quota stop, secondary hold or budget deferral re-armed stale_explained and catching_up, nothing
# bounded the total age, and nobody heard until `now` showed a RED line. Past STALE_HELD_MAX of waited age the alarm
