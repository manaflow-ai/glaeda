# Guest repositories (any repo other than --home-repo, admitted by an org-scoped runner's --allowed-owner)
# never touch cmux's canonical roots or persistent DerivedData, so they are costed by job-id suffix alone:
# "-sim" or "simulator" uses the one CoreSimulator service, "-light" is small, anything else is isolated.
DEFAULT_HOME_REPO = "manaflow-ai/cmux"


GUEST_WAIT_S = 600.0  # guests have no rescue workflow: a full mini holds their job this long before refusing
# A DEV Release compile is placed again when the runner that accepted it is already full. GitHub cannot move a
# job after it has entered runner setup, so the hook refuses after this short bounded wait; the owned-pool rescue
# then re-runs it through placement, where an idle warm-cache mini (or the configured overflow) can take it.
DEV_COMPILE_CAPACITY_WAIT_S = 60.0
# The DEV daily publisher's Mac jobs (verify, the tip DMG) take 1.6 and 2.5 min p95 on Blacksmith, and their
# timeout-minutes (15 and 20) count the wait inside "Set up runner". A full mini held tip-dmg-build there 19 min
# (cmux run 40466210697, 2026-10-27) until GitHub timed it out and the DEV feed went stale. So every job of that
# workflow waits DEV_COMPILE_CAPACITY_WAIT_S at most and is then refused; cmux's owned-pool rescue re-runs a refused
# job, and attempt 2 takes Blacksmith. The bound, like the DEV compile's, is when the last try starts: one try can
# wait ADMISSION_WAIT_S more for admission.lock, so the refusal comes within DEV_BOUND_WORST_S, far inside the 15
# and 20 minute timeouts it protects.
DEV_DAILY_WORKFLOW = "cmux-next-dev-daily.yml"
# CAPACITY_WAIT: an ordinary cmux job that finds its units or tokens taken waits for them, with no time limit,
# instead of failing. The DEV cmux-next scheme compile is the bounded exception above: GitHub handed the job to
# this runner and never moves it to another one, so a refusal only turned a
# capacity problem into a red job and a rescue round trip (cmux PR #15160's compile admission, 2026-09-28: refused
# after 240 s on cmux10s while two E2E builds on the mini's non-root runners held both canonical roots). A job
# waiting here is still in its runner's setup, and cmux's owned-pool rescue re-runs a job that waits there too
# long on Blacksmith, as it does a job queued too long. --gui-wait N caps the wait (then it refuses), for tests.
# The waiter polls every ADMIT_POLL_S and logs what it waits for, and who holds it, when that changes and every
# ADMIT_NOTE_S. It leaves a marker, capacity/admit.want-<pid> (ADMIT_WANT: the token kinds it needs, since when,
# and who it is), rewritten every poll: a later admission that needs one of those kinds waits behind it instead
# of taking a token the moment it frees (fair_turn; nightly and DEV jobs rank ahead, FEED_FIRST), and the listener
# gate holds this mini's runners whose next job would compete for them (mini_full), so GitHub keeps such jobs queued
# for other minis.
ADMIT_POLL_S = 2.0
ADMIT_NOTE_S = 60.0
ADMIT_WANT = "admit.want-"
# A waiter rewrites its marker after every try, and one try can take a minute on a loaded mini (admission.lock,
# a preempted fleet build, lsof and ps timeouts), so a marker counts until it is this old or its pid is gone.
ADMIT_FRESH_S = 180.0
HOLDERS_BUDGET_S = 10.0  # token_holders stops looking after this long: the log line is not worth more
# The gui runner's reserve: one unit per gui runner that no other job takes while that runner is idle. Side and root
# jobs (compiles, daemon tests, fast-tier off the fast runner, isolated builds: 3 to 6 units each) filled every unit
# on a mini, so its one gui runner's gate held the listener off as full, and the gui label's jobs (app-host shards,
# cmux-next's swift test) queued 1.5 to 3 h with 13 gui runners online (2026-10-21 ~23:00Z: about 6 listening). The
# gui runner's listener gate holds an flock on capacity/<gui token>.reserve while its runner has no job and nothing
# but capacity holds it off (Gate.reserve); every other admission (take_capacity, ci-step admit and fits) and every
# other runner's gate (mini_full) then leaves GUI_RESERVE_UNITS units free, and the gui runner's own job takes them.
# A flock dies with its gate, so a mini without a gui runner, or with a stopped one, reserves nothing, and no host
# list or flag says which minis have one. A reserve never makes a job unfittable: one that needs the whole mini
# ignores it (reserve_for).
GUI_RESERVE = ".reserve"
GUI_RESERVE_UNITS = 1
# The freshness slot's reserve: the DEV compile runner (--dev-compile-runner, the glaeda-dev-* label, which only
# cmux NEXT's feed compiles target: a feat-cmux-next push's Release compile and DEV compile, a DEV daily's) holds
# capacity/fresh.reserve the same way while it is idle, for FRESH_RESERVE_UNITS, the costlier of those jobs
# (their JOB_CORES: 3 each). Without it the slot shared the mini's units with the PR
# side runners beside it: on 2026-10-26 from 23:53Z both DEV runners were held off as full while PR jobs filled
# their minis, and a feat-cmux-next push's nightly-next promote compile queued 30+ min on the shared side label
# behind 21 PR jobs. With the reserve, PR jobs on that mini drain off those units instead of refilling them, so the
# slot is listening for the next feed compile; cmux's placement takes it only while idle and otherwise falls back
# to the side label and Blacksmith, so the reservation never makes a job wait on it.
FRESH_RESERVE_TOKEN = "fresh"
FRESH_RESERVE_UNITS = max(JOB_CORES[("cmux-next.yml", job)] for job in ("cmux-scheme-compile", "release-compile"))
# A reserving runner's gate keeps its reserve through its own job, lent to that job: the job's admission holder (the
# detached process whose flocks are the job's units, take_capacity) also holds an flock on
# capacity/<token>.reserve.lent, and while that flock is held the reserve keeps nothing (gui_reserved), since the job
# holds those units itself. The flock dies with the holder, as the job's units go back, so the reserve is whole again
# at that moment, with no gate poll in between and no pid to trust. Before, the gate let the reserve go once its job
# was admitted and took it again on its first idle poll, seconds after job-completed released the units: a PR job
# waiting here for units took them in that gap, so the slot found the mini full right after each job and held its
# listener off (2026-10-27 05:07:50Z: "only 1 of 14 capacity units on this mini are free; its next job needs 4", 6 s
# after a DEV compile ended), and a feed compile its listener took at once met a PR waiter ahead of it for units
# instead of its own reserve (run 40452488452, refused at 05:06Z: "has waited longer here for units"). Like every file
# in the ledger, any process of the runner user can take the flock; the ledger is cooperative between the jobs on one
# mini, which can take unit flocks directly as well.
RESERVE_LENT = ".lent"
LEND_WAIT_S = 5.0  # an admission waits this long for the previous job's holder to let go of the lend
UNITS_FULL = "capacity units on this mini"  # in mini_full's answers that are about units (Gate.reserves)


def reserve_units(name: str) -> int:
    """The units one held <token>.reserve keeps: the freshness slot's FRESH_RESERVE_UNITS, a gui runner's
    GUI_RESERVE_UNITS."""
    return FRESH_RESERVE_UNITS if name == f"{FRESH_RESERVE_TOKEN}{GUI_RESERVE}" else GUI_RESERVE_UNITS


def lent_file(reserve: Path) -> Path:
    return reserve.with_name(reserve.name + RESERVE_LENT)


def reserve_lent(reserve: Path) -> bool:
    """Whether this reserve is lent to its runner's own admitted job: that job's holder holds <token>.reserve.lent
    (RESERVE_LENT). Never raises: an unreadable file lends nothing."""
    return not probe(lent_file(reserve))


def gui_reserved(capacity_dir: Path, own_token: str | None = None) -> int:
    """The units this mini keeps for idle reserving runners: reserve_units() for each <token>.reserve an idle gui
    runner's (or the freshness slot's) gate holds, except own_token's (a runner's own job takes its own reserve) and
    one lent to its runner's running job (RESERVE_LENT). Never raises: an unreadable ledger reserves nothing."""
    try:
        paths = sorted(capacity_dir.glob(f"*{GUI_RESERVE}"))
    except OSError:
        return 0
    own = f"{own_token}{GUI_RESERVE}" if own_token is not None else None
    return sum(reserve_units(path.name) for path in paths
               if path.name != own and not probe(path) and not reserve_lent(path))


def reserve_for(reserved: int, units: int, total: int) -> int:
    """The reserved units a job of `units` must leave free on a mini of `total`: at most what is left beside it, and
    none for a job that takes no unit (the fast runner's fast-tier listens and admits with every unit taken)."""
    return max(0, min(reserved, total - units)) if units > 0 else 0


def kept_note(kept: int) -> str:
    return f" and {kept} {'is' if kept == 1 else 'are'} kept for an idle reserving runner" if kept else ""


def is_guest(repo: str | None, home_repo: str = DEFAULT_HOME_REPO) -> bool:
    """An unknown repository is a guest: the safe side, since a guest never takes cmux's roots."""
    return not repo or repo.lower() != home_repo.lower()


def workflow_file(ref: str | None) -> str:
    """The workflow file of GITHUB_WORKFLOW_REF (owner/repo/.github/workflows/<file>@<ref>), or ""."""
    path = (ref or "").split("@", 1)[0]
    return path.rsplit("/", 1)[-1] if "/.github/workflows/" in path else ""


def job_workflow() -> str:
    """This job's workflow file, from GITHUB_WORKFLOW_REF, else a workflow_dispatch payload's `workflow` path."""
    found = workflow_file(os.environ.get("GITHUB_WORKFLOW_REF"))
    if found:
        return found
    event = load_event(os.environ.get("GITHUB_EVENT_PATH")) if os.environ.get("GITHUB_EVENT_PATH") else None
    path = event.get("workflow") if isinstance(event, dict) else None
    return path.rsplit("/", 1)[-1] if isinstance(path, str) and path.startswith(".github/workflows/") else ""


def dev_compile_capacity_wait(repo: str | None, home_repo: str, event_name: str | None,
                              ref: str | None, event: dict[str, Any] | None, job: str,
                              workflow: str) -> float | None:
    """The bounded capacity wait for cmux NEXT's DEV compile, or None for ordinary jobs.

    A push to feat-cmux-next runs the DEV Release product in ``cmux-scheme-compile``. A DEV daily
    workflow_dispatch carries ``inputs.dev_daily=true``. Every job of DEV_DAILY_WORKFLOW (the publisher's verify
    and tip DMG jobs, whose short timeouts count this wait) is bounded too. Once a job has been claimed by a runner,
    waiting longer only strands it on one mini; a refusal lets the owned-pool rescue run placement again.
    """
    if repo is None or repo.lower() != home_repo.lower():
        return None
    if workflow == DEV_DAILY_WORKFLOW:
        return DEV_COMPILE_CAPACITY_WAIT_S
    if workflow != "cmux-next.yml" or job != "cmux-scheme-compile":
        return None
    if event_name == "push" and ref == "refs/heads/feat-cmux-next":
        return DEV_COMPILE_CAPACITY_WAIT_S
    if event_name == "workflow_dispatch" and isinstance(event, dict):
        inputs = event.get("inputs")
        if isinstance(inputs, dict) and str(inputs.get("dev_daily", "")).lower() == "true":
            return DEV_COMPILE_CAPACITY_WAIT_S
    return None


def bounded_wait(cap: float | None, bound: float | None) -> float | None:
    """The shorter of an explicit wait (`cap`, None for no limit) and a job's own bound (None for none)."""
    if bound is None:
        return cap
    return bound if cap is None else min(cap, bound)


def slot_capacity_wait(cap: float | None, dev_compile_runner: bool) -> float | None:
    """`cap`, bounded on the freshness slot (an explicit longer --gui-wait is clamped too): every job it admits (a push's release-compile too, which
    dev_compile_capacity_wait does not name) waits at most DEV_COMPILE_CAPACITY_WAIT_S. GitHub never moves a job
    off the runner that took it, so a refusal lets placement send it to the side label or Blacksmith instead of
    stranding it here (review of glaeda#1636)."""
    if not dev_compile_runner:
        return cap
    return DEV_COMPILE_CAPACITY_WAIT_S if cap is None else min(cap, DEV_COMPILE_CAPACITY_WAIT_S)


def job_class(job: str, repo: str | None, home_repo: str = DEFAULT_HOME_REPO,
              workflow: str = "") -> tuple[str, bool]:
    """The job's class and whether it is pinned to /private/tmp/cmux-ci (an unknown job of the home repo)."""
    if is_guest(repo, home_repo):
        name = job.lower()
        if name.endswith("-sim") or name.endswith("simulator"):
            return "simulator", False
        return ("light" if name.endswith("-light") else "isolated"), False
    if (workflow, job) in WORKFLOW_JOB_CLASSES:
        return WORKFLOW_JOB_CLASSES[(workflow, job)], False
    return JOB_CLASSES.get(job, "compile"), job not in JOB_CLASSES


def job_units(klass: str, job: str, repo: str | None, home_repo: str = DEFAULT_HOME_REPO, workflow: str = "") -> int:
    """The cores this job is estimated to use: its JOB_CORES entry, else its class's CLASS_COST units."""
    key = (workflow, job) if not is_guest(repo, home_repo) else ((repo or "").lower(), workflow, job)
    return JOB_CORES.get(key, CLASS_COST[klass][0])


CANONICAL_ROOT_ENV = "CMUX_CI_CANONICAL_ROOT"
# With more than one root, these restore a producer's product into the producer's root (#filePath is baked
# in there), so they take that root from their restore step, not a token-chosen one at job start.
ROOT_CONSUMERS = ("gui", "product", "gui-step")
# Producers whose admission root sits in a holder of its own (root_holder_file), so a step can swap it for the
# root of a product the job reuses instead of compiling (glaeda-canonical-root take ROOT --switch): the old
# root is let go once the new one is held, so a switch that times out leaves the job on its old root.
ROOT_SWITCHERS = ("compile-gui",)
TAKE_ROOT_POLL_S = 1.0
# glaeda-canonical-root take-gui: a job takes the gui token only for the steps that use the console session.
# It holds a root while it waits, and a gui job (gui at admission) may be waiting in take-root for that root:
# the lock orders are opposite. So a take-root waiter leaves a marker, capacity/root-k.want-<pid> ("gui" when
# its job holds the gui token), and take-gui gives way (TAKE_GUI_GAVE_WAY) when a gui holder wants its root.
TAKE_GUI_GAVE_WAY = 3
WANT_FRESH_S = 10.0  # a waiter rewrites its marker every TAKE_ROOT_POLL_S; an older one is stale


# Compile admission keeps its DerivedData per canonical root on the mini (cmux ci-macos.yml
# CMUX_OWNED_STATE_ROOT: root 1 in OWNED_STATE_DIR, root k in OWNED_STATE_DIR/cmux-ci-k), and cmux's
# owned_build_state.py `keep` stamps it (stamp.json) with the commit the build merged onto (`merged_onto`,
# cmux#14717) and its pull request (`pr`, cmux#14718). cmux's picker sends admission to a root runner whose
# mini is warm for the run (warm affinity, cmux#14696), but the root follows the token, not the runner, so
# the hook gives such a job the root whose stamp holds its base, else its pull request, before the runner's
# own root. cmux stamps the merge commit's first parent; the event's pull_request.base.sha is the same
# commit unless the base moved between the event and the merge ref, when only the pull request matches.
# Any job on the mini can write these files, so they are read as untrusted: regular files only, bounded,
# never blocking, and any failure means "not warm".
OWNED_STATE_DIR = os.path.join(FLEET_DIR, "ci")
WARM_JOBS = ("macos-compile-admission",)
WARM_SHA = re.compile(r"[0-9a-f]{40}")
# cmux owned_build_state.py STATE_VERSION: a stamp of another version is cold there too.
OWNED_STATE_VERSION = "-owned-rec1"
STAMP_MAX_BYTES = 64 * 1024


def job_warm_keys(event: Any) -> tuple[str, ...]:
    """A pull request event's warm keys, best first: its base commit's sha12, then pr-<number>."""
    pr = event.get("pull_request") if isinstance(event, dict) else None
    if not isinstance(pr, dict):
        return ()
    keys = []
    base = pr.get("base")
    sha = str(base.get("sha") or "").lower() if isinstance(base, dict) else ""
    if WARM_SHA.fullmatch(sha):
        keys.append(sha[:12])
    number = pr.get("number")
    if isinstance(number, int) and not isinstance(number, bool) and 0 < number < 10**9:
        keys.append(f"pr-{number}")
    return tuple(keys)


def root_warm_keys(k: int, state_dir: str = "") -> list[str]:
    """The warm keys of root k's kept DerivedData ([base sha12, pr-<n>]), or [] (none, unreadable, mid-keep)."""
    base = Path(state_dir or OWNED_STATE_DIR)
    store = base if k == 1 else base / f"cmux-ci-{k}"
    try:
        fd = os.open(store / "stamp.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                return []
            raw = os.read(fd, STAMP_MAX_BYTES + 1)
        finally:
            os.close(fd)
        if len(raw) > STAMP_MAX_BYTES or not (store / "derived-data").is_dir():
            return []
        stamp = json.loads(raw.decode("utf-8"))
        if not isinstance(stamp, dict) or not str(stamp.get("fingerprint") or "").endswith(OWNED_STATE_VERSION):
            return []
        keys = []
        merged_onto = str(stamp.get("merged_onto") or "").lower()
        if WARM_SHA.fullmatch(merged_onto):
            keys.append(merged_onto[:12])
        number = stamp.get("pr")
        if isinstance(number, int) and not isinstance(number, bool) and 0 < number < 10**9:
            keys.append(f"pr-{number}")
        return keys
    except Exception:  # noqa: BLE001 - a stamp any job can write must never refuse or fail a job
        return []


def warm_root_order(order: list[int], keys: tuple[str, ...], state_dir: str = "") -> tuple[list[int], str]:
    """ORDER (root copies, 0-based) with the roots warm for KEYS first, best key first, and the key matched."""
    if not keys:
        return order, ""
    kept = {copy: root_warm_keys(copy + 1, state_dir) for copy in order}
    for key in keys:
        warm = [copy for copy in order if key in kept[copy]]
        if warm:
            return [*warm, *(copy for copy in order if copy not in warm)], key
    return order, ""


# Warm root choice by predicted compile (cmux#14778, cmuxterm-hq#661 WS6). cmux's compile admission records
# what each compile cost against how far its start was (warm_distance.py) and fits tiers of app Swift files
# changed between the start and the build: near (at most near_app_swift_files, no package interface change,
# no hot file), far (more), rebuild (a package change or a hot file: the whole `cmux` module recompiles).
# It copies the fitted model beside root 1's stamp (WARM_MODEL) and stamps each kept build with its pull
# request's own app Swift files. The hook predicts each free root's compile from its stamp: the files main
# changed between the kept build's merge base and the job's (the seed prefetch's blobless mirror, trees
# only), plus the kept pull request's own files, which the job undoes unless it is the same pull request.
# The job's own files are the same for every root, so they are left out. The cheapest root goes first, the
# runner's own root on a tie. The mirror lacking a commit, a missing model or stamp, or any error falls back
# to the exact warm keys (warm_root_order). The model and stamps are written by jobs, so they are read as
# untrusted and bounded, like the stamps above.
WARM_MODEL = "warm-distance-model.json"
WARM_PR_BUILDS = "pr-builds"
WARM_PR_BUILD_MAX_JOBS = int(os.environ.get("CMUX_PR_SLOT_MAX_JOBS") or 80)
WARM_MIRROR = os.path.join(".prefetch", "cmux.git")
WARM_ROUTE_ENV = "GLAEDA_WARM_ROUTE"
WARM_GIT_TIMEOUT_S = 2.0
# All roots' diffs together, under the admission lock (others wait at most ADMISSION_WAIT_S).
WARM_BUDGET_S = 3.0
WARM_MAX_FILES = 400
WARM_PACKAGE_SOURCES = ("Packages/", "vendor/", "Examples/")
WARM_NOT_APP = ("cmuxTests/", "cmuxUITests/")
# The model fitted on 223 admissions of 2026-09-25/26 (cmux scripts/ci/warm-distance-model.json), used
# until a job has copied one to this mini.
WARM_DEFAULT_MODEL = {"near_app_swift_files": 5, "hot_files": [],
                      "tiers": {"near": 140.0, "far": 266.5, "rebuild": 400.7}, "kept": {}, "unknown": 309.7}
# Every root the hook compares starts from its kept build, and a kept start compiles faster than the tier's
# mix of kept and seed starts (a near one about 90 s against 140 s). cmux's model keeps the p50 per tier and
# start kind (tiers_by_start, with counts); a tier's kept cell costs a root once it has this many compiles,
# as cmux warm_distance.py predict() does (MIN_START_ROWS).
WARM_MIN_START_ROWS = 5


def warm_app_swift(path: str) -> bool:
    return path.endswith(".swift") and "/Tests/" not in path and not path.startswith(WARM_NOT_APP)


def read_warm_model(state_dir: str = "") -> dict[str, Any]:
    """The fitted tiers (seconds), near threshold, hot files and unknown-start cost; the default when unreadable."""
    def seconds(value: Any) -> float:
        number = float(value)
        if not math.isfinite(number) or number < 0:
            raise ValueError("not a duration")
        return number

    try:
        raw = read_bounded(Path(state_dir or OWNED_STATE_DIR) / WARM_MODEL)
        model = json.loads(raw.decode("utf-8")) if raw is not None else None
        tiers = {name: seconds(model["tiers"][name]["p50"]) for name in ("near", "far", "rebuild")}
        hot = [str(path) for path in model.get("hot_files") or [] if isinstance(path, str)][:200]
        near = int(model.get("near_app_swift_files") or 5)
        unknown = seconds(((model.get("start_classes") or {}).get("none") or {}).get("expected") or tiers["far"])
        kept = {}
        by_start = model.get("tiers_by_start")
        for name in tiers:
            try:  # a model without tiers_by_start, a sparse cell or a bad one: that tier's p50
                cell = by_start[name]["kept"]
                count = cell["n"]
                if isinstance(count, int) and not isinstance(count, bool) and count >= WARM_MIN_START_ROWS \
                        and not isinstance(cell["p50"], bool) and seconds(cell["p50"]) > 0:
                    kept[name] = seconds(cell["p50"])
            except Exception:  # noqa: BLE001
                pass
        return {"near_app_swift_files": near, "hot_files": hot, "tiers": tiers, "kept": kept, "unknown": unknown}
    except Exception:  # noqa: BLE001 - a model any job can write only ever falls back to the default
        return dict(WARM_DEFAULT_MODEL)


def read_bounded(path: Path) -> bytes | None:
    """A regular file's bytes, at most STAMP_MAX_BYTES, never blocking on a FIFO; None otherwise."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        raw = os.read(fd, STAMP_MAX_BYTES + 1)
    finally:
        os.close(fd)
    return raw if len(raw) <= STAMP_MAX_BYTES else None


def root_stamp(k: int, state_dir: str = "", number: int | None = None) -> dict[str, Any] | None:
    """Root k's kept-build stamp when it is current (STATE_VERSION, DerivedData present), else None.

    With NUMBER, a build of that pull request parked on the root (cmux owned_build_state.py PR slots,
    `pr-builds/pr-<n>`, which admission swaps back in or adopts from before it reads the kept build) comes
    first.
    """
    base = Path(state_dir or OWNED_STATE_DIR)
    store = base if k == 1 else base / f"cmux-ci-{k}"
    kept = root_stamp_at(store)
    if number is not None:
        # admission's `check` swaps a parked build in over another pull request's build, and adopts from it
        # where the root keeps main (cmux owned_build_state.py holds_last_main): either way the job starts there.
        slot = store / WARM_PR_BUILDS / f"pr-{number}"
        fresh = parked_slot_within_reuse_distance(slot)
        parked = root_stamp_at(slot) if fresh else None
        if parked is not None and parked.get("pr") == number:
            return parked
    return kept


def parked_slot_within_reuse_distance(slot: Path) -> bool:
    """Use host job reuse distance for parked builds; without telemetry, the slot count is the bound."""
    try:
        parked_at = slot.stat().st_mtime
    except OSError:
        return False
    log = JOB_LOG
    try:
        jobs = 0
        with log.open(encoding="utf-8", errors="replace") as file:
            for line in file:
                if '"started"' not in line:
                    continue
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if event.get("event") == "started" and isinstance(event.get("at"), (int, float)) \
                        and event["at"] >= parked_at:
                    jobs += 1
        return jobs < WARM_PR_BUILD_MAX_JOBS
    except OSError:
        return True


def root_stamp_at(store: Path) -> dict[str, Any] | None:
    try:
        raw = read_bounded(store / "stamp.json")
        if raw is None or not (store / "derived-data").is_dir():
            return None
        stamp = json.loads(raw.decode("utf-8"))
        if not isinstance(stamp, dict) or not str(stamp.get("fingerprint") or "").endswith(OWNED_STATE_VERSION):
            return None
        return stamp
    except Exception:  # noqa: BLE001
        return None


def main_changes(mirror: Path, old: str, new: str) -> tuple[set[str], bool] | None:
    """App Swift files main changed between two commits, and whether a package source or submodule did."""
    if not (WARM_SHA.fullmatch(old) and WARM_SHA.fullmatch(new)):
        return None
    if old == new:
        return set(), False
    try:
        env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
        raw = subprocess.run([GIT, "-C", os.fspath(mirror), "diff", "--raw", "-z", "--no-renames", "--no-abbrev",
                              old, new, "--"], capture_output=True, timeout=WARM_GIT_TIMEOUT_S,
                             env={**env, "GIT_NO_LAZY_FETCH": "1", "GIT_TERMINAL_PROMPT": "0"})
    except (OSError, subprocess.SubprocessError):
        return None
    if raw.returncode != 0:
        return None
    fields = raw.stdout.decode("utf-8", "replace").split("\0")
    files: set[str] = set()
    package = False
    for meta, path in zip(fields[0::2], fields[1::2]):
        if "160000" in (mode.lstrip(":") for mode in meta.split()[:2]):
            package = True  # a submodule bump: its sources changed
            continue
        if warm_app_swift(path):
            files.add(path)
            package = package or path.startswith(WARM_PACKAGE_SOURCES)
    return files, package


def warm_root_costs(order: list[int], base: str, number: int | None, state_dir: str = "",
                    job_files: int = 0) -> tuple[list[int], dict]:
    """ORDER with the root of the lowest predicted compile first, and the per-root predictions; ([], {}) to fall back.

    A root's prediction is the tier of main's changes from its kept build's merge base to BASE plus the kept
    pull request's own files and JOB_FILES, the job's own (the event's changed_files, an upper bound: the
    mirror has no pull request heads), unless the kept build is pull request NUMBER's, which has both
    built already (09-26: #14149's 124 files were predicted near from other pull requests' builds). It
    costs that tier's kept-start p50 when the model has one (read_warm_model()). Roots of one tier rank
    by that file count, then the runner's own root. A kept build that cannot be compared (a base past the mirror's depth,
    a stamp of an older cmux) costs the model's unknown start; a root with no kept build at all goes last.
    Falls back when no root could be compared, the mirror is missing, or WARM_BUDGET_S runs out.
    """
    if not WARM_SHA.fullmatch(base or ""):
        return [], {}
    mirror = Path(state_dir or OWNED_STATE_DIR) / WARM_MIRROR
    if not (mirror / "HEAD").is_file():
        return [], {}
    model = read_warm_model(state_dir)
    cold = max(model["tiers"].values()) + 1.0
    deadline = time.monotonic() + WARM_BUDGET_S
    diffs: dict[str, tuple[set[str], bool] | None] = {}
    costs: dict[int, tuple[float, str, int]] = {}
    known = 0
    for copy in order:
        stamp = root_stamp(copy + 1, state_dir, number)
        if stamp is None:
            costs[copy] = (cold, "cold", -1)
            continue
        onto = str(stamp.get("merged_onto") or "").lower()
        if onto not in diffs:
            if time.monotonic() >= deadline:
                return [], {}
            diffs[onto] = main_changes(mirror, onto, base)
        changes = diffs[onto]
        same = isinstance(stamp.get("pr"), int) and stamp.get("pr") == number
        if changes is None or (not same and "pr_app_swift_files" not in stamp and stamp.get("pr")):
            costs[copy] = (model["unknown"], "unknown", -1)  # not comparable, or an older cmux's stamp
            continue
        files, package = changes
        own = stamp.get("pr_app_swift_files") if not same else []
        own = own if isinstance(own, list) else []
        own_set = {str(path) for path in own[:WARM_MAX_FILES] if isinstance(path, str) and warm_app_swift(path)}
        total = stamp.get("pr_app_swift_total") if not same else 0
        extra = max(0, total - len(own_set)) if isinstance(total, int) and not isinstance(total, bool) else 0
        interface = stamp.get("pr_package_interface") if not same else False
        # A list cut short may hide a package file: unless the stamp says no interface changed, assume one did.
        own_package = any(path.startswith(WARM_PACKAGE_SOURCES) for path in own_set) or extra > 0
        package = package or (own_package and interface is not False)
        changed = files | own_set
        count = len(changed) + extra + (0 if same else max(0, job_files))
        hot = bool(changed & set(model["hot_files"]))
        name = ("rebuild" if package or hot else "far" if count > model["near_app_swift_files"] else "near")
        costs[copy] = (model["kept"].get(name, model["tiers"][name]), name, count)
        known += 1
    if not known:
        return [], {}
    ranked = sorted(order, key=lambda copy: (costs[copy][0], costs[copy][2], order.index(copy)))
    return ranked, {f"root-{copy + 1}": {"seconds": round(costs[copy][0], 1), "tier": costs[copy][1],
                                         "app_swift_files": costs[copy][2]} for copy in order}


def job_warm_target(event: Any) -> tuple[str, int | None, int]:
    """A pull request event's base sha, number and changed file count, or ("", None, 0)."""
    pr = event.get("pull_request") if isinstance(event, dict) else None
    if not isinstance(pr, dict):
        return "", None, 0
    base = pr.get("base")
    sha = str(base.get("sha") or "").lower() if isinstance(base, dict) else ""
    number = pr.get("number")
    number = number if isinstance(number, int) and not isinstance(number, bool) and 0 < number < 10**9 else None
    changed = pr.get("changed_files")
    changed = changed if isinstance(changed, int) and not isinstance(changed, bool) and 0 <= changed < 10**6 else 0
    return (sha if WARM_SHA.fullmatch(sha) else ""), number, changed


def export_warm_route(route: dict) -> None:
    """Hand the job the root predictions (cmux warm_distance.py records them): $GITHUB_ENV, one line."""
    target = os.environ.get("GITHUB_ENV")
    if not target or not route:
        return
    with contextlib.suppress(OSError):
        with open(target, "a", encoding="utf-8") as env_file:
            env_file.write(f"{WARM_ROUTE_ENV}={json.dumps(route, separators=(',', ':'), sort_keys=True)}\n")


def canonical_root(k: int) -> str:
    """Root k (1-based): /private/tmp/cmux-ci, then /private/tmp/cmux-ci-2 and so on (cmux#14338)."""
    return "/private/tmp/cmux-ci" if k == 1 else f"/private/tmp/cmux-ci-{k}"


def export_root(name: str) -> str:
    """Tell the job which root its token holds: $GITHUB_ENV for later steps, and $RUNNER_TEMP/glaeda-canonical-root."""
    path = canonical_root(int(name.rsplit("-", 1)[1]))
    wrote = []
    for var, target in (("GITHUB_ENV", None), ("RUNNER_TEMP", "glaeda-canonical-root")):
        base = os.environ.get(var)
        if not base:
            continue
        try:
            if target is None:
                with open(base, "a", encoding="utf-8") as env_file:
                    env_file.write(f"{CANONICAL_ROOT_ENV}={path}\n")
            else:
                Path(base, target).write_text(path + "\n", encoding="utf-8")
            wrote.append(var)
        except OSError:
            pass
    return f"{CANONICAL_ROOT_ENV}={path} via {'+'.join(wrote) or 'nothing (no GITHUB_ENV or RUNNER_TEMP)'}"
ADMISSION_WAIT_S = 30.0  # admissions are serialized briefly so two jobs never split the free units
# A DEV-bounded job's worst wait before its refusal (DEV_DAILY_WORKFLOW's comment).
DEV_BOUND_WORST_S = DEV_COMPILE_CAPACITY_WAIT_S + ADMISSION_WAIT_S + ADMIT_POLL_S
# The listener gate reads its runner's --capacity-units from the job-started hook glaeda-cmux-runner wrote.
RUNNER_HOOK_SCRIPT = "glaeda-hooks/job-started.sh"
LISTEN_SCRIPT = "glaeda-hooks/listen.sh"
LSOF = shutil.which("lsof") or "/usr/sbin/lsof"
GIT = shutil.which("git") or "/usr/bin/git"
# Events whose code is the repository's own, or a same-repo pull request checked below. Comment,
# check and review-comment events can run with secrets on behalf of a fork PR, so they are left out.
ADMITTED_EVENTS = ("push", "pull_request", "merge_group", "workflow_dispatch", "schedule", "workflow_run")
# The only fork trusted to run on the PR minis. Keep this a single narrow allowlist; add team accounts deliberately.
ALLOWED_FORK_REPOS = frozenset({"teamleaderleo/cmux"})
PREFIX = "glaeda-cmux-runner-hook"
# glaeda-cmux-runner --refresh-hooks stages a new hook beside this one while the runner has a job (its NEXT_SUFFIX and
# NEXT_RECORD; a test keeps the names equal), and job-completed installs it (install_staged_hook).
NEXT_SUFFIX = ".next"
NEXT_RECORD = ".hook-next.json"
# listen: the runner LaunchAgent runs run.sh under this gate. While the fleet holds or wants the host
# (an exclusive host lock, a process waiting for it, or a reservation), an idle runner stops listening,
# so GitHub hands its jobs to another runner instead of here, where job-started would refuse them.
GATE = "glaeda-cmux-runner-gate"
GATE_POLL_S = float(os.environ.get("GLAEDA_RUNNER_GATE_POLL_S") or 2.0)
GATE_CONFIRM = 2  # consecutive idle polls, so a hook's or a probe's momentary hold never stops a listener
# The old 1-minute load gate overcounted runnable threads on these 14-core minis: it held 578 runner-hours on
# 09-28 while median host CPU was only 34-59%. Gate on sampled iostat CPU busy instead, with hysteresis, and hold
# for elevated/critical Darwin VM pressure even when CPU is quiet. An unreadable sample fails open; job admission's
# unit locks and the existing load-independent safety checks remain in force.
# With units that are cores (CLASS_COST), admission already stops near the core count, so the gate is the margin
# for jobs above their p75: it pauses at 85% and resumes below 80% (it was 80/70 while units were 2.8 cores and the
# gate was the only real limit; 10-12 to 10-19 the std minis' CPU busy at job end was p50 52-68%, p90 79-93%).
GATE_CPU_PAUSE = float(os.environ.get("GLAEDA_RUNNER_GATE_CPU_PAUSE") or 85.0)
GATE_CPU_RESUME = float(os.environ.get("GLAEDA_RUNNER_GATE_CPU_RESUME") or 80.0)
GATE_CPU_EVERY_S = float(os.environ.get("GLAEDA_RUNNER_GATE_CPU_EVERY_S") or 10.0)
GATE_MEMORY_PRESSURE_HOLD = 2
# Kept for the pure mini_saturated helper and old operator tooling; the listener gate no longer uses load average.
GATE_LOAD_PAUSE = float(os.environ.get("GLAEDA_RUNNER_GATE_LOAD_PAUSE") or 2.0)
GATE_LOAD_RESUME = float(os.environ.get("GLAEDA_RUNNER_GATE_LOAD_RESUME") or 1.5)
SATURATED = "the mini is saturated"
# A load hold longer than this is not a compile (measured compile p99 is about 18 min): something outside CI (a leaked process,
# Spotlight, a software update) is loading the mini. The gate then listens anyway, logs it, and only pauses for
# load again once the load has fallen below the resume mark, so one stuck process cannot keep a mini dark.
GATE_LOAD_MAX_HOLD_S = float(os.environ.get("GLAEDA_RUNNER_GATE_LOAD_MAX_HOLD_S") or 30 * 60)
GATE_STOP_WAIT_S = 60.0  # a graceful listener exit, before it is killed
# A listener's first message poll is kept this long before a hold may stop it. GitHub can hand a queued job to a
# new session before the listener has seen it, and a stop that cancels that poll loses the job: GitHub retries the
# gone session and fails the job 3 min later, "not acquired by Runner of type self-hosted even after multiple
# attempts" (cmux14 root runner, 2026-10-12: session at 03:46:41, stopped at 03:46:44). A job that does arrive on a
# full host is refused at job-started in seconds and rescued, which a lost one never is. The broker holds a message
# poll open up to BROKER_POLL_S, and a job can be handed to the session at any point in it, so the hold covers the
# whole first poll (cmux7s roots, 2026-10-21: a job queued 25 s into the first poll was lost to a stop at 30 s).
BROKER_POLL_S = 50.0
GATE_FIRST_POLL_S = float(os.environ.get("GLAEDA_RUNNER_GATE_FIRST_POLL_S") or BROKER_POLL_S + 10.0)
# After the gate stops a listener, the host must stay free this long before it starts one again: every stop can lose
# a job GitHub just handed the session, and a hold that comes back within seconds turned two free polls into a
# start and a stop 30 s later (cmux7s roots, 2026-10-21: at 14:10, 14:50 and 14:59).
GATE_RESTART_FREE_S = float(os.environ.get("GLAEDA_RUNNER_GATE_RESTART_FREE_S") or BROKER_POLL_S + 10.0)
# reload() hands the listener's start (time.monotonic, system-wide) to the re-executed gate here, not in argv, so a
# rollback to a hook without it still accepts the exec.
GATE_LISTENING_SINCE_ENV = "GLAEDA_RUNNER_GATE_LISTENING_SINCE"
GATE_WATCH_S = 0.1  # while a job is below the disk floor, notice its Worker exit promptly
GATE_WAITER_EVERY_S = 30.0
# The yield to a fleet build waiting for the host lock is bounded (policy, declared here; env overrides it). A waiter
# seen waiting for GATE_WAITER_MAX_HOLD_S without a break longer than GATE_WAITER_GAP_S is not getting the host
# (2026-10-26, a std mini: the controller handed its worker a build needing 250 GiB free on a disk with 80. Each try
# waited 2 to 12 min for the lock behind runner jobs, took it, failed for disk and queued again, and the gate kept 11
# of 12 listeners off from 22:19Z for over an hour). The hold is 10 min: a fleet build that the drain lets in gets the
# lock within one runner job's tail, which the worker log put at 2 to 12 min that day. Past it the gate takes the
# runners back and logs why once; after GATE_WAITER_WAIVE_S it honours the same wait again, so a build that is only
# slow still gets a drained host once per cycle and no listener stays held without anyone stepping in.
GATE_WAITER_MAX_HOLD_S = float(os.environ.get("GLAEDA_RUNNER_GATE_WAITER_MAX_HOLD_S") or 10 * 60)
GATE_WAITER_WAIVE_S = float(os.environ.get("GLAEDA_RUNNER_GATE_WAITER_WAIVE_S") or 20 * 60)
# A waiter not seen this long starts a new wait. A worker that took the lock and handed the job back re-queues within
# seconds to minutes (its eviction runs under the lock, and the gate takes no reading while the lock is held); a build
# that ran holds it far longer.
GATE_WAITER_GAP_S = 10 * 60.0
WAITER_SPANS_FILE = "fleet-waiter-spans.json"  # in the state dir, shared by every runner's gate and job-started
WAITER_SPANS_LOCK_S = 2.0  # waiting for another reader's update; past it every waiter is honoured
GATE_MAX_FAILURES = 5  # consecutive failed polls before the gate hands the runner back
GATE_FALLBACK = 70  # listen.sh runs run.sh itself: the gate broke before any runner started
# A throttled mini (macOS thermal pressure, notifyutil's com.apple.system.thermalpressurelevel: 0 nominal,
# 1 moderate, 2 heavy, 3 trapping, 4 sleeping) compiles 3 to 14x slower per task (cmuxterm-hq#663), which
# pmset -g therm never reports. At GATE_THERMAL_HOLD or above an idle listener stops, so GitHub routes to a
# cool mini while this one cools; it listens again once the level is back at GATE_THERMAL_RELEASE or below.
# GLAEDA_RUNNER_THERMAL_HOLD=0 turns this off.
THERMAL_HOT = 3  # also what job telemetry calls thermal_limited, whatever the gate's setting
_hold = os.environ.get("GLAEDA_RUNNER_THERMAL_HOLD", "")
GATE_THERMAL_HOLD = int(_hold) if _hold.strip().isdigit() else THERMAL_HOT  # never crash a hook on a typo
GATE_THERMAL_RELEASE = 1
GATE_THERMAL_EVERY_S = 30.0
NOTIFYUTIL = "/usr/bin/notifyutil"
THERMAL_PRESSURE_KEY = "com.apple.system.thermalpressurelevel"
# GUI tests (app-host shards, tests-build-and-lag, test-e2e) run in the console user's session. A mini whose
# auto-login session is screen-locked (displaysleep, then the lock) or sits at the login window fails every one of
# them (cmuxterm-hq#757). ioreg's IOConsoleUsers names the console session (kCGSSessionOnConsoleKey) and whether its
# screen is locked (CGSSessionScreenIsLocked), readable from any user or launchd domain. job-started refuses a job
# that needs the console there, take-gui gives way, and a gui runner's listener gate holds it off, so GitHub hands
# the job to another mini. An unreadable state (no ioreg, as on Linux, or a timeout) changes nothing.
# GLAEDA_RUNNER_CONSOLE_GATE=0 turns all of it off.
IOREG = os.environ.get("GLAEDA_RUNNER_IOREG") or "/usr/sbin/ioreg"
CONSOLE_GATE = os.environ.get("GLAEDA_RUNNER_CONSOLE_GATE", "1") != "0"
CONSOLE_CLASSES = ("gui", "gui-step")  # job classes whose tests need the console session
# Console jobs that skip their console steps themselves when take-gui gives way, and run nowhere else: a refusal
# would only fail them (the frame-pacing bench, cmux#16511, runs on the side-lane mini or not at all, with no
# rescue). On a locked console they are admitted as light, with no gui token, and their take-gui gives way.
CONSOLE_SKIPPERS = {("cmux-next-frame-pacing.yml", "bench")}
GATE_CONSOLE_EVERY_S = 30.0
# A --require-eligible runner's listener is held off while its node would be refused (node_refusal, then
# toolchain_refusal without align): a listening runner took every job its label brought and failed it in "Set up
# job" (cmux21-glaeda-1 refused cmux's fleet-compile-check, run 39576639849, with rust 1.99.1 not installed). Held
# off, GitHub hands the job to an eligible runner on the same label. The look runs in a thread (its probes take up
# to 2 x ELIGIBILITY_BUDGET_S) at most every GATE_ELIGIBLE_EVERY_S, and the gate uses the last answer.
GATE_ELIGIBLE_EVERY_S = float(os.environ.get("GLAEDA_RUNNER_GATE_ELIGIBLE_EVERY_S") or 300.0)
# A new refusal is looked at once more this soon, and holds only when that look agrees: a probe that timed out on a
# busy mini reads as a refusal (an empty xcodebuild or node status) and must not hold a good runner for 300 s.
GATE_ELIGIBLE_RECHECK_S = 30.0
# The held answer across a reload's exec (as GATE_LISTENING_SINCE_ENV), so a hook --apply does not start every
# held runner listening while the new gate's first look runs.
GATE_INELIGIBLE_ENV = "GLAEDA_RUNNER_GATE_INELIGIBLE"
# Across a reload: "clean" when this gate started its listener with listener_env, else why its env is stale.
GATE_LISTENER_ENV = "GLAEDA_RUNNER_GATE_LISTENER_ENV"
GATE_RESERVE_FD_ENV = "GLAEDA_RUNNER_GATE_RESERVE_FD"  # a reload hands its reserve flock's fd to the new gate


def _repo_name(repo: Any) -> str | None:
    if not isinstance(repo, dict):
        return None
    name = repo.get("full_name")
    return name.lower() if isinstance(name, str) and name else None


def decide(event_name: str | None, event: Any, repository: str | None,
           allowed_repos: list[str], allowed_owner: str | None,
           extra_events: tuple[str, ...] = ()) -> tuple[bool, str]:
    """Return (admit, reason). Pure: no I/O, so tests can table-drive it."""
    if not event_name:
        return False, "GITHUB_EVENT_NAME is not set"
    if not isinstance(event, dict):
        return False, "event payload is missing or not a JSON object"
    if event_name == "pull_request_target":
        return False, "pull_request_target runs untrusted PR context with base-repo secrets"
    if event_name not in ADMITTED_EVENTS + tuple(extra_events):
        return False, f"{event_name} is not an admitted event on this runner"
    repo = (repository or _repo_name(event.get("repository")) or "").lower()
    if allowed_repos and repo not in {r.lower() for r in allowed_repos}:
        return False, f"repository {repo or '(unknown)'} is not allowed on this runner"
    if allowed_owner and repo.split("/", 1)[0] != allowed_owner.lower():
        return False, f"repository {repo or '(unknown)'} is outside {allowed_owner}"

    pr = event.get("pull_request")
    if pr is not None or event_name.startswith("pull_request"):
        if not isinstance(pr, dict):
            return False, f"{event_name} event without a pull_request object"
        head = (pr.get("head") or {}).get("repo") if isinstance(pr.get("head"), dict) else None
        base = (pr.get("base") or {}).get("repo") if isinstance(pr.get("base"), dict) else None
        if not isinstance(head, dict):
            return False, "pull request head repository is missing (deleted fork?)"
        head_name, base_name = _repo_name(head), _repo_name(base)
        allowed_fork = (
            head.get("fork") is True
            and head_name in ALLOWED_FORK_REPOS
            and base_name == repo
        )
        if head.get("fork") is True and not allowed_fork:
            return False, f"fork pull request from {head.get('full_name')}"
        if head_name is None or base_name is None or (head_name != base_name and not allowed_fork):
            return False, f"cross-repository pull request ({head_name} into {base_name})"

    if event_name == "workflow_run":
        run = event.get("workflow_run")
        if not isinstance(run, dict):
            return False, "workflow_run event without a workflow_run object"
        head_name = _repo_name(run.get("head_repository"))
        if head_name is None or head_name != (repo or _repo_name(event.get("repository"))):
            return False, f"workflow_run triggered from another repository ({head_name})"
    return True, f"{event_name} on {repo or '(unknown)'}"


# workflow_dispatch is not here: a dispatched workflow on main can check out any ref from its inputs.
TRUSTED_EVENTS = ("push", "schedule")
UNTRUSTED_PAYLOAD_KEYS = ("pull_request", "workflow_run", "merge_group")


def trusted_refusal(event_name: str | None, ref: str | None, repository: str | None, event: Any,
                    trusted_ref: str, trusted_repo: str, *, trusted_next_nightly: bool = False,
                    workflow_ref: str | None = None, job: str | None = None,
                    run_attempt: str | None = None) -> str | None:
    """Why a job is not merged code of trusted_repo on trusted_ref, or None. Pure. For a push or schedule the
    workflow file and the default checkout come from that ref, so PR code runs only if a merged workflow
    fetches it (docs/CMUX_MINI_RUNNER.md 2e)."""
    why = f"untrusted: this runner takes only {trusted_repo} {trusted_ref} push and schedule jobs"
    if trusted_next_nightly and (trusted_ref != "refs/heads/main" or trusted_repo != "manaflow-ai/cmux"):
        return "untrusted: NEXT nightly opt-in needs manaflow-ai/cmux trusted main admission"
    if event_name not in TRUSTED_EVENTS:
        return f"{why}, not {event_name}"
    if not isinstance(event, dict):
        return f"{why}; the event payload is missing"
    repos = {(repository or "").lower(), (_repo_name(event.get("repository")) or "").lower()}
    if repos != {trusted_repo.lower()}:
        return f"{why}, not {' / '.join(sorted(r or '(unknown)' for r in repos))}"
    if any(key in event for key in UNTRUSTED_PAYLOAD_KEYS):
        return f"{why}; the payload carries {', '.join(k for k in UNTRUSTED_PAYLOAD_KEYS if k in event)}"
    if trusted_next_nightly and ref == "refs/heads/nightly-next":
        # A fixed exception, never a general extra-ref list. Schedules run on the default branch;
        # NEXT promotion reaches this runner only through the protected nightly-next push.
        if (event_name == "push" and event.get("ref") == ref and run_attempt == "1"
                and workflow_ref == "manaflow-ai/cmux/.github/workflows/nightly.yml@refs/heads/nightly-next"
                and job == "build-nightly-app"):
            return None
        return "untrusted: NEXT nightly needs its exact nightly.yml build-nightly-app push on attempt 1"
    if ref != trusted_ref:
        return f"{why}, not ref {ref or '(unset)'}"
    if event_name == "push" and event.get("ref") != trusted_ref:
        return f"{why}; the push payload ref is {event.get('ref')!r}"
    if event_name == "schedule" and f"refs/heads/{(event.get('repository') or {}).get('default_branch')}" != trusted_ref:
        return f"{why}; a schedule runs on the default branch, which is not {trusted_ref}"
    return None


# The cmux-next.yml jobs the freshness slot admits (dev_compile_refusal); cmux's FRESH_SLOT_JOBS names the same.
FRESH_SLOT_JOBS = ("cmux-scheme-compile", "release-compile")


def dev_compile_refusal(event_name: str | None, ref: str | None, repository: str | None, event: Any,
                        workflow_ref: str | None, job: str | None) -> str | None:
    """Why a DEV compile priority runner (the freshness slot) must refuse this job, or None.

    The label is a soft priority lane: the workflow still has its normal
    cascade fallback.  Only cmux NEXT's feed compiles may use it: the DEV
    compile (cmux-scheme-compile) on a feat-cmux-next push or a dev_daily
    dispatch, and on a feat-cmux-next push the Release compile
    (release-compile) that gates nightly-next's promotion.
    """
    repos = {(repository or "").lower(), (_repo_name(event.get("repository")) or "").lower()
             if isinstance(event, dict) else ""}
    if repos != {"manaflow-ai/cmux"}:
        return "dev compile runner admits only manaflow-ai/cmux"
    if job not in FRESH_SLOT_JOBS:
        return "dev compile runner admits only cmux-scheme-compile and a push's release-compile"
    path = (workflow_ref or "").split("@", 1)[0]
    if path != "manaflow-ai/cmux/.github/workflows/cmux-next.yml":
        return "dev compile runner admits only cmux-next.yml"
    if workflow_ref != path + "@refs/heads/feat-cmux-next":
        return "dev compile runner requires cmux-next.yml from feat-cmux-next"
    if event_name == "push" and ref == "refs/heads/feat-cmux-next":
        if isinstance(event, dict) and event.get("ref") == ref:
            return None
        return "dev compile runner requires the feat-cmux-next push ref"
    if job == "release-compile":
        return "dev compile runner admits release-compile only on a feat-cmux-next push"
    if event_name == "workflow_dispatch":
        if ref != "refs/heads/feat-cmux-next":
            return "dev compile runner requires the feat-cmux-next dispatch ref"
        inputs = event.get("inputs") if isinstance(event, dict) else None
        if isinstance(inputs, dict) and str(inputs.get("dev_daily", "")).lower() == "true":
            return None
        return "dev compile runner requires workflow_dispatch input dev_daily=true"
    return "dev compile runner admits only a feat-cmux-next push or dev_daily dispatch"


# FEED_FIRST: a mini's admission queue (fair_turn) ranks waiters by tier, not only by arrival. Leo, 2026-10-27, on a
# nightly app build queued behind PR jobs: "BUT WTF COULD POSSIBLY BE MORE IMPORTANT ON OUR FUCKING MINIS".
#   - NIGHTLY: every nightly.yml job of manaflow-ai/cmux on a nightly-next or main push, schedule or dispatch (NEXT and
#     classic nightly: build-nightly-app, promote, the sign, notarize and verify jobs), and the Release compile on a
#     feat-cmux-next push that gates nightly-next's promotion. A waiting nightly job is admitted next, ahead of every
#     other waiter however long it has waited; no admission of any other tier takes a unit while one waits here; and
#     it keeps no idle runner's reserve (GUI_RESERVE, FRESH_RESERVE_TOKEN).
#   - DEV: the other feed compiles the freshness slot admits (dev_compile_refusal: a feat-cmux-next push's DEV
#     compile, a DEV daily's). Ahead of PR and side jobs, except one that has waited FEED_JUMP_S: that keeps its
#     arrival order against DEV compiles, so a stream of them cannot starve it.
#   - everything else (PR and side jobs): arrival order.
# Nothing running is preempted: a nightly job takes the next units that free up, and none goes to anyone else first.
# Strict arrival order had them queue behind PR work: on 2026-10-27 from 04:27Z a nightly-next build-nightly-app sat
# 13+ min in this hook on a side runner behind a fast-tier, a generated-files and a swift test job that had arrived
# first, and at 04:47Z, the oldest waiter, it still waited with 3 of 14 units free, because the fresh reserve (4) and a
# gui reserve (1) made its 4 units need 9 free.
NIGHTLY_REFS = ("refs/heads/nightly-next", "refs/heads/main")
NIGHTLY_EVENTS = ("push", "schedule", "workflow_dispatch")
NIGHTLY_WORKFLOW = "manaflow-ai/cmux/.github/workflows/nightly.yml"
PROMOTE_COMPILE = "release-compile"  # cmux-next.yml's, on a feat-cmux-next push: nightly-next's promote gate
TIER_NIGHTLY, TIER_DEV = "nightly", "dev"
FEED_JUMP_S = 20 * 60.0


def job_tier(event_name: str | None, ref: str | None, repository: str | None, event: Any,
             workflow_ref: str | None, job: str | None) -> str:
    """This job's admission tier (FEED_FIRST): TIER_NIGHTLY, TIER_DEV or "". Pure. Only merged workflow code on a
    protected branch qualifies: the workflow ref names the same branch the job runs on, and a pull request's ref is
    never one of them, nor is a payload that carries a pull request, a workflow_run or a merge group."""
    if not isinstance(event, dict) or any(key in event for key in UNTRUSTED_PAYLOAD_KEYS):
        return ""
    if dev_compile_refusal(event_name, ref, repository, event, workflow_ref, job) is None:
        return TIER_NIGHTLY if job == PROMOTE_COMPILE and event_name == "push" else TIER_DEV
    repos = {(repository or "").lower(), (_repo_name(event.get("repository")) or "").lower()}
    if repos != {"manaflow-ai/cmux"} or not job or event_name not in NIGHTLY_EVENTS:
        return ""
    if ref not in NIGHTLY_REFS or workflow_ref != f"{NIGHTLY_WORKFLOW}@{ref}":
        return ""
    if event_name == "push" and event.get("ref") != ref:
        return ""
    return TIER_NIGHTLY


# glaeda-mini-health's drain for a Tailscale restart (glaeda#1627): it wants the host idle, not jobs refused. The gate
# stops idle listeners while the marker stands, so no new job comes; a job a listener already took before the gate
# saw the marker is admitted and finishes (mini-health waits for it). Refusing it only failed that job: one
# mini refused 28 jobs this way during a single 20-minute drain.
DRAIN_OWNER = "glaeda-mini-health"
DRAIN_PURPOSE = "drain for a Tailscale restart: "  # glaeda-mini-health start_drain's purpose, exactly this prefix


def drain_marker(marker: dict[str, Any]) -> bool:
    return marker.get("owner") == DRAIN_OWNER and str(marker.get("purpose") or "").startswith(DRAIN_PURPOSE)


def reservation_refusal(path: str, now: float, taken_job: bool = False) -> str | None:
    """Why an active or unreadable reservation refuses this job, or None. Parsed by glaeda_reservation,
    shared with glaeda-mini-fleet, which the installer copies next to this hook. taken_job (job-started only):
    a valid, active drain marker (drain_marker) admits the job a listener already took; any other marker, and
    an unreadable or invalid one, refuses as before."""
    try:
        text = Path(path).read_text(encoding="utf-8")
    except FileNotFoundError:
        return None
    except (OSError, UnicodeDecodeError) as error:
        return f"reservation {path} is unreadable ({type(error).__name__})"
    try:
        module = Path(__file__).resolve().parent / "glaeda_reservation.py"
        loader = importlib.machinery.SourceFileLoader("glaeda_reservation", os.fspath(module))
        spec = importlib.util.spec_from_loader("glaeda_reservation", loader)
        reservation = importlib.util.module_from_spec(spec)
        loader.exec_module(reservation)
    except Exception as error:  # noqa: BLE001  (a marker we cannot read refuses)
        return f"reservation {path} exists but glaeda_reservation.py is missing ({type(error).__name__})"
    marker, why = reservation.parse(text)
    if marker is None:
        return f"reservation {path} is not a valid {reservation.SCHEMA} marker ({why})"
    if not reservation.active(marker, now):
        return None
    if taken_job and drain_marker(marker):
        print(f"{PREFIX}: host draining ({reservation.describe(marker)}); admitting the job this runner already "
              "took (its listener is held off for new ones)", flush=True)
        return None
    return f"host reserved by {reservation.describe(marker)}"


FLEET_ROLE = "cmux_macos_native_build"
NODE_STATUS_SCHEMA = "glaeda-cmux-fleet-node-status/v1"
# (class receipt toolchain field, command) run from $HOME on the runner's own PATH (the job's PATH), so
# no checkout's rust-toolchain.toml applies. Every field must be in the receipt: a receipt without them
# proves nothing.
TOOLCHAIN_PROBES = (("rustcVersion", ["rustc", "--version"]), ("cargoVersion", ["cargo", "--version"]),
                    ("zigVersion", ["zig", "version"]),
                    ("macosSdkVersion", ["xcrun", "--sdk", "macosx", "--show-sdk-version"]))
REQUIRED_TOOLCHAIN = ("rustcVersion", "cargoVersion", "zigVersion", "xcodeVersion", "xcodeBuild", "macosSdkVersion")
MIN_WORKLOAD_PYTHON = (3, 13)  # cmux_fleet_bootstrap profile_runner_interpreter_ready: os.waitid on macOS
ELIGIBILITY_BUDGET_S = 20.0  # one deadline for every probe: a hung xcodebuild refuses, it does not stall


def _json_file(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None


def _probe(argv: list[str], env: dict[str, str], cwd: Path, deadline: float) -> str:
    return _probe_answer(argv, env, cwd, deadline)[0]


def _probe_answer(argv: list[str], env: dict[str, str], cwd: Path, deadline: float) -> tuple[str, bool]:
    """(stdout when it exited 0, else "", whether it ran out of time). Out of time (the deadline passed before or
    while it ran) is no answer at all, which a caller may tell apart from a probe that ran and failed."""
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        return "", True
    try:
        out = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, env=env,
                             cwd=cwd, timeout=remaining, check=False)
    except subprocess.TimeoutExpired:
        return "", True
    except OSError:
        return "", False
    return (out.stdout.strip() if out.returncode == 0 else ""), False


def node_refusal(fleet_class: str | None) -> tuple[str | None, dict[str, Any]]:
    """(why this node is not an eligible fleet node, {}) or (None, its class receipt's toolchain). No effects."""
    why, want, _timed_out = node_answer(fleet_class)
    return why, want


def node_answer(fleet_class: str | None) -> tuple[str | None, dict[str, Any], bool]:
    """node_refusal plus whether the refusal is only a probe that ran out of ELIGIBILITY_BUDGET_S (the class receipt
    validator or the generation's node status, on a mini too loaded to start Python in time). job-started still
    refuses then, but names the timeout; the health agent reports no node_ineligible for it (cmux10s-mac-mini at
    load ~275 read "does not validate" while the same validator said `valid` in 0.08 s by hand)."""
    home = Path.home()
    deadline = time.monotonic() + ELIGIBILITY_BUDGET_S
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config") / "glaeda" / "cmux-fleet"
    if not fleet_class:
        return "node not eligible (no fleet class configured for this runner)", {}, False
    receipt = _json_file(config / "class-acceptance" / f"{fleet_class}.json")
    enrollment = _json_file(config / "enrollment.json")
    if not isinstance(enrollment, dict):
        return "node not eligible (no Glaeda enrollment on this mini)", {}, False
    if not isinstance(receipt, dict):
        return f"node not eligible (no {fleet_class} class receipt)", {}, False
    acceptance = _json_file(config / "acceptance" / f"{FLEET_ROLE}.json")
    if not receipt.get("receiptSha256") or (enrollment.get("classAcceptanceSha256") != receipt.get("receiptSha256")
                                            and not receipt_source(enrollment, acceptance, receipt, fleet_class)):
        return f"node not eligible (the enrollment does not reference the {fleet_class} class receipt)", {}, False
    commit = str(((receipt.get("glaedaCandidate") or {}) if isinstance(receipt.get("glaedaCandidate"), dict) else {})
                 .get("commit") or "")
    if not re.fullmatch(r"[0-9a-f]{12,40}", commit):
        return "node not eligible (the class receipt names no Glaeda candidate)", {}, False
    generation = home / "Projects" / "glaeda-generations" / commit[:12]
    if not generation.is_dir():
        return f"node not eligible (no node status from generation {commit[:12]})", {}, False
    # The receipt's own sha is a claim; the generation's validator recomputes it from the content.
    valid, slow = _probe_answer([sys.executable, "-B", "-c",
                                 "import json, sys; sys.path.insert(0, 'scripts'); import cmux_fleet; "
                                 "cmux_fleet.validate_class_acceptance(json.load(open(sys.argv[1]))); print('valid')",
                                 os.fspath(config / "class-acceptance" / f"{fleet_class}.json")],
                                dict(os.environ), generation, deadline)
    if slow:
        return (f"node not eligible (the {fleet_class} class receipt validator timed out after "
                f"{ELIGIBILITY_BUDGET_S:.0f} s; no answer, not an invalid receipt)"), {}, True
    if valid != "valid":
        return f"node not eligible (the {fleet_class} class receipt does not validate)", {}, False
    status_out, slow = _probe_answer([sys.executable, "-B", os.fspath(generation / "scripts" / "cmux_fleet.py"),
                                      "status", os.fspath(config / "enrollment.json"), "--acceptance",
                                      os.fspath(config / "acceptance" / f"{FLEET_ROLE}.json")],
                                     dict(os.environ), generation, deadline)
    if slow:
        return (f"node not eligible (the node status from generation {commit[:12]} timed out after "
                f"{ELIGIBILITY_BUDGET_S:.0f} s; no answer)"), {}, True
    try:
        status = json.loads(status_out)
    except ValueError:
        status = None
    if not isinstance(status, dict) or status.get("schema") != NODE_STATUS_SCHEMA:
        return f"node not eligible (no node status from generation {commit[:12]})", {}, False
    roles = status.get("roles") if isinstance(status.get("roles"), list) else []
    build_role = [r for r in roles if isinstance(r, dict) and r.get("role") == FLEET_ROLE]
    if (status.get("state") != "eligible" or status.get("routingCandidateEligible") is not True
            or not build_role or build_role[0].get("eligible") is not True):
        why = ", ".join(f"{r.get('role')}: {r.get('reason')}" for r in roles if isinstance(r, dict)) or "no roles"
        return f"node not eligible (state {status.get('state')}, {why})", {}, False
    want = receipt.get("toolchain") if isinstance(receipt.get("toolchain"), dict) else {}
    missing = [f for f in REQUIRED_TOOLCHAIN if not str(want.get(f) or "").strip() or str(want.get(f)) == "unknown"]
    if missing:
        return f"node not eligible (the {fleet_class} class receipt records no {', '.join(missing)})", {}, False
    return None, want, False


# The class receipt's source node never adopts it (glaeda-mini-enroll --renew leaves its current, accept-local
# enrollment alone), so it is admitted when the receipt names exactly this node's enrollment and local acceptance.
SOURCE_BINDING = (("enrollment", "nodeId", "acceptingNodeId"), ("enrollment", "enrollmentGeneration", "acceptingEnrollmentGeneration"),
                  ("enrollment", "glaedaGeneration", "glaedaGeneration"), ("acceptance", "nodeId", "acceptingNodeId"),
                  ("acceptance", "enrollmentGeneration", "acceptingEnrollmentGeneration"),
                  ("acceptance", "toolchainGeneration", "toolchainGeneration"),
                  ("acceptance", "cmuxToolchainIdentity", "cmuxToolchainIdentity"),
                  ("acceptance", "cmuxSemanticResultSha256", "cmuxSemanticResultSha256"))


def receipt_source(enrollment: dict[str, Any], acceptance: Any, receipt: dict[str, Any], fleet_class: str) -> bool:
    """This node is the one the class receipt was exported from: an enrollment that references no class
    receipt, and every binding field equal and present. Eligibility itself is still the node status."""
    if enrollment.get("classAcceptanceSha256") is not None or not isinstance(acceptance, dict):
        return False
    docs = {"enrollment": enrollment, "acceptance": acceptance}
    generations = enrollment.get("supportedToolchainGenerations")
    if receipt.get("fleetClass") != fleet_class or not isinstance(generations, list) \
            or receipt.get("toolchainGeneration") not in generations:
        return False
    return all(docs[doc].get(field) not in (None, "") and docs[doc].get(field) == receipt.get(key)
               for doc, field, key in SOURCE_BINDING)


# A node that cannot run its Rust toolchain at all. 2026-10-26 21:26Z-00:48Z: ~/.cargo/bin/rustup was deleted on the
# runner minis (rust-cache's cleanBin), and job-started refused with "cannot name a toolchain", which reads like a
# version drift. That is a definite answer, not a slow probe: the listener gate holds at once, with no
# GATE_ELIGIBLE_EVERY_S wait and no GATE_ELIGIBLE_RECHECK_S look (Gate.ineligible); ci-step fits advertises no class
# and admit refuses (step_refusal), so the controller stops leasing steps here; and glaeda-mini-health reports
# toolchain_missing, naming which tool and why. The PATH is the one jobs run with: the gate's own (it runs run.sh with
# it), else the runner LaunchAgent's WORKLOAD_PATH (glaeda-cmux-runner's; a test keeps the two equal). Never the
# runner's .path: nothing on a glaeda runner reads it (only bin/runsvc.sh does), and it drifted to /usr/bin:/bin:...
# on re-registered minis while their jobs ran on WORKLOAD_PATH. A few stats, so the gate reads it every poll.
# GLAEDA_RUNNER_TOOLCHAIN_GATE=0 turns all of it off (job-started still probes rustc as before).
RUST_TOOLS = ("rustup", "rustc", "cargo")
TOOLCHAIN_MISSING = "Rust toolchain missing"
TOOLCHAIN_OFF_PATH = "is not on the job PATH"
TOOLCHAIN_GATE = os.environ.get("GLAEDA_RUNNER_TOOLCHAIN_GATE", "1") != "0"
WORKLOAD_DEFAULT = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"  # glaeda-cmux-runner WORKLOAD_PATH
WORKLOAD_PATH = os.environ.get("GLAEDA_RUNNER_WORKLOAD_PATH") or WORKLOAD_DEFAULT


def workload_env() -> dict[str, str]:
    """The env a runner job gets its Rust from, for a caller outside the listener (the build worker's fits and admit,
    the health agent): the LaunchAgent's WORKLOAD_PATH, and this process's CARGO_HOME if it sets one."""
    return {"PATH": WORKLOAD_PATH, **({"CARGO_HOME": os.environ["CARGO_HOME"]} if os.environ.get("CARGO_HOME") else {})}


def toolchain_missing(env: dict[str, str] | None = None, home: Path | None = None) -> str | None:
    """Why a job with this env (PATH, CARGO_HOME; default this process's) cannot run rustup, rustc or cargo, naming
    each tool, or None. A tool counts when PATH finds it executable. One that is not found is described by what is
    there: a link on PATH that dangles (rustc -> rustup with rustup gone), else rustup's bin dir ($CARGO_HOME/bin, else
    ~/.cargo/bin) holding it while PATH does not reach it, else that it is nowhere."""
    if not TOOLCHAIN_GATE:
        return None
    env = os.environ if env is None else env
    path = env.get("PATH") or ""
    bin_dir = Path(env.get("CARGO_HOME") or (home or Path.home()) / ".cargo") / "bin"
    gone = []
    for tool in RUST_TOOLS:
        if shutil.which(tool, path=path):
            continue
        links = [Path(d) / tool for d in [*path.split(os.pathsep), os.fspath(bin_dir)] if d]
        dangling = next((c for c in links if os.path.islink(c) and not os.path.exists(c)), None)
        if dangling is not None:
            gone.append(f"{dangling} (a link to {os.readlink(dangling)}, which is gone)")
        elif os.access(bin_dir / tool, os.X_OK):
            gone.append(f"{tool} {TOOLCHAIN_OFF_PATH} {path or '(empty)'} ({bin_dir / tool} is there)")
        else:
            gone.append(f"{tool} is not installed (not on the job PATH {path or '(empty)'}, not in {bin_dir})")
    return f"node not eligible ({TOOLCHAIN_MISSING}: {'; '.join(gone)})" if gone else None


def fleet_toolchain_missing(home: Path | None = None) -> str | None:
    """toolchain_missing on the workload PATH, for a mini with a glaeda runner that runs its jobs with
    --require-eligible (a fleet build node), else None."""
    home = home or Path.home()
    if not any(eligibility_scope(d) is not None for d in sorted(home.glob("actions-runner-glaeda*"))):
        return None
    return toolchain_missing(workload_env(), home)


def receipt_toolchain_name(want: dict[str, Any], env: dict[str, str], home: Path, deadline: float) -> str | None:
    """'1.98.1-<host triple>' for the receipt's rustc, the triple taken from rustup itself."""
    match = re.fullmatch(r"rustc (\d+\.\d+\.\d+)(?: .*)?", str(want.get("rustcVersion") or ""))
    host = re.search(r"^Default host: (\S+)$", _probe(["rustup", "show"], env, home, deadline), re.M)
    return f"{match.group(1)}-{host.group(1)}" if match and host else None


def toolchain_refusal(fleet_class: str | None, want: dict[str, Any], xcode_app: str | None,
                      align: bool = True) -> tuple[str | None, str]:
    """Require every probed string to equal the class receipt's. With align (under the host lock), first
    point rustup's default at the receipt's toolchain when rustc differs: other fleet jobs on this mini
    flip it. Without align (the read-only check), probe as if aligned. Returns (refusal, note)."""
    home = Path.home()
    deadline = time.monotonic() + ELIGIBILITY_BUDGET_S
    env = dict(os.environ)  # the runner's PATH, which is the job's (workload) PATH
    note = ""
    missing = toolchain_missing(env, home)
    if missing:
        return missing, note
    if _probe(["rustc", "--version"], env, home, deadline) != str(want.get("rustcVersion")):
        toolchain = receipt_toolchain_name(want, env, home, deadline)
        if toolchain is None:
            return f"node not eligible (cannot name a toolchain for {want.get('rustcVersion')!r})", note
        names = [line.split()[0] for line in _probe(["rustup", "toolchain", "list"], env, home, deadline).splitlines()
                 if line.strip()]
        if toolchain not in names:
            return f"node not eligible (rust toolchain {toolchain} is not installed)", note
        if align:
            current = _probe(["rustup", "default"], env, home, deadline).split()[:1]
            _probe(["rustup", "default", toolchain], env, home, deadline)
            if _probe(["rustup", "default"], env, home, deadline).split()[:1] != [toolchain]:
                return f"node not eligible (could not set the rustup default to {toolchain})", note
            note = f"set the rustup default to {toolchain} (was {current[0] if current else 'none'})"
        else:
            env["RUSTUP_TOOLCHAIN"] = toolchain  # probe only: what the job would see once aligned
            note = f"would set the rustup default to {toolchain}"
    python = _probe(["python3", "-c", "import sys; print('%d.%d' % sys.version_info[:2])"], env, home, deadline)
    if not re.fullmatch(r"\d+\.\d+", python) or tuple(map(int, python.split("."))) < MIN_WORKLOAD_PYTHON:
        return (f"node not eligible (python3 on the job PATH is {python or 'missing'}; cmux's profile runner "
                f"needs {'.'.join(map(str, MIN_WORKLOAD_PYTHON))}+)"), note
    if not _probe(["gh", "--version"], env, home, deadline):
        return "node not eligible (gh is not on the job PATH; cmux's CI scripts call gh api)", note
    if xcode_app:
        env["DEVELOPER_DIR"] = os.fspath(Path(xcode_app) / "Contents" / "Developer")
    have: dict[str, str] = {}
    for field, argv in TOOLCHAIN_PROBES:
        have[field] = _probe(argv, env, home, deadline)
    lines = _probe(["xcodebuild", "-version"], env, home, deadline).splitlines()
    have["xcodeVersion"] = lines[0].removeprefix("Xcode ").strip() if lines else ""
    have["xcodeBuild"] = lines[1].removeprefix("Build version ").strip() if len(lines) > 1 else ""
    fields = list(REQUIRED_TOOLCHAIN)
    diff = str(want.get("diffRustToolchain") or "")
    if diff and want.get("diffRustcVersion"):  # the DiffSidecar pin, run the way cmux runs it
        have["diffRustcVersion"] = _probe(["rustup", "run", diff, "rustc", "--version"], env, home, deadline)
        fields.append("diffRustcVersion")
    drift = [f"{field} {have[field]!r} != {str(want[field])!r}" for field in fields
             if have.get(field) != str(want[field])]
    if xcode_app:
        # after the receipt probes and on its own budget, so slow Xcode probes never starve them into a '' drift;
        # its refusal is the clearer reason for what drift may also see
        why = xcode_refusal(xcode_app, env, deadline=time.monotonic() + XCODE_PROBE_BUDGET_S)
        if why:
            return why, note
    if drift:
        return f"node not eligible (toolchain drifted from the {fleet_class} class receipt: {'; '.join(drift)})", note
    return None, note


# ---------------------------------------------------------------- the pool Xcode's toolchain
# A runner's pool Xcode is its job-started hook's --toolchain-xcode (glaeda-cmux-runner: the member's first verified
# Xcode, the one its xcode-26.6 label names). cmux21 (macOS 27, 2026-10-21): Command Line Tools 27 in
# /Library/Developer/CommandLineTools made xcrun resolve their MacOSX27 SDK and Swift 6.4 even with xcode-select and
# DEVELOPER_DIR on Xcode_26.6, and the /usr/bin/python3 xcrun shim the gate ran under exported that SDKROOT into the
# listener's environment, so every job built against an SDK its compiler rejects ("this SDK is not supported by the
# compiler"). So the listener starts with SDKROOT and TOOLCHAINS removed and DEVELOPER_DIR on the pool Xcode
# (listener_env), and a host whose xcrun still resolves outside that Xcode, or cannot find or start what cmux jobs
# run (CMUX_TOOLS, both python3s), is refused (xcode_refusal): job-started
# refuses its jobs, the gate holds its listener off (Gate.ineligible, through toolchain_refusal) and
# glaeda-mini-health reports toolchain_mismatch. Only a definite mismatch refuses: a probe that times out or prints
# nothing is no answer, and the exact-string drift check after it still compares xcrun's SDK version.
TOOLCHAIN_ENV = ("SDKROOT", "TOOLCHAINS")  # each points xcrun past DEVELOPER_DIR
XCODE_PROBE_BUDGET_S = 15.0
# A pass is reused this long (a probe runs xcrun twice and swiftc once); a refusal is never cached, so a fixed host
# is admitted at the next look and a broken one is refused on fresh evidence each time.
XCODE_PROBE_TTL_S = float(os.environ.get("GLAEDA_RUNNER_XCODE_PROBE_TTL_S") or 600.0)
XCODE_PROBE_CACHE = "xcode-probe.json"  # under the runner state dir
SWIFT_VERSION = re.compile(r"\bSwift version (\d+(?:\.\d+)+)")
# The tools cmux's macOS jobs run through xcrun or the developer dir: each must resolve (`xcrun --find`). And both
# python3s must start: the job PATH's, and the xcrun shim, which cmux scripts reach as /usr/bin/python3 and which
# fails outright (exit 72, "xcode-select: Failed to locate 'python3'") under an SDKROOT whose SDK is gone (cmux21,
# 2026-10-21: app-compile, fast-tier and web-bundles failed as infra).
CMUX_TOOLS = ("swift", "swiftc", "clang", "git", "make", "ld", "xcodebuild", "python3")
SHIM_PYTHON = os.environ.get("GLAEDA_RUNNER_SHIM_PYTHON") or "/usr/bin/python3"
# By absolute path: a PATH without xcrun would exit 127 for every probe and refuse a healthy host.
XCRUN = os.environ.get("GLAEDA_RUNNER_XCRUN") or "/usr/bin/xcrun"
BATCH_REAP_S = 2.0  # after the deadline's SIGKILL, how long the batch's pipe may take to close
MACOS_PLATFORM = "Platforms/MacOSX.platform"


def listener_env(environ: Any, xcode_app: str | None) -> dict[str, str]:
    """A copy of environ for the runner (and every job it runs): no SDKROOT or TOOLCHAINS, and DEVELOPER_DIR on the
    pool Xcode when the runner has one."""
    env = {key: value for key, value in environ.items() if key not in TOOLCHAIN_ENV}
    if xcode_app:
        env["DEVELOPER_DIR"] = os.fspath(Path(xcode_app) / "Contents" / "Developer")
    return env


def _xcode_name(xcode_app: str | None) -> str:
    return Path(xcode_app).name.removesuffix(".app") if xcode_app else "the pool Xcode"


def _under(path: str, parent: Path) -> bool:
    """path is inside parent, as written or once both are resolved."""
    return any(os.path.normpath(p).startswith(os.path.normpath(d) + os.sep)
               for p, d in ((path, os.fspath(parent)), (os.path.realpath(path), os.path.realpath(parent))))


def leaked_toolchain_env(environ: Any, xcode_app: str | None) -> str | None:
    """Why this environment points xcrun outside the pool Xcode (an SDKROOT path outside it, any TOOLCHAINS), or None.
    Under the /usr/bin/python3 shim SDKROOT is the shim's own (under_xcrun_shim): the caller leaves it out."""
    leaked = []
    sdkroot = environ.get("SDKROOT")  # a name (macosx) resolves through DEVELOPER_DIR; only a path is a leak
    if sdkroot and os.path.isabs(sdkroot) and not (xcode_app and _under(sdkroot, Path(xcode_app) / "Contents" /
                                                                        "Developer")):
        leaked.append(f"SDKROOT={sdkroot}")
    if environ.get("TOOLCHAINS"):
        leaked.append(f"TOOLCHAINS={environ['TOOLCHAINS']}")
    if not leaked:
        return None
    return f"toolchain: the runner's environment sets {', '.join(leaked)}, outside {_xcode_name(xcode_app)}"


def under_xcrun_shim(executable: str) -> bool:
    """This interpreter is a developer directory's python, which /usr/bin/python3 (the xcrun shim) runs with SDKROOT
    set to what xcrun resolved for it: that SDKROOT is the shim's, not the environment the hook was given."""
    real = os.path.realpath(executable)
    return "/Contents/Developer/" in real or real.startswith("/Library/Developer/CommandLineTools/")


def swift_version(text: str) -> str | None:
    """'6.3.3' from `swiftc --version` ("Apple Swift version 6.3.3 (swiftlang-...)"), or None."""
    match = SWIFT_VERSION.search(text or "")
    return match.group(1) if match else None


def _sdk_version(sdk: str | os.PathLike[str]) -> str | None:
    """SDKSettings' Version of an SDK directory (json, else the plist), or None."""
    doc = _json_file(Path(sdk) / "SDKSettings.json")
    if not isinstance(doc, dict):
        try:
            doc = plistlib.loads((Path(sdk) / "SDKSettings.plist").read_bytes())
        except (OSError, ValueError, plistlib.InvalidFileException):
            return None
    version = str(doc.get("Version") or "") if isinstance(doc, dict) else ""
    return version if re.fullmatch(r"\d+(?:\.\d+)*", version) else None


def xcode_mismatch(xcode_app: str, facts: dict[str, Any]) -> str | None:
    """Pure: why a host whose xcrun reports facts (xcode_facts) does not build with the pool Xcode, or None. Only
    what was seen counts: an empty sdkPath or a missing version is no answer (a probe that timed out), never a
    mismatch. Refused: an SDK outside the Xcode's macOS platform, an xcrun swiftc of another Swift than the Xcode's
    own toolchain, an SDK of a newer major than the Xcode's (its compiler rejects it), and every probe that ran and
    failed (broken: a CMUX_TOOLS tool xcrun cannot find, a python3 that does not start)."""
    name = _xcode_name(xcode_app)
    why = []
    sdk = str(facts.get("sdkPath") or "")
    if os.path.isabs(sdk) and not _under(sdk, Path(xcode_app) / "Contents" / "Developer" / MACOS_PLATFORM):
        why.append(f"xcrun resolves {sdk} outside {name}")
    swift, xcode_swift = facts.get("swift"), facts.get("xcodeSwift")
    if swift and xcode_swift and swift != xcode_swift:
        why.append(f"xcrun swiftc is Swift {swift}, {name}'s is {xcode_swift}")
    sdk_version, xcode_sdk = str(facts.get("sdkVersion") or ""), str(facts.get("xcodeSdkVersion") or "")
    if sdk_version and xcode_sdk and int(sdk_version.split(".")[0]) > int(xcode_sdk.split(".")[0]):
        why.append(f"SDK {sdk_version} is newer than {name}'s SDK {xcode_sdk}")
    why += [str(b) for b in facts.get("broken") or []]
    return f"toolchain: {'; '.join(why)}" if why else None


# One shell batch runs every probe (xcode_facts): probe KEY CMD... prints "KEY<tab>EXIT<tab>STDOUT<tab>STDERR" once
# CMD ends, each field on one line. Last the probes most likely to hang (xcrun resolving the SDK), so a batch killed
# at its deadline has already said what it saw. $1 is the stderr scratch file _batch made (and removes).
XCODE_PROBE_SCRIPT = r"""err=$1
probe() {
    key=$1; shift
    out=$("$@" 2>"$err" </dev/null); code=$?
    printf '%s\t%s\t%s\t%s\n' "$key" "$code" "$(printf '%s' "$out" | tr '\t\n' '  ' | cut -c1-400)" \
        "$(tr '\t\n' '  ' <"$err" | cut -c1-200)"
}
"""


def _batch(script: str, env: dict[str, str], cwd: Path, deadline: float) -> dict[str, tuple[int, str, str]]:
    """{key: (exit, stdout, stderr)} for each probe the batch finished before deadline. The batch runs in its own
    process group, killed whole at the deadline, so a hung xcrun never outlives it; its finished lines still count.
    Its stderr scratch file is made and removed here, so a killed batch leaves nothing behind."""
    try:
        fd, err = tempfile.mkstemp(prefix="glaeda-xcode-probe-")
        os.close(fd)
    except OSError:
        return {}
    try:
        try:
            proc = subprocess.Popen(["/bin/sh", "-c", script, "glaeda-xcode-probe", err], stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env, cwd=cwd,
                                    start_new_session=True)
        except OSError:
            return {}
        try:
            out, _ = proc.communicate(timeout=max(0.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired as timeout:
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, signal.SIGKILL)
            try:
                out, _ = proc.communicate(timeout=BATCH_REAP_S)
            except subprocess.TimeoutExpired:  # something outside the group holds the pipe: keep what was read
                out = timeout.stdout or b""
                proc.kill()
    finally:
        with contextlib.suppress(OSError):
            os.unlink(err)
    seen = {}
    for line in out.decode("utf-8", "replace").splitlines():
        fields = line.split("\t")
        if len(fields) == 4 and fields[1].isdigit():
            seen[fields[0]] = (int(fields[1]), fields[2].strip(), fields[3].strip())
    return seen


def xcode_facts(xcode_app: str, environ: Any, deadline: float) -> dict[str, Any]:
    """What xcrun resolves in the runner's clean env (listener_env) and what the pool Xcode itself ships, from one
    probe batch bounded by deadline. A probe that did not finish leaves its fact empty; broken lists the probes that
    finished and failed."""
    env = listener_env(environ, xcode_app)
    developer = Path(xcode_app) / "Contents" / "Developer"
    own = developer / "Toolchains" / "XcodeDefault.xctoolchain" / "usr" / "bin" / "swiftc"
    pythons = ("python3", SHIM_PYTHON)
    q = shlex.quote
    script = XCODE_PROBE_SCRIPT + "".join(
        [f"probe xcodeSwift {q(os.fspath(own))} --version\n"]
        + [f"probe python:{q(python)} {q(python)} -c 'import sys'\n" for python in pythons]
        + [f"probe find:{tool} {q(XCRUN)} --find {tool}\n" for tool in CMUX_TOOLS]
        + [f"probe swift {q(XCRUN)} swiftc --version\n", f"probe sdk {q(XCRUN)} --show-sdk-path\n"])
    seen = _batch(script, env, Path.home(), deadline)

    def ok(key: str) -> str:
        code, out, _ = seen.get(key, (1, "", ""))
        return out if code == 0 else ""

    broken = []
    for python in dict.fromkeys(pythons):
        if f"python:{python}" in seen and seen[f"python:{python}"][0] != 0:
            code, out, err = seen[f"python:{python}"]
            broken.append(f"{python} does not run (exit {code}: {(err or out or 'no output')[:160]})")
    for tool in CMUX_TOOLS:
        if f"find:{tool}" in seen and seen[f"find:{tool}"][0] != 0:
            code, out, err = seen[f"find:{tool}"]
            broken.append(f"xcrun --find {tool} fails (exit {code}: {(err or out or 'no output')[:160]})")
    sdk = ok("sdk")
    return {"sdkPath": sdk, "swift": swift_version(ok("swift")), "xcodeSwift": swift_version(ok("xcodeSwift")),
            "sdkVersion": _sdk_version(sdk) if os.path.isabs(sdk) else None,
            "xcodeSdkVersion": _sdk_version(developer / MACOS_PLATFORM / "Developer" / "SDKs" / "MacOSX.sdk"),
            "broken": broken}


def xcode_refusal(xcode_app: str, environ: Any, cache: Path | None = None, ttl: float | None = None,
                  deadline: float | None = None) -> str | None:
    """xcode_mismatch for this host, probed (xcode_facts) unless a pass for the same Xcode is younger than ttl
    (XCODE_PROBE_TTL_S) in cache (XCODE_PROBE_CACHE in the runner state dir, shared by the mini's runners). Only a
    pass that saw the SDK path and both Swift versions is written: no answer is never cached."""
    cache = cache if cache is not None else Path.home() / ".local/state/glaeda/cmux-runner" / XCODE_PROBE_CACHE
    ttl = XCODE_PROBE_TTL_S if ttl is None else ttl
    seen = _json_file(cache)
    if (isinstance(seen, dict) and seen.get("xcode") == xcode_app and isinstance(seen.get("at"), (int, float))
            and 0 <= time.time() - seen["at"] < ttl):
        return None
    facts = xcode_facts(xcode_app, environ, deadline if deadline is not None
                        else time.monotonic() + XCODE_PROBE_BUDGET_S)
    why = xcode_mismatch(xcode_app, facts)
    if why is None and facts.get("sdkPath") and facts.get("swift") and facts.get("xcodeSwift"):
        with contextlib.suppress(OSError):
            cache.parent.mkdir(parents=True, exist_ok=True)
            stage = cache.with_name(f".{cache.name}.{os.getpid()}")
            stage.write_text(json.dumps({"xcode": xcode_app, "at": time.time()}))
            os.replace(stage, cache)
    return why


def export_developer_dir(xcode_app: str) -> str:
    """Pin the job's later steps to the pool Xcode through $GITHUB_ENV when the runner's env does not already
    (a listener started before listener_env). Returns a note, or ''."""
    developer = os.fspath(Path(xcode_app) / "Contents" / "Developer")
    target = os.environ.get("GITHUB_ENV")
    if not target or os.environ.get("DEVELOPER_DIR") == developer:
        return ""
    with contextlib.suppress(OSError):
        with open(target, "a", encoding="utf-8") as env_file:
            env_file.write(f"DEVELOPER_DIR={developer}\n")
        return f"DEVELOPER_DIR={developer} for the job"
    return ""


def runner_xcode(runner_dir: Path) -> str | None:
    """The pool Xcode: the --toolchain-xcode this runner's job-started hook passes, or None."""
    try:
        line = next((ln for ln in (runner_dir / RUNNER_HOOK_SCRIPT).read_text().splitlines()
                     if ln.startswith("exec ")), "")
        words = shlex.split(line)
    except (OSError, UnicodeDecodeError, ValueError):
        return None
    return words[words.index("--toolchain-xcode") + 1] if "--toolchain-xcode" in words[:-1] else None


def adopted_env_stale(marker: str | None, environ: Any, xcode_app: str | None) -> str | None:
    """Why a listener this gate adopted (a reload) runs with an environment listener_env would not give it, or None.
    A gate that started it says so across the reload (GATE_LISTENER_ENV: "clean", or why not); a gate from before
    listener_env started it with its own environment, which is environ."""
    if marker:
        return None if marker == "clean" else marker
    leaked = leaked_toolchain_env(environ, xcode_app)
    if leaked:
        return leaked
    developer = os.fspath(Path(xcode_app) / "Contents" / "Developer") if xcode_app else None
    if developer and environ.get("DEVELOPER_DIR") != developer:
        return f"the listener started before the gate set DEVELOPER_DIR={developer}"
    return None


def free_gib(path: str) -> float:
    return shutil.disk_usage(path if os.path.isdir(path) else str(Path.home())).free / 1024**3


def disk_refusal(path: str, min_free_gib: float) -> str | None:
    if min_free_gib <= 0:
        return None
    try:
        free = free_gib(path)
    except OSError as error:
        return f"cannot read free disk ({type(error).__name__})"
    return None if free >= min_free_gib else f"{free:.1f} GiB free, {min_free_gib:g} GiB required"


def free_or_none(path: str) -> float | None:
    try:
        return free_gib(path)
    except OSError:
        return None


def evicted(path: str, min_free_gib: float, ran: str, before: float | None) -> str:
    """The one-line note an eviction under the floor logs, with the space it freed."""
    after = free_or_none(path)
    freed = f"{after - before:.1f} GiB" if before is not None and after is not None else "an unknown amount"
    return f"under the {min_free_gib:g} GiB disk floor: {ran}, freed {freed}"


def evict(path: str, min_free_gib: float, explicit: str | None, deadline: float | None = None) -> str:
    """Free disk under the floor before refusing a job for it: glaeda-disk --pressure runs, bounded together by
    EVICT_TIMEOUT_S. Under the floor, free space is below glaeda-disk's emergency mark (20 GiB above the floor), so
    it deletes even while CI jobs run on this mini; it frees idle caches up to its runner target. glaeda-disk
    never deletes the Chromium trees (NEVER_DELETE) or anything a running job has open, names or marks busy.
    When a pass already holds glaeda-disk's evict.lock (job-completed starts one detached), it waits for that one,
    then runs its own only if still under the floor; when that one skips as busy (the queue's next pass took the
    lock first) it waits for that pass too, and so on until a pass of its own ran or the budget is spent. deadline
    (monotonic) is the budget's end, which job-started shares between its evictions; by default EVICT_TIMEOUT_S on.
    Returns a one-line note with the space freed; never raises."""
    before = free_or_none(path)
    start = time.monotonic()
    deadline = start + EVICT_TIMEOUT_S if deadline is None else deadline
    waited, busy, ran = 0.0, 0, ""
    while True:
        looked = time.monotonic()
        if wait_for_running_pass(deadline):
            # job-completed's detached pass (or the gate's, or the LaunchAgent's) held glaeda-disk's evict.lock: a
            # pass of our own would have skipped as busy and refused this job while space was being freed
            waited += time.monotonic() - looked
            if not disk_refusal(path, min_free_gib):
                ran = ""
                break
        left = deadline - time.monotonic()
        if left < 1.0:
            ran = ran or "the eviction budget is spent"
            break
        ran, skipped = disk_pressure_run(explicit, min_free_gib, left)
        if not skipped or time.monotonic() >= deadline:
            break
        busy += 1
        # busy behind measure.lock, which wait_for_running_pass does not watch: never a tight loop of glaeda-disk runs
        time.sleep(min(EVICT_BUSY_PAUSE_S, max(0.0, deadline - time.monotonic())))
    notes = [f"waited {waited:.0f} s for a running glaeda-disk pass"] if waited else []
    if busy:
        notes.append(f"its own pass skipped as busy {busy} time{'s' if busy > 1 else ''}")
    return evicted(path, min_free_gib, "; ".join([*notes, *([ran] if ran else [])]), before)


def prejob_margin_gib() -> float:
    """PREJOB_MARGIN_GIB, or PREJOB_MARGIN_ENV when it is a finite number from 0 to 500."""
    try:
        value = float(os.environ.get(PREJOB_MARGIN_ENV) or PREJOB_MARGIN_GIB)
    except ValueError:
        return PREJOB_MARGIN_GIB
    return value if math.isfinite(value) and 0 <= value <= 500 else PREJOB_MARGIN_GIB


def prejob_target_gib(min_free_gib: float) -> float:
    """The free space a job starts at: the floor plus prejob_margin_gib, or 0 (no target) for a runner with no floor."""
    return min_free_gib + prejob_margin_gib() if min_free_gib > 0 else 0.0


def pass_active() -> bool:
    """Whether a glaeda-disk pass is freeing space now or about to: a trigger no pass has served yet (DISK_PASS_PENDING
    or its .claimed, which disk_pressure_detached writes before its detached child takes the pass lock), the queued
    pass (the hook's pass lock), or any --apply holding evict.lock."""
    state = disk_state_dir()
    pending = state / DISK_PASS_PENDING
    return (os.path.lexists(pending) or os.path.lexists(f"{pending}.claimed")
            or disk_pass_running(state / DISK_PASS_LOCK) or wait_for_running_pass(time.monotonic()))


def prejob_evict(path: str, min_free_gib: float, explicit: str | None, wait_s: float = PREJOB_WAIT_S) -> str | None:
    """Evict before the job: above the floor but under the pre-job target, start the one queued glaeda-disk pass now
    (disk_pressure_detached, which coalesces into a running one) and wait for free space to reach the target, at most
    wait_s, polling free space every PREJOB_POLL_S and stopping early once no pass runs. The pass is never cut or
    killed here, and the job is admitted whatever it freed: it is above the floor. None when there is nothing to do
    (no floor, at or above the target, or already under the floor, which evict() handles). Never raises."""
    try:
        target = prejob_target_gib(min_free_gib)
        if target <= 0 or not disk_refusal(path, target) or disk_refusal(path, min_free_gib):
            return None
        before = free_or_none(path)
        started = disk_pressure_detached(explicit)
        start = time.monotonic()
        deadline = start + max(0.0, wait_s)
        while time.monotonic() < deadline and disk_refusal(path, target):
            time.sleep(min(PREJOB_POLL_S, max(0.0, deadline - time.monotonic())))
            if time.monotonic() - start >= PREJOB_POLL_S and not pass_active():
                break
        after = free_or_none(path)
        freed = f"{after - before:.1f} GiB" if before is not None and after is not None else "an unknown amount"
        reached = "reached" if not disk_refusal(path, target) else "not reached; admitted above the floor"
        return (f"under the {target:g} GiB pre-job target ({min_free_gib:g} GiB floor + {target - min_free_gib:g}): "
                f"{started}; waited {time.monotonic() - start:.0f} s, freed {freed}, target {reached}")
    except Exception as error:  # noqa: BLE001  (never fail the job on housekeeping)
        return f"pre-job eviction skipped: {type(error).__name__}"


def evict_lock_path() -> Path:
    """glaeda-disk's EVICT_LOCK: one --apply at a time across the runner hooks, the gate and the LaunchAgent."""
    return Path.home() / ".cache" / "glaeda-disk" / "evict.lock"


def wait_for_running_pass(deadline: float) -> bool:
    """Wait until no glaeda-disk --apply holds its evict.lock, at most until deadline (monotonic). True when one held
    it. Probes with a shared non-blocking flock, as glaeda-disk's eviction_lock_is_held does, and never keeps it."""
    try:
        fd = os.open(evict_lock_path(), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return False  # no lock file: no pass has ever run
    held = False
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                held = True
                if time.monotonic() >= deadline:
                    return held
                time.sleep(0.25)
                continue
            except OSError:
                return held
            fcntl.flock(fd, fcntl.LOCK_UN)
            return held
    finally:
        os.close(fd)


def root_number(spec: str, roots: int = 99) -> int | None:
    """1 for /private/tmp/cmux-ci or 1, k for /private/tmp/cmux-ci-k or k (2 to roots), else None. No leading
    zeros, so the path a caller uses is exactly the one held."""
    spec = spec.rstrip("/")
    if spec in ("/private/tmp/cmux-ci", "1"):
        return 1
    match = re.fullmatch(r"(?:/private/tmp/cmux-ci-)?([2-9]|[1-9][0-9])", spec)
    k = int(match.group(1)) if match else 0
    return k if 2 <= k <= roots else None


def runner_worker_pid() -> int | None:
    """The Runner.Worker this step runs under, walking up from our parent with /bin/ps (never the job's PATH)."""
    pid = os.getppid()
    try:
        for _ in range(64):
            if pid <= 1:
                return None
            out = subprocess.run(["/bin/ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True,
                                 timeout=5, check=False).stdout.strip()
            if not out:
                return None
            ppid, comm = out.split(None, 1)
            if os.path.basename(comm.strip()) == "Runner.Worker":
                return pid
            pid = int(ppid)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return None


def direct_child_pids(pid: int) -> set[int]:
    """Return direct children without trusting the job's PATH or following a process tree."""
    try:
        out = subprocess.run(["/bin/ps", "-axo", "pid=,ppid=,comm="], stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return {pid}  # fail closed: an unreadable process table is not proof of an orphan
    children: set[int] = set()
    for line in out.splitlines():
        fields = line.split()
        if (len(fields) >= 3 and fields[0].isdigit() and fields[1].isdigit()
                and os.path.basename(fields[2]) != "ps" and int(fields[1]) == pid):
            children.add(int(fields[0]))
    return children


def orphan_hook_should_exit(worker_pid: int, worker_identity: str, children: set[int], parent_pid: int | None = None) -> bool:
    """Only reap a hook after its original Runner.Worker is gone and it has no child work."""
    if children:
        return False
    # Runner.Worker execs the hook wrapper, so a crashed runner reparents the
    # hook directly to launchd. This avoids macOS `ps lstart`'s one-second
    # resolution and cannot confuse a same-second PID reuse for our parent.
    if parent_pid == 1:
        return True
    if pid_alive(worker_pid):
        # A live PID with an unreadable start token is unknown, not orphaned.
        # This avoids killing a real job during a transient /bin/ps failure.
        current = process_identity(worker_pid)
        return current is not None and current != worker_identity
    return True


def start_runner_parent_watchdog(owner: JobOwner | None) -> None:
    """Stop an admitted hook stranded by a dead Runner.Worker, releasing its flocks.

    Hooks are normally descendants of Runner.Worker. A runner crash can reparent a
    still-blocked hook to launchd, leaving host.lock held forever. The watcher is
    enabled only when that ancestry was observed, uses a start token to reject PID
    reuse, and waits until the hook has no direct child process before terminating.
    """
    # The owner is pinned once (job_owner): the Runner.Worker, else the observed parent, never launchd.
    if owner is None:
        return
    worker_pid, identity = owner

    def watch() -> None:
        while True:
            time.sleep(ORPHAN_HOOK_POLL_S)
            if orphan_hook_should_exit(worker_pid, identity, direct_child_pids(os.getpid()), os.getppid()):
                print(f"{PREFIX}: orphaned job-started hook; Runner.Worker {worker_pid} is gone, releasing admission", flush=True)
                os.kill(os.getpid(), signal.SIGTERM)
                return

    threading.Thread(target=watch, name="glaeda-orphan-hook-watch", daemon=True).start()


ROOT_SHIM = "glaeda-canonical-root"


# The user's testmanagerd (a launchd agent started on demand) pairs xcodebuild with the xctest it launches.
# On cmux7s (2026-09-25) it stopped half way through tearing down a control session and from then on
# accepted xcodebuild's control connections without creating the IDE session, so every macOS XCTest run
# there hung ("The test runner hung before establishing connection", exit 65) for 10 hours. launchctl
# kickstart is refused under SIP, and the wedged daemon ignored SIGTERM. So a job taking the gui token
# (every console-session XCTest job holds it) stops the daemon while no test runs, and launchd starts a
# fresh one at the next connection. The simulators' own testmanagerd runs from the runtime root, not here.
TESTMANAGERD = "/usr/libexec/testmanagerd"
TESTMANAGERD_TERM_S = 3.0
TESTMANAGERD_KILL_S = 5.0
TESTMANAGERD_STUCK = "testmanagerd: stuck"
# Finished CI XCTest apps can outlive the Runner.Worker after their _temp tree is removed.
# Only this exact derived-data app family is eligible; arbitrary user apps are never touched.
LEAKED_TEST_APP = re.compile(r"^\s*'?(.*/actions-runner[^/]+/_work/_temp/cmux-derived-data-tests-[^/]+/Build/Products/Debug/cmux DEV\.app)(?:/Contents/MacOS/[^ ]+)?'?(?:\s|$)")
# Media/E2E jobs use a stable macOS DerivedData family outside the runner's
# _work tree. The app can detach and be reparented to launchd, so the normal
# work-directory reaper cannot see it after the job ends. Keep this exact
# generated app family narrow; arbitrary user apps are never eligible.
LEAKED_MEDIA_APP = re.compile(
    r"^\s*'?(/Users/[^/\s]+/Library/Developer/Xcode/DerivedData/cmux-(?P<tag>ci-media-[A-Za-z0-9._-]+)/"
    r"Build/Products/Debug/cmux DEV(?: (?P=tag))?\.app)/Contents/Resources/bin/"
    r"(?:cmux-tui|cmux-agent-screen-detection)(?:'?(?:\s|$))")
LEAKED_TEST_TEMP = re.compile(r"^(.*/actions-runner[^/]+/_work/_temp/cmux-derived-data-tests-[^/]+)(?:/|$)")
LEAKED_APP_TERM_S = 1.0
# A process that may be talking to testmanagerd: an XCTest runner, or xcodebuild testing. A false match only
# keeps the daemon, so these err wide.
XCTEST_RUNNING = re.compile(r"(?:^|/)xctest(?:\s|$)|(?:^|/)xcodebuild\s(?:.*\s)?(?:test|test-without-building)(?:\s|$)")


def _ps_table() -> list[tuple[int, int, str, str]] | None:
    """(pid, uid, state, command) for every process, or None when ps fails. Arguments of other jobs' processes
    are read to decide, never printed."""
    try:
        out = subprocess.run(["/bin/ps", "-Aww", "-o", "pid=,uid=,stat=,command="], stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, errors="replace", timeout=5, check=False).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit() and parts[1].isdigit():
            rows.append((int(parts[0]), int(parts[1]), parts[2], parts[3].strip()))
    return rows


def recycle_testmanagerd(program: str = TESTMANAGERD, busy: re.Pattern[str] = XCTEST_RUNNING) -> str:
    """Stop this user's testmanagerd unless a test is running, so the next test starts a fresh one.
    Returns a note, never raises. A daemon that outlives SIGKILL gives a note starting TESTMANAGERD_STUCK."""
    try:
        return _recycle_testmanagerd(program, busy)
    except Exception as error:  # noqa: BLE001  (a failed recycle leaves the daemon; it never fails the job)
        return f"testmanagerd: not checked ({type(error).__name__})"


def _recycle_testmanagerd(program: str, test_running: re.Pattern[str]) -> str:
    uid, me = os.getuid(), os.getpid()

    def survey() -> tuple[set[int], bool] | None:
        """This user's live daemons and whether a test runs. A zombie (Z) is gone: its parent just has not reaped
        it; so is one macOS ps marks as exiting (E), which a loaded mini can take seconds to finish."""
        rows = _ps_table()
        if rows is None:
            return None
        daemons, busy = set(), False
        for pid, owner, state, command in rows:
            if pid == me or state.startswith("Z") or "E" in state:
                continue
            if owner == uid and (command == program or command.startswith(program + " ")):
                daemons.add(pid)
            elif test_running.search(command):
                busy = True
        return daemons, busy

    first = survey()
    if first is None:
        return "testmanagerd: not checked (ps failed)"
    daemons, busy = first
    if not daemons:
        return "testmanagerd: not running (launchd starts it at the next test)"
    if busy:
        return "testmanagerd: kept (a test is running on this mini)"
    pids = " ".join(map(str, sorted(daemons)))

    def left_of(wait_s: float) -> tuple[set[int], bool] | None:
        """The daemons still alive after up to wait_s, and whether a test runs; None when ps failed last."""
        deadline = time.monotonic() + wait_s
        while True:
            now = survey()
            alive = daemons & now[0] if now is not None else daemons
            if (now is not None and not alive) or time.monotonic() >= deadline:
                return None if now is None else (alive, now[1])
            time.sleep(0.2)

    for pid in daemons:
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGTERM)
    after = left_of(TESTMANAGERD_TERM_S)
    if after is None:  # unconfirmed: never SIGKILL or refuse on a guess
        return f"testmanagerd: sent SIGTERM to pid {pids} (not confirmed: ps failed)"
    alive, running = after
    if not alive:
        return f"testmanagerd: stopped pid {pids}"
    killed = " ".join(map(str, sorted(alive)))
    if running:  # a test started meanwhile and may be talking to it: leave it to that run
        return f"testmanagerd: kept pid {killed} (ignored SIGTERM; a test started)"
    for pid in alive:
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGKILL)
    after = left_of(TESTMANAGERD_KILL_S)
    if after is None:
        return f"testmanagerd: sent SIGKILL to pid {killed} (not confirmed: ps failed)"
    if after[0]:
        return f"{TESTMANAGERD_STUCK}: pid {' '.join(map(str, sorted(after[0])))} outlived SIGKILL"
    return f"testmanagerd: killed pid {killed} (it ignored SIGTERM)"


TEST_KEYCHAIN = "cmux-ci.keychain-db"


def ensure_test_keychain(home: Path) -> str:
    """A passwordless keychain for PR jobs' tests, unlocked, first in the user search list and the default.
    The login keychain stays locked from a launchd session (errSecInteractionNotAllowed), so tests that add
    items need their own; it holds only test junk, never credentials. Idempotent and best effort: a failure
    is reported, never fatal, and the login keychain's contents are never touched.
    The default is the user's, not the job's: anything that later stores a credential as this user on a PR
    mini without naming a keychain lands here, readable by every PR job. Never store credentials as the
    runner user on a PR mini (docs/CMUX_MINI_RUNNER.md)."""
    sec = "/usr/bin/security"
    path = os.fspath(home / "Library/Keychains" / TEST_KEYCHAIN)

    def call(*args: str) -> subprocess.CompletedProcess:
        return subprocess.run([sec, *args], capture_output=True, text=True, timeout=15)

    def listed(out: str) -> list[str]:
        return [line.strip().strip('"') for line in out.splitlines() if line.strip()]

    try:
        if not os.path.exists(path):
            made = call("create-keychain", "-p", "", path)
            if made.returncode and not os.path.exists(path):
                return f"test keychain: create failed ({made.stderr.strip()[:120]})"
        call("set-keychain-settings", path)  # no -l, -u or -t: never locks on sleep or after a timeout
        if call("unlock-keychain", "-p", "", path).returncode:
            return "test keychain: unlock failed"
        keychains = listed(call("list-keychains", "-d", "user").stdout)
        if keychains[:1] != [path] and call("list-keychains", "-d", "user", "-s", path,
                                            *[k for k in keychains if k != path]).returncode:
            return "test keychain: unlocked, but setting the search list failed"
        if listed(call("default-keychain", "-d", "user").stdout)[:1] != [path] \
                and call("default-keychain", "-d", "user", "-s", path).returncode:
            return "test keychain: unlocked, but setting the default failed"
        return f"test keychain {TEST_KEYCHAIN} unlocked and default"
    except (OSError, subprocess.SubprocessError) as error:
        return f"test keychain: {type(error).__name__}"


GUI_UNLOCK_LABEL = "com.teamleaderleo.glaeda.test-keychain-unlock"


# Runs in the Aqua session: unlock, then cancel keychain prompts queued while it was locked. A prompt already
# on screen stays there after the unlock, and killing SecurityAgent only cancels the one shown: securityd
# starts a new SecurityAgent for the next queued prompt, 6 to 9 s later (cmux-mac-mini, 2026-09-27), so stop
# only once none has come back for 15 s (at most 30 kills). A single quiet check after 1 s left the next
# queued prompt up. -u: only this user's SecurityAgent, never loginwindow's.
# SIGKILL: a SecurityAgent showing a prompt ignores SIGTERM (cmux12s, 2026-09-27).
GUI_UNLOCK_SCRIPT = ('/usr/bin/security unlock-keychain -p "" "$1" || exit 1\n'
                     'uid=$(/usr/bin/id -u) kills=0 quiet=0\n'
                     'while [ "$quiet" -lt 15 ] && [ "$kills" -lt 30 ]; do\n'
                     '  if /usr/bin/pkill -KILL -x -u "$uid" SecurityAgent; then kills=$((kills + 1)) quiet=0\n'
                     '  else quiet=$((quiet + 1)); fi\n'
                     '  sleep 1\n'
                     'done\n'
                     'exit 0\n')


def unlock_test_keychain_in_gui(home: Path, uid: int | None = None) -> str:
    """Unlock the test keychain in the GUI (Aqua) security session too, and cancel keychain prompts queued there
    while it was locked. Unlock state is per security session, and each runner's LaunchAgent has SessionCreate,
    so the job-started unlock never reaches the desktop: there the user's default keychain stays locked and
    Spotlight or assistantd asks for its password over UI tests. A LaunchAgent limited to Aqua runs the unlock in
    that session: RunAtLoad covers every login, and the kickstart here covers a keychain made since.
    Daemons ask for the default keychain within seconds of login, often before that agent runs, and securityd
    keeps such a prompt up after the unlock (cmux14 and cmux8s, 2026-09-27: queued at the 09-26 reboot, still up
    the next morning). So the agent then kills SecurityAgent until no queued prompt has restarted it for 15 s. On a PR mini
    no keychain prompt is ever wanted. Best effort; without a GUI login there is nothing to fix."""
    uid = os.getuid() if uid is None else uid
    keychain = os.fspath(home / "Library/Keychains" / TEST_KEYCHAIN)
    plist = home / "Library/LaunchAgents" / f"{GUI_UNLOCK_LABEL}.plist"
    data = plistlib.dumps({"Label": GUI_UNLOCK_LABEL, "LimitLoadToSessionType": "Aqua", "RunAtLoad": True,
                           "ProgramArguments": ["/bin/sh", "-c", GUI_UNLOCK_SCRIPT, "sh", keychain]},
                          sort_keys=True)

    def launchctl(*args: str) -> int:
        return subprocess.run(["/bin/launchctl", *args], capture_output=True, text=True, timeout=15).returncode

    try:
        service = f"gui/{uid}/{GUI_UNLOCK_LABEL}"
        if not plist.is_file() or plist.read_bytes() != data:
            plist.parent.mkdir(parents=True, exist_ok=True)
            aside = plist.with_name(f".{plist.name}.{os.getpid()}")
            aside.write_bytes(data)
            os.replace(aside, plist)  # runner instances write it at once
            launchctl("bootout", service)  # a loaded agent keeps its old program until it is loaded again
        # Not loaded yet: bootstrap runs it (RunAtLoad). Another instance may bootstrap first: kickstart again.
        if launchctl("kickstart", service) and launchctl("bootstrap", f"gui/{uid}", os.fspath(plist)) \
                and launchctl("kickstart", service):
            return "test keychain: no GUI session to unlock it in"
        return "test keychain: GUI session unlock started"
    except (OSError, subprocess.SubprocessError) as error:
        return f"test keychain: GUI unlock {type(error).__name__}"


# Diagnostics Reporter's LaunchAgent watches these QueueDirectories: launchd starts it while either holds an entry,
# and an entry stays until someone answers the dialog it draws ("Your computer was restarted because of a problem"
# after a kernel panic, "<app> cannot be opened because of a problem" after a crashed launch). On a PR mini nobody
# answers: a panic queued on 2026-09-25 put that dialog over UI tests for two days, and the cmux e2e action's kill
# only made launchd start it again with the same dialog. The directories are world-writable (not sticky).
DIAGNOSTICS_QUEUES = (Path("/var/db/PanicReporter"), Path("/var/db/DiagnosticsReporter"))
# A queued panic is a symlink to the unanswered summary the dialog shows, a `.contents.*` file here. The full
# reports (panic-full-*.panic, crash reports) are never touched.
DIAGNOSTIC_REPORTS = Path("/Library/Logs/DiagnosticReports")


# An earlier job's sparse checkout (actions/checkout `sparse-checkout: scripts/ci`) leaves the reused workspace
# sparse. The next full checkout runs `sparse-checkout disable`, which writes the whole tree back, then
# `checkout --force`, which on cmuxs-mac-mini-6-glaeda-2 refused the files it had just written ("not
# uptodate; will not remove from working tree") and left the job without its scripts (manaflow-ai/cmux runs
# 38301254053 and 38308823659, 2026-10-12). Before the checkout, such a workspace keeps only its object store:
# the index, the sparse settings and every working file go, so checkout's `reset --hard` writes the tree whole
# with a fresh index. A failed checkout's leftovers get the same reset (workspace_damage); a workspace whose
# tracked files match HEAD is never touched.
SPARSE_SETTINGS = ("core.sparseCheckout", "core.sparseCheckoutCone", "index.sparse", "extensions.worktreeConfig")


def unsparse_workspace(workspace: str | None) -> str:
    if not workspace:
        return ""
    ws = Path(workspace)
    git_dir = ws / ".git"
    if "_work" not in ws.parts or git_dir.is_symlink() or not git_dir.is_dir():
        return ""
    why = workspace_damage(ws)
    if not why:
        return ""
    for child in ws.iterdir():
        if child.name == ".git":
            continue
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child)
        else:
            child.unlink()
    for setting in SPARSE_SETTINGS:
        subprocess.run(["git", "-C", os.fspath(ws), "config", "--local", "--unset-all", setting],
                       capture_output=True, timeout=30, check=False)
    for leftover in (git_dir / "index", git_dir / "info" / "sparse-checkout", git_dir / "config.worktree"):
        with contextlib.suppress(FileNotFoundError):
            leftover.unlink()
    return f"reset the workspace {ws} an earlier job left {why} (checkout rebuilds it whole)"


def workspace_damage(ws: Path) -> str:
    """Why the reused workspace cannot take a plain checkout, or "". A failed checkout (glaeda-2, three
    cmux-tui runs on 2026-10-12) leaves skip-worktree entries with no sparse setting, or tracked files that
    differ from HEAD; checkout's clean and reset --hard did not recover it."""
    def git(*args: str) -> subprocess.CompletedProcess:
        return subprocess.run(["git", "-C", os.fspath(ws), *args], capture_output=True, text=True,
                              timeout=60, check=False)

    if git("config", "--bool", "--default", "false", "core.sparseCheckout").stdout.strip() == "true":
        return "sparse"
    listed = git("ls-files", "-v")
    if listed.returncode != 0 or any(line.startswith("S ") for line in listed.stdout.splitlines()):
        return "with skip-worktree entries"
    status = git("status", "--porcelain", "--untracked-files=no", "--ignore-submodules=all")
    if status.returncode != 0 or status.stdout.strip():
        return "with tracked files that differ from HEAD"
    return ""


def dequeue_diagnostics_reporter(queues: tuple[Path, ...] = DIAGNOSTICS_QUEUES,
                                 reports: Path = DIAGNOSTIC_REPORTS, uid: int | None = None) -> str:
    """Empty Diagnostics Reporter's queues, then close it, so no crash or panic dialog is left over a job's GUI.

    Emptied first: closing it alone lets launchd start it again for the same entry. A symlink entry is removed,
    never followed; the summary it names is removed too only when it is a `.contents.*` file directly in
    `reports`. Best effort: any failure leaves the dialog, never fails the job. Returns "" when nothing was queued
    and nothing was closed."""
    uid = os.getuid() if uid is None else uid
    dequeued = failed = 0
    for queue in queues:
        try:
            entries = list(os.scandir(queue))
        except OSError:
            continue
        for entry in entries:
            path = Path(entry.path)
            try:
                target = os.readlink(path) if entry.is_symlink() else ""
                if entry.is_dir(follow_symlinks=False):
                    shutil.rmtree(path)
                else:
                    path.unlink()
                dequeued += 1
            except FileNotFoundError:
                continue  # another runner instance starting a job at once removed it first
            except OSError:
                failed += 1
                continue
            summary = Path(target) if target else None
            if summary is not None and summary.is_absolute() and ".." not in summary.parts \
                    and summary.parent == reports and summary.name.startswith(".contents."):
                with contextlib.suppress(OSError):
                    summary.unlink()
    closed = False
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        # Its name is longer than the 16 bytes pkill -x compares, so match the executable path.
        closed = subprocess.run(["/usr/bin/pkill", "-KILL", "-u", str(uid), "-f",
                                 "/Diagnostics Reporter.app/Contents/MacOS/"],
                                capture_output=True, timeout=15).returncode == 0
    parts = [f"dequeued {dequeued} Diagnostics Reporter entr{'y' if dequeued == 1 else 'ies'}"] if dequeued else []
    if failed:
        parts.append(f"could not dequeue {failed}")
    if closed:
        parts.append("closed Diagnostics Reporter")
    return "; ".join(parts)


def ensure_root_shim(bin_dir: Path) -> None:
    """Point FLEET_DIR/bin/glaeda-canonical-root at this hook's shim (the path cmux's restore step calls).
    Best effort and atomic: a symlink written aside and renamed over the old one."""
    shim = Path(__file__).resolve().parent / ROOT_SHIM
    link = bin_dir / ROOT_SHIM
    if not shim.is_file() or not bin_dir.is_dir():
        return
    with contextlib.suppress(OSError):
        if link.is_symlink() and os.readlink(link) == os.fspath(shim):
            return
        tmp = bin_dir / f".{ROOT_SHIM}.{os.getpid()}"
        tmp.unlink(missing_ok=True)
        os.symlink(shim, tmp)
        os.replace(tmp, link)


def take_root(spec: str, wait_s: float, capacity_dir: Path, state_dir: Path, roots: int = 99,
              switch: bool = False, gui_token: str = "gui") -> int:
    """glaeda-canonical-root take ROOT: hold canonical root ROOT for the rest of this job (cmux#14338), waiting
    up to wait_s for it. A root this job already holds is a no-op; a second, different root is refused (two
    jobs taking two roots in opposite orders would deadlock), unless `switch` and every root the job holds
    has a live holder of its own (ROOT_SWITCHERS, or an earlier take-root). A switch waits for ROOT while
    still holding the old roots and lets them go only once ROOT is held, so a timeout leaves the job where
    it was (exit 1) and never without a root; two switchers after each other's root both time out, so
    callers keep --wait short. On success it points $GITHUB_ENV's CMUX_CI_CANONICAL_ROOT at ROOT. Prints
    the root's path."""
    k = root_number(spec)
    if k is None:
        print(f"{PREFIX}: take-root: {spec!r} is not a canonical root "
              "(/private/tmp/cmux-ci, /private/tmp/cmux-ci-N or N)", file=sys.stderr)
        return 2
    if not os.environ.get("RUNNER_NAME"):
        print(f"{PREFIX}: take-root: RUNNER_NAME is not set (not a runner job step)", file=sys.stderr)
        return 2
    name, path = f"root-{k}", canonical_root(k)
    held: list[str] = []
    with contextlib.suppress(OSError):
        held = roots_file(state_dir).read_text().split()
    if name in held:
        print(path)
        return 0
    # A consumer on a mini with fewer roots than the producer's (a product compiled at /private/tmp/cmux-ci-2
    # on a two-root mini, restored on a one-root mini): nothing compiles at root k here, so only consumers
    # alias it. A job holding every root this mini has (a consumer's admission on a one-root mini) still takes
    # root k's token, so it and a job holding no root never share the alias. A job that takes root k first and
    # then switches to one of this mini's roots can wait on this job while this job waits on it; neither hangs,
    # both give up after their --wait (the restore script waits up to 1800 s). No workflow does that switch today.
    extra = k > roots and bool(held) and set(held) >= {f"root-{n}" for n in range(1, roots + 1)}
    if held and not extra and not (switch and all(holder_alive(root_holder_file(state_dir, old)) for old in held)):
        print(f"{PREFIX}: take-root: this job already holds {', '.join(held)}; one root per job"
              + ("" if switch else " (--switch lets go of a root with its own holder first)"), file=sys.stderr)
        return 2
    worker = runner_worker_pid()
    if worker is None:
        print(f"{PREFIX}: take-root: not inside a runner job (no Runner.Worker above this step)", file=sys.stderr)
        return 2
    deadline = time.monotonic() + max(0.0, wait_s)
    want = capacity_dir / f"{name}.want-{os.getpid()}"
    try:
        while True:
            fd = lock_file(capacity_dir / f"{name}.token", fcntl.LOCK_EX)
            if fd is None and time.monotonic() >= deadline:
                fd = retake(capacity_dir / f"{name}.token")  # a listener gate's probe holds it for microseconds
            if fd is not None:
                break
            if time.monotonic() >= deadline:
                print(f"{PREFIX}: take-root: {path} is still in use after {wait_s:g} s", file=sys.stderr)
                return 1
            # take-gui reads it: a gui holder waiting for a root must not be waited on. Rewritten every poll,
            # so a marker a killed waiter left goes stale (WANT_FRESH_S) even if its pid comes back.
            with contextlib.suppress(OSError):
                want.write_text(f"{gui_token}\n" if gui_file(state_dir).exists() else "\n")
            time.sleep(TAKE_ROOT_POLL_S)
    finally:
        with contextlib.suppress(OSError):
            want.unlink()
    ok, note = hold([fd], worker, state_dir, pid_file=root_holder_file(state_dir, name))
    if not ok:
        print(f"{PREFIX}: take-root: {note}", file=sys.stderr)
        return 1
    settled = settle_root(k)
    if settled:
        print(f"{PREFIX}: take-root: {settled}", file=sys.stderr)
    if held and not extra:  # a switch: ROOT is held, so the old roots can go, after the record stops naming them
        with contextlib.suppress(OSError):
            roots_file(state_dir).write_text(name + "\n")
        for old in held:
            release_holder(root_holder_file(state_dir, old))
        print(f"{PREFIX}: take-root: let go of {', '.join(held)}; {export_root(name)}", file=sys.stderr)
    else:
        with contextlib.suppress(OSError), open(roots_file(state_dir), "a", encoding="utf-8") as record:
            record.write(name + "\n")
    print(path)
    return 0


PROBE_RETRY_S = 0.05


def retake(path: Path) -> int | None:
    """One more try at a token after a short pause. The listener gate's probe (mini_full) takes root and gui
    tokens for microseconds without admission.lock, which take-root and take-gui do not hold either, so a
    last try that meets a probe must not be the one that fails the job."""
    time.sleep(PROBE_RETRY_S)
    return lock_file(path, fcntl.LOCK_EX)


# A root's token is free once its job is gone, but not every process of that job is. When a step ignores the
# runner's SIGINT and SIGTERM, the runner kills the step's process tree, and processes xcodebuild started that are
# no longer in that tree (its build service and compilers) keep working in the root for seconds after
# job-completed released the token (manaflow-ai/cmux 36312829569: a cancelled compile's leftovers were still
# writing <root>/src when the next holder, a test consumer, ran rm -rf on it: "Directory not empty"). So a job
# that takes a root stops this user's leftovers still using it before the job goes on: a process working in the
# root (lsof cwd) or naming a path inside it (ps) that no live job owns. A process under a live Runner.Worker is
# spared even so: a job that switched roots (take --switch) may still name its old root in a running step's
# arguments. The hook itself (its detached holders, and take-root waiters, which may name the root with a
# trailing slash) is spared too. Tests point ROOT_PARENT at a temporary directory, so they never touch this
# machine's own roots.
ROOT_PARENT = os.environ.get("GLAEDA_CANONICAL_ROOT_PARENT") or "/private/tmp"
ROOT_SETTLE_TERM_S = 3.0  # SIGTERM first, then SIGKILL
ROOT_SETTLE_S = 15.0
ROOT_SETTLE_POLL_S = 0.2
ROOT_SETTLE_SPARED = ("glaeda-cmux-runner-hook", ROOT_SHIM)


def settle_path(k: int) -> str:
    return os.path.join(ROOT_PARENT, os.path.basename(canonical_root(k)))


def root_users(path: str) -> list[int] | None:
    """This user's leftover processes working in root `path` or naming a path inside it: none under a live
    Runner.Worker, and not the hook. None when ps cannot tell."""
    inside, uid = path.rstrip("/") + "/", str(os.getuid())
    try:
        listing = subprocess.run([PS, "-U", uid, "-ww", "-o", "pid=,ppid=,command="], stdin=subprocess.DEVNULL,
                                 capture_output=True, text=True, timeout=10, check=False, env={"LC_ALL": "C"}).stdout
        cwds = subprocess.run([LSOF, "-nP", "-w", "-a", "-u", uid, "-d", "cwd", "-Fpn"], stdin=subprocess.DEVNULL,
                              capture_output=True, text=True, timeout=10, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    parent: dict[int, int] = {}
    command: dict[int, str] = {}
    for line in listing.splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            parent[int(parts[0])], command[int(parts[0])] = int(parts[1]), parts[2] if len(parts) == 3 else ""
    if not parent:
        return None
    users = {pid for pid, argv in command.items() if inside in argv}
    pid = 0
    for line in cwds.splitlines():
        if line[:1] == "p" and line[1:].isdigit():
            pid = int(line[1:])
        elif line[:1] == "n" and pid in command and (line[1:] == path or line[1:].startswith(inside)):
            users.add(pid)

    def in_live_job(pid: int) -> bool:
        for _ in range(256):
            if pid <= 1 or pid not in command:
                return False
            if os.path.basename(command[pid].split(" ", 1)[0]) == "Runner.Worker":
                return True
            pid = parent[pid]
        return True  # a loop in the table: leave it alone

    return sorted(pid for pid in users if pid != os.getpid() and not in_live_job(pid)
                  and not any(name in command[pid] for name in ROOT_SETTLE_SPARED))


def settle_root(k: int) -> str:
    """Stop the leftover processes still using root k (root_users) before this job uses it; a note for the log."""
    path = settle_path(k)
    if not os.path.lexists(path):
        return ""
    start = time.monotonic()
    stopped: set[int] = set()
    while True:
        users = root_users(path)
        if users is None:
            return f"cannot list the processes using {path}"
        if not users:
            return f"stopped {len(stopped)} leftover process(es) in {path}" if stopped else ""
        elapsed = time.monotonic() - start
        if elapsed >= ROOT_SETTLE_S:
            return f"{len(users)} leftover process(es) still use {path} (pids {', '.join(map(str, users[:8]))})"
        signum = signal.SIGTERM if elapsed < ROOT_SETTLE_TERM_S else signal.SIGKILL
        for pid in users:
            with contextlib.suppress(OSError):
                os.kill(pid, signum)
        stopped.update(users)
        time.sleep(ROOT_SETTLE_POLL_S)


def holder_alive(pid_file: Path) -> bool:
    """A holder pid file whose holder is still running (a killed one leaves its file behind)."""
    try:
        return pid_alive(int(pid_file.read_text().strip()))
    except (OSError, ValueError):
        return False


def gui_holder_wants(capacity_dir: Path, roots: list[str], gui_token: str = "gui") -> str | None:
    """A root in `roots` that a job holding the gui token is waiting for in take-root, from its marker."""
    for name in roots:
        for marker in capacity_dir.glob(f"{name}.want-*"):
            try:
                pid, mark = int(marker.name.rsplit("-", 1)[1]), marker.read_text()
            except (OSError, ValueError):
                continue
            try:
                fresh = time.time() - marker.stat().st_mtime < WANT_FRESH_S
            except OSError:
                continue
            if not fresh or not pid_alive(pid):
                with contextlib.suppress(OSError):
                    marker.unlink()  # a waiter that was killed
            elif mark.strip() == gui_token:
                return name
    return None


def take_gui(wait_s: float, capacity_dir: Path, state_dir: Path, recycle: str | None = None,
             busy: re.Pattern[str] = XCTEST_RUNNING, gui_token: str = "gui") -> int:
    """glaeda-canonical-root take-gui: hold this mini's gui token (one console session) for the rest of this
    job, waiting up to wait_s. A job that already holds it (from admission) is a no-op. Exits 0 when held, 1
    when still taken after the wait, TAKE_GUI_GAVE_WAY when the holder waits for a root this job holds (see
    TAKE_GUI_GAVE_WAY: the caller then leaves its console-session work to another job) or when the console session
    is locked or has no user (console_refusal), 2 outside a job.
    With `recycle` (the testmanagerd program), a newly taken token also restarts testmanagerd for its tests."""
    if not os.environ.get("RUNNER_NAME"):
        print(f"{PREFIX}: take-gui: RUNNER_NAME is not set (not a runner job step)", file=sys.stderr)
        return 2
    if gui_file(state_dir).exists():
        return 0
    worker = runner_worker_pid()
    if worker is None:
        print(f"{PREFIX}: take-gui: not inside a runner job (no Runner.Worker above this step)", file=sys.stderr)
        return 2
    locked = console_refusal()
    if locked:  # the console session cannot run the tests: leave them to a job on another mini
        print(f"{PREFIX}: take-gui: {locked}", file=sys.stderr)
        return TAKE_GUI_GAVE_WAY
    stopped = yield_idle_fuzz(capacity_dir)  # the console session is this job's from here on
    if stopped:
        print(f"{PREFIX}: take-gui: {stopped[2:]}", file=sys.stderr)
    deadline = time.monotonic() + max(0.0, wait_s)
    while True:
        fd = lock_file(capacity_dir / f"{gui_token}.token", fcntl.LOCK_EX)
        if fd is None and time.monotonic() >= deadline:
            fd = retake(capacity_dir / f"{gui_token}.token")  # a listener gate's probe holds it for microseconds
        if fd is not None:
            break
        held: list[str] = []
        with contextlib.suppress(OSError):
            held = roots_file(state_dir).read_text().split()
        wanted = gui_holder_wants(capacity_dir, held, gui_token)
        if wanted:
            print(f"{PREFIX}: take-gui: the gui token's holder is waiting for {wanted}, which this job holds; "
                  "giving way", file=sys.stderr)
            return TAKE_GUI_GAVE_WAY
        if time.monotonic() >= deadline:
            print(f"{PREFIX}: take-gui: the gui token is still taken after {wait_s:g} s", file=sys.stderr)
            return 1
        time.sleep(TAKE_ROOT_POLL_S)
    main = holder_file(state_dir)
    ok, note = hold([fd], worker, state_dir, pid_file=main.with_name(f"{main.stem}-gui.pid"))
    if not ok:
        print(f"{PREFIX}: take-gui: {note}", file=sys.stderr)
        return 1
    try:
        gui_file(state_dir).write_text("gui\n")
    except OSError as error:  # unrecorded, a re-take would wait on itself and markers would miss it
        release_holder(main.with_name(f"{main.stem}-gui.pid"))
        print(f"{PREFIX}: take-gui: cannot record the gui token ({type(error).__name__})", file=sys.stderr)
        return 1
    if recycle:  # stdout stays empty for callers; a stuck daemon is only reported here, the tests will show it
        print(f"{PREFIX}: take-gui: {recycle_testmanagerd(recycle, busy)}", file=sys.stderr)
    return 0


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def process_identity(pid: int) -> str | None:
    """Return a process start token so a reused PID cannot keep a job holder alive."""
    if pid <= 1:
        return None
    proc = Path(f"/proc/{pid}/stat")
    try:
        fields = proc.read_text(encoding="ascii").rsplit(")", 1)[1].split()
        if len(fields) > 19:
            return "proc:" + fields[19]
    except (OSError, UnicodeDecodeError, IndexError):
        pass
    try:
        result = subprocess.run(["/bin/ps", "-o", "lstart=", "-p", str(pid)],
                                stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    token = result.stdout.strip()
    return "ps:" + token if result.returncode == 0 and token else None


def process_alive(pid: int, identity: str) -> bool:
    """Require both liveness and the same process instance, not just the numeric PID."""
    return pid_alive(pid) and process_identity(pid) == identity


OWNER_GONE = "the job's Runner.Worker is gone"


class JobOwner(NamedTuple):
    """The process a job's holds belong to, pinned once by pid and start token.

    job-started pins its Runner.Worker when it starts and every hold, sampler and watchdog of that job watches
    this one handle. Asking os.getppid() again later is wrong: once the Worker exits (a cancelled job, a runner
    crash) the hook is reparented to launchd, and PID 1 is never a job. A hold for an owner that is gone is not a
    refusal of a live job: there is nothing to admit, so the hook lets go of what it waited for and exits."""
    pid: int
    identity: str

    @classmethod
    def of(cls, pid: int) -> JobOwner | None:
        """The owner for a live pid, or None for PID 0/1 (launchd: never a job) or a pid with no start token."""
        identity = process_identity(pid) if pid > 1 else None
        return cls(pid, identity) if identity else None

    def alive(self) -> bool:
        return process_alive(self.pid, self.identity)

    def gone(self) -> bool:
        """Proven gone: the pid is free, or it now names another process. An unreadable start token (a /bin/ps
        timeout) is unknown, not gone, so a live job is never given up on a transient probe failure."""
        if not pid_alive(self.pid):
            return True
        current = process_identity(self.pid)
        return current is not None and current != self.identity


def job_owner(explicit: int = 0) -> JobOwner | None:
    """Pin this hook's job owner: the --watch-pid it was given, else the parent it starts under (the wrapper execs
    the hook, so that is the job's Runner.Worker), else the Runner.Worker above it. None once the parent is
    launchd and no Worker is left above it."""
    if explicit:
        return JobOwner.of(explicit)
    return JobOwner.of(os.getppid()) or JobOwner.of(runner_worker_pid() or 0)


# Idle catch-up (glaeda-idle-warm): while a mini is idle and a root's kept build is far from main, it holds that
# root's token, a persistent-dd token and a compile's units (flocks under the capacity dir, like a job) and builds
# main's head into the root's kept state. Any job comes first. take_capacity stops it and waits for its locks to
# go before it takes its own; the listener gate counts what it holds as free, never counts it as a fleet build
# waiting for the host, and stops it instead of holding a runner off for load or heat. So a mini never stops
# listening or refuses a job because of it. It names its pid (the leader of the process group its build runs in)
# and locks in WARM_HOLDER, written under admission.lock before that lock is released, so an admission that holds
# admission.lock always sees it.
WARM_HOLDER = "idle-warm.json"
WARM_PROGRAM = "glaeda-idle-warm"
WARM_YIELD_S = 5.0
# The idle UI fuzzer (glaeda-idle-warm --fuzz) runs beside compiles at low priority and holds no capacity unit
# or token, so a compile's admission leaves it alone. It drives the console session, so every job that takes the
# gui token (at admission or with take-gui) stops it first, the way admission stops a catch-up: it names its pid
# in FUZZ_HOLDER, and yield_idle_fuzz sends SIGTERM and waits for it and its app to go.
FUZZ_HOLDER = "idle-fuzz.json"


def is_idle_warm(command: str) -> bool:
    """Whether a ps command line is glaeda-idle-warm itself (the program or the script its interpreter runs)."""
    return any(os.path.basename(word) == WARM_PROGRAM for word in command.split()[:2])


def warm_holder(capacity_dir: Path, name: str = WARM_HOLDER) -> tuple[int, set[str]] | None:
    """The idle catch-up (or fuzzer, NAME) holder file's pid and lock names, or None when there is none that parses."""
    raw = read_bounded(capacity_dir / name)
    holder = json.loads(raw.decode("utf-8")) if raw is not None else None
    pid = holder.get("pid") if isinstance(holder, dict) else None
    held = holder.get("held") if isinstance(holder, dict) else None
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1 or not isinstance(held, list):
        return None
    return pid, {str(name) for name in held if isinstance(name, str)}


def idle_warm(capacity_dir: Path, name: str = WARM_HOLDER) -> tuple[int, set[str]] | None:
    """The running idle catch-up's pid and the lock names it holds (unit-N, root-K, persistent-dd...), or None.
    With NAME FUZZ_HOLDER, the running idle fuzzer's pid (it holds no locks).

    The file is written by a process of this user, so it is read bounded and trusted only as far as its pid is
    alive and is glaeda-idle-warm: a stale file whose pid was reused never gets another process signalled."""
    try:
        holder = warm_holder(capacity_dir, name)
        if holder is None or holder[0] == os.getpid() or not pid_alive(holder[0]):
            return None
        command = subprocess.run(["/bin/ps", "-o", "command=", "-p", str(holder[0])], capture_output=True,
                                 text=True, timeout=5).stdout
        # The two lanes are one program: the fuzz lane runs with --fuzz, the catch-up without. A stale holder whose
        # pid now belongs to the other lane is not this holder.
        if not is_idle_warm(command) or ("--fuzz" in command.split()) != (name == FUZZ_HOLDER):
            return None
        return holder
    except Exception:  # noqa: BLE001 - a holder file must never refuse or fail a job
        return None


def kill_warm_group(pid: int) -> None:
    """SIGKILL what is left of the catch-up's process group (its build) the moment its leader PID, which we
    just saw alive as glaeda-idle-warm, is gone: no other group can have that id while its build lives. A
    catch-up that dies any other way is a LaunchAgent, and launchd kills its process group."""
    with contextlib.suppress(OSError):
        os.killpg(pid, signal.SIGKILL)


def yield_idle_fuzz(capacity_dir: Path) -> str:
    """Stop a running idle fuzzer (and its app) before this job takes the gui token; a note, or ''."""
    return yield_idle_warm(capacity_dir, FUZZ_HOLDER)


def yield_idle_warm(capacity_dir: Path, name: str = WARM_HOLDER) -> str:
    """Stop a running idle catch-up so this job gets its locks; a note for the admission line, or ''."""
    what = "idle fuzzer" if name == FUZZ_HOLDER else "idle catch-up"
    try:
        warm = idle_warm(capacity_dir, name)
        if warm is None:
            return ""
        pid = warm[0]
        deadline = time.monotonic() + WARM_YIELD_S
        for signum in (signal.SIGTERM, signal.SIGKILL):
            with contextlib.suppress(OSError):
                os.kill(pid, signum)
            while pid_alive(pid) and time.monotonic() < deadline:
                time.sleep(0.02)
            if not pid_alive(pid):
                kill_warm_group(pid)
                return f"; stopped the {what} (pid {pid})"
            deadline = time.monotonic() + 2.0
        return f"; the {what} (pid {pid}) did not stop"
    except Exception:  # noqa: BLE001 - yielding must never refuse or fail a job
        return ""


def holder_file(state_dir: Path, runner: str | None = None) -> Path:
    """One pid file per runner (RUNNER_NAME comes from the runner, not the job; the listener gate, which has none,
    passes its runner's name)."""
    name = "".join(c for c in (os.environ.get("RUNNER_NAME", "") if runner is None else runner)
                   if c.isalnum() or c in "-_.")
    return state_dir / (f"{HOLDER_FILE}-{name}.pid" if name else f"{HOLDER_FILE}.pid")


# A fleet build that yields the host to runner jobs (cmuxterm-hq catch-up/fill-main.py, the fleet-cas main fill
# on the writer mini) writes its pid to <host lock>.yield while it waits for or holds the host lock. The gate
# then keeps listening through it, and a job that meets it preempts it instead of being refused: the hook
# writes <host lock>.preempted, sends the pid SIGTERM (the fill stops its build and releases the lock) and
# waits up to PREEMPT_WAIT_S for the lock. A fresh DerivedData seed saves more PR compile time than one more
# main fill, which the next quiet tick redoes from the compile cache (cmux#14792 follow-up). The marker is
# only a hint: the pid must be alive for the gate, and must hold or wait on the lock (lsof) to be signalled.
YIELD_SUFFIX = ".yield"
PREEMPTED_SUFFIX = ".preempted"
PREEMPT_WAIT_S = 90.0
# Under the admission lock the wait must end well before another admission gives up (ADMISSION_WAIT_S). A fill
# that has not let go by then is still dying; the next job gets the host.
PREEMPT_ADMISSION_WAIT_S = ADMISSION_WAIT_S / 2


def yielding_pid(host_lock: str) -> int | None:
    """The live pid <host_lock>.yield names, or None. Bounded and untrusted: a regular file of a few bytes."""
    path = host_lock + YIELD_SUFFIX
    try:
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode) or info.st_size > 32:
            return None
        pid = int(Path(path).read_text().strip())
    except (OSError, ValueError):
        return None
    if pid <= 1:
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return pid


def yielding_family(host_lock: str) -> set[int]:
    """The yielding build (yielding_pid) and its descendants and their process groups: the fill passes the lock
    fd to its recipe (a new session), so the recipe, xcodebuild and the compilers all have the lock open too.
    Empty without a live marker; just the pid when ps cannot tell."""
    pid = yielding_pid(host_lock)
    if pid is None:
        return set()
    try:
        listing = subprocess.run(["/bin/ps", "-axo", "pid=,ppid=,pgid="], stdin=subprocess.DEVNULL,
                                 capture_output=True, text=True, timeout=15, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {pid}
    rows = [tuple(map(int, line.split())) for line in listing.splitlines()
            if len(line.split()) == 3 and all(f.isdigit() for f in line.split())]
    family = {pid}
    while True:
        grown = family | {child for child, parent, group in rows if parent in family or group in family - {pid}}
        if grown == family:
            return family
        family = grown


def preemptible_pid(host_lock: str, ours: set[int]) -> int | None:
    """The yielding build (yielding_pid) when it and its own processes (yielding_family) are the only fleet
    processes with host_lock open (lsof), else None. A stale or planted marker never names a process with the
    lock open, and a fill that only waits behind another fleet build (the worker holding the lock) is not what
    keeps the host: neither yields it."""
    family = yielding_family(host_lock)
    if not family:
        return None
    pid = yielding_pid(host_lock)
    others = set(lock_open_pids(host_lock, ours))
    return pid if pid in others and others <= family else None


# The gate polls every GATE_POLL_S; lsof costs about 0.3 s of CPU, so its yielding verdict is kept per marker pid
# for GATE_WAITER_EVERY_S. job-started always asks afresh.
_gate_yield_verdict: dict[tuple[str, int], tuple[float, bool]] = {}


def gate_yields(host_lock: str, ours: set[int]) -> bool:
    pid = yielding_pid(host_lock)
    if pid is None:
        return False
    key, at = (host_lock, pid), time.monotonic()
    seen = _gate_yield_verdict.get(key)
    if seen is None or at - seen[0] >= GATE_WAITER_EVERY_S:
        _gate_yield_verdict.clear()
        seen = _gate_yield_verdict[key] = (at, preemptible_pid(host_lock, ours) == pid)
    return seen[1]


def preempt_yielding(host_lock: str, job: str, ours: set[int]) -> str | None:
    """Stop the yielding fleet build holding host_lock (preemptible_pid) so this job can have the host; a note
    for the log, or None when nothing yields. The note names the pid, so the fill honors only its own."""
    pid = preemptible_pid(host_lock, ours)
    if pid is None:
        return None
    incoming = f"{host_lock}{PREEMPTED_SUFFIX}.{os.getpid()}"
    try:
        Path(incoming).write_text(json.dumps({"by": job[:120], "at": int(time.time()), "pid": pid}) + "\n")
        os.replace(incoming, host_lock + PREEMPTED_SUFFIX)
    except OSError:
        with contextlib.suppress(OSError):
            os.unlink(incoming)
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        return None
    return f"preempted the yielding fleet build (pid {pid})"


def wait_host_shared(fd: int, seconds: float) -> bool:
    """A shared flock on fd, retried for up to `seconds` (after preempt_yielding)."""
    deadline = time.monotonic() + seconds
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return True
        except OSError:
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.5)


def close_all(fds: list[int]) -> None:
    for fd in fds:
        with contextlib.suppress(OSError):
            os.close(fd)


def take_host_lock(path: str, watch_pid: int | JobOwner, state_dir: Path) -> tuple[bool, str]:
    """Take the fleet host lock without waiting and leave it with a detached holder for this job.
    Admitted only once the holder itself reports its pid, so a holder that died never counts."""
    if not os.path.exists(path):
        return True, "no fleet host lock on this machine"
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)  # flock needs no write access
    except OSError as error:
        return False, f"cannot open the fleet host lock ({type(error).__name__})"
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        preempted = preempt_yielding(path, os.environ.get("GITHUB_JOB") or "a job", holder_pids(state_dir))
        deadline = time.monotonic() + PREEMPT_WAIT_S
        while preempted:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                print(f"{PREFIX}: {preempted}", flush=True)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    preempted = None
                else:
                    time.sleep(0.5)
        if not preempted:
            os.close(fd)
            return False, "another build holds the fleet host lock"
    held, note = hold([fd], watch_pid, state_dir)
    return held, (f"holding the fleet host lock for this job ({note})" if held else note)


def lock_file(path: Path, mode: int) -> int | None:
    """An fd holding flock `mode` (with LOCK_NB) on path, created if missing, or None when it is taken."""
    fd = os.open(path, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    try:
        fcntl.flock(fd, mode | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def _blocked_lock_pids(listing: str, pids: set[int]) -> set[int]:
    """Return candidate pids whose kernel wait channel says they are blocked on a file lock.

    lsof reports every process with a descriptor open, including the worker's idle lock keeper and
    an exclusive holder. The wait channel is the observation that distinguishes a blocked LOCK_EX
    call from those processes. Keep this parser pure so the lock protocol is covered with a fake
    process table in tests.
    """
    blocked: set[int] = set()
    for line in listing.splitlines():
        fields = line.split(None, 3)
        if len(fields) < 3 or not fields[0].isdigit():
            continue
        pid, wchan = int(fields[0]), fields[1].lower()
        if pid in pids and any(token in wchan for token in ("lock", "flock", "fcntl")):
            blocked.add(pid)
    return blocked


def _lock_processes(path: str, ours: set[int]) -> tuple[list[int], str]:
    """Return fleet processes with the lock open and their ps observation."""
    try:
        out = subprocess.run([LSOF, "-t", "--", path], stdin=subprocess.DEVNULL, capture_output=True,
                             text=True, timeout=5, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return [], ""
    pids = [int(p) for p in out.split() if p.isdigit() and int(p) not in ours]
    if not pids:
        return [], ""
    # This hook's own processes are never fleet builds: another runner's job-started inside its admission,
    # a holder between its fork and its pid file, or a listener gate probing.
    try:
        # Apple ps accepts keyword=header, but not the BSD/Linux field-width spelling (wchan:32=).
        # Its native wchan column is wide enough to retain the Darwin flock wait prefix (lockf:).
        listing = subprocess.run(["/bin/ps", "-o", "pid=,wchan=,command=", "-p", ",".join(map(str, pids))],
                                 stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=15,
                                 check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return [], ""  # cannot tell a fleet build from our own admission: no waiter, as when lsof cannot tell
    # The idle catch-up holds it shared, like a job, and gives way to any job: not a fleet build either.
    fleet = {int(line.split(None, 1)[0]) for line in listing.splitlines()
             if line.strip() and PREFIX not in line and line.split(None, 1)[0].isdigit()
             and not is_idle_warm(line.split(None, 3)[-1] if len(line.split(None, 3)) > 2 else "")}
    return [pid for pid in pids if pid in fleet], listing  # a pid gone since lsof is not waiting either


def lock_open_pids(path: str, ours: set[int]) -> list[int]:
    """Processes with the host lock open, for the yielding marker's ownership check."""
    return _lock_processes(path, ours)[0]


def registered_lock_waiters(path: str, ours: set[int]) -> set[int]:
    """The fleet's host.lock.waiters protocol, also used by with-host-lock.

    Polling workers refresh their marker within 30 seconds. Blocking wrappers
    keep an unrefreshed marker until their PID exits. Read only: the publisher
    owns cleanup, and stale observations never authorize stopping a process.
    """
    directory = Path(path + ".waiters")
    found: set[int] = set()
    try:
        if directory.is_symlink():
            return found
        now = time.time()
        with os.scandir(directory) as entries:
            for i, entry in enumerate(entries):
                if i >= 1024:  # bound work in this shared directory
                    break
                match = re.fullmatch(r"([1-9][0-9]*)-[A-Za-z0-9._-]+", entry.name)
                if not match:
                    continue
                pid = int(match.group(1))
                if not 1 < pid <= 2147483647 or pid in ours:
                    continue
                try:
                    info = entry.stat(follow_symlinks=False)
                except OSError:
                    continue
                if not stat.S_ISREG(info.st_mode):
                    continue
                if "-refresh-" in entry.name and not 0 <= now - info.st_mtime < 30:
                    continue
                if pid_alive(pid):
                    found.add(pid)
    except OSError:
        pass
    return found


def lock_waiters(path: str, ours: set[int]) -> list[int]:
    """Registered polling waiters and processes actually blocked in LOCK_EX.

    lsof lists any process with the host lock open, so it is only the candidate source. The ps
    wait channel is required to show a lock wait; an idle worker keeper such as /bin/cat and an
    exclusive holder therefore do not count without an explicit live marker.
    Markers remain observable when Darwin's wait channel is unavailable.
    """
    pids, listing = _lock_processes(path, ours)
    blocked = _blocked_lock_pids(listing, set(pids))
    return sorted(blocked | registered_lock_waiters(path, ours))


def holder_pids(state_dir: Path) -> set[int]:
    pids = {os.getpid()}
    for pid_file in state_dir.glob(f"{HOLDER_FILE}*.pid*") if state_dir.is_dir() else []:
        with contextlib.suppress(OSError, ValueError):
            pids.add(int(pid_file.read_text().strip()))
    return pids


def admission_waiters(capacity_dir: Path, skip_pid: int = 0) -> list[dict[str, Any]]:
    """The live jobs waiting for capacity on this mini (CAPACITY_WAIT), oldest first: pid, since (Unix seconds),
    wants (token kinds, and "units" while it lacks units) and who. A marker older than ADMIT_FRESH_S, or whose
    waiter is gone, is removed. Markers are written by jobs on this mini, so they are read as untrusted."""
    waiters: list[dict[str, Any]] = []
    for marker in capacity_dir.glob(f"{ADMIT_WANT}*"):
        if marker.name.endswith(".tmp"):
            continue
        try:
            pid = int(marker.name[len(ADMIT_WANT):])
            fresh = time.time() - marker.stat().st_mtime < ADMIT_FRESH_S
        except (OSError, ValueError):
            continue
        if pid == skip_pid or not 0 < pid < 2 ** 31:  # a pid no process has: never signalled or ranked
            continue
        if not fresh or not pid_alive(pid):
            with contextlib.suppress(OSError):
                marker.unlink()  # a waiter that was killed
            continue
        try:
            data = json.loads(read_bounded(marker) or b"")
            if isinstance(data["since"], bool):
                continue
            since = float(data["since"])
            if not math.isfinite(since):  # an infinite or NaN since would break the one total order
                continue
            wants = [str(kind) for kind in data.get("wants") or [] if isinstance(kind, str)]
        except (OSError, ValueError, TypeError, KeyError, AttributeError, OverflowError):
            continue  # OverflowError: a since too large for a float (an integer past 1e308)
        tier = data.get("tier") if data.get("tier") in (TIER_NIGHTLY, TIER_DEV) else ""
        waiters.append({"pid": pid, "since": since, "wants": wants, "who": str(data.get("who") or "")[:200],
                        "tier": tier})
    return sorted(waiters, key=lambda waiter: (waiter["since"], waiter["pid"]))


def admission_rank(tier: str, since: float, pid: int, now: float) -> tuple[int, float, int]:
    """A waiter's place in the queue (FEED_FIRST): nightly jobs first; then DEV compiles and other jobs that have
    waited FEED_JUMP_S; then the rest; each by arrival. One total order, so no two waiters each wait for the other."""
    if tier == TIER_NIGHTLY:
        return (0, since, pid)
    return (1 if tier == TIER_DEV or now - since >= FEED_JUMP_S else 2, since, pid)


def fair_turn(capacity_dir: Path, needs: set[str], since: float, tier: str = "",
              takes_units: bool = False) -> str | None:
    """Why an admission needing these kinds (tokens and "units") must wait behind a waiter ahead of it, or None.
    Ahead is older, except across tiers (FEED_FIRST, admission_rank). A waiting nightly job also stops every other
    admission that takes a unit (takes_units), one the reserve its own gate holds would cover too."""
    now = time.time()
    mine = admission_rank(tier, since, os.getpid(), now)
    for waiter in admission_waiters(capacity_dir, os.getpid()):
        if admission_rank(waiter["tier"], waiter["since"], waiter["pid"], now) >= mine:
            continue
        shared = needs & set(waiter["wants"])
        if waiter["tier"] == TIER_NIGHTLY and takes_units:  # a later nightly job too: arrival order among them
            shared.add("units")
        if shared:
            who = waiter["who"] or "pid " + str(waiter["pid"])
            if (waiter["since"], waiter["pid"]) > (since, os.getpid()) or waiter["tier"] == TIER_NIGHTLY != tier:
                kind = "a nightly job" if waiter["tier"] == TIER_NIGHTLY else "a DEV compile"
                return f"capacity: {who} is {kind} and goes first here for {', '.join(sorted(shared))}"
            return f"capacity: {who} has waited longer here for {', '.join(sorted(shared))}"
    return None


def job_who() -> str:
    """This job as a waiter marker and the log name it: runner, job id and run."""
    return " ".join(filter(None, (os.environ.get("RUNNER_NAME"), os.environ.get("GITHUB_JOB") or "a job",
                                  f"(run {os.environ['GITHUB_RUN_ID']})" if os.environ.get("GITHUB_RUN_ID") else "")))


def write_want(marker: Path, since: float, wants: list[str], tier: str = "") -> None:
    with contextlib.suppress(OSError):
        tmp = marker.with_name(marker.name + ".tmp")
        want: dict[str, Any] = {"since": since, "wants": wants, "who": job_who()}
        if tier:
            want["tier"] = tier
        tmp.write_text(json.dumps(want) + "\n")
        tmp.replace(marker)


TOKEN_ENV = re.compile(r"(?:^|\s)(RUNNER_NAME|GITHUB_JOB|GITHUB_RUN_ID)=(\S+)")


def token_holders(capacity_dir: Path, wants: list[str], compile_slots: int, roots: int) -> str:
    """Who holds the tokens of these kinds, for a waiting job's log line: "root-1: RUNNER JOB (run N)" per taken
    token, from lsof and the holder's environment (ps -E, this user's own processes); "" when nothing is known."""
    names: list[str] = []
    for kind in wants:
        if kind == "root":
            names += [f"root-{k}" for k in range(1, max(1, roots) + 1)]
        elif kind == "persistent-dd":
            names += ["persistent-dd"] + [f"persistent-dd-{c}" for c in range(1, max(1, compile_slots))]
        elif kind in ("gui", "simulator") or kind in FAST_TOKENS:
            names.append(kind)
    notes = []
    deadline = time.monotonic() + HOLDERS_BUDGET_S
    for name in names:
        path = capacity_dir / f"{name}.token"
        if time.monotonic() >= deadline:
            break
        if probe(path):
            continue
        try:
            pids = subprocess.run([LSOF, "-t", "--", str(path)], stdin=subprocess.DEVNULL, capture_output=True,
                                  text=True, timeout=5, check=False).stdout.split()
            listing = subprocess.run(["/bin/ps", "-E", "-ww", "-o", "command=", "-p", ",".join(pids)],
                                     stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                                     timeout=5, check=False).stdout if pids else ""
        except (OSError, subprocess.SubprocessError):
            continue
        for line in listing.splitlines()[:1]:
            env = dict(TOKEN_ENV.findall(line))
            if "GITHUB_JOB" in env:
                who = f"{env.get('RUNNER_NAME', '?')} {env['GITHUB_JOB']}" + (
                    f" (run {env['GITHUB_RUN_ID']})" if "GITHUB_RUN_ID" in env else "")
            else:
                who = "an idle warm build" if is_idle_warm(line) else os.path.basename(line.split(None, 1)[0])
            notes.append(f"{name}: {who}")
    return "; ".join(notes)


def take_capacity(host_lock: str, capacity_dir: Path, total: int, job: str, watch_pid: int | JobOwner,
                  state_dir: Path, compile_slots: int = 1, roots: int = 1,
                  repo: str | None = DEFAULT_HOME_REPO, home_repo: str = DEFAULT_HOME_REPO,
                  instance: int = 0, workflow: str = "", warm_keys: tuple[str, ...] = (),
                  owned_state_dir: str = "", taken_out: dict[str, Any] | None = None,
                  warm_target: tuple[Any, ...] = ("", None, 0), klass: str | None = None,
                  one_holder: bool = False, since: float | None = None, gui_token: str = "gui",
                  gui_runner: bool = False, fresh_runner: bool = False, tier: str = "") -> tuple[bool, str]:
    """Weighted admission for one of several runners on this mini, without ever waiting on a job.
    When held, taken_out (if given) receives the units and tokens taken, for the job log; on a capacity refusal it
    receives "wants", the kinds a waiter marker names (CAPACITY_WAIT): the token kind or "units" it lacks, else
    every kind it needs (behind another waiter: its class's tokens, and units). since is when this job began to wait (a
    waiter's own tries): it goes ahead of any admission that began later and behind any that began earlier and
    needs a kind it needs (fair_turn); None is a newcomer. tier (job_tier) ranks it across arrival order
    (FEED_FIRST): a nightly job also keeps no idle reserve. klass, when given,
    is the class itself (a ci-step names it, step_admit) instead of one looked up from the job id. one_holder
    refuses, under admission.lock, when this holder file's holder is still alive (a ci-step key admits once).
    Every job but the gui runner's own (gui_runner: job-started --gui-runner) leaves the units idle gui runners
    reserve free (gui_reserved, GUI_RESERVE). The gui runner's job takes them, and one that fits in the reserve its
    gate holds never queues behind another lane's job waiting for units: that job could not have taken the
    reserved unit. A costlier one waits its turn (fair_turn) like any job; its gate keeps the reserve until it is
    admitted (Gate.admitted), so the reserved unit stays out of other lanes' reach meanwhile.
    One detached holder keeps, for the whole job: a shared lock on the fleet host lock (with-host-lock
    takes it exclusively, so the build worker and our jobs exclude each other), `units` unit files and
    the job class's tokens. Everything is a flock, so a holder that dies releases all of it."""
    if klass:  # a class given outright (a ci-step, the fast tier, a console skipper admitted as light) costs its own
        pinned, (units, tokens) = False, CLASS_COST[klass]
    else:
        klass, pinned = job_class(job, repo, home_repo, workflow)
        units, tokens = job_units(klass, job, repo, home_repo, workflow), CLASS_COST[klass][1]
    uses_gui = "gui" in tokens
    if uses_gui:
        tokens = tuple(gui_token if token == "gui" else token for token in tokens)
    units = min(units, total)
    if roots > 1 and klass in ROOT_CONSUMERS:
        # a consumer must use the producer's root, which only its restore step knows: it takes that root
        # itself with glaeda-canonical-root take (take-root below) instead of a token-chosen one here
        tokens = tuple(t for t in tokens if t != "root")
        if klass == "gui-step":  # and the gui token, which its step takes before that root (take-gui)
            tokens = tuple(t for t in tokens if t != gui_token)
    # pinned: home-repo workflows the hook does not know use /private/tmp/cmux-ci itself
    try:
        capacity_dir.mkdir(parents=True, exist_ok=True)
        admission = os.open(capacity_dir / "admission.lock", os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    except OSError as error:
        return False, f"cannot open the capacity ledger ({type(error).__name__})"
    fds: list[int] = []
    try:
        deadline = time.monotonic() + ADMISSION_WAIT_S
        while True:
            try:
                fcntl.flock(admission, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    return False, "capacity: another admission on this mini is stuck"
                time.sleep(0.1)
        if one_holder and holder_alive(holder_file(state_dir)):
            return False, f"{job or 'this job'} is already admitted"
        if taken_out is not None:
            taken_out["wants"] = list(tokens)
        # the gui runner's job that fits in the reserve its gate holds takes the reserved unit, which no waiter here
        # could take
        own_reserve = gui_token if gui_runner else FRESH_RESERVE_TOKEN if fresh_runner else None
        in_reserve = (own_reserve is not None and 0 < units <= reserve_units(f"{own_reserve}{GUI_RESERVE}")
                      and not probe(capacity_dir / f"{own_reserve}{GUI_RESERVE}"))
        needs = {*tokens, *(("units",) if units and not in_reserve else ())}
        behind = fair_turn(capacity_dir, needs, time.time() if since is None else since, tier, units > 0)
        if behind:
            # a waiter behind another names every kind it needs, units too: a newcomer that fits must not take the
            # units it waits for in the poll between the waiter ahead being admitted and this one's next try
            if taken_out is not None:
                taken_out["wants"] = sorted(needs)
            return False, behind
        yielded = yield_idle_warm(capacity_dir)  # under admission.lock, so a catch-up cannot start meanwhile
        if uses_gui:  # this job will drive the console session: the idle fuzzer's app must be gone first
            yielded += yield_idle_fuzz(capacity_dir)
        if os.path.isdir(os.path.dirname(host_lock)):
            # created if missing, so a worker that starts later still has to wait for this job
            fd = os.open(host_lock, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW, 0o660)
            for attempt in range(6):  # a fleet probe takes it exclusively for microseconds; a build keeps it
                try:
                    fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                    break
                except OSError:
                    if attempt == 5:
                        preempted = preempt_yielding(host_lock, job or "a job", holder_pids(state_dir))
                        if preempted is None or not wait_host_shared(fd, PREEMPT_ADMISSION_WAIT_S):
                            os.close(fd)
                            return False, ("capacity: a fleet build holds the host lock"
                                           + (f" ({preempted}, still held after {PREEMPT_ADMISSION_WAIT_S:g} s)"
                                              if preempted else ""))
                        print(f"{PREFIX}: {preempted}", flush=True)
                        break
                    time.sleep(0.1)
            fds.append(fd)
            waiting = bounded_waiters(state_dir, lock_waiters(host_lock, holder_pids(state_dir) | yielding_family(host_lock)),
                                      log=lambda note: print(f"{PREFIX}: {note}", flush=True))
            # lsof sees only this user's processes, which is how the fleet worker runs today.
            if waiting:  # flock has no writer preference: stop admitting so the build worker gets in
                # This must not be a retryable capacity refusal: a draining fleet
                # worker waits for our parent Runner.Worker to exit before claiming.
                return False, f"a fleet build is waiting for the host (pid {waiting[0]})"
        taken: list[str] = []
        named: dict[str, int] = {}
        warm_for = warm_note = ""
        warm_route: dict[str, Any] = {}
        for token in tokens:
            # persistent-dd comes in compile_slots copies once compile admission keeps its state per
            # runner; copy 0 keeps the original file name. A mini whose runners disagree on the count runs
            # as many compiles as the highest one allows, so re-apply every instance on a mini together.
            copies = {"persistent-dd": max(1, compile_slots), "root": 1 if pinned else max(1, roots)}.get(token, 1)
            order = list(range(copies))
            if token == "root" and copies > 1 and klass != "compile-gui":
                # this runner's own root first (instance i -> root i+1), then any free one: its kept build and
                # warm labels (cmux#14396) stay with one tree unless a consumer holds that root. compile-gui
                # keeps no per-root state, and seed and cache keys at another root differ from root 1's
                # (compile-app-host-test-product.sh fingerprint), so it tries root 1 first and falls back
                own = instance % copies
                order = [own, *(c for c in order if c != own)]
                if job in WARM_JOBS:
                    ranked, predicted = warm_root_costs(order, warm_target[0], warm_target[1], owned_state_dir,
                                                        job_files=warm_target[2] if len(warm_target) > 2 else 0)
                    if ranked:
                        order, warm_route = ranked, {"predicted": predicted, "own": f"root-{own + 1}"}
                    else:
                        order, warm_for = warm_root_order(order, warm_keys, owned_state_dir)
            for copy in order:
                # root tokens are named for the root they hold: root-1 is /private/tmp/cmux-ci
                name = f"root-{copy + 1}" if token == "root" else token if copy == 0 else f"{token}-{copy}"
                fd = lock_file(capacity_dir / f"{name}.token", fcntl.LOCK_EX)
                if fd is not None:
                    fds.append(fd)
                    taken.append(name)
                    named[name] = fd
                    if token == "root" and warm_for and warm_for in root_warm_keys(copy + 1, owned_state_dir):
                        warm_note = f", warm for {warm_for}"
                    if token == "root" and warm_route:
                        warm_route["chosen"] = name
                        guess = warm_route["predicted"].get(name) or {}
                        warm_note = f", predicted {guess.get('seconds')} s {guess.get('tier')}"
                    break
            else:
                what = "canonical root" if token == "root" else token
                held = f"all {copies} {what} tokens are taken" if copies > 1 else f"the {what} token is taken"
                if taken_out is not None:
                    taken_out["wants"] = [token]
                return False, f"capacity: {held} ({job or 'unknown job'} is {klass})"
        # every job but a reserving runner's own leaves the idle reserves free (GUI_RESERVE, FRESH_RESERVE_TOKEN); a
        # nightly job keeps none (FEED_FIRST)
        def kept_now() -> int:
            return 0 if tier == TIER_NIGHTLY else reserve_for(gui_reserved(capacity_dir, own_reserve), units, total)

        kept = kept_now()
        lent: int | None = None
        if own_reserve is not None and units > 0:
            # the reserving runner's own job: its holder lends the reserve (RESERVE_LENT) for as long as it lives. Taken
            # before the units and let go before them (hold's close_first), so the lend never outlives the job's units.
            # The previous job's holder may still be letting go: wait for it briefly. One not taken leaves the reserve
            # counted beside this job, which keeps more units from the other lanes, never fewer.
            lend_until = time.monotonic() + LEND_WAIT_S
            while (lent := lock_file(lent_file(capacity_dir / f"{own_reserve}{GUI_RESERVE}"), fcntl.LOCK_EX)) is None \
                    and time.monotonic() < lend_until:
                time.sleep(0.1)
            if lent is not None:
                fds.append(lent)
        got = spare = 0
        unit_fds: list[int] = []
        for slot in range(total):
            fd = lock_file(capacity_dir / f"unit-{slot}", fcntl.LOCK_EX)
            if fd is None:
                continue
            if got < units:
                fds.append(fd)
                unit_fds.append(fd)
                got += 1
            else:  # free beside this job's units: one the reserve keeps (under admission.lock, so it stays free)
                os.close(fd)
                spare += 1
        # a lend that ended during the scan (its holder let the job's units go) makes the reserve whole again: the
        # larger of the two looks, so units freed by that holder are never counted as spare beside a kept-at-0 reserve
        kept = max(kept, kept_now())
        if got < units or spare < kept:
            if taken_out is not None:
                taken_out["wants"] = ["units"]
            return False, (f"capacity: {got + spare} of {total} units free, {job or 'an unknown job'} ({klass}) "
                           f"needs {units}{kept_note(kept)}")
        root = next((name for name in taken if name.startswith("root-")), None)
        split = named[root] if root and klass in ROOT_SWITCHERS else None
        if split is not None:  # its own holder (ROOT_SWITCHERS); the main holder must not inherit it
            fds.remove(split)
        # a lent reserve covers the job's whole admission: its units are never released early (the sampler's
        # dynamic release), else the reserve would stay lent while the units it stands for went to other jobs
        held, note = hold(fds, watch_pid, state_dir, drop=(admission,) if split is None else (admission, split),
                          release_fds=[] if own_reserve is not None and units > 0 else unit_fds,
                          close_first=(lent,) if lent is not None else ())
        fds = [] if split is None else [split]  # the holder has them now, or hold closed them
        if held and split is not None:
            held, why = hold(fds, watch_pid, state_dir, drop=(admission,), pid_file=root_holder_file(state_dir, root),
                             release_fds=[split])
            fds = []
            if not held:
                release_holder(holder_file(state_dir))
                note = why
        what = "+".join([f"{units}/{total} units", *taken]) + warm_note
        if held and taken_out is not None:
            taken_out.update(units=units, units_total=total, tokens=list(taken))
        if held and gui_token in taken:
            with contextlib.suppress(OSError):
                gui_file(state_dir).write_text("gui\n")
        if held and root:
            note += f"; {export_root(root)}"
            export_warm_route(warm_route)
            with contextlib.suppress(OSError):
                roots_file(state_dir).write_text(root + "\n")
        return held, (f"holding {what} for {job or 'an unknown job'} ({klass}; {note}{yielded})" if held else note)
    except OSError as error:
        return False, f"capacity: cannot take the ledger ({type(error).__name__})"
    finally:
        close_all(fds)
        os.close(admission)


def hold(fds: list[int], watch: int | JobOwner, state_dir: Path, drop: tuple[int, ...] = (),
         pid_file: Path | None = None, release_fds: list[int] | None = None,
         close_first: tuple[int, ...] = ()) -> tuple[bool, str]:
    """Hand the locked fds to a detached holder that keeps them until job-completed or the job's owner exits.
    watch is the owner job-started pinned (JobOwner), or a pid a step resolved just now (take-root, take-gui).
    Closes this process's copies either way. The holder closes `drop` (locks that must not outlive the
    admission). Succeeds only once the holder reports its own pid. pid_file defaults to the runner's
    holder file; take-root passes its own so a second holder for the same job lives beside it. close_first (fds
    among fds) are let go before every other lock when the holder ends (the reserve's lend, RESERVE_LENT, so no
    reader sees the job's units free while the reserve still counts as lent)."""
    owner = watch if isinstance(watch, JobOwner) else JobOwner.of(watch)
    if owner is None:
        close_all(fds)
        return False, f"the watched process {watch} has no stable identity"
    if owner.gone():  # nothing to hold for: the locks go back now, never to a holder watching nobody
        close_all(fds)
        return False, f"{OWNER_GONE} (pid {owner.pid})"
    watch_pid, watch_identity = owner.pid, owner.identity
    try:
        state_dir.mkdir(parents=True, exist_ok=True)
        pid_file = pid_file or holder_file(state_dir)
        pid_file.unlink(missing_ok=True)  # a stale file from a crashed holder must not look like success
        release_file = pid_file.with_name(pid_file.name + ".release")
        release_file.unlink(missing_ok=True)
    except OSError as error:
        close_all(fds)
        return False, f"cannot prepare the lock holder ({type(error).__name__})"
    try:
        ready_r, ready_w = os.pipe()
    except OSError as error:
        close_all(fds)
        return False, f"cannot start the lock holder ({type(error).__name__})"
    try:
        child = os.fork()
    except OSError as error:
        close_all([*fds, ready_r, ready_w])
        return False, f"cannot start the lock holder ({type(error).__name__})"
    if child == 0:  # detach twice so the runner never waits on the holder
        try:
            close_all([ready_r, *drop])
            os.setsid()
            if os.fork():
                os._exit(0)
            null = os.open(os.devnull, os.O_RDWR)
            for std in (0, 1, 2):  # the runner reads the hook's output until EOF
                os.dup2(null, std)
            me = str(os.getpid())
            releasing = pid_file.with_name(pid_file.name + RELEASING)
            pid_file.write_text(me + "\n")
            os.write(ready_w, me.encode())
            os.close(ready_w)
            deadline = time.monotonic() + HOLDER_MAX_S
            while process_alive(watch_pid, watch_identity) and time.monotonic() < deadline:
                try:
                    if pid_file.read_text().strip() != me:
                        break  # job-completed released it
                except OSError:
                    break
                if release_fds:
                    try:
                        request = json.loads(release_file.read_text())
                        if request.get("release_all"):
                            close_all(release_fds)
                            release_fds.clear()
                        else:
                            keep = max(1, min(len(release_fds), int(request.get("keep_units", len(release_fds)))))
                            if keep < len(release_fds):
                                close_all(release_fds[keep:])
                                del release_fds[keep:]
                        if not release_fds or request.get("release_all"):
                            release_file.unlink(missing_ok=True)
                    except (OSError, ValueError, TypeError, json.JSONDecodeError):
                        pass
                time.sleep(HOLDER_POLL_S)
        finally:
            close_all(list(close_first))
            for leftover in ("releasing", "pid_file"):  # still ours: released, or the job died first
                with contextlib.suppress(Exception):
                    path = releasing if leftover == "releasing" else pid_file
                    if path.read_text().strip() == me:
                        path.unlink()
            os._exit(0)  # the locks go with this process
    os.close(ready_w)
    os.waitpid(child, 0)
    close_all(fds)  # the holder keeps the same open files, so the locks stay held while it lives
    ready, _, _ = select.select([ready_r], [], [], 10)
    reported = os.read(ready_r, 32).decode().strip() if ready else ""
    os.close(ready_r)
    if not reported.isdigit() or not pid_alive(int(reported)):
        return False, "the lock holder did not start; refusing rather than run unlocked"
    return True, f"holder {reported}, watching pid {watch_pid}"


def roots_file(state_dir: Path) -> Path:
    """The canonical roots this runner's job holds (root-k per line), so take-root knows a re-take is a no-op."""
    main = holder_file(state_dir)
    return main.with_name(main.stem + ".roots")


def gui_file(state_dir: Path) -> Path:
    """Present while this runner's job holds the gui token (from admission or take-gui)."""
    main = holder_file(state_dir)
    return main.with_name(main.stem + ".gui")


def root_holder_file(state_dir: Path, name: str) -> Path:
    main = holder_file(state_dir)
    return main.with_name(f"{main.stem}-{name}.pid")


def release_host_lock(state_dir: Path) -> str:
    """job-completed: tell this job's holders to let go (the admission holder and any take-root holders),
    and wait briefly for them."""
    roots_file(state_dir).unlink(missing_ok=True)
    gui_file(state_dir).unlink(missing_ok=True)
    main = holder_file(state_dir)
    main.with_name(main.name + ".release").unlink(missing_ok=True)
    for release in state_dir.glob(f"{main.stem}-root-*.pid.release"):
        release.unlink(missing_ok=True)
    extra = [release_holder(path) for path in sorted(state_dir.glob(f"{main.stem}-root-*.pid"))]
    gui = [release_holder(path) for path in state_dir.glob(f"{main.stem}-gui.pid")]
    note = release_holder(main)
    return (note + (f"; {len(extra)} canonical root holder(s) released" if extra else "")
            + ("; the gui token holder released" if gui else ""))


def release_holder(pid_file: Path) -> str:
    try:
        pid = int(pid_file.read_text().strip())
    except (OSError, ValueError):
        return "no host lock holder to release"
    try:  # the holder sees its file gone and exits; the renamed copy keeps it known until it has
        pid_file.replace(pid_file.with_name(pid_file.name + RELEASING))
    except OSError:
        pid_file.unlink(missing_ok=True)
    deadline = time.monotonic() + HOLDER_POLL_S * 3
    while pid_alive(pid) and time.monotonic() < deadline:
        time.sleep(0.1)
    return "released the fleet host lock" if not pid_alive(pid) else f"holder {pid} still exiting"


# ---------------------------------------------------------------- ci-step admission (cmuxterm-hq#794)
# The build worker (cmuxterm-hq build-fleet/cmd/worker) runs CI steps the controller hands it (ci-step jobs) and
# admits each one through this same ledger, so a mini claims only work that fits and a capacity refusal never
# reaches GitHub. `fits` tells the worker which step classes this mini could admit right now, for its heartbeat;
# the controller leases a ci-step only to a worker whose heartbeat lists its class. `admit` then takes the class's
# units and tokens for real, without waiting, and leaves them with a detached holder (hold) that watches the
# worker's pid; `release` lets them go when the step ends. A step's holder is keyed by its job key, as a runner
# job's is by RUNNER_NAME, so several steps hold at once beside the runners' jobs.
# Steps take no canonical root, persistent-dd or gui token yet: those classes carry per-job setup that job-started
# does (settle_root, testmanagerd, the console check) and move behind admit with the compile phase. No simulator
# either: the worker is a system LaunchDaemon, outside the console user's CoreSimulator service.
STEP_CLASSES = ("light", "isolated")
STEP_KEY = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,119}")
STEP_ADMISSION = "glaeda-ci-step-admission/v1"
STEP_FITS = "glaeda-ci-step-fits/v1"
STEP_FITS_WAIT_S = 1.0  # an admission holds admission.lock for milliseconds; past this the answer is unknown


def step_runner_name(key: str) -> str:
    """The RUNNER_NAME a ci-step's holder files are keyed by (holder_file), apart from every runner's. A digest of
    the key, fixed length and hex, so release_host_lock's `<holder>-root-*` and `<holder>-gui` globs for one key
    can never match another key's files, whatever the keys contain."""
    return "ci-step-" + hashlib.sha256(key.encode()).hexdigest()[:24]


def step_refusal(home: Path | None = None) -> str | None:
    """Why this mini takes no ci-step of any class whatever its capacity: a fleet build node (a --require-eligible
    runner here) whose Rust toolchain is missing (toolchain_missing). fits then advertises nothing, so the controller
    leases no step here and the worker's heartbeat shows why (`refusal`), and admit refuses. Steps the controller
    leased to a mini that could not run cargo failed in seconds and were leased to it again."""
    return fleet_toolchain_missing(home)


def step_fits(capacity_dir: Path, total: int, compile_slots: int, roots: int, host_lock: str, reservation: str,
              state_dir: Path, now: float) -> list[str] | Unknown:
    """The STEP_CLASSES this mini could admit right now, or UNKNOWN when an admission held admission.lock
    throughout. The listener gate's probe (mini_full): the host is not the fleet's (host_held) and no fleet
    build waits for it (host_waiters, which admission refuses for too, so a worker never leases a step it
    would hand back), and under
    admission.lock, held without waiting so no admission meets a unit the probe holds, enough unit files and one
    free copy of each token are free (an idle catch-up's locks count as free: it yields them to the next job), and
    no job admitted here waits for units or one of those tokens (CAPACITY_WAIT: it goes first). The units an idle gui
    runner reserves (GUI_RESERVE) are not free to a step."""
    if total <= 0 or host_held(host_lock, reservation, now, state_dir) or host_waiters(host_lock, state_dir):
        return []
    try:
        admission: int | None = os.open(capacity_dir / "admission.lock", os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        admission = None  # no admission has run on this mini yet, so nothing is taken
    try:
        deadline = time.monotonic() + STEP_FITS_WAIT_S
        while admission is not None:
            try:
                fcntl.flock(admission, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    return UNKNOWN
                time.sleep(0.05)
        warm = idle_warm(capacity_dir)
        yielding = warm[1] if warm else set()

        def free(name: str) -> bool:
            return name in yielding or probe(capacity_dir / name)

        units = sum(1 for slot in range(total) if free(f"unit-{slot}"))
        reserved = gui_reserved(capacity_dir)  # a step is never the gui runner's job: it leaves the reserve free
        waited = set()
        for waiter in admission_waiters(capacity_dir):
            waited |= set(waiter["wants"]) | ({"units"} if waiter["tier"] == TIER_NIGHTLY else set())  # FEED_FIRST
        fits = []
        for klass in STEP_CLASSES:
            need, tokens = CLASS_COST[klass]
            need = min(need, total)
            if units < need + reserve_for(reserved, need, total) or waited & {*tokens, "units"}:  # fair_turn
                continue
            copies = {"persistent-dd": max(1, compile_slots), "root": max(1, roots)}
            if all(any(free((f"root-{c + 1}" if token == "root" else token if c == 0 else f"{token}-{c}")
                            + ".token") for c in range(copies.get(token, 1))) for token in tokens):
                fits.append(klass)
        return fits
    finally:
        if admission is not None:
            os.close(admission)


def step_admit(klass: str, key: str, watch_pid: int, host_lock: str, reservation: str, capacity_dir: Path,
               total: int, state_dir: Path, compile_slots: int = 1, roots: int = 1) -> tuple[int, dict[str, Any]]:
    """Admit one ci-step now or refuse it, never waiting for room. (exit status, typed result): 0 and the units and
    tokens its holder keeps, or 1 and the reason. RUNNER_NAME must already be step_runner_name(key)."""
    result: dict[str, Any] = {"schema": STEP_ADMISSION, "class": klass, "key": key, "admitted": False}

    def refused(why: str) -> tuple[int, dict[str, Any]]:
        result["reason"] = why[:400]
        return 1, result

    if total <= 0:
        return refused("admit needs --capacity-units: this mini has no capacity ledger")
    if watch_pid <= 1 or not pid_alive(watch_pid):
        return refused(f"the watched pid {watch_pid} is not running")
    why = reservation_refusal(reservation, time.time()) or step_refusal()
    if why:
        return refused(why)
    taken: dict[str, Any] = {}
    held, note = take_capacity(host_lock, capacity_dir, total, f"ci-step {key}", watch_pid, state_dir,
                               compile_slots, roots, klass=klass, taken_out=taken, one_holder=True)
    if not held:
        return refused(note)
    holder = holder_file(state_dir)
    with contextlib.suppress(OSError, ValueError):
        result["holder_pid"] = int(holder.read_text().strip())
    result.update(admitted=True, units=taken.get("units"), units_total=taken.get("units_total"),
                  tokens=taken.get("tokens", []), note=note[:400])
    return 0, result


# ---------------------------------------------------------------- listener gate


class Unknown(str):
    """mini_full's answer when it could not look (an admission held admission.lock): keep the last answer."""


UNKNOWN = Unknown("unknown")


def runner_units(runner_dir: Path) -> int:
    """The --capacity-units this runner's job-started hook passes (take_capacity's total), or 0 for a
    single-runner mini or an unreadable hook. Read on every probe, so a re-apply that changes it counts at once."""
    return runner_scope(runner_dir).units


class RunnerScope(NamedTuple):
    """What this runner's job-started hook admits with: its --capacity-units, --compile-slots and
    --canonical-roots, whether it is a root runner (instance below canonical roots, glaeda-cmux-runner),
    whether it is the mini's gui runner (--gui-runner, the gui pool label; never a root runner), its
    --min-free-gib disk floor (0: none), its gui token, whether it is the mini's fast runner (--fast-runner,
    the fast pool label; never a root or gui runner), and whether it is one of the mini's session runners
    (--session-runner, only the session pool label; never a root, gui or fast runner), and whether it is the
    freshness slot (--dev-compile-runner: the DEV compile runner, which holds FRESH_RESERVE while idle)."""
    units: int = 0
    compile_slots: int = 1
    roots: int = 1
    root: bool = False
    gui: bool = False
    min_free_gib: float = 0.0
    gui_token: str = "gui"
    fast: bool = False
    session: bool = False
    fresh: bool = False


def reserve_token(scope: RunnerScope | None) -> str | None:
    """The token whose <token>.reserve this runner's gate holds while idle, and its own job may take: a gui
    runner's gui token, the freshness slot's FRESH_RESERVE_TOKEN, else None (it reserves nothing)."""
    if scope is None:
        return None
    return scope.gui_token if scope.gui else FRESH_RESERVE_TOKEN if scope.fresh else None


def listen_fit_units(runner_dir: Path) -> int:
    """The --fit-units the runner's current listen.sh passes, or 1. A gate started from an older listen.sh keeps
    its argv across hook reloads, so it reads this on every probe: an --apply that adds the flag counts at once,
    without restarting a runner that may be running a job."""
    try:
        match = re.search(r"\s--fit-units\s+([0-9]+)(?:\s|$)", (runner_dir / LISTEN_SCRIPT).read_text())
    except (OSError, UnicodeDecodeError):
        return 1
    return int(match.group(1)) if match else 1


def runner_scope(runner_dir: Path) -> RunnerScope:
    """RunnerScope from the hook script glaeda-cmux-runner wrote. The hook passes --instance; the directory's
    -K suffix (actions-runner-glaeda-K) is the fallback for hooks written before it always did."""
    try:
        text = (runner_dir / RUNNER_HOOK_SCRIPT).read_text()
    except (OSError, UnicodeDecodeError):
        return RunnerScope()

    def flag(name: str, default: int) -> int:
        match = re.search(rf"\s--{name}\s+([0-9]+)(?:\s|$)", text)
        return int(match.group(1)) if match else default

    suffix = re.search(r"-([0-9]+)$", runner_dir.name)
    instance = flag("instance", int(suffix.group(1)) if suffix else 0)
    roots = max(1, flag("canonical-roots", 1))
    fast = re.search(r"\s--fast-runner(?:\s|$)", text) is not None
    session = re.search(r"\s--session-runner(?:\s|$)", text) is not None and not fast
    gui = re.search(r"\s--gui-runner(?:\s|$)", text) is not None and not fast and not session
    fresh = re.search(r"\s--dev-compile-runner(?:\s|$)", text) is not None and not fast and not session and not gui
    gui_match = re.search(r"\s--gui-token\s+([A-Za-z0-9._-]+)(?:\s|$)", text)
    gui_token = gui_match.group(1) if gui_match else "gui"
    return RunnerScope(flag("capacity-units", 0), max(1, flag("compile-slots", 1)), roots,
                       instance < roots and not gui and not fast and not session, gui,
                       runner_floor_gib(min_free_gib(text), gui or session), gui_token,
                       fast, session, fresh)


def eligibility_scope(runner_dir: Path) -> tuple[str, str | None] | None:
    """(--fleet-class, --toolchain-xcode or None) when this runner's job-started hook runs with --require-eligible,
    else None (its jobs are not refused for eligibility, so the gate never holds it for that)."""
    try:
        text = (runner_dir / RUNNER_HOOK_SCRIPT).read_text()
    except (OSError, UnicodeDecodeError):
        return None
    line = next((ln for ln in text.splitlines() if ln.startswith("exec ")), "")
    try:
        words = shlex.split(line)  # the wrapper shlex.quotes its paths
    except ValueError:
        return None

    def value(flag: str) -> str | None:
        return words[words.index(flag) + 1] if flag in words[:-1] else None

    klass = value("--fleet-class")
    if "--require-eligible" not in words or not klass:
        return None
    return klass, value("--toolchain-xcode")


def eligibility_refusal(fleet_class: str, xcode_app: str | None) -> str | None:
    """What job-started would refuse every job with for eligibility (the read-only `check`), or None."""
    why, want = node_refusal(fleet_class)
    if not why:
        why, _ = toolchain_refusal(fleet_class, want, xcode_app, align=False)
    return why


def runner_floor_gib(min_free_gib: float, takes_tours: bool) -> float:
    """A runner's disk floor: its --min-free-gib, raised to a cmux-next tour's floor on a gui or session runner. A
    runner with no floor (0) keeps none: only the fleet's wrappers pass one, and a fleet runner is the one tours reach."""
    if takes_tours and min_free_gib > 0:
        return max(min_free_gib, float(CMUX_TOUR_REQUIREMENTS["min_free_gib"]))
    return min_free_gib


def min_free_gib(text: str) -> float:
    """The last unquoted --min-free-gib in a job-started hook script, as glaeda-cmux-runner writes it (:g, so 1e+03
    is a valid form), or 0 without one or when it is not a finite number. glaeda-disk's runner_floor_gib reads the
    same pattern (MIN_FREE_GIB_RE there; a test keeps the two equal)."""
    values = re.findall(MIN_FREE_GIB_RE, text)
    try:
        value = float(values[-1]) if values else 0.0
    except ValueError:
        return 0.0
    return value if math.isfinite(value) and value > 0 else 0.0


MIN_FREE_GIB_RE = r"\s--min-free-gib[\s=]+([0-9.eE+-]+)(?=\s|$)"
# The free space a cmux-next tour needs: manaflow-ai/cmux scripts/cmux-next/tour-requirements.json, vendored as is at
# CMUX_TOUR_REQUIREMENTS_PIN (reload.sh reads its floor from that file). The gui and session runners take tours, so
# the hook holds them to at least this whatever --min-free-gib their wrapper passes: with the fleet floor alone, a
# runner took tours reload.sh then refused, and since the hook applies it, glaeda-update's hook refresh rolls it out
# without re-applying a runner. CI's glaeda-cmux-tour-floor-check fails when cmux's file says otherwise: vendor it and
# move the pin to the cmux commit that changed it.
CMUX_TOUR_REQUIREMENTS = {"min_free_gib": 40}
CMUX_TOUR_REQUIREMENTS_PIN = "becb28033f69367e00aec1a1bd23737a1cd74968"


# A root runner's jobs (compile admission, app-host shards, cli-product, lag) cost up to this many units, and
# the costliest takes a persistent-dd and a root token, and a shard the gui token (CLASS_COST).
ROOT_FIT_UNITS = max(CLASS_COST[k][0] for k in ("compile", "gui", "product", "compile-gui", "gui-step"))


def mini_full(capacity_dir: Path | None, total: int, scope: RunnerScope | None = None,
              fit_units: int = 1) -> str | None:
    """Why none of this runner's `total` capacity units is free, or None, or UNKNOWN when it could not look.
    A job handed to a full mini is refused at once, and cmux's rescue re-runs it on Blacksmith along with the
    siblings fail-fast cancelled (cmux main full suite 36114055694: three shards refused with 0 of 4 units
    free, and the re-run waited 30 to 40 minutes for Blacksmith 12 vCPU runners). A full mini that stops
    listening leaves the job queued for the next free runner instead. `total` is what this runner's own
    admissions try (take_capacity scans unit-0 up to it), so full here means this runner's next job would be
    refused. The probe holds admission.lock without waiting for it, so no admission can find a unit taken by
    the probe; while an admission holds it the answer is UNKNOWN. take-root and take-gui take their tokens
    without admission.lock, so a try that meets the probe's microsecond hold retries once (retake).

    With the scope of a root runner (scope.root), full also means this mini cannot admit every job the root
    label brings: fewer than ROOT_FIT_UNITS units free, or every persistent-dd token or every canonical root
    taken. GitHub hands a root label's job to any idle root runner, so a root runner listening on a mini with
    one unit left took compiles it then refused (90 of about 400 refusals on 2026-09-25). Each refusal costs a
    rescue round trip and, after two, a Blacksmith run. Held off, the job goes to a mini that fits it, or waits
    in GitHub's queue for this one (hq#661 Workstream 7). The gui token is not a reason to hold: a compile
    needs none, and holding the root runner for it kept a mini's second root idle while roots were the fleet's
    bottleneck (09-25 22:30Z: 18 of 18 roots busy, 5 held off). A shard that meets a taken gui token waits for
    it (CAPACITY_WAIT) instead of refusing.

    With the scope of a gui runner (scope.gui, the gui pool label: app-host shards, tests-build-and-lag,
    app-host-test-rerun), full also means the gui token is taken (test-e2e's take-gui, or a GUI job that reached a
    root runner) or every canonical root is: a GUI job takes the producer's root in its restore step and would
    wait there holding the gui token. Held off, GitHub hands the job to another mini's gui runner. Only this
    runner carries the label, so holding it never keeps a compile off the mini.

    With the scope of a session runner (scope.session, guiRunners above 1: the gui runners other than the console
    one carry only the session pool label), full means only that units are taken or a job here waits for units
    (Gate.locked also holds it while the console is locked). Its jobs (cmux-next daemon tests, generated files,
    action exports, the tour) need a logged-in session but neither the gui token nor a canonical root, so a console
    job's token is no reason to hold it, and no console job reaches it: the gui label it lacks is the console
    runner's alone. It listens only with room for the costliest of them (--fit-units, SESSION_FIT_UNITS in
    glaeda-cmux-runner), so a job it takes never waits here for units while another mini has room.

    Full also means a job admitted to this mini is waiting (CAPACITY_WAIT, its admit.want marker) for units or
    for a token this runner's next job would take (a root runner: a canonical root or persistent-dd; a gui
    runner: the gui token or a root). That job goes first, so a job this runner took now would only queue behind
    it here, while GitHub could hand it to a mini with room. A waiting nightly job (FEED_FIRST) holds every such
    runner, the gui runner and the freshness slot too: no admission of another tier takes a unit while it waits.

    With the scope of a fast runner (scope.fast, the fast pool label: cmux-next's fast-tier), full means only that a
    fast token is taken or a job here waits for one: its job takes the fast tokens and none of the shared units,
    so a mini whose units the side lane fills still takes it. Every other scope ignores the fast tokens.

    The gui runner's reserve (GUI_RESERVE): while an idle gui runner's gate holds it, every other scope counts
    GUI_RESERVE_UNITS fewer units free (but never so many that its next job could not fit the mini at all), so a
    root, side or session runner that would take the gui runner's unit stops listening first. The gui runner counts
    its reserve as its own, and a job waiting here for units is no reason to hold it: a job that fits in the
    reserve takes the reserved unit, which that waiter could not have taken, and a costlier one waits its turn
    here instead of in GitHub's queue (take_capacity)."""
    if capacity_dir is None or total <= 0:
        return None
    try:
        admission = os.open(capacity_dir / "admission.lock", os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None  # no admission has run on this mini yet, so no unit is taken
    try:
        try:
            fcntl.flock(admission, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return UNKNOWN
        warm = idle_warm(capacity_dir)
        yielding = warm[1] if warm else set()  # the idle catch-up gives these to the next job

        def open_to_jobs(name: str, path: Path) -> bool:
            return name in yielding or probe(path)

        if scope is not None and scope.fast:
            for waiter in admission_waiters(capacity_dir):
                shared = set(FAST_TOKENS) & set(waiter["wants"])
                if shared:
                    return f"{waiter['who'] or 'a job'} waits here for {', '.join(sorted(shared))}"
            for name in FAST_TOKENS:
                if not probe(capacity_dir / f"{name}.token"):
                    return f"the {name} token is taken"
            return None
        root = scope is not None and scope.root
        # fit_units: a side runner whose label brings costlier jobs (listen --fit-units: glaeda-ios-sim's isolated
        # builds, a session runner's jobs)
        # The freshness slot listens only with room for its costliest job (FRESH_RESERVE_UNITS): its reserve keeps
        # that room from the other lanes, so a feed compile it takes never waits here for units.
        fresh = scope is not None and scope.fresh
        need = min(max(ROOT_FIT_UNITS if root else FRESH_RESERVE_UNITS if fresh else 1, fit_units), total)
        gui = scope is not None and scope.gui
        # every runner leaves the idle reserving runners' reserves free (GUI_RESERVE, FRESH_RESERVE_TOKEN); a
        # reserving runner's own reserve is its next job's
        kept = reserve_for(gui_reserved(capacity_dir, reserve_token(scope)), need, total)
        free = 0
        for slot in range(total):
            if not open_to_jobs(f"unit-{slot}", capacity_dir / f"unit-{slot}"):
                continue
            free += 1
            if free >= need + kept:
                break
        if free == 0:
            return f"all {total} {UNITS_FULL} are taken"
        if free < need + kept:
            return (f"only {free} of {total} {UNITS_FULL} are free; "
                    f"{'a compile' if root else 'its next job'} needs {need}{kept_note(kept)}")
        # a job already here waits for what this runner's next job would take (CAPACITY_WAIT): it goes first. Not
        # for units on the gui runner or the freshness slot: its next job takes the reserved units, which the waiter
        # could not have taken
        compete = ({"units"} if not gui and not fresh else set()) | ({"root", "persistent-dd"} if root else set()) | (
            {scope.gui_token, "root"} if gui else set())
        for waiter in admission_waiters(capacity_dir):
            shared = compete & set(waiter["wants"])
            if waiter["tier"] == TIER_NIGHTLY:  # no other job takes a unit while a nightly job waits (FEED_FIRST)
                shared.add("units")
            if shared:
                return f"{waiter['who'] or 'a job'} waits here for {', '.join(sorted(shared))}"
        if scope is not None and scope.session:
            return None
        if scope is not None and scope.gui:
            if not probe(capacity_dir / f"{scope.gui_token}.token"):
                return "the gui token is taken"
            if not any(probe(capacity_dir / f"root-{k}.token") for k in range(1, scope.roots + 1)):
                return ("the canonical root is taken" if scope.roots == 1
                        else f"all {scope.roots} canonical roots on this mini are taken")
            return None
        if not root:
            return None
        assert scope is not None
        dd = ["persistent-dd"] + [f"persistent-dd-{c}" for c in range(1, scope.compile_slots)]
        if not any(open_to_jobs(name, capacity_dir / f"{name}.token") for name in dd):
            return ("the persistent-dd token is taken" if len(dd) == 1
                    else f"all {len(dd)} persistent-dd tokens on this mini are taken")
        if not any(open_to_jobs(f"root-{k}", capacity_dir / f"root-{k}.token") for k in range(1, scope.roots + 1)):
            return ("the canonical root is taken" if scope.roots == 1
                    else f"all {scope.roots} canonical roots on this mini are taken")
        return None
    finally:
        os.close(admission)


def probe(path: Path) -> bool:
    """Whether the flock at path is free right now: taken and given back at once. A file that cannot be
    opened counts as free (the admission that needs it creates it, as lock_file does)."""
    try:
        fd = lock_file(path, fcntl.LOCK_EX)
    except OSError:
        return True
    if fd is None:
        return False
    os.close(fd)
    return True


def thermal_pressure_level() -> int | None:
    """macOS thermal pressure (0 nominal to 4 sleeping), or None when it cannot be read."""
    try:
        out = subprocess.run([NOTIFYUTIL, "-g", THERMAL_PRESSURE_KEY], stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=5, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    found = re.search(re.escape(THERMAL_PRESSURE_KEY) + r"\s+(\d+)", out)
    return int(found.group(1)) if found else None


class ConsoleState(NamedTuple):
    """The console session as ioreg reports it: "unlocked", "locked" or "no_user", and its user name."""
    state: str
    user: str | None = None


def parse_console_users(text: str) -> ConsoleState | None:
    """ConsoleState from `ioreg -n Root -d1` text output, or None when it names neither IOConsoleUsers nor
    IOConsoleLocked (not the Root entry). A session counts only while on the console with its login done; none
    (or no IOConsoleUsers at all, as at the login window) is no_user. Locked is the session's
    CGSSessionScreenIsLocked or Root's IOConsoleLocked."""
    rows = text.splitlines()
    users = next((row for row in rows if '"IOConsoleUsers" =' in row), None)
    console_locked = next((row for row in rows if '"IOConsoleLocked" =' in row), None)
    if users is None and console_locked is None:
        return None
    for session in re.findall(r"\{([^{}]*)\}", users or ""):
        def value(key: str) -> str | None:
            found = re.search(rf'"{key}"=("[^"]*"|[^,]*)', session)
            return found.group(1).strip('"') if found else None

        if value("kCGSSessionOnConsoleKey") != "Yes" or value("kCGSessionLoginDoneKey") == "No":
            continue
        user = value("kCGSSessionUserNameKey")
        if not user or user == "loginwindow":
            continue
        locked = value("CGSSessionScreenIsLocked") == "Yes" or (console_locked or "").rstrip().endswith("= Yes")
        return ConsoleState("locked" if locked else "unlocked", user[:64])
    return ConsoleState("no_user")


def console_state() -> ConsoleState | None:
    """This mini's console session, or None when ioreg cannot be read."""
    try:
        out = subprocess.run([IOREG, "-n", "Root", "-d1"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                             timeout=5, check=False).stdout
    except (OSError, subprocess.TimeoutExpired, UnicodeDecodeError):
        return None
    return parse_console_users(out)


def console_refusal() -> str | None:
    """Why GUI tests cannot run in this mini's console session right now, or None (also when it is unreadable or
    the check is off)."""
    if not CONSOLE_GATE:
        return None
    state = console_state()
    if state is None or state.state == "unlocked":
        return None
    if state.state == "locked":
        return (f"console: the console session ({state.user}) is screen-locked, so GUI tests cannot run on this "
                "mini; unlock it and turn off the screen lock (cmuxterm-hq#757)")
    return "console: no user is logged in at the console, so GUI tests cannot run on this mini (cmuxterm-hq#757)"


def mini_saturated(paused: bool, load: float | None = None, cores: int | None = None) -> str | None:
    """Why this mini is too loaded to take another job, or None: its 1-minute load is at least GATE_LOAD_PAUSE per
    core, or, once `paused` for that, still at least GATE_LOAD_RESUME per core (the gap keeps a listener from
    flapping). The text is stable, so a held gate logs it once. An unreadable load never saturates."""
    try:
        load = os.getloadavg()[0] if load is None else load
    except OSError:
        return None
    cores = (os.cpu_count() or 0) if cores is None else cores
    if cores <= 0:
        return None
    limit = GATE_LOAD_RESUME if paused else GATE_LOAD_PAUSE
    if load < limit * cores:
        return None
    return (f"{SATURATED} (1-minute load at least {GATE_LOAD_PAUSE:g} per core on {cores} cores; "
            f"listening resumes below {GATE_LOAD_RESUME:g})")


def host_saturated(paused: bool, cpu_busy: float | None = None, memory_pressure: int | None = None) -> str | None:
    """Why the listener should pause from measured host pressure, or None when it has headroom.

    CPU busy is iostat's one-second sample; memory pressure 2 (elevated) or 4 (critical) is a separate
    admission brake. Missing samples fail open so a broken probe never strands a runner.
    """
    memory_hot = memory_pressure is not None and memory_pressure >= GATE_MEMORY_PRESSURE_HOLD
    if cpu_busy is None and not memory_hot:
        return None
    if paused:
        cpu_hot = cpu_busy is not None and cpu_busy >= GATE_CPU_RESUME
    else:
        cpu_hot = cpu_busy is not None and cpu_busy >= GATE_CPU_PAUSE
    if not cpu_hot and not memory_hot:
        return None
    reasons = []
    if cpu_hot:
        limit = GATE_CPU_RESUME if paused else GATE_CPU_PAUSE
        reasons.append(f"CPU busy at least {limit:g}%")
    if memory_hot:
        reasons.append(f"memory pressure level {memory_pressure}")
    return f"{SATURATED} ({' and '.join(reasons)}; listening resumes below {GATE_CPU_RESUME:g}% CPU and normal memory pressure)"


def host_held(host_lock: str, reservation: str, now: float, state_dir: Path | None = None) -> str | None:
    """Why the fleet, not a PR job, holds this host right now, or None. Our own jobs hold the host lock
    shared, so only an exclusive holder or a reservation counts. Microseconds: one non-blocking flock."""
    why = reservation_refusal(reservation, now)
    if why or not os.path.exists(host_lock):
        return why
    try:
        fd = os.open(host_lock, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None  # job-started decides what an unreadable lock means
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        # A yielding build gives way to the next job: keep listening through it. lsof only while a marker is
        # up (a fill on the writer mini), to tell it from another fleet build it is waiting behind.
        if gate_yields(host_lock, holder_pids(state_dir) if state_dir else set()):
            return None
        return "a fleet build holds the host lock"
    finally:
        os.close(fd)  # drops the probe's shared lock too
    return None


def host_waiters(host_lock: str, state_dir: Path) -> set[int]:
    """Fleet builds waiting for the host lock that the gate still yields to (bounded_waiters). lsof costs about
    0.3 s of CPU on a mini, so the gate asks at most every GATE_WAITER_EVERY_S, and a stop needs the same pid in
    two readings."""
    if not os.path.exists(host_lock):
        return set()
    return set(bounded_waiters(state_dir, lock_waiters(host_lock, holder_pids(state_dir) | yielding_family(host_lock)),
                               log=gate_log))


def bounded_waiters(state_dir: Path, waiting: list[int] | set[int], now: float | None = None,
                    log: Callable[[str], None] | None = None,
                    identity: Callable[[int], str | None] | None = None) -> list[int]:
    """The waiters still owed a yield. Each waiter's wait span is kept in WAITER_SPANS_FILE, updated under its
    flock so every runner's gate and job-started agree on it. A span is keyed by pid and process start
    (process_identity), so a reused pid starts its own, and a reboot leaves no span to match. Times are
    time.monotonic (system-wide, immune to wall clock steps), read once the lock is held; a reading a little behind a
    span's last sighting (a caller's own `now`) neither ends the span nor moves its sighting back. A span starts when a
    waiter is first seen and ends when it is not seen for GATE_WAITER_GAP_S. Within it the waiter is honoured for
    GATE_WAITER_MAX_HOLD_S, then ignored for GATE_WAITER_WAIVE_S, and so on; the first reading that ignores it in a
    cycle logs why, after the record holds that. A record that cannot be locked, read or written honours every
    waiter, as before the bound."""
    waiting = sorted(set(waiting))
    if not waiting:
        return []
    identity = identity or process_identity
    path = state_dir / WAITER_SPANS_FILE
    try:
        state_dir.mkdir(parents=True, exist_ok=True)
        fd = os.open(path.with_suffix(".lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return waiting
    try:
        deadline = time.monotonic() + WAITER_SPANS_LOCK_S
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    return waiting
                time.sleep(0.05)
        now = time.monotonic() if now is None else now  # after the lock: no reader writes an older sighting
        try:
            record = json.loads(path.read_text())
            spans = record if isinstance(record, dict) else {}
        except (FileNotFoundError, ValueError):
            spans = {}  # none yet, or torn by a crash between write and replace: rewritten below
        except OSError:
            return waiting
        kept: dict[str, dict[str, Any]] = {}
        for key, span in spans.items():  # spans of waiters this reading missed, still within the gap
            if isinstance(span, dict) and all(isinstance(span.get(k), (int, float)) for k in ("since", "seen")) \
                    and span["since"] <= span["seen"] and abs(now - span["seen"]) < GATE_WAITER_GAP_S:
                kept[key] = span
        owed: list[int] = []
        notes: list[str] = []
        cycle = GATE_WAITER_MAX_HOLD_S + GATE_WAITER_WAIVE_S
        for pid in waiting:
            who = identity(pid)
            if who is None:  # gone, or unreadable: honour it, and keep no span a reused pid could inherit
                owed.append(pid)
                continue
            key = f"{pid}:{who}"
            span = kept.get(key) or {"since": now}
            span["seen"] = max(span["seen"], now) if "seen" in span else now
            kept[key] = span
            waited = max(0.0, now - span["since"])
            if GATE_WAITER_MAX_HOLD_S <= 0 or cycle <= 0 or waited % cycle < GATE_WAITER_MAX_HOLD_S:
                owed.append(pid)
                continue
            turn = int(waited // cycle)
            if span.get("noted") != turn:
                span["noted"] = turn
                notes.append(f"a fleet build (pid {pid}) has waited for the host for {waited / 60:.0f} min without "
                             f"getting it: listening anyway for up to {GATE_WAITER_WAIVE_S / 60:g} min (look at what "
                             "the fleet handed this host)")
        try:
            tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
            tmp.write_text(json.dumps(kept, sort_keys=True))
            os.replace(tmp, path)
        except OSError:
            return waiting
    finally:
        os.close(fd)
    if log is not None:
        for note in notes:
            log(note)
    return sorted(owed)


def processes() -> dict[int, tuple[int, str]]:
    """pid -> (ppid, command) for every process this user can see."""
    out = subprocess.run(["/bin/ps", "-axo", "pid=,ppid=,command="], stdin=subprocess.DEVNULL,
                         capture_output=True, text=True, timeout=30, check=True).stdout
    table: dict[int, tuple[int, str]] = {}
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            table[int(parts[0])] = (int(parts[1]), parts[2] if len(parts) > 2 else "")
    return table


def descendants(root: int, table: dict[int, tuple[int, str]]) -> list[int]:
    """root's descendants, children before their own children."""
    found, frontier = [], [root]
    while frontier:
        parent = frontier.pop(0)
        kids = [pid for pid, (ppid, _) in table.items() if ppid == parent and pid not in found]
        found += kids
        frontier += kids
    return found


def gate_log(message: str) -> None:
    """One gate line, stamped like the runner's own lines (`2026-09-25 23:31:11Z: ...`): the runner log keeps
    weeks of gate lines, and unstamped ones read as current (09-25: thermal holds from before a 13:10Z reboot
    were taken for live ones at 23:00Z). Readers match the text after the stamp (glaeda-cmux-runner GATE_HELD)."""
    print(f"{time.strftime('%Y-%m-%d %H:%M:%SZ', time.gmtime())}: {GATE}: {message}", flush=True)


class Adopted:
    """The runner's run.sh after the gate re-exec'd itself: still this process's child, so waitpid works."""

    def __init__(self, pid: int) -> None:
        self.pid, self.returncode = pid, None

    def poll(self) -> int | None:
        if self.returncode is None:
            try:
                pid, status = os.waitpid(self.pid, os.WNOHANG)
            except ChildProcessError:  # not our child: never report a clean exit launchd would not restart
                self.returncode = 1
                return 1
            if pid:
                self.returncode = os.waitstatus_to_exitcode(status)
        return self.returncode

    def wait(self) -> int:
        while self.poll() is None:
            time.sleep(0.5)
        return self.returncode or 0


def source_identity() -> tuple[int, int, int] | None:
    try:
        st = os.stat(__file__)
    except OSError:
        return None
    return st.st_ino, st.st_mtime_ns, st.st_size


# The listener's own trace of taking a job (actions/runner src/Runner.Listener/Runner.cs and JobDispatcher.cs,
# v2.337.0). A broker job message is acknowledged, then acquired (POST acquirejob), then dispatched to a
# Runner.Worker. Before the acknowledge the broker redelivers an unacknowledged message to another runner; after it
# the job is this runner's, and a listener stopped before its acquirejob completes never runs it: GitHub fails it
# 10 min later with "The self-hosted runner lost communication with the server" (mini-5, 2026-09-28 13:53:03Z,
# https://github.com/manaflow-ai/cmux/pull/15160). A restarted listener gets a new session and never sees that
# request again, so nothing recovers the job; the stop has to wait. The trace is flushed line by line, and the
# acknowledge line is written before its request is sent.
RUNNER_DIAG_TAIL = 1 << 20  # bytes of the newest Runner_*.log read; an acquisition's retries write about 50 KiB
LISTENER_TAKES = re.compile(r"Acknowledging runner request '([^']+)'|"
                            r"JobDispatcher\] Job request \S+ for plan \S+ job (\S+) received\.")
LISTENER_DONE = ("Skipping message Job.", "Caught exception from acquiring job message",
                 "JobDispatcher] Worker finished for job", "JobDispatcher] finish job request for job",
                 # every other dispatcher exit (cancelled before or while the Worker starts, a lost first renew)
                 "JobDispatcher] Stop renew job request for job", "JobDispatcher] Unable to renew job request for job",
                 "Runner execution has finished")


def runner_worker(runner_dir: Path, command: str, program: str = "Worker") -> bool:
    """command is a Runner.<program> of the runner in runner_dir: bin/Runner.Worker, or bin.<version>/Runner.Worker
    once the runner updated itself (its listener spawns the Worker by the resolved path)."""
    return re.search(r"(?:^|\s)" + re.escape(os.fspath(runner_dir)) + r"/bin(?:\.[^/\s]+)?/Runner\." +
                     re.escape(program) + r"(?:\s|$)", command) is not None


def runner_has_job(runner_dir: Path, commands: list[str]) -> bool:
    """The runner in runner_dir has a job, given every process's command line: a Runner.Worker of it, or a
    request its live listener took and has not finished (listener_request). A request in the diag of a listener
    that is gone is no job: nothing can run it, and it would hold the runner busy for good. An unreadable diag
    raises (callers count that as busy)."""
    if any(runner_worker(runner_dir, command) for command in commands):
        return True
    listening = any(runner_worker(runner_dir, command, "Listener") for command in commands)
    return listening and listener_request(runner_dir) is not None


def runner_busy_now(runner_dir: Path) -> bool:
    """runner_has_job from a fresh, untruncated process table. Anything that cannot be read counts as busy: a
    deferred stop is retried, a cancelled job is lost."""
    try:
        out = subprocess.run(["/bin/ps", "-axww", "-o", "command="], stdin=subprocess.DEVNULL, capture_output=True,
                             text=True, timeout=60, check=True).stdout
        return runner_has_job(runner_dir, out.splitlines())
    except Exception:  # noqa: BLE001
        return True


def runner_busy_main(argv: list[str]) -> int:
    """`busy --runner-dir D` for shell: exit 3 only when that runner is idle, so a crash (1) or an older hook without
    this phase (2) never reads as idle; 0 when it has a job or this cannot tell."""
    return 0 if len(argv) != 1 or runner_busy_now(Path(argv[0])) else 3


def listener_request(runner_dir: Path) -> str | None:
    """The runner request the listener has acknowledged or dispatched and not yet finished, from the tail of the
    newest _diag/Runner_*.log (a listener writes a new one each start; Worker_*.log files are jobs' own), or None.
    From the acknowledge until its Worker finishes the job is this runner's: a stop in that span loses it."""
    diag = runner_dir / "_diag"
    try:
        names = sorted(n for n in os.listdir(diag) if n.startswith("Runner_") and n.endswith(".log"))
    except FileNotFoundError:
        return None
    if not names:
        return None
    with open(diag / names[-1], "rb") as file:
        size = os.fstat(file.fileno()).st_size
        file.seek(max(0, size - RUNNER_DIAG_TAIL))
        text = file.read().decode("utf-8", "replace")
    request = None
    for line in text.splitlines():
        taken = LISTENER_TAKES.search(line)
        if taken:
            request = taken.group(1) or taken.group(2)
        elif request is not None and any(done in line for done in LISTENER_DONE):
            request = None
    return request


# A runner GitHub removed (an org deletes a runner that has not connected for a while, so a listener the gate held
# off long enough loses it) exits at once on every start: "The runner registration has been deleted from the
# server, please re-configure", "Registration was not found" in _diag. Restarting it cannot help (2026-10-24: 36
# runners looped about 33k times each), and the mini holds no admin token to re-register itself. So the gate
# records the cause in registration-<runner dir>.json in the state dir (glaeda-mini-health reports it, an
# operator-side reconciler re-registers from it) and tries again only every GATE_REGISTRATION_RETRY_S, or at once
# when the runner is re-configured (.runner changes). A listener that stays up GATE_REGISTRATION_OK_S clears it.
REGISTRATION_SCHEMA = "glaeda-runner-registration/v1"
REGISTRATION_DELETED = "registration_deleted"
REGISTRATION_EVIDENCE = ("The runner registration has been deleted from the server", "Registration was not found")
GATE_REGISTRATION_RETRY_S = float(os.environ.get("GLAEDA_RUNNER_GATE_REGISTRATION_RETRY_S") or 600.0)
GATE_REGISTRATION_OK_S = float(os.environ.get("GLAEDA_RUNNER_GATE_REGISTRATION_OK_S") or 120.0)
REGISTRATION_TAIL = 64 * 1024  # the listener writes the error as it exits: it is in the last lines


def registration_file(state_dir: Path, runner_dir: Path) -> Path:
    return state_dir / f"registration-{runner_dir.name}.json"


def runner_config(runner_dir: Path) -> tuple[str | None, float | None]:
    """(the registered runner name, .runner's mtime): config.sh rewrites .runner when it re-registers."""
    path = runner_dir / ".runner"
    try:
        mtime = path.stat().st_mtime
        name = json.loads(path.read_text(encoding="utf-8-sig")).get("agentName")
    except (OSError, ValueError, AttributeError):
        return None, None
    return (name if isinstance(name, str) else None), mtime


def registration_deleted(runner_dir: Path, since: float) -> str | None:
    """The evidence line when the newest _diag/Runner_*.log written since `since` (wall clock) says GitHub deleted
    this runner's registration, else None."""
    diag = runner_dir / "_diag"
    try:
        logs = sorted(n for n in os.listdir(diag) if n.startswith("Runner_") and n.endswith(".log"))
        if not logs or (diag / logs[-1]).stat().st_mtime < since - 5:
            return None
        with open(diag / logs[-1], "rb") as file:
            file.seek(max(0, os.fstat(file.fileno()).st_size - REGISTRATION_TAIL))
            text = file.read().decode("utf-8", "replace")
    except OSError:
        return None
    return next((e for e in REGISTRATION_EVIDENCE if e in text), None)


def read_registration(state_dir: Path, runner_dir: Path) -> dict[str, Any] | None:
    try:
        doc = json.loads(registration_file(state_dir, runner_dir).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) and doc.get("cause") == REGISTRATION_DELETED else None


def note_registration_deleted(state_dir: Path, runner_dir: Path, evidence: str, now: float) -> dict[str, Any]:
    """Write (atomically) and return the registration record, counting this exit."""
    before = read_registration(state_dir, runner_dir) or {}
    name, mtime = runner_config(runner_dir)
    doc = {"schema": REGISTRATION_SCHEMA, "cause": REGISTRATION_DELETED, "runner": name,
           "runner_dir": os.fspath(runner_dir), "evidence": evidence,
           "first_seen": before.get("first_seen") or int(now), "last_seen": int(now),
           "exits": int(before.get("exits") or 0) + 1, "retry_after": int(now + GATE_REGISTRATION_RETRY_S),
           "runner_mtime": mtime}
    path = registration_file(state_dir, runner_dir)
    with contextlib.suppress(OSError):
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name(path.name + f".{os.getpid()}")
        tmp.write_text(json.dumps(doc, separators=(",", ":"), sort_keys=True) + "\n", encoding="utf-8")
        os.replace(tmp, path)
    return doc


GATE_DISK_RESUME_GIB = 2.0  # a disk hold ends only this far above the floor
GATE_DISK_NOTE_S = 30 * 60  # two evictions that did not end the hold
GATE_DISK_EVICT_EVERY_S = 15 * 60  # an eviction that left the disk short is retried this often, not every poll


class Gate:
    """run.sh under the listener gate. The whole runner tree (run.sh, run-helper.sh, Runner.Listener and a
    job's Runner.Worker) stays in the gate's process group, so launchd's group cleanup still covers it. A
    runner with a job, or taking one, is never stopped (stop()). Anything unexpected hands the runner back to plain
    run.sh behaviour (unexpected())."""

    def __init__(self, runner_dir: Path, host_lock: str, reservation: str, state_dir: Path,
                 waiters: bool = True, capacity_dir: Path | None = None, fit_units: int = 1) -> None:
        self.runner_dir, self.host_lock, self.reservation, self.state_dir, self.waiters = \
            runner_dir, host_lock, reservation, state_dir, waiters
        self.capacity_dir = capacity_dir
        self.fit_units = fit_units
        self.full_why: str | None = None  # the last known mini_full answer, kept across UNKNOWN looks
        self.child: subprocess.Popen[bytes] | None = None
        self.stop_deadline: float | None = None  # set while a stop the gate asked for is under way
        self.streak = 0
        self.held: str | None = None
        self.free_since: float | None = None  # the first free poll of the current free span
        self.stopped_one = False  # the gate stopped a listener and has not started one since (GATE_RESTART_FREE_S)
        self.terminating = False
        self.waiting: set[int] = set()
        self.job_waited = False  # a fleet build was waiting, or the host was reserved, at the last poll of a job
        self.waiting_at = -GATE_WAITER_EVERY_S
        self.worker_noted = False
        self.defer_noted = False  # stop() said once that it kept a listener taking a job
        self.source = source_identity()
        self.thermal: int | None = None  # the level while the gate holds for heat, else None
        self.thermal_at = -GATE_THERMAL_EVERY_S
        self.load_since: float | None = None  # when the current CPU/memory hold began (legacy field name)
        self.load_waived = False  # a pressure hold ran past GATE_LOAD_MAX_HOLD_S; ignored until pressure falls
        self.cpu_busy: float | None = None
        self.cpu_at = -GATE_CPU_EVERY_S
        self.memory_pressure: int | None = None
        self.memory_at = -GATE_CPU_EVERY_S
        self.console_why: str | None = None  # the last console_refusal, read at most every GATE_CONSOLE_EVERY_S
        self.console_at = -GATE_CONSOLE_EVERY_S
        self.eligible_why: str | None = os.environ.pop(GATE_INELIGIBLE_ENV, None) or None  # the held answer
        if self.eligible_why and TOOLCHAIN_MISSING in self.eligible_why:
            self.eligible_why = None  # never carried across a reload: the per-poll check reads it afresh
        self.eligible_new: str | None = None  # a first refusal, held only once a recheck agrees
        self.missing_why: str | None = None  # the last toolchain_missing answer, read every poll
        self.eligible_at = -GATE_ELIGIBLE_EVERY_S
        self.eligible_look: threading.Thread | None = None
        self.stale_env: str | None = None  # why an adopted listener's env is not listener_env's (listen())
        self.disk_since: float | None = None  # when the current disk hold began
        self.disk_noted = False  # the hold ran past GATE_DISK_NOTE_S and said so once
        self.disk_evicted_at = -GATE_DISK_EVICT_EVERY_S  # when the last eviction under the floor started
        # the eviction under way: the detached glaeda-disk, when it started and the free GiB before it
        self.evicting: tuple[subprocess.Popen[bytes], float, float | None] | None = None
        self.watching: tuple[int, ...] = ()
        self.fast_until = 0.0
        self.listening_since: float | None = None  # when start() last started run.sh (GATE_FIRST_POLL_S)
        self.first_poll_noted = False
        self.swept_at = time.monotonic() - GATE_SWEEP_S + GATE_POLL_S  # first sweep on the second poll
        self.reserve_fd: int | None = None  # a gui runner's capacity/<gui token>.reserve flock while it is idle
        self.started_wall = 0.0  # time.time() when start() last started run.sh (registration_deleted's log)
        self.registration = read_registration(state_dir, runner_dir)  # kept across gate restarts: the backoff holds

    def reload(self) -> None:
        """An --apply replaced this hook: re-exec the new one in place, keeping run.sh as our child, so a gate
        fix reaches a running mini without restarting its runner. A new hook that fails to load is skipped."""
        now = source_identity()
        if now is None or now == self.source:
            return
        if self.eligible_look is not None and self.eligible_look.is_alive():
            return  # the next poll: the look thread does not block SIGTERM, and its probes would be orphaned
        self.source = now
        argv = [a for a in sys.argv if not a.startswith("--adopt=")]
        if self.child is not None:
            argv.append(f"--adopt={self.child.pid}")
        # The new hook must load and accept exactly this argv (a hook without --parse-only, such as a
        # rollback to one before the gate, never gets the exec).
        try:
            check = subprocess.run([sys.executable, __file__, *argv[1:], "--parse-only"], stdin=subprocess.DEVNULL,
                                   capture_output=True, timeout=30, check=False)
            ok = check.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            ok = False
        if not ok:
            gate_log("the hook changed but cannot run this gate; keeping this gate")
            return
        if self.terminating:
            return
        gate_log("the hook changed; reloading the gate")
        sys.stdout.flush()
        blocked = {signal.SIGTERM, signal.SIGINT}
        signal.pthread_sigmask(signal.SIG_BLOCK, blocked)  # kept across exec; listen() unblocks it
        if self.terminating:  # arrived just before the block
            signal.pthread_sigmask(signal.SIG_UNBLOCK, blocked)
            return
        if self.listening_since is not None:
            os.environ[GATE_LISTENING_SINCE_ENV] = repr(self.listening_since)
        if self.eligible_why:
            os.environ[GATE_INELIGIBLE_ENV] = self.eligible_why
        if self.child is not None:
            os.environ[GATE_LISTENER_ENV] = self.stale_env or "clean"
        if self.reserve_fd is not None:  # the flock stays held across the exec: no admission sees the reserve free
            with contextlib.suppress(OSError):
                os.set_inheritable(self.reserve_fd, True)
                os.environ[GATE_RESERVE_FD_ENV] = str(self.reserve_fd)
        try:
            os.execv(sys.executable, [sys.executable, *argv])
        except OSError:
            os.environ.pop(GATE_LISTENING_SINCE_ENV, None)
            os.environ.pop(GATE_INELIGIBLE_ENV, None)
            os.environ.pop(GATE_LISTENER_ENV, None)
            os.environ.pop(GATE_RESERVE_FD_ENV, None)
            if self.reserve_fd is not None:
                with contextlib.suppress(OSError):
                    os.set_inheritable(self.reserve_fd, False)
            signal.pthread_sigmask(signal.SIG_UNBLOCK, blocked)
            gate_log("the reload failed; keeping this gate")

    def claimed(self) -> str | None:
        why = host_held(self.host_lock, self.reservation, time.time(), self.state_dir)
        if why is None and self.waiters and time.monotonic() - self.waiting_at >= GATE_WAITER_EVERY_S:
            self.waiting, self.waiting_at = host_waiters(self.host_lock, self.state_dir), time.monotonic()
        if why is None and self.waiting:
            why = f"a fleet build is waiting for the host (pid {min(self.waiting)})"
        if why:
            self.load_since = None  # the fleet's claim, not load, is holding this gate
            self.yield_to_fleet()
        return (why or self.shed(self.saturated()) or self.full() or self.shed(self.hot()) or self.locked()
                or self.low_disk() or self.ineligible())

    def yield_to_fleet(self) -> None:
        """A fleet build waiting for the host lock waits for every holder, the idle catch-up's shared hold
        too, which would otherwise keep it out for a whole build: stop the catch-up."""
        if self.capacity_dir is not None and idle_warm(self.capacity_dir) is not None:
            gate_log("a fleet build wants the host: stopping the idle catch-up")
            yield_idle_warm(self.capacity_dir)

    def shed(self, why: str | None) -> str | None:
        """A load or thermal hold while the idle catch-up runs stops the catch-up instead: holding the runners
        off would keep away the only thing that makes it stop. The next poll reads the mini without it."""
        if why and self.capacity_dir is not None and idle_warm(self.capacity_dir) is not None:
            gate_log(f"{why}: stopping the idle catch-up instead of holding the runner off")
            yield_idle_warm(self.capacity_dir)
            # the hold was the catch-up's: read the mini afresh without it, not from the resume marks
            self.load_since, self.thermal, self.thermal_at = None, None, -GATE_THERMAL_EVERY_S
            return None
        return why

    def saturated(self) -> str | None:
        """Use sampled host CPU and VM pressure with hysteresis; unreadable probes never hold a listener.

        The gui runner is held for memory pressure only. Its label brings the console jobs (app-host shards, lag,
        cmux-next's swift test), one at a time per mini, and their units are admitted like any other job's; the
        CPU mark held it whenever the side and root lanes kept the mini busy, which they did for hours
        (2026-10-21: about 6 of 13 gui runners listening, gui-label jobs queued 1.5 to 3 h). Nothing local says
        whether gui jobs are queued (the gate reads no GitHub API), so the exemption is unconditional.

        The freshness slot (--dev-compile-runner) is exempt the same way. Its jobs are the feed compiles, and its
        reserve (FRESH_RESERVE_TOKEN) keeps their units free, but the PR lanes beside it keep the mini's CPU above
        the mark: on 2026-10-27 the canary slot logged "the mini is saturated (CPU busy at least 85%)" every
        minute and stayed offline while a nightly-next promote compile queued behind PR jobs. A feed compile that
        runs slower beats one that waits 30+ minutes for a mini to cool."""
        now = time.monotonic()
        scope = runner_scope(self.runner_dir)
        if scope.gui or scope.fresh:
            self.cpu_busy = None
        elif now - self.cpu_at >= GATE_CPU_EVERY_S:
            _, self.cpu_busy = host_io()
            self.cpu_at = now
        if now - self.memory_at >= GATE_CPU_EVERY_S:
            self.memory_pressure = memory_pressure_level()
            self.memory_at = now
        why = host_saturated(paused=self.load_since is not None or self.load_waived,
                             cpu_busy=self.cpu_busy, memory_pressure=self.memory_pressure)
        if why is None:
            if self.load_waived:
                gate_log("host pressure fell below the resume mark; pressure holds apply again")
            self.load_since, self.load_waived = None, False
            return None
        if self.load_waived:
            return None
        if self.load_since is None:
            self.load_since = now
        elif now - self.load_since >= GATE_LOAD_MAX_HOLD_S:
            gate_log(f"{SATURATED} for over {GATE_LOAD_MAX_HOLD_S / 60:g} min, longer than any compile: listening "
                     "anyway until host pressure falls (look for a process outside CI jobs)")
            self.load_since, self.load_waived = None, True
            return None
        return why

    def hot(self, fresh: bool = False) -> str | None:
        """Why this mini is too hot to take a job, read at most every GATE_THERMAL_EVERY_S. Holds from
        GATE_THERMAL_HOLD until the level is back at GATE_THERMAL_RELEASE, so a mini at the edge does not
        flap. An unreadable level changes nothing."""
        if GATE_THERMAL_HOLD <= 0:
            return None
        if fresh or time.monotonic() - self.thermal_at >= GATE_THERMAL_EVERY_S:
            level, self.thermal_at = thermal_pressure_level(), time.monotonic()
            if level is not None:
                release = min(GATE_THERMAL_RELEASE, GATE_THERMAL_HOLD - 1)  # below the hold, or it flaps
                limit = release if self.thermal is not None else GATE_THERMAL_HOLD - 1
                self.thermal = level if level > limit else None
        if self.thermal is None:
            return None
        return f"the mini is throttled (thermal pressure level {self.thermal})"

    def confirmed(self) -> str | None:
        """A fresh reading right before a stop: the holder still holds, or a waiter seen at least one poll ago
        is still waiting (a job-started in flight, which lsof also lists, is gone by then)."""
        why = host_held(self.host_lock, self.reservation, time.time(), self.state_dir)
        if why is None and self.waiting:
            again = self.waiting & host_waiters(self.host_lock, self.state_dir)
            self.waiting, self.waiting_at = again, time.monotonic()
            if again:
                why = f"a fleet build is waiting for the host (pid {min(again)})"
        if why:
            self.load_since = None
            self.yield_to_fleet()
        return (why or self.shed(self.saturated()) or self.full(fresh=True) or self.shed(self.hot(fresh=True))
                or self.locked(fresh=True) or self.low_disk() or self.ineligible())

    def still_waiting(self) -> str | None:
        """A fleet build seen waiting during the job that just ended, still waiting in a fresh reading."""
        if not self.waiting:
            return None
        again = self.waiting & host_waiters(self.host_lock, self.state_dir)
        self.waiting, self.waiting_at = again, time.monotonic()
        if not again:
            return None
        self.load_since = None
        self.yield_to_fleet()
        return f"a fleet build is waiting for the host (pid {min(again)})"

    def still_reserved(self) -> str | None:
        """The host's reservation, read afresh (one small file): why it holds the host, or None."""
        return reservation_refusal(self.reservation, time.time()) if self.reservation else None

    def low_disk(self) -> str | None:
        """Why job-started would refuse every job for free disk (disk_refusal against this runner's own
        --min-free-gib), or None. A listening runner under the floor took every job its label brought and refused
        it: 68 of the fleet's 151 refusals in the 24 h to 2026-09-27 18:00Z, mostly seeds on cmuxs-mac-mini-6 at
        134 of 150 GiB. Under the floor the gate starts an eviction of idle caches (evict_in_background, at most
        every GATE_DISK_EVICT_EVERY_S) and holds while the disk is short; the hold ends once an eviction makes room.
        Held off, the job goes to another runner or waits in GitHub's queue. statvfs is cheap, so every poll reads
        it.
        A hold resumes only at GATE_DISK_RESUME_GIB above the floor, so a mini at the edge does not flap. glaeda-disk
        --pressure frees space well past it; a hold past GATE_DISK_NOTE_S logs once that it could not, so an
        operator frees space by hand."""
        # the margin and the hold timer apply only while the listener is actually held off for disk, so a
        # listening runner that dips once is stopped only on two readings under the floor itself
        holding = self.child is None and (self.held or "").startswith("disk:")
        if not holding:
            self.disk_since, self.disk_noted = None, False
        floor = runner_scope(self.runner_dir).min_free_gib
        path, need = os.path.dirname(self.host_lock), floor + GATE_DISK_RESUME_GIB if floor > 0 and holding else floor
        self.reap_eviction(path, floor)
        why = disk_refusal(path, need)
        if why:
            self.evict_in_background(path, floor)
        if why is None or not holding:
            return f"disk: {why}" if why else None
        now = time.monotonic()
        if self.disk_since is None:
            self.disk_since = now
        elif not self.disk_noted and now - self.disk_since >= GATE_DISK_NOTE_S:
            gate_log(f"held for free disk over {GATE_DISK_NOTE_S / 60:g} min ({why}): evicting idle caches has not "
                     "freed enough; check with glaeda-disk --top 25")
            self.disk_noted = True
        return f"disk: {why}"

    def evict_in_background(self, path: str, floor: float) -> None:
        """Start a detached glaeda-disk --pressure run for the floor (disk_argv) unless one is under way or one
        started within GATE_DISK_EVICT_EVERY_S. It stays in the gate's process group, so launchd's cleanup covers
        it; reap_eviction reads it on later polls, so no poll waits on it."""
        now = time.monotonic()
        if self.evicting is not None or now - self.disk_evicted_at < GATE_DISK_EVICT_EVERY_S:
            return
        self.disk_evicted_at = now
        argv = disk_argv(None, floor)
        if argv is None:
            gate_log(f"under the {floor:g} GiB disk floor: glaeda-disk not installed; skipped")
            return
        before = free_or_none(path)
        try:
            proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, env=floor_disk_env("listener gate floor eviction"))
        except OSError as error:
            gate_log(f"under the {floor:g} GiB disk floor: glaeda-disk skipped: {type(error).__name__}")
            return
        self.evicting = (proc, now, before)

    def reap_eviction(self, path: str, floor: float) -> None:
        """Log a finished eviction with the space it freed; kill one running past DISK_TIMEOUT_S."""
        if self.evicting is None:
            return
        proc, started, before = self.evicting
        code = proc.poll()
        if code is None:
            if time.monotonic() - started < DISK_TIMEOUT_S:
                return
            with contextlib.suppress(OSError):
                proc.kill()
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.wait(timeout=5)
            ran = "glaeda-disk timed out"
        else:
            ran = f"glaeda-disk exited {code}"
        self.evicting = None
        gate_log(evicted(path, floor, ran, before))

    def locked(self, fresh: bool = False) -> str | None:
        """For the gui and session runners only: why their console session cannot run a GUI job (console_refusal),
        read at most every GATE_CONSOLE_EVERY_S. Every job their labels bring needs the logged-in session, so they
        wait here instead of being refused; a root runner's compiles do not, so it keeps listening."""
        scope = runner_scope(self.runner_dir)
        if not CONSOLE_GATE or not (scope.gui or scope.session):
            return None
        if fresh or time.monotonic() - self.console_at >= GATE_CONSOLE_EVERY_S:
            self.console_why, self.console_at = console_refusal(), time.monotonic()
        return self.console_why

    def ineligible(self) -> str | None:
        """For a --require-eligible runner: why job-started would refuse every job for eligibility (GATE_ELIGIBLE_EVERY_S),
        from the last look. A look starts in a thread when the last one is older than GATE_ELIGIBLE_EVERY_S and none
        is running, so no poll waits on its probes. A look that crashes counts as eligible: job-started still checks
        every job itself, so a wrong "eligible" only costs the refusal this hold avoids. An adopted listener whose env
        is stale (adopted_env_stale) is held the same way, for any runner: stopped once idle, it starts clean."""
        if self.child is None:
            self.stale_env = None  # the next start() gives it listener_env
        elif self.stale_env:
            return f"listener env: {self.stale_env}; restarting it on the pool Xcode's env"
        scope = eligibility_scope(self.runner_dir)
        if scope is None:
            self.eligible_why = self.missing_why = None
            return None
        missing = toolchain_missing()  # run.sh's PATH, so the jobs'; every poll: a few stats, a definite answer
        if missing != self.missing_why:
            gate_log(f"{missing}; held off at once so another runner takes the job (glaeda-mini-health: "
                     "toolchain_missing)" if missing else "the Rust toolchain is back")
            self.missing_why = missing
        if missing:
            return f"ineligible: {missing}"
        running =self.eligible_look is not None and self.eligible_look.is_alive()
        if not running and time.monotonic() - self.eligible_at >= GATE_ELIGIBLE_EVERY_S:
            self.eligible_at = time.monotonic()

            def look() -> None:
                try:
                    why = eligibility_refusal(*scope)
                except Exception as error:  # noqa: BLE001 - a broken look must never stop the gate
                    why = None
                    gate_log(f"the eligibility look failed ({type(error).__name__}); not holding for it")
                if why and TOOLCHAIN_MISSING in why:
                    return  # the per-poll toolchain_missing owns that answer; the held one, if any, stands
                if why and not self.eligible_why and not self.eligible_new:
                    self.eligible_new = why  # look again soon; hold only if that look refuses too
                    self.eligible_at = time.monotonic() - GATE_ELIGIBLE_EVERY_S + GATE_ELIGIBLE_RECHECK_S
                    return
                self.eligible_new = None
                if why != self.eligible_why:
                    gate_log(f"eligibility: {why}; held off so another runner takes the job" if why
                             else "eligible again")
                self.eligible_why = why

            self.eligible_look = threading.Thread(target=look, name="eligibility", daemon=True)
            self.eligible_look.start()
        return f"ineligible: {self.eligible_why}" if self.eligible_why else None

    def full(self, fresh: bool = False) -> str | None:
        """Every unit this runner's jobs could take is held. A look an admission blocked keeps the previous
        answer, so a full mini's retrying admissions never read as free and restart a listener; the fresh
        look right before a stop (confirmed()) stops only on a reading of its own."""
        scope = runner_scope(self.runner_dir)
        why = mini_full(self.capacity_dir, scope.units, scope, max(self.fit_units, listen_fit_units(self.runner_dir)))
        if isinstance(why, Unknown):
            return None if fresh else self.full_why
        self.full_why = why
        return why

    def reserve(self, want: bool) -> None:
        """Hold or let go of this gui runner's reserve (GUI_RESERVE: capacity/<gui token>.reserve), which keeps
        GUI_RESERVE_UNITS units from every other job and runner on the mini. step() holds it while the runner is
        idle and reserves() agrees, and keeps it through the runner's own job, which its admission holder lends
        (RESERVE_LENT), so it is whole again the moment that job's units go back. Only a gui runner with a capacity
        ledger reserves. The flock is the gate's own fd (not inherited by run.sh; a reload hands it to the new gate,
        adopt_reserve), so a gate that dies reserves nothing. Never raises: a reserve it cannot
        take is tried again on the next poll."""
        if want and self.reserve_fd is None:
            path = self.reserve_path()
            if path is None:
                return
            with contextlib.suppress(OSError):
                self.reserve_fd = lock_file(path, fcntl.LOCK_EX)
        elif not want and self.reserve_fd is not None:
            with contextlib.suppress(OSError):
                os.close(self.reserve_fd)
            self.reserve_fd = None

    def adopt_reserve(self, handed: str | None) -> None:
        """Take over the reserve flock the gate before a reload held (GATE_RESERVE_FD_ENV), so the reserve is never
        free across the exec. Only an fd open on this runner's own <token>.reserve is kept; anything else is closed
        if it was a number, and ignored otherwise. Never raises."""
        try:
            fd = int(handed or "")
        except ValueError:
            return
        if fd < 3:
            return
        path = self.reserve_path()
        try:
            same = path is not None and os.path.samestat(os.fstat(fd), os.stat(path, follow_symlinks=False))
        except OSError:
            same = False
        if not same:
            with contextlib.suppress(OSError):
                os.close(fd)
            return
        with contextlib.suppress(OSError):
            os.set_inheritable(fd, False)
        self.reserve_fd = fd

    def reserve_path(self) -> Path | None:
        """This runner's capacity/<token>.reserve, or None when it reserves nothing (reserve())."""
        scope = runner_scope(self.runner_dir)
        token = reserve_token(scope)
        if token is None or scope.units <= 0 or self.capacity_dir is None or not self.capacity_dir.is_dir():
            return None
        return self.capacity_dir / f"{token}{GUI_RESERVE}"

    def keeps_reserve(self, why: str | None) -> bool:
        """reserves(why), except that a held reserve is never let go once a job has arrived meanwhile: claimed() can
        read the runner's own new job (its gui token, its units) as a reason to hold off, and a reserve dropped then
        stays dropped through that job, reopening the gap at its end (review of glaeda#1651)."""
        if self.reserves(why):
            return True
        return self.reserve_fd is not None and self.busy()

    def reserves(self, why: str | None) -> bool:
        """Whether an idle gui runner keeps its reserve, given claimed()'s answer: only while nothing holds it or
        only units do (full(), UNITS_FULL), and its console can run a GUI job. Held off for the fleet, heat, memory
        pressure, a locked console, the gui token or the canonical roots, it could take no job, so the unit would
        only sit idle."""
        return (why is None or (why == self.full_why and UNITS_FULL in why)) and self.locked() is None

    def tree(self) -> tuple[list[int], dict[int, tuple[int, str]]]:
        table = processes()
        return (descendants(self.child.pid, table) if self.child is not None else []), table

    def sweep(self) -> None:
        """Every GATE_SWEEP_S while this runner has no job: end orphans left in its own _work
        (sweep_idle_leftovers). Never raises; a failed sweep waits for the next one."""
        if time.monotonic() - self.swept_at < GATE_SWEEP_S:
            return
        self.swept_at = time.monotonic()
        try:
            if self.busy():
                return
            for note in sweep_idle_leftovers(self.runner_dir):
                gate_log(note)
        except Exception as error:  # noqa: BLE001  (housekeeping never stops the gate)
            gate_log(f"the leftover sweep failed ({type(error).__name__}); trying again later")

    def busy(self) -> bool:
        """The runner has a job: a Runner.Worker under its tree, or a request its live listener is taking. A request
        left in the diag of a listener that is gone holds nothing (nothing can run it), so it never pins the gate."""
        return self.worker() or (self.listening() and self.taking() is not None)

    def listening(self) -> bool:
        """A Runner.Listener of this runner under its tree. A failed look counts as listening."""
        try:
            pids, table = self.tree()
        except Exception:  # noqa: BLE001
            return True
        return any(runner_worker(self.runner_dir, table[pid][1], "Listener") for pid in pids)

    def worker_pids(self) -> tuple[int, ...]:
        """Runner.Worker descendants, used to wake a disk hold when the job exits."""
        try:
            pids, table = self.tree()
        except Exception:  # noqa: BLE001
            return ()
        return tuple(pid for pid in pids if runner_worker(self.runner_dir, table[pid][1]))

    def job_left(self) -> bool:
        """After run.sh exited: a Runner.Worker of this runner anywhere (an orphan is no longer in tree()), or a
        request its listener took and did not finish. A failed look counts as a job: the exit then goes to
        launchd as before, never to the registration backoff, which would start a listener beside the job."""
        try:
            table = processes()
        except Exception:  # noqa: BLE001
            return True
        found = any(runner_worker(self.runner_dir, command) for _, command in table.values())
        return found or self.taking() is not None

    def worker(self) -> bool:
        """A Runner.Worker under this runner's tree. A failed look counts as busy."""
        try:
            pids, table = self.tree()
        except Exception:  # noqa: BLE001
            return True
        return any(runner_worker(self.runner_dir, table[pid][1]) for pid in pids)

    def taking(self) -> str | None:
        """The runner request the listener has acknowledged and not finished (listener_request). An unreadable
        diag counts as taking one."""
        try:
            return listener_request(self.runner_dir)
        except (OSError, ValueError) as error:
            return f"unknown ({type(error).__name__})"

    def start(self) -> None:
        gate_log("starting the listener")
        self.child = subprocess.Popen([os.fspath(self.runner_dir / "run.sh")], cwd=self.runner_dir,
                                      stdin=subprocess.DEVNULL, env=listener_env(os.environ, runner_xcode(self.runner_dir)))
        self.stale_env = None
        self.streak, self.stopped_one = 0, False
        self.listening_since, self.first_poll_noted = time.monotonic(), False
        self.started_wall = time.time()

    def registration_wait(self) -> bool:
        """Whether a deleted registration still holds the listener off (its backoff, unless re-configured)."""
        if self.registration is None:
            return False
        _, mtime = runner_config(self.runner_dir)
        if mtime is not None and mtime != self.registration.get("runner_mtime"):
            gate_log("the runner was re-configured; listening again")
            self.registration["runner_mtime"] = mtime  # one try now; the record stays until a listener stays up
            return False
        return time.time() < float(self.registration.get("retry_after") or 0)

    def registration_ok(self) -> None:
        """A listener up GATE_REGISTRATION_OK_S has its registration: clear the record."""
        if self.registration is None or self.listening_since is None \
                or time.monotonic() - self.listening_since < GATE_REGISTRATION_OK_S:
            return
        self.registration = None
        with contextlib.suppress(OSError):
            registration_file(self.state_dir, self.runner_dir).unlink()
        gate_log("the runner's registration is back; cleared the registration_deleted record")

    def first_poll(self, why: str) -> bool:
        """The listener started less than GATE_FIRST_POLL_S ago: its first poll may already carry a job, so a hold
        waits (keeping its streak) instead of stopping it."""
        if self.listening_since is None or time.monotonic() - self.listening_since >= GATE_FIRST_POLL_S:
            return False
        if not self.first_poll_noted:
            gate_log(f"keeping the new listener through its first poll ({GATE_FIRST_POLL_S:g} s): {why}")
            self.first_poll_noted = True
        return True

    def stop(self, why: str) -> bool:
        """SIGINT to the listener: its graceful exit ends its session, so GitHub stops routing here. With no
        listener (run-helper.sh between listeners), SIGTERM the whole tree so nothing starts one later.
        A listener can take a job at any moment, and a SIGINT between its acknowledge and its Worker loses that
        job (listener_request). So the listener is frozen (SIGSTOP) for the last look: frozen, it can neither
        acknowledge a request nor start a Worker, and its trace shows every acknowledge it has sent. A listener
        with a job, or taking one, is thawed and kept; an idle one gets the SIGINT before it is thawed. When the
        agent is stopping, a running job is cancelled as before, but an acquisition is still waited out.
        Returns whether it signalled; step() tries again on a later poll."""
        pids, table = self.tree()
        listener = os.fspath(self.runner_dir / "bin" / "Runner.Listener")
        listeners = [pid for pid in pids if listener in table[pid][1]]
        frozen = []
        try:
            for pid in listeners:
                with contextlib.suppress(OSError):
                    os.kill(pid, signal.SIGSTOP)
                    frozen.append(pid)
            if listeners:
                request, worker = self.taking(), self.worker()
                if (worker and not self.terminating) or (request is not None and not worker):
                    if not self.defer_noted:
                        gate_log(f"not stopping the listener ({why}): it is taking job request {request}"
                                 if request is not None and not worker else
                                 f"not stopping the listener ({why}): it has a job")
                        self.defer_noted = True
                    self.streak = 0
                    return False
            gate_log(f"stopping the idle listener: {why}")
            self.held, self.stop_deadline, self.worker_noted = why, time.monotonic() + GATE_STOP_WAIT_S, False
            self.defer_noted = False
            targets = listeners or [*reversed(pids), *([self.child.pid] if self.child is not None else [])]
            for pid in targets:
                with contextlib.suppress(OSError):
                    os.kill(pid, signal.SIGINT if listeners else signal.SIGTERM)
            return True
        finally:
            for pid in frozen:  # a SIGINT sent while frozen is delivered as it thaws
                with contextlib.suppress(OSError):
                    os.kill(pid, signal.SIGCONT)

    def kill(self) -> None:
        try:
            pids, _ = self.tree()
        except Exception:  # noqa: BLE001
            pids = []
        for pid in [*reversed(pids), *([self.child.pid] if self.child is not None else [])]:
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGKILL)

    def step(self) -> int | None:
        """One poll. Returns an exit code when the gate itself should exit."""
        if self.child is not None:
            code = self.child.poll()
            if code is not None:
                self.child = None
                if self.stop_deadline is None and not self.terminating and \
                        (evidence := registration_deleted(self.runner_dir, self.started_wall)) and \
                        not self.job_left():
                    self.registration = note_registration_deleted(self.state_dir, self.runner_dir, evidence,
                                                                  time.time())
                    gate_log(f"{REGISTRATION_DELETED}: GitHub deleted this runner's registration ({evidence}); it "
                             f"needs re-registering, trying again in {GATE_REGISTRATION_RETRY_S:g} s "
                             f"(exit {self.registration['exits']})")
                    return None
                if self.stop_deadline is None or self.terminating:
                    return code  # the runner exited on its own: launchd's KeepAlive decides, as before
                self.stop_deadline, self.stopped_one = None, True
                gate_log(f"holding the listener off: {self.held}")
                return None
            self.registration_ok()
            if self.stop_deadline is not None:
                if time.monotonic() > self.stop_deadline:
                    if self.busy():  # a job slipped in before the stop: let it finish, never kill it
                        if not self.worker_noted:
                            gate_log("the listener has a job; waiting for it instead of killing it")
                            self.worker_noted = True
                    else:
                        gate_log("the listener did not exit; killing it")
                        self.kill()
                return None
            if self.terminating:
                self.stop("the runner agent is stopping")
                return None
            if (self.watching or self.job_waited) and not self.busy():
                self.watching, self.job_waited = (), False
                self.fast_until = time.monotonic() + 5.0
                if (why := self.low_disk() or self.still_waiting() or self.still_reserved()):
                    self.stop(why)
                    return None
            self.reload()
            if self.busy():
                # A fleet build seen waiting, or a reservation made, during a job stops the listener as the job
                # ends: with a queue behind the label the next job comes before two idle polls, and each is
                # refused (cmux10s, 2026-10-14: 14 PR jobs in two minutes under a soak's reservation). A job
                # job-started refused ends in seconds, so its worker is watched; any other is seen on a poll.
                if self.waiters and time.monotonic() - self.waiting_at >= GATE_WAITER_EVERY_S:
                    self.waiting, self.waiting_at = host_waiters(self.host_lock, self.state_dir), time.monotonic()
                reserved = self.still_reserved()
                self.job_waited = bool(self.waiting) or reserved is not None
                workers = self.worker_pids() if self.waiting or reserved or self.low_disk() else []
                refused = (self.waiting or reserved) and any(refused_note(self.state_dir, pid).exists()
                                                             for pid in workers)
                if workers and (refused or self.low_disk()):
                    self.watching = tuple(workers)
                    self.fast_until = time.monotonic() + 5.0
                self.streak = 0  # a claim must hold for two idle polls, not carry over from the job
                self.load_since = None  # the hold limit times a pause, never a job
                # the reserve stays held through the runner's own job: its admission lends it (RESERVE_LENT), so it
                # keeps nothing while that job holds its units and is whole the moment they go back. One the job could
                # not borrow keeps its units from the other lanes meanwhile, the safe side.
                if self.reserve_fd is None and self.locked() is None:
                    # one let go at an idle look a job then beat, or a reload's: a job of its own always gets it
                    # back, read from nothing but the job itself, so no state is lost across a reload
                    self.reserve(True)
                return None
            why = self.claimed()
            if self.reserves(why):
                self.reserve(True)
            self.streak = self.streak + 1 if why else 0
            if why and self.streak >= GATE_CONFIRM and not self.first_poll(why):
                why = self.confirmed()
                if why and not self.busy():  # the fresh look and the busy check right before the signal
                    self.stop(why)
            # let go only after the last look (confirmed() included), and never with a job of its own arrived
            # (keeps_reserve); a job that beats even this busy() check gets it back on its first busy poll
            self.reserve(self.keeps_reserve(why))
            return None
        if self.terminating:
            return 0
        self.reload()
        if self.registration_wait():
            self.reserve(False)  # a runner GitHub no longer knows takes no job: it keeps no units from the others
            return None
        why = self.claimed()
        self.reserve(self.keeps_reserve(why))
        if why:
            if why != self.held:
                gate_log(f"holding the listener off: {why}")
            self.held, self.streak, self.free_since = why, 0, None
            return None
        if self.held is not None:
            self.streak += 1
            if self.free_since is None:
                self.free_since = time.monotonic()
            if self.streak < GATE_CONFIRM:
                return None
            if self.stopped_one and time.monotonic() - self.free_since < GATE_RESTART_FREE_S:
                if self.streak == GATE_CONFIRM:
                    gate_log(f"the host is free; listening again after {GATE_RESTART_FREE_S:g} s free, since a stop")
                return None
            gate_log("the host is free again")
            self.held, self.free_since = None, None
        if self.terminating:  # SIGTERM during the look above
            return 0
        self.start()
        return None

    def nap(self) -> None:
        """Sleep until the next poll, waking quickly while a disk-held job exits."""
        if self.watching:
            if self.fast_until <= time.monotonic():
                self.fast_until = time.monotonic() + 5.0
            while self.watching:
                alive = []
                for pid in self.watching:
                    if pid_alive(pid) and not self._zombie(pid):
                        alive.append(pid)
                self.watching = tuple(alive)
                if not self.watching:
                    self.fast_until = time.monotonic() + 5.0
                    return
                time.sleep(GATE_WATCH_S)
                if time.monotonic() > self.fast_until:
                    break
            return
        delay = GATE_POLL_S
        if self.fast_until > time.monotonic():
            delay = GATE_WATCH_S
        if self.stop_deadline is not None:
            delay = max(0.0, self.stop_deadline - time.monotonic())
        time.sleep(delay)

    @staticmethod
    def _zombie(pid: int) -> bool:
        try:
            result = subprocess.run(["/bin/ps", "-o", "stat=", "-p", str(pid)], stdin=subprocess.DEVNULL,
                                    capture_output=True, text=True, timeout=1, check=False)
        except (OSError, subprocess.SubprocessError):
            return False
        return result.stdout.strip().startswith("Z")

    def unexpected(self, error: BaseException) -> int:
        """The gate broke for good: run the runner as plain run.sh would. A live child keeps running (a job is
        never killed for a gate bug) until it exits or the agent stops, otherwise GATE_FALLBACK tells listen.sh
        to exec run.sh itself."""
        gate_log(f"the gate failed ({type(error).__name__}: {error}); running the runner without it")
        if self.child is None or self.child.poll() is not None:
            return GATE_FALLBACK
        signalled = False
        while (code := self.child.poll()) is None:
            if self.terminating and not signalled:  # launchd is stopping the agent: end the runner's session
                try:
                    signalled = self.stop("the runner agent is stopping")  # False: retried on the next look
                except Exception:  # noqa: BLE001
                    signalled = True
                    self.child.terminate()
            time.sleep(0.5)
        return code

    def terminate(self, *_: Any) -> None:
        self.terminating = True  # step() acts on it: a signal handler must not run ps


def listen(runner_dir: Path, host_lock: str, reservation: str, state_dir: Path, waiters: bool,
           adopt: int = 0, capacity_dir: Path | None = None, fit_units: int = 1) -> int:
    gate = Gate(runner_dir, host_lock, reservation, state_dir, waiters, capacity_dir, fit_units)
    gate.adopt_reserve(os.environ.pop(GATE_RESERVE_FD_ENV, None))
    marker = os.environ.pop(GATE_LISTENER_ENV, None)
    xcode = runner_xcode(runner_dir)
    if adopt:
        gate.child = Adopted(adopt)  # type: ignore[assignment]
        # registration_deleted reads only a _diag log written since: never one from before this gate's exec
        gate.started_wall = time.time()
        with contextlib.suppress(ValueError):  # the adopted listener keeps its first poll (GATE_FIRST_POLL_S)
            gate.listening_since = float(os.environ.get(GATE_LISTENING_SINCE_ENV, ""))
        gate.stale_env = adopted_env_stale(marker, os.environ, xcode)
        if gate.stale_env:
            gate_log(f"the adopted listener's env is stale ({gate.stale_env}); restarting it once it is idle")
    os.environ.pop(GATE_LISTENING_SINCE_ENV, None)
    # The gate's own env too (the /usr/bin/python3 shim exports SDKROOT): its eligibility probes see the job's env.
    clean = listener_env(os.environ, xcode)
    os.environ.clear()
    os.environ.update(clean)
    signal.signal(signal.SIGTERM, gate.terminate)
    signal.signal(signal.SIGINT, gate.terminate)
    # reload() blocks both before its exec, so a stop that arrives across it stays pending until here.
    signal.pthread_sigmask(signal.SIG_UNBLOCK, {signal.SIGTERM, signal.SIGINT})
    failures = 0
    while True:
        try:
            code = gate.step()
            failures = 0
        except Exception as error:  # noqa: BLE001  (a ps timeout under load: log it and keep gating)
            failures += 1
            if failures >= GATE_MAX_FAILURES:
                return gate.unexpected(error)
            gate_log(f"a poll failed ({type(error).__name__}: {error}); trying again")
            code = None
        if code is not None:
            return code
        if not gate.terminating:
            gate.sweep()
        time.sleep(GATE_POLL_S if not gate.terminating else 0.5)


def refused_note(state_dir: Path, worker: int) -> Path:
    """job-started's note that it refused this Worker's job, which job-completed reads. The state dir is the
    mini's, shared by its runners, so the note is the Worker's."""
    return state_dir / f"refused-{worker}"


def refuse(reason: str) -> int:
    message = f"{PREFIX}: refused: {reason}"
    print(message, flush=True)
    print(f"::error::{message}", flush=True)
    return 1


def load_event(path: str | None) -> Any:
    if not path:
        return None
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None


# ---------------------------------------------------------------- per-job host telemetry
#
# A detached sampler watches the host while each admitted job runs, so a slow job can be explained after
# the fact: how loaded the mini was, how much CPU went to this job, to the other runner slots' jobs, and to
# processes outside any runner job, and which of those used the most. On job-completed (or when the job's
# Runner.Worker exits) it appends one bounded JSON line to JOB_LOG. Observation only: it never refuses,
# delays or fails a job, and every failure is swallowed.
#
# Privacy: processes are recorded by executable basename and user only, never arguments or paths; runner
# slots by their directory name (actions-runner-glaeda-2). ps's %cpu is the kernel's decaying recent
# average, so core-seconds are an estimate: good for "who used the CPU", not for billing.
JOB_LOG = Path.home() / "Library/Logs/glaeda-cmux-jobs.jsonl"
JOB_LOG_MAX_BYTES = 16 * 1024 * 1024  # past this the log keeps its newest half (weeks of started/completed lines)
JOB_SCHEMA = "glaeda-cmux-job/v1"
SAMPLER_FILE = "job-sampler"
COMPILE_TELEMETRY_SCHEMA = "cmux-compile-telemetry/v1"
COMPILE_TELEMETRY_FILE = "glaeda-compile-telemetry.json"
COMPILE_TELEMETRY_MAX_BYTES = 16 * 1024
SAMPLE_S = 10.0
THERMAL_EVERY = 6  # pmset -g therm every Nth sample
DYNAMIC_WARMUP_S = float(os.environ.get("GLAEDA_DYNAMIC_WARMUP_S") or 120.0)
DYNAMIC_LOW_S = float(os.environ.get("GLAEDA_DYNAMIC_LOW_S") or 60.0)
DYNAMIC_TARGET_BUSY_PCT = 80.0
DYNAMIC_LOW_JOB_SHARE = 0.60
MEMORY_PRESSURE_KEY = "kern.memorystatus_vm_pressure_level"
PS = "/bin/ps"
SYSCTL = "/usr/sbin/sysctl"
PMSET = "/usr/bin/pmset"
IOSTAT = "/usr/sbin/iostat"
TOP_OUTSIDE = 5
# Contended, any of: work outside this mini's runner jobs averaged at least this many cores and this share of
# the cores; the host CPU was saturated while other runner jobs and outside work held a real share of it (so
# co-tenant jobs the capacity ledger admitted count here, deliberately: they slow this job all the same); or
# many processes sat in uninterruptible wait. The load average is recorded but is never a reason by itself.
CONTENDED_OUTSIDE_CORES = 2.0
CONTENDED_OUTSIDE_SHARE = 0.15
CONTENDED_BUSY_PCT = 90.0
CONTENDED_SHARED_SHARE = 0.25
# ps state U on macOS means some thread waits uninterruptibly: disk, but also VM faults and memory-compressor
# stalls. An idle Mac shows 1 to 3, so the floor sits well above that noise.
CONTENDED_BLOCKED = 4.0
CONTENDED_BLOCKED_SHARE = 0.3
RUNNER_DIR_RE = re.compile(r"/(actions-runner[A-Za-z0-9_.-]*)/")


def sampler_file(state_dir: Path) -> Path:
    main = holder_file(state_dir)
    return state_dir / main.name.replace(HOLDER_FILE, SAMPLER_FILE, 1)


def ps_rows() -> list[tuple[int, int, float, str, str]]:
    """(pid, ppid, %cpu, user, name) for every process. The name is the kernel's executable name (ucomm), not
    argv[0], so a process title can never carry arguments into the record; Runner.Worker keeps its argv[0]
    because its runner directory is the only thing read from it."""
    def run(fields: str) -> str:
        return subprocess.run([PS, "-Ao", fields], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=10, check=False, env={"LC_ALL": "C"}).stdout
    names: dict[int, str] = {}
    for line in run("pid=,ucomm=").splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0].isdigit():
            names[int(parts[0])] = parts[1].strip()
    rows = []
    for line in run("pid=,ppid=,pcpu=,user=,comm=").splitlines():
        parts = line.split(None, 4)
        if len(parts) < 5:
            continue
        try:
            pid, comm = int(parts[0]), parts[4].strip()
            name = comm if comm.endswith("Runner.Worker") else names.get(pid, "?")
            rows.append((pid, int(parts[1]), float(parts[2]), parts[3], name))
        except ValueError:
            continue
    return rows


def telemetry_test_app_owners(table: dict[int, tuple[int, str]]) -> dict[int, int]:
    """Observe reparented CI XCTest apps whose exact temp tree is used by a live runner job.

    Paths and arguments are evidence only and never enter telemetry. A runner-prefix match alone would
    adopt a stale app from an earlier job, so require a process under that same Worker to name this tree.
    This observation does not grant process cleanup or signal authority.
    """
    workers = {pid: command.split("/bin/Runner.Worker", 1)[0]
               for pid, (_, command) in table.items()
               if re.search(r"^/.*?/actions-runner[^/]+/bin/Runner\.Worker(?:\s|$)", command)}

    def owner(pid: int) -> int | None:
        for _ in range(256):
            if pid in workers:
                return pid
            if pid <= 1 or pid not in table:
                return None
            pid = table[pid][0]
        return None

    result: dict[int, int] = {}
    for pid, (_, command) in table.items():
        app = LEAKED_TEST_APP.search(command)
        temp = LEAKED_TEST_TEMP.match(app.group(1)) if app else None
        if temp is None:
            continue
        tree = temp.group(1)
        runner = tree.split("/_work/", 1)[0]
        candidates = {owner(other) for other, (_, cmd) in table.items()
                      if other != pid and tree + "/" in cmd and not LEAKED_TEST_APP.search(cmd)}
        candidates = {worker for worker in candidates if worker is not None and workers[worker] == runner}
        if len(candidates) == 1:
            result[pid] = candidates.pop()
    return result


def classify(rows: list[tuple[int, int, float, str, str]], job_root: int,
             skip: set[int], test_app_owners: dict[int, int] | None = None
             ) -> tuple[float, float, float, dict[str, float], dict[str, float]]:
    """Cores used right now by this job's tree, its reparented CI test app tree, other jobs, and everything else, plus the outside
    cores by "basename (user)" and the other jobs' cores by runner directory."""
    parent = {pid: ppid for pid, ppid, _, _, _ in rows}
    workers = {pid: (m.group(1) if (m := RUNNER_DIR_RE.search(comm)) else "runner")
               for pid, _, _, _, comm in rows if comm.endswith("Runner.Worker")}
    workers.setdefault(job_root, "this job")

    def owner(pid: int) -> int | None:
        seen = 0
        while pid > 1 and seen < 256:
            if pid in workers:
                return pid
            if test_app_owners and test_app_owners.get(pid) in workers:
                return test_app_owners[pid]
            pid = parent.get(pid, 0)
            seen += 1
        return None

    job = others = outside = 0.0
    by_outside: dict[str, float] = {}
    by_runner: dict[str, float] = {}
    for pid, _, pcpu, user, comm in rows:
        if pid in skip or pcpu <= 0:
            continue
        cores = pcpu / 100.0
        root = owner(pid)
        if root == job_root:
            job += cores
        elif root is not None:
            others += cores
            by_runner[workers[root]] = by_runner.get(workers[root], 0.0) + cores
        else:
            outside += cores
            key = f"{os.path.basename(comm)[:60]} ({user[:24]})"
            by_outside[key] = by_outside.get(key, 0.0) + cores
    return job, others, outside, by_outside, by_runner


def load_average() -> float | None:
    try:
        out = subprocess.run([SYSCTL, "-n", "vm.loadavg"], stdin=subprocess.DEVNULL, capture_output=True,
                             text=True, timeout=5, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    nums = re.findall(r"\d+(?:\.\d+)?", out)
    return float(nums[0]) if nums else None


def run_queue() -> tuple[int, int] | None:
    """(running, blocked): processes in ps state R and in uninterruptible wait (U, or D on Linux)."""
    try:
        out = subprocess.run([PS, "-Ao", "stat="], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                             timeout=10, check=False, env={"LC_ALL": "C"}).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    states = [line.strip()[:1] for line in out.splitlines() if line.strip()]
    if not states:
        return None
    return sum(s == "R" for s in states), sum(s in ("U", "D") for s in states)


def host_io() -> tuple[float | None, float | None]:
    """(disk MB/s summed over every disk, host CPU busy %) over one second: the second iostat report, since
    the first counts from boot. Busy % is the ground truth for saturation: ps %cpu is a decaying average that
    misses the short-lived compiler processes a build is made of."""
    try:
        out = subprocess.run([IOSTAT, "-d", "-C", "-K", "-n", "16", "-c", "2", "-w", "1"],
                             stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10, check=False,
                             env={"LC_ALL": "C"}).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None, None
    lines = [l.split() for l in out.splitlines() if l.strip()]
    if len(lines) < 4 or "MB/s" not in lines[1]:
        return None, None
    header, last = lines[1], lines[-1]
    if len(last) != len(header):
        return None, None
    try:
        disk = round(sum(float(last[i]) for i, name in enumerate(header) if name == "MB/s"), 2)
        busy = float(100 - int(last[header.index("id")])) if "id" in header else None
    except (ValueError, IndexError):
        return None, None
    return disk, busy


def thermal_limited() -> bool | None:
    """True when macOS reports high thermal pressure, or pmset a CPU speed limit under 100 or a recorded
    thermal/performance warning."""
    level = thermal_pressure_level()
    try:
        out = subprocess.run([PMSET, "-g", "therm"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                             timeout=5, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    if level is not None and level >= THERMAL_HOT:
        return True  # pmset stays silent at thermal pressure (cmuxterm-hq#663)
    if not out:
        return None if level is None else False
    limit = re.search(r"CPU_Speed_Limit\s*=\s*(\d+)", out)
    if limit and int(limit.group(1)) < 100:
        return True
    warned = [l for l in out.splitlines() if "warning level" in l.lower() and not l.strip().startswith("Note: No")]
    return bool(warned)


def memory_pressure_level() -> int | None:
    """Darwin VM pressure: 1 normal, 2 elevated, 4 critical; unknown off Darwin."""
    try:
        out = subprocess.run([SYSCTL, "-n", MEMORY_PRESSURE_KEY], stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=5, check=False).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return None
    try:
        return int(out)
    except ValueError:
        return None


def dynamic_release_decision(elapsed: float, low_since: float | None, units: int, total: int,
                             job_cores: float | None, host_busy: float | None, blocked: int,
                             memory: int | None, thermal: bool | None,
                             admitted: int | None = None) -> tuple[int, str] | None:
    """Pure safety decision: release one unit only after warmup and sustained low, safe headroom. A job keeps at
    least half the units it was admitted with (rounded up): units are its estimated cores, and a 6-core job quiet
    through a slow checkout or cache fetch must not drop to one core and then compile on cores others were given."""
    floor = max(1, math.ceil(admitted / 2)) if admitted else 1
    if units <= floor or total <= 1 or elapsed < DYNAMIC_WARMUP_S or low_since is None:
        return None
    if elapsed - low_since < DYNAMIC_LOW_S or job_cores is None:
        return None
    if job_cores > max(0.5, units * DYNAMIC_LOW_JOB_SHARE):
        return None
    if host_busy is not None and host_busy >= DYNAMIC_TARGET_BUSY_PCT:
        return None
    if blocked > 0 or (memory is not None and memory >= 2) or thermal:
        return None
    return units - 1, "sustained low job CPU with host headroom"


def request_dynamic_release(state_dir: Path, keep_units: int, details: dict[str, Any]) -> None:
    """Ask the admission holder to close surplus unit fds; the holder remains authoritative for locks."""
    path = holder_file(state_dir).with_name(holder_file(state_dir).name + ".release")
    tmp = path.with_name(path.name + f".{os.getpid()}")
    tmp.write_text(json.dumps({"keep_units": keep_units, **details}, separators=(",", ":")))
    os.replace(tmp, path)
    if details.get("release_root"):
        for root_pid in state_dir.glob(f"{holder_file(state_dir).stem}-root-*.pid"):
            root_path = root_pid.with_name(root_pid.name + ".release")
            root_tmp = root_path.with_name(root_path.name + f".{os.getpid()}")
            root_tmp.write_text(json.dumps({"release_all": True}, separators=(",", ":")))
            os.replace(root_tmp, root_path)


class JobSamples:
    """Running totals for one job; summary() is the JSON line."""

    def __init__(self, meta: dict[str, Any], ncpu: int, started: float, interval: float = SAMPLE_S):
        self.meta, self.ncpu, self.started, self.interval = meta, max(1, ncpu), started, interval
        self.samples = 0
        self.load_sum = self.load_max = 0.0
        self.loads = 0
        self.job = self.others = self.outside = 0.0
        self.outside_by: dict[str, float] = {}
        self.runners_by: dict[str, float] = {}
        self.thermal: bool | None = None
        self.queues = 0
        self.running = self.blocked = 0.0
        self.blocked_max = 0
        self.disks = 0
        self.disk_sum = self.disk_max = 0.0
        self.busies = 0
        self.busy_sum = 0.0
        # free GiB on the disk the floor checks (--min-free-gib), at admission and at the end: what a job wrote
        self.disk_free_start: float | None = None
        self.disk_free_end: float | None = None
        # and the lowest sampled while it ran (DISK_JOB_PEAK_GIB's evidence: its peak is start minus min)
        self.disk_free_min: float | None = None

    def add(self, load: float | None, split: tuple[float, float, float, dict[str, float], dict[str, float]],
            interval: float, queue: tuple[int, int] | None = None, disk: float | None = None,
            busy: float | None = None, free: float | None = None) -> None:
        job, others, outside, by_outside, by_runner = split
        if free is not None and math.isfinite(free):
            self.disk_free_min = free if self.disk_free_min is None else min(self.disk_free_min, free)
        if queue is not None:
            self.queues += 1
            self.running += queue[0]
            self.blocked += queue[1]
            self.blocked_max = max(self.blocked_max, queue[1])
        if disk is not None:
            self.disks += 1
            self.disk_sum += disk
            self.disk_max = max(self.disk_max, disk)
        if busy is not None:
            self.busies += 1
            self.busy_sum += busy
        self.samples += 1
        if load is not None:
            self.loads += 1
            self.load_sum += load
            self.load_max = max(self.load_max, load)
        self.job += job
        self.others += others
        self.outside += outside
        for key, cores in by_outside.items():
            self.outside_by[key] = self.outside_by.get(key, 0.0) + cores * interval
        for key, cores in by_runner.items():
            self.runners_by[key] = self.runners_by.get(key, 0.0) + cores * interval

    def summary(self, ended: float) -> dict[str, Any]:
        n = max(1, self.samples)
        load_mean = self.load_sum / self.loads if self.loads else None
        outside_mean = self.outside / n
        reasons = []
        if self.samples and outside_mean >= max(CONTENDED_OUTSIDE_CORES, CONTENDED_OUTSIDE_SHARE * self.ncpu):
            top = max(self.outside_by, key=self.outside_by.get) if self.outside_by else "unknown"
            reasons.append(f"outside processes averaged {outside_mean:.1f} cores (top: {top})")
        busy_mean = self.busy_sum / self.busies if self.busies else None
        shared = self.others / n + outside_mean
        if (busy_mean is not None and busy_mean >= CONTENDED_BUSY_PCT
                and shared >= CONTENDED_SHARED_SHARE * self.ncpu):
            reasons.append(f"host CPU {busy_mean:.0f}% busy while other runner jobs and outside processes "
                           f"used {shared:.1f} of {self.ncpu} cores")
        blocked_mean = self.blocked / self.queues if self.queues else None
        if blocked_mean is not None and blocked_mean >= max(CONTENDED_BLOCKED, CONTENDED_BLOCKED_SHARE * self.ncpu):
            disk = f", disks {self.disk_sum / self.disks:.0f} MB/s" if self.disks else ""
            reasons.append(f"{blocked_mean:.1f} processes on average in uninterruptible wait (disk or memory){disk}")
        if self.thermal:
            reasons.append("thermal or performance limit reported")
        top_outside = sorted(self.outside_by.items(), key=lambda kv: -kv[1])[:TOP_OUTSIDE]
        return {
            "schema": JOB_SCHEMA, **self.meta, "event": "completed", "at": int(ended),
            "started_at": int(self.started), "ended_at": int(ended), "seconds": round(ended - self.started, 1),
            "ncpu": self.ncpu, "samples": self.samples, "sample_seconds": self.interval,
            "load": {"mean": None if load_mean is None else round(load_mean, 2), "max": round(self.load_max, 2)},
            "cores": {"job": round(self.job / n, 2), "other_runner_jobs": round(self.others / n, 2),
                      "outside": round(outside_mean, 2)},
            "queue": None if not self.queues else {
                "running": round(self.running / self.queues, 1),
                "blocked": round(self.blocked / self.queues, 1), "blocked_max": self.blocked_max},
            "cpu_busy_pct": None if busy_mean is None else round(busy_mean, 1),
            "disk_mb_s": None if not self.disks else {
                "mean": round(self.disk_sum / self.disks, 1), "max": round(self.disk_max, 1)},
            "top_outside": [{"process": k, "core_seconds": round(v)} for k, v in top_outside],
            "other_runner_jobs": [{"runner": k, "core_seconds": round(v)}
                                  for k, v in sorted(self.runners_by.items(), key=lambda kv: -kv[1])[:8]],
            "thermal_limited": self.thermal,
            "disk_free_start_gib": None if self.disk_free_start is None else round(self.disk_free_start, 1),
            "disk_free_end_gib": None if self.disk_free_end is None else round(self.disk_free_end, 1),
            # the volume's, so other jobs' writes count too: the peak this job saw is start minus min
            "disk_free_min_gib": None if self.disk_free_min is None else round(self.disk_free_min, 1),
            "verdict": "contended" if reasons else "clear", "reasons": reasons,
        }


JOB_LINE_MAX = 8192
JOB_LOG_LOCK_TRIES = 10  # job-started's lines: LOCK_NB tries 20 ms apart, then the line is skipped
JOB_LOG_LOCK_PAUSE_S = 0.02


def append_job_record(record: dict[str, Any], log: Path = JOB_LOG, wait: bool = True) -> bool:
    """One line per job; past JOB_LOG_MAX_BYTES keep the newest half, cut at a line boundary. The trim writes
    the kept half to a temporary file and renames it over the log while holding the old inode's lock, so a
    crash never leaves an empty log. A writer that got the lock on a replaced inode sees it (the path's inode
    differs) and reopens. wait=False (job-started) tries the lock for about 200 ms and then skips the line, so
    the log never delays a job. Returns whether the line was written."""
    log.parent.mkdir(parents=True, exist_ok=True)
    text = json.dumps(record, separators=(",", ":"), sort_keys=True)
    if len(text) > JOB_LINE_MAX:  # drop the bulkiest optional fields rather than cut the JSON
        slim = {k: v for k, v in record.items() if k not in ("top_outside", "other_runner_jobs", "decision")}
        text = json.dumps(slim, separators=(",", ":"), sort_keys=True)
    line = (text[:JOB_LINE_MAX] + "\n").encode()
    tries = JOB_LOG_LOCK_TRIES
    while True:
        with open(log, "a+b") as handle:
            if wait:
                fcntl.flock(handle, fcntl.LOCK_EX)
            else:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    tries -= 1
                    if tries <= 0:
                        return False
                    time.sleep(JOB_LOG_LOCK_PAUSE_S)
                    continue
            try:
                current = os.stat(log).st_ino
            except OSError:
                current = None
            if current != os.fstat(handle.fileno()).st_ino:
                continue  # a trim renamed a new file over the path while this writer waited: reopen it
            handle.write(line)
            handle.flush()
            if os.fstat(handle.fileno()).st_size > JOB_LOG_MAX_BYTES:
                handle.seek(0)
                data = handle.read()
                keep = data[len(data) // 2:]
                keep = keep[keep.find(b"\n") + 1:]
                tmp = log.with_name(f".{log.name}.trim-{os.getpid()}")
                try:
                    with open(tmp, "wb") as out:
                        out.write(keep)
                        out.flush()
                        os.fsync(out.fileno())
                    os.replace(tmp, log)  # still under the old inode's lock: waiters reopen the new file
                finally:
                    tmp.unlink(missing_ok=True)
            return True


def job_meta(repo: str | None, home_repo: str) -> dict[str, Any]:
    def env(name: str, limit: int = 120) -> str | None:
        value = os.environ.get(name)
        return value[:limit] if value else None
    job = env("GITHUB_JOB") or ""
    # the class admission used (the same workflow lookup), so the record agrees with the ledger
    klass, _ = job_class(job, repo, home_repo, job_workflow()) if job else ("unknown", False)
    return {"host": os.uname().nodename.split(".")[0][:64], "runner": env("RUNNER_NAME", 80), "job": job or None,
            "class": klass, "workflow": env("GITHUB_WORKFLOW"), "repository": repo,
            "run_id": env("GITHUB_RUN_ID", 32), "run_attempt": env("GITHUB_RUN_ATTEMPT", 8),
            "event_name": env("GITHUB_EVENT_NAME", 40), "ref": env("GITHUB_REF", 160),
            "head_ref": env("GITHUB_HEAD_REF", 160), "sha": env("GITHUB_SHA", 40)}


def compile_telemetry(meta: dict[str, Any]) -> dict[str, Any] | None:
    """Read the bounded CI compiler receipt left in RUNNER_TEMP, if it is this job's.

    The workflow owns the file and writes it only after the compile. The hook
    treats it as optional observation: malformed, stale or oversized data is
    ignored and never changes admission or job completion.
    """
    temp = os.environ.get("RUNNER_TEMP", "")
    if not temp:
        return None
    path = Path(temp) / COMPILE_TELEMETRY_FILE
    try:
        if path.stat().st_size > COMPILE_TELEMETRY_MAX_BYTES:
            return None
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None
    finally:
        with contextlib.suppress(OSError):
            path.unlink()
    if not isinstance(payload, dict) or payload.get("schema") != COMPILE_TELEMETRY_SCHEMA:
        return None
    for key in ("run_id", "run_attempt"):
        expected = meta.get(key)
        if expected and payload.get(key) != expected:
            return None
    result: dict[str, Any] = {"schema": COMPILE_TELEMETRY_SCHEMA}
    integer_fields = ("cacheable_tasks", "hits", "misses", "seed_distance")
    number_fields = ("hit_rate", "compile_seconds", "compile_wall_seconds", "fetch_seconds", "link_seconds")
    for key in integer_fields:
        value = payload.get(key)
        if value is None and key == "seed_distance":
            result[key] = None
        elif isinstance(value, int) and not isinstance(value, bool) and 0 <= value <= 10_000_000:
            result[key] = value
        else:
            return None
    for key in number_fields:
        value = payload.get(key)
        if value is None and key in ("hit_rate", "compile_wall_seconds", "fetch_seconds"):
            result[key] = None
        elif isinstance(value, (int, float)) and not isinstance(value, bool):
            # Check the JSON number's range before converting an arbitrarily
            # large integer to float; float conversion can raise OverflowError.
            if isinstance(value, float) and not math.isfinite(value):
                return None
            if not 0 <= value <= 10_000_000:
                return None
            result[key] = round(float(value), 6)
        else:
            return None
    backend = payload.get("cache_backend")
    if backend is not None:
        if backend not in ("local", "fleet"):
            return None
        result["cache_backend"] = backend
    if (result["hits"] + result["misses"] != result["cacheable_tasks"]
            or result["hits"] > result["cacheable_tasks"]
            or result["misses"] > result["cacheable_tasks"]):
        return None
    return result


def held_roots(state_dir: Path) -> list[str]:
    """The canonical roots (root-k) the runner's .roots file names now; take-root --switch rewrites it mid-job."""
    try:
        return [name for name in roots_file(state_dir).read_text().split() if name.startswith("root-")][:8]
    except (OSError, ValueError):
        return []


def job_event(event: str, meta: dict[str, Any], log: Path = JOB_LOG, **fields: Any) -> None:
    """Append a started or refused line (the sampler writes the completed one). Observation only: every
    failure is swallowed, so the log can never refuse or fail a job."""
    try:
        append_job_record({"schema": JOB_SCHEMA, **meta, "event": event, "at": int(time.time()), **fields}, log,
                          wait=False)
    except Exception:  # noqa: BLE001
        pass


def start_sampler(watch_pid: int, state_dir: Path, meta: dict[str, Any], log: Path = JOB_LOG,
                  interval: float = SAMPLE_S, disk_path: str | None = None) -> str:
    """Fork the detached sampler. Best effort: returns a note, never raises, never fails the job."""
    try:
        pid_file = sampler_file(state_dir)
        state_dir.mkdir(parents=True, exist_ok=True)
        pid_file.unlink(missing_ok=True)
        child = os.fork()
    except Exception as error:  # noqa: BLE001  (observation must not refuse a job)
        return f"job telemetry off ({type(error).__name__})"
    if child:
        os.waitpid(child, 0)
        return "job telemetry sampling"
    try:
        os.setsid()
        if os.fork():
            os._exit(0)
        null = os.open(os.devnull, os.O_RDWR)
        for std in (0, 1, 2):  # the runner reads the hook's output until EOF
            os.dup2(null, std)
        me = str(os.getpid())
        pid_file.write_text(me + "\n")
        started = time.time()
        started_mono = time.monotonic()
        samples = JobSamples(meta, os.cpu_count() or 1, started, interval)
        if disk_path:
            samples.disk_free_start = free_or_none(disk_path)
        deadline = time.monotonic() + HOLDER_MAX_S
        tick = 0
        dynamic_units = admitted_units = int(meta.get("units") or 0)
        dynamic_total = int(meta.get("units_total") or dynamic_units)
        dynamic_warmup = DYNAMIC_WARMUP_S + (300.0 if meta.get("class") == "compile-gui" else 0.0)
        low_since: float | None = None
        # what the job holds, read only while its Runner.Worker lives: job-completed removes .roots and .gui
        # after finish_sampler's short wait, and once the worker is gone the next job on this runner rewrites them
        holdings = (list(meta.get("roots") or []), bool(meta.get("gui")))
        while True:
            sampled_at = time.monotonic()
            try:
                rows = ps_rows()
                skip = {os.getpid()} | {pid for pid, ppid, _, _, _ in rows if ppid == os.getpid()}
                queue = run_queue()
                disk_busy = host_io()
                # XCTest's app is launched by testmanagerd/launchd rather than Runner.Worker. Only read
                # full process arguments when a test app is present, and keep that evidence off the log.
                test_apps = (telemetry_test_app_owners(processes())
                             if any(os.path.basename(row[4]) == "cmux DEV" for row in rows) else {})
                split = classify(rows, watch_pid, skip, test_apps)
                samples.add(load_average(), split, interval, queue, *disk_busy,
                            free=free_or_none(disk_path) if disk_path else None)
                if dynamic_units > 1 and dynamic_total > 1:
                    now = time.monotonic()
                    job_cores = split[0]
                    host_busy = disk_busy[1]
                    blocked = queue[1] if queue is not None else 0
                    memory = memory_pressure_level()
                    thermal = samples.thermal is True
                    quiet = (now - started_mono >= dynamic_warmup
                             and job_cores <= max(0.5, dynamic_units * DYNAMIC_LOW_JOB_SHARE)
                             and (host_busy is None or host_busy < DYNAMIC_TARGET_BUSY_PCT)
                             and blocked == 0 and (memory is None or memory < 2) and not thermal)
                    low_since = now if quiet and low_since is None else (low_since if quiet else None)
                    decision = dynamic_release_decision(now - started_mono, low_since, dynamic_units, dynamic_total,
                                                        job_cores, host_busy, blocked, memory, thermal,
                                                        admitted=admitted_units)
                    if decision:
                        keep, release_reason = decision
                        request_dynamic_release(state_dir, keep, {"reason": release_reason,
                                                                 "release_root": meta.get("class") == "compile-gui"})
                        job_event("capacity_release", meta, log, units_before=dynamic_units,
                                  units_after=keep, job_cores=round(job_cores, 2),
                                  host_cpu_busy_pct=host_busy, memory_pressure=memory,
                                  blocked=blocked, reason=release_reason)
                        dynamic_units = keep
                        low_since = None
                if tick % THERMAL_EVERY == 0:
                    limited = thermal_limited()
                    if limited is not None:
                        samples.thermal = bool(samples.thermal) or limited
            except Exception:  # noqa: BLE001  (a bad sample is skipped, not fatal)
                pass
            tick += 1
            stop_at = sampled_at + interval  # a sample takes about a second; keep the period at interval
            finished = False
            def still_ours():
                try:
                    return pid_file.read_text().strip() == me
                except OSError:
                    return False
            while True:  # check at least once, even when the sample outlasted the interval
                ours = still_ours()
                try:  # take-root/--switch and take-gui change these mid-job
                    # a reading counts only if our pid file is still in place on both sides of it: finish_sampler
                    # removes that file before job-completed removes .roots and .gui, which a slow sample can
                    # otherwise read as empty while the Runner.Worker is still alive
                    seen = (held_roots(state_dir), gui_file(state_dir).exists())
                    if ours and still_ours() and pid_alive(watch_pid):
                        holdings = seen
                except Exception:  # noqa: BLE001
                    pass
                if not ours or not pid_alive(watch_pid) or time.monotonic() >= deadline:
                    finished = True
                    break
                left = stop_at - time.monotonic()
                if left <= 0:
                    break
                time.sleep(min(1.0, left))
            if finished:
                break
        if disk_path:
            samples.disk_free_end = free_or_none(disk_path)
        record = samples.summary(time.time())
        final, gui = holdings
        if final != record.get("roots", []):
            record["roots_admitted"] = record.get("roots", [])
        record["roots"] = final
        record["gui"] = bool(record.get("gui")) or gui
        metrics = compile_telemetry(record)
        if metrics is not None:
            record["compile"] = metrics
        append_job_record(record, log)
    except Exception:  # noqa: BLE001
        pass
    finally:
        with contextlib.suppress(Exception):
            if pid_file.read_text().strip() == str(os.getpid()):
                pid_file.unlink()
        os._exit(0)


def finish_sampler(state_dir: Path, wait_s: float = 5.0) -> str:
    """job-completed: tell the sampler to write its record, and give it a moment to do so."""
    pid_file = sampler_file(state_dir)
    try:
        pid = int(pid_file.read_text().strip())
    except (OSError, ValueError):
        return "no job telemetry sampler"
    pid_file.unlink(missing_ok=True)
    deadline = time.monotonic() + wait_s
    while pid_alive(pid) and time.monotonic() < deadline:
        time.sleep(0.1)
    return "job telemetry recorded" if not pid_alive(pid) else f"job telemetry sampler {pid} still writing"


def leaked_test_app_pids(table: dict[int, tuple[int, str]], ignored_workers: set[int] | None = None) -> list[tuple[int, str]]:
    """Find exact CI test apps whose process tree and temp tree have no live job owner."""
    result: list[tuple[int, str]] = []
    ignored_workers = ignored_workers or set()
    for pid, (ppid, command) in table.items():
        match = LEAKED_TEST_APP.search(command)
        if not match or pid == os.getpid():
            continue
        temp = LEAKED_TEST_TEMP.match(match.group(1))
        if temp:
            # XCTest may reparent through testmanagerd or launchd. A live job process that still names the
            # same per-run temp tree is ownership evidence even when the app's parent is pid 1, but only
            # alongside that runner's live Runner.Worker. A stale command line alone is not ownership.
            prefix = temp.group(1) + "/"
            runner_prefix = temp.group(1).split("/_work/", 1)[0]
            worker = any(other not in ignored_workers and runner_prefix in cmd
                         and re.search(r"(?:^|/)Runner\.Worker(?:\s|$)", cmd)
                         for other, (_ppid, cmd) in table.items())
            if worker and any(other != pid and prefix in cmd and not LEAKED_TEST_APP.search(cmd)
                              for other, (_ppid, cmd) in table.items()):
                continue
        owner = pid
        owned = False
        for _ in range(256):
            if owner <= 1 or owner not in table:
                break
            if owner not in ignored_workers and re.search(r"(?:^|/)Runner\.Worker(?:\s|$)", table[owner][1]):
                owned = True
                break
            owner = table[owner][0]
        if not owned:
            result.append((pid, match.group(1)))
    return result


def cleanup_leaked_test_apps(ignored_workers: set[int] | None = None) -> list[str]:
    """Kill orphaned cmux DEV test apps and return bounded receipt lines."""
    try:
        found = leaked_test_app_pids(processes(), ignored_workers)
    except (OSError, subprocess.SubprocessError):
        return []
    killed: list[str] = []
    for pid, path in found:
        # Re-observe the exact pid and command immediately before each signal. A pid can be reused
        # between the survey and the kill, and a replacement must never inherit the old verdict.
        try:
            current = processes()
            if (pid, path) not in leaked_test_app_pids(current, ignored_workers):
                continue
        except (OSError, subprocess.SubprocessError):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        except OSError:
            continue
        deadline = time.monotonic() + LEAKED_APP_TERM_S
        while pid_alive(pid) and time.monotonic() < deadline:
            time.sleep(0.05)
        if pid_alive(pid):
            try:
                current = processes()
                if (pid, path) not in leaked_test_app_pids(current, ignored_workers):
                    continue
            except (OSError, subprocess.SubprocessError):
                continue
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGKILL)
        if not pid_alive(pid):
            killed.append(f"killed pid {pid} {path}")
    return killed


def leaked_media_app_pids(table: dict[int, tuple[int, str]], ignored_workers: set[int] | None = None) -> list[tuple[int, str]]:
    """Find detached cmux-ci-media apps only after every other runner job is gone."""
    ignored_workers = ignored_workers or set()
    workers = {pid for pid, (_ppid, command) in table.items()
               if pid not in ignored_workers and re.search(r"(?:^|/)Runner\.Worker(?:\s|$)", command)}
    if workers:
        # A media DerivedData name can be shared by concurrent runners. The
        # job-completed hook must never kill another runner's app by path.
        return []
    result: list[tuple[int, str]] = []
    for pid, (ppid, command) in table.items():
        match = LEAKED_MEDIA_APP.search(command)
        if not match or pid == os.getpid():
            continue
        owner = pid
        owned = False
        for _ in range(256):
            if owner <= 1 or owner not in table:
                break
            if owner not in ignored_workers and re.search(r"(?:^|/)Runner\.Worker(?:\s|$)", table[owner][1]):
                owned = True
                break
            owner = table[owner][0]
        if not owned:
            result.append((pid, match.group(1)))
    return result


def cleanup_leaked_media_apps(ignored_workers: set[int] | None = None, host_lock: str | None = None) -> list[str]:
    """Reap generated media helpers under admission, with process-instance checks.

    The host lock excludes new runner and fleet admissions between observation
    and signal. Run as the build user; a path never grants authority to root.
    At most sixteen candidates are handled per completed job.
    """
    if os.geteuid() == 0:
        return []  # job-owned cleanup runs as the build user, never as root
    host_lock = host_lock or HOST_LOCK
    try:
        fd = os.open(host_lock, os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return []
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return []
        return _cleanup_leaked_media_apps_locked(ignored_workers)
    finally:
        os.close(fd)


def _cleanup_leaked_media_apps_locked(ignored_workers: set[int] | None = None) -> list[str]:
    try:
        table = processes()
        found = leaked_media_app_pids(table, ignored_workers)[:16]
    except (OSError, subprocess.SubprocessError):
        return []
    killed: list[str] = []
    for pid, path in found:
        command = table[pid][1]
        identity = process_identity(pid)
        if identity is None:
            continue

        def still_orphan() -> bool:
            try:
                current = processes()
                return (current.get(pid, (0, None))[1] == command
                        and (pid, path) in leaked_media_app_pids(current, ignored_workers)
                        and process_identity(pid) == identity)
            except (OSError, subprocess.SubprocessError):
                return False

        if not still_orphan():
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            continue
        deadline = time.monotonic() + LEAKED_APP_TERM_S
        while process_alive(pid, identity) and time.monotonic() < deadline:
            time.sleep(0.05)
        if process_alive(pid, identity) and still_orphan():
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGKILL)
        if not process_alive(pid, identity):
            killed.append(f"media cleanup: ended pid {pid} {path}")
    return killed


# A test can start a process that detaches from the job: cmux-tui's headless daemon calls setsid and is
# reparented to launchd, and its terminal hosts stay its children. When the test process is killed before its
# teardown (the hang watchdog, a step timeout, a cancel), nothing ends them. On 2026-10-11 the minis held ~60
# such daemons from cmux-next's CmuxNext tests, 1-2 days old, each running
# <runner>/_work/cmux/cmux/cmux-tui/target/hosted/tree/<sha>/cmux-tui. At job-completed this runner's job has
# ended and no other job uses its _work, so a process whose command runs from there, and its descendants, are
# leftovers. Another runner's _work is never touched: that runner may be mid-job.
#
# A test can also copy its binary out of _work first (cmux-tui to $TMPDIR/cnd-bin-*, a remote-connect drill to
# /tmp/slr-*), so only the orphan's working directory still points into _work. On 2026-10-21 two of those on
# cmuxs-mac-mini-6 held actions-runner-glaeda-11/_work/cmux for 6 and 9 hours, past every job-completed. So a
# process launchd adopted (ppid 1) whose cwd is inside _work is a leftover too, and the listener gate sweeps its own
# idle runner's _work every GATE_SWEEP_S for orphans no job-completed reached. Spared always: the runner and glaeda
# processes (leftover_spared), git maintenance, and whatever ~/.cache/git-repair/protected lists.
LEFTOVER_TERM_S = 3.0
GATE_SWEEP_S = 600.0
GIT_REPAIR_PROTECTED = Path.home() / ".cache/git-repair/protected"
LEFTOVER_SPARED_NAMES = frozenset({"Runner.Listener", "Runner.Worker", "run.sh", "run-helper.sh", "listen.sh",
                                   "job-started.sh", "job-completed.sh",
                                   # people's and agents' sessions, which a dropped ssh hands to launchd
                                   "tmux", "screen", "zellij", "abduco", "dtach", "mosh-server", "sshd",
                                   "sshd-session", "login", "claude", "codex", "acpmux", "opencode", "gemini"})
GIT_MAINTENANCE = frozenset({"fetch", "clone", "gc", "repack", "rev-list", "pack-objects", "index-pack", "backfill",
                             "fsck", "maintenance", "prune", "upload-pack", "remote-http", "remote-https"})


def job_work_dir() -> str | None:
    """This runner's _work directory, from the job's RUNNER_TEMP (<runner>/_work/_temp)."""
    temp = os.environ.get("RUNNER_TEMP", "").rstrip("/")
    work = os.path.dirname(temp)
    if not temp or os.path.basename(work) != "_work" or "/actions-runner" not in work:
        return None
    return work


def leftover_spared(command: str) -> bool:
    """The runner's and glaeda's own processes (glaeda-disk's detached bound runs as `python -c ... glaeda-disk`),
    git maintenance, and people's or agents' sessions (a tmux server or an agent left running from a checkout), by
    executable or script name, never by a path's directories (every runner path contains "glaeda")."""
    argv = command.split()
    if not argv:
        return True
    names = [os.path.basename(arg.strip("'\"")) for arg in argv]
    if any(name.startswith("glaeda") for name in names):
        return True
    if any(name in LEFTOVER_SPARED_NAMES for name in names[:2]):
        return True
    if names[0] == "git" or names[0].startswith("git-"):
        return names[0][4:] in GIT_MAINTENANCE or any(arg in GIT_MAINTENANCE for arg in argv[1:8])
    return False


def tty_pids() -> set[int] | None:
    """Processes with a controlling terminal: someone's session, never a job's (runner jobs have none). None when
    ps cannot tell."""
    try:
        out = subprocess.run([PS, "-axo", "pid=,tty="], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                             timeout=10, check=True, env={"LC_ALL": "C"}).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    found: set[int] = set()
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0].isdigit() and parts[1] not in ("??", "?", "-"):
            found.add(int(parts[0]))
    return found


def git_repair_protected(table: dict[int, tuple[int, str]], path: Path | None = None) -> set[int] | None:
    """Pids ~/.cache/git-repair/protected lists ("PID<TAB>why" lines), and their descendants. None when the file
    exists but cannot be read."""
    path = path or GIT_REPAIR_PROTECTED
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return set()
    except OSError:
        return None
    keep: set[int] = set()
    for line in text.splitlines():
        first = line.split(None, 1)[0] if line.strip() else ""
        if first.isdigit() and int(first) in table:
            keep |= {int(first), *descendants(int(first), table)}
    return keep


def process_cwds() -> dict[int, str] | None:
    """pid -> working directory for this user's processes, from lsof. None when lsof cannot tell."""
    try:
        out = subprocess.run([LSOF, "-nP", "-w", "-a", "-u", str(os.getuid()), "-d", "cwd", "-Fpn"],
                             stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10,
                             check=False).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    cwds: dict[int, str] = {}
    pid = 0
    for line in out.splitlines():
        if line[:1] == "p" and line[1:].isdigit():
            pid = int(line[1:])
        elif line[:1] == "n" and pid:
            cwds[pid] = line[1:]
    return cwds or None  # this process always has a cwd, so an empty answer is a failed look


def work_leftover_pids(table: dict[int, tuple[int, str]], work: str, protected: set[int],
                       cwds: dict[int, str] | None = None, orphans_only: bool = False,
                       ttys: set[int] | None = None) -> list[tuple[int, str]]:
    """Processes whose command runs from `work`, or orphans (ppid 1) without a terminal (`ttys`) whose cwd (from
    `cwds`) is inside it, and their descendants, minus `protected` (the hook and its ancestors), processes with a
    terminal and leftover_spared ones, with everything under them. orphans_only takes command roots only when launchd adopted them too. Roots
    come before their descendants."""
    prefixes = tuple({work.rstrip("/") + "/", os.path.realpath(work).rstrip("/") + "/"})
    roots = {pid for pid, (ppid, cmd) in table.items()
             if pid not in protected and cmd.lstrip("'\"").startswith(prefixes) and (ppid == 1 or not orphans_only)}
    roots |= {pid for pid, cwd in (cwds or {}).items()
              if pid in table and pid not in protected and table[pid][0] == 1 and pid not in (ttys or set())
              and (cwd + "/").startswith(prefixes)}
    found: list[tuple[int, str]] = []
    seen: set[int] = set()
    for root in sorted(roots):
        skipped: set[int] = set()
        for pid in [root, *descendants(root, table)]:
            if pid in seen or pid in skipped:
                continue
            if (pid in protected or pid in (ttys or set()) or leftover_spared(table[pid][1])
                    or table[pid][0] in skipped):
                skipped.add(pid)  # nothing under a spared process (or one with a terminal) is a leftover either
                continue
            seen.add(pid)
            found.append((pid, table[pid][1]))
    return found


def protected_pids(table: dict[int, tuple[int, str]]) -> set[int]:
    """This hook and every ancestor up to launchd."""
    keep: set[int] = set()
    pid = os.getpid()
    for _ in range(256):
        if pid <= 1 or pid in keep:
            break
        keep.add(pid)
        pid = table.get(pid, (1, ""))[0]
    return keep


def end_leftovers(found: list[tuple[int, str]],
                  current: Callable[[], dict[int, str] | None]) -> list[tuple[int, str]]:
    """SIGTERM each (pid, command) that current() still shows with that command, wait LEFTOVER_TERM_S, then SIGKILL
    the ones still there. current() returns pid -> command, or None to veto (nothing more is signalled), so a
    reused pid is never hit. Returns the ended ones."""
    try:
        now = current()
    except (OSError, subprocess.SubprocessError):
        now = None
    if not now:
        return []
    signalled: list[tuple[int, str]] = []
    for pid, command in found:
        if now.get(pid) == command:
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGTERM)
                signalled.append((pid, command))
    deadline = time.monotonic() + LEFTOVER_TERM_S
    while any(pid_alive(pid) for pid, _ in signalled) and time.monotonic() < deadline:
        time.sleep(0.1)
    try:
        now = current() or {}
    except (OSError, subprocess.SubprocessError):
        now = {}
    for pid, command in signalled:
        if pid_alive(pid) and now.get(pid) == command:
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGKILL)
    return [(pid, command) for pid, command in signalled if not pid_alive(pid)]


def command_table() -> dict[int, str]:
    return {pid: command for pid, (_ppid, command) in processes().items()}


def cleanup_job_leftovers(work: str | None = None) -> list[str]:
    """job-completed: end processes left running from this runner's _work. Each pid is signalled only while
    its command is unchanged, so a reused pid is never hit."""
    work = work or job_work_dir()
    if not work:
        return []
    try:
        table = processes()
    except (OSError, subprocess.SubprocessError):
        return []
    keep = git_repair_protected(table)
    if keep is None:
        return []  # a protected list we cannot read protects everything
    # Without lsof or a terminal list the cwd rule finds nothing, and the command rule works as before.
    ttys = tty_pids()
    cwds = process_cwds() if ttys is not None else None
    found = work_leftover_pids(table, work, protected_pids(table) | keep, cwds, ttys=ttys)
    if not found:
        return []
    ended = end_leftovers(found, command_table)
    if not ended:
        return []
    names = ", ".join(sorted({executable_name(cmd) for _pid, cmd in ended}))[:300]
    return [f"ended {len(ended)} leftover process(es) from {home_relative(work)}: {names}"]


def executable_name(command: str) -> str:
    return os.path.basename(command.split(None, 1)[0].strip("'\"")) if command.strip() else "?"


def home_relative(path: str) -> str:
    home = os.fspath(Path.home()).rstrip("/")
    return "~" + path[len(home):] if home and (path == home or path.startswith(home + "/")) else path


def sweep_idle_leftovers(runner_dir: Path) -> list[str]:
    """The gate's sweep: end orphans (ppid 1) left in this runner's own _work by jobs whose job-completed missed
    them, while no Runner.Worker of this runner exists. Fails closed: no ps, lsof or protected-list evidence, or a
    Worker appearing before a signal, ends nothing. Notes name pid, executable and cwd under _work, never
    arguments."""
    if os.geteuid() == 0:
        return []  # cleanup runs as the build user, never as root
    work = os.fspath(runner_dir / "_work")
    worker = os.fspath(runner_dir / "bin" / "Runner.Worker")

    def idle(table: dict[int, tuple[int, str]]) -> bool:
        return not any(worker in command for _ppid, command in table.values())

    table = processes()
    if not idle(table):
        return []
    ttys = tty_pids()
    cwds = process_cwds()
    keep = git_repair_protected(table)
    if ttys is None or cwds is None or keep is None:
        return []
    found = work_leftover_pids(table, work, protected_pids(table) | keep, cwds, orphans_only=True, ttys=ttys)
    if not found:
        return []

    def current() -> dict[int, str] | None:
        now = processes()
        return {pid: command for pid, (_ppid, command) in now.items()} if idle(now) else None

    notes = []
    prefixes = (work.rstrip("/") + "/", os.path.realpath(work).rstrip("/") + "/")
    for pid, command in end_leftovers(found[:32], current):
        cwd = cwds.get(pid, "")
        prefix = next((p for p in prefixes if cwd.startswith(p)), None)
        where = "_work/" + cwd[len(prefix):] if prefix else "outside _work"
        notes.append(f"ended leftover pid {pid} ({executable_name(command)}, cwd {where})")
    return notes


def find_disk(explicit: str | None) -> str | None:
    if explicit:
        return explicit if os.path.isfile(explicit) else None
    found = shutil.which("glaeda-disk")
    if found:
        return found
    fallback = Path.home() / ".local/bin/glaeda-disk"
    return os.fspath(fallback) if fallback.is_file() else None


def hooks_floor_gib() -> float:
    """The floor glaeda-disk's runner_floor_gib reads by itself: the highest --min-free-gib among this user's
    runner hooks."""
    floor = 0.0
    for script in Path.home().glob(f"actions-runner*/{RUNNER_HOOK_SCRIPT}"):
        with contextlib.suppress(OSError, UnicodeDecodeError):
            floor = max(floor, min_free_gib(script.read_text()))
    return floor


def disk_argv(explicit: str | None, floor_gib: float = 0.0) -> list[str] | None:
    """glaeda-disk --pressure --apply, told floor_gib (--floor-gib) only when it would not read that floor from the
    runner hooks itself, so a glaeda-disk from before --floor-gib still runs. None when it is not installed."""
    disk = find_disk(explicit)
    if disk is None:
        return None
    floor = ["--floor-gib", f"{floor_gib:g}"] if floor_gib > hooks_floor_gib() else []
    return [sys.executable, disk, "--pressure", "--apply", "--top", "0", *floor]


def floor_disk_env(caller: str) -> dict[str, str]:
    """A floor eviction's environment: it must free space now, so glaeda-disk never folds it into the queued pass
    (GLAEDA_DISK_HOOK_PASS, as the queue's own pass), and its run line names the caller."""
    return {**os.environ, "GLAEDA_DISK_HOOK_PASS": "1", "GLAEDA_DISK_CALLER": caller}


# glaeda-disk's answers when it ran no pass because another holds evict.lock or measure.lock (DISK_BOUND's BUSY)
DISK_BUSY = (b"another eviction running", b"another measurement running")


def disk_pressure_run(explicit: str | None, floor_gib: float = 0.0,
                      timeout: float = DISK_TIMEOUT_S) -> tuple[str, bool]:
    """The floor eviction before refusing a job (evict): its one-line note, and whether glaeda-disk skipped as busy
    (DISK_BUSY: another pass held its lock first, so nothing was freed and evict() waits for that pass instead). Best
    effort; never raises."""
    try:
        argv = disk_argv(explicit, floor_gib)
        if argv is None:
            return "glaeda-disk not installed; skipped", False
        override = float(os.environ.get("GLAEDA_RUNNER_DISK_TIMEOUT") or timeout)
        timeout = min(override, timeout) if math.isfinite(override) and override > 0 else timeout  # never past it
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            timeout=timeout, check=False, env=floor_disk_env("runner hook floor eviction"),
        )
        out = result.stdout if isinstance(result.stdout, bytes) else b""
        skipped = any(mark in out for mark in DISK_BUSY)
        return f"glaeda-disk exited {result.returncode}{' (busy)' if skipped else ''}", skipped
    except subprocess.TimeoutExpired:
        return "glaeda-disk timed out; continuing", False
    except Exception as error:  # noqa: BLE001  (never fail the job on housekeeping)
        return f"glaeda-disk skipped: {type(error).__name__}", False


# job-completed's passes: one at a time per host, triggers coalesced, none started above the target. Every job on
# every runner started its own detached pass, and a pass takes 11-28 min under pressure, so on cmux14 2889 of 2986
# passes (2026-10-24..26) skipped as eviction_busy, each still starting glaeda-disk and measuring (median 10.6 s).
DISK_PASS_LOCK = "hook-pass.lock"  # held by the one bounding process running passes (DISK_BOUND), never by a hook
DISK_PASS_PENDING = "hook-pass.pending"  # a trigger no pass has started after yet
DISK_PASS_LIFETIME_FACTOR = 4  # a bound serves follow-ups for at most this many pass bounds, then leaves the trigger
HOOK_SKIP_ABOVE_TARGET = "above target (runner hook)"
HOOK_SKIP_COALESCED = "coalesced into the running pass (runner hook)"
HOOK_SKIP_MARK = "(runner hook)"
DISK_TARGET_MAX_AGE_S = 6 * 3600  # an older target is not trusted: the trigger runs its pass

DISK_BOUND = """# glaeda-disk-bound (leftover_spared reads this name)
# argv: TIMEOUT LIFETIME LOCK PENDING EVICT_LOCK GLAEDA-DISK-ARGV...
# Holds LOCK while it runs passes, one at a time; never runs one without it. A trigger writes PENDING, then starts
# this; one that finds LOCK held exits at once and leaves PENDING to the holder. The holder renames PENDING to
# PENDING.claimed right before a pass that starts after it and removes that only once the pass ran (it stays when
# another evict.lock holder outlasted the bound or glaeda-disk skipped as busy), and checks both again after it lets
# go of LOCK, so no trigger is dropped.
# Each pass is bounded by TIMEOUT and the holder by LIFETIME; a trigger left then is served by the next one.
import fcntl, os, subprocess, sys, time
timeout, lifetime = float(sys.argv[1]), float(sys.argv[2])
lock, pending, evict = sys.argv[3:6]
argv = sys.argv[6:]
os.environ["GLAEDA_DISK_HOOK_PASS"] = "1"  # glaeda-disk's HOOK_PASS_ENV: this is the queue's own pass
os.environ.setdefault("GLAEDA_DISK_CALLER", "runner hook pass")
end = time.monotonic() + lifetime
BUSY = (b"another eviction running", b"another measurement running", b"deferred: a CI job is running")

claimed = pending + ".claimed"  # the triggers the current pass serves; removed only once a pass ran after them

def waiting():
    return os.path.lexists(pending) or os.path.lexists(claimed)

def evict_free(deadline):
    try:
        fd = os.open(evict, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return True  # no lock file: no pass has ever run
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    return False
                time.sleep(1)
                continue
            except OSError:
                return True
            fcntl.flock(fd, fcntl.LOCK_UN)
            return True
    finally:
        os.close(fd)

def run_pass():
    # another glaeda-disk --apply (the gate's, job-started's, the LaunchAgent's) holding evict.lock would only make
    # this pass skip as eviction_busy: wait for it within the bound. True when glaeda-disk ran a pass.
    deadline = min(time.monotonic() + timeout, end)
    if not evict_free(deadline) or deadline - time.monotonic() <= 0:
        return False
    try:
        done = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=deadline - time.monotonic(), check=False)
    except subprocess.TimeoutExpired:
        return True  # it ran, cut at its bound
    except OSError:
        return False  # glaeda-disk did not start: keep the trigger
    return done.returncode == 0 and not any(busy in (done.stdout or b"") for busy in BUSY)

try:
    held = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
except OSError:
    sys.exit(0)  # never an unlocked pass; the trigger stays pending
while time.monotonic() < end:
    try:
        fcntl.flock(held, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)  # a pass is running; it serves PENDING
    try:
        misses = 0
        while waiting() and time.monotonic() < end:
            try:
                os.replace(pending, claimed)  # triggers from here on wait for the next pass
            except FileNotFoundError:
                pass
            except OSError:
                sys.exit(0)  # cannot claim it: leave it to the next bound, never a pass for an unclaimed trigger
            if not os.path.lexists(claimed):
                continue
            if run_pass():
                misses = 0
                try:
                    os.unlink(claimed)
                except FileNotFoundError:
                    pass
                except OSError:
                    sys.exit(0)  # cannot mark it served: leave it to the next bound rather than pass again
            else:
                time.sleep(min(30, 2 ** misses, max(0, end - time.monotonic())))
                misses += 1
    finally:
        fcntl.flock(held, fcntl.LOCK_UN)
    if not waiting():
        break
"""


def disk_state_dir() -> Path:
    """glaeda-disk's own state directory, where its evict.lock lives; the hook's pass lock and trigger sit beside it."""
    return evict_lock_path().parent


def disk_run_log() -> Path:
    """glaeda-disk's RUN_LOG: one JSON line per --apply run, with the target it worked to."""
    return Path.home() / ("Library/Logs/glaeda-disk-runs.jsonl" if sys.platform == "darwin"
                          else ".local/state/glaeda/disk-runs.jsonl")


def disk_config_sha256(disk: str | None) -> str | None:
    """glaeda-disk's config_sha256 for the glaeda-disk this hook runs: its bytes and disk-policy.json's."""
    if disk is None:
        return None
    h = hashlib.sha256()
    for path in (Path(os.path.abspath(disk)), Path.home() / ".config/glaeda/disk-policy.json"):
        with contextlib.suppress(OSError):
            h.update(path.read_bytes())
        h.update(b"\0")
    return h.hexdigest()


def disk_targets(log: Path | None = None, now: float | None = None, config: str | None = None) -> dict[str, int] | None:
    """Every filesystem's exact target (mount: bytes) from glaeda-disk's newest own --pressure run line, or None (run
    the pass) unless that line is a plain `--pressure --apply`'s (default_targets) under the same glaeda-disk and
    disk-policy.json (config, its config_sha256), at least this runner's floor,
    under DISK_TARGET_MAX_AGE_S old and well formed. The hook's own skip lines and other modes' lines are passed over;
    an older pressure line never stands in for the newest."""
    try:
        with (log or disk_run_log()).open("rb") as f:
            f.seek(0, os.SEEK_END)
            start = max(0, f.tell() - 262144)
            f.seek(start)
            lines = f.read().decode("utf-8", "replace").splitlines()[1 if start else 0:]
    except OSError:
        return None
    for line in reversed(lines):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except ValueError:
            return None
        if not isinstance(row, dict):
            return None
        if row.get("mode") != "pressure" or HOOK_SKIP_MARK in str(row.get("skipped") or ""):
            continue
        try:
            at = datetime.datetime.strptime(str(row.get("at")), "%Y-%m-%dT%H:%M:%S%z").timestamp()
            floor = float(row.get("floor_gib"))
        except (TypeError, ValueError):
            return None
        targets = row.get("targets")
        if ((time.time() if now is None else now) - at > DISK_TARGET_MAX_AGE_S or row.get("default_targets") is not True
                or config is None or row.get("config_sha256") != config
                or not math.isfinite(floor) or floor < hooks_floor_gib() or not isinstance(targets, dict) or not targets
                or not all(isinstance(v, int) and not isinstance(v, bool) and v > 0 for v in targets.values())):
            return None
        return {str(mount): value for mount, value in targets.items()}
    return None


def disk_short(targets: dict[str, int]) -> str | None:
    """The first filesystem below its target ("<free> of <target> GiB on <mount>"), "" when every one is met, or None
    when one cannot be read (run the pass)."""
    for mount, target in targets.items():
        try:
            free = shutil.disk_usage(mount).free
        except OSError:
            return None
        if free < target:
            return f"{free / 1024**3:.1f} of {target / 1024**3:g} GiB on {mount}"
    return ""


def disk_skip_line(why: str, free: float, targets: dict[str, int] | None) -> None:
    """A skipped trigger's line in glaeda-disk's RUN_LOG, in its own schema, so skips are counted where passes are."""
    home = None
    with contextlib.suppress(OSError):
        home = (targets or {}).get(os.fspath(Path.home()), None) or next(
            (v for m, v in (targets or {}).items() if os.stat(m).st_dev == Path.home().stat().st_dev), None)
    row = {"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node(), "mode": "pressure", "off": False,
           "free_gib_before": round(free, 1), "free_gib_after": round(free, 1),
           "target_gib": None if home is None else round(home / 1024**3, 1), "target_bytes": home,
           "targets": targets, "default_targets": False, "config_sha256": None, "floor_gib": None,
           "caller": "runner hook trigger", "evict_owner": None, "reclaimed_gib": 0.0,
           "reached": None if home is None else free * 1024**3 >= home,
           "blocked": {}, "duration_s": 0.0, "skipped": why, "cmux_next_ci_over_gib": None}
    with contextlib.suppress(OSError):
        log = disk_run_log()
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("a") as f:
            f.write(json.dumps(row) + "\n")


def disk_pass_running(lock: Path) -> bool:
    """True when a bounding process holds the pass lock. Probes with a non-blocking exclusive flock it lets go of at
    once; the bounding process's own try decides, so a probe that races it only costs a fork."""
    try:
        fd = os.open(lock, os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    except OSError:
        return False
    finally:
        os.close(fd)  # closing drops a lock the probe took
    return False


def disk_pressure_detached(explicit: str | None, timeout: float = BACKGROUND_DISK_TIMEOUT_S) -> str:
    """job-completed's pass: glaeda-disk --pressure in a detached process (DISK_BOUND), each pass bounded by
    BACKGROUND_DISK_TIMEOUT_S, so the runner takes its next job at once ("Complete runner" took 121-124 s on main's
    macOS jobs while job-completed waited on it). One pass at a time per host: a trigger above glaeda-disk's target is
    skipped (a stat and a log read); otherwise it writes the pending trigger, and while a pass runs it is coalesced
    into it (the running pass does one more for every batch of triggers), so no trigger is lost and none queues.
    The child leaves the runner's session and execs with RUNNER_TRACKING_ID dropped, so the runner's orphan cleanup
    does not kill it, and closes every inherited fd, so it holds no lock of this job's. Best effort: returns a note,
    never raises."""
    try:
        argv = disk_argv(explicit)
        if argv is None:
            return "glaeda-disk not installed; skipped"
        timeout = float(os.environ.get(BACKGROUND_DISK_TIMEOUT_ENV) or timeout)
        if not math.isfinite(timeout) or timeout <= 0:
            timeout = BACKGROUND_DISK_TIMEOUT_S
        timeout = min(timeout, BACKGROUND_DISK_TIMEOUT_MAX_S)
        state, log = disk_state_dir(), disk_run_log()
        free, targets = free_gib(str(Path.home())), disk_targets(log, config=disk_config_sha256(argv[1]))
        if targets is not None and disk_short(targets) == "":
            disk_skip_line(HOOK_SKIP_ABOVE_TARGET, free, targets)
            return f"glaeda-disk skipped: every filesystem at or above its target ({free:.1f} GiB free on home)"
        state.mkdir(parents=True, exist_ok=True)
        lock, pending = state / DISK_PASS_LOCK, state / DISK_PASS_PENDING
        pending.touch()  # before the probe: a holder that lets go after it still sees this trigger
        if disk_pass_running(lock):
            disk_skip_line(HOOK_SKIP_COALESCED, free, targets)
            return "glaeda-disk pass already running; this trigger is coalesced into its follow-up"
        env = {key: value for key, value in os.environ.items() if key != "RUNNER_TRACKING_ID"}
        bound = [f"{timeout * DISK_PASS_LIFETIME_FACTOR:g}", os.fspath(lock), os.fspath(pending),
                 os.fspath(evict_lock_path())]
        child = os.fork()
    except Exception as error:  # noqa: BLE001  (never fail the job on housekeeping)
        return f"glaeda-disk skipped: {type(error).__name__}"
    if child == 0:  # detach twice so the runner never waits on the pass
        try:
            os.setsid()
            # the middle process exits only once the pass has exec'd (the close-on-exec end reads EOF), so when the
            # hook returns no process of this job's environment, RUNNER_TRACKING_ID included, is left to clean up
            execd, execing = os.pipe()  # both close-on-exec
            if os.fork():
                os.close(execing)
                with contextlib.suppress(OSError):
                    select.select([execd], [], [], 10)
                os._exit(0)
            os.close(execd)
            null = os.open(os.devnull, os.O_RDWR)
            for std in (0, 1, 2):  # the runner reads the hook's output until EOF
                os.dup2(null, std)
            limit = os.sysconf("SC_OPEN_MAX")
            limit = limit if limit > 0 else 65536
            os.closerange(3, execing)
            os.closerange(execing + 1, limit)
            # exec, so the bounding process's own environment is clean too, not only glaeda-disk's
            os.execve(sys.executable, [sys.executable, "-c", DISK_BOUND, f"{timeout:g}", *bound, *argv], env)
        finally:
            os._exit(0)
    with contextlib.suppress(OSError):
        os.waitpid(child, 0)
    return f"glaeda-disk started in the background (bounded by {timeout:g} s)"


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog=PREFIX)
    p.add_argument("phase", choices=("job-started", "job-completed", "check", "listen", "take-root", "take-gui",
                                     "admit", "release", "fits", "busy"),
                   help="check: the eligibility gate only, read-only (no lock, no rustup change); "
                        "listen: run the runner's run.sh under the listener gate (the LaunchAgent's program); "
                        "admit, release, fits: the build worker's ci-step admission (one JSON line each); "
                        "busy --runner-dir D: exit 3 when that runner is idle, 0 when it has a job or it cannot tell")
    p.add_argument("--class", dest="step_class", choices=STEP_CLASSES, help="admit: the ci-step's class")
    p.add_argument("--job-key", help="admit, release: the ci-step's key (runner name, run id and attempt)")
    p.add_argument("--runner-dir", type=Path, help="listen: the runner directory whose run.sh the gate runs")
    p.add_argument("--root", help="take-root: the canonical root to hold, /private/tmp/cmux-ci[-N] or N")
    p.add_argument("--wait", type=float, default=0, help="take-root, take-gui: seconds to wait for the token")
    p.add_argument("--switch", action="store_true",
                   help="take-root: let go of the root this job holds (its own holder) and take ROOT instead")
    p.add_argument("--fit-units", type=int, default=1,
                   help="listen: hold the listener unless this many units are free (2 for a glaeda-ios-sim side runner)")
    p.add_argument("--no-waiters", action="store_true",
                   help="listen: only an exclusive holder or a reservation stops the listener (one runner per mini)")
    p.add_argument("--adopt", type=int, default=0, help=argparse.SUPPRESS)
    p.add_argument("--parse-only", action="store_true", help=argparse.SUPPRESS)  # the gate's reload check
    p.add_argument("--allowed-repo", action="append", default=[])
    p.add_argument("--allowed-owner")
    p.add_argument("--home-repo", default=DEFAULT_HOME_REPO,
                   help="the repository whose job ids JOB_CLASSES names; other repos are guests (see job_class)")
    p.add_argument("--guest-wait", type=float, default=GUEST_WAIT_S,
                   help="seconds a guest job waits for room on a full mini before it is refused")
    p.add_argument("--gui-wait", type=float, default=None,
                   help="cap, in seconds, on a home-repository job's wait for capacity (default: no cap)")
    p.add_argument("--allow-event", action="append", default=[],
                   help="admit another event name (pull_request_target is always refused)")
    p.add_argument("--trusted-ref", help="admit only push and schedule jobs on this ref (needs --trusted-repo)")
    p.add_argument("--trusted-repo", help="the one repository --trusted-ref admits")
    p.add_argument("--trusted-next-nightly", action="store_true",
                   help="also admit only cmux nightly-next's exact nightly app push on attempt 1")
    p.add_argument("--dev-compile-runner", action="store_true",
                   help="this instance admits only cmux NEXT DEV Release compile jobs (shared host capacity)")
    p.add_argument("--disk", help="glaeda-disk path (default: PATH, then ~/.local/bin)")
    p.add_argument("--no-disk", action="store_true")
    p.add_argument("--no-telemetry", action="store_true", help="do not sample the host while the job runs")
    p.add_argument("--test-keychain", action="store_true",
                   help="give the job an unlocked, passwordless default keychain for tests (PR runner minis)")
    p.add_argument("--recycle-testmanagerd", action="store_true",
                   help="job-started, take-gui: a job taking the gui token restarts the user's testmanagerd "
                        "while no test runs (PR runner minis); a daemon that outlives SIGKILL refuses the job")
    p.add_argument("--testmanagerd-program", default=TESTMANAGERD, help=argparse.SUPPRESS)
    p.add_argument("--xctest-pattern", type=re.compile, default=XCTEST_RUNNING, help=argparse.SUPPRESS)
    p.add_argument("--job-log", type=Path, default=JOB_LOG, help=argparse.SUPPRESS)
    p.add_argument("--min-free-gib", type=float, default=0, help="refuse a job below this much free disk")
    p.add_argument("--require-eligible", action="store_true",
                   help="refuse unless this is an eligible Glaeda node on its class receipt's toolchain")
    p.add_argument("--fleet-class", help="hardware class naming class-acceptance/<class>.json (with --require-eligible)")
    p.add_argument("--toolchain-xcode", help="the Xcode app the class receipt's xcodeVersion and SDK refer to")
    p.add_argument("--capacity-units", type=int, default=0,
                   help="weighted capacity shared by this mini's runners (0: one job holds the host lock alone)")
    p.add_argument("--compile-slots", type=int, default=1,
                   help="compiles at once on this mini (persistent-dd tokens; >1 needs per-runner compile state)")
    p.add_argument("--canonical-roots", type=int, default=1,
                   help="canonical roots on this mini (root-N tokens; one compile or app-host consumer per root)")
    p.add_argument("--instance", type=int, default=0,
                   help="this runner's glaeda-cmux-runner instance: it prefers canonical root instance+1")
    p.add_argument("--gui-runner", action="store_true",
                   help="this is the mini's gui runner (the gui pool label): the listener gate holds it while the "
                        "gui token, every canonical root or every unit is taken")
    p.add_argument("--gui-token", default="gui",
                   help="capacity ledger token for this runner's desktop session (default: gui)")
    p.add_argument("--session-runner", action="store_true",
                   help="this is one of the mini's session runners (only the session pool label, guiRunners above "
                        "1): its jobs need the logged-in session but no gui token or root, so the listener gate "
                        "holds it only while units are short, a job here waits for units, or the console is locked")
    p.add_argument("--fast-runner", action="store_true",
                   help="this is the mini's fast runner (the fast pool label): a FAST_JOBS job here takes the fast "
                        "tokens instead of shared units, and the listener gate holds it while a fast token is taken")
    p.add_argument("--capacity-dir", type=Path, default=Path(FLEET_DIR) / "capacity", help=argparse.SUPPRESS)
    p.add_argument("--host-lock", default=HOST_LOCK, help=argparse.SUPPRESS)
    p.add_argument("--reservation", default=RESERVATION, help=argparse.SUPPRESS)
    p.add_argument("--state-dir", type=Path, default=Path.home() / ".local/state/glaeda/cmux-runner",
                   help=argparse.SUPPRESS)
    p.add_argument("--watch-pid", type=int, default=0, help=argparse.SUPPRESS)
    args = p.parse_args(argv)
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", args.gui_token) or args.gui_token == FRESH_RESERVE_TOKEN:
        p.error(f"--gui-token must be a simple capacity token name other than {FRESH_RESERVE_TOKEN}")
    if args.parse_only:
        return 0
    if args.phase == "busy":
        return runner_busy_main([os.fspath(args.runner_dir)] if args.runner_dir else [])
    args.min_free_gib = runner_floor_gib(args.min_free_gib, args.gui_runner or args.session_runner)
    # the floor a job is refused under, after eviction (DISK_JOB_PEAK_GIB); a tour runner's floor is cmux's measure
    admit_floor = admit_floor_gib(args.min_free_gib, args.gui_runner or args.session_runner)
    # the runner LaunchAgent's environment can switch sampling off fleet-wide without a reinstall
    telemetry = not args.no_telemetry and os.environ.get("GLAEDA_RUNNER_TELEMETRY", "1") != "0"

    owner: JobOwner | None = None
    if args.phase == "job-started":
        # Pin the job's Runner.Worker (pid + start token) once, before admission: every hold, the sampler and the
        # watchdog watch this handle, never a later os.getppid() (launchd once the Worker is gone). If the Worker
        # dies while this hook waits or cleans up, the wait ends and the watcher releases the host/capacity flocks.
        owner = job_owner(args.watch_pid)
        start_runner_parent_watchdog(owner)

    if args.phase in ("admit", "release"):
        if not args.job_key or not STEP_KEY.fullmatch(args.job_key):
            p.error(f"{args.phase} needs --job-key matching {STEP_KEY.pattern}")
        os.environ["RUNNER_NAME"] = step_runner_name(args.job_key)  # the step's own holder files (holder_file)
    if args.phase == "admit":
        if not args.step_class:
            p.error("admit needs --class")
        status, result = step_admit(args.step_class, args.job_key, args.watch_pid, args.host_lock, args.reservation,
                                    args.capacity_dir, args.capacity_units, args.state_dir, args.compile_slots,
                                    args.canonical_roots)
        print(json.dumps(result, sort_keys=True), flush=True)
        return status
    if args.phase == "release":
        print(json.dumps({"schema": STEP_ADMISSION, "key": args.job_key,
                          "released": release_host_lock(args.state_dir)}, sort_keys=True), flush=True)
        return 0
    if args.phase == "fits":
        why = step_refusal()
        fits = [] if why else step_fits(args.capacity_dir, args.capacity_units, args.compile_slots,
                                        args.canonical_roots, args.host_lock, args.reservation, args.state_dir,
                                        time.time())
        unknown = isinstance(fits, Unknown)
        answer: dict[str, Any] = {"schema": STEP_FITS, "fits": [] if unknown else fits, "unknown": unknown}
        if why:
            answer["refusal"] = why[:2000]  # every tool, with its paths
            print(f"{PREFIX}: fits: {why}", file=sys.stderr, flush=True)
        print(json.dumps(answer, sort_keys=True), flush=True)
        return 0
    if args.phase == "listen":
        if args.runner_dir is None:
            p.error("listen needs --runner-dir")
        return listen(args.runner_dir, args.host_lock, args.reservation, args.state_dir, not args.no_waiters,
                      args.adopt, args.capacity_dir, args.fit_units)
    if args.phase == "take-root":
        if not args.root:
            p.error("take-root needs --root")
        return take_root(args.root, args.wait, args.capacity_dir, args.state_dir, args.canonical_roots, args.switch,
                         args.gui_token)
    if args.phase == "take-gui":
        return take_gui(args.wait, args.capacity_dir, args.state_dir,
                        args.testmanagerd_program if args.recycle_testmanagerd else None,
                        args.xctest_pattern, args.gui_token)
    if args.phase == "check":
        why, want = node_refusal(args.fleet_class)
        if not why:
            why, note = toolchain_refusal(args.fleet_class, want, args.toolchain_xcode, align=False)
        print(f"{PREFIX}: {'refused: ' + why if why else 'eligible' + (f' ({note})' if note else '')}", flush=True)
        return 1 if why else 0
    if args.phase == "job-started":
        event = load_event(os.environ.get("GITHUB_EVENT_PATH"))
        # the repository decide() admits: the runner's variable, else the event payload's
        repo = os.environ.get("GITHUB_REPOSITORY") or _repo_name((event or {}).get("repository")
                                                                 if isinstance(event, dict) else None)
        admit_start: float | None = None

        def refused(why: str, disk: bool = False) -> int:
            if owner is not None and owner.gone():
                return abandoned()  # nobody reads a refusal of a job whose Worker is gone
            worker = owner.pid if owner is not None else args.watch_pid or os.getppid()
            if not disk and worker > 1:  # a disk refusal's job-completed still runs its pass; launchd is no job
                with contextlib.suppress(OSError):
                    args.state_dir.mkdir(parents=True, exist_ok=True)
                    refused_note(args.state_dir, worker).touch()
            if telemetry:
                with contextlib.suppress(Exception):  # observation never hides or changes a refusal
                    job_event("refused", job_meta(repo, args.home_repo), args.job_log, decision=why[:400],
                              wait_s=None if admit_start is None else round(time.monotonic() - admit_start, 1),
                              units=0, roots=[], gui=False, instance=args.instance)
            return refuse(why)

        def abandoned() -> int:
            """The owner is gone (a cancelled or crashed job): give up the wait, hold nothing, refuse nobody."""
            why = f"{OWNER_GONE} (pid {owner.pid if owner else 'unknown'}); nothing admitted, nothing held"
            print(f"{PREFIX}: {why}", flush=True)
            if telemetry:
                with contextlib.suppress(Exception):
                    job_event("abandoned", job_meta(repo, args.home_repo), args.job_log, decision=why[:400],
                              wait_s=None if admit_start is None else round(time.monotonic() - admit_start, 1),
                              units=0, roots=[], gui=False, instance=args.instance)
            return 1

        admit, reason = decide(os.environ.get("GITHUB_EVENT_NAME"), event,
                               os.environ.get("GITHUB_REPOSITORY"), args.allowed_repo, args.allowed_owner,
                               tuple(args.allow_event))
        if not admit:
            return refused(reason)
        if args.dev_compile_runner:
            why = dev_compile_refusal(os.environ.get("GITHUB_EVENT_NAME"), os.environ.get("GITHUB_REF"),
                                      os.environ.get("GITHUB_REPOSITORY"), event,
                                      os.environ.get("GITHUB_WORKFLOW_REF"), os.environ.get("GITHUB_JOB"))
            if why:
                return refused(why)
        if args.trusted_ref or args.trusted_repo or args.trusted_next_nightly:
            why = trusted_refusal(os.environ.get("GITHUB_EVENT_NAME"), os.environ.get("GITHUB_REF"),
                                  os.environ.get("GITHUB_REPOSITORY"), event, args.trusted_ref or "(unset)",
                                  args.trusted_repo or "(unset)", trusted_next_nightly=args.trusted_next_nightly,
                                  workflow_ref=os.environ.get("GITHUB_WORKFLOW_REF"), job=os.environ.get("GITHUB_JOB"),
                                  run_attempt=os.environ.get("GITHUB_RUN_ATTEMPT"))
            if why:
                return refused(why)
        want: dict[str, Any] = {}
        if args.require_eligible:
            why, want = node_refusal(args.fleet_class)
            if why:
                return refused(why)
        if args.toolchain_xcode:  # the listener's env, which every step inherits (listener_env)
            given = {k: v for k, v in os.environ.items() if k != "SDKROOT" or not under_xcrun_shim(sys.executable)}
            why = leaked_toolchain_env(given, args.toolchain_xcode)
            if why:
                return refused(why)
        why = reservation_refusal(args.reservation, time.time(), taken_job=True)
        disk_path = os.path.dirname(args.host_lock)
        disk_deadline = time.monotonic() + EVICT_TIMEOUT_S  # one budget for every eviction of this job-started
        if not why and not args.no_disk and disk_refusal(disk_path, args.min_free_gib):
            print(f"{PREFIX}: {evict(disk_path, args.min_free_gib, args.disk, disk_deadline)}", flush=True)
        if why:
            return refused(why)

        def disk_why() -> str | None:
            """The refusal for this job's disk, after eviction: under the admission floor, or under the runner floor
            while another job admitted there still runs (disk_low_turn)."""
            low = disk_refusal(disk_path, admit_floor)
            if low or admit_floor >= args.min_free_gib or not disk_refusal(disk_path, args.min_free_gib):
                return low
            # only a pinned Runner.Worker takes the ledger's turn: its marker lives exactly as long as that job
            turn = disk_low_turn(args.capacity_dir, owner.pid) if owner is not None \
                else "this job's Runner.Worker is not pinned, so it cannot take the disk ledger's turn"
            if turn:
                return f"{disk_refusal(disk_path, args.min_free_gib) or 'under the disk floor'}: {turn}"
            return disk_refusal(disk_path, admit_floor)  # read again: it may have waited for the ledger

        why = disk_why()
        if why:
            return refused(why, disk=True)
        prejob = None if args.no_disk else prejob_evict(disk_path, args.min_free_gib, args.disk)
        if prejob:
            print(f"{PREFIX}: {prejob}", flush=True)
            # the jobs already running may have written the disk below the floor while this one waited
            if disk_refusal(disk_path, args.min_free_gib):
                print(f"{PREFIX}: {evict(disk_path, args.min_free_gib, args.disk, disk_deadline)}", flush=True)
                why = disk_why()
                if why:
                    return refused(why, disk=True)
        # before any capacity is taken: a job that needs the console session fails on a locked one
        admit_class = None
        if args.gui_runner or args.session_runner or job_class(
                os.environ.get("GITHUB_JOB", ""), repo, args.home_repo, job_workflow())[0] in CONSOLE_CLASSES:
            why = console_refusal()
            if why and (job_workflow(), os.environ.get("GITHUB_JOB", "")) in CONSOLE_SKIPPERS:
                print(f"{PREFIX}: {why}; admitted as light, its take-gui step skips the console steps", flush=True)
                admit_class = "light"
            elif why:
                return refused(why)
        if (admit_class is None and args.fast_runner and not is_guest(repo, args.home_repo)
                and (job_workflow(), os.environ.get("GITHUB_JOB", "")) in FAST_JOBS):
            admit_class = "fast"  # its own tokens on its own runner; on any other runner it keeps its usual cost
        if args.fast_runner and admit_class != "fast":
            # It listens on a full mini (it needs no general units), so any other job would wait here for units
            # with no limit and idle the runner; refused, it is rescued onto its own pool.
            return refused("the fast runner takes only the fast tier")
        if owner is None:  # fail closed: with no pinned owner no holder could watch the job
            return refused(f"cannot pin this job's Runner.Worker (pid {args.watch_pid or os.getppid()})")
        admit_start = time.monotonic()
        taken: dict[str, Any] = {}
        if args.capacity_units > 0:
            roots_file(args.state_dir).unlink(missing_ok=True)  # a crashed job's record must not look held
            gui_file(args.state_dir).unlink(missing_ok=True)
            ensure_root_shim(Path(FLEET_DIR) / "bin")
            # A cmux job waits for capacity with no limit (CAPACITY_WAIT); a guest has no rescue workflow, so it
            # waits GUEST_WAIT_S for room and is then refused.
            cap = args.guest_wait if is_guest(repo, args.home_repo) else args.gui_wait
            # The DEV bound holds over a longer --gui-wait too; a shorter one is kept.
            cap = bounded_wait(cap, dev_compile_capacity_wait(
                repo, args.home_repo, os.environ.get("GITHUB_EVENT_NAME"),
                os.environ.get("GITHUB_REF"), event, os.environ.get("GITHUB_JOB", ""), job_workflow()))
            cap = slot_capacity_wait(cap, args.dev_compile_runner)
            tier = job_tier(os.environ.get("GITHUB_EVENT_NAME"), os.environ.get("GITHUB_REF"),
                            os.environ.get("GITHUB_REPOSITORY"), event, os.environ.get("GITHUB_WORKFLOW_REF"),
                            os.environ.get("GITHUB_JOB"))
            if tier == TIER_NIGHTLY:
                print(f"{PREFIX}: a nightly job: it goes ahead of every other job waiting here, no other job takes a "
                      f"unit while it waits, and it keeps no idle reserve", flush=True)
            elif tier:
                print(f"{PREFIX}: a DEV compile: it goes ahead of PR jobs waiting here for capacity "
                      f"(those waiting under {FEED_JUMP_S / 60:g} min)", flush=True)
            start, since = time.monotonic(), time.time()
            marker = args.capacity_dir / f"{ADMIT_WANT}{os.getpid()}"
            shown, shown_at = "", 0.0
            try:
                while True:
                    if owner.gone():  # a cancelled job's hook must not keep queuing for units
                        return abandoned()
                    held, note = take_capacity(args.host_lock, args.capacity_dir, args.capacity_units,
                                               os.environ.get("GITHUB_JOB", ""), owner,
                                               args.state_dir, args.compile_slots, args.canonical_roots,
                                               repo, args.home_repo, instance=args.instance,
                                               workflow=job_workflow(),
                                               warm_keys=job_warm_keys(event), taken_out=taken,
                                               warm_target=job_warm_target(event), since=since,
                                               gui_token=args.gui_token, klass=admit_class,
                                               gui_runner=args.gui_runner,
                                               fresh_runner=args.dev_compile_runner, tier=tier)
                    if held or not note.startswith("capacity:"):
                        break
                    waited = time.monotonic() - start
                    left = math.inf if cap is None else cap - waited
                    if left <= 0:
                        break
                    wants = list(taken.get("wants") or [])
                    write_want(marker, since, wants, tier)
                    if note != shown or time.monotonic() - shown_at >= ADMIT_NOTE_S:
                        holders = ""
                        with contextlib.suppress(Exception):  # naming holders must never fail the wait
                            holders = token_holders(args.capacity_dir, wants, args.compile_slots,
                                                    args.canonical_roots)
                        print(f"{PREFIX}: waiting ({waited:.0f} s so far): {note.removeprefix('capacity: ')}"
                              + (f"; held by {holders}" if holders else ""), flush=True)
                        shown, shown_at = note, time.monotonic()
                    time.sleep(min(ADMIT_POLL_S, left))  # never start a try after the deadline
            finally:
                with contextlib.suppress(OSError):
                    marker.unlink()
        else:
            with contextlib.suppress(OSError):  # a crashed job's record must not show in this job's log lines
                roots_file(args.state_dir).unlink(missing_ok=True)
                gui_file(args.state_dir).unlink(missing_ok=True)
            held, note = take_host_lock(args.host_lock, owner, args.state_dir)
        if not held:
            return refused(note)
        if args.require_eligible:
            # Under the lock no fleet build runs here, and every runner here aligns to the same receipt,
            # so the default set now holds for this job.
            why, aligned = toolchain_refusal(args.fleet_class, want, args.toolchain_xcode)
            if why:
                release_host_lock(args.state_dir)
                return refused(why)
            if aligned:
                note += f"; {aligned}"
        if args.toolchain_xcode and (pinned := export_developer_dir(args.toolchain_xcode)):
            note += f"; {pinned}"
        for root in held_roots(args.state_dir):
            settled = settle_root(int(root.rsplit("-", 1)[1]))
            if settled:
                note += f"; {settled}"
        testmanagerd = None
        if args.recycle_testmanagerd and gui_file(args.state_dir).exists():
            testmanagerd = recycle_testmanagerd(args.testmanagerd_program, args.xctest_pattern)
            if testmanagerd.startswith(TESTMANAGERD_STUCK):  # every XCTest run here would hang: go elsewhere
                release_host_lock(args.state_dir)
                return refused(testmanagerd)
            note += f"; {testmanagerd}"
        print(f"{PREFIX}: admitted: {reason}; {note}", flush=True)
        unsparsed = ""
        with contextlib.suppress(Exception):  # must not fail an admitted job
            unsparsed = unsparse_workspace(os.environ.get("GITHUB_WORKSPACE"))
        if unsparsed:
            print(f"{PREFIX}: {unsparsed}", flush=True)
        if sys.platform == "darwin":
            dialogs = ""
            with contextlib.suppress(Exception):  # must not fail an admitted job
                dialogs = dequeue_diagnostics_reporter()
            if dialogs:
                print(f"{PREFIX}: {dialogs}", flush=True)
        if args.test_keychain:
            print(f"{PREFIX}: {ensure_test_keychain(Path.home())}", flush=True)
            print(f"{PREFIX}: {unlock_test_keychain_in_gui(Path.home())}", flush=True)
        if telemetry:
            meta: dict[str, Any] = {}
            try:  # observation must not fail an admitted job
                meta = job_meta(repo, args.home_repo)
                meta.update(decision=f"{reason}; {note}"[:400], wait_s=round(time.monotonic() - admit_start, 1),
                            units=taken.get("units"), roots=held_roots(args.state_dir),
                            gui=gui_file(args.state_dir).exists(), instance=args.instance)
                if testmanagerd:
                    meta["testmanagerd"] = testmanagerd[:120]
                job_event("started", meta, args.job_log)
            except Exception:  # noqa: BLE001
                pass
            note = start_sampler(owner.pid, args.state_dir, meta, args.job_log,
                                 disk_path=None if args.no_disk else disk_path)
            print(f"{PREFIX}: {note}", flush=True)
    else:
        if telemetry:
            print(f"{PREFIX}: {finish_sampler(args.state_dir)}", flush=True)
        print(f"{PREFIX}: {release_host_lock(args.state_dir)}", flush=True)
    skip_disk = False
    if args.phase == "job-completed":
        current_worker = runner_worker_pid()
        for note in cleanup_leaked_test_apps({current_worker} if current_worker else set()):
            print(f"{PREFIX}: {note}", flush=True)
        for note in cleanup_leaked_media_apps({current_worker} if current_worker else set(), args.host_lock):
            print(f"{PREFIX}: {note}", flush=True)
        for note in cleanup_job_leftovers():
            print(f"{PREFIX}: {note}", flush=True)
        worker = args.watch_pid or current_worker
        if worker:
            with contextlib.suppress(OSError):
                refused_note(args.state_dir, worker).unlink()
                skip_disk = True
        if skip_disk:  # nothing ran, so nothing to free; the runner is back on the queue at once
            print(f"{PREFIX}: refused in job-started; no disk pass", flush=True)
    if not args.no_disk and not skip_disk:
        # both phases trigger the one queued pass: job-started ran its own pass before every job, which spent 10-20 s
        # measuring and then skipped as busy behind the queue's (cmux14, 2026-10-26: 23 of 28 busy skips in an hour
        # came within 150 s of a job start); under the floor, evict() above still frees space before admitting
        note = disk_pressure_detached(args.disk)
        print(f"{PREFIX}: {note}", flush=True)
    if args.phase == "job-completed":  # last: between this job and the next
        note = install_staged_hook(Path(__file__).resolve().parent)
        if note:
            print(f"{PREFIX}: {note}", flush=True)
    return 0


def install_staged_hook(hook_dir: Path) -> str | None:
    """job-completed: install the hook (and module) --refresh-hooks staged while this runner had a job, or None when
    nothing is staged. The job is over, so the next job-started runs the new file whole, and the listener gate sees
    the change and reloads. A stage whose bytes are not the ones recorded, or that would replace another hook than the
    one it was checked against (an --apply wrote a newer one since), is dropped."""
    hook, module = hook_dir / PREFIX, hook_dir / "glaeda_reservation.py"
    staged, staged_module, record_path = (hook_dir / f".{hook.name}{NEXT_SUFFIX}",
                                          hook_dir / f".{module.name}{NEXT_SUFFIX}", hook_dir / NEXT_RECORD)
    if not staged.exists() and not record_path.exists():
        return None

    def drop(why: str) -> str:
        for path in (staged, staged_module, record_path):
            with contextlib.suppress(OSError):
                path.unlink()
        return f"dropped the hook --refresh-hooks staged: {why}"

    try:
        record = json.loads(record_path.read_text())
        st = os.lstat(staged)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            return drop("not a regular file owned by this user")
        if not isinstance(record, dict) or hashlib.sha256(staged.read_bytes()).hexdigest() != record.get("hook"):
            return drop("it is not the file the refresh checked")
        if hashlib.sha256(hook.read_bytes()).hexdigest() != record.get("replaces"):
            return drop("the installed hook changed since it was staged")
        if record.get("module"):
            st = os.lstat(staged_module)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() \
                    or hashlib.sha256(staged_module.read_bytes()).hexdigest() != record["module"]:
                return drop("the staged module is not the file the refresh wrote")
            os.replace(staged_module, module)  # the module first: the hook lands only beside the module it reads
        os.replace(staged, hook)
        record_path.unlink()
    except (OSError, ValueError) as error:
        return drop(f"{type(error).__name__}: {error}"[:200])
    with contextlib.suppress(OSError):
        fd = os.open(hook_dir, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    return "installed the hook --refresh-hooks staged while this runner had a job; the gate reloads it"


if __name__ == "__main__":
    raise SystemExit(main())
