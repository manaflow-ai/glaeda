#!/usr/bin/env python3
"""glaeda-daemon-heal: keep macOS system daemons from holding a core for hours on a glaeda host.

    glaeda-daemon-heal --policy P               plan: what a pass would do now (changes nothing)
    glaeda-daemon-heal --policy P --apply       one reconcile pass (the root LaunchDaemon, every policy every_s)
    glaeda-daemon-heal --install --policy P     plan the root install
    sudo glaeda-daemon-heal --install --policy P --apply   install or update it (idempotent)
    glaeda-daemon-heal --status --policy P      is the installed copy this one (any user; JSON)

Desired state (config/macos-daemons.json, the one source of every number here): no daemon in `daemons` uses
`hot_cores` or more for `hot_hours`. Each pass samples each daemon's CPU time with ps; a streak starts at the first
interval at or above hot_cores and ends at the first below it, or when the pid changes. A daemon past hot_hours is
restarted: SIGTERM, then SIGKILL after stop_wait_s, and launchd (KeepAlive or on demand) starts a fresh one. That is
what clears fseventsd's wedged notify thread (cmux9 10-20: 100% CPU and 27 GiB RSS with no disk I/O, 1.5% and 4 MiB
after one restart). A `wait_idle` daemon (fseventsd: a restart drops live FSEvents streams) waits while a process
named in `busy` runs, up to busy_hot_hours. At most max_restarts_per_day per daemon, so nothing loops.

A daemon whose memory footprint (top's MEM: resident, compressed and swapped pages) is footprint_gib or more is
restarted at once, busy host or not: a wedged fseventsd never gives that memory back, and its swap files take the
disk the runners need. cmuxs-mac-mini-6 10-25: fseventsd at 102 GiB footprint for 14 days, 65 GiB of swap files on
the VM volume and 3 GiB left on a 460 GiB disk, while its CPU streak kept breaking and the busy wait held it 8 h.

Only processes whose executable is exactly a policy path run as a system account (uid < 500) are touched, and a
policy path must lie under a SIP-protected system directory. The installed copy and its policy are root-owned
snapshots under INSTALL_DIR run by /usr/bin/python3 -I, so nothing the runner user (or a PR job) can write runs as
root.

The root copy keeps itself on the stable release (policy `release`), so a release that changes this script or the
policy reaches every mini with no hand step. Every release.every_s an --apply pass reads ota-channels/control.json
and stable.json from the first of release.sources that answers (glaeda-update's channel: this repository, or its
byte-identical mirror), over HTTPS only. When the tag differs from the one installed, or the installed files no
longer hash to what that tag shipped, it downloads release.json (its SHA-256 must be the channel's), then the macOS
glaeda-hygiene archive (size and SHA-256 must be release.json's), and reads exactly two members from it in memory:
glaeda/scripts/glaeda-daemon-heal and glaeda/config/macos-daemons.json. Those are staged root-owned and must plan a
pass with each other (the new code's own check of its own policy) before they replace the snapshot; the next pass
runs them. A pass whose plist no longer matches its policy (every_s changed) reloads the LaunchDaemon from a detached
helper, after the pass exits. Nothing the runner user can write is read: not ~/.config/glaeda, not the release
copies glaeda-update keeps. The report says what it runs and what the channel wants, and `judge` turns a report into
current, stale or missing for glaeda-mini-health and glaeda-fleet-status (daemon_heal_missing, daemon_heal_stale).
A copy installed before this existed cannot update itself: one root --install of a current release makes it.
Stdlib only; runs on macOS /usr/bin/python3 (3.9).
"""

from __future__ import annotations

import argparse
import contextlib
import datetime
import hashlib
import http.client
import io
import json
import os
import plistlib
import re
import signal
import subprocess
import sys
import tarfile
import tempfile
import threading
import time
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

SCHEMA = "glaeda-daemon-heal/v1"
POLICY_SCHEMA = "glaeda-macos-daemons/v1"
LABEL = "com.teamleaderleo.glaeda.daemon-heal"
INSTALL_DIR = Path("/Library/Application Support/glaeda/daemon-heal")
PLIST = Path("/Library/LaunchDaemons") / f"{LABEL}.plist"
SYSTEM_PYTHON = "/usr/bin/python3"  # SIP-protected; a Homebrew python is writable by the runner user
SCRIPT_NAME = "glaeda-daemon-heal"
POLICY_NAME = "macos-daemons.json"
SYSTEM_PREFIXES = ("/System/", "/usr/libexec/", "/usr/sbin/", "/usr/bin/", "/sbin/")
SYSTEM_UID_MAX = 499
DAY_S = 86400
GIB = 1 << 30
UNITS = {"B": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}
POLICY_KEYS = {"every_s": int, "hot_cores": (int, float), "hot_hours": (int, float), "busy_hot_hours": (int, float),
               "footprint_gib": (int, float), "max_restarts_per_day": int, "stop_wait_s": (int, float), "report_stale_passes": int, "busy": list,
               "daemons": list, "release": dict}
# The release channel (glaeda-update and glaeda_release.py write and read the same files).
REPOSITORY = "teamleaderleo/glaeda"
RELEASE_SOURCES = (REPOSITORY, "manaflow-ai/glaeda")  # glaeda-update SOURCES: the repository and its mirror
RING = "stable"  # only releases a canary verified (with attestation) and that soaked
CONTROL_SCHEMA = "glaeda-ota-control/v1"
CHANNEL_SCHEMA = "glaeda-ota-channel/v1"
RELEASE_SCHEMA = "glaeda-release/v1"
TAG_RE = re.compile(r"r-\d{8}-[0-9a-f]{12}")
SHA_RE = re.compile(r"[0-9a-f]{40}")
HEX64 = re.compile(r"[0-9a-f]{64}")
ARCHIVE = "glaeda-hygiene-aarch64-apple-darwin.tar.gz"
MEMBERS = {SCRIPT_NAME: "glaeda/scripts/glaeda-daemon-heal", POLICY_NAME: "glaeda/config/macos-daemons.json"}
MODES = {SCRIPT_NAME: 0o555, POLICY_NAME: 0o444}
MAX_META = 1 << 20
MAX_ARCHIVE = 200 << 20  # glaeda-update MAX_ASSET
MAX_MEMBER = 1 << 20
MAX_EXTRACTED = 1 << 30  # glaeda-update MAX_EXTRACTED: what the whole archive may expand to
ANCESTRY = "ancestry.txt"  # glaeda_release.ANCESTRY: the release's commit and its ancestors, at the archive root
URL_HOSTS = ("github.com", "release-assets.githubusercontent.com", "objects.githubusercontent.com")
PAIR_MARK = "ready.json"  # in staged/: the commit point of a script and policy swap
INSTALLED = "installed.json"  # beside the pair: the release it is (tag, commit, hashes), swapped with it
FETCH_TIMEOUT = 60
CHECK_TIMEOUT = 120  # the staged copy's plan pass (ps and one top sample)
AFTER_PID_WAIT_S = 300


class HealError(RuntimeError):
    pass


# ---------------------------------------------------------------- policy


def load_policy(path: Path) -> dict[str, Any]:
    try:
        doc = json.loads(path.read_text())
    except (OSError, ValueError) as e:
        raise HealError(f"cannot read policy {path}: {e}") from e
    return validate_policy(doc)


def validate_policy(doc: Any) -> dict[str, Any]:
    if not isinstance(doc, dict) or doc.get("schema") != POLICY_SCHEMA:
        raise HealError(f"policy schema is not {POLICY_SCHEMA}")
    for key, kind in POLICY_KEYS.items():
        value = doc.get(key)
        if isinstance(value, bool) or not isinstance(value, kind):
            raise HealError(f"policy {key} is missing or not {kind}")
        if kind not in (list, dict) and value <= 0:
            raise HealError(f"policy {key} must be positive")
    if doc["busy_hot_hours"] < doc["hot_hours"]:
        raise HealError("policy busy_hot_hours must be at least hot_hours")
    if not all(isinstance(b, str) and b and "/" not in b for b in doc["busy"]):
        raise HealError("policy busy holds process names")
    names = set()
    for d in doc["daemons"]:
        if not isinstance(d, dict) or not isinstance(d.get("name"), str) or not isinstance(d.get("path"), str) \
                or not isinstance(d.get("wait_idle"), bool):
            raise HealError("each policy daemon needs name, path and wait_idle")
        path = d["path"]
        if not path.startswith(SYSTEM_PREFIXES) or ".." in path.split("/") or os.path.basename(path) != d["name"]:
            raise HealError(f"policy daemon {d['name']}: path must be its own executable under {SYSTEM_PREFIXES}")
        if d["name"] in names:
            raise HealError(f"policy daemon {d['name']} is listed twice")
        names.add(d["name"])
    release = doc["release"]
    for key in ("every_s", "stale_s"):
        if type(release.get(key)) is not int or release[key] <= 0:
            raise HealError(f"policy release.{key} must be a positive integer")
    if release["stale_s"] < release["every_s"]:
        raise HealError("policy release.stale_s must be at least release.every_s")
    sources = release.get("sources")
    if not isinstance(sources, list) or not sources or not all(s in RELEASE_SOURCES for s in sources) \
            or len(set(sources)) != len(sources):
        raise HealError(f"policy release.sources must name some of {', '.join(RELEASE_SOURCES)}")
    return doc


# ---------------------------------------------------------------- the host


def sh(argv: list[str], timeout: float = 15) -> tuple[int, str, str]:
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                           timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError) as e:
        return 127, "", str(e)
    return p.returncode, p.stdout, p.stderr


def cpu_seconds(text: str) -> float | None:
    """ps `time` ([dd-][hh:]mm:ss[.ss]; macOS prints minutes past 59, as 1891:53.94) in seconds."""
    m = re.fullmatch(r"(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+(?:\.\d+)?)", text.strip())
    if not m:
        return None
    d, h, mi, s = m.groups()
    return ((int(d or 0) * 24 + int(h or 0)) * 60 + int(mi)) * 60 + float(s)


def footprint_bytes(text: str) -> int | None:
    """top's MEM column (102G, 1264M, 31M+, 4096K, 12B) in bytes."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([BKMGT])[+-]?", text.strip())
    return None if not m else int(float(m.group(1)) * UNITS[m.group(2)])


class Host:
    """What a pass reads and does. Tests replace these methods."""

    def processes(self) -> list[tuple[int, int, float, str]]:
        """(pid, uid, cpu seconds, executable) for every process."""
        rows = []
        for line in sh(["/bin/ps", "-axww", "-o", "pid=,uid=,time=,comm="])[1].splitlines():
            parts = line.split(None, 3)
            if len(parts) == 4 and parts[0].isdigit() and parts[1].isdigit():
                cpu = cpu_seconds(parts[2])
                if cpu is not None:
                    rows.append((int(parts[0]), int(parts[1]), cpu, parts[3].strip()))
        return rows

    def footprints(self, pids: list[int]) -> dict[int, int]:
        """pid -> memory footprint in bytes (top's MEM, which counts compressed and swapped pages; ps rss does not)."""
        if not pids:
            return {}
        argv = ["/usr/bin/top", "-l", "1", "-s", "0", "-stats", "pid,mem"]
        for pid in pids:
            argv += ["-pid", str(pid)]
        code, text, _err = sh(argv, timeout=30)
        if code != 0:  # a failed top measured nothing, whatever it printed
            return {}
        out = {}
        for line in text.splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[0].isdigit() and int(parts[0]) in pids:
                size = footprint_bytes(parts[1])
                if size is not None:
                    out[int(parts[0])] = size
        return out

    def signal(self, pid: int, sig: int) -> bool:
        try:
            os.kill(pid, sig)
            return True
        except OSError:
            return False

    def sleep(self, seconds: float) -> None:
        time.sleep(seconds)

    def now(self) -> float:
        return time.time()


# ---------------------------------------------------------------- one pass


def iso(t: float) -> str:
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def restart(host: Host, policy: dict[str, Any], daemon: dict[str, Any], pid: int) -> tuple[bool, str]:
    """Stop pid only while it is still this daemon; launchd starts the next one."""
    def alive() -> bool:
        return any(p == pid and exe == daemon["path"] for p, _u, _c, exe in host.processes())

    if pid <= 1:
        return False, f"{daemon['name']} pid {pid}: refusing to signal launchd or the kernel"
    if not alive():
        return True, f"{daemon['name']} pid {pid} had already exited"
    host.signal(pid, signal.SIGTERM)
    waited = 0.0
    while alive() and waited < policy["stop_wait_s"]:
        host.sleep(0.5)
        waited += 0.5
    how = "SIGTERM"
    if alive():
        host.signal(pid, signal.SIGKILL)
        host.sleep(0.5)
        how = "SIGKILL after SIGTERM"
    if alive():
        return False, f"{daemon['name']} pid {pid} survived {how}"
    fresh = [p for p, _u, _c, exe in host.processes() if exe == daemon["path"]]
    return True, f"{daemon['name']} pid {pid} stopped ({how}); " + (
        f"launchd started pid {fresh[0]}" if fresh else "launchd starts it on demand")


def reconcile(host: Host, policy: dict[str, Any], state: dict[str, Any], apply: bool) -> tuple[dict, dict]:
    """One pass: (new state, report). State: {"samples": {name: {pid, t, cpu, since}}, "restarts": {name: [t]}}."""
    now = host.now()
    rows = host.processes()
    busy_names = set(policy["busy"])
    busy = sorted({os.path.basename(exe) for _p, _u, _c, exe in rows if os.path.basename(exe) in busy_names})
    samples: dict[str, Any] = dict(state.get("samples") or {})
    restarts = {k: [t for t in v if isinstance(t, (int, float)) and now - t < DAY_S]
                for k, v in (state.get("restarts") or {}).items() if isinstance(v, list)}
    healed = [h for h in state.get("healed") or [] if isinstance(h, dict) and now - h.get("t", 0) < DAY_S]
    hot_s, busy_hot_s = policy["hot_hours"] * 3600, policy["busy_hot_hours"] * 3600
    cap = int(policy["footprint_gib"] * GIB)
    hot, actions = [], []
    found = {}
    for daemon in policy["daemons"]:
        mine = [(p, c) for p, u, c, exe in rows if exe == daemon["path"] and u <= SYSTEM_UID_MAX]
        if len(mine) == 1:  # not running, or more than one: nothing to judge
            found[daemon["name"]] = mine[0]
    sizes = host.footprints(sorted(pid for pid, _c in found.values()))
    for daemon in policy["daemons"]:
        name = daemon["name"]
        if name not in found:
            samples.pop(name, None)
            continue
        pid, cpu = found[name]
        prev = samples.get(name)
        since = None
        cores = None
        if isinstance(prev, dict) and prev.get("pid") == pid and now > prev.get("t", now) and cpu >= prev.get("cpu", cpu):
            cores = (cpu - prev["cpu"]) / (now - prev["t"])
            if cores >= policy["hot_cores"]:
                since = prev.get("since") or prev["t"]
        samples[name] = {"pid": pid, "t": now, "cpu": cpu, "since": since}
        size = sizes.get(pid)
        bloated = size is not None and size >= cap
        if since is None and not bloated:
            continue
        hot_for = 0.0 if since is None else now - since
        entry = {"name": name, "pid": pid, "cores": round(cores or 0, 2), "since": iso(since or now),
                 "hot_for_s": round(hot_for)}
        if size is not None:
            entry["footprint_gib"] = round(size / GIB, 1)
        due = hot_for >= hot_s and since is not None
        if bloated:  # memory a wedged daemon never returns: its swap fills the disk, so no busy wait
            due = True
            entry["why"] = f"footprint {entry['footprint_gib']} GiB is at least {policy['footprint_gib']} GiB"
        elif due and daemon["wait_idle"] and busy and hot_for < busy_hot_s:
            entry["waiting"] = f"host busy ({', '.join(busy)}); restarts anyway at {policy['busy_hot_hours']} h"
            due = False
        if due and len(restarts.get(name, [])) >= policy["max_restarts_per_day"]:
            entry["waiting"] = f"{policy['max_restarts_per_day']} restarts in the last day; no more until one ages out"
            due = False
        if not due:
            entry.setdefault("waiting", f"restarts at {policy['hot_hours']} h")
            hot.append(entry)
            continue
        if not apply:
            entry["waiting"] = "would restart now (plan)"
            hot.append(entry)
            continue
        ok, what = restart(host, policy, daemon, pid)
        restarts.setdefault(name, []).append(now)
        actions.append({"name": name, "ok": ok, "action": what})
        if ok:
            samples.pop(name, None)
            healed.append({"name": name, "t": now, "at": iso(now), "since": entry["since"], "cores": entry["cores"],
                           **({"footprint_gib": entry["footprint_gib"]} if "footprint_gib" in entry else {}),
                           "action": what})
        else:
            entry["waiting"] = what
            hot.append(entry)
    new_state = {"samples": samples, "restarts": restarts, "healed": healed}
    report = {"schema": SCHEMA, "at": iso(now), "busy": busy, "hot": hot, "healed": healed, "actions": actions}
    return new_state, report


# ---------------------------------------------------------------- files


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def read_bytes(path: Path) -> bytes | None:
    try:
        return path.read_bytes()
    except OSError:
        return None


def atomic_write(path: Path, data: bytes, mode: int, root: bool) -> None:
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=os.fspath(path.parent))
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        if root:
            os.chown(tmp, 0, 0)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


def load_json(path: Path) -> dict[str, Any]:
    try:
        doc = json.loads(path.read_text())
        return doc if isinstance(doc, dict) else {}
    except (OSError, ValueError):
        return {}


def check_root_dir(path: Path) -> None:
    """Every component from / down is a real directory owned by root and not writable by others."""
    current = Path("/")
    for part in path.parts[1:]:
        current = current / part
        st = os.lstat(current)
        if not os.path.isdir(current) or os.path.islink(current) or st.st_uid != 0 or st.st_mode & 0o022:
            raise HealError(f"{current} is not a root-owned directory closed to other users")


# ---------------------------------------------------------------- install


def desired_install(policy_path: Path, install_dir: Path = INSTALL_DIR) -> dict[str, Any]:
    """The files the root LaunchDaemon needs, from this copy of the script and a validated policy."""
    policy_bytes = policy_path.read_bytes()
    policy = validate_policy(json.loads(policy_bytes))
    script = install_dir / SCRIPT_NAME
    state_dir = install_dir / "state"
    plist = {
        "Label": LABEL,
        "ProgramArguments": [SYSTEM_PYTHON, "-I", os.fspath(script), "--apply",
                             "--policy", os.fspath(install_dir / POLICY_NAME), "--state-dir", os.fspath(state_dir)],
        "StartInterval": policy["every_s"],
        "RunAtLoad": True,
        "ProcessType": "Background",
        "LowPriorityIO": True,
        "Nice": 10,
        "StandardOutPath": os.fspath(state_dir / "heal.log"),
        "StandardErrorPath": os.fspath(state_dir / "heal.err"),
    }
    return {"files": {script: (Path(__file__).read_bytes(), MODES[SCRIPT_NAME]),
                      install_dir / POLICY_NAME: (policy_bytes, MODES[POLICY_NAME])},
            "plist": plistlib.dumps(plist, sort_keys=True), "state_dir": state_dir}


def install_status(policy_path: Path, install_dir: Path = INSTALL_DIR, plist_path: Path = PLIST) -> dict[str, Any]:
    want = desired_install(policy_path, install_dir)
    stale = [os.fspath(p) for p, (data, _m) in want["files"].items() if read_bytes(p) != data]
    if read_bytes(plist_path) != want["plist"]:
        stale.append(os.fspath(plist_path))
    installed = (install_dir / SCRIPT_NAME).exists() and plist_path.exists()
    report_path = want["state_dir"] / "report.json"
    policy = validate_policy(json.loads(policy_path.read_bytes()))
    try:
        report_age = time.time() - report_path.stat().st_mtime
    except OSError:
        report_age = None
    # The daemon writes its report every pass: older than report_stale_passes passes means it is not running.
    fresh = report_age is not None and report_age <= policy["report_stale_passes"] * policy["every_s"]
    # current/stale/missing from the root report: a self-updating copy follows stable, not this user's release
    verdict = judge(load_json(report_path), time.time(), installed)
    return {"schema": SCHEMA, "installed": installed, "current": not stale, "stale": stale, "verdict": verdict,
            "loaded": loaded(), "reportFresh": fresh,
            "reportAgeS": None if report_age is None else round(report_age),
            "sha256": sha256(Path(__file__).read_bytes()), "policySha256": sha256(policy_path.read_bytes()),
            "report": os.fspath(report_path)}


def loaded() -> bool | None:
    """launchctl print system/LABEL (readable without root); None when launchctl could not answer."""
    code, said = launchctl("print", f"system/{LABEL}")
    if code == 0:
        return True
    return False if code in (36, 113) or "could not find service" in said.lower() else None


def launchctl(*args: str) -> tuple[int, str]:
    code, out, err = sh(["/bin/launchctl", *args], timeout=20)
    return code, (err or out).strip()[-200:]


def install(policy_path: Path, apply: bool, expect_sha256: str | None = None,
            expect_policy_sha256: str | None = None) -> dict[str, Any]:
    want = desired_install(policy_path)
    # These bytes become root's: check exactly them against the hashes the operator took from the release
    # (first, so a wrong pin says so even when nothing would change).
    script_bytes = want["files"][INSTALL_DIR / SCRIPT_NAME][0]
    policy_bytes = want["files"][INSTALL_DIR / POLICY_NAME][0]
    for what, data, expected in (("script", script_bytes, expect_sha256), ("policy", policy_bytes, expect_policy_sha256)):
        if expected is None:
            continue
        pin = (expected.split() or [""])[0].lower()  # `shasum -a 256` prints "<hash>  -"
        if not re.fullmatch(r"[0-9a-f]{64}", pin):
            raise HealError(f"--expect-{what if what == 'policy' else 'script'} sha256 {expected!r} is not 64 hex digits")
        if sha256(data) != pin:
            raise HealError(f"{what} sha256 {sha256(data)} is not the expected {pin}; refusing to install")
    status = install_status(policy_path)
    if not apply or status["current"] and status["loaded"] and status["reportFresh"]:
        return {**status, "state": "unchanged" if status["current"] else "planned"}
    if os.geteuid() != 0:
        raise HealError("--install --apply needs root: the snapshot and the LaunchDaemon are root-owned")
    for d in (INSTALL_DIR, want["state_dir"]):
        d.mkdir(mode=0o755, parents=True, exist_ok=True)
        check_root_dir(d.parent)  # before chown/chmod: never follow a planted link with root's chown
        if os.path.islink(d):
            raise HealError(f"{d} is a symlink")
        os.chown(d, 0, 0)
        os.chmod(d, 0o755)
    check_root_dir(want["state_dir"])
    check_root_dir(PLIST.parent)
    finish_pair(INSTALL_DIR, root=True)
    if any(read_bytes(path) != data or (path.stat().st_mode & 0o777) != mode
           for path, (data, mode) in want["files"].items()):
        commit_pair({path.name: data for path, (data, _mode) in want["files"].items()}, INSTALL_DIR, True, None)
    changed = read_bytes(PLIST) != want["plist"]
    if changed:
        launchctl("bootout", f"system/{LABEL}")
        atomic_write(PLIST, want["plist"], 0o644, root=True)
    if changed or not status["loaded"] or not status["reportFresh"]:
        launchctl("bootout", f"system/{LABEL}")  # loaded but not running its passes: load it afresh
        for _ in range(40):  # launchd lets go of a booted-out job asynchronously
            if loaded() is not True:
                break
            time.sleep(0.25)
        tries = []
        for wait in (0, 1, 2, 4, 8, 15):  # a bootstrap right after a bootout can fail with EIO; nothing reloads it later
            time.sleep(wait)
            code, said = launchctl("bootstrap", "system", os.fspath(PLIST))
            tries.append(code)
            if code == 0 or loaded() is True:
                break
        else:
            raise HealError(f"launchctl bootstrap system {PLIST} failed {tries}: {said}")
    return {**install_status(policy_path), "state": "applied"}


# ---------------------------------------------------------------- the release this copy follows


class HttpsOnly(urllib.request.HTTPRedirectHandler):
    """Release downloads redirect to GitHub's asset host; a redirect off https is refused, not followed."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: ANN001 (urllib's signature)
        if not url_ok(newurl):
            raise HealError(f"refusing a redirect off https://github.com and its asset hosts ({URL_HOSTS})")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def url_ok(url: str, hosts: tuple[str, ...] = URL_HOSTS) -> bool:
    parts = urllib.parse.urlsplit(str(url))
    return parts.scheme == "https" and parts.hostname in hosts and parts.port in (None, 443)


def fetch(url: str, limit: int) -> bytes:
    if not url_ok(url, ("github.com",)):
        raise HealError("release files come from https://github.com only")
    request = urllib.request.Request(url, headers={"User-Agent": "glaeda-daemon-heal"})
    with urllib.request.build_opener(HttpsOnly).open(request, timeout=FETCH_TIMEOUT) as response:
        raw = response.read(limit + 1)
    if len(raw) > limit:
        raise HealError(f"{url} exceeds {limit} bytes")
    return raw


def release_url(source: str, tag: str, name: str) -> str:
    return f"https://github.com/{source}/releases/download/{tag}/{name}"


def read_channel(sources: list[str], get=fetch) -> tuple[str, dict[str, Any] | None]:
    """(source, the stable entry), or (source, None) while paused; the first source that answers wins."""
    errors = []
    for source in sources:
        try:
            control = json.loads(get(release_url(source, "ota-channels", "control.json"), MAX_META))
            if not isinstance(control, dict) or control.get("schema") != CONTROL_SCHEMA \
                    or not isinstance(control.get("paused"), bool):
                raise HealError("control.json is malformed")
            if control["paused"]:
                return source, None
            entry = json.loads(get(release_url(source, "ota-channels", f"{RING}.json"), MAX_META))
            if not isinstance(entry, dict) or entry.get("schema") != CHANNEL_SCHEMA or entry.get("ring") != RING \
                    or not TAG_RE.fullmatch(str(entry.get("tag"))) or not SHA_RE.fullmatch(str(entry.get("source"))) \
                    or not HEX64.fullmatch(str(entry.get("releaseSha256"))):
                raise HealError(f"{RING}.json is malformed")
            return source, entry
        except (HealError, OSError, ValueError, http.client.HTTPException) as e:  # urllib's errors are OSErrors
            errors.append(f"{source}: {str(e)[:120]}")
    raise HealError("no release source answered: " + "; ".join(errors))


def release_files(source: str, entry: dict[str, Any], get=fetch, installed: str | None = None) -> dict[str, bytes]:
    """The two files the channel's release ships, by the hash chain channel -> release.json -> archive. A release
    that does not descend from the installed commit (its ancestry.txt) is refused, as glaeda-update refuses it."""
    raw = get(release_url(source, entry["tag"], "release.json"), MAX_META)
    if sha256(raw) != entry["releaseSha256"]:
        raise HealError(f"release.json of {entry['tag']} does not match the channel")
    doc = json.loads(raw)
    if not isinstance(doc, dict) or doc.get("schema") != RELEASE_SCHEMA or doc.get("repository") != REPOSITORY \
            or doc.get("tag") != entry["tag"] or doc.get("source") != entry["source"]:
        raise HealError(f"release.json does not describe {entry['tag']}")
    assets = doc.get("assets")
    meta = assets.get(ARCHIVE) if isinstance(assets, dict) else None
    if not isinstance(meta, dict):
        raise HealError(f"{entry['tag']} has no {ARCHIVE}")
    archive = get(release_url(source, entry["tag"], ARCHIVE), MAX_ARCHIVE)
    if len(archive) != meta.get("size") or sha256(archive) != meta.get("sha256"):
        raise HealError(f"{ARCHIVE} of {entry['tag']} does not match release.json")
    files = {}
    with tarfile.open(fileobj=io.BytesIO(archive), mode="r:gz") as tar:
        if sum(m.size for m in tar.getmembers() if m.isfile()) > MAX_EXTRACTED:
            raise HealError(f"{ARCHIVE} of {entry['tag']} expands past {MAX_EXTRACTED} bytes")
        if installed and installed != entry["source"]:
            try:
                info = tar.getmember(ANCESTRY)
                lines = tar.extractfile(info).read(MAX_META).decode("ascii").split() if info.isfile() else []
            except (KeyError, UnicodeDecodeError):
                lines = []
            if installed not in lines:
                raise HealError(f"{entry['tag']} does not descend from the installed {installed[:12]}; kept")
        for name, member in MEMBERS.items():
            try:
                info = tar.getmember(member)
            except KeyError:
                raise HealError(f"{entry['tag']} ships no {member}") from None
            if not info.isfile() or info.size > MAX_MEMBER:
                raise HealError(f"{member} in {entry['tag']} is not a small regular file")
            files[name] = tar.extractfile(info).read()
    return files


def bounded_run(argv: list[str], timeout: float, limit: int = MAX_META) -> tuple[int, str, str]:
    """sh() for code root did not write: keeps at most `limit` bytes of each stream, drains and drops the rest."""
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                start_new_session=True)
    except OSError as e:
        return 127, "", str(e)
    kept = (bytearray(), bytearray())

    def drain(stream: Any, buf: bytearray) -> None:
        for chunk in iter(lambda: stream.read(65536), b""):
            buf.extend(chunk[:max(0, limit - len(buf))])

    readers = [threading.Thread(target=drain, args=(stream, buf), daemon=True)
               for stream, buf in ((proc.stdout, kept[0]), (proc.stderr, kept[1]))]
    for reader in readers:
        reader.start()
    try:
        code = proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        code = 124
        with contextlib.suppress(OSError):  # its own session (not yet reaped): what it started, holding our pipes, too
            os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
    for reader in readers:
        reader.join(5)
    for stream, reader in zip((proc.stdout, proc.stderr), readers):
        if not reader.is_alive():
            stream.close()
    return code, kept[0].decode(errors="replace"), kept[1].decode(errors="replace")


def stage_dir(install_dir: Path, root: bool) -> Path:
    stage = install_dir / "staged"
    stage.mkdir(mode=0o700, exist_ok=True)
    if root:
        check_root_dir(stage)
    return stage


def commit_pair(files: dict[str, bytes], install_dir: Path, root: bool, release: dict[str, str] | None) -> None:
    """The script, the policy and the release they are (installed.json; None for a hand install) change together or
    not at all: all staged, then a ready mark (the commit point), then the swap. A pass or install that dies after
    the mark is finished by finish_pair before any policy load."""
    stage = stage_dir(install_dir, root)
    for name, data in files.items():
        if read_bytes(stage / name) != data:
            atomic_write(stage / name, data, MODES[name], root)
    mark = {"files": {n: sha256(d) for n, d in files.items()}, "release": release}
    atomic_write(stage / PAIR_MARK, json.dumps(mark, sort_keys=True).encode(), 0o644, root)
    finish_pair(install_dir, root)


def finish_pair(install_dir: Path, root: bool) -> bool:
    """Swap in a pair marked ready; a mark whose staged files do not hash to it is dropped. True if one was marked."""
    stage = install_dir / "staged"
    mark = load_json(stage / PAIR_MARK)
    if not mark:
        return False
    want = mark.get("files") if isinstance(mark.get("files"), dict) else {}
    staged = {name: read_bytes(stage / name) for name in MEMBERS}
    if set(want) == set(MEMBERS) and all(data is not None and sha256(data) == want[name] for name, data in staged.items()):
        for name in (POLICY_NAME, SCRIPT_NAME):
            path = install_dir / name
            if read_bytes(path) != staged[name] or (path.stat().st_mode & 0o777) != MODES[name]:
                atomic_write(path, staged[name], MODES[name], root)
        release = mark.get("release")
        if isinstance(release, dict):
            atomic_write(install_dir / INSTALLED, json.dumps({**release, "files": want}, sort_keys=True).encode(),
                         0o644, root)
        else:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(install_dir / INSTALLED)  # a hand install: these bytes are no release this copy knows
    os.unlink(stage / PAIR_MARK)
    return True


def stage_check(files: dict[str, bytes], install_dir: Path, root: bool, run=bounded_run,
                python: str = SYSTEM_PYTHON) -> None:
    """The new pair must plan a pass with each other (its code reading its policy) before it replaces the snapshot."""
    stage = stage_dir(install_dir, root)
    for name, data in files.items():
        atomic_write(stage / name, data, MODES[name], root)
    code, out, err = run([python, "-I", os.fspath(stage / SCRIPT_NAME), "--policy", os.fspath(stage / POLICY_NAME),
                          "--state-dir", os.fspath(install_dir / "state")], timeout=CHECK_TIMEOUT)
    try:
        doc = json.loads(out) if code == 0 else None
    except ValueError:
        doc = None
    if not isinstance(doc, dict) or not str(doc.get("schema") or "").startswith("glaeda-daemon-heal/"):
        raise HealError(f"its own plan pass failed (exit {code}): {(err or out).strip()[-160:]}")
    if doc.get("follows") != RING:
        # Code from before self-update would run, but never update again: a hand install newer than the channel
        # (no installed.json, so no ancestry to check) would be stranded on it for good.
        raise HealError(f"its code does not keep itself on the {RING} release; kept")


def pair_hashes(install_dir: Path) -> dict[str, str | None]:
    return {name: None if (data := read_bytes(install_dir / name)) is None else sha256(data) for name in MEMBERS}


def refresh(policy: dict[str, Any], state: dict[str, Any], now: float, install_dir: Path = INSTALL_DIR,
            root: bool = True, get=fetch, run=bounded_run, python: str = SYSTEM_PYTHON) -> dict[str, Any]:
    """Bring the snapshot to the stable release's two files; returns the new state["release"]. Never raises: a
    channel or release that fails a check leaves the snapshot as it is and says why."""
    rel = dict(state.get("release") or {})
    have = {name: read_bytes(install_dir / name) for name in MEMBERS}
    hashes = pair_hashes(install_dir)
    ident = load_json(install_dir / INSTALLED)  # what the pair is, swapped with it: never ahead of or behind it
    drifted = ident.get("files") != hashes
    if now - float(rel.get("checked") or 0) < policy["release"]["every_s"] and not (drifted and not rel.get("error")):
        return rel
    rel["checked"] = now
    try:
        source, entry = read_channel(policy["release"]["sources"], get)
        rel.update(source=source, wants=None if entry is None else entry["tag"], ok=now)  # ok: the channel answered
        if entry is not None and (entry["tag"] != ident.get("tag") or drifted):
            commit = ident.get("commit") if isinstance(ident.get("commit"), str) else None
            files = release_files(source, entry, get, commit)
            release = {"tag": entry["tag"], "commit": entry["source"]}
            if any(have[name] != data for name, data in files.items()):
                stage_check(files, install_dir, root, run, python)
                commit_pair(files, install_dir, root, release)  # the next pass runs the pair
                rel["installed_at"] = now
            else:  # the bytes already are this release (a hand install of it): only name them
                atomic_write(install_dir / INSTALLED, json.dumps({**release, "files": hashes}, sort_keys=True).encode(),
                             0o644, root)
        rel["error"] = None
    except Exception as e:  # noqa: BLE001 (a root pass persists its heal state whatever the network or release did)
        rel["error"] = re.sub(r"\s+", " ", str(e))[:300] or type(e).__name__
    ident = load_json(install_dir / INSTALLED)
    rel.update(tag=ident.get("tag"), commit=ident.get("commit"))
    # behind: not the release the channel names, or not the bytes of the release it says it is (a repair failed)
    rel["drifted"] = ident.get("files") != pair_hashes(install_dir)
    if rel.get("wants") and rel.get("wants") != rel.get("tag") or rel["drifted"]:
        rel.setdefault("behind_since", now)
    else:
        rel.pop("behind_since", None)
    return rel


def release_report(rel: dict[str, Any], policy: dict[str, Any]) -> dict[str, Any]:
    def at(key: str) -> str | None:
        return iso(rel[key]) if isinstance(rel.get(key), (int, float)) else None
    return {"tag": rel.get("tag"), "commit": rel.get("commit"), "wants": rel.get("wants"), "source": rel.get("source"),
            "checkedAt": at("checked"), "okAt": at("ok"), "installedAt": at("installed_at"),
            "behindSince": at("behind_since"), "drifted": bool(rel.get("drifted")), "error": rel.get("error"), "staleAfterS": policy["release"]["stale_s"]}


def parse_iso(text: Any) -> float | None:
    try:
        return datetime.datetime.strptime(str(text), "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=datetime.timezone.utc).timestamp()
    except ValueError:
        return None


def judge(report: Any, now: float, installed: bool) -> dict[str, Any]:
    """current, stale or missing, and why, from the root report alone (any reader: mini-health, fleet-status).
    reinstall: whether a root --install can fix it (not for a channel it cannot read or a release it refused)."""
    if not installed:
        return {"state": "missing", "reinstall": True, "why": "the root daemon-heal LaunchDaemon is not installed"}
    at = parse_iso(report.get("at")) if isinstance(report, dict) else None
    if at is None:
        return {"state": "stale", "reinstall": True, "why": "the root daemon-heal LaunchDaemon has written no report: no passes run"}
    rel = report.get("release")
    limit = report.get("staleAfterS")
    if not isinstance(rel, dict) or type(limit) is not int or type(rel.get("staleAfterS")) is not int:
        return {"state": "stale", "reinstall": True, "why": "installed before it kept itself on the release: one root --install of a "
                                         "current release makes it"}
    if now - at > limit:
        return {"state": "stale", "reinstall": True, "why": f"its last pass was {round(now - at)} s ago: its passes are not running"}
    tag, wants, error = rel.get("tag"), rel.get("wants"), rel.get("error")
    grace = rel["staleAfterS"]
    because = f": {str(error)[:200]}" if error else ""
    behind = parse_iso(rel.get("behindSince"))
    if behind is not None and now - behind > grace and (wants and wants != tag or rel.get("drifted")):
        what = ("it has not identified its files as any release" if not tag else
                f"its files are not the {tag} they were installed as" if not wants or wants == tag else
                f"runs {tag}, its channel has named {wants}")
        return {"state": "stale", "reinstall": False, "why": f"{what} since {rel.get('behindSince')}{because}"}
    ok = parse_iso(rel.get("okAt"))
    if ok is None or now - ok > grace:
        return {"state": "stale", "reinstall": False, "why": f"has not read its release channel since {rel.get('okAt') or 'install'}"
                                         f"{because}"}
    lag = f", its channel names {wants}" if wants and wants != tag else ""
    return {"state": "current", "reinstall": False, "why": f"runs {tag or 'its install'}{lag}"}


def schedule_reload(install_dir: Path, plist_path: Path, state: dict[str, Any], now: float,
                    every_s: int, spawn=subprocess.Popen) -> bool:
    """A plist that no longer matches the installed policy (or this code) is reloaded by a detached --install, in
    its own session so launchd's bootout of this job does not end it; it waits for this pass to exit first."""
    want = desired_install(install_dir / POLICY_NAME, install_dir)["plist"]
    if read_bytes(plist_path) == want or now - float(state.get("reload_at") or 0) < every_s:
        return False
    state["reload_at"] = now
    with open(install_dir / "state" / "reload.log", "ab") as log:
        spawn([SYSTEM_PYTHON, "-I", os.fspath(install_dir / SCRIPT_NAME), "--install", "--apply", "--policy",
               os.fspath(install_dir / POLICY_NAME), "--after-pid", str(os.getpid())],
              stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True, close_fds=True)
    return True


# ---------------------------------------------------------------- main


def run_pass(policy_path: Path, state_dir: Path, apply: bool, host: Host | None = None,
             install_dir: Path | None = None, **release: Any) -> dict[str, Any]:
    """One pass. The installed root copy (or a test's install_dir) also keeps itself on the release."""
    policy = load_policy(policy_path)
    state = load_json(state_dir / "state.json")
    new_state, report = reconcile(host or Host(), policy, state, apply)
    root = os.geteuid() == 0
    if install_dir is None and root and Path(__file__).resolve() == (INSTALL_DIR / SCRIPT_NAME).resolve():
        install_dir = INSTALL_DIR
    for key in ("release", "reload_at"):
        if key in state:
            new_state[key] = state[key]
    if apply and install_dir is not None:
        new_state["release"] = refresh(policy, state, report_time(report), install_dir, root, **release)
        if root and install_dir == INSTALL_DIR:
            try:
                schedule_reload(install_dir, PLIST, new_state, report_time(report), policy["release"]["every_s"])
            except (HealError, OSError, ValueError) as e:  # never at the cost of this pass's report
                new_state["release"]["error"] = f"reload: {str(e)[:200]}"
    report["staleAfterS"] = policy["report_stale_passes"] * policy["every_s"]
    report["follows"] = RING  # stage_check: a release whose code says so keeps itself current once installed
    if "release" in new_state:
        report["release"] = release_report(new_state["release"], policy)
    if apply:
        state_dir.mkdir(mode=0o755, parents=True, exist_ok=True)
        atomic_write(state_dir / "state.json", json.dumps(new_state, sort_keys=True).encode() + b"\n", 0o644, root)
        atomic_write(state_dir / "report.json", json.dumps(report, sort_keys=True).encode() + b"\n", 0o644, root)
    return report


def report_time(report: dict[str, Any]) -> float:
    return parse_iso(report["at"]) or time.time()


def wait_for_exit(pid: int) -> None:
    deadline = time.time() + AFTER_PID_WAIT_S
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return
        except PermissionError:
            pass
        time.sleep(0.5)


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--policy", type=Path, required=True, help="config/macos-daemons.json")
    p.add_argument("--state-dir", type=Path, default=INSTALL_DIR / "state")
    p.add_argument("--apply", action="store_true")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--install", action="store_true", help="install or update the root LaunchDaemon")
    mode.add_argument("--status", action="store_true", help="is the installed copy this one")
    p.add_argument("--expect-sha256", help="--install: refuse unless this script's sha256 is this (from the release)")
    p.add_argument("--expect-policy-sha256", help="--install: the same for the policy file")
    p.add_argument("--after-pid", type=int, help="--install: wait for this pass to exit first (the self-reload)")
    args = p.parse_args(argv)
    try:
        if args.after_pid:
            wait_for_exit(args.after_pid)
        if args.apply and not args.install and os.geteuid() == 0 \
                and Path(__file__).resolve() == (INSTALL_DIR / SCRIPT_NAME).resolve():
            before = Path(__file__).read_bytes()
            if finish_pair(INSTALL_DIR, root=True) and Path(__file__).read_bytes() != before:
                # a swap a crash cut short, finished: run the pass with the code that goes with the new policy
                os.execv(SYSTEM_PYTHON, [SYSTEM_PYTHON, "-I", os.fspath(INSTALL_DIR / SCRIPT_NAME),
                                         *(sys.argv[1:] if argv is None else argv)])
        if args.status:
            out = install_status(args.policy)
        elif args.install:
            out = install(args.policy, args.apply, args.expect_sha256, args.expect_policy_sha256)
        else:
            out = run_pass(args.policy, args.state_dir, args.apply)
            if args.apply:
                if out["actions"]:
                    print(json.dumps({"at": out["at"], "actions": out["actions"]}, separators=(",", ":")), flush=True)
                return 0
    except (HealError, OSError, ValueError) as e:
        print(json.dumps({"schema": SCHEMA, "error": str(e)}), file=sys.stderr)
        return 1
    print(json.dumps(out, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
