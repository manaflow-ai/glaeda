# ---------------------------------------------------------------- small helpers


def sha256_bytes(data: bytes) -> str:
    return "sha256:" + hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str | None:
    try:
        return sha256_bytes(path.read_bytes())
    except OSError:
        return None


def stream_sha256(path: Path) -> str | None:
    """sha256_file for a large file (a runner tarball): hashed in chunks, never read whole."""
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as file:
            for chunk in iter(lambda: file.read(1 << 20), b""):
                digest.update(chunk)
    except OSError:
        return None
    return "sha256:" + digest.hexdigest()


def run(argv: list[str], timeout: int = RUN_TIMEOUT, env: dict[str, str] | None = None,
        cwd: Path | None = None, stdin_text: str | None = None) -> tuple[int, str]:
    """Run a command. Never raises; a missing tool is (127, ""). stdin_text, when given, is the child's stdin."""
    try:
        result = subprocess.run(
            argv, input=stdin_text, stdin=None if stdin_text is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, timeout=timeout, env=env, cwd=cwd, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return 127, str(error)[:400]
    return result.returncode, result.stdout.strip()[:65536]


def read_token(gh: str, endpoint: str) -> str | None:
    """POST for a one-time token. Only stdout is kept, in memory; the token is not in argv."""
    try:
        result = subprocess.run(
            [gh, "api", "-X", "POST", endpoint, "--jq", ".token"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, timeout=RUN_TIMEOUT, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    token = result.stdout.strip()
    if result.returncode != 0 or not token or not re.fullmatch(TOKEN_RE, token):
        return None
    return token


def run_with_token(argv: list[str], token: str, cwd: Path, timeout: int = 900) -> tuple[int, str]:
    """Run config.sh with the token only in that child's environment; scrub it from the output."""
    env = dict(os.environ)
    env["ACTIONS_RUNNER_INPUT_TOKEN"] = token
    try:
        # Own process group: config.sh runs Runner.Listener as a child, which would otherwise outlive
        # a timeout, keep the token in its environment, and register behind our back.
        proc = subprocess.Popen(
            argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, env=env, cwd=cwd, start_new_session=True,
        )
        try:
            out, _ = proc.communicate(timeout=timeout)
            code = proc.returncode
        except subprocess.TimeoutExpired:
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, signal.SIGKILL)
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.communicate(timeout=10)
            code, out = 124, f"config.sh timed out after {timeout} seconds; its process group was killed"
    except OSError as error:
        code, out = 127, str(error)
    finally:
        env.pop("ACTIONS_RUNNER_INPUT_TOKEN", None)
    return code, out.replace(token, "***").strip()[-2000:]


def which(name: str, extra: tuple[str, ...] = ()) -> str | None:
    found = shutil.which(name)
    if found:
        return found
    for candidate in extra:
        if os.access(candidate, os.X_OK):
            return candidate
    return None


# The hooks' interpreter, best first. /usr/bin/python3 is the xcrun shim: it runs Xcode's (or the Command Line Tools')
# python with SDKROOT exported into its environment, which the gate once passed to every job (cmux21, 2026-10-21), and
# it fails outright when that SDK is gone. A fleet member's job PATH has Homebrew's python3 anyway (the hook's
# MIN_WORKLOAD_PYTHON), so the shim is the last resort.
HOOK_PYTHONS = ("/opt/homebrew/bin/python3", "/usr/local/bin/python3", "/usr/bin/python3")
XCRUN_SHIM_PYTHON = "/usr/bin/python3"


def hook_python() -> str | None:
    """python3 on PATH unless it is the xcrun shim, else the first HOOK_PYTHONS that runs, the shim last."""
    found = shutil.which("python3")
    if found and os.path.realpath(found) != XCRUN_SHIM_PYTHON:
        return found
    for candidate in HOOK_PYTHONS:
        if os.access(candidate, os.X_OK) and os.path.realpath(candidate) != XCRUN_SHIM_PYTHON:
            return candidate
    return XCRUN_SHIM_PYTHON if os.access(XCRUN_SHIM_PYTHON, os.X_OK) else found


def write_atomic(path: Path, data: bytes, mode: int, make_parent: bool = True) -> None:
    """Write and sync a unique stage beside path, then rename it over path: a reader, or a crash, sees the old
    file or the whole new one. --refresh-hooks passes make_parent=False: it never recreates a removed runner."""
    if make_parent:
        path.parent.mkdir(parents=True, exist_ok=True)
    stage = stage_file(path, data, mode)
    try:
        os.replace(stage, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(stage)
        raise
    sync_dir(path.parent)


RUNNER_LABEL_PREFIX = "glaeda-runner-"


def runner_label(name: str) -> str:
    """The label only the runner registered as `name` carries (glaeda-runner-<name>, lowercase)."""
    return RUNNER_LABEL_PREFIX + re.sub(r"[^a-z0-9._-]+", "-", name.lower())


def default_name() -> str:
    host = socket.gethostname().split(".")[0].lower()
    host = re.sub(r"[^a-z0-9-]+", "-", host).strip("-") or "mac"
    return f"{host}-glaeda"


class Context:
    def __init__(self, args: argparse.Namespace) -> None:
        self.home = Path(os.environ.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir)
        self.uid = os.getuid()
        real_home = Path(pwd.getpwuid(self.uid).pw_dir)
        # A fake HOME (tests, rehearsals) must never reach the real launchd session.
        self.sandbox = os.path.realpath(self.home) != os.path.realpath(real_home)
        self.skip_launchctl = args.skip_launchctl or self.sandbox
        # Never let a fake HOME used by tests or rehearsals reach the real system
        # LaunchDaemon path, even when --headless was passed.
        self.headless = bool(args.headless) and not self.sandbox
        self.apply = args.apply
        self.org = args.org
        self.repo = None if args.org else (args.repo or DEFAULT_REPO)
        self.instance = args.instance or 0
        self.gui_runner = bool(args.gui_runner)  # the member's gui runner (or an explicitly managed guest runner)
        self.gui_token = args.gui_token
        self.fast_runner = False  # the member's fast runner (fastRunners 1: the last instance, the fast pool label)
        self.session_runner = False  # a gui-role instance other than the console one (guiRunners above 1)
        self.gateway_runner = False  # a gateway runner (gatewayRunners: the instances after runners, the gateway label)
        # Instance 0 keeps the original paths; instance K adds -K (dirs, logs, name) or .K (launchd label).
        self.suffix = f"-{self.instance}" if self.instance else ""
        self.label = f"{LABEL}.{self.instance}" if self.instance else LABEL
        self.name = args.name or default_name() + self.suffix
        extra = [label.strip() for label in (args.labels or "").split(",") if label.strip()]
        self.labels = list(dict.fromkeys([*BASE_LABELS, MINI_LABEL, *extra]))
        # True when this run says what the labels must be (--labels or --manifest); otherwise a
        # re-run keeps whatever the receipt registered and never asks for a relabel.
        self.labels_requested = bool(extra)
        self.member: dict[str, Any] | None = None
        self.dedicated: dict[str, Any] | None = None  # a runner.dedicated entry (--dedicated): see dedicated_context
        self.min_free_gib: float = args.min_free_gib or 0
        self.capacity_units: int = args.capacity_units or 0
        configured_capacity = args.capacity_dir or os.environ.get("GLAEDA_FLEET_CAPACITY_DIR")
        self.capacity_dir = Path(configured_capacity).expanduser().absolute() if configured_capacity else \
            Path(os.environ.get("GLAEDA_FLEET_DIR") or "/Users/Shared/cmux-build-fleet") / "capacity"
        self.group = args.group
        self.replace = args.replace
        self.version = args.runner_version
        self.pinned_sha = args.runner_sha256
        # What the operator resolved as the latest release, once per fleet apply (glaeda-cmux-runner-fleet).
        self.latest_version = args.latest_runner_version
        self.latest_sha = (args.latest_runner_sha256 or "").lower().removeprefix("sha256:") or None
        cache = os.environ.get(RUNNER_CACHE_ENV)
        self.runner_cache = Path(cache).expanduser().absolute() if cache else self.home / RUNNER_CACHE
        self.route_repo = args.route_repo
        self.runner_dir = (args.runner_dir or self.home / f"actions-runner-glaeda{self.suffix}").expanduser().absolute()
        self.hook_dir = self.runner_dir / HOOK_DIR
        self.gh = args.gh or which("gh", ("/opt/homebrew/bin/gh", "/usr/local/bin/gh"))
        self.gh_state = "missing" if self.gh is None else "logged in"
        self.xcode_app = args.xcode_app
        self.python = args.python or hook_python()
        self.agents = self.home / "Library/LaunchAgents"
        self.logs = self.home / "Library/Logs"
        self.state = self.home / ".local/state/glaeda/cmux-runner"
        if self.instance:
            self.state = self.state / f"instance-{self.instance}"
        self.receipt_path = self.state / "receipt.json"
        self.plist_path = self.agents / f"{self.label}.plist"
        self.service_plist_path = (SYSTEM_DAEMON_DIR / f"{self.label}.plist") if self.headless else self.plist_path
        self.log_path = self.logs / f"glaeda-cmux-runner{self.suffix}.log"
        self.token_stdin = args.token_stdin
        self.github_labels = getattr(args, "github_labels", None)
        self.stdin_token: str | None = None  # set by main() from stdin; used once, never stored

    def take_token(self, endpoint: str) -> str | None:
        """The stdin token when one was given (single use), otherwise a fresh one from gh."""
        if self.token_stdin:
            token, self.stdin_token = self.stdin_token, None
            return token
        return read_token(self.gh or "gh", endpoint)

    @property
    def scope_api(self) -> str:
        return f"orgs/{self.org}" if self.org else f"repos/{self.repo}"

    @property
    def scope_url(self) -> str:
        return f"https://github.com/{self.org or self.repo}"

    def show(self, path: Path | str) -> str:
        text, home = os.fspath(path), os.fspath(self.home)
        return "~" + text[len(home):] if text == home or text.startswith(home + "/") else text


def xcode_present(app: dict[str, Any]) -> bool:
    """The manifest's Xcode is really here: a real directory whose xcodebuild reports that exact build."""
    path, build = Path(str(app.get("path") or "")), str(app.get("build") or "")
    if not path.is_absolute() or not build or not path.is_dir() or path.is_symlink():
        return False
    code, out = run(["/usr/bin/xcodebuild", "-version"],
                    env={**os.environ, "DEVELOPER_DIR": os.fspath(path / "Contents/Developer")})
    version = str(app.get("version") or "")
    return (code == 0 and re.search(rf"^Build version {re.escape(build)}$", out, re.M) is not None
            and re.search(rf"^Xcode {re.escape(version)}$", out, re.M) is not None)


def ios_sim_present(apps: list[dict[str, Any]], builds: list[str]) -> bool | None:
    """Every iOS simulator runtime build in builds (23F77) is available (simctl, read-only). Runtimes are shared by
    every Xcode on the machine, so the member's first verified Xcode answers for all. None when simctl gives no
    usable answer."""
    developer = Path(str(apps[0].get("path") or "")) / "Contents/Developer"
    code, out = run(["/usr/bin/xcrun", "simctl", "list", "runtimes", "-j"],
                    env={**os.environ, "DEVELOPER_DIR": os.fspath(developer)})
    if code != 0:
        return None
    try:
        runtimes = json.loads(out[out.find("{"):]).get("runtimes")  # stderr is merged in; skip any warning
    except (ValueError, AttributeError):
        return None
    if not isinstance(runtimes, list):
        return None
    have = {str(r.get("buildversion")) for r in runtimes
            if isinstance(r, dict) and r.get("isAvailable") and r.get("platform") == "iOS"}
    return all(b in have for b in builds)


def macos_major() -> str | None:
    """This host's macOS major version from sw_vers (27.0.1 -> "27"); None when sw_vers gives no usable answer."""
    code, out = run(["/usr/bin/sw_vers", "-productVersion"])
    found = re.fullmatch(r"([1-9][0-9]*)(\.[0-9]+)*", out.strip()) if code == 0 else None
    return found.group(1) if found else None


def fleet_labels() -> Any:
    """The shared label rule, loaded from beside this script only when --manifest asks for it."""
    path = SCRIPT_DIR / LABELS_MODULE
    loader = importlib.machinery.SourceFileLoader("glaeda_fleet_labels", os.fspath(path))
    spec = importlib.util.spec_from_loader("glaeda_fleet_labels", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def member_labels(manifest: Any, member: str, prior_labels: list[str] | None = None
                  ) -> tuple[dict[str, Any] | None, str | None]:
    """(member summary with labels, None) or (None, why this member cannot be a runner). Reads only.
    prior_labels: what this runner registered with, so a simctl or sw_vers hiccup keeps the iOS or macOS label
    instead of re-registering the runner without it."""
    try:
        rule = fleet_labels()
    except Exception as error:  # noqa: BLE001  (missing, broken or stale module: explain, never a traceback)
        return None, f"{LABELS_MODULE} must sit next to this script for --manifest ({type(error).__name__})"
    def ios_sim_ok(apps: list[dict[str, Any]], builds: list[str]) -> bool:
        found = ios_sim_present(apps, builds)
        return found if found is not None else getattr(rule, "IOS_SIM_LABEL", "glaeda-ios-sim") in (prior_labels or [])
    if not hasattr(rule, "macos_label"):  # an older label module beside this script: no OS label, no traceback
        return rule.member_labels(manifest, member, lambda app: xcode_present(app), ios_sim_ok)
    major = macos_major()
    if major is None:
        prefix = rule.MACOS_LABEL_PREFIX
        major = next((label[len(prefix):] for label in prior_labels or [] if label.startswith(prefix)), None)
    return rule.member_labels(manifest, member, lambda app: xcode_present(app), ios_sim_ok, macos_major=major)


def load_receipt(ctx: Context) -> dict[str, Any] | None:
    try:
        doc = json.loads(ctx.receipt_path.read_text())
        return doc if isinstance(doc, dict) else None
    except (OSError, ValueError):
        return None


# ---------------------------------------------------------------- GitHub reads


def api_token() -> str | None:
    """A GitHub token from the environment for the gh-free path, or None (then the read is unauthenticated)."""
    for name in API_TOKEN_ENV:
        value = os.environ.get(name, "").strip()
        if value and re.fullmatch(TOKEN_RE, value):
            return value
    return None


def gh_json(ctx: Context, endpoint: str, public: bool = False) -> Any:
    if ctx.gh is None and public:
        argv = [CURL, "-fsSL", "--retry", "3", "-H", "Accept: application/vnd.github+json"]
        token = api_token()
        if token:  # on curl's stdin as a config line, never in argv or a file
            code, out = run([*argv, "--config", "-", PUBLIC_API + endpoint],
                            stdin_text=f'header = "Authorization: Bearer {token}"\n')
        else:
            code, out = run([*argv, PUBLIC_API + endpoint])
    elif ctx.gh is None:
        return None
    else:
        code, out = run([ctx.gh, "api", endpoint])
    if code != 0:
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None


def runner_asset(version: str) -> str:
    return f"actions-runner-{PLATFORM_ASSET}-{version}.tar.gz"


def version_key(version: str) -> tuple[int, ...]:
    return tuple(int(part) for part in version.split("."))


def known_release(version: str, sha: str, sources: list[str], via: str) -> dict[str, Any]:
    """A release this mini can install without asking the API: the download URL follows from the version."""
    asset = runner_asset(version)
    return {"state": "ok", "version": version, "asset": asset,
            "url": RUNNER_DOWNLOAD_URL.format(version=version, asset=asset), "sha256": sha,
            "shaSources": sources, "resolvedBy": via}


def release_from_doc(release: Any, pinned_sha: str | None = None) -> dict[str, Any]:
    """Version, url and expected sha256 of a GitHub release document's osx-arm64 asset. Pure: the fleet's one
    "latest" read uses it too."""
    if not isinstance(release, dict):
        return {"state": "blocked", "note": "not a release document"}
    version = str(release.get("tag_name") or "").lstrip("v")
    if not re.fullmatch(RUNNER_VERSION_RE, version):
        return {"state": "blocked", "note": f"release tag {version[:40]!r} is not a runner version"}
    asset_name = runner_asset(version)
    asset = next((a for a in release.get("assets") or [] if isinstance(a, dict) and a.get("name") == asset_name), None)
    if asset is None:
        return {"state": "blocked", "note": f"release v{version} has no {asset_name}"}
    body = str(release.get("body") or "")
    match = re.search(rf"<!--\s*BEGIN SHA {re.escape(PLATFORM_ASSET)}\s*-->\s*([0-9a-f]{{64}})\s*<!--\s*END SHA", body)
    notes_sha = match.group(1) if match else None
    digest = str(asset.get("digest") or "")
    digest_sha = digest.split(":", 1)[1] if digest.startswith("sha256:") else None
    if pinned_sha:
        expected = pinned_sha.lower().removeprefix("sha256:")
    else:
        expected = notes_sha or digest_sha
    if expected is None:
        return {"state": "blocked", "note": f"release v{version} publishes no SHA-256 for {PLATFORM_ASSET}; pass --runner-sha256"}
    for other in (notes_sha, digest_sha):
        if other and other != expected:
            return {"state": "blocked", "note": f"SHA-256 sources disagree for v{version}; refusing"}
    return {"state": "ok", "version": version, "asset": asset_name,
            "url": asset.get("browser_download_url"), "sha256": expected,
            "shaSources": [n for n, v in (("releaseNotes", notes_sha), ("assetDigest", digest_sha), ("pinned", pinned_sha)) if v]}


def cached_release(ctx: Context, version: str) -> dict[str, Any] | None:
    """The cached tarball of this version when its marker names it and its bytes still hash to the marker's
    SHA-256 (re-hashed now: a truncated or replaced file is a miss, never trusted). Reads only."""
    if not re.fullmatch(RUNNER_VERSION_RE, version):
        return None
    folder = ctx.runner_cache / version
    try:  # only this user's own folder and marker vouch for a tarball (GLAEDA_RUNNER_CACHE_DIR may be shared)
        folder_info, marker_info = folder.lstat(), (folder / RUNNER_CACHE_MARKER).lstat()
        if not stat.S_ISDIR(folder_info.st_mode) or not stat.S_ISREG(marker_info.st_mode) or \
                folder_info.st_uid != ctx.uid or marker_info.st_uid != ctx.uid or folder_info.st_mode & 0o022:
            return None
        marker = json.loads((folder / RUNNER_CACHE_MARKER).read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(marker, dict) or marker.get("schema") != RUNNER_CACHE_SCHEMA or marker.get("version") != version:
        return None
    sha, asset = str(marker.get("sha256") or ""), runner_asset(version)
    tarball = folder / asset
    try:
        info = tarball.lstat()
    except OSError:
        return None
    if not re.fullmatch(SHA256_RE, sha) or not stat.S_ISREG(info.st_mode) or info.st_uid != ctx.uid:
        return None
    if stream_sha256(tarball) != "sha256:" + sha:
        return None
    sources = [s for s in marker.get("shaSources") or [] if isinstance(s, str)][:4]
    return {**known_release(version, sha, sources, "cache"), "cached": os.fspath(tarball)}


def cached_versions(ctx: Context) -> list[str]:
    """Versions with a folder in the runner cache, newest first (each still needs cached_release). Reads only."""
    try:
        names = [p.name for p in ctx.runner_cache.iterdir() if p.is_dir() and not p.is_symlink()]
    except OSError:
        return []
    return sorted((n for n in names if re.fullmatch(RUNNER_VERSION_RE, n)), key=version_key, reverse=True)


def installed_versions(ctx: Context) -> list[tuple[str, str | None]]:
    """(version, its SHA-256 when an install recorded it) for every runner this user installed on the mini,
    newest first. A self-updated runner's bin symlink (bin -> bin.2.339.0) wins over its receipt's version,
    which names only what was unpacked. Reads only."""
    base = ctx.home / ".local/state/glaeda/cmux-runner"
    found: dict[str, str | None] = {}
    for path in [base / "receipt.json", *sorted(base.glob("instance-*/receipt.json"))]:
        try:
            doc = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(doc, dict) or not doc.get("runnerDirOwned") or not doc.get("runnerDir"):
            continue
        runner_dir = Path(str(doc["runnerDir"]))
        if not (runner_dir / "config.sh").is_file():
            continue
        recorded = str(doc.get("runnerVersion") or "")
        sha = str(doc.get("runnerSha256") or "")
        live = None
        with contextlib.suppress(OSError):
            target = os.readlink(runner_dir / "bin")
            hit = re.fullmatch(rf"(?:.*/)?bin\.({RUNNER_VERSION_RE})/?", target)
            live = hit.group(1) if hit else None
        version = live or recorded
        if not re.fullmatch(RUNNER_VERSION_RE, version):
            continue
        known = sha if version == recorded and re.fullmatch(SHA256_RE, sha) else None
        found[version] = found.get(version) or known
    return sorted(found.items(), key=lambda item: version_key(item[0]), reverse=True)


def local_release(ctx: Context, version: str, recorded_sha: str | None = None) -> dict[str, Any] | None:
    """This version's release when its SHA-256 is known on this mini without the API: the cache, an install's
    receipt, the operator's resolved latest, or the pinned fallback. Reads only."""
    cached = cached_release(ctx, version)
    if cached:
        return cached
    if recorded_sha:
        return known_release(version, recorded_sha, ["receipt"], "receipt")
    if ctx.latest_version == version and ctx.latest_sha:
        return known_release(version, ctx.latest_sha, ["operator"], "operator")
    if version == PINNED_RUNNER_VERSION:
        return known_release(version, PINNED_RUNNER_SHA256, ["pinned"], "pinned")
    return None


def api_release(ctx: Context, endpoint: str, via: str) -> dict[str, Any]:
    release = release_from_doc(gh_json(ctx, endpoint, public=True), ctx.pinned_sha)
    if release["state"] == "ok":
        release["resolvedBy"] = via
    elif release.get("note") == "not a release document":
        release["note"] = f"could not read {endpoint}"
    return release


def resolve_release(ctx: Context) -> dict[str, Any]:
    """Which osx-arm64 runner a new install unpacks: version, url, expected sha256 and resolvedBy. Reads only
    (a plan calls it); download_and_unpack fills the cache. The fleet minis share one public IP, so the order
    keeps a fleet apply off GitHub's unauthenticated API (60 reads an hour per IP):
      1. --runner-version: that release; its SHA-256 from --runner-sha256 or the cache, else its tag on the API
      2. the newest version an existing instance on this mini runs, when its SHA-256 is known here (the cache,
         that install's receipt, the operator's --latest-runner-*, or the pinned fallback)
      3. the newest verified tarball in this mini's runner cache
      4. the operator's --latest-runner-version/--latest-runner-sha256 (glaeda-cmux-runner-fleet reads
         "latest" once per apply, authenticated, and passes it to every instance)
      5. the API, read once: an existing instance's version by its tag, else "latest"; through gh when it is
         logged in, else curl with GH_TOKEN or GITHUB_TOKEN when set
      6. PINNED_RUNNER_VERSION, when the API gives no usable answer
    The runner self-updates after it registers, so an older version than "latest" is never wrong, only one
    update behind."""
    if ctx.version:
        if ctx.pinned_sha:
            return known_release(ctx.version, ctx.pinned_sha.lower().removeprefix("sha256:"), ["pinned"], "flag")
        cached = cached_release(ctx, ctx.version)
        return cached or api_release(ctx, f"{RUNNER_RELEASE_API}/tags/v{ctx.version}", "api-tag")
    if ctx.pinned_sha:  # a SHA-256 pinned without a version vouches only for what "latest" names, as before
        return api_release(ctx, f"{RUNNER_RELEASE_API}/latest", "api-latest")
    installed = installed_versions(ctx)
    for version, sha in installed:
        found = local_release(ctx, version, sha)
        if found:
            return {**found, "reused": "installed"}
    for version in cached_versions(ctx):
        found = cached_release(ctx, version)
        if found:
            return found
    if ctx.latest_version and ctx.latest_sha:
        return known_release(ctx.latest_version, ctx.latest_sha, ["operator"], "operator")
    if installed:
        version = installed[0][0]
        found = api_release(ctx, f"{RUNNER_RELEASE_API}/tags/v{version}", "api-tag")
        if found["state"] == "ok" and found["version"] == version:
            return {**found, "reused": "installed"}
    else:
        found = api_release(ctx, f"{RUNNER_RELEASE_API}/latest", "api-latest")
        if found["state"] == "ok":
            return found
    return {**known_release(PINNED_RUNNER_VERSION, PINNED_RUNNER_SHA256, ["pinned"], "pinned"),
            "note": f"fell back to the pinned version ({found.get('note') or 'the API gave no usable release'})"}


def lookup_runner(ctx: Context) -> tuple[bool, dict[str, Any] | None]:
    """(query succeeded, runner with ctx.name or None). A failed query is not "absent"."""
    # filtered by name: an org's list (hosted scale sets included) runs far past one page
    doc = gh_json(ctx, f"{ctx.scope_api}/actions/runners?name={urllib.parse.quote(ctx.name)}&per_page=100")
    if not isinstance(doc, dict) or not isinstance(doc.get("runners"), list):
        return False, None
    for runner in doc["runners"]:
        if runner.get("name") == ctx.name:
            return True, {"id": runner.get("id"), "status": runner.get("status"), "busy": runner.get("busy"),
                          "labels": sorted(label.get("name") for label in runner.get("labels") or [])}
    return True, None


def find_runner(ctx: Context) -> dict[str, Any] | None:
    return lookup_runner(ctx)[1]


# ---------------------------------------------------------------- desired state


def ere_escape(text: str) -> str:
    """text as a POSIX extended regular expression that matches only itself (for pgrep -f)."""
    return re.sub(r"([][.*^$+?(){}|\\])", r"\\\1", text)


def hook_wrappers(ctx: Context) -> dict[str, bytes]:
    python = shlex.quote(ctx.python or "/usr/bin/python3")
    hook = shlex.quote(os.fspath(ctx.hook_dir / "glaeda-cmux-runner-hook"))
    gui_token = getattr(ctx, "gui_token", "gui")
    if not isinstance(gui_token, str):
        gui_token = "gui"
    capacity_dir = getattr(ctx, "capacity_dir", Path(os.environ.get("GLAEDA_FLEET_DIR") or
                                                       "/Users/Shared/cmux-build-fleet") / "capacity")
    if not isinstance(capacity_dir, (str, bytes, os.PathLike)):
        capacity_dir = Path(os.environ.get("GLAEDA_FLEET_DIR") or "/Users/Shared/cmux-build-fleet") / "capacity"
    scope = f"--allowed-owner {shlex.quote(ctx.org)}" if ctx.org else f"--allowed-repo {shlex.quote(ctx.repo or '')}"
    recycle = ""
    if ctx.min_free_gib:
        scope += f" --min-free-gib {ctx.min_free_gib:g}"
    dedicated = dedicated_of(ctx)
    if dedicated:  # glaeda's checks, then the builder's own admission (dedicated-admit.sh below)
        scope += f" --dedicated-admit {shlex.quote(os.fspath(ctx.hook_dir / DEDICATED_ADMIT))}"
        if dedicated.get("yieldToExclusive"):  # the hook's YIELD_TO_EXCLUSIVE
            scope += " --yield-to-exclusive"
    trusted_entry = dedicated if (dedicated or {}).get("trustedRef") else None
    if trusted_entry:
        # A trusted runner.dedicated entry (glaeda_fleet_labels DEDICATED_TRUSTED) holds a trusted pool's labels:
        # only jobs on its branch, never PR code. Independent of ctx.member, which a dedicated runner does not set.
        scope += (f" --trusted-ref {shlex.quote(trusted_entry['trustedRef'])}"
                  f" --trusted-repo {shlex.quote(trusted_entry['trustedRepo'])}")
    if ctx.member:  # a fleet member runs PR jobs only while it is an eligible node on its class toolchain
        scope += f" --require-eligible --fleet-class {shlex.quote(ctx.member['hardware'])}"
        if ctx.member.get("xcodeApps"):
            scope += f" --toolchain-xcode {shlex.quote(ctx.member['xcodeApps'][0])}"
        if trusted_entry:
            pass  # its trust arguments are above; never a PR runner's setup
        elif ctx.member.get("trustedRef"):  # this mini holds a secret: only jobs on that branch, never PR code
            scope += (f" --trusted-ref {shlex.quote(ctx.member['trustedRef'])}"
                      f" --trusted-repo {shlex.quote(ctx.member['trustedRepo'])}")
            if ctx.member.get("trustedNextNightly"):
                scope += " --trusted-next-nightly"
            if ctx.member.get("trustedNextSigning"):
                scope += " --trusted-next-signing"
        elif dev_compile_instance(ctx.member, ctx.instance):
            scope += " --dev-compile-runner"
        elif getattr(ctx, "gateway_runner", False) is True:
            # thin cmux-ci clients only (the hook's GATEWAY_JOBS): no test keychain, no gui token to recycle for
            scope += " --gateway-runner"
        else:  # PR runners: an unlocked test keychain (the login keychain is locked in the runner session)
            if nightly_slot_instance(ctx.member, ctx.instance):  # the nightly slot: nightly jobs only, same setup
                scope += " --nightly-runner"
            scope += " --test-keychain"
            # and a fresh testmanagerd for each job that takes the gui token (a wedged one hangs every XCTest run)
            recycle = " --recycle-testmanagerd"
            scope += recycle
    if ctx.capacity_units:  # every runner on this mini shares these units (the hook's capacity ledger)
        scope += f" --capacity-units {int(ctx.capacity_units)}"
        slots = int((ctx.member or {}).get("compileSlots") or 1)
        if slots > 1:
            scope += f" --compile-slots {slots}"
        roots = int((ctx.member or {}).get("canonicalRoots") or 1)
        if roots > 1:
            # instance i prefers root i+1, so a root runner keeps compiling in the tree its warm labels name
            scope += f" --canonical-roots {roots}"
        # always, so the listener gate tells a root runner from a side runner (instance below the roots)
        scope += f" --instance {ctx.instance}"
        if getattr(ctx, "gui_runner", False):  # the listener gate holds it while the gui token or every root is taken
            scope += " --gui-runner"
            scope += f" --gui-token {shlex.quote(gui_token)}"
        if getattr(ctx, "session_runner", False):  # session-only jobs: the gate holds it only for units
            scope += " --session-runner"
        if getattr(ctx, "fast_runner", False):  # fast-tier takes the fast tokens; the gate holds it while they are taken
            scope += " --fast-runner"
    started = (
        "#!/bin/bash\n"
        "# glaeda-cmux-runner job-started hook (generated, receipt-owned). A non-zero exit fails the job\n"
        "# before any step runs. A missing interpreter also exits non-zero, so this fails closed.\n"
        f"exec {python} {hook} job-started {scope}\n"
    )
    completed = (
        "#!/bin/bash\n"
        "# glaeda-cmux-runner job-completed hook (generated, receipt-owned). Never fails the job.\n"
        f"{python} {hook} job-completed || true\n"
        "exit 0\n"
    )
    gate = (f"{python} {hook} listen --runner-dir {shlex.quote(os.fspath(ctx.runner_dir))}"
            + ("" if ctx.capacity_units else " --no-waiters"))
    # Listening with fewer free units (cores) than the label's costliest job only takes one to wait for units, and
    # a job waiting here holds every runner on the mini (cmuxterm-hq#661 Workstream 7). The iOS picker sends
    # isolated builds (mobile-core-package, ios-simulator-build) to glaeda-ios-sim; a session runner takes cmux-next's
    # daemon tests, generated files, both autofix workflows' action exports and the media tour.
    fit = max([IOS_SIM_FIT_UNITS] * (IOS_SIM_JOB_LABEL in ctx.labels)
              + [SESSION_FIT_UNITS] * (getattr(ctx, "session_runner", False) is True), default=0)
    if ctx.capacity_units and fit:
        gate += f" --fit-units {fit}"
    # The runner and every job it runs build with the pool Xcode: no SDKROOT or TOOLCHAINS to send xcrun past it
    # (the hook's listener_env does the same for the run.sh the gate starts).
    xcode_apps = (ctx.member or {}).get("xcodeApps") or []
    toolchain_env = "unset SDKROOT TOOLCHAINS\n" + (
        f"export DEVELOPER_DIR={shlex.quote(os.fspath(Path(xcode_apps[0]) / 'Contents/Developer'))}\n"
        if xcode_apps else "")
    home = ctx.home if isinstance(getattr(ctx, "home", None), Path) else Path.home()
    # the gate's default --state-dir and its registration_file()
    registration = shlex.quote(os.fspath(home / ".local/state/glaeda/cmux-runner"
                                         / f"registration-{Path(ctx.runner_dir).name}.json"))
    listen = (
        "#!/bin/bash\n"
        "# glaeda-cmux-runner listener gate (generated, receipt-owned): the runner LaunchAgent's program. The\n"
        "# hook's gate runs run.sh and stops an idle listener while the fleet has the host. If the gate cannot\n"
        "# run, the runner runs without it, as it did before the gate. bash, like run.sh, stays the job's main\n"
        "# program for macOS privacy grants.\n"
        f"cd {shlex.quote(os.fspath(ctx.runner_dir))} || exit 1\n"
        + toolchain_env +
        f"{gate} &\n"
        "gate=$!\n"
        "stopping=\n"
        "trap 'stopping=1; kill -TERM \"$gate\" 2>/dev/null' TERM INT\n"
        "while :; do\n"
        "    wait \"$gate\"\n"
        "    code=$?\n"
        "    kill -0 \"$gate\" 2>/dev/null || break\n"
        "done\n"
        "[ -n \"$stopping\" ] && exit 0\n"
        "[ \"$code\" -eq 0 ] && exit 0\n"
        "# The gate died (a crash, a SIGKILL, a re-exec into a hook it cannot run). If its runner still runs,\n"
        "# never start a second one beside it: stop the listener once it has no job, then exit 1 so launchd\n"
        "# restarts this wrapper and a fresh gate. With no runner left, run it without the gate.\n"
        f"dir={shlex.quote(os.fspath(ctx.runner_dir))}  # as the gate runs it\n"
        f"re={shlex.quote(ere_escape(os.fspath(ctx.runner_dir)))}  # the same, as a literal pgrep pattern\n"
        "tree=\"$re/run|$re/bin[^/ ]*/Runner\\.(Listener|Worker)\"  # bin.<version> after a self-update\n"
        "sup=\"$re/(run(-helper)?\\.sh|bin[^/ ]*/Runner\\.Listener)\"  # the listener and what starts one\n"
        "# SIGSTOP them until a look finds every match stopped (a listener forked during a pkill is caught by the next\n"
        "# pass); 0 when stable, 1 when a signal or ps failed or the tree kept changing\n"
        "freeze() {\n"
        "    tries=0\n"
        "    while [ \"$tries\" -lt 5 ]; do\n"
        "        tries=$((tries + 1))\n"
        "        rc=0; /usr/bin/pkill -STOP -f \"$sup\" || rc=$?\n"
        "        [ \"$rc\" -le 1 ] || return 1\n"
        "        table=$(/bin/ps -axww -o stat=,command=) || return 1\n"
        "        rc=0; matches=$(printf '%s\\n' \"$table\" | /usr/bin/grep -E -- \"$sup\") || rc=$?\n"
        "        [ \"$rc\" -le 1 ] || return 1\n"
        "        running=$(printf '%s\\n' \"$matches\" | /usr/bin/awk 'NF && $1 !~ /^T/') || return 1\n"
        "        [ -n \"$running\" ] || return 0\n"
        "    done\n"
        "    return 1\n"
        "}\n"
        "if /usr/bin/pgrep -f \"$tree\" >/dev/null; then\n"
        "    echo \"$(date -u '+%Y-%m-%d %H:%M:%SZ'): glaeda-cmux-runner-gate: the gate exited $code with its runner running; stopping the runner once it has no job\"\n"
        "    # idle only by the hook's own test (no Worker, no request its listener took: exit 3), decided with the\n"
        "    # listener and run.sh/run-helper.sh frozen, so none can start or take one before the SIGINT; a hook that\n"
        "    # cannot answer keeps the runner\n"
        "    while [ -z \"$stopping\" ] && /usr/bin/pgrep -f \"$tree\" >/dev/null; do\n"
        "        freeze; frozen=$?\n"
        f"        {python} {hook} busy --runner-dir \"$dir\" >/dev/null 2>&1; busy=$?\n"
        "        if [ \"$frozen\" -eq 0 ] && [ \"$busy\" -eq 3 ]; then\n"
        "            /usr/bin/pkill -INT -f \"$re/bin[^/ ]*/Runner\\.Listener\" ||\n"
        "                /usr/bin/pkill -TERM -f \"$re/run\"\n"
        "        fi\n"
        "        /usr/bin/pkill -CONT -f \"$sup\"\n"
        "        sleep 5\n"
        "    done\n"
        "    exit 1\n"
        "fi\n"
        # A deleted registration (the hook's registration_deleted) is the gate's backoff: never retried without it
        # unless config.sh re-registered it since (.runner is newer than the record)
        f"if [ -f {registration} ] && [ ! .runner -nt {registration} ]; then\n"
        "    echo \"$(date -u '+%Y-%m-%d %H:%M:%SZ'): glaeda-cmux-runner-gate: the gate exited $code and GitHub deleted"
        " this runner's registration; leaving the retry to a fresh gate\"\n"
        "    exit 1\n"
        "fi\n"
        "echo \"$(date -u '+%Y-%m-%d %H:%M:%SZ'): glaeda-cmux-runner-gate: the gate exited $code; running the runner without it\"\n"
        "exec ./run.sh\n"
    )
    # Explicit dirs, so a restore step that changes HOME or FLEET_DIR still finds this runner's roots record.
    roots_n = int((ctx.member or {}).get("canonicalRoots") or 1)
    capacity = shlex.quote(os.fspath(capacity_dir))
    state = shlex.quote(os.fspath(home / ".local/state/glaeda/cmux-runner"))
    dirs = f" --capacity-dir {capacity} --state-dir {state}"
    root = (
        "#!/bin/sh\n"
        "# glaeda-canonical-root take ROOT [--wait SECONDS] [--switch] (generated, receipt-owned): hold canonical\n"
        "# root ROOT (/private/tmp/cmux-ci[-N]) for the rest of this job; take-gui [--wait SECONDS] holds the\n"
        "# mini's gui token (exit 3: gave way to a gui job waiting for this job's root). The job-started hook links\n"
        "# it into the fleet bin.\n"
        "usage() { echo 'usage: glaeda-canonical-root take ROOT [--wait SECONDS] [--switch]"
        " | take-gui [--wait SECONDS]' >&2; exit 2; }\n"
        "case \"${1:-}\" in\n"
        "take) [ -n \"${2:-}\" ] || usage; root=$2; shift 2\n"
        f"    exec {python} {hook} take-root --root \"$root\" --canonical-roots {roots_n}{dirs} --gui-token {shlex.quote(gui_token)} \"$@\" ;;\n"
        f"take-gui) shift; exec {python} {hook} take-gui{dirs} --gui-token {shlex.quote(gui_token)}{recycle} \"$@\" ;;\n"
        "*) usage ;;\n"
        "esac\n"
    )
    wrappers = {"job-started.sh": started.encode(), "job-completed.sh": completed.encode(),
                "listen.sh": listen.encode(), "glaeda-canonical-root": root.encode()}
    if dedicated:
        wrappers[DEDICATED_ADMIT] = (
            "#!/bin/bash\n"
            "# glaeda-cmux-runner dedicated runner admission (generated from the manifest's runner.dedicated admit,\n"
            "# receipt-owned). The job-started hook runs it after glaeda's own checks; a non-zero exit refuses the job.\n"
            f"exec {' '.join(shlex.quote(dedicated_word(ctx, w)) for w in dedicated['admit'])}\n").encode()
    return wrappers


def agent_plist(ctx: Context) -> dict[str, Any]:
    # Exactly cmux's workload PATH (cmux_fleet_bootstrap CMUX_WORKLOAD_TOOL_PATH): a tool under the
    # user's home, such as an old ~/.local/bin/zig, must never shadow the one the class accepted.
    path = WORKLOAD_PATH
    if ctx.headless:
        # A system daemon survives a reboot without a GUI login. The helper waits for a
        # listener left by an in-flight apply, then hands the registration to listen.sh.
        program = [os.fspath(SYSTEM_HELPER), os.fspath(ctx.runner_dir)]
    else:
        program = [os.fspath(ctx.hook_dir / "listen.sh")]
    plist = {
        "Label": ctx.label,
        # run.sh under the hook's listener gate (listen.sh): an idle runner stops listening while a fleet
        # build holds or waits for the host, so GitHub routes its jobs elsewhere instead of here to be refused.
        "ProgramArguments": program,
        "WorkingDirectory": os.fspath(ctx.runner_dir),
        "RunAtLoad": True,
        # A GitHub session cancellation is a clean Runner.Listener exit (status 0), but the
        # runner must still reconnect.  Keep the LaunchAgent alive for both clean and failed
        # exits; launchd's throttle prevents a broken install from spinning.
        "KeepAlive": True,
        "ThrottleInterval": 10,
        "ProcessType": "Interactive",
        "EnvironmentVariables": {
            "ACTIONS_RUNNER_HOOK_JOB_STARTED": os.fspath(ctx.hook_dir / "job-started.sh"),
            "ACTIONS_RUNNER_HOOK_JOB_COMPLETED": os.fspath(ctx.hook_dir / "job-completed.sh"),
            "PATH": path,
        },
        "StandardOutPath": os.fspath(ctx.log_path),
        "StandardErrorPath": os.fspath(ctx.logs / f"glaeda-cmux-runner{ctx.suffix}.err"),
    }
    if not console_session_runner(ctx):
        plist["SessionCreate"] = True
    if ctx.headless:
        plist["UserName"] = pwd.getpwuid(ctx.uid).pw_name
    return plist


def console_session_runner(ctx: Context) -> bool:
    """The gui and session runners run in the console user's security session, every other runner in one of its own
    (SessionCreate). Their jobs launch and drive apps there (XCUITest, captures), and on macOS 27 LaunchServices can stop
    mapping a SessionCreate session to the console's: `lsappinfo front` reads [ NULL ] from it and xcodebuild dies
    launching the test runner with "IDELaunchServicesLauncher.m:418 Assertion failed: childPID > 0" (cmuxs-mac-mini-3
    and cmux8s, 2026-10-30; a fresh SessionCreate agent there could not see Finder, one without it could). It isolates
    nothing from such a job: any job can bootstrap a LaunchAgent into gui/<uid> and run in the console session anyway."""
    return not ctx.headless and bool(getattr(ctx, "gui_runner", False) or getattr(ctx, "session_runner", False))


def hook_sources() -> dict[str, tuple[bytes, int]]:
    """The files every install copies unchanged from this copy into glaeda-hooks/, with their modes: what
    --apply writes there beside the generated wrappers, and all that --refresh-hooks writes."""
    return {HOOK_NAME: (HOOK_SOURCE.read_bytes(), 0o755),
            RESERVATION_NAME: (RESERVATION_SOURCE.read_bytes(), 0o644)}


def desired_files(ctx: Context) -> dict[Path, tuple[bytes, int]]:
    files = {ctx.hook_dir / name: source for name, source in hook_sources().items()}
    for name, data in hook_wrappers(ctx).items():
        files[ctx.hook_dir / name] = (data, 0o755)
    files[ctx.service_plist_path] = (plistlib.dumps(agent_plist(ctx), sort_keys=True), 0o644)
    watch = watch_plist_path(ctx)
    if watch is not None:
        files[watch] = (plistlib.dumps(watch_plist(ctx), sort_keys=True), 0o644)
    relay = relay_plist_path(ctx)
    if relay is not None:
        files[relay] = (plistlib.dumps(relay_plist(ctx), sort_keys=True), 0o644)
    return files


def owns_runner_dir(runner_dir: Path, receipt: dict[str, Any] | None) -> bool:
    """The runner directory is ours only if the receipt says so and the marker still matches."""
    if not receipt or not receipt.get("runnerDirOwned") or receipt.get("runnerDir") != os.fspath(runner_dir):
        return False
    try:
        return (runner_dir / MARKER).read_text().strip() == receipt.get("installId")
    except OSError:
        return False


def owned_dir(ctx: Context, receipt: dict[str, Any] | None) -> bool:
    return owns_runner_dir(ctx.runner_dir, receipt)


def launchctl_loaded(ctx: Context) -> bool | None:
    if ctx.skip_launchctl:
        return None
    domain = f"system/{ctx.label}" if ctx.headless else f"gui/{ctx.uid}/{ctx.label}"
    return run([LAUNCHCTL, "print", domain])[0] == 0


def held_marker(ctx: Context) -> Path:
    """cmux_mini_fix.sh runner_hold's mark: this runner was stopped on purpose, and runner_release starts it."""
    return ctx.home / HELD_DIR / ctx.runner_dir.name


def launchctl_disabled(ctx: Context) -> bool | None:
    """launchd's disabled override for this label (bootstrap refuses a disabled service with error 5)."""
    if ctx.skip_launchctl:
        return None
    domain = "system" if ctx.headless else f"gui/{ctx.uid}"
    code, out = run([LAUNCHCTL, "print-disabled", domain])
    if code != 0:
        return None
    found = re.search(r'"' + re.escape(ctx.label) + r'"\s*=>\s*(\w+)', out)
    return bool(found) and found.group(1) in {"disabled", "true"}


def start_agent(ctx: Context, act: dict[str, Any], plist: str) -> str | None:
    """Enable the label if launchd has it disabled, then bootstrap it. The reason on failure, else None.

    Callers never start a runner that runner_hold marked held, so a disabled label here is one nothing
    means to keep stopped (a hand `launchctl disable`, or a hold whose mark is gone)."""
    ctx.log_offset = ctx.log_path.stat().st_size if ctx.log_path.is_file() else 0
    domain = f"system/{ctx.label}" if ctx.headless else f"gui/{ctx.uid}/{ctx.label}"
    launcher = [SUDO, LAUNCHCTL] if ctx.headless else [LAUNCHCTL]
    if launchctl_disabled(ctx):
        code, out = run([*launcher, "enable", domain])
        act["wasDisabled"], act["enabled"] = True, code == 0
        ctx.enabled_label = code == 0  # the agent step records it too when a relabel started the runner
        if code != 0:
            act["bootstrapped"] = False
            return "launchctl enable failed: " + out
    code, out = run([*launcher, "bootstrap", "system" if ctx.headless else f"gui/{ctx.uid}", plist])
    act["bootstrapped"] = code == 0
    return None if code == 0 else "launchctl bootstrap failed: " + out


def routing(ctx: Context) -> dict[str, Any]:
    if dedicated_of(ctx):
        return {"route": [], "rollback": [],
                "note": "dedicated runner: only jobs that name its labels come here, as they did before glaeda "
                        "managed it; nothing is set per runner"}
    repo = shlex.quote(ctx.route_repo)
    member = ctx.member
    if not member:
        return {
            "route": [f"gh variable set {v} --body {MINI_LABEL} --repo {repo}" for v in ROUTE_VARIABLES],
            "rollback": [f"gh variable delete {v} --repo {repo}" for v in ROUTE_VARIABLES],
        }
    if not member.get("trustedRef"):
        # MACOS_RUNNER_* would send every PR job to the generic glaeda-mini label, past cmux's picker.
        return {"route": [], "rollback": [],
                "note": "fleet member: cmux's PR pool picker routes to its pool labels (CI_PR_POOL_OWNED, "
                        "CI_OWNED_POOL_SLOTS); nothing is set per runner. Never set MACOS_RUNNER_* to glaeda-mini: "
                        "that bypasses the picker"}
    runner = next((label for label in ctx.labels if label.startswith(RUNNER_LABEL_PREFIX)), None)
    pool = next(iter(member.get("pools") or []), None)
    note = ("trusted member: only cmux's nightly app build and seed run here, while CI_PR_POOL_OWNED is 1 and "
            "both variables below name it; PR jobs never do. Never set MACOS_RUNNER_* to glaeda-mini")
    if not (runner and pool):
        return {"route": [], "rollback": [], "note": note + " (this instance carries no runner label)"}
    return {"route": [f"gh variable set CI_SEED_TRUSTED_POOL --body {shlex.quote(pool)} --repo {repo}",
                      f"gh variable set CI_NIGHTLY_TRUSTED_RUNNER --body {shlex.quote(runner)} --repo {repo}"],
            "rollback": [f"gh variable delete CI_NIGHTLY_TRUSTED_RUNNER --repo {repo}"],
            "note": note}


# ---------------------------------------------------------------- stale copies and label drift


def day(text: object) -> str | None:
    found = re.match(DAY_RE, str(text or ""))
    return found.group(0) if found else None


def script_source(script_dir: Path) -> dict[str, Any] | None:
    """Where this copy of the runner scripts came from: {date, source, tag, via}, or None when unknown.
    Its stamp (written by whoever staged it), else the OTA release it sits in, else its git checkout."""
    try:
        stamp = json.loads((script_dir / SOURCE_STAMP).read_text())
    except (OSError, ValueError):
        stamp = None
    if isinstance(stamp, dict) and day(stamp.get("date")):
        return {"date": day(stamp["date"]), "source": str(stamp.get("source") or "")[:40],
                "tag": str(stamp.get("tag") or "") or None, "via": f"stamp by {str(stamp.get('by') or '?')[:40]}"}
    try:
        release = json.loads((script_dir.parent.parent / "release.json").read_text())
        found = re.fullmatch(RELEASE_TAG_RE, str(release.get("tag")))
    except (OSError, ValueError, AttributeError):
        found = None
    if found:
        return {"date": "-".join(found.groups()), "source": str(release.get("source") or "")[:40],
                "tag": found.group(0), "via": "release"}
    if (script_dir.parent / ".git").exists():
        code, out = run(["env", "TZ=UTC", "git", "-C", os.fspath(script_dir.parent), "log", "-1",
                          "--format=%H %cd", "--date=format-local:%Y-%m-%d"])  # UTC, like release tags
        parts = out.split() if code == 0 else []
        if len(parts) == 2 and re.fullmatch(r"[0-9a-f]{40}", parts[0]) and day(parts[1]):
            return {"date": parts[1], "source": parts[0], "tag": None, "via": "git"}
    return None


def installed_release(home: Path) -> dict[str, Any] | None:
    """The release glaeda-update installed here, with its copy of the runner scripts, or None."""
    root = home / UPDATE_STATE
    try:
        tag = str(json.loads((root / "state.json").read_text()).get("current") or "")
    except (OSError, ValueError, AttributeError):
        return None
    found = re.fullmatch(RELEASE_TAG_RE, tag)
    scripts = root / "generations" / tag / "glaeda/scripts"
    if not found or not (scripts / "glaeda-cmux-runner").is_file():
        return None
    return {"tag": tag, "date": "-".join(found.groups()), "scripts": scripts}


def copy_check(ctx: Context) -> dict[str, Any] | None:
    """How this copy compares with the installed release: None when there is none, or it is this copy."""
    if os.environ.get(NO_RELEASE_CHECK):
        return None
    release = installed_release(ctx.home)
    if release is None or os.path.realpath(release["scripts"]) == os.path.realpath(SCRIPT_DIR):
        return None
    if all(sha256_file(SCRIPT_DIR / name) == sha256_file(release["scripts"] / name) for name in RUNNER_FILES):
        return None
    own = script_source(SCRIPT_DIR)
    stale = own is None or own["date"] < release["date"] or bool(own.get("tag") and own["tag"] != release["tag"])
    return {"state": "stale" if stale else "differs", "release": release["tag"], "copy": own,
            "releaseScript": ctx.show(release["scripts"] / "glaeda-cmux-runner"),
            "releaseScriptPath": os.fspath(release["scripts"] / "glaeda-cmux-runner")}


def release_plan_labels(script: str, argv: list[str]) -> list[str] | None:
    """The labels the release's copy would register for these same arguments: its read-only plan."""
    plan: list[str] = []
    skip = False
    for arg in argv:
        if skip:
            skip = False
        elif arg == "--output":
            skip = True
        elif arg not in ("--apply", "--allow-stale") and not arg.startswith("--output="):
            plan.append(arg)
    python = sys.executable or "/usr/bin/python3"
    code, out = run([python, script, *plan, "--output", "json"], timeout=180,
                    env={**os.environ, NO_RELEASE_CHECK: "1"})
    try:
        doc = json.loads(out[out.find("{"):])
        reg = next(a for a in doc.get("actions", []) if a.get("kind") == "register")
    except (ValueError, StopIteration, AttributeError):
        return None
    labels = reg.get("labels")
    return labels if isinstance(labels, list) else None


def label_drift(against: str, registered: list[str], wanted: list[str]) -> dict[str, Any] | None:
    """How `wanted` (this version's labels) differs from `registered`; None when they match."""
    added = sorted(set(wanted) - set(registered))
    removed = sorted(set(registered) - set(wanted))
    if not (added or removed):
        return None
    return {"against": against, "added": added, "removed": removed}


def drift_text(drift: dict[str, Any]) -> str:
    return " ".join([*(f"+{label}" for label in drift["added"]), *(f"-{label}" for label in drift["removed"])])


# ---------------------------------------------------------------- plan


def receipt_conflict(ctx: Context, receipt: dict[str, Any] | None) -> str | None:
    """A live receipt for another directory, name or scope: this run must not touch or replace it."""
    if not receipt:
        return None
    reg = receipt.get("registration") or {}
    theirs = (receipt.get("runnerDir"), reg.get("name"), reg.get("scope"))
    if not receipt.get("runnerDirOwned") and not reg:
        return None
    mine = (os.fspath(ctx.runner_dir), ctx.name if reg else None, (ctx.org or ctx.repo) if reg else None)
    if theirs == mine:
        return None
    return (f"this Mac already has a runner install ({theirs[1] or 'unregistered'} on {theirs[2] or '?'} in "
            f"{ctx.show(theirs[0] or '?')}); run --uninstall --apply first")


def plan_install(ctx: Context, receipt: dict[str, Any] | None) -> list[dict[str, Any]]:
    conflict = receipt_conflict(ctx, receipt)
    if conflict:
        return [{"kind": "receipt", "path": os.fspath(ctx.receipt_path), "state": "blocked", "note": conflict}]
    actions: list[dict[str, Any]] = []
    ours = owned_dir(ctx, receipt)
    configured = (ctx.runner_dir / ".runner").is_file()
    exists = ctx.runner_dir.exists()

    if ours:
        actions.append({"kind": "dir", "path": os.fspath(ctx.runner_dir), "state": "unchanged", "owned": True})
    elif exists:
        actions.append({"kind": "dir", "path": os.fspath(ctx.runner_dir), "state": "blocked", "owned": False,
                        "note": "exists and is not owned by this command; pick --runner-dir or remove it"})
    else:
        actions.append({"kind": "dir", "path": os.fspath(ctx.runner_dir), "state": "create", "owned": False})
    blocked_dir = actions[-1]["state"] == "blocked"

    if ours and (ctx.runner_dir / "config.sh").is_file():
        actions.append({"kind": "download", "state": "unchanged",
                        "version": (receipt or {}).get("runnerVersion"), "note": "installed; the runner self-updates"})
    else:
        rel = resolve_release(ctx)
        act = {"kind": "download", **rel}
        act["state"] = "create" if rel["state"] == "ok" else "blocked"
        if blocked_dir:
            act["state"] = "blocked"
        actions.append(act)

    reg = {"kind": "register", "scope": ctx.org or ctx.repo, "name": ctx.name, "labels": ctx.labels,
           "ephemeral": False}
    registered = ((receipt or {}).get("registration") or {}) if ours else {}
    had = registered.get("labels")
    github_listed = github_found = None
    if ours and configured and ctx.gh is not None:
        # A local receipt records what this copy last requested, not what GitHub currently
        # holds.  Read the registration once and use that observation for reconciliation.
        github_listed, github_found = lookup_runner(ctx)
    if ours and configured and not github_listed and isinstance(getattr(ctx, "github_labels", None), str):
        # the minis hold no gh login (or one that cannot list runners): the fleet read GitHub's labels with its own
        # and passed them. Without them, every apply re-registered each idle runner in place (the token path
        # below) whatever its labels were.
        github_listed, github_found = True, {"labels": sorted({label.strip() for label in ctx.github_labels.split(",")
                                                              if label.strip()})}
    # This install registered that name before and lost its local .runner (an interrupted relabel):
    # registering again replaces its own server-side entry instead of colliding with it.
    own_name = bool(ours and not configured and registered.get("owned") and registered.get("name") == ctx.name)
    if ours and configured and ctx.labels_requested:
        if github_listed and github_found is not None:
            actual = github_found.get("labels") or []
            if sorted(actual) != sorted(ctx.labels):
                # GitHub fixes labels at registration, and the labels API needs an admin token the mini does
                # not hold, so relabelling re-registers this same runner in place with --replace.
                reg.update(state="relabel", previousLabels=actual)
                if runner_busy(ctx):
                    reg.update(state="blocked", busy=True, note="the runner is running a job; re-run when it is idle")
            else:
                reg.update(state="unchanged")
        elif github_listed and github_found is None:
            reg.update(state="blocked", note=f"GitHub does not list runner {ctx.name}; refusing to replace an unknown registration")
        elif ctx.apply and ctx.token_stdin:
            # An operator supplied a fresh registration token for apply.  If the read-only
            # lookup is unavailable, let the same-name --replace repair proceed, but never
            # claim the receipt proves the current server-side labels.
            reg.update(state="relabel", previousLabels=had or [],
                       note="GitHub labels could not be read; re-registering with the supplied token")
            if runner_busy(ctx):
                reg.update(state="blocked", busy=True, note="the runner is running a job; re-run when it is idle")
        else:
            reg.update(state="blocked", note="could not read GitHub labels; receipt labels are not authoritative; "
                       "re-run with GitHub access or --apply --token-stdin")
    elif ours and configured:
        reg.update(state="unchanged")
    elif ctx.gh is None and not ctx.token_stdin:
        reg.update(state="blocked", note="needs gh logged in as an admin, or a token through --token-stdin")
    elif blocked_dir:
        reg.update(state="blocked", note="runner directory is not ours")
    elif ctx.gh is None:
        reg.update(state="create", note="no gh here: config.sh refuses a name that is already registered")
    else:
        existing = find_runner(ctx)
        if existing and own_name and not ctx.replace and registered.get("runnerId") not in (None, existing.get("id")):
            reg.update(state="blocked", existing=existing,
                       note=f"{ctx.name} is now registered as id {existing.get('id')}, not this install's "
                            f"{registered.get('runnerId')}; another machine may hold the name. If it was "
                            "this install's own interrupted --replace, pass --replace")
        elif existing and not (ctx.replace or own_name):
            reg.update(state="blocked", existing=existing,
                       note=f"a runner named {ctx.name} is already registered; pass --name or --replace")
        else:
            reg.update(state="create", existing=existing)
    if own_name and reg["state"] == "create":
        reg.update(replace=True, note="re-registers this install's own name with --replace")
    drifts = []
    if ours and configured and had is not None:
        drifts.append(label_drift("receipt", had, ctx.labels))
        if github_listed and github_found is not None:  # what GitHub holds, which a hand edit or a lost receipt can make differ
            drifts.append(label_drift("github", github_found.get("labels") or [], ctx.labels))
    if any(drifts):
        reg["drift"] = [d for d in drifts if d]
        if reg["state"] == "unchanged":
            reg["note"] = ("registered labels differ from what this version would register; pass --manifest and "
                           "--member (or --labels) to re-register")
    actions.append(reg)

    prior = {a.get("path"): a.get("ownedSha256") for a in (receipt or {}).get("actions", [])
             if a.get("kind") in {"hook", "agent", *COMPANIONS} and a.get("owned")}
    companions = companion_paths(ctx)
    for path, (data, mode) in desired_files(ctx).items():
        kind = "agent" if path == ctx.service_plist_path else companions[path][0] if path in companions else "hook"
        current, want = sha256_file(path), sha256_bytes(data)
        if current is None:
            state = "create"
        elif current == want and (path.stat().st_mode & 0o777) == mode:
            state = "unchanged"
        elif prior.get(os.fspath(path)) == current or (kind == "hook" and ours):
            state = "update"
        else:
            state = "blocked"
        if kind == "hook" and blocked_dir:
            state = "blocked"
        owned = prior.get(os.fspath(path)) is not None and prior.get(os.fspath(path)) == current
        act = {"kind": kind, "path": os.fspath(path), "state": state, "sha256": want, "previousSha256": current,
               "mode": oct(mode), "owned": owned, "ownedSha256": current if owned else None}
        if state == "blocked" and not blocked_dir:
            act["note"] = "exists and was not written by this command"
        if kind in COMPANIONS:
            act["label"] = companions[path][1]
            if kind == "relay":
                act["socket"] = os.fspath(relay_socket(ctx))
            act["loaded"] = None if ctx.skip_launchctl else run(
                [LAUNCHCTL, "print", f"gui/{ctx.uid}/{act['label']}"])[0] == 0
        if kind == "agent":
            act["label"] = ctx.label
            act["loaded"] = launchctl_loaded(ctx)
            act["launchctl"] = "skipped (sandbox HOME)" if ctx.sandbox else ("skipped" if ctx.skip_launchctl else "managed")
            act["held"] = held_marker(ctx).is_file()
            act["disabled"] = launchctl_disabled(ctx)
            if act["disabled"] and not act["held"] and not act.get("note"):
                act["note"] = "launchd has this label disabled with no hold mark; --apply enables it before bootstrap"
        actions.append(act)
    declared = {kind for kind, _ in companions.values()}
    if dedicated_of(ctx) is not None:
        # the manifest dropped its watch loop or its relay: stop and remove the agent this install wrote, if unchanged
        for old in [a for a in (receipt or {}).get("actions", [])
                    if a.get("kind") in COMPANIONS and a.get("kind") not in declared and a.get("owned")]:
            current = sha256_file(Path(str(old.get("path"))))
            loaded = not ctx.skip_launchctl and run([LAUNCHCTL, "print", f"gui/{ctx.uid}/{old.get('label')}"])[0] == 0
            if current is not None or loaded:
                # a plist removed by hand while launchd still runs the job: ours by the receipt, booted out all the same
                ours = current is None or current == old.get("ownedSha256")
                # owned until the removal is applied, so a skipped removal (an earlier step failed) is planned again
                actions.append({"kind": old["kind"], "label": old.get("label"), "path": old.get("path"),
                                "state": "remove" if ours else "kept", "owned": ours, "loaded": loaded,
                                "socket": old.get("socket"),
                                "ownedSha256": current if ours else None,
                                "note": "" if ours else "changed since this command wrote it"})
    actions.append({"kind": "verify", "state": "pending", "note": f"GET {ctx.scope_api}/actions/runners, name {ctx.name}"})
    return actions


def plan_uninstall(ctx: Context, receipt: dict[str, Any] | None) -> list[dict[str, Any]]:
    actions: list[dict[str, Any]] = []
    if receipt is None:
        return [{"kind": "note", "state": "kept",
                 "note": f"no install receipt at {ctx.show(ctx.receipt_path)}; nothing is removed"}]
    owned = {a.get("path"): a.get("ownedSha256") for a in receipt.get("actions", [])
             if a.get("kind") in {"hook", "agent"} and a.get("owned")}
    plist = os.fspath(ctx.service_plist_path)
    current = sha256_file(ctx.service_plist_path)
    if current is None:
        state, note = "absent", ""
    elif owned.get(plist) == current:
        state, note = "remove", ""
    else:
        state, note = "kept", "not installed by this command, or changed since"
    actions.append({"kind": "agent", "label": ctx.label, "path": plist, "state": state, "note": note,
                    "loaded": launchctl_loaded(ctx)})
    for watch in [a for a in receipt.get("actions", []) if a.get("kind") in COMPANIONS and a.get("owned")]:
        current = sha256_file(Path(str(watch.get("path"))))
        loaded = not ctx.skip_launchctl and run([LAUNCHCTL, "print", f"gui/{ctx.uid}/{watch.get('label')}"])[0] == 0
        state = ("remove" if loaded else "absent") if current is None else \
            "remove" if current == watch.get("ownedSha256") else "kept"
        actions.append({"kind": watch["kind"], "label": watch.get("label"), "path": watch.get("path"), "state": state,
                        "socket": watch.get("socket"),
                        "note": "changed since this command wrote it" if state == "kept" else ""})

    ours = owned_dir(ctx, receipt)
    registered = receipt.get("registration") or {}
    local = local_runner(ctx) if ours else None
    if registered.get("owned") and ours:
        actions.append({"kind": "deregister", "state": "remove", "scope": registered.get("scope"),
                        "name": registered.get("name"), "runnerId": registered.get("runnerId")})
    elif local and getattr(ctx, "unreadable_registration", False):
        return [{"kind": "deregister", "state": "blocked", "path": os.fspath(ctx.runner_dir / ".runner"),
                 "note": "a .runner here has no github.com URL or name to deregister by; remove it by hand"}]
    elif local:
        # config.sh finished after this command gave up on it: the directory is ours, so is its .runner
        actions.append({"kind": "deregister", "state": "remove", "name": local.get("agentName"),
                        "runnerId": local.get("agentId"), "note": "registered by an interrupted --apply"})
    elif registered.get("owned"):
        # the receipt records a registration this command made, but its runner directory is gone (or not ours): the
        # GitHub registration may still exist and nothing here can deregister it, so a retirement must not read this as
        # "never registered" (glaeda-cmux-runner-fleet registered_scope; review of 611e013e)
        actions.append({"kind": "deregister", "state": "kept", "registered": True, "scope": registered.get("scope"),
                        "note": "the receipt records a registration, but its runner directory is gone or not ours"})
    else:
        actions.append({"kind": "deregister", "state": "kept",
                        "note": "no registration owned by this command in this runner directory"})
    if ours:
        actions.append({"kind": "dir", "path": os.fspath(ctx.runner_dir), "state": "remove",
                        "note": "runner, hooks and _work (hot state) go with it"})
    else:
        actions.append({"kind": "dir", "path": os.fspath(ctx.runner_dir),
                        "state": "absent" if not ctx.runner_dir.exists() else "kept",
                        "note": "" if not ctx.runner_dir.exists() else "not owned by this command (receipt or marker mismatch)"})
    return actions


# ---------------------------------------------------------------- apply


def prune_runner_cache(ctx: Context, keep: str) -> None:
    """Keep the RUNNER_CACHE_KEEP newest versions (always keep). Removes only the files this cache writes, so a
    folder holding anything else stays."""
    stale = [v for v in cached_versions(ctx) if v != keep]
    for version in stale[max(0, RUNNER_CACHE_KEEP - 1):]:
        folder = ctx.runner_cache / version
        for name in (RUNNER_CACHE_MARKER, runner_asset(version)):
            with contextlib.suppress(OSError):
                (folder / name).unlink()
        with contextlib.suppress(OSError):
            folder.rmdir()


def cache_tarball(ctx: Context, act: dict[str, Any]) -> tuple[Path | None, str]:
    """(the verified tarball in this mini's runner cache, how it got there) or (None, why). A hit downloads
    nothing; a miss downloads once, verifies, and publishes the tarball before its marker."""
    hit = cached_release(ctx, act["version"])
    if hit and hit["sha256"] == act["sha256"]:
        return Path(hit["cached"]), "cache"
    folder = ctx.runner_cache / act["version"]
    try:
        folder.mkdir(parents=True, exist_ok=True, mode=0o755)
    except OSError as error:
        return None, f"runner cache: {type(error).__name__}"
    if folder.is_symlink() or folder.stat().st_uid != ctx.uid:
        return None, f"runner cache folder {ctx.show(folder)} is not this user's directory"
    stage = folder / f".{act['asset']}.{os.getpid()}.part"
    stage.unlink(missing_ok=True)
    code, out = run([CURL, "-fsSL", "--retry", "3", "-o", os.fspath(stage), act["url"]], timeout=900)
    if code != 0:
        stage.unlink(missing_ok=True)
        return None, f"download failed: {out[-300:]}"
    got = stream_sha256(stage)
    if got != "sha256:" + act["sha256"]:
        stage.unlink(missing_ok=True)
        return None, f"SHA-256 mismatch: got {got}, want sha256:{act['sha256']}"
    tarball = folder / act["asset"]
    with contextlib.suppress(OSError):  # a stale marker never vouches for the new bytes, even for a moment
        (folder / RUNNER_CACHE_MARKER).unlink()
    os.replace(stage, tarball)
    marker = {"schema": RUNNER_CACHE_SCHEMA, "version": act["version"], "asset": act["asset"],
              "sha256": act["sha256"], "shaSources": act.get("shaSources") or [], "url": act["url"],
              "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")}
    write_atomic(folder / RUNNER_CACHE_MARKER, (json.dumps(marker, indent=2, sort_keys=True) + "\n").encode(), 0o644)
    prune_runner_cache(ctx, act["version"])
    return tarball, "downloaded"


def download_and_unpack(ctx: Context, act: dict[str, Any], install_id: str) -> None:
    ctx.state.mkdir(parents=True, exist_ok=True, mode=0o700)
    tarball, how = cache_tarball(ctx, act)
    if tarball is None:
        act["state"], act["note"] = "failed", how
        return
    act["tarball"] = how
    ctx.runner_dir.mkdir(parents=True, exist_ok=True, mode=0o755)  # a rerun after a failed unpack
    # The marker lands first, so a failed unpack still leaves a directory this command owns.
    (ctx.runner_dir / MARKER).write_text(install_id + "\n")
    tar = which("tar", ("/usr/bin/tar",)) or "tar"
    code, out = run([tar, "-xzf", os.fspath(tarball), "-C", os.fspath(ctx.runner_dir)], timeout=600)
    if code != 0 or not (ctx.runner_dir / "config.sh").is_file():
        act["state"], act["note"] = "failed", f"unpack failed: {out[-300:]}"
        return
    act["applied"] = True


def runner_path(home: Path, *paths: str) -> str:
    """The PATH a runner's .path keeps: Homebrew first (the workload PATH's order), every entry the given PATHs
    already had in their order, then the runner user's ~/.cargo/bin and the system directories, each once."""
    entries = ["/opt/homebrew/bin", "/usr/local/bin"]
    for path in paths:
        entries += path.split(":")
    entries += [os.fspath(home / ".cargo/bin"), *WORKLOAD_PATH.split(":")]
    return ":".join(dict.fromkeys(e for e in entries if e))


def read_runner_path(runner_dir: Path) -> str:
    """The runner's .path, "" when it is missing or unreadable. Bytes that are not UTF-8 round-trip unchanged
    (surrogateescape) instead of raising mid-registration."""
    try:
        return (runner_dir / ".path").read_bytes().decode("utf-8", "surrogateescape").strip()
    except OSError:
        return ""


def keep_runner_path(ctx: Context, before: str) -> None:
    """config.sh's env.sh overwrites .path with the PATH it ran under, and runsvc.sh runs the runner with it. A
    registration over ssh runs under a bare /usr/bin:/bin:/usr/sbin:/sbin and so dropped /opt/homebrew/bin
    (2026-10-26). Merge the .path that was there before with the new one and make sure Homebrew and ~/.cargo/bin
    are on it."""
    after = read_runner_path(ctx.runner_dir)
    merged = runner_path(ctx.home, before, after)
    if merged != after:
        write_atomic(ctx.runner_dir / ".path", (merged + "\n").encode("utf-8", "surrogateescape"), 0o644,
                     make_parent=False)


def register(ctx: Context, act: dict[str, Any]) -> None:
    token = ctx.take_token(f"{ctx.scope_api}/actions/runners/registration-token")
    if token is None:
        act["state"], act["note"] = "failed", "could not obtain a registration token (needs repo or org admin)"
        return
    path_before = read_runner_path(ctx.runner_dir)
    argv = [os.fspath(ctx.runner_dir / "config.sh"), "--unattended", "--url", ctx.scope_url,
            "--name", ctx.name, "--labels", ",".join(l for l in ctx.labels if l not in BASE_LABELS),
            "--work", "_work"]
    if ctx.org and ctx.group:
        argv += ["--runnergroup", ctx.group]
    if dedicated_of(ctx):  # exactly the declared labels: no self-hosted, macOS or ARM64
        argv.append("--no-default-labels")
    if ctx.replace or act.get("replace"):
        argv.append("--replace")
    code, out = run_with_token(argv, token, ctx.runner_dir)
    del token
    act["argv"] = argv
    # env.sh rewrites .path before config.sh can fail (a bad token, a timeout), so this runs either way
    try:
        keep_runner_path(ctx, path_before)
    except OSError as error:  # the registration's outcome stands; a later --apply or relabel fixes .path
        act["pathNote"] = f"could not rewrite .path ({type(error).__name__}: {error})"[:300]
    if code != 0 or not (ctx.runner_dir / ".runner").is_file():
        act["state"], act["note"] = "failed", f"config.sh failed: {out[-400:]}"
        return
    act["applied"] = True
    act["runnerId"] = (local_runner(ctx) or {}).get("agentId")


# Newer runners also keep a migrated identity (.runner_migrated, .credentials_migrated) and try it
# first; left behind, it would point the Listener at the agent id --replace just deleted.
LOCAL_REGISTRATION = (".runner", ".credentials", ".credentials_rsaparams", ".runner_migrated",
                      ".credentials_migrated")


@functools.lru_cache(maxsize=1)
def hook_module() -> Any:
    """The hook beside this copy, for the one reading of "this runner has a job" the gate uses too."""
    loader = importlib.machinery.SourceFileLoader("glaeda_cmux_runner_hook", os.fspath(HOOK_SOURCE))
    spec = importlib.util.spec_from_loader("glaeda_cmux_runner_hook", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def worker_running(runner_dir: Path) -> bool:
    """This install has a job right now: the hook's runner_busy_now, the gate's own test (a Runner.Worker under bin
    or a self-update's bin.<version>, or a request its live listener took). A pgrep for bin/Runner.Worker missed a
    self-updated runner's job, so --apply re-registered runners mid-compile (2026-10-27 02:09:59Z, 02:21:55Z).
    A copy without its hook counts as busy, as does anything the hook cannot read."""
    try:
        return bool(hook_module().runner_busy_now(runner_dir))
    except Exception:  # noqa: BLE001
        return True


def runner_busy(ctx: Context) -> bool:
    return worker_running(ctx.runner_dir)


def supervisor_role(runner_dir: Path, command: str) -> str | None:
    """Which part of this runner's launchd job command is: "listener" (bin or bin.<version>/Runner.Listener), "spawner"
    (the gate, `listen --runner-dir DIR`, and run.sh or run-helper.sh, which start listeners), else None."""
    hook = hook_module()
    if hook.runner_worker(runner_dir, command, "Listener"):
        return "listener"
    root = re.escape(os.fspath(runner_dir))
    if re.search(r"(?:^|\s)listen\s+--runner-dir[ =]" + root + r"(?:\s|$)", command) or \
            re.search(r"(?:^|\s)(?:/bin/(?:ba)?sh\s+)?" + root + r"/(?:run|run-helper)\.sh(?:\s|$)", command):
        return "spawner"
    return None


FREEZE_LOOKS = 5


@contextlib.contextmanager
def listeners_frozen(runner_dir: Path) -> Iterator[int | None]:
    """This runner's listeners and what spawns them (the gate, run.sh, run-helper.sh) stopped (SIGSTOP) for a last
    look and a stop, as the gate's own stop freezes its listener: frozen, nothing of it can start a listener,
    acknowledge a request or start a Worker, so an idle reading stays true through the stop. It looks again until a
    look finds nothing new to freeze (a listener a spawner started between two looks is frozen too). Yields how
    many processes of that tree it froze (0: nothing of the runner runs), or None when it could not freeze them all or the tree kept changing: the caller then
    stops nothing. Thawed afterwards; a booted-out process is gone by then (launchd's SIGKILL reaches it frozen)."""
    frozen: list[int] = []
    count: int | None = None
    try:
        for _ in range(FREEZE_LOOKS):
            out = subprocess.run(["/bin/ps", "-axww", "-o", "pid=,command="], stdin=subprocess.DEVNULL,
                                 capture_output=True, text=True, timeout=RUN_TIMEOUT, check=True).stdout
            new = []
            for line in out.splitlines():
                pid, _, command = line.strip().partition(" ")
                role = supervisor_role(runner_dir, command.strip()) if pid.isdigit() else None
                if role and int(pid) not in frozen and int(pid) != os.getpid():
                    new.append((int(pid), role))
            if not new:
                count = len(frozen)  # everything of the runner's tree that runs: listeners and their spawners
                break
            for pid, role in new:
                try:
                    os.kill(pid, signal.SIGSTOP)
                except ProcessLookupError:
                    continue  # it exited: nothing left of it to take a job
                frozen.append(pid)
    except Exception:  # noqa: BLE001
        count = None
    try:
        yield count
    finally:
        for pid in reversed(frozen):
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGCONT)


# The hook's RUNNER_DRAIN marker (glaeda-cmux-runner-hook RUNNER_DRAIN_FILE, DRAIN_TTL_S): a re-registration or a
# retirement this apply cannot do under a job marks the runner draining, so its gate takes no new job once the job
# ends, and the next look (the fleet's retry, a minute later) finds it idle. The job is never cancelled.
RUNNER_DRAIN_FILE = ".glaeda-drain"
DRAIN_TTL_S = 3600.0
DRAINING = "draining: it takes no new job once this one ends"


def relabel_reason(ctx: Context) -> str:
    labels = getattr(ctx, "labels", None)
    return "a relabel to " + (",".join(map(str, labels)) if isinstance(labels, (list, tuple)) else "the manifest's labels")


def drain_marker_path(ctx: Context) -> Path:
    return ctx.runner_dir / RUNNER_DRAIN_FILE


def start_drain(ctx: Context, why: str, actions: list[dict[str, Any]] | None = None) -> bool:
    """Mark this runner draining for `why` (RUNNER_DRAIN). With `actions`, a non-dedicated runner's planned hook
    writes land first, so a gate running an older hook (which ignores the marker) reloads one that reads it: those
    are the same writes an apply makes under any running job. A dedicated runner's hooks wait for its stop
    (write_hooks in apply_install), so its drain needs a gate that already reads the marker. False when the marker
    could not be written."""
    if actions is not None and dedicated_of(ctx) is None:
        for act in [a for a in actions if a["kind"] == "hook" and a["state"] in {"create", "update"}]:
            try:
                data, mode = desired_files(ctx)[Path(act["path"])]
                write_atomic(Path(act["path"]), data, mode)
            except (OSError, KeyError):
                continue
            act["applied"] = act["owned"] = True
            act["ownedSha256"] = act["sha256"]
    doc = {"reason": why, "until": time.time() + DRAIN_TTL_S, "by": "glaeda-cmux-runner --apply", "name": str(ctx.name)}
    try:
        write_atomic(drain_marker_path(ctx), (json.dumps(doc, sort_keys=True) + "\n").encode(), 0o644)
    except (OSError, TypeError):  # never fails the apply: the runner only stays undrained, as before
        return False
    return True


def drain_marked(ctx: Context) -> bool:
    try:
        return drain_marker_path(ctx).is_file()
    except (OSError, TypeError):
        return False


def end_drain(ctx: Context) -> bool | None:
    """Remove this runner's drain marker: True when it removed one, False when there was none, None when one is
    there and could not be removed (its gate then stays held until the marker's expiry, which the note says)."""
    try:
        drain_marker_path(ctx).unlink()
    except FileNotFoundError:
        return False
    except (OSError, TypeError):
        return None
    return True


def note_drain_end(act: dict[str, Any], ended: bool | None) -> None:
    act["drainEnded"] = ended
    if ended is None:
        act["note"] = "; ".join(filter(None, [act.get("note"), "its drain marker could not be removed; the runner "
                                              f"stays held until it expires (at most {DRAIN_TTL_S / 60:g} min)"]))


def stop_if_idle(ctx: Context, stop: Callable[[], bool] | None = None, listener_ok: bool = True) -> bool:
    """Run stop (default: boot this runner's agent out) only when it has no job, deciding with its listeners and
    their spawners frozen. listener_ok=False also refuses while a listener of it lives (a re-registration under a
    listener nothing stops would orphan it). False: it has a job, this cannot tell, or the stop did not complete."""
    with listeners_frozen(ctx.runner_dir) as frozen:
        if frozen is None or (frozen and not listener_ok) or runner_busy(ctx):
            return False
        return bool((stop or (lambda: bootout(ctx)))())


def relabel(ctx: Context, act: dict[str, Any], stopped: Callable[[], None] | None = None) -> None:
    """Re-register this runner under the same name with the manifest's labels. _work stays. `stopped` runs once the
    runner is confirmed stopped and idle, before it registers and starts again."""
    def unregister() -> bool:  # with its listeners frozen and idle: none can take a job before the files go
        for name in LOCAL_REGISTRATION:
            (ctx.runner_dir / name).unlink(missing_ok=True)
        return True
    # only after a confirmed bootout: a listener that survived one would take jobs under a registration --replace drops
    stop = unregister if ctx.skip_launchctl else (lambda: bootout(ctx) and unregister())
    # --skip-launchctl stops nothing, so a listener still running there refuses: --replace would orphan it
    if not stop_if_idle(ctx, stop, listener_ok=not ctx.skip_launchctl):
        act["state"], act["note"] = "failed", "the runner started a job (or a listener runs); nothing changed, re-run when idle"
        if start_drain(ctx, relabel_reason(ctx)):
            act["note"] += f"; {DRAINING}"
            act["draining"] = True
        return
    note_drain_end(act, end_drain(ctx))  # stopped idle: the runner it starts again takes jobs under the new labels
    if not ctx.skip_launchctl:
        ctx.agent_started = False  # stopped now, whatever the plan saw; the agent step reads this
    if stopped is not None:
        stopped()
    act["replace"] = True
    register(ctx, act)
    if act["state"] != "failed" and dedicated_of(ctx):
        keep_runner_env(ctx)
    if act["state"] == "failed":
        act["note"] += ("; the old registration is still on GitHub and this runner is stopped: re-run with a "
                        "fresh token (it re-registers the same name with --replace)")
        return
    if not ctx.skip_launchctl and not held_marker(ctx).is_file():  # a held runner stays stopped
        why = start_agent(ctx, act, os.fspath(ctx.service_plist_path))
        ctx.agent_started = why is None  # the agent step must not bootstrap it a second time
        if why:
            act["state"], act["note"] = "failed", ("re-registered, but " + why)[:400]


LAUNCHCTL_NOT_FOUND = 113  # launchctl print: "Could not find service"; anything else is no proof it is gone


def bootout(ctx: Context, wait_s: float = 15.0) -> bool:
    """Unload this runner's agent; True once launchd says it no longer has it (print exits LAUNCHCTL_NOT_FOUND;
    launchd SIGKILLs a job 5 s after its SIGTERM, so wait_s covers that). False: still loaded, or a print that
    failed some other way (sudo refused, a timeout), and the caller must not act as if it stopped."""
    domain = f"system/{ctx.label}" if ctx.headless else f"gui/{ctx.uid}/{ctx.label}"
    run([SUDO, LAUNCHCTL, "bootout", domain] if ctx.headless else [LAUNCHCTL, "bootout", domain])
    deadline = time.monotonic() + wait_s
    while run(([SUDO, LAUNCHCTL, "print", domain] if ctx.headless
               else [LAUNCHCTL, "print", domain]))[0] != LAUNCHCTL_NOT_FOUND:
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)
    return True


def install_service_file(ctx: Context, path: Path, data: bytes, mode: int) -> None:
    """Install a system plist atomically through the host's explicit sudo boundary."""
    if not ctx.headless:
        write_atomic(path, data, mode)
        return
    with tempfile.NamedTemporaryFile(prefix="glaeda-runner-", suffix=".plist", delete=False) as tmp:
        tmp.write(data)
        tmp.flush()
        os.fchmod(tmp.fileno(), mode)
        staged = Path(tmp.name)
    try:
        code, out = run([SUDO, "/usr/bin/install", "-o", "root", "-g", "wheel", "-m", oct(mode)[2:],
                         os.fspath(staged), os.fspath(path)])
        if code != 0:
            raise OSError(out or f"sudo install exited {code}")
    finally:
        staged.unlink(missing_ok=True)


def ensure_headless_helper(ctx: Context) -> None:
    if not ctx.headless:
        return
    helper = b"#!/bin/sh\nset -eu\nrunner=\"$1\"\nwhile /usr/bin/pgrep -f \"$runner/bin/Runner.Listener\" >/dev/null 2>&1 || /usr/bin/pgrep -f \"$runner/glaeda-hooks/listen.sh\" >/dev/null 2>&1; do\n  /bin/sleep 15\ndone\nexec \"$runner/glaeda-hooks/listen.sh\"\n"
    with tempfile.NamedTemporaryFile(prefix="glaeda-supervise-", delete=False) as tmp:
        tmp.write(helper)
        tmp.flush()
        os.fchmod(tmp.fileno(), 0o755)
        staged = Path(tmp.name)
    try:
        code, out = run([SUDO, "/bin/mkdir", "-p", os.fspath(SYSTEM_HELPER.parent)])
        if code != 0:
            raise OSError(out or f"sudo mkdir exited {code}")
        code, out = run([SUDO, "/usr/bin/install", "-o", "root", "-g", "wheel", "-m", "755",
                         os.fspath(staged), os.fspath(SYSTEM_HELPER)])
        if code != 0:
            raise OSError(out or f"sudo install exited {code}")
    finally:
        staged.unlink(missing_ok=True)


def apply_install(ctx: Context, actions: list[dict[str, Any]], receipt_doc: dict[str, Any]) -> None:
    # A plan with any blocked step applies nothing, so a half-installed runner never exists. The one exception is
    # a relabel blocked only by a running job: the runner drains (start_drain, with its hook writes), so the next
    # look finds it idle instead of between two jobs it never sees.
    failed = any(a["state"] == "blocked" for a in actions)
    busy = [a for a in actions if a["kind"] == "register" and a["state"] == "blocked" and a.get("busy")]
    if busy and all(a["state"] != "blocked" or a in busy for a in actions):
        if start_drain(ctx, relabel_reason(ctx), actions):
            for act in busy:
                act["note"] = f"the runner is running a job; {DRAINING}, re-run when it is idle"
                act["draining"] = True
    elif any(a["kind"] == "register" and a["state"] == "unchanged" for a in actions) and drain_marked(ctx):
        # its labels already match (another apply re-registered it): a drain left behind would keep it off
        for act in [a for a in actions if a["kind"] == "register"]:
            note_drain_end(act, end_drain(ctx))
    if ctx.headless and not failed and not ctx.skip_launchctl:
        try:
            ensure_headless_helper(ctx)
        except OSError as error:
            failed = True
            for act in actions:
                if act["kind"] == "agent" and act["state"] in {"create", "update", "unchanged"}:
                    act["state"], act["note"] = "failed", f"headless supervisor install failed: {error}"[:400]
    for act in actions:
        act.setdefault("applied", False)
        if failed:
            if act["state"] in {"create", "update", "pending"}:
                act["state"], act["note"] = "skipped", "an earlier step was blocked or failed"
            continue
        kind, state = act["kind"], act["state"]
        if state == "blocked":
            failed = True
            continue
        if kind == "dir" and state == "create":
            receipt_doc["runnerDirOwned"] = True  # set before anything lands inside it
        elif kind == "download" and state == "create":
            download_and_unpack(ctx, act, receipt_doc["installId"])
            if act["state"] != "failed":
                receipt_doc["runnerVersion"] = act["version"]
                receipt_doc["runnerSha256"] = act["sha256"]
        elif kind == "register" and state == "create":
            register(ctx, act)
            if act["state"] != "failed":
                receipt_doc["registration"] = {"owned": True, "scope": ctx.org or ctx.repo, "org": bool(ctx.org),
                                               "name": ctx.name, "labels": ctx.labels,
                                               "runnerId": act.get("runnerId")}
        elif kind == "register" and state == "relabel":
            def write_hooks() -> None:
                # a dedicated runner's hooks (its admission wrapper) once it is stopped and before relabel starts it
                # again: its first job meets the manifest's admission, and a runner relabel could not stop (a job)
                # keeps its old labels with its old admission
                for hook_act in [a for a in actions if a["kind"] == "hook" and a["state"] in {"create", "update"}]:
                    data, mode = desired_files(ctx)[Path(hook_act["path"])]
                    write_atomic(Path(hook_act["path"]), data, mode)
                    hook_act["applied"] = hook_act["owned"] = True
                    hook_act["ownedSha256"] = hook_act["sha256"]
            relabel(ctx, act, write_hooks if dedicated_of(ctx) else None)
            if act["state"] != "failed":
                receipt_doc["registration"] = {**(receipt_doc.get("registration") or {}), "labels": ctx.labels,
                                               "runnerId": act.get("runnerId"), "owned": True}
                act["state"] = "updated"
        elif kind == "register" and state == "unchanged" and not receipt_doc.get("registration"):
            adopted = adopt_registration(ctx)
            if adopted:
                receipt_doc["registration"] = adopted
                act["note"] = "adopted the registration an interrupted --apply finished in this directory"
        elif kind == "relay" and state in {"create", "update", "remove"} and act.get("loaded") and runner_busy(ctx):
            # a job may be talking through the relay: unloading it now would cut that connection
            act["state"], act["note"] = "failed", ("the runner has a job that may use the relay; nothing changed, "
                                                   "re-run when idle")
        elif kind in COMPANIONS and state in {"create", "update"}:
            # unloaded first, confirmed: a watch launchd still runs keeps its old plist on disk, so the next apply
            # sees the change again instead of an "unchanged" plist under an old process
            if not ctx.skip_launchctl and not bootout_watch(ctx, act["label"]):
                act["state"], act["note"] = "failed", f"launchd still has the old {kind} agent; nothing written, re-run"
            elif kind == "relay" and (why := prepare_relay_dir(ctx)):
                act["state"], act["note"] = "failed", why[:400]
            else:
                data, mode = desired_files(ctx)[Path(act["path"])]
                write_atomic(Path(act["path"]), data, mode)
                act["applied"] = act["owned"] = True
                act["ownedSha256"] = act["sha256"]
                if not ctx.skip_launchctl:
                    restart_watch(ctx, act)
        elif kind in COMPANIONS and state == "unchanged" and not ctx.skip_launchctl and not act.get("loaded"):
            if kind == "relay" and (why := prepare_relay_dir(ctx)):
                act["state"], act["note"] = "failed", why[:400]
            else:
                restart_watch(ctx, act)
        elif kind in COMPANIONS and state == "remove":
            if not ctx.skip_launchctl and not bootout_watch(ctx, act["label"]):
                # still owned, plist kept: the next apply plans the removal again
                act["state"], act["note"] = "failed", f"launchd still has the {kind} agent; its plist is kept, re-run"
            else:
                Path(act["path"]).unlink(missing_ok=True)
                if kind == "relay":
                    remove_relay_socket(ctx, act)
                act["applied"], act["owned"], act["ownedSha256"] = True, False, None
        elif kind == "agent" and state in {"create", "update"} and not ctx.skip_launchctl \
                and (act.get("loaded") or getattr(ctx, "agent_started", False)) and not stop_if_idle(ctx):
            # loaded at plan time, or started since by a relabel: a bootout now would cancel its job
            act["state"], act["note"] = "failed", "the runner has a job; nothing changed, re-run when idle"
        elif kind in {"hook", "agent"} and state in {"create", "update"}:
            data, mode = desired_files(ctx)[Path(act["path"])]
            if kind == "agent" and (act.get("loaded") or getattr(ctx, "agent_started", False)):
                act["loaded"] = ctx.agent_started = False  # the step above stopped it idle
            if kind == "agent":
                install_service_file(ctx, Path(act["path"]), data, mode)
            else:
                write_atomic(Path(act["path"]), data, mode)
            act["applied"] = act["owned"] = True
            act["ownedSha256"] = act["sha256"]
        if kind == "agent" and hasattr(ctx, "agent_started") and not act.get("applied"):
            act["loaded"] = ctx.agent_started  # relabel stopped this unchanged plist, and started it unless held
        if kind == "agent" and act["state"] in {"create", "update", "unchanged"} and not ctx.skip_launchctl \
                and not act.get("loaded"):
            if act.get("held"):
                ctx.held = True
                act["note"] = (f"held by runner_hold ({ctx.show(held_marker(ctx))}); not started. "
                               "cmux_mini_fix.sh runner_release starts it")
            else:
                why = start_agent(ctx, act, act["path"])
                if why:
                    act["state"], act["note"] = "failed", why[:400]
        if kind == "agent" and getattr(ctx, "enabled_label", False):
            act["wasDisabled"] = act["enabled"] = True
        if kind == "register" and dedicated_of(ctx) and act["state"] != "failed":
            # before the agent starts the runner, which reads .env and .path once: a running listener whose env
            # changes is restarted between jobs (the agent step below starts it again), never under a job
            agent = next((a for a in actions if a["kind"] == "agent"), None)
            running = not ctx.skip_launchctl and agent is not None and \
                bool(agent.get("loaded") or getattr(ctx, "agent_started", False))
            if running and keep_runner_env(ctx, write=False):
                if stop_if_idle(ctx):
                    agent["loaded"] = ctx.agent_started = False
                    keep_runner_env(ctx)
                    act["note"] = "; ".join(filter(None, [act.get("note"), "env changed: restarted between jobs"]))
                else:
                    act["state"], act["note"] = "failed", "its env changed, but the runner has a job; nothing changed, re-run when idle"
            else:
                keep_runner_env(ctx)
        if act["state"] == "failed":
            failed = True
        if kind == "verify":
            held = getattr(ctx, "held", False)
            verify(ctx, act, wait=not ctx.skip_launchctl and not held)
            if held and act["state"] == "ok":
                act["note"] = "; ".join(filter(None, [act.get("note"), "held: registered but not started"]))
            registration = receipt_doc.get("registration")
            if registration and registration.get("runnerId") is None:  # receipts from before .runner ids
                registration["runnerId"] = (local_runner(ctx) or {}).get("agentId")


def local_runner(ctx: Context) -> dict[str, Any] | None:
    """What the runner itself recorded at registration (.runner is JSON, sometimes with a BOM)."""
    try:
        doc = json.loads((ctx.runner_dir / ".runner").read_text(encoding="utf-8-sig"))
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) else None


def adopt_registration(ctx: Context) -> dict[str, Any] | None:
    """An earlier --apply timed out while config.sh kept going and registered anyway. Only called for
    a directory this command owns (marker + receipt), and only for the exact name and scope asked for."""
    local = local_runner(ctx)
    if not local or local.get("agentName") != ctx.name:
        return None
    if str(local.get("gitHubUrl") or "").rstrip("/").lower() != ctx.scope_url.lower():
        return None
    return {"owned": True, "scope": ctx.org or ctx.repo, "org": bool(ctx.org), "name": ctx.name,
            "labels": ctx.labels, "runnerId": local.get("agentId"), "adopted": True}


def verify_local(ctx: Context, act: dict[str, Any], wait: bool) -> None:
    """No gh: trust .runner for the identity and the runner's own log for being online."""
    local = local_runner(ctx)
    if local is None or local.get("agentName") != ctx.name:
        act["state"], act["note"] = "failed", "no .runner for this name; registration did not complete"
        return
    offset = getattr(ctx, "log_offset", None)
    deadline = time.monotonic() + (ONLINE_WAIT_S if wait else 0)
    online = held = False
    while offset is not None:
        try:
            with ctx.log_path.open("rb") as log:
                log.seek(offset)
                text = log.read()
                online, held = LISTENING.encode() in text, GATE_HELD.encode() in text
        except OSError:
            pass
        if online or held or time.monotonic() >= deadline:
            break
        time.sleep(3)
    status = "online" if online else "held off by the listener gate" if held else "unknown"
    act["runner"] = {"id": local.get("agentId"), "status": status, "source": "local"}
    if held and not online:
        act["state"] = "ok"
        act["note"] = ("registered; the listener gate is holding it off while a fleet build has the host, "
                       f"and it starts listening once the host is free (see {ctx.show(ctx.log_path)})")
        return
    if offset is not None and not online:
        act["state"], act["note"] = "failed", f"runner did not log '{LISTENING}' within {ONLINE_WAIT_S}s; see {ctx.show(ctx.log_path)}"
        return
    act["state"] = "ok"
    act["note"] = ("online per the runner log" if online else "registered locally") + \
        f"; no gh here, so confirm labels from an admin machine: gh api {ctx.scope_api}/actions/runners"


def gate_holding(ctx: Context) -> bool:
    """The listener gate logged, since this --apply started the agent, that it is holding the runner off."""
    offset = getattr(ctx, "log_offset", None)
    if offset is None:
        return False
    try:
        with ctx.log_path.open("rb") as log:
            log.seek(offset)
            return GATE_HELD.encode() in log.read()
    except OSError:
        return False


def verify(ctx: Context, act: dict[str, Any], wait: bool) -> None:
    if ctx.gh is None:
        verify_local(ctx, act, wait)
        return
    deadline = time.monotonic() + (ONLINE_WAIT_S if wait else 0)
    while True:
        found = find_runner(ctx)
        if found and (found.get("status") == "online" or time.monotonic() >= deadline or gate_holding(ctx)):
            break
        if not found and time.monotonic() >= deadline:
            break
        time.sleep(3)
    if not found:
        act["state"], act["note"] = "failed", f"GitHub does not list a runner named {ctx.name}"
        return
    missing = [label for label in ctx.labels if label not in (found.get("labels") or [])]
    act.update(runner=found, state="ok" if not missing else "failed",
               note="" if not missing else "missing labels: " + ",".join(missing))
    if found.get("status") != "online" and act["state"] == "ok":
        act["note"] = f"registered, status {found.get('status')}" + (
            "; the listener gate is holding it off while a fleet build has the host" if gate_holding(ctx) else "")


def service_may_run(ctx: Context) -> bool:
    """launchd may (re)start this runner's agent: it has the label loaded (KeepAlive restarts it between processes),
    or print failed some other way. A sandbox HOME loads nothing."""
    if getattr(ctx, "sandbox", False):
        return False
    domain = f"system/{ctx.label}" if ctx.headless else f"gui/{ctx.uid}/{ctx.label}"
    return run([SUDO, LAUNCHCTL, "print", domain] if ctx.headless else [LAUNCHCTL, "print", domain])[0] \
        != LAUNCHCTL_NOT_FOUND


def apply_uninstall(ctx: Context, actions: list[dict[str, Any]]) -> None:
    # Nothing is removed under a job: the agent's bootout, the deregister and the directory each cancel one. One
    # frozen look decides for every step: with launchctl, the agent is booted out under it (and its own step then
    # only removes the plist); otherwise (--skip-launchctl, or a plist this install does not own) any listener
    # still running refuses too, since deregistering under a live listener orphans it.
    removing = [act for act in actions if act["state"] == "remove"]
    # a dedicated runner's watch loop goes first, confirmed: one launchd keeps would outlive everything below it,
    # so the uninstall stops there and keeps the receipt, the registration and the directory for a re-run
    if any(a["kind"] == "relay" for a in removing) and runner_busy(ctx):
        # the relay goes before the idle check below, so it waits for idle itself: a job may be using it
        for other in removing:
            other["applied"] = False
            other["state"], other["note"] = "failed", ("the runner has a job that may use the relay; nothing removed, "
                                                       "re-run when idle")
        return
    for act in [a for a in removing if a["kind"] in COMPANIONS]:
        act["applied"] = False
        if not ctx.skip_launchctl and not bootout_watch(ctx, act["label"]):
            for other in removing:
                other["state"], other["note"] = "failed", (
                    f"launchd still has the {act['kind']} agent; nothing else removed, re-run" if other is act
                    else f"kept: the {act['kind']} agent did not unload")
            return
        Path(act["path"]).unlink(missing_ok=True)
        if act["kind"] == "relay":
            remove_relay_socket(ctx, act)
        act["applied"] = True
    removing = [act for act in removing if act["kind"] not in COMPANIONS]
    agent = next((act for act in removing if act["kind"] == "agent"), None)
    booting_out = bool(agent) and not ctx.skip_launchctl
    idle = not removing or ((booting_out or not service_may_run(ctx)) and stop_if_idle(
        ctx, (lambda: bootout(ctx)) if booting_out else (lambda: True), listener_ok=booting_out))
    drained: bool | None = None
    for act in actions:
        if act["kind"] in COMPANIONS:
            continue  # handled above
        act["applied"] = False
        if act["state"] != "remove":
            continue
        if not idle:
            # failed, not skipped: a nonzero exit stops the fleet's migration before it registers the new scope
            act["state"], act["note"] = "failed", "the runner has a job (or a listener runs); nothing removed, re-run when idle"
            if drained is None:
                drained = start_drain(ctx, "its retirement")
            if drained:
                act["note"] += f"; {DRAINING}"
                act["draining"] = True
            continue
        if act["kind"] == "agent":
            if ctx.headless:
                code, out = run([SUDO, "/bin/rm", "-f", act["path"]])
                if code != 0:
                    act["state"], act["note"] = "failed", f"sudo remove failed: {out[-300:]}"
                    continue
            else:
                Path(act["path"]).unlink()
            act["applied"] = True
            if held_marker(ctx).is_file():  # a later install of this directory must not start out held
                held_marker(ctx).unlink()
                act["heldMarkRemoved"] = True
        elif act["kind"] == "deregister":
            token = ctx.take_token(f"{ctx.scope_api}/actions/runners/remove-token")
            code, out = (1, "no removal token")
            if token is not None:
                code, out = run_with_token([os.fspath(ctx.runner_dir / "config.sh"), "remove"], token, ctx.runner_dir)
                del token
            if code == 0:
                act["applied"] = True
                continue
            if ctx.gh is None:
                act["state"], act["note"] = "failed", f"deregistration failed: {out[-300:]}"
                continue
            listed, runner = lookup_runner(ctx)
            owned_id = act.get("runnerId")
            if runner and owned_id is not None and runner.get("id") == owned_id:
                code2, out2 = run([ctx.gh, "api", "-X", "DELETE", f"{ctx.scope_api}/actions/runners/{int(runner['id'])}"])
                if code2 == 0:
                    act["applied"], act["note"] = True, "config.sh remove failed; deleted by id through the API"
                    continue
                out = out2
            elif runner:
                out = (f"GitHub lists {ctx.name} as id {runner.get('id')}, not this install's id {owned_id}; "
                       "another machine may own that name now, so it is not deleted")
            elif listed and runner is None:
                act["applied"], act["note"] = True, "GitHub no longer lists this runner"
                continue
            act["state"], act["note"] = "failed", f"deregistration failed: {out[-300:]}"
        elif act["kind"] == "dir":
            if any(a["kind"] == "deregister" and a["state"] == "failed" for a in actions):
                act["state"], act["note"] = "kept", "kept because deregistration failed; rerun after fixing it"
                continue
            shutil.rmtree(act["path"])
            act["applied"] = True


# ---------------------------------------------------------------- hook refresh (glaeda-update)

REFRESH_SCHEMA = "glaeda-cmux-runner-refresh-hooks/v1"
HOOK_CALLERS = ("job-started.sh", "job-completed.sh", "listen.sh", "glaeda-canonical-root")  # hook_wrappers
SHELL_ENDS = {"&", "&&", "||", "|", ";", ";;"}
# Shell words in glaeda-canonical-root's calls: a sample value for $root, nothing for the caller's "$@".
SHELL_SAMPLES = {"$root": "1", "$@": None}
# glaeda_release.HOOK_HISTORY at the release root, two levels above this copy (generations/<tag>/glaeda/scripts)
HOOK_HISTORY = SCRIPT_DIR.parent.parent / "hook-history.json"
# A runner with a job when --refresh-hooks looks is watched this long for the gap between two jobs, and swapped in
# it. One look per run left runners that ran jobs back to back on a hook two releases old for hours (2026-10-21).
REFRESH_GAP_WAIT_S = 240.0
REFRESH_GAP_POLL_S = 0.5
JOB_RUNNING = "the runner has a job; a later run installs it"
HOOK_CHECK_TIMEOUT_S = 60  # one --parse-only start of the new hook; on an idle mini it takes 0.1 s
HOOK_CHECK_SLOW = "the new hook's argument check did not finish in time"
# A runner busy at every refresh still goes idle between jobs, and that is when its gate runs. So a refresh that finds a
# job leaves the checked new files beside the old ones as .<name>.next, with NEXT_RECORD naming the hook they replace,
# and the hook's job-completed installs them at the end of that job (glaeda-cmux-runner-hook install_staged_hook): the
# next job-started runs the new file whole. A runner whose installed hook predates install_staged_hook gets its first
# new hook from the gap wait above.
NEXT_SUFFIX = ".next"
NEXT_RECORD = ".hook-next.json"
RUNNER_LOCK = "runner.lock"
# DEDICATED_ONLY marker, written under the runner lock by the first dedicated --apply on a dedicatedOnly member: from
# then on every pool --apply on this Mac refuses, whatever manifest it read (a stale one names no dedicatedOnly).
# Only --clear-dedicated-only (a deliberate operator step, under the same lock) removes it. Review of a1de21e4.
DEDICATED_ONLY_MARKER = "dedicated-only.json"
STAGE_SUFFIX = ".cmux-runner.tmp"


@contextlib.contextmanager
def runner_lock(home: Path, wait: bool):
    """One lock for every --apply, --uninstall and --refresh-hooks on this Mac, so a refresh never checks the
    wrappers of one install and writes over the hook of the next. Yields False when wait is off and it is held."""
    state = home / ".local/state/glaeda/cmux-runner"
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(state / RUNNER_LOCK, "a") as file:
        try:
            fcntl.flock(file, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            yield False
            return
        yield True


def hook_history() -> dict[str, set[str]] | None:
    """{file: SHA-256s of every version of it this release descends from}, or None beside no release."""
    try:
        doc = json.loads(HOOK_HISTORY.read_text())
        return {name: {str(digest) for digest in doc[name]} for name in (HOOK_NAME, RESERVATION_NAME)}
    except (OSError, ValueError, KeyError, TypeError):
        return None


def hook_calls(hook_dir: Path) -> list[tuple[str, list[str]]]:
    """(wrapper, [interpreter, hook, arguments...]) for each line of the installed wrappers that runs the hook.
    $root takes a sample value and "$@" is dropped; a line with any other shell word is left out."""
    hook = os.fspath(hook_dir / HOOK_NAME)
    calls = []
    for name in HOOK_CALLERS:
        try:
            text = (hook_dir / name).read_text()
        except (OSError, UnicodeDecodeError):
            continue
        for line in text.splitlines():
            try:
                words = shlex.split(line, comments=True)
            except ValueError:
                continue
            if hook not in words or words.index(hook) == 0:
                continue
            at = words.index(hook)
            args = []
            for word in words[at + 1:]:
                if word in SHELL_ENDS:
                    break
                if word in SHELL_SAMPLES:
                    if SHELL_SAMPLES[word] is not None:
                        args.append(SHELL_SAMPLES[word])
                    continue
                args.append(word)
            if not any("$" in arg for arg in args):
                calls.append((name, [words[at - 1], hook, *args]))
    return calls


def new_hook_accepts(calls: list[tuple[str, list[str]]], staged: Path) -> str | None:
    """None when the staged hook, run from the hook directory, parses every installed call's arguments under that
    call's own interpreter; else the first wrapper it rejects and why. A job-started it rejects fails every job."""
    for wrapper, (python, _, *args) in calls:
        if not os.path.isabs(python) or not os.access(python, os.X_OK):
            return f"{wrapper} runs the hook with {python[:120]!r}, not an executable absolute path"
        try:
            result = subprocess.run([python, os.fspath(staged), *args, "--parse-only"], stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                    timeout=HOOK_CHECK_TIMEOUT_S, check=False)
        except subprocess.TimeoutExpired:
            # a loaded host (load 160 on a fleet mini, 2026-10-27), not a hook that rejects anything: no verdict
            return f"{HOOK_CHECK_SLOW} ({wrapper}, {HOOK_CHECK_TIMEOUT_S} s)"
        except OSError as error:
            return f"the new hook rejects {wrapper}'s arguments (exit 127: {str(error)[-200:]})"
        if result.returncode != 0:
            return f"the new hook rejects {wrapper}'s arguments (exit {result.returncode}: {result.stdout.strip()[-200:]})"
    return None


def hook_check_note(entry: dict[str, Any], why: str) -> dict[str, Any]:
    """refresh_hook_dir's answer for new_hook_accepts' why: a check that timed out is deferred to a later run (it never
    marks the release's hook bad); a rejection blocks."""
    if why.startswith(HOOK_CHECK_SLOW):
        return {**entry, "state": "deferred", "note": why + "; a later run checks again"}
    return {**entry, "state": "blocked", "note": why + "; re-run glaeda-cmux-runner --apply"}


def stage_file(path: Path, data: bytes, mode: int) -> Path:
    """data, synced, in a unique stage beside path (its directory must exist); the caller renames or removes it."""
    fd, stage = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=STAGE_SUFFIX)
    try:
        with os.fdopen(fd, "wb") as file:
            file.write(data)
            file.flush()
            os.fsync(file.fileno())
        os.chmod(stage, mode)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(stage)
        raise
    return Path(stage)


def clear_next(hook_dir: Path) -> None:
    """Remove what stage_next left: the runner got the release's files some other way."""
    for path in (hook_dir / f".{HOOK_NAME}{NEXT_SUFFIX}", hook_dir / f".{RESERVATION_NAME}{NEXT_SUFFIX}",
                 hook_dir / NEXT_RECORD):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()


def stage_next(hook_dir: Path, staged: Path, stale: list[str], sources: dict[str, tuple[bytes, int]]) -> None:
    """Leave the checked hook (staged) and the module as .<name>.next, and NEXT_RECORD, for job-completed to install."""
    clear_next(hook_dir)
    if RESERVATION_NAME in stale:
        write_atomic(hook_dir / f".{RESERVATION_NAME}{NEXT_SUFFIX}", *sources[RESERVATION_NAME], make_parent=False)
    record = {"replaces": hashlib.sha256((hook_dir / HOOK_NAME).read_bytes()).hexdigest(),
              "hook": hashlib.sha256(sources[HOOK_NAME][0]).hexdigest()}  # bare hex digests, as the hook compares
    if RESERVATION_NAME in stale:
        record["module"] = hashlib.sha256(sources[RESERVATION_NAME][0]).hexdigest()
    os.replace(staged, hook_dir / f".{HOOK_NAME}{NEXT_SUFFIX}")
    write_atomic(hook_dir / NEXT_RECORD, (json.dumps(record, sort_keys=True) + "\n").encode(), 0o644, make_parent=False)
    sync_dir(hook_dir)


def sync_dir(path: Path) -> None:
    with contextlib.suppress(OSError):
        fd = os.open(path, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


# SIGN_HOLD: cmux's claim gate admits a signing job only when glaeda-signing-hooks.txt at the run's own commit lists the
# hook that runs it (SIGNING_HOOKS in the hook). A nightly-next run's sign job can wait hours for a signing mini, so a run
# pushed before cmux listed a new hook is still queued when the OTA refresh installs it. On 2026-11-05 cmux15 took hook
# aff786ca at 06:49Z and refused the sign jobs of five such runs at 06:51-06:53Z (cmux 41967127267 to 41976650433),
# each queued since 04:19-05:51Z. So on a --trusted-next-signing runner the refresh holds a new hook back while any
# active run of a SIGN_HOLD_SOURCES workflow has a head commit whose list lacks it but carries the hook on disk; that
# old hook signs them. It never changes what is admitted: the hook and the claim gate are untouched, and a commit that
# lists neither hook is refused as before, which is why such a run is not a blocker (sign_hold_blockers): holding the
# old hook cannot serve it, and treating it as one would strand every rollout for as long as cmux's list trailed.
# The hold ends when no active run needs it, or SIGN_HOLD_CAP_S after its first deferral of that hook (installed then,
# with a loud line), so a rollout can never be held for good by old queued runs. The cap never installs a hook that the
# tip of a branch this runner signs for lacks while it lists the hook on disk (sign_hold_tips): that would refuse every
# new run of the branch too. On 2026-11-06 the cap installed 5836275a on cmux15 at 11:17Z while nightly-next's list
# lacked it, and every nightly-next sign job was refused for hours (cmux 42235384601 to 42238047014).
# Reads are anonymous (the minis have no gh): one runs list per active status per source, then one raw read per head
# commit, cached in the state file (a commit's list never changes), all memoised for SIGN_HOLD_MEMO_S and made only
# while a signing runner has a new hook pending, with a known blocker rechecked through the build controller at no
# GitHub cost (glaeda#1864). A read that fails is retried once, then holds like a blocker, inside the same cap
# (2026-11-05 10:16Z: a failed read let a signing runner take hook bcdd1aac over a run in progress that lacked it).
# A commit with no list at all is not a failed read (sign_hold_absent): its claim gate reads none, so either hook
# serves it and it holds nothing. cmux#41694 deleted the list from nightly-next on 2026-11-12; read as a failure, that
# 404 deferred every hook on the signing runners from then on, with no cap (sign_hold_tips).
SIGN_HOLD_REPO = "manaflow-ai/cmux"
# SIGN_HOLD_SOURCES: the (workflow file, the branches whose runs hold) the hold reads. One entry per workflow whose
# signing jobs this runner admits, so the hold covers every one of them: nightly.yml on nightly-next (TRUSTED_NEXT_SIGNING)
# and on main, and auto-resume-nightly-notarization.yml on main (ONE_MINI_NIGHTLY, AUTO_RESUME). With nightly-next alone,
# a hook rolled here while cmux main's list lacked it refused main's signing jobs instead of holding the old hook: that
# list trails nightly-next's by several releases (091eec20 against bcdd1aac on 2026-11-05), so every classic signing job
# would have been refused until a cmux pull request landed, and the job then requeues rather than reaching a signer.
# Branches are filtered here, not in the query, so one runs-list pass per workflow covers all of its branches: nightly.yml
# costs the same reads for both branches as it did for one. A workflow's runs are listed per active status
# (sign_hold_runs), so a discovery pass is len(SIGN_HOLD_SOURCES) * len(SIGN_HOLD_ACTIVE) list reads (10, against 5 for
# nightly-next alone) plus one raw read per distinct head commit, cached in the state file and shared across the sources.
# That pass is not periodic: refresh_hook_dir consults the hold only while a signing runner's installed hook differs from
# the release's, so a converged host reads nothing, and once a blocker is known glaeda#1864 rechecks it through the build
# controller over the tailnet at no GitHub cost. So a rollout window costs the 10 once, not 10 per refresh, well inside the
# 60/h unauthenticated limit that HTTP 403 spent at 11:00Z on 2026-11-05. A controller that cannot answer for the whole
# window falls back to this list every refresh (6/h), which is that limit exactly: its own residual, tracked with #1864.
SIGN_HOLD_SOURCES: tuple[tuple[str, frozenset[str]], ...] = (
    ("nightly.yml", frozenset({"nightly-next", "main"})),
    ("auto-resume-nightly-notarization.yml", frozenset({"main"})),
)
SIGN_HOLD_RUNS_URL = ("https://api.github.com/repos/{repo}/actions/workflows/{workflow}/runs"
                      "?per_page=100")
SIGN_HOLD_PAGE_SIZE = 100
SIGN_HOLD_PAGES = 3
SIGN_HOLD_LIST_URL = "https://raw.githubusercontent.com/{repo}/{sha}/scripts/ci/glaeda-signing-hooks.txt"
# A file every commit that can hold has (a run of nightly.yml is what holds): read to tell "this commit has no list"
# from "this commit cannot be read" when the list answers 404.
SIGN_HOLD_PROBE_URL = "https://raw.githubusercontent.com/{repo}/{sha}/.github/workflows/nightly.yml"
SIGN_HOLD_ACTIVE = frozenset({"queued", "in_progress", "waiting", "requested", "pending"})
SIGN_HOLD_CAP_S = 3 * 3600.0
SIGN_HOLD_MEMO_S = 300.0
SIGN_HOLD_FETCH_S = 15
SIGN_HOLD_STATE = "sign-hold.json"
# Known blockers are rechecked through the cmux build controller (glaeda-gh's Controller: run status from GitHub's
# webhooks over the tailnet, no GitHub quota) instead of re-listing runs anonymously: the office minis share one IP's
# 60/h anonymous budget, and a spent one (HTTP 403) is what let hook bcdd1aac in at 11:00Z on 2026-11-05. While any
# known blocker is still running the hold is holding anyway, so a run that appeared since cannot slip through; once
# none is, the full anonymous list is read again before anything installs. A controller that cannot answer is retried
# once, then the list is read; an unreadable list retries once more and then holds (never fails open).
SIGN_HOLD_CONTROLLER_DEFAULT = "http://100.89.225.106:18765"
SIGN_HOLD_CONTROLLER_CONFIG = Path(".local/share/cmux-fleet-client/client.json")  # under HOME, as glaeda-gh reads it
SIGN_HOLD_FLAG = "--trusted-next-signing"
_SIGN_HOLD_MEMO: dict[tuple[str, str | None], tuple[float, Any, list[str]]] = {}
SIGN_HOLD_RETRY_S = 3.0  # one retry of a failed read before the hold fails open
# What the hold did in this refresh (a deferral, or an install at its cap), for --refresh-hooks' "signHold":
# glaeda-update writes it to its jsonl and converge.json. Its stderr lines are not kept (2026-11-05 10:16Z: a signing
# runner took hook bcdd1aac over an active run that lacked it, and nothing on the host said why).
_SIGN_HOLD_EVENTS: list[str] = []


def signing_runner(hook_dir: Path) -> bool:
    """Whether this install's job-started runs the hook with --trusted-next-signing (the nightly signing runner)."""
    try:
        text = (hook_dir / "job-started.sh").read_text()
    except (OSError, UnicodeDecodeError):
        return False
    for line in text.splitlines():
        try:
            if SIGN_HOLD_FLAG in shlex.split(line, comments=True):
                return True
        except ValueError:
            continue
    return False


def sign_hold_fetch(url: str, protocols: str = "=https", status: bool = False) -> str | None:
    """The body at url, read anonymously with curl, or None on any failure. With status, the HTTP status of the final
    answer instead ("404"), or None when there was none."""
    mode = ["-sSL", "-o", os.devnull, "-w", "%{http_code}"] if status else ["-fsSL"]
    try:
        got = subprocess.run([CURL, *mode, "--proto", protocols, "--max-time", str(SIGN_HOLD_FETCH_S),
                              "--max-filesize", "4194304", "-H", "Accept: application/vnd.github+json", url],
                             stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                             timeout=SIGN_HOLD_FETCH_S + 5, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    return got.stdout if got.returncode == 0 else None


def sign_hold_read(url: str) -> str | None:
    """One anonymous read for the hold (sign_hold_blockers' whole pass is what is retried)."""
    return sign_hold_fetch(url)


def sign_hold_absent(ref: str) -> bool:
    """Whether SIGN_HOLD_REPO at ref (a commit or a branch) has no signing-hook list: the list answers 404 while the
    same ref serves nightly.yml. Asked only after the list read failed. Anything else (a 403 or 5xx, no answer, a ref
    that serves neither file) is an unreadable answer, as before."""
    if sign_hold_fetch(SIGN_HOLD_LIST_URL.format(repo=SIGN_HOLD_REPO, sha=ref), status=True) != "404":
        return False
    return sign_hold_fetch(SIGN_HOLD_PROBE_URL.format(repo=SIGN_HOLD_REPO, sha=ref)) is not None


def sign_hold_runs() -> list[dict] | None:
    """The active runs of every SIGN_HOLD_SOURCES workflow, on the branches that entry names, or None when they cannot
    all be read. GitHub lists runs by creation time, not status, so an old queued run can sit behind newer finished ones
    (2026-11-05: five runs queued for hours while every newer one was cancelled). So each active status is listed on its
    own with `status=`: every run on such a page is active, and a status is read whole once a page comes back short. More
    than SIGN_HOLD_PAGES pages of one status is no answer (glaeda#1852). A run of a branch the entry does not name is
    skipped here rather than in the query, so one pass covers every branch of that workflow."""
    active: dict[int, dict] = {}
    for workflow, branches in SIGN_HOLD_SOURCES:
        url = SIGN_HOLD_RUNS_URL.format(repo=SIGN_HOLD_REPO, workflow=workflow)
        for status in sorted(SIGN_HOLD_ACTIVE):
            for page in range(1, SIGN_HOLD_PAGES + 1):
                body = sign_hold_read(url + f"&status={status}&page={page}")
                try:
                    runs = json.loads(body)["workflow_runs"] if body is not None else None
                except (ValueError, KeyError, TypeError):
                    runs = None
                if not isinstance(runs, list) or not all(isinstance(run, dict) for run in runs):
                    return None
                for run in runs:
                    rid, sha = run.get("id"), str(run.get("head_sha") or "")
                    if not isinstance(rid, int) or isinstance(rid, bool) or not re.fullmatch(r"[0-9a-f]{40}", sha):
                        return None  # malformed run data is an unreadable answer, never a crash
                    branch = run.get("head_branch")
                    if not isinstance(branch, str):
                        return None  # GitHub types head_branch nullable; which branch a run is on is not optional here
                    if branch not in branches:  # another branch's run of this workflow holds nothing
                        continue
                    if run.get("status") in SIGN_HOLD_ACTIVE:  # a run that finished between two reads holds nothing
                        active[rid] = {"id": rid, "head_sha": sha, "workflow": workflow, "branch": branch}
                if len(runs) < SIGN_HOLD_PAGE_SIZE:
                    break
            else:
                return None
    return sorted(active.values(), key=lambda run: -run["id"])


def sign_hold_controller(home: Path) -> str | None:
    """The build controller's base URL ($CMUX_CI_CONTROLLER, else glaeda-gh's client.json, else the default)."""
    base = os.environ.get("CMUX_CI_CONTROLLER", "").strip()
    if not base:
        try:
            doc = json.loads((home / SIGN_HOLD_CONTROLLER_CONFIG).read_text())
            base = doc.get("controller") if isinstance(doc, dict) else None
        except (OSError, ValueError):
            base = None
        base = base or SIGN_HOLD_CONTROLLER_DEFAULT
    return base.rstrip("/") if isinstance(base, str) and base.startswith(("http://", "https://")) else None


def sign_hold_recheck(home: Path, known: list[tuple[int, str]]) -> list[tuple[int, str]] | None:
    """The known blockers the controller still has running, or None when it cannot answer for every one of them."""
    base = sign_hold_controller(home)
    if base is None:
        return None
    still = []
    for rid, sha in known:
        body = sign_hold_fetch(f"{base}/v1/github/runs/{int(rid)}?wait=0", protocols="=http,https")
        try:
            doc = json.loads(body) if body is not None else None
        except ValueError:
            doc = None
        run = doc.get("run") if isinstance(doc, dict) else None
        if not isinstance(doc, dict) or doc.get("known") is not True or not isinstance(doc.get("terminal"), bool) \
                or not isinstance(run, dict) or run.get("id") != rid:
            return None  # not known to it, or not an answer: the anonymous list decides
        if not doc["terminal"]:
            still.append((rid, sha))
    return still


def sign_hold_blockers(digest: str, cache: dict[str, bool], home: Path | None = None,
                       known: list[tuple[int, str]] | None = None,
                       installed: str | None = None) -> list[tuple[int, str]] | None:
    """[(run id, head sha)] of the active runs of every SIGN_HOLD_SOURCES (workflow, branches) pair that holding the
    installed hook would serve, or None when a read failed. A run holds only when its commit's list lacks digest (the
    hook about to be installed) *and* carries installed (the hook on disk now): a commit listing neither is refused
    whichever hook this runner holds, so keeping the old one buys that run nothing and only strands the rollout. cache
    maps a head sha to that decision, so two sources at one commit read it once; new answers are added to it. Known
    blockers (the last answer's) still running by the controller are the answer, with no anonymous read, whichever
    source listed them."""
    if known and home is not None:
        still = sign_hold_recheck(home, known)
        if still is None:
            time.sleep(SIGN_HOLD_RETRY_S)
            still = sign_hold_recheck(home, known)
        if still:
            return still
    runs = sign_hold_runs()
    if runs is None:
        return None
    blockers = []
    for run in runs:
        sha = run["head_sha"]
        if sha not in cache:
            text = sign_hold_read(SIGN_HOLD_LIST_URL.format(repo=SIGN_HOLD_REPO, sha=sha))
            if text is None:
                if not sign_hold_absent(sha):
                    return None
                cache[sha] = True  # no list at this commit: its gate reads none, so the new hook serves it too
                continue
            listed = {ln.split(None, 1)[0] for ln in text.splitlines() if ln.strip() and not ln.lstrip().startswith("#")}
            if not listed:
                return None  # an empty answer is not a list
            # cache[sha] is "this commit needs no hold": it already lists the new hook, or it lists neither, so the
            # old hook cannot serve it either (cmux main's list trailed nightly-next's by seven hooks on 2026-11-05,
            # and every queued main run's commit listed neither bcdd1aac nor its successors).
            cache[sha] = digest in listed or (installed is not None and installed not in listed)
        if not cache[sha]:
            blockers.append((run["id"], sha))
    return blockers


def sign_hold_tips(digest: str, installed: str | None) -> list[str] | None:
    """The SIGN_HOLD_SOURCES branches whose tip lists installed (the hook on disk) and not digest (the one about to be
    installed), or None when a tip's list cannot be read. A tip that lists neither is refused whichever hook is on disk,
    so it holds nothing (as in sign_hold_blockers); nor does a tip with no list (sign_hold_absent), which refuses
    neither."""
    held = []
    for branch in sorted({b for _, branches in SIGN_HOLD_SOURCES for b in branches}):
        # one read per tip for SIGN_HOLD_MEMO_S, shared by every runner whatever hook it has on disk (the memo's
        # ("tip", branch) entries, cleared with it)
        memo = _SIGN_HOLD_MEMO.get(("tip", branch))
        if memo and time.time() - memo[0] < SIGN_HOLD_MEMO_S:
            listed = memo[1]
        else:
            text = sign_hold_read(SIGN_HOLD_LIST_URL.format(repo=SIGN_HOLD_REPO, sha=branch))
            if text is None and not sign_hold_absent(branch):
                return None
            listed = frozenset(ln.split(None, 1)[0] for ln in (text or "").splitlines()
                               if ln.strip() and not ln.lstrip().startswith("#"))
            if not listed and text is not None:
                return None  # an empty answer is not a list
            _SIGN_HOLD_MEMO[("tip", branch)] = (time.time(), listed, [])
        if digest not in listed and installed is not None and installed in listed:
            held.append(branch)
    return held


def sign_hold_event(line: str) -> None:
    """Say what the hold did: on stderr, and in this refresh's "signHold" report."""
    print(f"glaeda-cmux-runner: sign hold: {line}", file=sys.stderr, flush=True)
    if line not in _SIGN_HOLD_EVENTS:
        _SIGN_HOLD_EVENTS.append(line)


def sign_hold(home: Path, digest: str, installed: str | None = None,
              now: Callable[[], float] = time.time) -> str | None:
    """SIGN_HOLD: a deferral note while an active run of a SIGN_HOLD_SOURCES workflow lacks digest and the installed
    hook would serve it, else None (install). Records the first deferral of digest in the state file and stops holding
    SIGN_HOLD_CAP_S after it."""
    # keyed on both hooks: a cached decision folds in the installed one (sign_hold_blockers), so it is not the
    # answer once a different hook is on disk, even for the same incoming digest
    memo = _SIGN_HOLD_MEMO.get((digest, installed))
    if memo and now() - memo[0] < SIGN_HOLD_MEMO_S:
        for line in memo[2]:  # a memoised answer is reported again: this refresh's "signHold" starts empty
            sign_hold_event(line)
        return memo[1]
    path = home / ".local/state/glaeda/cmux-runner" / SIGN_HOLD_STATE
    try:
        state = json.loads(path.read_text())
        if not isinstance(state, dict) or state.get("digest") != digest:
            state = {}
        elif state.get("installed") != installed:
            # The cap window belongs to the hook being rolled out, so it survives a change of the hook on disk: one
            # state file serves every instance of this install (refresh_hooks calls this once per receipt), and two
            # instances sitting at different hooks would otherwise reset "since" for each other on every refresh, so
            # the cap would never fire and a rollout could be held for good. The cached decisions are the opposite
            # case: each folds in the hook on disk, so they are this pair's and are dropped here.
            state = {"digest": digest, "since": state.get("since")}
    except (OSError, ValueError):
        state = {}
    # "serves", not the older "listed": the cached value now folds in the installed hook (sign_hold_blockers), so a
    # state file written by an earlier release at this same digest must not be read as the new decision.
    cache = state.get("serves") if isinstance(state.get("serves"), dict) else {}
    cache = {k: v for k, v in cache.items() if isinstance(v, bool)}
    known = [(rid, sha) for rid, sha in (state.get("blockers") or [])
             if isinstance(rid, int) and not isinstance(rid, bool) and isinstance(sha, str)] \
        if isinstance(state.get("blockers"), list) and all(isinstance(b, list) and len(b) == 2
                                                          for b in state["blockers"]) else []
    blockers = sign_hold_blockers(digest, cache, home, known, installed)
    if blockers is None:  # any unreadable answer (a failed read, malformed data, too many pages): one more pass
        time.sleep(SIGN_HOLD_RETRY_S)
        blockers = sign_hold_blockers(digest, cache, home, known, installed)
    note: str | None = None
    events_before = len(_SIGN_HOLD_EVENTS)
    since = state.get("since") if isinstance(state.get("since"), (int, float)) else None
    capped = False
    if blockers is None or blockers:
        # an unreadable answer holds too, inside the same cap: on a signing runner keeping the old hook a little
        # longer costs nothing, and installing over a run that lacks the new one strands its sign job (10:16Z)
        since = since if since is not None else now()
        held_since = f"{datetime.datetime.fromtimestamp(since, datetime.timezone.utc):%H:%M:%SZ}"
        why = ("could not read the active runs of a signing workflow or their signing-hook lists (after one retry)"
               if blockers is None else
               "an active signing run's commit does not list hook " + digest[:12] + " ("
               + ", ".join(f"run {rid} at {sha[:12]}" for rid, sha in blockers) + ")")
        if now() - since < SIGN_HOLD_CAP_S:
            note = (f"deferred: {why}; the old hook stays for its sign job (held since {held_since}, "
                    f"cap {SIGN_HOLD_CAP_S / 3600:g} h)")
            sign_hold_event(note)
        else:
            capped = True
    if note is None:
        # about to install: never a hook a signing branch's tip lacks while it lists the one on disk, cap or not
        tips = sign_hold_tips(digest, installed)
        if tips is None or tips:
            since = since if since is not None else now()
            held_since = f"{datetime.datetime.fromtimestamp(since, datetime.timezone.utc):%H:%M:%SZ}"
            why = (f"{', '.join(tips)} at its tip does not list hook {digest[:12]}" if tips else
                   "a signing branch's tip list cannot be read")
            note = f"deferred: {why}; the old hook stays until it does (held since {held_since}, no cap)"
            sign_hold_event(note)
        elif capped:
            sign_hold_event(f"SIGN HOLD CAP: hook {digest[:12]} held {SIGN_HOLD_CAP_S / 3600:g} h since {held_since}; "
                            f"installing it now, though {why}: a sign job whose commit does not list it will be refused")
    with contextlib.suppress(OSError):
        path.parent.mkdir(parents=True, exist_ok=True)
        kept = [[rid, sha] for rid, sha in blockers] if blockers else (known if blockers is None else [])
        write_atomic(path, (json.dumps({"digest": digest, "installed": installed, "since": since, "serves": cache,
                                        "blockers": kept}) + "\n").encode(), 0o644)
    _SIGN_HOLD_MEMO[(digest, installed)] = (now(), note, list(_SIGN_HOLD_EVENTS[events_before:]))
    return note


def refresh_hook_dir(runner_dir: Path, receipt: Any, apply: bool, sources: dict[str, tuple[bytes, int]],
                     history: dict[str, set[str]],
                     hold: Callable[[str, str | None], str | None] | None = None) -> dict[str, Any]:
    """Plan (and with apply, make) one runner install's hook files match this copy's. Caller holds runner_lock."""
    entry: dict[str, Any] = {"runnerDir": os.fspath(runner_dir)}
    if not isinstance(receipt, dict) or not runner_dir.is_absolute() or not owns_runner_dir(runner_dir, receipt):
        return {**entry, "state": "skipped", "note": "not a runner directory this command owns (receipt or marker)"}
    hook_dir = runner_dir / HOOK_DIR
    if hook_dir.is_symlink() or not hook_dir.is_dir():
        return {**entry, "state": "skipped", "note": f"no {HOOK_DIR} directory; --apply installs it"}
    if apply:  # stages a killed refresh or --apply left; under the lock none is live
        for leftover in hook_dir.glob(f".*{STAGE_SUFFIX}"):
            # an older copy's --apply takes no lock and stages to a fixed .<name>.cmux-runner.tmp: never its
            if (hook_dir / leftover.name[1:-len(STAGE_SUFFIX)]).exists():  # .job-started.sh.cmux-runner.tmp
                continue
            if leftover.is_file() and not leftover.is_symlink():
                leftover.unlink()
    stale = []
    for name, (data, mode) in sources.items():
        target = hook_dir / name
        try:
            st = os.lstat(target)
        except FileNotFoundError:
            return {**entry, "state": "skipped", "note": f"{name} is not installed; --apply installs it"}
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            return {**entry, "state": "skipped", "note": f"{name} is not a regular file owned by this user"}
        current = target.read_bytes()
        if current == data:
            if (st.st_mode & 0o777) != mode:
                stale.append(name)
            continue
        if hashlib.sha256(current).hexdigest() not in history[name]:
            # a newer hook (a relabel from main, an --apply from a newer copy) or a local edit: never downgrade it
            return {**entry, "state": "kept", "note": f"the installed {name} is not a version this release "
                                                      "descends from; --apply owns it"}
        stale.append(name)
    if not stale:
        if apply:
            clear_next(hook_dir)
        return {**entry, "state": "unchanged"}
    entry["files"] = stale
    if apply and hold is not None and HOOK_NAME in stale and signing_runner(hook_dir):
        # SIGN_HOLD: cmux lists bare hex. The hook on disk goes too: a run whose commit lists neither it nor the new
        # one is refused either way, so it must not hold the rollout (an unreadable one holds as before).
        try:
            installed_digest = hashlib.sha256((hook_dir / HOOK_NAME).read_bytes()).hexdigest()
        except OSError:
            installed_digest = None
        held = hold(hashlib.sha256(sources[HOOK_NAME][0]).hexdigest(), installed_digest)
        if held:
            # nor may a job-completed install a copy an earlier, unheld refresh staged. The hook's install_staged_hook
            # takes no lock (changing the hook would need a new signing-hooks rollout), so one already past its checks
            # can still land the copy: that is read back and reported as installed, never as held.
            clear_next(hook_dir)
            if hashlib.sha256((hook_dir / HOOK_NAME).read_bytes()).hexdigest() == \
                    hashlib.sha256(sources[HOOK_NAME][0]).hexdigest():
                return {**entry, "state": "updated", "note": "a job-completed installed the copy staged before the "
                                                             "sign hold; " + held}
            return {**entry, "state": "deferred", "note": held}
    # A job's hooks run from these files: job-started under one version, job-completed under the next. The
    # gate takes a swap mid-job (it re-execs in place and adopts its runner), but the job hooks are only ever
    # swapped between jobs. A job that starts after the last look runs one whole file or the other. A runner with a
    # job gets the checked files staged for its job-completed (stage_next).
    busy = worker_running(runner_dir)
    if busy and not apply:
        return {**entry, "state": "deferred", "note": JOB_RUNNING}
    calls = hook_calls(hook_dir)
    if not any(wrapper == "job-started.sh" for wrapper, _ in calls):
        return {**entry, "state": "blocked", "note": "no job-started.sh call to check the new hook against; "
                                                     "re-run glaeda-cmux-runner --apply"}
    if not apply:  # a plan writes nothing: it checks this copy's hook where it is
        why = new_hook_accepts(calls, HOOK_SOURCE)
        if why:
            return hook_check_note(entry, why)
        return {**entry, "state": "update"}
    try:
        staged = stage_file(hook_dir / HOOK_NAME, *sources[HOOK_NAME])
    except OSError as error:  # a full disk: this runner waits, the others still refresh
        return {**entry, "state": "deferred", "note": f"cannot stage the new hook ({type(error).__name__}: {error})"[:300]}
    try:
        why = new_hook_accepts(calls, staged)
        if why:
            return hook_check_note(entry, why)
        if busy or worker_running(runner_dir):  # a job has the runner, or took it during the checks
            try:
                stage_next(hook_dir, staged, stale, sources)
            except OSError as error:
                return {**entry, "state": "deferred", "note": f"{JOB_RUNNING} (cannot stage it: {type(error).__name__})"}
            return {**entry, "state": "deferred", "note": JOB_RUNNING, "staged": True}
        # the module first: the hook, which the gate watches and reloads, lands only beside the module it reads
        try:
            if RESERVATION_NAME in stale:
                write_atomic(hook_dir / RESERVATION_NAME, *sources[RESERVATION_NAME], make_parent=False)
            if HOOK_NAME in stale:
                os.replace(staged, hook_dir / HOOK_NAME)
                sync_dir(hook_dir)
            clear_next(hook_dir)
        except OSError as error:
            return {**entry, "state": "deferred", "note": f"cannot install ({type(error).__name__}: {error})"[:300]}
    finally:
        with contextlib.suppress(FileNotFoundError):
            staged.unlink()
    return {**entry, "state": "updated"}


def refresh_hooks(home: Path, apply: bool) -> dict[str, Any]:
    """--refresh-hooks: every receipt's runner install (the first one and each --instance K)."""
    doc: dict[str, Any] = {"schema": REFRESH_SCHEMA, "apply": apply, "source": os.fspath(SCRIPT_DIR), "runners": []}
    state = home / ".local/state/glaeda/cmux-runner"
    receipts = [state / "receipt.json", *sorted(state.glob("instance-*/receipt.json"))]
    if not any(path.is_file() for path in receipts):
        return doc
    history = hook_history()
    if history is None:
        return {**doc, "error": f"no {HOOK_HISTORY.name} beside this copy: only a release's copy refreshes hooks"}
    sources = hook_sources()
    doc["hookSha256"] = sha256_bytes(sources[HOOK_NAME][0])
    hold = functools.partial(sign_hold, home)
    _SIGN_HOLD_EVENTS.clear()
    with runner_lock(home, wait=False) as held:
        if not held:
            return {**doc, "error": "an --apply or --uninstall holds the runner lock; a later run refreshes"}
        waiting: list[tuple[int, Any, Path]] = []
        for path in receipts:
            try:
                receipt = json.loads(path.read_text())
            except FileNotFoundError:
                continue
            except (OSError, ValueError):
                doc["runners"].append({"receipt": os.fspath(path), "state": "skipped", "note": "unreadable receipt"})
                continue
            runner_dir = Path(str(receipt.get("runnerDir") or "")) if isinstance(receipt, dict) else Path()
            doc["runners"].append({"receipt": os.fspath(path),
                                   **refresh_hook_dir(runner_dir, receipt, apply, sources, history, hold)})
            if apply and doc["runners"][-1].get("note") == JOB_RUNNING:
                waiting.append((len(doc["runners"]) - 1, receipt, runner_dir))
        # a busy runner is swapped in the gap between its jobs, not only if a run happens to land in one
        deadline = time.monotonic() + REFRESH_GAP_WAIT_S
        while waiting and time.monotonic() < deadline:
            time.sleep(REFRESH_GAP_POLL_S)
            for item in list(waiting):
                index, receipt, runner_dir = item
                if worker_running(runner_dir):
                    continue
                entry = refresh_hook_dir(runner_dir, receipt, apply, sources, history, hold)
                doc["runners"][index] = {"receipt": doc["runners"][index]["receipt"], **entry}
                if entry.get("note") != JOB_RUNNING:
                    waiting.remove(item)
    if _SIGN_HOLD_EVENTS:
        doc["signHold"] = list(_SIGN_HOLD_EVENTS)
    return doc


# ---------------------------------------------------------------- output


def preflight(ctx: Context) -> dict[str, Any]:
    checks: dict[str, dict[str, Any]] = {}

    def check(name: str, ok: bool | None, value: object, note: str = "", blocking: bool = False) -> None:
        level = "ok" if ok else ("info" if ok is None else ("block" if blocking else "warn"))
        checks[name] = {"level": level, "value": value, "note": note if level != "ok" else ""}

    arch = platform.machine()
    check("appleSilicon", arch == "arm64" or not DARWIN_REQUIRED, arch, "the runner build is osx-arm64", True)
    # Never blocking here: the steps that need a token block themselves (register, deregister),
    # so an installed runner can be re-checked or re-applied on a mini with no gh.
    if ctx.gh:
        check("gh", True, f"{ctx.gh} (logged in)")
    elif ctx.token_stdin:
        check("gh", None, ctx.gh_state, "token from stdin; release read with curl, runner confirmed locally")
    else:
        check("gh", False, ctx.gh_state, "gh auth login as an admin, or pipe a token to --token-stdin")
    check("python", ctx.python is not None, ctx.python or "missing", "hooks need python3", True)
    if ctx.xcode_app:
        # cmux jobs pick Xcode by path (CMUX_CI_XCODE_APP*), not by xcode-select, so the path must exist
        # as a real directory: a symlinked Xcode breaks compilation-cache replay (swift#92545).
        app = Path(ctx.xcode_app)
        version = run(["/usr/bin/xcodebuild", "-version"], env={**os.environ, "DEVELOPER_DIR": os.fspath(
            app / "Contents/Developer")})[1].replace("\n", " ") if app.is_dir() and not app.is_symlink() else ""
        check("xcodeApp", bool(version) and "Build version" in version, version or f"{app} missing or a symlink",
              "cmux jobs routed here will fail; install that Xcode at exactly this path")
    copy = getattr(ctx, "copy", None)
    if copy is not None:
        own = copy.get("copy") or {}
        what = f"{own.get('via')} {own.get('source', '')[:12]} {own.get('date')}" if own else "unknown source"
        if copy["state"] == "stale":
            check("scriptCopy", False, f"older than release {copy['release']} ({what})",
                  f"run {copy['releaseScript']} instead, stage main (fleet runner relabel), or pass --allow-stale",
                  blocking=not ctx.allow_stale)
        else:
            check("scriptCopy", None, f"differs from release {copy['release']} ({what})", "not older; used as is")
    disk = which("glaeda-disk", (os.fspath(ctx.home / ".local/bin/glaeda-disk"),))
    check("glaedaDisk", disk is not None or None, disk or "not installed",
          "optional: glaeda-mini-setup --apply installs it; hooks skip disk pressure without it")
    return {"checks": checks, "blocking": sorted(n for n, c in checks.items() if c["level"] == "block")}


def render(ctx: Context, receipt: dict[str, Any]) -> str:
    mode = receipt["mode"]
    lines = [f"glaeda-cmux-runner: {mode.upper()}" + ("" if receipt["applied"] else " (nothing changed; add --apply to act)")]
    if ctx.sandbox:
        lines.append(f"  sandbox HOME {ctx.home}: launchctl is never called")
    lines.append(f"target: {ctx.scope_url}  name {ctx.name}  labels {','.join(ctx.labels)}")
    lines.append("preflight")
    for name, c in receipt["preflight"]["checks"].items():
        note = f"  ({c['note']})" if c["note"] else ""
        lines.append(f"  {c['level']:<5} {name:<13} {c['value']}{note}")
    lines.append("actions")
    for act in receipt["actions"]:
        target = act.get("label") or act.get("version") or act.get("name") or ctx.show(act.get("path", "")) or ""
        if act["kind"] == "download" and act.get("sha256"):
            target = f"v{act.get('version')} sha256:{act['sha256'][:12]}..."
        note = f"  ({act['note']})" if act.get("note") else ""
        lines.append(f"  {act['state']:<9} {act['kind']:<10} {target}{note}")
        for drift in act.get("drift") or []:
            lines.append(f"            label drift ({'GitHub' if drift['against'] == 'github' else 'receipt'}): "
                         f"registered labels differ from what this version would register: {drift_text(drift)}")
    copy = receipt.get("scriptCopy")
    if copy and copy.get("labelDrift"):
        lines.append(f"label drift (release {copy['release']}): the installed release would register "
                     f"{drift_text(copy['labelDrift'])} against this copy")
    elif copy and copy.get("releaseLabels") is None and copy["state"] == "stale":
        lines.append(f"label drift (release {copy['release']}): unknown; its plan did not run")
    if mode == "install":
        route = receipt["routing"]
        if route.get("note"):
            lines.append(f"routing: {route['note']}")
        if route["route"]:
            lines.append(f"route cmux jobs to this runner (printed only; run one at a time, {ctx.route_repo} admin):")
            lines.extend(f"  {c}" for c in route["route"])
            lines.append("rollback (jobs fall back to Blacksmith immediately):")
            lines.extend(f"  {c}" for c in route["rollback"])
    lines.append("ready: " + ("yes" if receipt["ready"] else "no, blocking: " + ", ".join(receipt["blocking"])))
    if receipt["applied"]:
        written = ctx.state / "uninstall-receipt.json" if mode == "uninstall" else ctx.receipt_path
        lines.append(f"receipt: {ctx.show(written)}")
    return "\n".join(lines)


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="glaeda-cmux-runner", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--apply", action="store_true", help="make the changes (default is plan only)")
    p.add_argument("--uninstall", action="store_true", help="deregister and remove what --apply installed")
    p.add_argument("--clear-dedicated-only", action="store_true",
                   help="remove this Mac's dedicatedOnly marker, so pool instances may be installed again (with --apply)")
    p.add_argument("--output", choices=("human", "json"), default="human")
    scope = p.add_mutually_exclusive_group()
    scope.add_argument("--repo", help=f"register to OWNER/REPO (default {DEFAULT_REPO})")
    scope.add_argument("--org", help="register to an organization instead")
    p.add_argument("--group", help="runner group (with --org)")
    p.add_argument("--labels", help=f"extra comma-separated labels beyond {','.join(BASE_LABELS)},{MINI_LABEL}")
    p.add_argument("--manifest", type=Path, help="fleet manifest (cmuxterm-hq build-fleet/mini-fleet.json); labels "
                   "come from --member's class, availability and present Xcodes instead of --labels")
    p.add_argument("--min-free-gib", type=float, help="job-started evicts below this much free disk, then admits the job with a warning "
                   "(default: the manifest's disk.min_free_gib with --manifest, else no floor)")
    p.add_argument("--member", help="this machine's key in the manifest's hosts table (default name <member>-glaeda)")
    p.add_argument("--name", help="runner name (default: <short hostname>-glaeda, plus -K for --instance K)")
    p.add_argument("--instance", type=int, default=0,
                   help="which of this mini's runners (0 keeps the original paths; K > 0 gets its own "
                        "~/actions-runner-glaeda-K, LaunchAgent, receipt and name <member>-glaeda-K)")
    p.add_argument("--gui-runner", action="store_true",
                   help="mark this explicitly managed runner as a GUI desktop session")
    p.add_argument("--gui-token", default="gui",
                   help="capacity ledger token for this runner's desktop session (default: gui)")
    p.add_argument("--capacity-units", type=int,
                   help="weighted capacity the job-started hook shares across this mini's runners "
                        "(default: the manifest class's capacityUnits with --manifest, else one job at a time)")
    p.add_argument("--capacity-dir", help="shared capacity ledger path (default: $GLAEDA_FLEET_CAPACITY_DIR or the fleet path)")
    p.add_argument("--dedicated", metavar="NAME",
                   help="install the member's runner.dedicated runner NAME (with --manifest and --member) instead of "
                        "a pool instance: its exact labels, scope and admission, ~/actions-runner-glaeda-NAME")
    p.add_argument("--replace", action="store_true", help="replace an existing runner with the same name")
    p.add_argument("--runner-dir", type=Path, help="install directory (default ~/actions-runner-glaeda)")
    p.add_argument("--runner-version", help="pin a runner version such as 2.328.0 (default: one this mini already "
                   "runs or has cached, else the latest; see resolve_release)")
    p.add_argument("--runner-sha256", help="pin the expected SHA-256 of the tarball")
    p.add_argument("--latest-runner-version", help="the latest release as the operator resolved it (the fleet "
                   "passes it once per apply); used only when this mini has no version to reuse")
    p.add_argument("--latest-runner-sha256", help="the osx-arm64 SHA-256 of --latest-runner-version")
    p.add_argument("--route-repo", default=DEFAULT_REPO, help="repository whose variables the printed routing commands set")
    p.add_argument("--gh", help="gh binary (default: PATH)")
    p.add_argument("--github-labels", metavar="LABELS",
                   help="the labels GitHub lists for this runner now (comma-separated), as glaeda-cmux-runner-fleet "
                        "read them with its admin gh; used when this machine's gh cannot read them itself")
    p.add_argument("--token-stdin", action="store_true",
                   help="with --apply, read the registration (or, with --uninstall, removal) token from stdin; "
                        "without --apply, plan that path")
    p.add_argument("--python", help="interpreter the job hooks run (default: python3 on PATH unless it is the "
                   "/usr/bin/python3 xcrun shim, else Homebrew's; HOOK_PYTHONS)")
    p.add_argument("--xcode-app", help="check the Xcode that routed jobs select (the value of the repo's "
                   "CMUX_CI_XCODE_APP_PR variable, such as /Applications/Xcode_26.6.app); a warning, never a block")
    p.add_argument("--skip-launchctl", action="store_true", help="write the plist but do not load or unload it")
    p.add_argument("--headless", action="store_true",
                   help="install a system LaunchDaemon as the runner user (for GUI-less hosts; requires passwordless sudo)")
    p.add_argument("--allow-stale", action="store_true",
                   help="apply from a copy older than the installed OTA release (default: that blocks)")
    p.add_argument("--refresh-hooks", action="store_true",
                   help="only bring every owned runner's glaeda-cmux-runner-hook and glaeda_reservation.py to "
                        "this copy's (plan; with --apply, install): glaeda-update's hook rollout")
    return p


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    args = parser().parse_args(argv)
    if args.refresh_hooks:  # file writes only, under this user's home: no launchd, GitHub or Darwin tool
        if args.uninstall:
            print("glaeda-cmux-runner: --refresh-hooks and --uninstall are exclusive", file=sys.stderr)
            return 2
        doc = refresh_hooks(Path.home(), args.apply)
        failed = bool(doc.get("error")) or any(r["state"] == "blocked" for r in doc["runners"])
        if args.output == "json":
            print(json.dumps(doc, sort_keys=True))
        else:
            if doc.get("error"):
                print(f"refused   {doc['error']}")
            for r in doc["runners"]:
                print(f"{r['state']:<9} {r.get('runnerDir') or r.get('receipt')}  {r.get('note') or ''}".rstrip())
        return 1 if failed else 0
    if DARWIN_REQUIRED and platform.system() != "Darwin":
        print("glaeda-cmux-runner: macOS only", file=sys.stderr)
        return 2
    if args.instance < 0 or args.instance > 63:
        print("glaeda-cmux-runner: --instance must be 0 to 63", file=sys.stderr)
        return 2
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", args.gui_token):
        print("glaeda-cmux-runner: --gui-token must be a simple capacity token name", file=sys.stderr)
        return 2
    if args.org and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*", args.org):
        print("glaeda-cmux-runner: --org must be an organization login", file=sys.stderr)
        return 2
    if args.repo and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+", args.repo):
        print("glaeda-cmux-runner: --repo must be OWNER/REPO", file=sys.stderr)
        return 2
    if args.runner_version is not None:
        args.runner_version = args.runner_version.removeprefix("v")
    for flag, value, pattern in (("--runner-version", args.runner_version, RUNNER_VERSION_RE),
                                 ("--latest-runner-version", args.latest_runner_version, RUNNER_VERSION_RE),
                                 ("--runner-sha256", args.runner_sha256, f"(sha256:)?{SHA256_RE}"),
                                 ("--latest-runner-sha256", args.latest_runner_sha256, f"(sha256:)?{SHA256_RE}")):
        if value is not None and not re.fullmatch(pattern, value.lower() if "sha" in flag else value):
            print(f"glaeda-cmux-runner: {flag} is not a usable value", file=sys.stderr)
            return 2
    if bool(args.latest_runner_version) != bool(args.latest_runner_sha256):
        print("glaeda-cmux-runner: --latest-runner-version and --latest-runner-sha256 go together", file=sys.stderr)
        return 2
    if args.manifest and args.labels:
        print("glaeda-cmux-runner: --labels and --manifest are exclusive; labels come from one source", file=sys.stderr)
        return 2
    if bool(args.manifest) != bool(args.member):
        print("glaeda-cmux-runner: --manifest and --member go together", file=sys.stderr)
        return 2
    if args.dedicated is not None and (not args.manifest or args.instance or args.headless or args.labels):
        print("glaeda-cmux-runner: --dedicated needs --manifest and --member, and takes no --instance, --headless or "
              "--labels", file=sys.stderr)
        return 2
    ctx = Context(args)
    if args.manifest and args.dedicated is not None:
        try:
            manifest = json.loads(args.manifest.expanduser().read_text())
        except (OSError, ValueError) as error:
            print(f"glaeda-cmux-runner: cannot read manifest: {type(error).__name__}", file=sys.stderr)
            return 2
        why = dedicated_context(ctx, args, manifest)
        if why:
            print(f"glaeda-cmux-runner: {why}", file=sys.stderr)
            return 2
        summary, _ = member_labels(manifest, args.member, [])
        ctx.dedicated_only = bool((summary or {}).get("dedicatedOnly"))
    elif args.manifest:
        try:
            manifest = json.loads(args.manifest.expanduser().read_text())
        except (OSError, ValueError) as error:
            print(f"glaeda-cmux-runner: cannot read manifest: {type(error).__name__}", file=sys.stderr)
            return 2
        early = load_receipt(ctx)
        member, why = member_labels(manifest, args.member,
                                    ((early or {}).get("registration") or {}).get("labels") or [])
        if member is None:
            print(f"glaeda-cmux-runner: {why}", file=sys.stderr)
            return 2
        if member.get("dedicatedOnly") and not args.uninstall:
            # DEDICATED_ONLY (glaeda_fleet_labels): no pool instance here; --uninstall still removes an old one
            print(f"glaeda-cmux-runner: {args.member} declares runner.dedicatedOnly: it runs only its runner.dedicated "
                  "runners (--dedicated NAME), no pool instance", file=sys.stderr)
            return 2
        ctx.member = member
        if not args.min_free_gib:
            ctx.min_free_gib = float(member.get("minFreeGib") or 0)
        if ctx.instance >= int(member.get("runners") or 1) + int(member.get("gatewayRunners") or 0):
            print(f"glaeda-cmux-runner: {args.member} is class {member['class']} with {member.get('runners')} "
                  f"runner(s) and {int(member.get('gatewayRunners') or 0)} gateway runner(s); instance {ctx.instance} "
                  "is beyond that", file=sys.stderr)
            return 2
        if not args.capacity_units:
            ctx.capacity_units = int(member.get("capacityUnits") or 0)
        ctx.fast_runner, ctx.gui_runner, ctx.session_runner = member_roles(member, ctx.instance)
        ctx.gateway_runner = gateway_instance(member, ctx.instance)
        gateway = ctx.gateway_runner
        dev = dev_compile_instance(member, ctx.instance)
        nightly = nightly_slot_instance(member, ctx.instance)
        is_root = (ctx.instance < int(member.get("canonicalRoots") or 1) and not ctx.gui_runner and not ctx.fast_runner
                   and not ctx.session_runner and not gateway)
        # The console gui runner carries the session label only on a mini without session runners (guiRunners 1). With
        # them it takes console jobs alone: it listens with one free core (an app-host shard's cost), and a 6-core
        # session job (generated files, action exports) taken there with less room would wait and, through its
        # admit.want marker, hold every runner on the mini. The session runners listen with room for one.
        console_session = int(member.get("guiRunners") or 0) <= 1
        roots = (member.get("gatewayPools", []) if gateway
                 else member.get("devPools", []) if dev
                 else member.get("nightlyPools", []) if nightly
                 else member.get("fastPools", []) if ctx.fast_runner
                 else [*member.get("guiPools", []), *(member.get("sessionPools", []) if console_session else [])]
                 if ctx.gui_runner
                 else member.get("sessionPools", []) if ctx.session_runner
                 else [*member.get("rootPools", []), *(member.get("sidePools", []) if member.get("rootsTakeSide") else [])]
                 if is_root else member.get("sidePools", []))
        # Dedicated roles leave out ordinary pool and iOS labels, so those jobs cannot take a DEV, GUI or fast
        # instance. The pool's live count includes only the root and side instances it can route to.
        own = ([label for label in member["labels"] if label not in member.get("pools", []) and label != IOS_SIM_JOB_LABEL]
               if dev or nightly or gateway or ctx.gui_runner or ctx.session_runner or ctx.fast_runner
               else member["labels"])
        ctx.labels = list(dict.fromkeys([*BASE_LABELS, *own, *roots]))
        ctx.labels_requested = True
        if not args.name:
            ctx.name = f"{args.member}-glaeda{ctx.suffix}"
        if is_root or nightly:
            # A static handle on this one runner, so no job ever writes a runner label: a root runner for cmux's
            # warm affinity (the picker reads which runner kept a warm build and names it in runs-on), and the
            # nightly slot for cmux's owned signing pick (scripts/ci/signing_runner.py), which offers only a runner
            # it can pin. Without it no slot was ever offered, and nightly signing always went to Blacksmith.
            ctx.labels.append(runner_label(ctx.name))
    if args.token_stdin and args.apply:  # a plan previews the stdin path but never reads a token
        token = sys.stdin.readline(4096).strip()
        if not re.fullmatch(TOKEN_RE, token):
            print("glaeda-cmux-runner: --token-stdin read no usable token", file=sys.stderr)
            return 2
        ctx.stdin_token = token
        del token
    if ctx.gh and run([ctx.gh, "auth", "status"])[0] != 0:
        ctx.gh, ctx.gh_state = None, "installed, not logged in"  # a logged-out gh is no gh
    # Every --apply and --uninstall holds the runner lock from its plan to its receipt (runner_lock).
    with runner_lock(ctx.home, wait=True) if args.apply else contextlib.nullcontext():
        why = dedicated_only_refusal(ctx, args)
        if why:
            print(f"glaeda-cmux-runner: {why}", file=sys.stderr)
            return 2
        if getattr(args, "clear_dedicated_only", False):
            print("glaeda-cmux-runner: " + ("removed the dedicatedOnly marker" if args.apply else
                                           "--clear-dedicated-only needs --apply; nothing changed"))
            return 0  # only the marker: installing is a separate, later --apply
        return install_or_uninstall(ctx, args, raw_argv)


def dedicated_only_refusal(ctx: Any, args: argparse.Namespace) -> str | None:
    """DEDICATED_ONLY under the runner lock (every --apply holds it), or None. A dedicated --apply on a dedicatedOnly
    member refuses while any pool instance is on this Mac, and otherwise writes the marker first; a pool --apply
    refuses while the marker is there, whatever manifest it read. Reviews of 611e013e and a1de21e4."""
    marker = ctx.home / ".local/state/glaeda/cmux-runner" / DEDICATED_ONLY_MARKER
    if not args.apply or args.uninstall:
        return None
    if getattr(args, "clear_dedicated_only", False):
        marker.unlink(missing_ok=True)
        return None
    if dedicated_of(ctx) is not None:
        if not getattr(ctx, "dedicated_only", False):
            return None
        left = pool_installs(ctx.home)
        if left:
            return (f"{args.member} declares runner.dedicatedOnly and still has pool instances ({', '.join(left)}): "
                    "retire them first (glaeda-cmux-runner-fleet, fleet runner heal)")
        marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        marker.write_text(json.dumps({"member": args.member, "dedicated": args.dedicated}) + "\n")
        return None
    try:
        present = marker.exists()
    except OSError:
        present = True  # unreadable: fail closed
    if present:
        return ("this Mac is dedicatedOnly (" + os.fspath(marker).replace(os.fspath(ctx.home), "~", 1) + "): no pool "
                "instance is installed here; --clear-dedicated-only --apply removes the marker deliberately")
    return None


def pool_installs(home: Path) -> list[str]:
    """Every pool instance this Mac has (a receipt under instance-N or the first install's, or a pool runner directory
    actions-runner-glaeda[-N]), as names. A dedicated runner (instance-dedicated-NAME, actions-runner-glaeda-NAME) is
    not one. Read-only. Enumerates with os.listdir, which raises on a directory it cannot read (a glob would skip it
    silently: review of a1de21e4), so an unreadable home or state counts as one and a dedicatedOnly member fails
    closed."""
    state = home / ".local/state/glaeda/cmux-runner"
    found: list[str] = []
    try:
        try:
            names = sorted(os.listdir(state))
        except FileNotFoundError:
            names = []
        for name in names:
            if name == "receipt.json" or re.fullmatch(r"instance-\d+", name):
                path = state / name if name == "receipt.json" else state / name / "receipt.json"
                if name != "receipt.json":
                    os.listdir(state / name)  # raises when it cannot be read
                try:
                    os.stat(path)
                    found.append(name if name == "receipt.json" else f"{name}/receipt.json")
                except FileNotFoundError:
                    pass
        found += [n for n in sorted(os.listdir(home)) if re.fullmatch(r"actions-runner-glaeda(?:-\d+)?", n)]
    except OSError as error:
        return [f"unreadable ({type(error).__name__})"]
    return found


def dedicated_context(ctx: Context, args: argparse.Namespace, manifest: Any) -> str | None:
    """Point ctx at the member's runner.dedicated entry args.dedicated: its own directory, launchd label, receipt,
    name, scope and exact labels. Why it cannot, or None."""
    try:
        entries, why = fleet_labels().dedicated_runners(manifest, args.member)
    except Exception as error:  # noqa: BLE001  (a label module without dedicated_runners: explain, never a traceback)
        return f"{LABELS_MODULE} beside this script cannot read runner.dedicated ({type(error).__name__})"
    if why:
        return why
    entry = next((e for e in entries if e["name"] == args.dedicated), None)
    if entry is None:
        return f"{args.member} declares no runner.dedicated named {args.dedicated}"
    name = entry["name"]
    ctx.dedicated = entry
    ctx.suffix = f"-{name}"
    ctx.label = f"{LABEL}.dedicated.{name}"
    ctx.runner_dir = (args.runner_dir or ctx.home / f"actions-runner-glaeda-{name}").expanduser().absolute()
    ctx.hook_dir = ctx.runner_dir / HOOK_DIR
    ctx.state = ctx.home / ".local/state/glaeda/cmux-runner" / f"instance-dedicated-{name}"  # refresh_hooks reads it
    ctx.receipt_path = ctx.state / "receipt.json"
    ctx.plist_path = ctx.service_plist_path = ctx.agents / f"{ctx.label}.plist"
    ctx.log_path = ctx.logs / f"glaeda-cmux-runner-{name}.log"
    ctx.name = args.name or f"{args.member}-glaeda-{name}"
    ctx.org, ctx.repo, ctx.group = entry["org"], entry["repo"], entry["group"]
    ctx.labels, ctx.labels_requested = list(entry["labels"]), True
    ctx.capacity_units = 0  # never in the mini's capacity ledger: its jobs are the builder's, admitted by its hook
    if not args.min_free_gib:
        # the entry's own floor (its builder's), else the member's disk.min_free_gib
        summary, _ = fleet_labels().member_labels(manifest, args.member, lambda app: True)
        ctx.min_free_gib = float(entry.get("minFreeGib") or (summary or {}).get("minFreeGib") or 0)
    return None


def dedicated_of(ctx: Any) -> dict[str, Any] | None:
    """ctx's runner.dedicated entry (--dedicated), or None for a pool instance."""
    entry = getattr(ctx, "dedicated", None)
    return entry if isinstance(entry, dict) else None


def dedicated_word(ctx: Context, word: str) -> str:
    """A runner.dedicated command word or env value: "~/" is this user's home, "{runnerDir}" the runner's directory,
    and a whole word "{python}" the hook's own interpreter (the one job-started.sh execs the hook with)."""
    if word == "{python}":  # glaeda_fleet_labels.PYTHON_WORD
        return ctx.python or "/usr/bin/python3"
    if word.startswith("~/"):
        word = os.fspath(ctx.home / word[2:])
    return word.replace("{runnerDir}", os.fspath(ctx.runner_dir))


def dedicated_env(ctx: Context) -> dict[str, str]:
    return {k: dedicated_word(ctx, v) for k, v in sorted(((dedicated_of(ctx) or {}).get("env") or {}).items())}


def watch_env(ctx: Context) -> dict[str, str]:
    """The watch loop's env: the entry's env, with a declared PATH folded into the workload PATH (runner_path), never
    replacing it."""
    env = dedicated_env(ctx)
    return {**env, "PATH": runner_path(ctx.home, env.get("PATH", ""))}


def watch_label(ctx: Context) -> str:
    return f"{ctx.label}.watch"


def watch_plist_path(ctx: Context) -> Path | None:
    """The dedicated runner's watch LaunchAgent (its builder's own loop), or None when it declares no watch."""
    return ctx.agents / f"{watch_label(ctx)}.plist" if (dedicated_of(ctx) or {}).get("watch") else None


def watch_plist(ctx: Context) -> dict[str, Any]:
    return {"Label": watch_label(ctx),
            "ProgramArguments": [dedicated_word(ctx, w) for w in ctx.dedicated["watch"]],
            "WorkingDirectory": os.fspath(ctx.runner_dir), "RunAtLoad": True, "KeepAlive": True,
            "ThrottleInterval": 10, "ProcessType": "Interactive",
            "EnvironmentVariables": watch_env(ctx),
            "StandardOutPath": os.fspath(ctx.logs / f"glaeda-cmux-runner-{ctx.dedicated['name']}.watch.log"),
            "StandardErrorPath": os.fspath(ctx.logs / f"glaeda-cmux-runner-{ctx.dedicated['name']}.watch.err")}


def bootout_watch(ctx: Context, label: str, wait_s: float = 15.0) -> bool:
    """Unload a watch agent; True once launchd no longer has it (print exits LAUNCHCTL_NOT_FOUND), as bootout does
    for the runner. False: still loaded, or launchctl could not tell, and its plist must stay so a re-run retries."""
    domain = f"gui/{ctx.uid}/{label}"
    run([LAUNCHCTL, "bootout", domain])
    deadline = time.monotonic() + wait_s
    while run([LAUNCHCTL, "print", domain])[0] != LAUNCHCTL_NOT_FOUND:
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)
    return True


def restart_watch(ctx: Context, act: dict[str, Any]) -> None:
    """Load the watch agent's plist (after watch_unloaded). The watch loop holds no job, so it is never waited for."""
    domain = f"gui/{ctx.uid}"
    code, out = run([LAUNCHCTL, "bootstrap", domain, act["path"]])
    act["bootstrapped"] = code == 0
    if code != 0:
        act["state"], act["note"] = "failed", ("launchctl bootstrap failed: " + out)[:400]


# LAN_RELAY (glaeda_fleet_labels.lan_relay): a dedicated entry's lanRelay is <agent label>.relay, a socket-activated
# LaunchAgent. launchd owns a Unix socket in a directory only this user can enter (0700, the socket 0600), and for each
# connection starts Apple's /usr/bin/nc to the entry's one address and port with the connection as its stdin and stdout
# (inetdCompatibility). launchd starts nc directly, so it has no non-Apple ancestor and Local Network privacy lets it
# through; a job connects to the socket (`ssh -o ProxyCommand='/usr/bin/nc -U SOCKET'`), and a Unix socket is not the
# LAN. Nothing the job sends picks the destination, and the relay holds no key. Each connection ends at either side's
# EOF, after LAN_RELAY_CONNECT_S without a connect, or after LAN_RELAY_IDLE_S with no byte either way (nc -w).
LAN_RELAY_DIR = ".local/state/glaeda/lan-relay"  # under HOME; the socket is <entry name>.sock
LAN_RELAY_NC = "/usr/bin/nc"
LAN_RELAY_CONNECT_S = 5
LAN_RELAY_IDLE_S = 900  # an ssh session quiet this long is closed; ssh's ServerAliveInterval keeps a live one open
SOCKET_PATH_MAX = 103  # sockaddr_un.sun_path on macOS is 104 bytes with its NUL


def relay_of(ctx: Any) -> str | None:
    return (dedicated_of(ctx) or {}).get("lanRelay")


def relay_label(ctx: Context) -> str:
    return f"{ctx.label}.relay"


def relay_socket(ctx: Context) -> Path:
    return ctx.home / LAN_RELAY_DIR / f"{ctx.dedicated['name']}.sock"


def relay_plist_path(ctx: Context) -> Path | None:
    """The dedicated runner's LAN relay LaunchAgent, or None when its entry declares no lanRelay."""
    return ctx.agents / f"{relay_label(ctx)}.plist" if relay_of(ctx) else None


def relay_plist(ctx: Context) -> dict[str, Any]:
    address, port = relay_of(ctx).rsplit(":", 1)
    return {"Label": relay_label(ctx),
            "ProgramArguments": [LAN_RELAY_NC, "-G", str(LAN_RELAY_CONNECT_S), "-w", str(LAN_RELAY_IDLE_S),
                                 address, port],
            "inetdCompatibility": {"Wait": False},
            "Sockets": {"Listener": {"SockPathName": os.fspath(relay_socket(ctx)), "SockPathMode": 0o600,
                                     "SockType": "stream"}},
            "ProcessType": "Interactive",
            "StandardErrorPath": os.fspath(ctx.logs / f"glaeda-cmux-runner-{ctx.dedicated['name']}.relay.err")}


def prepare_relay_dir(ctx: Context) -> str | None:
    """Make the socket's directory this user's own, mode 0700, before launchd binds the socket; why it cannot, or
    None. A symlink or a directory another user owns is refused, never repaired."""
    path = relay_socket(ctx)
    if len(os.fsencode(path)) > SOCKET_PATH_MAX:
        return f"the relay socket path {path} is longer than a Unix socket path may be"
    try:
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        info = path.parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            return f"{path.parent} is not a directory this user owns"
        os.chmod(path.parent, 0o700)
        with contextlib.suppress(FileNotFoundError):
            if stat.S_ISSOCK(path.lstat().st_mode):
                path.unlink()  # a socket a booted-out relay left: launchd binds a fresh one
    except OSError as error:
        return f"cannot prepare {path.parent}: {error}"
    return None


def remove_relay_socket(ctx: Context, act: dict[str, Any]) -> None:
    """After the relay agent is gone: the socket file launchd may leave behind (only a socket, never anything else).
    The path is the one the receipt recorded (an uninstall by receipt has no manifest entry), else the label's name;
    only a path in this user's LAN_RELAY_DIR is touched."""
    label = str(act.get("label") or "")
    name = label[len(f"{LABEL}.dedicated."):-len(".relay")] if label.startswith(f"{LABEL}.dedicated.") else ""
    path = Path(str(act.get("socket") or (ctx.home / LAN_RELAY_DIR / f"{name}.sock")))
    if not name and not act.get("socket") or path.parent != ctx.home / LAN_RELAY_DIR:
        return
    with contextlib.suppress(OSError):
        if stat.S_ISSOCK(path.lstat().st_mode):
            path.unlink()


# COMPANIONS: the LaunchAgents a dedicated runner may have beside its runner agent, by receipt kind: its builder's watch
# loop and its LAN relay. Each is planned, (re)loaded and removed the same way.
COMPANIONS = ("watch", "relay")


def companion_paths(ctx: Context) -> dict[Path, tuple[str, str]]:
    """{plist path: (kind, label)} for the companions this install declares."""
    pairs = (("watch", watch_plist_path(ctx), watch_label), ("relay", relay_plist_path(ctx), relay_label))
    return {path: (kind, label(ctx)) for kind, path, label in pairs if path is not None}


ROLE_KEEP_MARKER = ".glaeda-keep.json"  # glaeda-disk ROLE_KEEP_MARKER: the warm state it keeps by role


def keep_role_paths(ctx: Context) -> None:
    """Write the dedicated entry's keep paths, expanded, to <runner>/ROLE_KEEP_MARKER (glaeda-disk role_keep reads
    it); an entry with none removes the marker."""
    marker = ctx.runner_dir / ROLE_KEEP_MARKER
    keep = [dedicated_word(ctx, k) for k in (dedicated_of(ctx) or {}).get("keep") or []]
    if not keep:
        marker.unlink(missing_ok=True)
        return
    data = (json.dumps(keep, indent=1) + "\n").encode()
    with contextlib.suppress(OSError):
        if marker.read_bytes() == data:
            return
    write_atomic(marker, data, 0o644, make_parent=False)


def keep_runner_env(ctx: Context, write: bool = True) -> bool:
    """Set the dedicated runner's declared env in its .env (config.sh writes the file; the runner reads it at start),
    keeping every other line. A declared PATH goes to .path instead (the jobs' PATH), merged as runner_path does.
    True when .env or .path differs from what it should be (write=False only tells, writing nothing)."""
    env = dedicated_env(ctx)
    path = ctx.runner_dir / ".env"
    if not (ctx.runner_dir / ".runner").is_file():
        return False
    changed = False
    # what this install wrote before: the .env keys, and the .path entries its declared PATH added (a key or an
    # entry the manifest drops goes too). An older marker is a plain list of keys.
    marker = ctx.runner_dir / DEDICATED_ENV_KEYS
    try:
        doc = json.loads(marker.read_text())
    except (OSError, ValueError, TypeError):
        doc = []
    doc = doc if isinstance(doc, dict) else {"keys": doc if isinstance(doc, list) else []}
    previous = {str(k) for k in doc.get("keys") or []}
    previous_path = [str(e) for e in doc.get("path") or []]
    declared = [e for e in env.pop("PATH", "").split(":") if e]
    current = read_runner_path(ctx.runner_dir)
    kept_path = [e for e in current.split(":") if e and (e not in previous_path or e in declared)]
    base = runner_path(ctx.home)  # what every runner's .path has anyway: never owned, never removed
    owned_path = [e for e in declared if e not in base.split(":") and (e not in kept_path or e in previous_path)]
    if declared or previous_path:
        merged = runner_path(ctx.home, ":".join(declared), ":".join(kept_path))
        if merged != current:
            changed = True
            if write:
                write_atomic(ctx.runner_dir / ".path", (merged + "\n").encode("utf-8", "surrogateescape"), 0o644,
                             make_parent=False)
    try:
        lines = path.read_text().splitlines()
    except OSError:
        lines = []
    kept = [line for line in lines if line.split("=", 1)[0] not in env and line.split("=", 1)[0] not in previous]
    want = "\n".join([*kept, *(f"{k}={v}" for k, v in env.items())]) + "\n"
    if want != ("\n".join(lines) + "\n" if lines else ""):
        changed = True
        if write:
            write_atomic(path, want.encode(), 0o644, make_parent=False)
    if write:
        write_atomic(marker, json.dumps({"keys": sorted(env), "path": owned_path}).encode(), 0o644, make_parent=False)
        keep_role_paths(ctx)
    return changed


def dev_compile_instance(member: dict[str, Any], instance: int) -> bool:
    """DEV uses the first existing side instance; every neighbor keeps its normal job admission and labels.
    Derive the index from canonicalRoots too when restoring an older member receipt."""
    return bool(member.get("devCompile")) and instance == int(member.get("canonicalRoots") or 1)


def nightly_slot_instance(member: dict[str, Any], instance: int) -> bool:
    """The nightly slot (runner.nightlySlot) is the next side instance after canonicalRoots, after the freshness
    slot when the member has one; like it, it reuses an instance and its neighbors keep their labels and hooks."""
    if not member.get("nightlySlot"):
        return False
    at = member.get("nightlyInstance")
    if not isinstance(at, int) or isinstance(at, bool):
        at = int(member.get("canonicalRoots") or 1) + int(bool(member.get("devCompile")))
    return instance == at


def gateway_instance(member: dict[str, Any], instance: int) -> bool:
    """A gateway runner (gatewayRunners): one of the instances after the member's `runners` pool instances. It carries
    only the gateway label and admits only thin cmux-ci client jobs (glaeda-cmux-runner-hook --gateway-runner).
    The hook's two gateway tokens cap them at MAX_GATEWAY_RUNNERS whatever a receipt says."""
    runners_n = int(member.get("runners") or 1)
    gateway_n = min(int(member.get("gatewayRunners") or 0), int(getattr(fleet_labels(), "MAX_GATEWAY_RUNNERS", 0)))
    return runners_n <= instance < runners_n + gateway_n


def member_roles(member: dict[str, Any], instance: int) -> tuple[bool, bool, bool]:
    """(fast runner, gui runner, session runner) for this instance of a member. The last instance is the fast
    runner when fastRunners is 1, and the guiRunners instances before it are gui-role runners: the last of them is
    the console gui runner (the gui and session pool labels), and any others are session runners (only the session
    pool label). None carries a root or side label. A gateway instance (past `runners`) has none of these roles."""
    runners_n = int(member.get("runners") or 1)
    if instance >= runners_n:
        return False, False, False
    fast_n, gui_n = int(member.get("fastRunners") or 0), int(member.get("guiRunners") or 0)
    fast = fast_n > 0 and instance >= runners_n - fast_n
    gui_role = gui_n > 0 and not fast and instance >= runners_n - fast_n - gui_n
    console = gui_role and instance == runners_n - fast_n - 1
    return fast, console, gui_role and not console


def install_or_uninstall(ctx: Context, args: argparse.Namespace, raw_argv: list[str]) -> int:
    prior = load_receipt(ctx)
    if isinstance(prior, dict) and prior.get("headless") and not ctx.sandbox:
        # Uninstall and plain re-apply must address the same system service even
        # when the operator omits --headless on the follow-up command.
        ctx.headless = True
        ctx.service_plist_path = SYSTEM_DAEMON_DIR / f"{ctx.label}.plist"
    if args.uninstall and prior:
        # Uninstall acts only on what the receipt recorded; flags cannot point it elsewhere.
        if prior.get("runnerDir"):
            ctx.runner_dir = Path(prior["runnerDir"])
            ctx.hook_dir = ctx.runner_dir / HOOK_DIR
        reg = prior.get("registration") or {}
        if reg.get("name"):
            ctx.name = reg["name"]
        if reg.get("scope"):
            ctx.org, ctx.repo = (reg["scope"], None) if reg.get("org") else (None, reg["scope"])
        elif not reg and owned_dir(ctx, prior):
            # an interrupted --apply registered without recording it: .runner says where
            local = local_runner(ctx) or {}
            scope = re.fullmatch(r"https://github\.com/([A-Za-z0-9-]+)(?:/([A-Za-z0-9._-]+))?/?",
                                 str(local.get("gitHubUrl") or ""))
            if local.get("agentName") and scope:
                ctx.name = str(local["agentName"])
                ctx.org, ctx.repo = (None, f"{scope[1]}/{scope[2]}") if scope[2] else (scope[1], None)
            elif local:
                ctx.unreadable_registration = True
        if ctx.headless:
            ctx.service_plist_path = SYSTEM_DAEMON_DIR / f"{ctx.label}.plist"
    if not args.uninstall and owned_dir(ctx, prior):
        registered = (prior or {}).get("registration") or {}
        kept = (prior or {}).get("member")
        if ctx.member is None and isinstance(kept, dict) and kept.get("hardware"):
            # a plain re-run keeps the member's gate, capacity and disk floor, not just its labels
            ctx.member = kept
            if not args.capacity_units:
                ctx.capacity_units = int(kept.get("capacityUnits") or 0)
            if not args.min_free_gib and dedicated_of(ctx) is None:
                ctx.min_free_gib = float(kept.get("minFreeGib") or 0)
            # and its role: the fast runner's and the gui runner's hooks stay theirs
            fast, gui, session = member_roles(kept, ctx.instance)
            ctx.fast_runner, ctx.session_runner = fast, session
            ctx.gateway_runner = gateway_instance(kept, ctx.instance)
            ctx.gui_runner = not fast and not session and (ctx.gui_runner or gui)
        # a re-run that names nothing keeps what this install registered, not the hostname default
        if not ctx.labels_requested and isinstance(registered.get("labels"), list) and registered["labels"]:
            ctx.labels = registered["labels"]
        if not args.name and not args.member and registered.get("name"):
            ctx.name = registered["name"]
    ctx.allow_stale = args.allow_stale
    ctx.copy = None if args.uninstall else copy_check(ctx)
    if ctx.copy is not None and ctx.copy["state"] == "stale":
        labels = release_plan_labels(ctx.copy["releaseScriptPath"], raw_argv)
        ctx.copy["releaseLabels"] = labels
        if labels is not None:
            ctx.copy["labelDrift"] = label_drift("release", ctx.labels, labels)
    pre = preflight(ctx)
    doc: dict[str, Any] = {
        "schema": SCHEMA,
        "mode": "uninstall" if args.uninstall else "install",
        "applied": args.apply,
        "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
        "sandboxHome": ctx.sandbox,
        "headless": ctx.headless,
        "runnerDir": os.fspath(ctx.runner_dir),
        "installId": (prior or {}).get("installId") if owned_dir(ctx, prior) else secrets.token_hex(16),
        "runnerDirOwned": owned_dir(ctx, prior),
        "runnerVersion": (prior or {}).get("runnerVersion") if owned_dir(ctx, prior) else None,
        "runnerSha256": (prior or {}).get("runnerSha256") if owned_dir(ctx, prior) else None,
        "registration": (prior or {}).get("registration") if owned_dir(ctx, prior) else None,
        "preflight": pre,
        "member": ctx.member or ((prior or {}).get("member") if owned_dir(ctx, prior) else None),
    }
    if ctx.dedicated:
        doc["dedicated"] = ctx.dedicated
    if ctx.copy is not None:
        doc["scriptCopy"] = {k: v for k, v in ctx.copy.items() if k != "releaseScriptPath"}
    if args.uninstall:
        actions = plan_uninstall(ctx, prior)
        if ctx.gh is None and not ctx.token_stdin and \
                any(a["kind"] == "deregister" and a["state"] == "remove" for a in actions):
            for act in actions:  # removing the agent or directory without deregistering strands the runner
                if act["state"] == "remove":
                    act["state"], act["note"] = "blocked", "deregistering needs gh as an admin, or --token-stdin"
        if args.apply:
            apply_uninstall(ctx, actions)
    else:
        actions = plan_install(ctx, prior)
        if args.apply and pre["blocking"]:
            for act in actions:
                if act["state"] in {"create", "update", "relabel"}:
                    act["state"], act["note"] = "blocked", "preflight blocks: " + ", ".join(pre["blocking"])
        if args.apply:
            apply_install(ctx, actions, doc)
        doc["routing"] = routing(ctx)
    doc["actions"] = actions
    doc["blocking"] = ([] if args.uninstall else pre["blocking"]) + [f"{a['kind']}:{a.get('path') or a.get('name') or ''}".rstrip(":")
                                         for a in actions if a.get("state") in {"blocked", "failed"}]
    doc["ready"] = not doc["blocking"]
    failed = any(a.get("state") == "failed" for a in actions)
    if args.apply:
        ctx.state.mkdir(parents=True, exist_ok=True, mode=0o700)
        data = (json.dumps(doc, indent=2, sort_keys=True) + "\n").encode()
        if args.uninstall:
            write_atomic(ctx.state / "uninstall-receipt.json", data, 0o600)
            if prior is not None and doc["ready"]:  # a blocked or failed uninstall keeps the receipt for a re-run
                os.replace(ctx.receipt_path, ctx.state / "receipt.uninstalled.json")
        elif receipt_conflict(ctx, prior) is None and (doc["runnerDirOwned"] or any(a.get("owned") for a in actions)):
            write_atomic(ctx.receipt_path, data, 0o600)
    if args.output == "json":
        print(json.dumps(doc, indent=2, sort_keys=True))
    else:
        print(render(ctx, doc))
    return 1 if failed or (args.apply and not doc["ready"]) else 0


if __name__ == "__main__":
    raise SystemExit(main())
