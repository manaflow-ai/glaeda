#!/usr/bin/env python3
"""glaeda-cmux-runner-fleet: bring every fleet mini's GitHub runners to what the manifest says, in parallel.

    glaeda-cmux-runner-fleet                        plan: which members are eligible and how many runners each gets
    glaeda-cmux-runner-fleet --apply                stage the scripts and apply every instance on every eligible member
    glaeda-cmux-runner-fleet --apply --hosts a,b    only these members, each on the manifest's runner.org/group
    glaeda-cmux-runner-fleet --apply --include-ineligible --skip-launchctl
                                                    install on members that do not pass the gate yet, left stopped
    glaeda-cmux-runner-fleet --apply --org manaflow-ai --group glaeda-minis --migrate-from-repo manaflow-ai/cmux
                                                    move every member from repo to org scope, one member at a time
    glaeda-cmux-runner-fleet --apply --hosts a --allow-downgrade "roll back #1384"
                                                    deploy although the guard below refuses, with the reason recorded

Scope. With no --org or --repo, each member's pool instances register where the manifest says: runner.org and
runner.group (defaults, or the host's overrides; a trusted-only member stays on runner.trustedRepo), or
manaflow-ai/cmux when the manifest names neither. So a re-apply keeps the scope the pools have, with no flags.
--org/--group or --repo, when passed, apply to every chosen member instead.

Org scope (--org, --group) lets every repository the runner group allows use the pools; the hook then admits
any repository of that org and costs other repositories as guests (glaeda-cmux-runner-hook job_class). A member
with a trusted-only runner (runner.trustedRepo) stays on its repository and is skipped. --migrate-from-repo
first deregisters each instance's repo-scoped runner (a remove token for that repo, over stdin), then registers
it at org scope; it runs one member at a time so the others keep serving the old scope's jobs meanwhile, and the
group must already allow that repository.

Run from an operator machine with gh logged in as an admin of --repo and SSH to every member. The members are
the manifest's hosts with the ci-runner role in a runner class (glaeda_fleet_labels.member_labels); each gets
runner.classes.<class>.runners instances of glaeda-cmux-runner (docs/CMUX_MINI_RUNNER.md 2d).

Every member runs at once, and so does every instance on a member. First the member's own job-started gate
runs read-only (`glaeda-cmux-runner-hook check`, sent over SSH on stdin, so the plan changes nothing on the
mini); a member that is not eligible is skipped, so a mini joins the pools on the first run after it is
onboarded and never takes jobs only to refuse them. Then --apply copies this checkout's glaeda-cmux-runner,
its hook and their two modules into ~/glaeda-runner/scripts, with a .glaeda-source.json stamp naming the
commit and its date (glaeda-cmux-runner blocks a copy older than the mini's OTA release; glaeda-update
refreshes one), and a manifest trimmed to that member (its own
entry and the xcode, disk and runner defaults: never other hosts, keys or people), mints one registration token
per scope here (reused for its hour) and pipes it over SSH (never an argv or a file), and applies --instance K
for every K.
The gate checks the manifest's first Xcode for the member; if that app is missing there, the member reads as
not eligible even when a later one would do (safe side). A member that SSH cannot reach is "unreachable", which
fails an --apply run. Nothing here routes a job: pool variables stay with whoever owns routing.

Runner release. The minis share one public IP, so they must not each ask GitHub's unauthenticated API for the
latest actions/runner. The first instance that applies reads "latest" here, once per run, through this
machine's gh, and every instance gets it as --latest-runner-version/--latest-runner-sha256 (the pinned
fallback in glaeda-cmux-runner when the read fails). A mini uses it only when it has no version to reuse: one an
instance there already runs, or a tarball in its runner cache (glaeda-cmux-runner resolve_release).

Downgrade guard. Before anything is staged, the run compares this checkout's HEAD with origin's main as origin
reports it now (git ls-remote: nothing is fetched or written here, and an old checkout's own stale origin/main
ref cannot vouch for it), and reads every target member's .glaeda-source.json over SSH. --apply refuses,
changing nothing on any member, when HEAD is not origin's main (or either cannot be read), or when a member's
stamped commit is not an ancestor of HEAD: a downgrade, or a deploy from a branch HEAD does not contain. It also
refuses when the staged files or this tool have uncommitted changes, or are marked assume-unchanged or
skip-worktree (edits git status cannot see). A run from origin's main replaces a member's still-active canary.
A member with no stamp, or one that cannot be read, is
not a downgrade; the output says so. A member whose stamp records allowDowngrade was deployed off main on
purpose (a canary of a PR that then squash-merged), so a run from origin's main rolls it forward instead of
refusing. --allow-downgrade REASON overrides every refusal; the reason is printed and recorded in each staged
stamp (allowDowngrade). The stamp names the HEAD the guard checked. A copy outside a git checkout (an OTA
release) has no HEAD to check, so it needs --allow-downgrade. A shallow checkout fails closed: an older stamp
beyond its history reads as not an ancestor; fetch the full history. A plan reports the same findings and does
not fail.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import errno
import functools
import importlib.machinery
import importlib.util
import json
import os
import re
import resource
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
import urllib.parse
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
STAGED = ("glaeda-cmux-runner", "glaeda-cmux-runner-hook", "glaeda_fleet_labels.py", "glaeda_reservation.py",
          "glaeda-promotion-admit", "glaeda-capture-admit", "glaeda-nightly-only-admit")
# HQ's nightly promotion lease runs ~/.local/bin/glaeda-promotion-admit over ssh: every stage installs the staged copy
# there (a temp file renamed into place, so a running request never reads a half-written file)
PROMOTION_ADMIT = "glaeda-promotion-admit"
REMOTE_DIR = "glaeda-runner"
SOURCE_STAMP = ".glaeda-source.json"  # glaeda-cmux-runner script_source reads it
DEFAULT_REPO = "manaflow-ai/cmux"
DEFAULT_MANIFEST = Path.home() / ".config/glaeda/mini-fleet.json"
WORKLOAD_PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
TRIMMED_DEFAULTS = ("xcode", "disk", "runner", "ios_simulator")
SSH_OPTIONS = ["-o", "ConnectTimeout=10", "-o", "BatchMode=yes"]
CHECK_TIMEOUT_S = 90
APPLY_TIMEOUT_S = 2700  # above the remote worst case (download, unpack, config.sh), so a slow install is never raced by a re-run
TOKEN_RE = re.compile(r"[A-Za-z0-9_.\-]+")
SHA_RE = re.compile(r"[0-9a-f]{7,40}")
STAMP_READ = f"head -c 4096 ~/{REMOTE_DIR}/scripts/{SOURCE_STAMP} 2>/dev/null || echo @no-stamp"  # read-only
MAX_REASON = 200
HOST_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


def load_labels() -> Any:
    path = SCRIPT_DIR / "glaeda_fleet_labels.py"
    loader = importlib.machinery.SourceFileLoader("glaeda_fleet_labels", os.fspath(path))
    spec = importlib.util.spec_from_loader("glaeda_fleet_labels", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


@functools.cache
def load_runner() -> Any:
    """glaeda-cmux-runner beside this script, as a module: its release parsing and pinned fallback."""
    path = SCRIPT_DIR / "glaeda-cmux-runner"
    loader = importlib.machinery.SourceFileLoader("glaeda_cmux_runner_for_fleet", os.fspath(path))
    spec = importlib.util.spec_from_loader("glaeda_cmux_runner_for_fleet", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# Members and their instances run at once, so a big rollout would start hundreds of ssh and scp children together,
# each holding pipes. One semaphore bounds the children across the whole run, sized from the open-file limit, so an
# operator Mac with a low limit does not fail launches with EMFILE (2026-11-01: "[Errno 24] Too many open files").
MAX_PROCS_ENV = "GLAEDA_FLEET_MAX_PROCS"
MAX_PROCS_RANGE = (4, 128)
NOFILE_TARGET = 10240  # macOS refuses a soft limit above OPEN_MAX even when the hard limit is unlimited
EMFILE_BACKOFF_S = 2.0
_PROCS: threading.BoundedSemaphore | None = None


def raise_nofile() -> int:
    """Raise the soft open-file limit toward the hard one; return the soft limit in force."""
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    want = NOFILE_TARGET if hard == resource.RLIM_INFINITY else min(hard, NOFILE_TARGET)
    if soft != resource.RLIM_INFINITY and soft < want:
        try:
            resource.setrlimit(resource.RLIMIT_NOFILE, (want, hard))
            soft = want
        except (OSError, ValueError):
            pass
    return NOFILE_TARGET if soft == resource.RLIM_INFINITY else soft


def max_procs(nofile: int, override: int | None = None) -> int:
    """Children at once: an explicit override, else an eighth of the open-file limit, clamped."""
    if override is not None:
        return max(1, override)
    low, high = MAX_PROCS_RANGE
    return max(low, min(high, nofile // 8))


def set_max_procs(limit: int) -> None:
    global _PROCS
    _PROCS = threading.BoundedSemaphore(max(1, limit))


def _launch(argv: list[str], timeout: float, stdin: str | None) -> subprocess.CompletedProcess:
    if _PROCS is None:
        set_max_procs(max_procs(raise_nofile()))
    with _PROCS:  # type: ignore[union-attr]
        return subprocess.run(argv, input=stdin if stdin is not None else "", capture_output=True, text=True,
                              timeout=timeout, check=False)


def run(argv: list[str], timeout: float, stdin: str | None = None) -> tuple[int, str, str]:
    for attempt in (0, 1):
        try:
            out = _launch(argv, timeout, stdin)
        except subprocess.TimeoutExpired:
            return 124, "", f"timed out after {timeout:g}s"
        except OSError as error:
            if attempt == 0 and error.errno in (errno.EMFILE, errno.ENFILE):
                time.sleep(EMFILE_BACKOFF_S)  # the launch never started; another child's pipes free up meanwhile
                continue
            return 127, "", str(error)
        return out.returncode, out.stdout, out.stderr
    raise AssertionError("unreachable")


def members(manifest: dict[str, Any], labels: Any, only: list[str] | None,
            exclude: list[str]) -> tuple[dict[str, dict[str, Any]], dict[str, str]]:
    """({member: summary} that take runners, {member: why not}) for the manifest's hosts (or only these)."""
    hosts = manifest.get("hosts") if isinstance(manifest.get("hosts"), dict) else {}
    chosen, skipped = {}, {}
    for name in only or sorted(hosts):
        if name in exclude:
            continue
        if not HOST_RE.fullmatch(name):
            skipped[name] = "not a usable host name"
            continue
        summary, why = labels.member_labels(manifest, name, lambda app: True)
        if summary is None:
            skipped[name] = why or "not a runner member"
        else:
            chosen[name] = summary
    return chosen, skipped


def trimmed(manifest: dict[str, Any], member: str) -> dict[str, Any]:
    defaults = manifest.get("defaults") if isinstance(manifest.get("defaults"), dict) else {}
    return {"defaults": {k: defaults[k] for k in TRIMMED_DEFAULTS if k in defaults},
            "hosts": {member: manifest["hosts"][member]}}


def check(member: str, summary: dict[str, Any]) -> tuple[bool | None, str]:
    """The member's own gate, read-only: the hook runs from stdin with the workload PATH. (True, line) when
    eligible, (False, line) when the hook refused, (None, why) when the member could not be asked."""
    argv = ["python3", "-", "check", "--fleet-class", summary["hardware"]]
    if summary.get("xcodeApps"):
        argv += ["--toolchain-xcode", summary["xcodeApps"][0]]
    remote = f"PATH={WORKLOAD_PATH} /usr/bin/" + " ".join(_quote(a) for a in argv)
    code, out, err = run(["ssh", *SSH_OPTIONS, member, remote], CHECK_TIMEOUT_S,
                         stdin=(SCRIPT_DIR / "glaeda-cmux-runner-hook").read_text())
    line = (out.strip().splitlines() or [err.strip() or f"ssh exited {code}"])[-1]
    if code not in (0, 1) or not line.startswith("glaeda-cmux-runner-hook: "):
        return None, f"unreachable (exit {code}): {(err.strip() or line)[-200:]}"
    return code == 0, line.removeprefix("glaeda-cmux-runner-hook: ")


def _quote(text: str) -> str:
    return text if re.fullmatch(r"[A-Za-z0-9_./:=,+-]+", text) else "'" + text.replace("'", "'\\''") + "'"


def scope_api(repo: str | None, org: str | None) -> str:
    return f"orgs/{org}" if org else f"repos/{repo}"


_RELEASE_LOCK = threading.Lock()
_RELEASE: list[tuple[str, str, str]] = []


def latest_release() -> tuple[str, str, str]:
    """(version, osx-arm64 SHA-256, where from): the actions/runner release a mini installs when it has no
    version of its own to reuse. Read at most once per run, through this operator's logged-in gh (the minis
    share one public IP, and 60 unauthenticated reads an hour run out across a fleet apply); the pinned
    fallback in glaeda-cmux-runner when that read fails. Every instance gets the answer on its command line."""
    with _RELEASE_LOCK:
        if not _RELEASE:
            runner = load_runner()  # main() loaded it once already, so this cannot fail here
            code, out, _ = run(["gh", "api", f"{runner.RUNNER_RELEASE_API}/latest"], 60)
            try:
                found = runner.release_from_doc(json.loads(out)) if code == 0 else {"state": "blocked"}
            except ValueError:
                found = {"state": "blocked"}
            if found.get("state") == "ok":
                _RELEASE.append((found["version"], found["sha256"], "latest"))
            else:
                _RELEASE.append((runner.PINNED_RUNNER_VERSION, runner.PINNED_RUNNER_SHA256, "pinned"))
        return _RELEASE[0]


# GitHub's registration and remove tokens last one hour and register or remove any number of runners in that
# hour, so a run mints each (scope, kind) once and reuses it until shortly before it expires. One POST per
# instance spent the operator's shared gh quota, and a quota shim that refuses calls under a floor then left
# every later instance with "no registration token". A failed mint is not cached: the next instance asks again.
TOKEN_REUSE_S = 50 * 60
_MINTED: dict[tuple[str, str], tuple[str, float]] = {}
_MINT_LOCKS: dict[tuple[str, str], threading.Lock] = {}
_MINT_LOCKS_GUARD = threading.Lock()


def mint(scope: str, kind: str = "registration-token") -> str | None:
    key = (scope, kind)
    with _MINT_LOCKS_GUARD:
        lock = _MINT_LOCKS.setdefault(key, threading.Lock())
    with lock:  # instances run at once: one mint per key in flight, the rest wait for its answer
        cached = _MINTED.get(key)
        if cached and time.monotonic() - cached[1] < TOKEN_REUSE_S:
            return cached[0]
        # gh's stderr is dropped: it never carries the token, but keep it quiet
        code, out, _ = run(["gh", "api", "-X", "POST", f"{scope}/actions/runners/{kind}", "--jq", ".token"], 60)
        token = out.strip()
        if code != 0 or not TOKEN_RE.fullmatch(token):
            _MINTED.pop(key, None)
            return None
        _MINTED[key] = (token, time.monotonic())
        return token


def github_labels(scope: str, name: str) -> str | None:
    """The labels GitHub lists for runner `name` now, comma-separated, read with this operator's gh; None when the
    read fails or GitHub lists no such runner (the mini then decides as before). The minis hold no gh login, so
    without this each apply re-registered every idle runner whatever its labels were."""
    code, out, _ = run(["gh", "api", f"{scope}/actions/runners?name={urllib.parse.quote(name)}&per_page=100"], 60)
    try:
        runners = json.loads(out).get("runners") if code == 0 else None
    except (ValueError, AttributeError):
        return None
    for found in runners if isinstance(runners, list) else []:
        if isinstance(found, dict) and found.get("name") == name:
            labels = sorted(str(label.get("name")) for label in found.get("labels") or [] if isinstance(label, dict))
            return ",".join(label for label in labels if label and "," not in label)
    return None


def group_refusal(org: str, group: str, repo: str | None) -> str | None:
    """Why the org runner group cannot take the migration, or None. Checked before any member is touched."""
    code, out, _ = run(["gh", "api", f"orgs/{org}/actions/runner-groups?per_page=100"], 60)
    try:
        groups = [g for g in json.loads(out).get("runner_groups", []) if g.get("name") == group]
    except (ValueError, AttributeError):
        return f"cannot list {org}'s runner groups (gh exit {code}; org admin needed)"
    if not groups:
        return f"{org} has no runner group named {group!r}"
    found = groups[0]
    if not repo:
        return None
    code, out, _ = run(["gh", "api", f"repos/{repo}", "--jq", ".private"], 60)
    if out.strip() == "false" and not found.get("allows_public_repositories"):
        return f"runner group {group!r} does not allow public repositories, and {repo} is public"
    if found.get("visibility") == "all":
        return None
    if found.get("visibility") == "private" and out.strip() == "true":
        return None
    code, out, _ = run(["gh", "api", "--paginate", f"orgs/{org}/actions/runner-groups/{found.get('id')}/repositories"
                        "?per_page=100", "--jq", ".repositories[].full_name"], 60)
    if code != 0:
        return f"cannot list the repositories of runner group {group!r}"
    if repo.lower() not in {line.strip().lower() for line in out.splitlines()}:
        return f"runner group {group!r} does not allow {repo}; add it before moving its runners"
    return None


@functools.lru_cache(maxsize=1)
def source_stamp() -> dict[str, Any] | None:
    """Where these scripts come from, for the staged copy's stamp: an existing stamp, the OTA release they sit
    in, or this git checkout's HEAD. None when unknown (the copy then reads as older than any release)."""
    try:
        stamp = json.loads((SCRIPT_DIR / SOURCE_STAMP).read_text())
        if isinstance(stamp, dict) and re.match(r"\d{4}-\d{2}-\d{2}", str(stamp.get("date") or "")):
            return stamp
    except (OSError, ValueError):
        pass
    try:
        release = json.loads((SCRIPT_DIR.parent.parent / "release.json").read_text())
        found = re.fullmatch(r"r-(\d{4})(\d{2})(\d{2})-[0-9a-f]{12}", str(release.get("tag")))
        if found:
            return {"by": "glaeda-cmux-runner-fleet", "date": "-".join(found.groups()),
                    "source": release.get("source"), "tag": found.group(0)}
    except (OSError, ValueError, AttributeError):
        pass
    code, out, _ = run(["env", "TZ=UTC", "git", "-C", os.fspath(SCRIPT_DIR.parent), "log", "-1",
                          "--format=%H %cd", "--date=format-local:%Y-%m-%d"], 30)  # UTC, like release tags
    parts = out.split() if code == 0 else []
    if len(parts) == 2 and re.fullmatch(r"[0-9a-f]{40}", parts[0]):
        return {"by": "glaeda-cmux-runner-fleet", "date": parts[1], "source": parts[0]}
    return None


def git(*args: str, timeout: float = 30) -> tuple[int, str, str]:
    return run(["git", "-C", os.fspath(SCRIPT_DIR.parent), *args], timeout)


def checkout_source() -> dict[str, Any]:
    """{head, originMain, refusal}: this checkout's HEAD and origin's main as origin reports it now. ls-remote
    fetches nothing and writes nothing here, and a stale local origin/main ref cannot vouch for a stale checkout.
    refusal is why --apply must not deploy from here, or None."""
    code, out, _ = git("rev-parse", "--verify", "HEAD^{commit}")
    head = out.strip() if code == 0 and re.fullmatch(r"[0-9a-f]{40}", out.strip()) else None
    if head is None:
        return {"head": None, "originMain": None,
                "refusal": "this is not a git checkout, so what it would deploy is unknown"}
    code, out, _ = git("ls-remote", "--exit-code", "origin", "refs/heads/main", timeout=60)
    found = re.match(r"([0-9a-f]{40})\trefs/heads/main\Z", out.strip()) if code == 0 else None
    main = found.group(1) if found else None
    if main is None:  # git's stderr may name the remote URL: keep it out
        refusal = f"cannot read origin's main (git ls-remote exit {code}), so HEAD {head} cannot be checked"
    elif main != head:
        refusal = f"HEAD {head} is not origin/main {main}; roll out from a worktree at origin/main"
    else:
        refusal = None
    return {"head": head, "originMain": main, "refusal": refusal}


def clean_reason(text: object) -> str:
    """One line, no control or format characters, at most MAX_REASON characters."""
    words = " ".join(str(text or "").split())
    return " ".join("".join(ch for ch in words if unicodedata.category(ch)[0] != "C").split())[:MAX_REASON]


GUARDED = tuple(f"scripts/{name}" for name in (*STAGED, "glaeda-cmux-runner-fleet"))


def dirty_staged() -> list[str] | None:
    """The staged files (and this tool) with uncommitted changes, by repository path; None when git cannot tell."""
    code, out, _ = git("status", "--porcelain", "--", *GUARDED)
    if code != 0:
        return None
    return sorted({line[3:].strip() for line in out.splitlines() if len(line) > 3})


def hidden_staged() -> list[str] | None:
    """The staged files (and this tool) git status cannot vouch for: marked assume-unchanged (a lowercase tag in
    ls-files -v) or skip-worktree (S). None when git cannot tell."""
    code, out, _ = git("ls-files", "-v", "--", *GUARDED)
    if code != 0:
        return None
    return sorted({line[2:].strip() for line in out.splitlines()
                   if len(line) > 2 and (line[0].islower() or line[0] == "S")})


def stamp_for(head: str | None) -> dict[str, Any] | None:
    """The stamp to stage. A checked HEAD gets its own stamp or none: never source_stamp's guess (an untracked
    stamp or release.json beside the scripts), which the guard did not check. Only with no git checkout at all
    (an OTA release copy, which needs --allow-downgrade) does that copy's own record stand in."""
    return head_stamp(head) if head else source_stamp()


def head_stamp(head: str) -> dict[str, Any] | None:
    """The stamp for the commit the guard checked: its UTC commit day, like source_stamp's git branch."""
    code, out, _ = run(["env", "TZ=UTC", "git", "-C", os.fspath(SCRIPT_DIR.parent), "log", "-1", "--format=%cd",
                        "--date=format-local:%Y-%m-%d", head], 30)
    day = out.strip()
    return {"by": "glaeda-cmux-runner-fleet", "date": day, "source": head} if code == 0 and re.fullmatch(
        r"\d{4}-\d{2}-\d{2}", day) else None


def host_source(member: str, head: str | None, on_main: bool = False) -> dict[str, Any]:
    """What the member's stamp says it runs, against HEAD. state: none, unreadable, current, behind, downgrade
    (not an ancestor of HEAD), rolling_forward (not an ancestor, but deployed off main on purpose with
    --allow-downgrade, and HEAD is origin's main) or unchecked (no HEAD). Read-only: one head -c over SSH."""
    code, out, _ = run(["ssh", *SSH_OPTIONS, member, STAMP_READ], CHECK_TIMEOUT_S)
    text = out.strip()
    if code != 0:
        return {"state": "unreadable", "note": f"cannot read the stamp (ssh exit {code})"}
    if text == "@no-stamp":
        return {"state": "none", "note": "no stamp"}
    try:
        stamp = json.loads(text)
    except ValueError:
        stamp = None
    source = str(stamp.get("source") or "") if isinstance(stamp, dict) else ""
    if not SHA_RE.fullmatch(source):
        return {"state": "unreadable",
                "note": "stamp names no commit" if isinstance(stamp, dict) else "stamp is not a JSON object"}
    row: dict[str, Any] = {"source": source, "date": str(stamp.get("date") or "")[:10] or None,
                           "by": str(stamp.get("by") or "")[:40] or None}
    if head is None:
        return {**row, "state": "unchecked", "note": "HEAD unknown"}
    code, _, _ = git("merge-base", "--is-ancestor", source, head)
    if code != 0:  # 1: not an ancestor; anything else: a commit this checkout does not have, so not one either
        override = stamp.get("allowDowngrade")
        reason = clean_reason(override.get("reason")) if isinstance(override, dict) else ""
        if on_main and reason:  # a squash-merged canary is never an ancestor of main: roll it forward
            return {**row, "state": "rolling_forward", "reason": reason,
                    "note": f"rolling forward from a deliberate off-main deploy (reason: {reason})"}
        unknown = "" if code == 1 else " (a commit this checkout does not have)"
        return {**row, "state": "downgrade",
                "note": f"stamped {source} is not an ancestor of HEAD {head}{unknown}: a downgrade or a diverged deploy"}
    code, out, _ = git("rev-list", "--count", f"{source}..{head}")
    behind = int(out.strip()) if code == 0 and out.strip().isdigit() else None
    return {**row, "state": "current" if behind == 0 else "behind", "behind": behind}


def source_guard(chosen: list[str], jobs: int) -> dict[str, Any]:
    """The checkout and every target member's stamp, and the refusals they add up to (each {member, text})."""
    guard = checkout_source()
    on_main = guard["head"] is not None and guard["head"] == guard["originMain"]
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, jobs)) as pool:
        hosts = dict(zip(chosen, pool.map(lambda m: host_source(m, guard["head"], on_main), chosen)))
    guard["hosts"] = hosts
    refusal = guard.pop("refusal")
    checkout = [refusal] if refusal else []
    if guard["head"] is not None:
        dirty = dirty_staged()
        if dirty is None:
            checkout.append("cannot tell whether the staged files have uncommitted changes (git status failed)")
        elif dirty:
            checkout.append(f"uncommitted changes to staged files: {', '.join(dirty)}; the stamp would name HEAD "
                            f"{guard['head']} for files that differ from it")
        hidden = hidden_staged()
        if hidden is None:
            checkout.append("cannot tell whether git ignores edits to the staged files (git ls-files failed)")
        elif hidden:
            checkout.append(f"staged files marked assume-unchanged or skip-worktree: {', '.join(hidden)}; git status "
                            "cannot vouch that they match HEAD (git update-index --no-assume-unchanged "
                            "--no-skip-worktree clears it)")
    guard["refusals"] = [{"member": None, "text": text} for text in checkout] + [
        {"member": m, "text": f"{m}: {row['note']}"} for m, row in sorted(hosts.items()) if row["state"] == "downgrade"]
    return guard


def guard_lines(guard: dict[str, Any], applied: bool) -> list[str]:
    head, main = (guard.get("head") or "unknown")[:12], (guard.get("originMain") or "unknown")[:12]
    lines = [f"source: HEAD {head}, origin/main {main}"]
    for member, row in sorted(guard["hosts"].items()):
        if row["state"] in ("none", "unreadable"):
            what = "no stamp" if row["state"] == "none" else f"unreadable stamp ({row['note']})"
            lines.append(f"  {member}: {what}; not counted as a downgrade")
        elif row["state"] in ("current", "behind"):
            behind = "?" if row.get("behind") is None else row["behind"]
            lines.append(f"  {member}: stamped {row['source'][:12]}, {behind} behind HEAD")
        elif row["state"] == "rolling_forward":
            lines.append(f"  {member}: {row['note']}")
        elif row["state"] == "unchecked":
            lines.append(f"  {member}: stamped {row['source'][:12]}, not checked ({row['note']})")
    return lines + refusal_lines(guard, applied)


def refusal_lines(guard: dict[str, Any], applied: bool) -> list[str]:
    if not guard["refusals"]:
        return []
    if guard.get("allowDowngrade"):
        head = f"--allow-downgrade ({guard['allowDowngrade']}) overrides:"
    else:
        head = "refused --apply, nothing changed:" if applied else "would refuse --apply:"
    return [head, *(f"  {r['text']}" for r in guard["refusals"])]


def stage(member: str, manifest: dict[str, Any], scratch: Path,
          override: dict[str, Any] | None = None, head: str | None = None) -> str | None:
    """Copy the scripts, their source stamp and the member's trimmed manifest. Returns why it failed, or None.
    override: the --allow-downgrade reason and the refusals it overrode, recorded in the stamp. head: the commit
    the guard checked, which the stamp then names (else source_stamp's guess: a stamp or release beside us)."""
    local = scratch / f"{member}.manifest.json"
    local.write_text(json.dumps(trimmed(manifest, member), indent=1) + "\n")
    files = [os.fspath(SCRIPT_DIR / f) for f in STAGED]
    stamp = stamp_for(head)
    if stamp is not None and override is not None:
        stamp = {**stamp, "allowDowngrade": override}
    if stamp is not None:
        (scratch / member).mkdir(exist_ok=True)
        (scratch / member / SOURCE_STAMP).write_text(json.dumps(stamp, sort_keys=True) + "\n")
        files.append(os.fspath(scratch / member / SOURCE_STAMP))
    code, _, err = run(["ssh", *SSH_OPTIONS, member, f"mkdir -p ~/{REMOTE_DIR}/scripts"], 60)
    if code != 0:
        return f"ssh: {err.strip()[-200:]}"
    if stamp is None:  # an old stamp would vouch for these new files
        run(["ssh", *SSH_OPTIONS, member, f"rm -f ~/{REMOTE_DIR}/scripts/{SOURCE_STAMP}"], 60)
    code, _, err = run(["scp", "-q", *SSH_OPTIONS, *files, f"{member}:{REMOTE_DIR}/scripts/"], 300)
    if code == 0:
        # scp normally preserves executable bits, but an SSH implementation or a mounted
        # home can discard them. The runner copy is ours, so repair the modes explicitly.
        code, _, err = run(["ssh", *SSH_OPTIONS, member,
                            f"chmod +x ~/{REMOTE_DIR}/scripts/glaeda-cmux-runner "
                            f"~/{REMOTE_DIR}/scripts/glaeda-cmux-runner-hook "
                            f"~/{REMOTE_DIR}/scripts/glaeda_fleet_labels.py "
                            f"~/{REMOTE_DIR}/scripts/glaeda_reservation.py "
                            f"~/{REMOTE_DIR}/scripts/{PROMOTION_ADMIT} && mkdir -p ~/.local/bin && "
                            f"cp ~/{REMOTE_DIR}/scripts/{PROMOTION_ADMIT} ~/.local/bin/.{PROMOTION_ADMIT}.tmp && "
                            f"chmod 755 ~/.local/bin/.{PROMOTION_ADMIT}.tmp && "
                            f"mv -f ~/.local/bin/.{PROMOTION_ADMIT}.tmp ~/.local/bin/{PROMOTION_ADMIT}"], 60)
    if code == 0:
        code, _, err = run(["scp", "-q", *SSH_OPTIONS, os.fspath(local), f"{member}:{REMOTE_DIR}/mini-fleet.json"], 60)
    return None if code == 0 else f"scp: {err.strip()[-200:]}"


def prepare_headless(member: str, summary: dict[str, Any], manifest: dict[str, Any]) -> str | None:
    """Converge the small operator fixes needed before a GUI-less AWS runner can start."""
    host = (manifest.get("hosts") or {}).get(member) or {}
    if host.get("gui") is not False or host.get("ssh_user") != "ec2-user":
        return None
    xcodes = summary.get("xcodeApps") or []
    pinned = next((p for p in xcodes if str(p).startswith("/Applications/Xcode_") and str(p).endswith(".app")), None)
    lines = [
        "set -eu",
        # These are global paths. Refuse a conflicting owner instead of replacing
        # a real file or someone else's link; reruns are safe when our link is
        # already present.
        "if [ -x /opt/homebrew/bin/gh ]; then "
        "if [ -L /usr/local/bin/gh ]; then "
        "[ \"$(/usr/bin/readlink /usr/local/bin/gh)\" = /opt/homebrew/bin/gh ] || "
        "{ echo 'refusing conflicting /usr/local/bin/gh' >&2; exit 1; }; "
        "elif [ -e /usr/local/bin/gh ]; then "
        "echo 'refusing non-symlink /usr/local/bin/gh' >&2; exit 1; "
        "else sudo -n /usr/bin/install -d -m 755 /usr/local/bin && "
        "sudo -n /bin/ln -s /opt/homebrew/bin/gh /usr/local/bin/gh; fi; fi",
    ]
    if pinned:
        q = _quote(str(pinned))
        lines.append(
            # xcode-select is process-global. Refuse to change it while a
            # runner job is active; the next apply can retry after the job
            # drains, so an in-flight build never sees a moving toolchain.
            f"if [ \"$(/usr/bin/xcode-select -p 2>/dev/null || true)\" != {q}/Contents/Developer ]; then "
            "if /usr/bin/pgrep -f '/actions-runner[^ ]*/bin/Runner.Listener' >/dev/null 2>&1 || "
            "/usr/bin/pgrep -f '/actions-runner[^ ]*/bin[^/ ]*/Runner.Worker' >/dev/null 2>&1; then "
            "echo 'refusing Xcode selection change while a runner is active' >&2; exit 1; fi; "
            "fi; "
            f"if [ -d {q} ]; then "
            f"if [ -L /Applications/Xcode.app ]; then "
            f"[ \"$(/usr/bin/readlink /Applications/Xcode.app)\" = {q} ] || "
            "{ echo 'refusing conflicting /Applications/Xcode.app' >&2; exit 1; }; "
            "elif [ -e /Applications/Xcode.app ]; then "
            "echo 'refusing non-symlink /Applications/Xcode.app' >&2; exit 1; "
            f"else sudo -n /bin/ln -s {q} /Applications/Xcode.app; fi; "
            f"if [ \"$(/usr/bin/xcode-select -p 2>/dev/null || true)\" != {q}/Contents/Developer ]; then "
            f"sudo -n /usr/bin/xcode-select -s {q}/Contents/Developer; fi; fi"
        )
    lines.append(f"chmod +x ~/{REMOTE_DIR}/scripts/* 2>/dev/null || true")
    code, _, err = run(["ssh", *SSH_OPTIONS, member, "; ".join(lines)], 90)
    return None if code == 0 else f"headless preparation failed: {err.strip()[-240:]}"


def _uninstall_cmd(member: str, instance: int, apply: bool, receipt_only: bool = False, token: bool = True) -> str:
    # --token-stdin even for the plan: without gh on the mini, a plan lacking it reads "blocked", and a plan
    # never reads stdin. receipt_only: no --manifest (a dedicatedOnly member declares no pool instance to name);
    # an uninstall acts only on what the instance's receipt recorded anyway.
    named = "" if receipt_only else f"--manifest ~/{REMOTE_DIR}/mini-fleet.json --member {_quote(member)} "
    # token=False: an instance with no registration to deregister (an interrupted install) takes no token
    return (f"~/{REMOTE_DIR}/scripts/glaeda-cmux-runner --uninstall {'--apply ' if apply else ''}"
            f"{'--token-stdin ' if token else ''}{named}--instance {instance} --output json")


def _failed_note(out: str, err: str, code: int) -> str:
    try:
        notes = [f"{a.get('kind')}: {a.get('note') or a.get('state')}" for a in json.loads(out).get("actions", [])
                 if isinstance(a, dict) and a.get("state") in ("failed", "blocked")]
    except (ValueError, AttributeError):
        notes = []
    return "; ".join(notes)[-200:] or f"exit {code}: {(err or out).strip()[-200:]}"


def registered_scope(member: str, instance: int, receipt_only: bool = False) -> tuple[str | None, str | None]:
    """(scope the instance is registered to, "" when none; or None and why it could not be read). Read-only:
    the single-mini uninstall plan, which follows the instance's receipt."""
    code, out, err = run(["ssh", *SSH_OPTIONS, member, _uninstall_cmd(member, instance, False, receipt_only)],
                         CHECK_TIMEOUT_S)
    try:
        acts = [a for a in json.loads(out).get("actions", []) if isinstance(a, dict) and a.get("kind") == "deregister"]
    except (ValueError, AttributeError):
        return None, f"cannot read its registration: {_failed_note(out, err, code)}"
    if not acts and receipt_only:  # retiring: no deregister plan at all is unknown state, never "unregistered"
        return None, f"no deregistration plan for instance {instance} ({_failed_note(out, err, code)})"
    act = acts[0] if acts else {"state": "kept"}
    if act.get("state") == "kept" and act.get("registered") and receipt_only:
        # retiring: a recorded registration with no runner directory to deregister from is unknown state on GitHub
        return None, (f"instance {instance}'s receipt records a registration ({act.get('scope') or '?'}) but its runner "
                      "directory is gone: delete that runner on GitHub by hand, then remove the receipt")
    if act.get("state") == "kept":
        return "", None
    if act.get("state") == "remove" and isinstance(act.get("scope"), str) and act["scope"]:
        return act["scope"], None
    return None, f"registration not recorded clearly ({act.get('note') or act.get('state')}); fix it by hand"


def uninstall_instance(member: str, instance: int, repo: str) -> str | None:
    """Deregister one instance's repo-scoped runner. Returns why it failed, or None."""
    token = mint(scope_api(repo, None), "remove-token")
    if token is None:
        return f"no remove token for {repo} (gh admin on the repo?)"
    code, out, err = run(["ssh", *SSH_OPTIONS, member, _uninstall_cmd(member, instance, True)], APPLY_TIMEOUT_S,
                         stdin=token + "\n")
    del token
    return None if code == 0 else f"uninstall failed ({_failed_note(out, err, code)})"


# DEDICATED_ONLY (glaeda_fleet_labels): the pool instances' receipts on a member (instance 0's at the top), and the
# pool runner directories (~/actions-runner-glaeda, ~/actions-runner-glaeda-K), which glaeda-cmux-runner names after
# the instance. Run by /bin/sh, never the login shell: zsh fails an unmatched glob ("no matches found").
# Fails closed (review of 5758205): a state directory that exists but cannot be entered, or a home that cannot, exits 3;
# an absent state directory is a mini with no receipts. The final "end" line proves the listing ran to completion.
# Fails closed (reviews of 5758205 and a1de21e4): ls, not a glob, enumerates each directory, so one it cannot read or
# enter exits 3 (a glob would skip it silently); an absent state directory is a mini with no receipts. The final "end"
# line proves the listing ran to completion.
POOL_RECEIPTS = ("/bin/sh -c 's=\"$HOME/.local/state/glaeda/cmux-runner\"; "
                 "if [ -e \"$s\" ]; then l=$(ls -1A \"$s\") || exit 3; for n in $l; do case $n in "
                 "receipt.json) echo \"receipt $n\";; instance-*) [ -d \"$s/$n\" ] || continue; "
                 "c=$(ls -1A \"$s/$n\") || exit 3; case \" $(echo $c) \" in *\" receipt.json \"*) "
                 "echo \"receipt $n/receipt.json\";; esac;; esac; done; fi; "
                 "h=$(ls -1A \"$HOME\") || exit 3; for n in $h; do case $n in actions-runner-glaeda*) "
                 "[ -d \"$HOME/$n\" ] && echo \"dir $n\";; esac; done; echo end; exit 0'")
POOL_RECEIPT_RE = re.compile(r"receipt (?:instance-(\d+)/)?receipt\.json")
POOL_DIR_RE = re.compile(r"dir actions-runner-glaeda(?:-(\d+))?")
# what else the listing may name: a dedicated runner's receipt and directory (glaeda_fleet_labels DEDICATED_NAME_RE)
DEDICATED_LISTING_RE = re.compile(r"receipt instance-dedicated-[a-z][a-z0-9-]{0,39}/receipt\.json"
                                  r"|dir actions-runner-glaeda-[a-z][a-z0-9-]{0,39}")


def installed_pool_instances(member: str) -> tuple[list[int] | None, str | None]:
    """([instance numbers with a pool receipt], None) or (None, why it could not be read or is not safe). Read-only.
    A dedicated runner (instance-dedicated-NAME, actions-runner-glaeda-NAME) is not a pool instance and never listed. A
    pool runner directory with no receipt (an interrupted install) is unknown state: (None, why), which holds the
    dedicated runners off until an operator removes it (fails closed)."""
    code, out, err = run(["ssh", *SSH_OPTIONS, member, POOL_RECEIPTS], CHECK_TIMEOUT_S)
    if code != 0:
        return None, f"cannot list its runner receipts (exit {code}: {(err or out).strip()[-160:]})"
    lines = [line.strip() for line in out.splitlines() if line.strip()]
    if not lines or lines[-1] != "end":
        return None, "its runner receipt listing did not complete (no end marker); unknown state"
    lines = lines[:-1]
    odd = [line for line in lines if not (POOL_RECEIPT_RE.fullmatch(line) or POOL_DIR_RE.fullmatch(line)
                                          or DEDICATED_LISTING_RE.fullmatch(line))]
    if odd:
        return None, f"its runner receipt listing has lines it cannot read ({odd[0][:80]!r}); unknown state"
    receipts = {int(m[1] or 0) for m in map(POOL_RECEIPT_RE.fullmatch, lines) if m}
    dirs = {int(m[1] or 0) for m in map(POOL_DIR_RE.fullmatch, lines) if m}
    orphans = sorted(dirs - receipts)
    if orphans:
        return None, (f"pool runner directories with no receipt (instances {orphans}): unknown state, remove them by "
                      "hand while idle (deregister any .runner), then re-run")
    return sorted(receipts), None


def repo_dedicated_only(member: str, summary: dict[str, Any], manifest: dict[str, Any]) -> bool:
    """REPO_DEDICATED_ONLY: whether every runner an apply would touch on the member is a repository-scoped dedicated
    runner: runner.dedicatedOnly, at least one dedicated entry and none at org scope, and no pool instance installed
    (read on the member; unreadable is False, so the org group check stays)."""
    if summary.get("dedicatedOnly") is not True:
        return False
    entries, bad = load_labels().dedicated_runners(manifest, member)
    if bad or not entries or any(e.get("org") for e in entries):
        return False
    installed, _ = installed_pool_instances(member)
    return installed == []


def retire_instance(member: str, instance: int, held: str = "dedicated runners held") -> dict[str, Any]:
    """Deregister and remove one pool instance, by its receipt: every pool instance of a dedicatedOnly member, and on
    any other member each instance at or past runners + gatewayRunners (SURPLUS). A runner with a job is never
    stopped: glaeda-cmux-runner's uninstall fails ("the runner has a job") and changes nothing; drain the mini
    (cmux-ci drain) and re-run."""
    scope, why = registered_scope(member, instance, receipt_only=True)
    if scope is None:
        return {"instance": instance, "exit": None, "state": f"retire: {why}; nothing changed"}
    token = mint(scope_api(None, scope) if "/" not in scope else scope_api(scope, None), "remove-token") if scope else ""
    if token is None:
        return {"instance": instance, "exit": None, "state": f"retire: no remove token for {scope}; nothing changed"}
    code, out, err = run(["ssh", *SSH_OPTIONS, member,
                          _uninstall_cmd(member, instance, True, receipt_only=True, token=bool(scope))],
                         APPLY_TIMEOUT_S, stdin=token + "\n" if scope else None)
    del token
    if code != 0:
        return {"instance": instance, "exit": code, "state": f"retire failed ({_failed_note(out, err, code)})",
                "name": None}
    # Exit 0 is no proof: an uninstall that keeps a directory it does not own (a missing or foreign ownership marker)
    # also exits 0. Retired means the mini lists neither its receipt nor a pool directory without one.
    left, why = installed_pool_instances(member)
    if left is None or instance in left:
        return {"instance": instance, "exit": 1, "name": None,
                "state": f"retire unconfirmed ({why or 'its receipt is still there'}); {held}"}
    return {"instance": instance, "exit": 0, "state": "retired", "name": None}


# SURPLUS: the apply installs instances 0 .. runners + gatewayRunners - 1, so after a member's count drops (an xl
# Studio from 10 to 6 runners, 2026-11-03) the instances past it kept their LaunchAgents and registrations, kept taking
# side jobs and kept their listen claims, which held the root runners off: the problem the drop was meant to fix
# (#1821). Each pool instance installed at or past the count is retired the way a dedicatedOnly member's are, only
# while idle. A busy one is left installed and reported "retire when idle"; it does not fail the apply, and the next
# apply retires it.
SURPLUS_BUSY = "has a job"


def surplus_instances(installed: list[int], count: int) -> list[int]:
    """The installed pool instances past a member's declared count (runners + gatewayRunners)."""
    return [k for k in installed if k >= count]


def retire_surplus(member: str, count: int) -> list[dict[str, Any]]:
    """Retire every idle pool instance at or past `count` on `member` (SURPLUS). Each result carries "surplus": True;
    a busy one ("deferred": True) is reported "retire when idle" and left installed. A listing that cannot be read
    retires nothing and says why, without failing the apply (deferred too)."""
    installed, why = installed_pool_instances(member)
    if installed is None:
        return [{"instance": None, "exit": None, "surplus": True, "deferred": True,
                 "state": f"surplus not checked: {why}"}]
    results = []
    for k in surplus_instances(installed, count):
        result = retire_instance(member, k, held=f"past the declared {count} instances")
        result["surplus"] = True
        if result["exit"] != 0 and SURPLUS_BUSY in str(result.get("state")):
            result["deferred"] = True
            result["state"] = f"retire when idle (past the declared {count} instances): {result['state']}"
        results.append(result)
    return results


def apply_instance(member: str, instance: int, repo: str | None, extra: list[str], org: str | None = None,
                   group: str | None = None, migrate_from: str | None = None) -> dict[str, Any]:
    # The registration token comes first, so a missing permission never strips a runner it cannot replace.
    token = mint(scope_api(repo, org))
    if token is None:
        return {"instance": instance, "exit": None,
                "state": f"no registration token (gh admin on {org or repo}?); nothing changed"}
    deregistered = None
    if migrate_from:
        scope, why = registered_scope(member, instance)
        if scope is None:
            return {"instance": instance, "exit": None, "state": f"{why}; nothing changed"}
        if scope.lower() == migrate_from.lower():
            failed = uninstall_instance(member, instance, migrate_from)
            if failed:
                return {"instance": instance, "exit": None, "state": f"{failed}; check the runner by hand"}
            deregistered = migrate_from
        elif scope and scope.lower() != (org or "").lower():
            return {"instance": instance, "exit": None,
                    "state": f"registered to {scope}, not {migrate_from} or {org}; nothing changed"}
    scope = f"--org {_quote(org)}" + (f" --group {_quote(group)}" if group else "") if org else f"--repo {_quote(repo)}"
    version, sha, _ = latest_release()
    labels = None if deregistered else github_labels(scope_api(repo, org),
                                                     f"{member}-glaeda" + (f"-{instance}" if instance else ""))
    observed = f"--github-labels={_quote(labels)} " if labels is not None else ""  # = : a label may start with -
    remote = (f"~/{REMOTE_DIR}/scripts/glaeda-cmux-runner --apply --token-stdin {scope} "
              f"--manifest ~/{REMOTE_DIR}/mini-fleet.json --member {_quote(member)} --instance {instance} "
              f"--latest-runner-version {_quote(version)} --latest-runner-sha256 {_quote(sha)} "
              f"{observed}--output json " + " ".join(_quote(a) for a in extra))
    code, out, err = run(["ssh", *SSH_OPTIONS, member, remote], APPLY_TIMEOUT_S, stdin=token + "\n")
    del token
    try:
        doc = json.loads(out)
        acts = {a["kind"]: a for a in doc.get("actions", []) if isinstance(a, dict) and "kind" in a}
        state = f"{acts.get('register', {}).get('state', '?')}/{acts.get('verify', {}).get('state', '?')}"
        name = acts.get("register", {}).get("name")
    except (ValueError, TypeError, AttributeError):
        state, name = f"no receipt: {(err or out).strip()[-200:]}", None
    if code != 0:
        # A failure before register (staging, launchctl) leaves register/verify
        # as "?": name the step that failed so the operator need not ssh in.
        state = f"{state} ({_failed_note(out, err, code)})"
    result = {"instance": instance, "exit": code, "state": state, "name": name}
    if deregistered:
        result["deregistered"] = deregistered
        if code != 0:  # the old runner is gone and the new one did not come up: say so loudly
            result["state"] = f"NO RUNNER: deregistered from {deregistered}, then {state}; re-run to register"
    return result


def apply_dedicated(member: str, entry: dict[str, Any], extra: list[str]) -> dict[str, Any]:
    """Apply one runner.dedicated runner (glaeda-cmux-runner --dedicated): a token for its own scope, piped over SSH.
    A dedicated runner with a job is never stopped: its plan blocks a relabel and its agent step waits for idle."""
    token = mint(scope_api(entry["repo"], entry["org"]))
    if token is None:
        return {"dedicated": entry["name"], "exit": None,
                "state": f"no registration token (gh admin on {entry['org'] or entry['repo']}?); nothing changed"}
    scope = (f"--org {_quote(entry['org'])}" + (f" --group {_quote(entry['group'])}" if entry["group"] else "")
             if entry["org"] else f"--repo {_quote(entry['repo'])}")
    version, sha, _ = latest_release()
    # GitHub's labels for it, so a mini without gh sees a match and never re-registers it (#1645)
    labels = github_labels(scope_api(entry["repo"], entry["org"]), f"{member}-glaeda-{entry['name']}")
    observed = f"--github-labels={_quote(labels)} " if labels is not None else ""
    remote = (f"~/{REMOTE_DIR}/scripts/glaeda-cmux-runner --apply --token-stdin {scope} "
              f"--manifest ~/{REMOTE_DIR}/mini-fleet.json --member {_quote(member)} --dedicated {_quote(entry['name'])} "
              f"--latest-runner-version {_quote(version)} --latest-runner-sha256 {_quote(sha)} {observed}--output json "
              + " ".join(_quote(a) for a in extra if a != "--headless"))
    code, out, err = run(["ssh", *SSH_OPTIONS, member, remote], APPLY_TIMEOUT_S, stdin=token + "\n")
    del token
    try:
        acts = {a["kind"]: a for a in json.loads(out).get("actions", []) if isinstance(a, dict) and "kind" in a}
        state = f"{acts.get('register', {}).get('state', '?')}/{acts.get('verify', {}).get('state', '?')}"
        name = acts.get("register", {}).get("name")
    except (ValueError, TypeError, AttributeError):
        state, name = f"no receipt: {(err or out).strip()[-200:]}", None
    if code != 0:
        state = f"{state} ({_failed_note(out, err, code)})"
    return {"dedicated": entry["name"], "exit": code, "state": state, "name": name}


def member_scope(args: argparse.Namespace, manifest: dict[str, Any], member: str) -> tuple[str | None, str | None,
                                                                                       str | None]:
    """(repo, org, group) the member's pool instances register to: --repo/--org/--group when passed, for every
    member; else the manifest's runner.org/runner.group (glaeda_fleet_labels.pool_scope; a trusted-only member stays
    on its runner.trustedRepo); else the default repository."""
    if args.scope_flags:
        return args.repo, args.org, args.group
    scope, _ = load_labels().pool_scope(manifest, member)
    if scope is None:
        return DEFAULT_REPO, None, None
    return scope.get("repo"), scope.get("org"), scope.get("group")


def one_member(member: str, summary: dict[str, Any], args: argparse.Namespace, manifest: dict[str, Any],
               scratch: Path) -> dict[str, Any]:
    started = time.monotonic()
    eligible, why = check(member, summary)
    row: dict[str, Any] = {"member": member, "class": summary["class"], "runners": summary.get("runners", 1),
                           "gatewayRunners": summary.get("gatewayRunners") or 0,
                           "simRunners": summary.get("simRunners") or 0,
                           "capacityUnits": summary.get("capacityUnits"), "eligible": eligible, "gate": why}
    dedicated, bad = load_labels().dedicated_runners(manifest, member)
    row["dedicated"] = [d["name"] for d in dedicated]
    if bad:
        row["eligible"], row["action"] = False, f"bad runner.dedicated: {bad}"
        return row
    if not args.scope_flags:
        _, bad = load_labels().pool_scope(manifest, member)
        if bad:
            row["eligible"], row["action"] = False, f"bad runner scope: {bad}"
            return row
    if eligible is None:
        row["eligible"], row["action"] = False, "unreachable"
        return row
    if args.org and summary.get("trustedRepo"):
        row["action"] = f"skip (trusted-only runner stays on {summary['trustedRepo']})"
        return row
    if summary.get("dedicatedOnly"):
        row["runners"], row["gatewayRunners"], row["simRunners"] = 0, 0, 0
        installed, why = installed_pool_instances(member)
        row["retire"] = installed if installed is not None else why
    if not args.apply:
        row["action"] = "would apply" if eligible or args.include_ineligible else "skip (not eligible)"
        if summary.get("dedicatedOnly"):
            row["action"] += (f"; dedicated only, retire pool instances {row['retire'] or 'none'}"
                              if isinstance(row["retire"], list) else f"; dedicated only, {row['retire']}")
        elif eligible or args.include_ineligible:
            # SURPLUS: the plan names the instances an apply would retire (read-only listing)
            installed, _ = installed_pool_instances(member)
            surplus = surplus_instances(installed or [], row["runners"] + row["gatewayRunners"] + row["simRunners"])
            if surplus:
                row["retire"] = surplus
                row["action"] += f"; retire surplus instances {surplus} when idle"
        return row
    if not (eligible or args.include_ineligible):
        row["action"] = "skipped (not eligible)"
        return row
    override = None
    if args.allow_downgrade is not None:
        override = {"reason": args.allow_downgrade,
                    "refusals": [r["text"] for r in args.guard["refusals"] if r["member"] in (None, member)]}
    failed = stage(member, manifest, scratch, override, args.guard.get("head"))
    if failed:
        row["action"] = f"stage failed: {failed}"
        return row
    prepared = prepare_headless(member, summary, manifest)
    if prepared:
        row["action"] = f"prepare failed: {prepared}"
        return row
    extra = ["--headless"] if ((manifest.get("hosts") or {}).get(member) or {}).get("gui") is False else []
    if args.skip_launchctl:
        extra.append("--skip-launchctl")
    repo, org, group = member_scope(args, manifest, member)
    row["scope"] = f"{org}/{group}" if org and group else org or repo
    if summary.get("dedicatedOnly"):
        # DEDICATED_ONLY: no pool instance; each installed one is deregistered and removed, only while it is idle
        retire = row["retire"] if isinstance(row["retire"], list) else []
        results = [retire_instance(member, k) for k in retire]
        if not isinstance(row["retire"], list):
            results.append({"instance": None, "exit": None, "state": f"retire: {row['retire']}"})
    else:
        # the pool instances, then the gateway runners after them (gatewayRunners: instances runners and on), then the
        # sim-first runner (simRunners)
        instances = row["runners"] + row["gatewayRunners"] + row["simRunners"]
        with concurrent.futures.ThreadPoolExecutor(max_workers=instances) as pool:
            results = list(pool.map(lambda k: apply_instance(member, k, repo, extra, org, group,
                                                             args.migrate_from_repo), range(instances)))
        results += retire_surplus(member, instances)
    held = None
    if summary.get("dedicatedOnly") and not all(r["exit"] == 0 for r in results):
        held = "held: pool instances are not all retired; drain the mini and re-run"
    elif summary.get("dedicatedOnly"):
        # re-list the whole pool set right before the dedicated runners: the snapshot above is not the mini now (a
        # concurrent or stale apply may have installed another pool instance since; review of 8c6009cd)
        left, why = installed_pool_instances(member)
        if left is None or left:
            held = f"held: the mini still has pool instances ({why or left}); drain the mini and re-run"
    if held:
        # DEDICATED_ONLY: a pool instance still installed (busy, or unreadable) can take a signing job whose whole-mini
        # claim the dedicated runners never join, so no dedicated runner is (re)applied until every one is retired
        results.append({"dedicated": "*", "exit": None, "state": held})
    else:
        # a dedicated runner keeps its own scope (never --org/--migrate-from-repo) and its own labels
        results += [apply_dedicated(member, entry, extra) for entry in dedicated]
    row["instances"] = results
    row["action"] = "applied" if all(r["exit"] == 0 or r.get("deferred") for r in results) else "failed"
    row["seconds"] = round(time.monotonic() - started, 1)
    return row


def render(rows: list[dict[str, Any]], skipped: dict[str, str], applied: bool, guard: dict[str, Any]) -> str:
    lines = [f"glaeda-cmux-runner-fleet: {'APPLY' if applied else 'PLAN (nothing changed; add --apply to act)'}"]
    lines.extend(guard_lines(guard, applied))
    for row in rows:
        units = f"{row['runners']} runners/{row['capacityUnits']} units" + (
            f"+{row['gatewayRunners']}gw" if row.get("gatewayRunners") else "") + (
            f"+{row['simRunners']}sim" if row.get("simRunners") else "")
        lines.append(f"  {row['member']:<22} {row['class']:<5} {units:<20} {row['action']:<24} {row['gate']}")
        if any(str(i.get("state", "")).startswith("NO RUNNER") for i in row.get("instances", [])):
            lines.append(f"      {row['member']} has instances with no runner: re-run for this member")
        if row.get("dedicated") and not row.get("instances"):
            lines.append(f"      dedicated: {', '.join(row['dedicated'])}")
        for inst in row.get("instances", []):
            lines.append(f"      {inst.get('instance', inst.get('dedicated'))}: exit={inst['exit']} {inst['state']}  {inst.get('name') or ''}")
    for member, why in sorted(skipped.items()):
        lines.append(f"  {member:<22} not a runner member: {why}")
    total = sum(r["runners"] for r in rows if r.get("eligible"))
    lines.append(f"eligible runners: {total} on {sum(1 for r in rows if r.get('eligible'))} members")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="glaeda-cmux-runner-fleet", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--apply", action="store_true", help="stage and apply (default: plan, read-only)")
    p.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    scope = p.add_mutually_exclusive_group()
    scope.add_argument("--repo", help=("register every member to OWNER/REPO (default: the manifest's "
                                        f"runner.org/group, else {DEFAULT_REPO})"))
    scope.add_argument("--org", help="register every member to this organization instead (needs gh as an org admin)")
    p.add_argument("--group", help="org runner group (with --org)")
    p.add_argument("--migrate-from-repo", metavar="OWNER/REPO",
                   help="with --org: deregister each instance from this repository first; one member at a time")
    p.add_argument("--hosts", help="comma-separated members (default: every runner member)")
    p.add_argument("--exclude", default="", help="comma-separated members to leave alone")
    p.add_argument("--include-ineligible", action="store_true",
                   help="also apply to members that do not pass the gate (pair with --skip-launchctl)")
    p.add_argument("--skip-launchctl", action="store_true", help="install or update without starting the runners")
    p.add_argument("--allow-downgrade", metavar="REASON",
                   help="deploy although HEAD is not origin/main or a member's stamp is not an ancestor of HEAD; "
                        "the reason is printed and recorded in the stamp")
    p.add_argument("--jobs", type=int, default=16, help="members at once")
    p.add_argument("--max-procs", type=int, default=None,
                   help=f"ssh/scp/gh children at once across the run (default: ${MAX_PROCS_ENV}, else the open-file "
                        f"limit / 8, clamped to {MAX_PROCS_RANGE[0]}-{MAX_PROCS_RANGE[1]})")
    p.add_argument("--output", choices=("human", "json"), default="human")
    args = p.parse_args(argv)
    if args.max_procs is None and os.environ.get(MAX_PROCS_ENV, "").strip():
        try:
            args.max_procs = int(os.environ[MAX_PROCS_ENV])
        except ValueError:
            print(f"glaeda-cmux-runner-fleet: ${MAX_PROCS_ENV} must be a whole number", file=sys.stderr)
            return 2
    if args.max_procs is not None and args.max_procs < 1:
        print("glaeda-cmux-runner-fleet: --max-procs must be at least 1", file=sys.stderr)
        return 2
    set_max_procs(max_procs(raise_nofile(), args.max_procs))
    args.scope_flags = bool(args.org or args.repo)  # else each member's scope comes from the manifest (member_scope)
    try:
        manifest = json.loads(args.manifest.expanduser().read_text())
    except (OSError, ValueError) as error:
        print(f"glaeda-cmux-runner-fleet: cannot read the manifest: {type(error).__name__}", file=sys.stderr)
        return 2
    if args.repo and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+", args.repo):
        print("glaeda-cmux-runner-fleet: --repo must be OWNER/REPO", file=sys.stderr)
        return 2
    if args.org and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*", args.org):
        print("glaeda-cmux-runner-fleet: --org must be an organization login", file=sys.stderr)
        return 2
    if (args.group or args.migrate_from_repo) and not args.org:
        print("glaeda-cmux-runner-fleet: --group and --migrate-from-repo need --org", file=sys.stderr)
        return 2
    if args.group and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9 ._-]*", args.group):
        print("glaeda-cmux-runner-fleet: --group is not a usable runner group name", file=sys.stderr)
        return 2
    if args.migrate_from_repo and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+", args.migrate_from_repo):
        print("glaeda-cmux-runner-fleet: --migrate-from-repo must be OWNER/REPO", file=sys.stderr)
        return 2
    if args.migrate_from_repo and not args.group:
        print("glaeda-cmux-runner-fleet: --migrate-from-repo needs --group (the Default group admits every repo)",
              file=sys.stderr)
        return 2
    if args.allow_downgrade is not None:
        reason = " ".join(args.allow_downgrade.split())
        args.allow_downgrade = clean_reason(reason)
        if not args.allow_downgrade or len(reason) > MAX_REASON:
            print(f"glaeda-cmux-runner-fleet: --allow-downgrade needs a reason, at most {MAX_REASON} characters",
                  file=sys.stderr)
            return 2
    try:  # its release parsing and pin: a broken copy fails here, before any token is minted
        load_runner()
    except Exception as error:  # noqa: BLE001
        print(f"glaeda-cmux-runner-fleet: cannot load glaeda-cmux-runner beside this script "
              f"({type(error).__name__})", file=sys.stderr)
        return 2
    if args.migrate_from_repo:
        args.jobs = 1  # one member at a time, so the rest keep serving the old scope
    only = [h for h in (args.hosts or "").split(",") if h] or None
    unknown = [h for h in only or [] if h not in (manifest.get("hosts") or {})]
    if unknown:
        print(f"glaeda-cmux-runner-fleet: not in the manifest: {', '.join(unknown)}", file=sys.stderr)
        return 2
    chosen, skipped = members(manifest, load_labels(), only, [h for h in args.exclude.split(",") if h])
    args.guard = guard = source_guard(sorted(chosen), args.jobs if not args.migrate_from_repo else 16)
    if args.allow_downgrade is not None:
        guard["allowDowngrade"] = args.allow_downgrade
    if args.apply and guard["refusals"]:
        for line in refusal_lines(guard, True):
            print(f"glaeda-cmux-runner-fleet: {line.strip()}", file=sys.stderr)
        if args.allow_downgrade is None:
            print("glaeda-cmux-runner-fleet: nothing changed; pass --allow-downgrade REASON to deploy anyway",
                  file=sys.stderr)
            return 2
    if args.apply:  # every org group a member would register into, checked before any member is touched
        # REPO_DEDICATED_ONLY: a member the apply touches only through repository-scoped dedicated runners registers
        # nothing in the org group, so the group is not its to check (and listing it needs an org admin it never uses)
        groups = {member_scope(args, manifest, m)[1:] for m, s in chosen.items()
                  if args.migrate_from_repo or not repo_dedicated_only(m, s, manifest)}
        for org, group in sorted((o, g) for o, g in groups if o and g):
            why = group_refusal(org, group, args.migrate_from_repo)
            if why:
                print(f"glaeda-cmux-runner-fleet: {why}; nothing changed", file=sys.stderr)
                return 2
    with tempfile.TemporaryDirectory(prefix="glaeda-runner-fleet-") as tmp, \
            concurrent.futures.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
        futures = {pool.submit(one_member, m, s, args, manifest, Path(tmp)): m for m, s in chosen.items()}
        rows = [f.result() for f in concurrent.futures.as_completed(futures)]
    rows.sort(key=lambda r: r["member"])
    if args.output == "json":
        release = dict(zip(("version", "sha256", "from"), _RELEASE[0])) if _RELEASE else None
        print(json.dumps({"applied": args.apply, "members": rows, "skipped": skipped, "source": guard,
                          "runnerRelease": release}, indent=2, sort_keys=True))
    else:
        print(render(rows, skipped, args.apply, guard))
    failed = any(r.get("action") == "failed" or str(r.get("action", "")).startswith("stage failed")
                 or (args.apply and r.get("action") == "unreachable") for r in rows)
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
