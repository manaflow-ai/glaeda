#!/bin/bash
# glaeda-fleet-cas-rollout: deploy the fleet compilation cache from an operator Mac.
#
#   glaeda-fleet-cas-rollout --store HOST [--trusted-keys HEX] [--writer HOST --sign-key PATH]
#                            [--store-root PATH] [--store-image PATH] [--allow-coordinator]
#                            [--prewarm REPO] [--prebuilt-dir DIR] NODE_HOST... [--apply]
#
# Plans by default; --apply deploys. HOST names are ssh aliases (User cmux). The store
# listens on the store host's tailnet address port 7450; every NODE_HOST gets a read-only
# node daemon pointed at it. With --trusted-keys, the store keeps and every node uses only
# index entries signed by those keys. --writer makes that host the signing writer: its node
# signs with the key at --sign-key (a path on the writer, created there beforehand with
# `fleet-cas keygen`), and its tailnet address becomes the store's only allowed writer. The
# writer host must run no PR or other untrusted job: any process there can reach the signing
# node's socket. Each host
# receives scripts/glaeda-fleet-cas and tools/fleet-cas-prototype under
# ~/.cache/glaeda-fleet-cas (also when planning) and runs `glaeda-fleet-cas` there
# (docs/CMUX_BUILD_SLOT_MODES.md). With --prewarm REPO (cmux@catchup-v1), every node also gets
# the prewarm agent (fleet-cas-prewarm.sh), which keeps it warm with the writer's newest fill.
# `--store-root` points only the store role at an owner-writable APFS root. With
# `--store-image`, the installed store wrapper attaches that exact pre-existing
# sparsebundle before launchd starts the service. It never creates, formats,
# partitions, or searches for another volume. A coordinator host is refused
# unless `--allow-coordinator` is supplied explicitly, keeping the production routing
# decision visible at the command line. With --prebuilt-dir, the supplied fleet-cas binary
# and helper scripts are copied to each host and the installer skips Cargo. Every host needs
# the tailnet grant for the store port.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
PORT=7450
store= store_root= store_image= apply= allow_coordinator= trusted= writer= sign_key= prewarm= prebuilt_dir= nodes=()
while [ $# -gt 0 ]; do
  case $1 in
    --store) store=${2:?}; shift ;;
    --store-root) store_root=${2:?}; shift ;;
    --store-image) store_image=${2:?}; shift ;;
    --allow-coordinator) allow_coordinator=1 ;;
    --trusted-keys) trusted=${2:?}; shift ;;
    --writer) writer=${2:?}; shift ;;
    --sign-key) sign_key=${2:?}; shift ;;
    --prewarm) prewarm=${2:?}; shift ;;
    --prebuilt-dir) prebuilt_dir=${2:?}; shift ;;
    --apply) apply=--apply ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) nodes+=("$1") ;;
  esac
  shift
done
[ -n "$store" ] || { sed -n '2,6p' "$0" >&2; exit 2; }
case $store_root in
  '') ;;
  /*) ;;
  *) echo "--store-root must be an absolute path" >&2; exit 2 ;;
esac
case $store_image in
  '') ;;
  /*) ;;
  *) echo "--store-image must be an absolute path" >&2; exit 2 ;;
esac
if [ -n "$store_image" ] && [ -z "$store_root" ]; then
  echo "--store-image requires --store-root" >&2; exit 2
fi
if [ -n "$prebuilt_dir" ]; then
  [ -f "$prebuilt_dir/SHA256SUMS" ] && [ ! -L "$prebuilt_dir/SHA256SUMS" ] || { echo "prebuilt bundle missing regular SHA256SUMS" >&2; exit 2; }
  (cd "$prebuilt_dir" && shasum -a 256 -c SHA256SUMS) || { echo "prebuilt bundle checksum failed" >&2; exit 2; }
  for f in fleet-cas fleet-cas-run fleet-cas-mount fleet-cas-settings.sh fleet-cas-marker.sh fleet-cas-warm.sh fleet-cas-prewarm.sh fleet-cas-writer-build.sh; do
    [ -f "$prebuilt_dir/$f" ] && [ ! -L "$prebuilt_dir/$f" ] && [ -x "$prebuilt_dir/$f" ] || { echo "prebuilt bundle missing regular executable $prebuilt_dir/$f" >&2; exit 2; }
  done
fi
if [ -n "$writer" ]; then
  [ -n "$sign_key" ] && [ -n "$trusted" ] || { echo "--writer needs --sign-key PATH and --trusted-keys HEX" >&2; exit 2; }
elif [ -n "$sign_key" ]; then
  echo "--sign-key needs --writer HOST" >&2; exit 2
fi
# The rollout is stateless: whatever it is given replaces the deployed configuration.
[ -n "$trusted" ] || echo "warning: no --trusted-keys: the store keeps, and nodes use, unsigned index entries" >&2
[ -n "$writer" ] || echo "warning: no --writer: the store will accept no writes" >&2
check_host() {  # host, role (store|writer|node)
  local h=$1 role=$2 target coordinator=
  target=$(ssh -G "$h" | awk '/^hostname /{print $2}')
  case "$h $target" in
    *lawrence*|*100.89.225.106*|*172.20.21.158*) coordinator=1 ;;
  esac
  [ -z "$coordinator" ] && return 0
  if [ "$role" != store ]; then
    echo "refusing $h ($target): the coordinator may host only the separate fleet-CAS store, never its writer or a reader node" >&2
    exit 2
  fi
  if [ -z "$allow_coordinator" ]; then
    echo "refusing $h ($target): cmux-lawrence is the fleet coordinator; pass --allow-coordinator for an owner-approved colocated store" >&2
    exit 2
  fi
  if [ -z "$store_root" ]; then
    echo "refusing $h ($target): a colocated coordinator store requires --store-root for a separate mounted APFS volume" >&2
    exit 2
  fi
}
check_host "$store" store
[ -z "$writer" ] || check_host "$writer" writer
for n in ${nodes[@]+"${nodes[@]}"}; do
  check_host "$n" node
done

ship() {  # host
  ssh -o BatchMode=yes "$1" 'mkdir -p ~/.cache/glaeda-fleet-cas/glaeda/scripts ~/.cache/glaeda-fleet-cas/glaeda/tools'
  rsync -a -e 'ssh -o BatchMode=yes' "$here/scripts/glaeda-fleet-cas" "$1:.cache/glaeda-fleet-cas/glaeda/scripts/"
  rsync -a -e 'ssh -o BatchMode=yes' --delete --exclude target "$here/tools/fleet-cas-prototype" "$1:.cache/glaeda-fleet-cas/glaeda/tools/"
  if [ -n "$prebuilt_dir" ]; then
    ssh -o BatchMode=yes "$1" 'mkdir -p ~/.cache/glaeda-fleet-cas/prebuilt'
    rsync -a --delete -e 'ssh -o BatchMode=yes' "$prebuilt_dir/" "$1:.cache/glaeda-fleet-cas/prebuilt/"
  fi
}
run() {  # host, args...
  local h=$1; shift
  echo "== $h"
  ship "$h"
  # Quote each argument for the remote shell.
  local env_prefix=
  if [ "$h" = "$store" ] && [ -n "$store_root" ]; then
    env_prefix="FLEET_CAS_ROOT=$(printf '%q' "$store_root") "
  fi
  if [ "$h" = "$store" ] && [ -n "$store_image" ]; then
    env_prefix="${env_prefix}FLEET_CAS_IMAGE=$(printf '%q' "$store_image") "
  fi
  if [ -n "$prebuilt_dir" ]; then
    env_prefix="${env_prefix}GLAEDA_FLEET_CAS_PREBUILT=\$HOME/.cache/glaeda-fleet-cas/prebuilt "
  fi
  ssh -o BatchMode=yes "$h" "PATH=\$HOME/.cargo/bin:\$PATH $env_prefix~/.cache/glaeda-fleet-cas/glaeda/scripts/glaeda-fleet-cas $(printf '%q ' "$@")"
}

# The store's tailnet address: launchd-started third-party binaries on these minis cannot
# reach other hosts' LAN addresses (macOS Local Network privacy), and tailnet addresses work.
# The tailnet grants the store port to the build minis (cmuxterm-hq#591). Every client,
# the writer included, then connects from its own tailnet address, so --writers sees real
# peers (glaeda#1208).
tailnet_ip() {
  local ip; ip=$(ssh -o BatchMode=yes "$1" "ifconfig | awk '/inet 100\\./ {print \$2; exit}'")
  [ -n "$ip" ] || { echo "no tailnet (100.x) address on $1" >&2; exit 1; }
  echo "$ip"
}
ip=$(tailnet_ip "$store")
writer_ip=
[ -z "$writer" ] || writer_ip=$(tailnet_ip "$writer")
run "$store" store --listen "$ip:$PORT" ${writer_ip:+--writers "$writer_ip"} ${trusted:+--trusted-keys "$trusted"} $apply
[ -z "$writer" ] || run "$writer" writer --store "$ip:$PORT" --sign-key "$sign_key" --trusted-keys "$trusted" $apply
for n in ${nodes[@]+"${nodes[@]}"}; do
  [ "$n" = "$writer" ] && continue
  run "$n" node --store "$ip:$PORT" ${trusted:+--trusted-keys "$trusted"} ${prewarm:+--prewarm "$prewarm"} $apply
done
