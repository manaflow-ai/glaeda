#!/usr/bin/env bash
# Run glaeda-worktree-reclaim over every main Git checkout directly under the projects root
# (default ~/Projects, override with GLAEDA_PROJECTS_ROOT) or one folder below it (cmux16's
# ~/Projects/cmux-personal-build/repo held 58 worktrees the sweep never saw) that has linked worktrees
# or local task branches, including after the last linked worktree was removed.
# Also deletes local branches whose work has landed and that no worktree has checked out
# (--branches), since removing a worktree leaves its branch behind.
# Extra arguments (for example --apply or --output json) pass through.
# Dry run by default, exactly like the underlying command.
# Under disk pressure (the projects disk at least GLAEDA_RECLAIM_PRESSURE_PERCENT used, default
# 90) unfinished but fully pushed work waits GLAEDA_RECLAIM_PRESSURE_IDLE_SECONDS (default 12 h)
# instead of the command's 72 h: cmux16 sat at 98% with nothing reclaimed. Every other veto
# (changes, untracked files, unpushed commits, a process inside) still holds. Depth-1 checkouts
# come first; a clone nested in a checkout is a checkout too.
# A checkout Git cannot read (cosmic-gray, 2026-10-22: a clone whose commit-graph chain was gone)
# is skipped and named on stderr, here or by the command (--skip-unlisted), so it no longer makes
# every run exit 2; the receipt still lists it with its error.
# Installed into ~/.local/bin by scripts/glaeda-mini-setup.
set -euo pipefail
reclaim="${GLAEDA_WORKTREE_RECLAIM:-$HOME/.local/bin/glaeda-worktree-reclaim}"
projects="${GLAEDA_PROJECTS_ROOT:-$HOME/Projects}"
repositories=()
seen=""
for directory in "$projects"/*/ "$projects"/*/*/; do
  directory="${directory%/}"
  [[ -d "$directory/.git" ]] || continue
  linked=$(/usr/bin/git -C "$directory" worktree list --porcelain 2>/dev/null | grep -c '^worktree ' || true)
  if (( linked <= 1 )); then
    # At most two names (main/master) can be skipped here. A third ref must be a
    # candidate. This is discovery only: the reclaimer still decides protection,
    # checked-out state, merge evidence, idle windows and compare-and-swap deletion.
    # Do not consume the repository budget for main/master-only checkouts.
    if ! branches=$(/usr/bin/git -C "$directory" for-each-ref --count=3 \
      --format='%(refname)' refs/heads/ 2>/dev/null); then
      # One unreadable checkout must not stop the sweep of the others: name it and its error, go on.
      problem=$(/usr/bin/git -C "$directory" for-each-ref --count=1 refs/heads/ 2>&1 >/dev/null || true)
      problem=${problem//$'\n'/ }
      printf 'glaeda-worktree-reclaim-all: skipped %s: %s\n' "$directory" "${problem:0:300}" >&2
      continue
    fi
    candidate=0
    while IFS= read -r branch; do
      case "$branch" in
        ''|refs/heads/main|refs/heads/master) ;;
        *) candidate=1 ;;
      esac
    done <<< "$branches"
    (( candidate )) || continue
  fi
  resolved=$(cd "$directory" && pwd -P)
  # A symlinked folder names the same checkout twice; each copy would take a slot.
  case $'\n'"$seen"$'\n' in *$'\n'"$resolved"$'\n'*) continue ;; esac
  seen+="$resolved"$'\n'
  repositories+=(--repository "$resolved")
  (( ${#repositories[@]} < 64 )) || break  # the command accepts at most 32 repositories
done
(( ${#repositories[@]} > 0 )) || exit 0
window=()
case " $* " in
  *" --minimum-idle-seconds"*) ;;
  *)
    used=$(df -Pk "$projects" 2>/dev/null | awk 'NR == 2 { sub("%", "", $5); print $5 }' || true)
    limit=${GLAEDA_RECLAIM_PRESSURE_PERCENT:-90}
    idle=${GLAEDA_RECLAIM_PRESSURE_IDLE_SECONDS:-43200}
    [[ "$limit" =~ ^[0-9]+$ ]] || limit=90
    # The command refuses a window under an hour, which would stop every sweep.
    [[ "$idle" =~ ^[0-9]+$ ]] && (( idle >= 3600 )) || idle=43200
    if [[ "$used" =~ ^[0-9]+$ ]] && (( used >= limit )); then
      window=(--minimum-idle-seconds "$idle")
    fi
    ;;
esac
# GLAEDA_RECLAIM_GIT_WORKERS (1-8) declares how many Git processes the sweep may run at once; unset,
# the command's own default (two) holds. A bad value is ignored rather than stopping every sweep.
workers=()
case " $* " in
  *" --git-workers"*) ;;
  *)
    if [[ "${GLAEDA_RECLAIM_GIT_WORKERS:-}" =~ ^[1-8]$ ]]; then
      workers=(--git-workers "$GLAEDA_RECLAIM_GIT_WORKERS")
    fi
    ;;
esac
# A command older than --skip-unlisted (a host whose build of it failed) would refuse the flag and
# sweep nothing; it gets the old argv and still exits 2 on an unreadable checkout.
skip=()
help=$("$reclaim" --help 2>/dev/null || true)
[[ "$help" == *--skip-unlisted* ]] && skip=(--skip-unlisted)
exec "$reclaim" --branches ${skip[@]+"${skip[@]}"} ${window[@]+"${window[@]}"} ${workers[@]+"${workers[@]}"} "$@" "${repositories[@]}"
